Intern = Struct.new(:name, :skills, :wishes)
Project = Struct.new(:code, :needs)

def compatible?(intern, project)
  Array.include?(Intern.wishes(intern), Project.code(project)) &&
    Array.all?(Project.needs(project)) { |s| Array.include?(Intern.skills(intern), s) }
end

def try_assign(i, interns, projects, owner, visited)
  intern = interns[i]
  Array.each_with_index(projects) do |pr, j|
    next unless compatible?(intern, pr)
    next if Set.include?(visited, j)
    Set.add(visited, j)
    holder = owner[j]
    if holder == nil || try_assign(holder, interns, projects, owner, visited)
      owner[j] = i
      return true
    end
  end
  false
end

def match(interns, projects)
  owner = Hash[]
  matched = 0
  Integer.times(Array.size(interns)) do |i|
    matched += 1 if try_assign(i, interns, projects, owner, Set[])
  end
  [owner, matched]
end

def parse_interns(lines)
  Array.map(lines) do |line|
    fields = Array.map(String.split(line, ";")) { |f| String.strip(f) }
    Intern.new(fields[0], String.split(fields[1], " "), String.split(fields[2], " "))
  end
end

interns = parse_interns(Array[
  "ada; ruby sql; web db",
  "ben; c asm; kernel",
  "cai; ruby js css; web ui",
  "dot; sql python; db ml",
  "eli; python math; ml",
  "fay; js css; ui web",
  "gil; c; kernel db"
])

projects = Project[
  Project.new("web", Array["ruby"]),
  Project.new("db", Array["sql"]),
  Project.new("kernel", Array["c"]),
  Project.new("ml", Array["python", "math"]),
  Project.new("ui", Array["js", "css"]),
  Project.new("docs", Array[])
]

options = Array.map(interns) do |it|
  [Intern.name(it), Array.count(projects) { |pr| compatible?(it, pr) }]
end
Array.each(options) { |name, n| puts(format("%-4s can take %d project(s)", name, n)) }

owner, matched = match(interns, projects)
puts("matched #{matched} of #{Array.size(interns)} interns to #{Array.size(projects)} projects")
Array.each_with_index(projects) do |pr, j|
  i = owner[j]
  who = i == nil ? "(open)" : Intern.name(interns[i])
  needs = Project.needs(pr)
  puts(format("  %-6s <- %-6s needs: %s", Project.code(pr), who,
              Array.empty?(needs) ? "-" : Array.join(needs, "+")))
end
taken = Hash.values(owner)
idle = Array.reject(Range.to_a(0...Array.size(interns))) { |i| Array.include?(taken, i) }
puts("unplaced: #{Array.join(Array.map(idle) { |i| Intern.name(interns[i]) }, ", ")}")
