# Port of activesupport-8.1.3/lib/active_support/core_ext/object/inclusion.rb

module Object
  module_function

  # Ruby: a Range is asked cover?, anything else include?; one that has neither raises ArgumentError.
  def in?(x, another_object)
    case another_object
    in Range then Range.cover?(another_object, x)
    in Array then Array.include?(another_object, x)
    in Hash then Hash.include?(another_object, x)
    in Set then Set.include?(another_object, x)
    in String then (x in String) && String.include?(another_object, x)
    else raise ArgumentError, "The parameter passed to #in? must respond to #include?"
    end
  end

  def presence_in(x, another_object) = in?(x, another_object) ? x : nil
end
