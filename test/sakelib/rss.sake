require "rss"

# fixed zone for the dates the gem converts to local time
ENV.set("TZ", "UTC")

# an RSS 2.0 document
rss_xml = <<~XML
  <?xml version="1.0" encoding="UTF-8"?>
  <rss version="2.0">
    <channel>
      <title>Sake News</title>
      <link>https://example.com/</link>
      <description>All about &lt;Sake&gt; &amp; more</description>
      <language>ja</language>
      <copyright>2024 Example</copyright>
      <pubDate>Tue, 02 Jan 2024 03:04:05 GMT</pubDate>
      <lastBuildDate>Wed, 03 Jan 2024 09:00:00 +0900</lastBuildDate>
      <generator>hand</generator>
      <ttl>60</ttl>
      <image>
        <url>https://example.com/logo.png</url>
        <title>Sake News</title>
        <link>https://example.com/</link>
        <width>88</width>
      </image>
      <item>
        <title>First post</title>
        <link>https://example.com/1</link>
        <description><![CDATA[<p>Hello</p>]]></description>
        <author>ann@example.com (Ann)</author>
        <category domain="https://example.com/tags">lang</category>
        <category>news</category>
        <guid isPermaLink="false">post-1</guid>
        <pubDate>Mon, 01 Jan 2024 10:00:00 +0000</pubDate>
        <enclosure url="https://example.com/1.mp3" length="1234" type="audio/mpeg"/>
      </item>
      <item>
        <title>Second post</title>
        <link>https://example.com/2</link>
        <guid>https://example.com/2</guid>
        <comments>https://example.com/2#c</comments>
      </item>
    </channel>
  </rss>
XML

rss = RSS::Parser.parse(rss_xml)
rss => RSS::Rss
p(RSS::Rss.feed_type(rss))
p(RSS::Rss.feed_version(rss))
p(RSS::Rss.rss_version(rss))
ch = RSS::Rss.channel(rss)
ch => RSS::Rss::Channel
p(RSS::Rss::Channel.title(ch))
p(RSS::Rss::Channel.link(ch))
p(RSS::Rss::Channel.description(ch))
p(RSS::Rss::Channel.language(ch))
p(RSS::Rss::Channel.copyright(ch))
pub_date = RSS::Rss::Channel.pubDate(ch)
pub_date => Time
p(Time.iso8601(Time.getutc(pub_date)))
last_build = RSS::Rss::Channel.lastBuildDate(ch)
last_build => Time
p(Time.iso8601(Time.getutc(last_build)))
p(RSS::Rss::Channel.generator(ch))
p(RSS::Rss::Channel.ttl(ch))
image = RSS::Rss::Channel.image(ch)
image => RSS::Rss::Channel::Image
p(RSS::Rss::Channel::Image.url(image))
p(RSS::Rss::Channel::Image.width(image))
p(RSS::Rss::Channel::Image.height(image))
p(Array.size(RSS::Rss.items(rss)))
Array.each(RSS::Rss.items(rss)) do |item|
  puts("-- #{RSS::Rss::Channel::Item.title(item)}")
  p(RSS::Rss::Channel::Item.link(item))
  p(RSS::Rss::Channel::Item.description(item))
  p(RSS::Rss::Channel::Item.author(item))
  p(Array.map(RSS::Rss::Channel::Item.categories(item)) { |c| [RSS::Rss::Channel::Item::Category.domain(c), RSS::Rss::Channel::Item::Category.content(c)] })
  guid = RSS::Rss::Channel::Item.guid(item)
  guid => RSS::Rss::Channel::Item::Guid
  p(RSS::Rss::Channel::Item::Guid.content(guid))
  p(RSS::Rss::Channel::Item::Guid.isPermaLink(guid))
  p(RSS::Rss::Channel::Item::Guid.PermaLink?(guid))
  date = RSS::Rss::Channel::Item.pubDate(item)
  p(date ? Time.iso8601(Time.getutc(date)) : nil)
  p(RSS::Rss::Channel::Item.comments(item))
  enc = RSS::Rss::Channel::Item.enclosure(item)
  p(enc ? [RSS::Rss::Channel::Item::Enclosure.url(enc), RSS::Rss::Channel::Item::Enclosure.length(enc), RSS::Rss::Channel::Item::Enclosure.type(enc)] : nil)
end
puts(RSS::Rss.to_s(rss))

# an Atom document
atom_xml = <<~XML
  <?xml version="1.0" encoding="utf-8"?>
  <feed xmlns="http://www.w3.org/2005/Atom">
    <title type="text">Example Feed</title>
    <subtitle>A subtitle.</subtitle>
    <link href="http://example.org/feed/" rel="self"/>
    <link href="http://example.org/"/>
    <id>urn:uuid:60a76c80-d399-11d9-b91C-0003939e0af6</id>
    <updated>2003-12-13T18:30:02Z</updated>
    <author>
      <name>John Doe</name>
      <email>johndoe@example.com</email>
    </author>
    <category term="tech" label="Technology"/>
    <generator uri="https://example.org/gen" version="1.0">Gen</generator>
    <entry>
      <title>Atom-Powered Robots Run Amok</title>
      <link href="http://example.org/2003/12/13/atom03"/>
      <link rel="alternate" type="text/html" href="http://example.org/2003/12/13/atom03.html"/>
      <id>urn:uuid:1225c695-cfb8-4ebb-aaaa-80da344efa6a</id>
      <updated>2003-12-13T18:30:02+09:00</updated>
      <published>2003-12-12T08:00:00Z</published>
      <summary>Some text.</summary>
      <content type="html">&lt;p&gt;Body&lt;/p&gt;</content>
    </entry>
    <entry>
      <title>Second</title>
      <id>urn:uuid:2</id>
      <updated>2003-12-14T00:00:00Z</updated>
      <author><name>Jane</name><uri>https://jane.example</uri></author>
    </entry>
  </feed>
XML

feed = RSS::Parser.parse(atom_xml)
feed => RSS::Atom::Feed
p(RSS::Atom::Feed.feed_type(feed))
title = RSS::Atom::Feed.title(feed)
title => RSS::Atom::TextConstruct
p(RSS::Atom::TextConstruct.content(title))
p(RSS::Atom::TextConstruct.type(title))
subtitle = RSS::Atom::Feed.subtitle(feed)
subtitle => RSS::Atom::TextConstruct
p(RSS::Atom::TextConstruct.content(subtitle))
id = RSS::Atom::Feed.id(feed)
id => RSS::Atom::Value
p(RSS::Atom::Value.content(id))
updated = RSS::Atom::Feed.updated(feed)
updated => RSS::Atom::DateConstruct
updated_at = RSS::Atom::DateConstruct.content(updated)
updated_at => Time
p(Time.iso8601(Time.getutc(updated_at)))
p(Array.map(RSS::Atom::Feed.links(feed)) { |l| [RSS::Atom::Link.href(l), RSS::Atom::Link.rel(l)] })
link = RSS::Atom::Feed.link(feed)
link => RSS::Atom::Link
p(RSS::Atom::Link.href(link))
author = RSS::Atom::Feed.author(feed)
author => RSS::Atom::PersonConstruct
author_name = RSS::Atom::PersonConstruct.name(author)
author_name => RSS::Atom::Value
p(RSS::Atom::Value.content(author_name))
author_email = RSS::Atom::PersonConstruct.email(author)
author_email => RSS::Atom::Value
p(RSS::Atom::Value.content(author_email))
p(Array.map(RSS::Atom::Feed.categories(feed)) { |c| [RSS::Atom::Category.term(c), RSS::Atom::Category.label(c)] })
gen = RSS::Atom::Feed.generator(feed)
gen => RSS::Atom::Generator
p([RSS::Atom::Generator.content(gen), RSS::Atom::Generator.uri(gen), RSS::Atom::Generator.version(gen)])
p(Array.size(RSS::Atom::Feed.entries(feed)))
Array.each(RSS::Atom::Feed.entries(feed)) do |entry|
  entry_title = RSS::Atom::Feed::Entry.title(entry)
  entry_title => RSS::Atom::TextConstruct
  puts("-- #{RSS::Atom::TextConstruct.content(entry_title)}")
  entry_id = RSS::Atom::Feed::Entry.id(entry)
  entry_id => RSS::Atom::Value
  p(RSS::Atom::Value.content(entry_id))
  entry_updated = RSS::Atom::Feed::Entry.updated(entry)
  entry_updated => RSS::Atom::DateConstruct
  updated_time = RSS::Atom::DateConstruct.content(entry_updated)
  updated_time => Time
  p(Time.iso8601(Time.getutc(updated_time)))
  published = RSS::Atom::Feed::Entry.published(entry)
  published_time = published ? RSS::Atom::DateConstruct.content(published) : nil
  p(published_time ? Time.iso8601(Time.getutc(published_time)) : nil)
  p(Array.map(RSS::Atom::Feed::Entry.links(entry)) { |l| [RSS::Atom::Link.href(l), RSS::Atom::Link.rel(l), RSS::Atom::Link.type(l)] })
  summary = RSS::Atom::Feed::Entry.summary(entry)
  p(summary ? RSS::Atom::TextConstruct.content(summary) : nil)
  content = RSS::Atom::Feed::Entry.content(entry)
  p(content ? [RSS::Atom::Content.type(content), RSS::Atom::Content.content(content)] : nil)
  p(Array.map(RSS::Atom::Feed::Entry.authors(entry)) do |a|
    name = RSS::Atom::PersonConstruct.name(a)
    uri = RSS::Atom::PersonConstruct.uri(a)
    [name ? RSS::Atom::Value.content(name) : nil, uri ? RSS::Atom::Value.content(uri) : nil]
  end)
end
puts(RSS::Atom::Feed.to_s(feed))

# making RSS 2.0
made = RSS::Maker.make("2.0") do |maker|
  ch = RSS::Maker::RSSBase.channel(maker)
  ch.RSS::Maker::ChannelBase.title = "Made & Sent"
  ch.RSS::Maker::ChannelBase.link = "https://example.com/"
  ch.RSS::Maker::ChannelBase.description = "Made <by> maker"
  ch.RSS::Maker::ChannelBase.language = "en"
  ch.RSS::Maker::ChannelBase.updated = Time.new(2024, 1, 2, 3, 4, 5, "UTC")
  RSS::Maker::ItemsBase.new_item(RSS::Maker::RSSBase.items(maker)) do |item|
    item.RSS::Maker::ItemBase.title = "One"
    item.RSS::Maker::ItemBase.link = "https://example.com/1"
    item.RSS::Maker::ItemBase.description = "first"
    item.RSS::Maker::ItemBase.updated = Time.new(2024, 1, 1, 0, 0, 0, "UTC")
    guid = RSS::Maker::ItemBase.guid(item)
    guid.RSS::Maker::GuidBase.content = "id-1"
    guid.RSS::Maker::GuidBase.isPermaLink = false
  end
  RSS::Maker::ItemsBase.new_item(RSS::Maker::RSSBase.items(maker)) do |item|
    item.RSS::Maker::ItemBase.title = "Two"
    item.RSS::Maker::ItemBase.link = "https://example.com/2"
    item.RSS::Maker::ItemBase.author = "bob@example.com"
    RSS::Maker::CategoriesBase.new_category(RSS::Maker::ItemBase.categories(item)) { |c| c.RSS::Maker::CategoryBase.content = "news" }
  end
end
puts(made)
made => RSS::Rss
p(Array.map(RSS::Rss.items(made)) { |i| RSS::Rss::Channel::Item.title(i) })

# making Atom
made_atom = RSS::Maker.make("atom") do |maker|
  ch = RSS::Maker::RSSBase.channel(maker)
  ch.RSS::Maker::ChannelBase.author = "Ann"
  ch.RSS::Maker::ChannelBase.updated = Time.new(2024, 1, 2, 3, 4, 5, "UTC")
  ch.RSS::Maker::ChannelBase.about = "urn:uuid:feed"
  ch.RSS::Maker::ChannelBase.title = "Atom <Made>"
  RSS::Maker::LinksBase.new_link(RSS::Maker::ChannelBase.links(ch)) do |l|
    l.RSS::Maker::LinkBase.href = "https://example.com/"
    l.RSS::Maker::LinkBase.rel = "alternate"
  end
  RSS::Maker::ItemsBase.new_item(RSS::Maker::RSSBase.items(maker)) do |item|
    item.RSS::Maker::ItemBase.link = "https://example.com/a1"
    item.RSS::Maker::ItemBase.title = "Entry one"
    item.RSS::Maker::ItemBase.updated = Time.new(2024, 1, 1, 0, 0, 0, "UTC")
    item.RSS::Maker::ItemBase.summary = "sum & more"
  end
end
puts(made_atom)

# round trip: what the maker made parses back
again = RSS::Parser.parse(RSS::Rss.to_s(made))
again => RSS::Rss
again_channel = RSS::Rss.channel(again)
again_channel => RSS::Rss::Channel
p(RSS::Rss::Channel.title(again_channel))
p(Array.map(RSS::Rss.items(again)) { |i| RSS::Rss::Channel::Item.link(i) })
back = RSS::Parser.parse(Kernel.to_s(made_atom))
back => RSS::Atom::Feed
back_title = RSS::Atom::Feed.title(back)
back_title => RSS::Atom::TextConstruct
p(RSS::Atom::TextConstruct.content(back_title))
first = Array.first(RSS::Atom::Feed.entries(back))
first => RSS::Atom::Feed::Entry
first_summary = RSS::Atom::Feed::Entry.summary(first)
first_summary => RSS::Atom::TextConstruct
p(RSS::Atom::TextConstruct.content(first_summary))

# errors: missing required elements, not XML, not a feed
begin
  RSS::Parser.parse("<rss version=\"2.0\"><channel><title>t</title><link>l</link></channel></rss>")
rescue RSS::MissingTagError => e
  puts(Exception.message(e))
end
begin
  RSS::Parser.parse("<rss version=\"2.0\"><channel><title>t</title>")
rescue RSS::NotWellFormedError => e
  puts("not well formed")
end
p(RSS::Parser.parse("<html><body/></html>"))
begin
  RSS::Maker.make("2.0") do |maker|
    RSS::Maker::RSSBase.channel(maker).RSS::Maker::ChannelBase.title = "t"
    RSS::Maker::RSSBase.channel(maker).RSS::Maker::ChannelBase.link = "l"
  end
rescue RSS::NotSetError => e
  puts(Exception.message(e))
end
begin
  RSS::Maker.make("3.0") { |maker| }
rescue RSS::UnsupportedMakerVersionError => e
  puts(Exception.message(e))
end
# without validation, the missing description is allowed
loose = RSS::Parser.parse("<rss version=\"2.0\"><channel><title>t</title><link>l</link></channel></rss>", false)
loose => RSS::Rss
loose_channel = RSS::Rss.channel(loose)
loose_channel => RSS::Rss::Channel
p(RSS::Rss::Channel.title(loose_channel))
p(RSS::Rss::Channel.description(loose_channel))
