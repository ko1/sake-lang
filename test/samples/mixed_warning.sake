# Instances of one type used for different values meet in its field (the typer gives Heap.items one type):
# a report there is `mixed`, a warning at level 1 and an error from level 2 (--strict).
class Heap
  attr_reader items
  def initialize(h) = @items = Array[]
  def push(h, x) = Array.push(@items, x)
  def top(h) = Array.max(@items)
end
class Job
  attr_reader prio
  include Comparable
  def <=>(a, b) = a.Job.prio <=> b.Job.prio
end
ints = Heap.new
jobs = Heap.new
Heap.push(ints, 3)
Heap.push(ints, 1)
Heap.push(jobs, Job.new(2))
p(Heap.top(ints) + 1)
p(Heap.top(jobs).Job.prio)
