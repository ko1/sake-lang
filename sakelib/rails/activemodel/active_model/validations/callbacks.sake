# Port of activemodel-8.1.3/lib/active_model/validations/callbacks.rb
#
# before_validation/after_validation (with on:/except_on:) are class-body lines (generate/callbacks.sake);
# the mixin wraps run_validations! in the :validation callbacks, as Ruby's `_run_validation_callbacks { super }`.

module ActiveModel
  module Validations
    module Callbacks
      include ActiveSupport::Callbacks

      # Required (generated): Ruby's define_callbacks :validation.
      def _run_validation_callbacks(r)
        raise NotImplementedError
        yield
      end

      def run_validations!(r) = _run_validation_callbacks(r) { super_run_validations!(r) }
    end
  end
end
