InvalidVersion = Exception.new(:text)

class Version < {reader: [major, minor, patch, pre]}
  include Comparable

  def parse(s)
    m = String.match(s, /\A(\d+)(?:\.(\d+))?(?:\.(\d+))?(?:-([0-9A-Za-z.]+))?\z/)
    raise InvalidVersion.new("invalid version: #{s}", s) unless m
    minor = m[2]
    patch = m[3]
    Version.new(String.to_i(m[1]), minor ? String.to_i(minor) : 0, patch ? String.to_i(patch) : 0, m[4])
  end

  def compare_pre(a, b)
    return 0 if a == nil && b == nil
    return 1 if a == nil
    return -1 if b == nil
    xs = String.split(a, ".")
    ys = String.split(b, ".")
    i = 0
    while i < Array.size(xs) && i < Array.size(ys)
      x = xs[i]
      y = ys[i]
      xnum = String.match?(x, /\A\d+\z/)
      ynum = String.match?(y, /\A\d+\z/)
      c = if xnum && ynum
        String.to_i(x) <=> String.to_i(y)
      elsif xnum
        -1
      elsif ynum
        1
      else
        x <=> y
      end
      return c if c != 0
      i += 1
    end
    Array.size(xs) <=> Array.size(ys)
  end

  def <=>(a, b)
    c = @major <=> Version.get_major(b)
    c = @minor <=> Version.get_minor(b) if c == 0
    c = @patch <=> Version.get_patch(b) if c == 0
    c = compare_pre(@pre, Version.get_pre(b)) if c == 0
    c
  end

  def bump(a, part)
    case part
    in :major then Version.new(@major + 1, 0, 0, nil)
    in :minor then Version.new(@major, @minor + 1, 0, nil)
    in :patch then Version.new(@major, @minor, @patch + 1, nil)
    end
  end

  def prerelease?(a) = @pre != nil
  def to_s(a) = @pre ? "#{@major}.#{@minor}.#{@patch}-#{@pre}" : "#{@major}.#{@minor}.#{@patch}"
end

Requirement = Struct.new(:op, :version, :parts)

class Requirement
  def parse(s)
    m = String.match(String.strip(s), /\A(>=|<=|>|<|=|~>)?\s*(\S+)\z/)
    raise InvalidVersion.new("invalid requirement: #{s}", s) unless m
    text = m[2]
    op = m[1] || "="
    Requirement.new(op, Version.parse(text), Array.size(String.split(text, ".")))
  end

  def satisfied?(r, v)
    target = get_version(r)
    case get_op(r)
    in "=" then v == target
    in ">" then v > target
    in ">=" then v >= target
    in "<" then v < target
    in "<=" then v <= target
    in "~>"
      upper = get_parts(r) <= 2 ? Version.bump(target, :major) : Version.bump(target, :minor)
      v >= target && v < upper
    end
  end

  def to_s(r) = "#{get_op(r)} #{get_version(r)}"
end

def parse_constraint(s) = Array.map(String.split(s, ",")) { |part| Requirement.parse(part) }

def matches?(reqs, v) = Array.all?(reqs) { |r| Requirement.satisfied?(r, v) }

def best_match(versions, constraint, allow_pre)
  reqs = parse_constraint(constraint)
  candidates = Array.select(versions) { |v| matches?(reqs, v) && (allow_pre || Version.prerelease?(v) == false) }
  Array.max(candidates)
end

raw = Array["1.0.0", "1.2.0", "1.2.10", "1.2.9", "1.10.0", "2.0.0-alpha", "2.0.0-alpha.1", "2.0.0-beta",
            "2.0.0-beta.2", "2.0.0-beta.11", "2.0.0-rc.1", "2.0.0", "2.1", "3", "x.y", "1.2.3.4", "2.0.1"]
versions = Array[]
Array.each(raw) do |s|
  begin
    Array.push(versions, Version.parse(s))
  rescue InvalidVersion => e
    puts("skip: #{Exception.message(e)}")
  end
end

sorted = Array.sort(versions)
puts("sorted:")
Array.each(sorted) { |v| puts("  #{v}#{Version.prerelease?(v) ? " (pre)" : ""}") }
puts("newest: #{Array.max(versions)}")
stable = Array.reject(versions) { |v| Version.prerelease?(v) }
puts("oldest stable: #{Array.min(stable)}")

constraints = Array["~> 1.2", "~> 1.2.0", ">= 1.2, < 2", "> 2.0.0-beta", "= 2.1.0", "~> 2", "< 1.0", ">= 2.0.0-rc.1, <= 2.0.0"]
puts("constraints:")
Array.each(constraints) do |c|
  best = best_match(versions, c, false)
  best_pre = best_match(versions, c, true)
  shown = best ? Kernel.to_s(best) : "none"
  shown_pre = best_pre ? Kernel.to_s(best_pre) : "none"
  puts(format("  %-26s stable=%-8s any=%s", c, shown, shown_pre))
end

puts("bumps of 1.2.9:")
base = Version.parse("1.2.9")
Array.each(Array[:patch, :minor, :major]) { |part| puts("  #{part}: #{Version.bump(base, part)}") }

puts("equal 2.1 vs 2.1.0: #{Version.parse("2.1") == Version.parse("2.1.0")}")
puts("1.2.10 > 1.2.9: #{Version.parse("1.2.10") > Version.parse("1.2.9")}")
puts("beta.11 > beta.2: #{Version.parse("2.0.0-beta.11") > Version.parse("2.0.0-beta.2")}")

begin
  parse_constraint(">= 1.0, ~> banana")
rescue InvalidVersion => e
  puts("bad constraint: #{Exception.message(e)} (#{InvalidVersion.get_text(e)})")
end

by_major = Array.group_by(stable) { |v| Version.get_major(v) }
Hash.each(by_major) { |maj, vs| puts("major #{maj}: #{Array.join(Array.sort(vs), ", ")}") }
