# Port of activerecord-8.1.3/lib/arel/nodes/node.rb (partial: no each/Enumerable walk over the tree)
#
# Ruby's class Arel::Nodes::Node is the superclass of every node. Sake has no inheritance, so Node is a
# module that every node class includes; `Arel::Nodes::Node.and(a, b)` dispatches to a's type.

module Arel
  module Nodes
    module Node
      include Arel::FactoryMethods

      # Factory method to create a Nodes::Not node that has the recipient of the caller as a child.
      def not(n) = Not.new(n)

      # Factory method to create a Nodes::Grouping node that has an Nodes::Or node as a child.
      def or(n, right) = Grouping.new(Or.new(Any[n, right]))

      # Factory method to create an Nodes::And node.
      def and(n, right) = And.new(Any[n, right])

      def invert(n) = Not.new(n)

      # Ruby: to_sql(engine = Table.engine), engine.with_connection { |c| c.visitor.accept(self, collector).value }.
      # Here the engine is the connection (an adapter); the model layer's engine comes later.
      def to_sql(n, engine = Arel::Table.engine)
        raise ArgumentError, "no engine: Arel::Table.set_engine(connection) first" unless engine
        collector = Arel::Collectors::SQLString.new
        visitor = ActiveRecord::ConnectionAdapters::AbstractAdapter.visitor(engine)
        Arel::Collectors::SQLString.value(Arel::Visitors::Visitor.accept(visitor, n, collector))
      end

      def equality?(n) = false
    end
  end
end
