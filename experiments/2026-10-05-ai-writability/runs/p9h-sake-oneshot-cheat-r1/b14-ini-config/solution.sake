def is_valid_name(s)
  if String.empty?(s)
    false
  else
    String.match?(s, /^[a-z0-9_]+$/)
  end
end

def resolve_value(section, key, config, visited)
  # visited is Set of "SECTION.KEY" strings we're currently resolving

  # Parse the value and resolve references
  full_key = section + "." + key

  if Set.include?(visited, full_key)
    # Cycle detected
    return {error: "cycle", visited: visited, key: full_key}
  end

  sections = Hash.fetch(config, section, Hash[])
  raw_value = Hash.fetch(sections, key, nil)

  if raw_value == nil
    return {error: "not found"}
  end

  new_visited = Set.dup(visited)
  Set.add(new_visited, full_key)

  # Resolve references in the value
  resolved = ""
  i = 0
  len = String.length(raw_value)

  while i < len
    idx = String.index(raw_value, "${", i)

    if idx == nil
      # No more references, append rest
      resolved += String.slice(raw_value, i, len - i)
      break
    end

    # Append up to the reference
    if idx > i
      resolved += String.slice(raw_value, i, idx - i)
    end

    # Find closing }
    close_idx = String.index(raw_value, "}", idx + 2)

    if close_idx == nil
      # Malformed, treat as literal
      resolved += String.slice(raw_value, idx, len - idx)
      break
    end

    ref_content = String.slice(raw_value, idx + 2, close_idx - (idx + 2))

    # Parse the reference: could be KEY or SECTION.KEY
    if String.include?(ref_content, ".")
      parts = String.split(ref_content, ".", 2)
      if Integer.length(parts) == 2
        ref_section = String.at(parts, 0)
        ref_key = String.at(parts, 1)

        if !is_valid_name(ref_section) || !is_valid_name(ref_key)
          resolved += String.slice(raw_value, idx, close_idx - idx + 1)
          i = close_idx + 1
          next
        end
      else
        resolved += String.slice(raw_value, idx, close_idx - idx + 1)
        i = close_idx + 1
        next
      end
    else
      # Same section
      ref_section = section
      ref_key = ref_content

      if !is_valid_name(ref_key)
        resolved += String.slice(raw_value, idx, close_idx - idx + 1)
        i = close_idx + 1
        next
      end
    end

    # Resolve the reference
    ref_result = resolve_value(ref_section, ref_key, config, new_visited)

    if ref_result in {error: String, ...}
      return ref_result
    end

    resolved += ref_result in {value:}; value

    i = close_idx + 1
  end

  {value: resolved}
end

def infer_type(s)
  # 1. Integer
  if String.match?(s, /^[+-]?\d+$/)
    return {type: "int", value: String.to_i(s)}
  end

  # 2. Boolean
  lower = String.downcase(s)
  case lower
  in "true" | "yes" | "on" then {type: "bool", value: true}
  in "false" | "no" | "off" then {type: "bool", value: false}
  else
    # 3 & 4: List or String
    if String.include?(s, ",")
      items = String.split(s, ",")
      items = Array.map(items) { String.strip(it) }
      items = Array.filter(items) { |item| !String.empty?(item) }
      {type: "list", items: items}
    else
      {type: "str", value: s}
    end
  end
end

def format_value(s)
  info = infer_type(s)
  info => {type:, ...}

  case type
  in "int"
    info => {value:}
    "int #{value}"
  in "bool"
    info => {value:}
    val_str = if value then "true" else "false" end
    "bool #{val_str}"
  in "list"
    info => {items:}
    count = Integer.length(items)
    if count == 0
      "list[0]"
    else
      "list[#{count}] " + Array.join(items, " | ")
    end
  in "str"
    info => {value:}
    "str \"#{value}\""
  end
end

# Read configuration
config = Hash[]
current_section = "main"
errors = Array[]
line_num = 0

while (line = gets)
  line_num += 1
  line = String.strip(line)

  if String.empty?(line) || String.start_with?(line, "#") || String.start_with?(line, ";")
    next
  end

  if line == "%%"
    break
  end

  if String.start_with?(line, "[") && String.end_with?(line, "]")
    section = String.slice(line, 1, String.length(line) - 2)
    section = String.strip(section)

    if !is_valid_name(section)
      Array.push(errors, "line #{line_num}: syntax error")
    else
      current_section = section
      if !Hash.has_key?(config, section)
        Hash.store(config, section, Hash[])
      end
    end
    next
  end

  if String.include?(line, "=")
    eq_idx = String.index(line, "=")
    key_part = String.slice(line, 0, eq_idx)
    value_part = String.slice(line, eq_idx + 1, String.length(line) - (eq_idx + 1))

    key = String.strip(key_part)
    value = String.strip(value_part)

    if !is_valid_name(key)
      Array.push(errors, "line #{line_num}: syntax error")
    else
      if !Hash.has_key?(config, current_section)
        Hash.store(config, current_section, Hash[])
      end

      section_hash = Hash.fetch(config, current_section, Hash[])

      if Hash.has_key?(section_hash, key)
        Array.push(errors, "line #{line_num}: duplicate key #{current_section}.#{key}")
      end

      Hash.store(section_hash, key, value)
    end
    next
  end

  Array.push(errors, "line #{line_num}: syntax error")
end

# Print configuration errors
Array.each(errors) { |e| puts(e) }

# Process queries
while (line = gets)
  line_num += 1
  line = String.strip(line)

  if String.empty?(line)
    next
  end

  words = String.split(line, /\s+/)

  if Integer.length(words) < 2
    puts("line #{line_num}: bad query")
    next
  end

  cmd = String.upcase(String.at(words, 0))

  case cmd
  in "GET"
    name = String.at(words, 1)

    if String.include?(name, ".")
      parts = String.split(name, ".", 2)
      section = String.at(parts, 0)
      key = String.at(parts, 1)
    else
      section = "main"
      key = name
    end

    # Check if key exists
    if !Hash.has_key?(config, section)
      puts("#{section}.#{key}: not found")
      next
    end

    section_hash = Hash.fetch(config, section, Hash[])
    if !Hash.has_key?(section_hash, key)
      puts("#{section}.#{key}: not found")
      next
    end

    # Resolve the value
    visited = Set[]
    result = resolve_value(section, key, config, visited)

    if result in {error: String, ...}
      error = String.at(result, :error)

      if error == "not found"
        puts("#{section}.#{key}: not found")
      elsif error == "cycle"
        # Build cycle message
        cycle_msg = error + " " + String.at(result, :key)
        Array.each(visited) do |v|
          if v != String.at(result, :key)
            cycle_msg += " -> " + v
          end
        end
        cycle_msg += " -> " + String.at(result, :key)
        puts("#{section}.#{key}: error: #{cycle_msg}")
      else
        puts("#{section}.#{key}: error: #{String.at(result, :key)}")
      end
    else
      value = String.at(result, :value)
      formatted = format_value(value)
      puts("#{section}.#{key} = #{formatted}")
    end
  in "KEYS"
    section_name = String.at(words, 1)

    if !Hash.has_key?(config, section_name)
      puts("#{section_name}: not found")
      next
    end

    section_hash = Hash.fetch(config, section_name, Hash[])
    keys = Hash.keys(section_hash)
    keys = Array.sort(keys)

    if Array.empty?(keys)
      puts("#{section_name}: (none)")
    else
      puts("#{section_name}: " + Array.join(keys, ", "))
    end
  else
    puts("line #{line_num}: bad query")
  end
end
