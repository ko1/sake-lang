fn try_it(f)
  try
    print(f())
  catch e
    print(e.kind, e.message)
  end
end
try_it(fn () return "a" + 1.5 end)
try_it(fn () return 1.5 + [1] end)
try_it(fn () return 1.5 - nil end)
try_it(fn () return true * 2.0 end)
try_it(fn () return -(-2.5) end)
try_it(fn () return -"a" end)
try_it(fn () return [1, 2][1.0] end)
try_it(fn () return "abc"[0.0] end)
try_it(fn () return [1, 2, 3][0.5:] end)
try_it(fn () return range(2.0) end)
try_it(fn () return slice([1, 2], 1.0) end)
try_it(fn () return len(1.5) end)
try_it(fn () return 1.5 in 2.5 end)
try_it(fn () return 1.5() end)
let xs = [1, 2]
xs[1.0] = 3
