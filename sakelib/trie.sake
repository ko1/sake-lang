# trie: a prefix tree of String keys with values (insert, lookup, prefix search, longest prefix,
# delete). Keys are visited in lexicographic order of their characters.
#
# Ruby's Trie is the class Trie here too; its node is Trie::Node, as in Ruby. `t[k]` and `t[k] = v`
# work through Indexable.

class Trie
  class Node
    attr_accessor children, value, terminal
    def initialize(t)
      @children = Hash[]
      @value = nil
      @terminal = false
    end
  end

  private attr_reader root
  attr_reader size
  def initialize(t)
    @root = Node.new
    @size = 0
  end
  include Indexable

  def empty?(t) = @size == 0

  # Adds or replaces word; returns value.
  def insert(t, word, value = true)
    word => String
    node = String.chars(word).Array.reduce(@root) do |n, c|
      kids = Node.children(n)
      kid = kids[c]
      next kid if kid
      kids[c] = Node.new
    end
    @size += 1 unless Node.terminal(node)
    Node.set_terminal(node, true)
    Node.set_value(node, value)
  end

  def []=(t, word, value)
    insert(t, word, value)
  end

  def [](t, word)
    node = find(t, word)
    node && Node.terminal(node) ? Node.value(node) : nil
  end

  def include?(t, word)
    node = find(t, word)
    node ? Node.terminal(node) : false
  end

  def starts_with?(t, prefix) = find(t, prefix) != nil

  # The keys starting with prefix, in order.
  def prefix_search(t, prefix)
    node = find(t, prefix)
    out = Tuple[]
    collect(node, prefix, out) if node
    Array.map(out) { |k, _| k }
  end

  # The longest key that is a prefix of s, or nil.
  def longest_prefix(t, s)
    node = @root
    best = Node.terminal(node) ? "" : nil
    String.chars(s).Array.each_with_index do |c, i|
      node = Node.children(node)[c]
      break unless node
      best = s[0, i + 1] if Node.terminal(node)
    end
    best
  end

  # Removes word; returns its value, or nil when it was not there. Empty branches are pruned.
  def delete(t, word)
    path = Node[@root]
    String.each_char(word) do |c|
      nxt = Node.children(Array.fetch(path, -1))[c]
      return nil unless nxt
      Array.push(path, nxt)
    end
    node = Array.fetch(path, -1)
    return nil unless Node.terminal(node)
    value = Node.value(node)
    Node.set_terminal(node, false)
    Node.set_value(node, nil)
    @size -= 1
    String.chars(word).Array.reverse.Array.each_with_index do |c, k|
      child = Array.fetch(path, Array.size(path) - 1 - k)
      break if Node.terminal(child) || !Hash.empty?(Node.children(child))
      Hash.delete(Node.children(Array.fetch(path, Array.size(path) - 2 - k)), c)
    end
    value
  end

  def each(t)
    Array.each(to_a(t)) { |k, v| yield(k, v) }
    t
  end

  def keys(t) = Array.map(to_a(t)) { |k, _| k }

  def to_a(t)
    out = Tuple[]
    collect(@root, "", out)
    out
  end

  def node_count(t) = count_nodes(@root)

  def find(t, word)
    node = @root
    String.each_char(word) do |c|
      node = Node.children(node)[c]
      return nil unless node
    end
    node
  end

  def collect(node, prefix, out)
    Array.push(out, [prefix, Node.value(node)]) if Node.terminal(node)
    kids = Node.children(node)
    Array.each(Array.sort(Hash.keys(kids))) { |c| collect(Hash.fetch(kids, c), prefix + c, out) }
  end

  def count_nodes(node) = 1 + Hash.sum(Node.children(node)) { |_, n| count_nodes(n) }
end
