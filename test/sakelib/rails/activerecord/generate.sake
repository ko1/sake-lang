# The generated source of a model (what `generate "rails/activerecord/active_record/generate/active_record", ...`
# joins into a program), for base_schema.rb and base_models.rb; no Ruby twin (Ruby defines these at run time)
require "rails/activerecord/active_record/generate/model"
require "rails/activerecord/active_record/generate/associations"
require "rails/activerecord/active_record/generate/features"

schema = File.read("base_schema.rb")
tables = ActiveRecord::Generate.parse_schema(schema, "base_schema.rb")
bodies = ActiveSupport::Generate.parse(File.read("base_models.rb"), "base_models.rb")
print(ActiveRecord::Generate.loader_source(schema, "base_schema.rb"))
Array.each(bodies) { |b| print(ActiveRecord::Generate.class_source(b, bodies, tables, "base_models.rb")) }
