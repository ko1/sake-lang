Slot = Struct.new(:name, :price, :count)

def valid_slot?(code)
  code =~ /^[A-Z]\d$/
end

def valid_name?(name)
  name =~ /^[a-z]{1,12}$/
end

def valid_money?(money)
  money =~ /^(0\.05|0\.10|0\.25|0\.50|1\.00|2\.00)$/
end

def valid_count?(count_str)
  count_str =~ /^\d+$/ && String.to_i(count_str) <= 999
end

def valid_slot_count?(count_str)
  count_str =~ /^\d+$/ && String.to_i(count_str) <= 99
end

def format_money(amount)
  format("%.2f", amount)
end

slots = Hash[]
tubes = Hash[0.05 => 0, 0.10 => 0, 0.25 => 0, 0.50 => 0, 1.00 => 0, 2.00 => 0]
credit = 0.0
coin_order = [0.05, 0.10, 0.25, 0.50, 1.00, 2.00]
inserted = Array[]
sales = Hash[]

line_num = 0
while line = gets
  line_num += 1
  line = String.strip(line)
  next if String.empty?(line)

  fields = String.split(line, /\s+/)
  command = Array.at(fields, 0)

  unless command
    puts("line #{line_num}: error: unknown command")
    next
  end

  case command
  in "SLOT"
    unless Array.size(fields) == 5
      puts("line #{line_num}: error: wrong field count")
      next
    end
    code = Array.at(fields, 1)
    name = Array.at(fields, 2)
    price_str = Array.at(fields, 3)
    count_str = Array.at(fields, 4)

    unless valid_slot?(code)
      puts("line #{line_num}: error: bad slot")
      next
    end
    unless valid_name?(name)
      puts("line #{line_num}: error: bad name")
      next
    end
    unless valid_money?(price_str)
      puts("line #{line_num}: error: bad money")
      next
    end
    unless valid_slot_count?(count_str)
      puts("line #{line_num}: error: bad count")
      next
    end

    price = String.to_f(price_str)
    count = String.to_i(count_str)
    slots[code] = Slot.new(name, price, count)

  in "TUBE"
    unless Array.size(fields) == 3
      puts("line #{line_num}: error: wrong field count")
      next
    end
    coin_str = Array.at(fields, 1)
    count_str = Array.at(fields, 2)

    unless valid_money?(coin_str)
      puts("line #{line_num}: error: bad coin")
      next
    end
    unless valid_count?(count_str)
      puts("line #{line_num}: error: bad count")
      next
    end

    coin_val = String.to_f(coin_str)
    count = String.to_i(count_str)
    tubes[coin_val] += count

  in "COIN"
    unless Array.size(fields) == 2
      puts("line #{line_num}: error: wrong field count")
      next
    end
    coin_str = Array.at(fields, 1)

    unless valid_money?(coin_str)
      puts("line #{line_num}: error: bad money")
      next
    end

    coin_val = String.to_f(coin_str)
    if credit + coin_val > 5.0
      puts("rejected #{format_money(coin_val)} (credit limit)")
      next
    end

    credit += coin_val
    Array.push(inserted, coin_val)
    tubes[coin_val] += 1
    puts("credit #{format_money(credit)}")

  in "SELECT"
    unless Array.size(fields) == 2
      puts("line #{line_num}: error: wrong field count")
      next
    end
    code = Array.at(fields, 1)

    slot = Hash.at(slots, code)
    unless slot
      puts("no slot #{code}")
      next
    end

    if Slot.count(slot) == 0
      puts("sold out #{code}")
      next
    end

    price = Slot.price(slot)
    if credit < price
      diff = price - credit
      puts("insert #{format_money(diff)} more")
      next
    end

    change = credit - price
    change_coins = Array[]
    temp_tubes = Hash[0.05 => tubes[0.05], 0.10 => tubes[0.10], 0.25 => tubes[0.25], 0.50 => tubes[0.50], 1.00 => tubes[1.00], 2.00 => tubes[2.00]]

    remaining = change
    Array.reverse(Array.sort(coin_order)) { |coin|
      while remaining >= coin && temp_tubes[coin] > 0
        Array.push(change_coins, coin)
        remaining -= coin
        temp_tubes[coin] -= 1
      end
    }

    if remaining > 0.001
      puts("exact change needed")
      next
    end

    Slot.set_count(slot, Slot.count(slot) - 1)
    Array.reverse(Array.sort(coin_order)) { |coin|
      while remaining >= coin && tubes[coin] > 0
        remaining -= coin
        tubes[coin] -= 1
      end
    }

    credit = 0.0
    inserted = Array[]

    product_name = Slot.name(slot)
    if Hash.has_key?(sales, product_name)
      sales[product_name] = [Array.at(sales[product_name], 0) + 1, Array.at(sales[product_name], 1) + price]
    else
      sales[product_name] = [1, price]
    end

    if Array.size(change_coins) == 0
      puts("vend #{product_name}")
    else
      change_str = Array.join(Array.map(change_coins) { format_money(it) }, " ")
      puts("vend #{product_name}, change #{format_money(change)} [#{change_str}]")
    end

  in "CANCEL"
    unless Array.size(fields) == 1
      puts("line #{line_num}: error: wrong field count")
      next
    end

    if credit == 0.0
      puts("nothing to return")
      next
    end

    temp_tubes = Hash[0.05 => tubes[0.05], 0.10 => tubes[0.10], 0.25 => tubes[0.25], 0.50 => tubes[0.50], 1.00 => tubes[1.00], 2.00 => tubes[2.00]]

    returned_coins = Array[]
    Array.each(inserted) { |coin|
      Array.push(returned_coins, coin)
      temp_tubes[coin] -= 1
    }

    Array.each(inserted) { |coin|
      tubes[coin] -= 1
    }

    credit = 0.0
    inserted = Array[]

    returned_str = Array.join(Array.map(returned_coins) { format_money(it) }, " ")
    puts("returned #{format_money(Array.sum(returned_coins, 0.0))} [#{returned_str}]")

  else
    puts("line #{line_num}: error: unknown command")
  end
end

if credit > 0.0
  puts("credit #{format_money(credit)} kept")
end

puts("sales:")
if Hash.empty?(sales)
  puts("  none")
else
  sales_list = Array[]
  Hash.each(sales) { |name, pair|
    count, revenue = pair
    Array.push(sales_list, [revenue, name, count])
  }
  sales_list = Array.sort_by(sales_list) { |revenue, name, count| [-revenue, name] }
  Array.each(sales_list) { |revenue, name, count|
    puts(format("  %-12s %3d %8s", name, count, format_money(revenue)))
  }
end

puts("tubes: 0.05x#{tubes[0.05]} 0.10x#{tubes[0.10]} 0.25x#{tubes[0.25]} 0.50x#{tubes[0.50]} 1.00x#{tubes[1.00]} 2.00x#{tubes[2.00]}")
