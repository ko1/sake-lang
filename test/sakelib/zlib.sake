require "zlib"

inputs = Array["", "a", "abc", "hello world", "日本語のテキスト", "héllo ✓ 😀", String.*("xyz", 100),
               String.*("q", 6000), Array.pack(Integer[0, 255, 128, 1, 127], "C*")]
Array.each(inputs) do |s|
  puts("#{String.bytesize(s)} bytes: crc32 #{Zlib.crc32(s)} adler32 #{Zlib.adler32(s)}")
end

# The running value: checksumming in pieces gives the checksum of the whole.
crc = 0
adler = 1
Array.each(Array["The quick ", "brown fox ", "", "jumps over the lazy dog"]) do |piece|
  crc = Zlib.crc32(piece, crc)
  adler = Zlib.adler32(piece, adler)
end
p(crc)
p(Zlib.crc32("The quick brown fox jumps over the lazy dog"))
p(adler)
p(Zlib.adler32("The quick brown fox jumps over the lazy dog"))
p(Zlib.crc32("", 12345))
p(Zlib.adler32("abc", 0))
p(Zlib.crc32("abc", 0xffffffff))

# Combining the checksums of two parts.
a = "hello, "
b = "日本語 world"
p(Zlib.crc32_combine(Zlib.crc32(a), Zlib.crc32(b), String.bytesize(b)))
p(Zlib.crc32(a + b))
p(Zlib.adler32_combine(Zlib.adler32(a), Zlib.adler32(b), String.bytesize(b)))
p(Zlib.adler32(a + b))
p(Zlib.crc32_combine(Zlib.crc32(a), Zlib.crc32(""), 0))
p(Zlib.adler32_combine(Zlib.adler32(a), Zlib.adler32(""), 0))

p(Array.size(Zlib.crc_table))
p(Array.first(Zlib.crc_table, 4))
p(Array.last(Zlib.crc_table, 2))
p(Array.last(Zlib.crc_table))

# No String: the initial value.
p(Zlib.crc32)
p(Zlib.adler32)
p(Zlib.crc32(nil, 5))
p(Zlib.adler32(nil, 5))
p(Zlib.crc32("a", -1))
p(Zlib.crc32("a", 2 ** 32 + 5))
