# Array.flatten opens only Arrays: a Tuple is one value. To open the Tuples of String.scan with groups,
# use flat_map and Tuple.to_a.
xs = String.scan("ab/cd ef/gh", /([a-z]+)\/([a-z]+)/)
p(xs)
p(Array.flat_map(xs) { |t| Tuple.to_a(t) })
ys = Any[Any[1, 2], Any[3, Any[4]]]
Array.flatten!(ys)
p(ys)
