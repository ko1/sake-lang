# Two compositions of different types: the body of compose's block must see both f's.
def compose(f, g) = proc { |x| Proc.call(f, Proc.call(g, x)) }
a = compose(proc { |x| x + 1 }, proc { |x| x * 2 })
b = compose(proc { |s| String.upcase(s) }, proc { |s| String.reverse(s) })
p Proc.call(a, 1)
p Proc.call(b, "ab")
p String.upcase(Proc.call(a, 1))
