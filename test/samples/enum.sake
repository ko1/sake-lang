# Enum (the prelude): Enumerable under a short name. On an Array, Hash, Set or Range, Enum.f dispatches to
# the type's own operation; a class joins with `include Enum` and `def each`, and gets every function.
xs = Any[3, 1, 2]
h = Hash.of(a: 1, b: 2)
s = Set.of(1, 2, 3)
r = 1..4

p(Enum.map(xs) { |v| v * 10 }, Enum.map(h) { |k, v| "#{k}=#{v}" }, Enum.select(s) { |v| v > 1 }, Enum.to_a(r))
p(Enum.reduce(xs, 0) { |a, v| a + v }, Enum.count(r) { |v| v > 2 }, Enum.include?(s, 2), Enum.first(xs), Enum.sort_by(xs) { |v| -v })

class Deck                               # a class's own iteration: Enum's functions come for free
  include Enum
  attr_reader cards
  def each(d)
    Array.each(@cards) { |c| yield(c) }
  end
end

d = Deck.new(Any["A", "K", "Q", "J"])
p(Deck.map(d) { |c| String.downcase(c) }, Deck.select(d) { |c| c < "K" }, Deck.first(d), Deck.first(d, 2))
p(Deck.count(d), Deck.include?(d, "Q"), Deck.any?(d) { |c| c == "A" }, Deck.min_by(d) { |c| c }, Deck.partition(d) { |c| c < "K" })
p(Deck.reduce(d, "") { |acc, c| acc + c }, Deck.group_by(d) { |c| c < "K" }, Deck.drop(d, 3), Deck.each_with_object(d, Any[]) { |c, m| Array.unshift(m, c) })
p(Enum.map(d) { |c| c + "!" })          # Enum.f on a Deck dispatches to Deck's copy
