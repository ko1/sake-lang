# Port of activerecord-8.1.3/lib/active_record/attribute_methods.rb, attribute_methods/{read,write,query,
# before_type_cast,primary_key,dirty}.rb (partial: no alias_attribute, no attribute method patterns at run time:
# the per-attribute methods are generated; no time zone conversion; no composite primary keys)
#
# Ruby defines `title`, `title=`, `title?`, `title_changed?`, `title_was`, ... with define_method from the
# attribute names when the class first needs them (define_attribute_methods). Here the generator writes them from
# the schema, each a one-line call of the functions below with the name as a String; the reader narrows the value
# to the column's type (`Post.title(post)` is `String | nil`). Dirty is ActiveModel::Dirty's (the model includes it
# before this module, as Ruby's AttributeMethods::Dirty does): its mutation trackers are the fields
# __mutations_from_database and __mutations_before_last_save, over the AttributeSet in __attributes (Ruby's @attributes).

module ActiveRecord
  module AttributeMethods
    def _read_attribute(r, name) = ActiveModel::AttributeSet.fetch_value(@__attributes, name)
    def read_attribute(r, name) = _read_attribute(r, attr_name_of(r, name))
    def _write_attribute(r, name, value) = ActiveModel::AttributeSet.write_from_user(@__attributes, name, value)

    def write_attribute(r, name, value)
      n = attr_name_of(r, name)
      raise ActiveModel::MissingAttributeError, "can't write unknown attribute `#{n}`" unless Hash.key?(attribute_types, n)
      _write_attribute(r, n, value)
    end

    def attr_name_of(r, name)
      n = Kernel.to_s(name)
      n == "id" ? (primary_key || "id") : n
    end

    # Ruby: post[:title], post[:title] = v
    def [](r, name) = read_attribute(r, name)
    def []=(r, name, value)
      write_attribute(r, name, value)
    end

    def has_attribute?(r, name) = ActiveModel::AttributeSet.key?(@__attributes, Kernel.to_s(name))
    def attribute_present?(r, name) = !Object.blank?(_read_attribute(r, Kernel.to_s(name)))
    def attributes(r) = ActiveModel::AttributeSet.to_hash(@__attributes)
    def attribute_set_of(r) = @__attributes
    # Ruby's instance attribute_names (@attributes.keys); the class's is attribute_names
    def attribute_names_of(r) = ActiveModel::AttributeSet.keys(@__attributes)

    def read_attribute_before_type_cast(r, name)
      ActiveModel::Attribute.value_before_type_cast(@__attributes[Kernel.to_s(name)])
    end
    def attributes_before_type_cast(r) = ActiveModel::AttributeSet.values_before_type_cast(@__attributes)
    def attribute_came_from_user?(r, name) = ActiveModel::Attribute.came_from_user?(@__attributes[name])

    # Ruby's query_attribute (title?): present, and for numbers not zero
    def query_attribute(r, name)
      value = _read_attribute(r, name)
      case value
      in true then true
      in false | nil then false
      in Integer | Float then value != 0
      in BigDecimal then !BigDecimal.zero?(value)
      in String then !Object.blank?(value) && value != "0" && value != "f" && value != "false"
      else true
      end
    end

    # primary_key.rb: id, id=, id?, id_was, id_in_database, to_key
    def id(r) = _read_attribute(r, primary_key || "id")
    def id_in_database(r) = attribute_in_database(r, primary_key || "id")
    def id_was(r) = attribute_was(r, primary_key || "id")
    def to_key(r) = (v = id(r)) ? Any[v] : nil

    # attribute_assignment.rb is ActiveModel's AttributeAssignment (through ActiveModel::API) with the generated
    # `_assign_attribute` (Ruby's public_send of the setter); multiparameter and nested Hashes are the writers' business

    # attribute_methods/dirty.rb, over ActiveModel::Dirty (changed?, changed, changes, attribute_changed?,
    # attribute_was, previous_changes, restore_attributes, changes_applied, ... on the two mutation trackers)
    def saved_change_to_attribute?(r, attr_name, **options) = ActiveModel::MutationTracker.changed?(mutations_before_last_save(r), Kernel.to_s(attr_name), options)
    def saved_change_to_attribute(r, attr_name) = ActiveModel::MutationTracker.change_to_attribute(mutations_before_last_save(r), Kernel.to_s(attr_name))
    def attribute_before_last_save(r, attr_name) = ActiveModel::MutationTracker.original_value(mutations_before_last_save(r), Kernel.to_s(attr_name))
    def saved_changes?(r) = ActiveModel::MutationTracker.any_changes?(mutations_before_last_save(r))
    def saved_changes(r) = ActiveModel::MutationTracker.changes(mutations_before_last_save(r))
    def will_save_change_to_attribute?(r, attr_name, **options) = ActiveModel::MutationTracker.changed?(mutations_from_database(r), Kernel.to_s(attr_name), options)
    def attribute_change_to_be_saved(r, attr_name) = ActiveModel::MutationTracker.change_to_attribute(mutations_from_database(r), Kernel.to_s(attr_name))
    def attribute_in_database(r, attr_name) = ActiveModel::MutationTracker.original_value(mutations_from_database(r), Kernel.to_s(attr_name))
    def has_changes_to_save?(r) = ActiveModel::MutationTracker.any_changes?(mutations_from_database(r))
    def changes_to_save(r) = ActiveModel::MutationTracker.changes(mutations_from_database(r))
    def changed_attribute_names_to_save(r) = ActiveModel::MutationTracker.changed_attribute_names(mutations_from_database(r))
    def attributes_in_database(r) = ActiveModel::MutationTracker.changed_values(mutations_from_database(r))

    # Ruby's Dirty#reload and #init_internals: the trackers start again
    def reset_mutation_trackers(r)
      @__mutations_before_last_save = nil
      @__mutations_from_database = nil
    end

    # Ruby: attribute_names_for_partial_inserts / updates (partial_inserts, partial_updates)
    def attribute_names_for_partial_inserts(r)
      return changed_attribute_names_to_save(r) if ModelClass.partial_inserts(__model)
      Hash.keys(ActiveModel::AttributeSet.attributes(@__attributes))
    end

    def attribute_names_for_partial_updates(r)
      return Array.select(column_names) { |n| n != primary_key } unless ModelClass.partial_updates(__model)
      changed_attribute_names_to_save(r)
    end

    # Ruby: attributes_with_values(attribute_names) = attribute_names.index_with { |name| @attributes[name] }
    def attributes_with_values(r, names)
      h = Hash.new
      Array.each(names) { |n| h[n] = @__attributes[n] if Array.include?(column_names, n) }
      h
    end
  end
end

module ActiveRecord
  module AttributeMethods
    # Ruby's AttributeMethods::Dirty#_create_record / #_update_record (super, then changes_applied)
    def dirty__create_record(r)
      id = locking__create_record(r)
      changes_applied(r)
      id
    end

    def dirty__update_record(r)
      affected = locking__update_record(r)
      changes_applied(r)
      affected
    end
  end
end
