module Sql
  class RowFeed
    attr_accessor rows: Array[Array[value]]

    def initialize: () -> void
  end

  class Cte
    attr_reader name: String
    attr_reader column_names: Array[String]?
    attr_reader query: Ast::Query
    attr_reader recursive: bool
    attr_reader env: Namespace

    def initialize: (String name, Array[String]? column_names, Ast::Query query, bool recursive, Namespace env) -> void
  end

  class WorkingTable
    attr_reader name: String
    attr_reader column_names: Array[String?]
    attr_reader feed: RowFeed

    def initialize: (String name, Array[String?] column_names, RowFeed feed) -> void
  end

  class Namespace
    type entry = Cte | WorkingTable

    attr_reader catalog: Catalog

    @local: Hash[String, entry]

    def initialize: (Catalog catalog, ?Hash[String, entry] local) -> void
    def lookup: (String name) -> entry?
    def with_cte: (Cte cte) -> Namespace
    def with_working_table: (WorkingTable working) -> Namespace

    private

    def with_local: (String name, entry entry) -> Namespace
  end
end
