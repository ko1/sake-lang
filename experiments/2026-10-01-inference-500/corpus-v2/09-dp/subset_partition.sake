# reachable[s]: some subset of the items so far sums to s; via[s] = item that first reached s
def subset_sums(items)
  total = Array.sum(items)
  reachable = Array.fill(Range.to_a(0..total), false)
  via = Array.fill(Range.to_a(0..total), nil)
  reachable[0] = true
  Array.each_with_index(items) do |w, idx|
    Integer.downto(total, w) do |s|
      if !reachable[s] && reachable[s - w]
        reachable[s] = true
        via[s] = idx
      end
    end
  end
  [reachable, via]
end

def pick(items, via, target)
  used = Array[]
  s = target
  while s > 0
    idx = via[s]
    Array.unshift(used, idx)
    s -= items[idx]
  end
  used
end

def balance(label, items)
  total = Array.sum(items)
  reachable, via = subset_sums(items)
  half = total / 2
  target = half
  target -= 1 until reachable[target]
  side_a = pick(items, via, target)
  side_b = Array.reject(Range.to_a(0...Array.size(items))) { |i| Array.include?(side_a, i) }
  a_vals = Array.map(side_a) { |i| items[i] }
  b_vals = Array.map(side_b) { |i| items[i] }
  diff = total - 2 * target
  verdict = diff == 0 ? "perfect split" : "difference #{diff}"
  puts("#{label}: total #{total}, #{verdict}")
  puts("  A #{Array.sum(a_vals)}: #{Array.join(a_vals, " + ")}")
  puts("  B #{Array.sum(b_vals)}: #{Array.join(b_vals, " + ")}")
end

def count_subsets(items, target)
  ways = Hash.new(0)
  ways[0] = 1
  Array.each(items) do |w|
    snapshot = Hash.to_a(ways)
    Array.each(snapshot) do |s, c|
      ways[s + w] += c if s + w <= target
    end
  end
  ways[target]
end

def reachable_sums(items)
  sums = Set[0]
  Array.each(items) do |w|
    added = Set.map(sums) { |s| s + w }
    Array.each(added) { |s| Set.add(sums, s) }
  end
  sums
end

jobs = Hash[
  "render farm" => Array[15, 5, 20, 10, 35, 15, 10],
  "moving boxes" => Array[3, 1, 4, 2, 2, 1],
  "odd total" => Array[8, 6, 5, 3, 1],
  "lopsided" => Array[50, 3, 4, 5],
  "single" => Array[7]
]
Hash.each(jobs) { |label, items| balance(label, items) }

items = Array[2, 3, 5, 6, 8, 10]
puts("subsets of #{items} summing to:")
Array.each(Array[10, 13, 17, 34, 1]) do |t|
  puts(format("  %2d -> %d", t, count_subsets(items, t)))
end

sums = reachable_sums(Array[3, 7, 12])
sorted = Set.sort(sums)
missing = Array.reject(Range.to_a(0..Array.max(sorted))) { |s| Set.include?(sums, s) }
puts("sums from 3, 7, 12: #{Array.join(sorted, " ")}")
puts("unreachable below #{Array.max(sorted)}: #{Array.size(missing)} values, largest #{Array.max(missing)}")
