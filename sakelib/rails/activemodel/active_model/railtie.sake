# Port of activemodel-8.1.3/lib/active_model/railtie.rb (partial: no secure password min_cost in test, no i18n_customize_full_message)

require "secure_password"

module ActiveModel
  module Railtie
    module_function

    def initializers
      list = Rails::Initializable::Initializer[]
      Rails::Initializable.add(list, :"active_model.secure_password", :active_model)
      list
    end

    def run(config, name)
      case name
      # Ruby: ActiveModel::SecurePassword.min_cost = Rails.env.test?
      in :"active_model.secure_password" then ActiveModel::SecurePassword.set_min_cost(Rails.env_inquirer.ActiveSupport::EnvironmentInquirer.test?)
      else raise ArgumentError, "no initializer #{name}"
      end
      nil
    end
  end
end
