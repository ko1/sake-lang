# The built-in functions (SPEC.md, "Built-in functions"). Each checks its
# argument count, then its arguments one by one (type, then value), and reports
# the first problem it finds as a runtime error at the position of the call.
# `map` and `filter` run Mini functions, so the interpreter carries them out
# (Interpreter.call_higher_order) with the checks defined here.
module Builtins
  module_function

  # name => [minimum, maximum] number of arguments; a nil maximum means no limit.
  def arity_table = once { Hash[
    "print" => [0, nil],
    "len" => [1, 1],
    "push" => [2, 2],
    "pop" => [1, 1],
    "keys" => [1, 1],
    "values" => [1, 1],
    "has" => [2, 2],
    "get" => [2, 3],
    "del" => [2, 2],
    "str" => [1, 1],
    "int" => [1, 1],
    "type" => [1, 1],
    "range" => [1, 3],
    "join" => [2, 2],
    "split" => [2, 2],
    "slice" => [2, 3],
    "sort" => [1, 1],
    "contains" => [2, 2],
    "min" => [1, nil],
    "max" => [1, nil],
    "upper" => [1, 1],
    "lower" => [1, 1],
    "reverse" => [1, 1],
    "map" => [2, 2],
    "filter" => [2, 2]
  ] }

  def names = Hash.keys(arity_table)

  # [minimum, maximum] number of arguments of the built-in `name`.
  def arity(name) = arity_table[name]

  def check_arity(name, args, pos)
    min, max = arity(name)
    return if Arity.accepts?(min, max, Array.length(args))

    Errors.runtime("arity", Arity.message(name, min, max, Array.length(args)), pos)
  end

  # Runs every built-in except `map` and `filter`.
  def call(name, args, pos)
    check_arity(name, args, pos)
    case name
    in "print" then builtin_print(args)
    in "len" then builtin_len(args, pos)
    in "push" then builtin_push(args, pos)
    in "pop" then builtin_pop(args, pos)
    in "keys" then Hash.keys(map_arg(name, args, 1, pos))
    in "values" then Hash.values(map_arg(name, args, 1, pos))
    in "has" then builtin_has(args, pos)
    in "get" then builtin_get(args, pos)
    in "del" then builtin_del(args, pos)
    in "str" then Format.show(args[0])
    in "int" then builtin_int(args, pos)
    in "type" then Values.type_name(args[0])
    in "range" then builtin_range(args, pos)
    in "join" then builtin_join(args, pos)
    in "split" then builtin_split(args, pos)
    in "slice" then builtin_slice(args, pos)
    in "sort" then builtin_sort(args, pos)
    in "contains" then builtin_contains(args, pos)
    in "min" | "max" then builtin_min_max(name, args, pos)
    in "upper" then String.upcase(string_arg(name, args, 1, pos))
    in "lower" then String.downcase(string_arg(name, args, 1, pos))
    in "reverse" then builtin_reverse(args, pos)
    else raise ArgumentError, "unknown built-in #{name}"
    end
  end

  # ---- argument checks ----

  # Argument `n` (1-based) of a call to `name` is not of the `expected` kind.
  def arg_error(name, n, expected, value, pos)
    Errors.runtime("type", "#{name}: argument #{n} must be #{expected}, got #{Values.type_name(value)}", pos)
  end

  def int_arg(name, args, n, pos)
    value = args[n - 1]
    arg_error(name, n, "an int", value, pos) unless (value in Integer)
    value
  end

  def string_arg(name, args, n, pos)
    value = args[n - 1]
    arg_error(name, n, "a string", value, pos) unless (value in String)
    value
  end

  def array_arg(name, args, n, pos)
    value = args[n - 1]
    arg_error(name, n, "an array", value, pos) unless (value in Array)
    value
  end

  def map_arg(name, args, n, pos)
    value = args[n - 1]
    arg_error(name, n, "a map", value, pos) unless (value in Hash)
    value
  end

  def function_arg(name, args, n, pos)
    value = args[n - 1]
    arg_error(name, n, "a function", value, pos) unless (value in Closure) || (value in Builtin)
    value
  end

  def key_arg(name, args, n, pos)
    value = args[n - 1]
    arg_error(name, n, "a string or int", value, pos) unless Values.key?(value)
    value
  end

  # ---- the built-ins ----

  def builtin_print(args)
    print("#{Array.join(Array.map(args) { |arg| Format.show(arg) }, " ")}\n")
    nil
  end

  def builtin_len(args, pos)
    value = args[0]
    case value
    in String | Array | Hash then (String|Array|Hash).length(value)
    else arg_error("len", 1, "a string, array or map", value, pos)
    end
  end

  def builtin_push(args, pos)
    Array.push(array_arg("push", args, 1, pos), args[1])
    nil
  end

  def builtin_pop(args, pos)
    array = array_arg("pop", args, 1, pos)
    Errors.runtime("value", "pop: array is empty", pos) if Array.empty?(array)
    Array.pop(array)
  end

  def builtin_has(args, pos)
    map = map_arg("has", args, 1, pos)
    Hash.key?(map, key_arg("has", args, 2, pos))
  end

  def builtin_get(args, pos)
    map = map_arg("get", args, 1, pos)
    key = key_arg("get", args, 2, pos)
    Hash.key?(map, key) ? map[key] : args[2]
  end

  def builtin_del(args, pos)
    map = map_arg("del", args, 1, pos)
    key = key_arg("del", args, 2, pos)
    Errors.runtime("key", "key #{Format.repr(key)} not found", pos) unless Hash.key?(map, key)
    Hash.delete(map, key)
  end

  def builtin_int(args, pos)
    value = args[0]
    case value
    in Integer then value
    in String
      n = parse_int(value)
      Errors.runtime("value", "int: cannot convert #{Format.repr(value)} to int", pos) if n == nil
      n
    else arg_error("int", 1, "an int or string", value, pos)
    end
  end

  # An optional "-" followed by one or more decimal digits, and nothing else; nil otherwise.
  def parse_int(text)
    digits = String.start_with?(text, "-") ? text[1..] : text
    return nil if String.empty?(digits)
    return nil unless Array.all?(String.chars(digits)) { |c| c >= "0" && c <= "9" }

    n = String.to_i(digits)
    String.start_with?(text, "-") ? -n : n
  end

  def builtin_range(args, pos)
    Array.each_index(args) { |i| int_arg("range", args, i + 1, pos) }
    start, stop, step =
      case Array.length(args)
      in 1 then [0, args[0], 1]
      in 2 then [args[0], args[1], 1]
      else args
      end
    start => Integer
    stop => Integer
    step => Integer
    Errors.runtime("value", "range: step must not be zero", pos) if step == 0
    result = Array[]
    i = start
    while step > 0 ? i < stop : i > stop
      Array.push(result, i)
      i += step
    end
    result
  end

  def builtin_join(args, pos)
    array = array_arg("join", args, 1, pos)
    separator = string_arg("join", args, 2, pos)
    Array.join(Array.map(array) { |element| Format.show(element) }, separator)
  end

  # Unlike Ruby's String#split, keeps every empty field: split(",a,", ",") is ["", "a", ""].
  def builtin_split(args, pos)
    text = string_arg("split", args, 1, pos)
    separator = string_arg("split", args, 2, pos)
    Errors.runtime("value", "split: separator must not be empty", pos) if String.empty?(separator)
    fields = Array[]
    start = 0
    while true
      found = String.index(text, separator, start)
      break if found == nil

      Array.push(fields, text[start...found])
      start = found + String.length(separator)
    end
    Array.push(fields, text[start..])
    fields
  end

  # slice(x, start, stop) is x[start:stop] (see Operators.slice); stop defaults to the end.
  def builtin_slice(args, pos)
    target = args[0]
    arg_error("slice", 1, "an array or string", target, pos) unless (target in Array) || (target in String)
    start = int_arg("slice", args, 2, pos)
    stop = Array.length(args) == 3 ? int_arg("slice", args, 3, pos) : nil
    Operators.slice(target, start, stop)
  end

  # A new array, in ascending order; the elements must be all ints or all strings.
  def builtin_sort(args, pos)
    array = array_arg("sort", args, 1, pos)
    Array.each_index(array) do |i|
      next if i == 0

      a = array[0]
      b = array[i]
      next if ((a in Integer) && (b in Integer)) || ((a in String) && (b in String))

      Errors.runtime("type", "sort: cannot compare #{Values.type_name(a)} and #{Values.type_name(b)}", pos)
    end
    Array.sort(array)
  end

  def builtin_contains(args, pos)
    collection = args[0]
    item = args[1]
    case collection
    in Array | Hash then nil
    in String then arg_error("contains", 2, "a string", item, pos) unless (item in String)
    else arg_error("contains", 1, "an array, map or string", collection, pos)
    end
    Values.contains?(collection, item, pos)
  end

  def builtin_min_max(name, args, pos)
    Array.each_index(args) { |i| int_arg(name, args, i + 1, pos) }
    name == "min" ? Array.min(args) : Array.max(args)
  end

  def builtin_reverse(args, pos)
    value = args[0]
    case value
    in Array | String then (Array|String).reverse(value)
    else arg_error("reverse", 1, "an array or string", value, pos)
    end
  end
end
