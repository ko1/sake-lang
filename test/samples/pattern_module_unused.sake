# `in M` for a module no type includes matches nothing (as Ruby's `M === x`).
module Filter
  def match?(f, t) = raise(NotImplementedError)
end
def conditions(x)
  case x
  in Symbol then "a method name"
  in Filter then "a filter object"
  else "other"
  end
end
p(conditions(:published?))
p(conditions(1))
xs = String["a", "b"]
p("%s-%s" % xs)
