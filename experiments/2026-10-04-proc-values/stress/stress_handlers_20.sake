Array.push(hs, proc { |x| Array.push(acc, "2:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "3:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "4:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "5:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "6:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "7:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "8:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "9:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "10:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "11:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "12:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "13:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "14:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "15:#{x}") })
