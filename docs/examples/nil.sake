Node = Struct.new(:value, :next)

def build(n)
  head = nil
  Integer.downto(n, 1) { |i| head = Node.new(i, head) }
  head
end

def sum(node)
  total = 0
  while node                      # nil and false are the only falsy values
    total += Node.value(node)
    node = Node.next(node)
  end
  total
end

def second(node)
  rest = Node.next(node)
  return 0 if rest == nil
  Node.value(rest)
end

list = build(4)
puts(sum(list))
puts(second(list))
puts(Node.next(list) == nil)
puts(Node.value(Node.next(Node.next(Node.next(Node.next(list))))))
