# rainbow: ANSI colours and effects on Strings, after the rainbow gem (3.1.1).
#
#   Rainbow("text").Rainbow.red.Rainbow.bright       # Ruby: Rainbow("text").red.bright
#   Rainbow.color("text", 255, 0, 0)                 # Ruby: Rainbow("text").color(255, 0, 0)
#   Rainbow.background("text", "#ff8800")            # Ruby: Rainbow("text").background("#ff8800")
#   Rainbow.color("text", :aqua)                     # Ruby: Rainbow("text").aqua (an X11 name)
#   Rainbow.set_enabled(true)                        # Ruby: Rainbow.enabled = true
#
# Ruby's Rainbow(s) returns a Presenter, a String subclass whose methods return new Presenters (or a
# NullPresenter when colouring is disabled). Sake has no String subclasses or methods on values, so
# Rainbow(s) returns the String and the methods are module functions with the String first; the chain
# form `s.Rainbow.red` reads as the gem's `s.red`. Enabled is checked at each call (Ruby: at wrap time).

module Rainbow
  module_function

  def term_effects = once {
    Hash[reset: 0, bright: 1, faint: 2, italic: 3, underline: 4, blink: 5, inverse: 7, hide: 8, cross_out: 9]
  }

  def named = once { Hash[black: 0, red: 1, green: 2, yellow: 3, blue: 4, magenta: 5, cyan: 6, white: 7, default: 9] }

  # Ruby's Rainbow::X11ColorNames::NAMES.
  def x11_names = once {
    Hash[
      aqua: [0, 255, 255], aquamarine: [127, 255, 212], mediumaquamarine: [102, 205, 170],
      azure: [240, 255, 255], beige: [245, 245, 220], bisque: [255, 228, 196], black: [0, 0, 0],
      blanchedalmond: [255, 235, 205], blue: [0, 0, 255], darkblue: [0, 0, 139], lightblue: [173, 216, 230],
      mediumblue: [0, 0, 205], aliceblue: [240, 248, 255], cadetblue: [95, 158, 160],
      dodgerblue: [30, 144, 255], midnightblue: [25, 25, 112], navyblue: [0, 0, 128],
      powderblue: [176, 224, 230], royalblue: [65, 105, 225], skyblue: [135, 206, 235],
      deepskyblue: [0, 191, 255], lightskyblue: [135, 206, 250], slateblue: [106, 90, 205],
      darkslateblue: [72, 61, 139], mediumslateblue: [123, 104, 238], steelblue: [70, 130, 180],
      lightsteelblue: [176, 196, 222], brown: [165, 42, 42], rosybrown: [188, 143, 143],
      saddlebrown: [139, 69, 19], sandybrown: [244, 164, 96], burlywood: [222, 184, 135],
      chartreuse: [127, 255, 0], chocolate: [210, 105, 30], coral: [255, 127, 80],
      lightcoral: [240, 128, 128], cornflower: [100, 149, 237], cornsilk: [255, 248, 220],
      crimson: [220, 20, 60], cyan: [0, 255, 255], darkcyan: [0, 139, 139], lightcyan: [224, 255, 255],
      firebrick: [178, 34, 34], fuchsia: [255, 0, 255], gainsboro: [220, 220, 220], gold: [255, 215, 0],
      goldenrod: [218, 165, 32], darkgoldenrod: [184, 134, 11], lightgoldenrod: [250, 250, 210],
      palegoldenrod: [238, 232, 170], gray: [190, 190, 190], darkgray: [169, 169, 169],
      dimgray: [105, 105, 105], lightgray: [211, 211, 211], slategray: [112, 128, 144],
      lightslategray: [119, 136, 153], webgray: [128, 128, 128], green: [0, 255, 0], darkgreen: [0, 100, 0],
      lightgreen: [144, 238, 144], palegreen: [152, 251, 152], darkolivegreen: [85, 107, 47],
      yellowgreen: [154, 205, 50], forestgreen: [34, 139, 34], lawngreen: [124, 252, 0],
      limegreen: [50, 205, 50], seagreen: [46, 139, 87], darkseagreen: [143, 188, 143],
      lightseagreen: [32, 178, 170], mediumseagreen: [60, 179, 113], springgreen: [0, 255, 127],
      mediumspringgreen: [0, 250, 154], webgreen: [0, 128, 0], honeydew: [240, 255, 240],
      indianred: [205, 92, 92], indigo: [75, 0, 130], ivory: [255, 255, 240], khaki: [240, 230, 140],
      darkkhaki: [189, 183, 107], lavender: [230, 230, 250], lavenderblush: [255, 240, 245],
      lemonchiffon: [255, 250, 205], lime: [0, 255, 0], linen: [250, 240, 230], magenta: [255, 0, 255],
      darkmagenta: [139, 0, 139], maroon: [176, 48, 96], webmaroon: [127, 0, 0], mintcream: [245, 255, 250],
      mistyrose: [255, 228, 225], moccasin: [255, 228, 181], oldlace: [253, 245, 230], olive: [128, 128, 0],
      olivedrab: [107, 142, 35], orange: [255, 165, 0], darkorange: [255, 140, 0], orchid: [218, 112, 214],
      darkorchid: [153, 50, 204], mediumorchid: [186, 85, 211], papayawhip: [255, 239, 213],
      peachpuff: [255, 218, 185], peru: [205, 133, 63], pink: [255, 192, 203], deeppink: [255, 20, 147],
      lightpink: [255, 182, 193], hotpink: [255, 105, 180], plum: [221, 160, 221], purple: [160, 32, 240],
      mediumpurple: [147, 112, 219], rebeccapurple: [102, 51, 153], webpurple: [127, 0, 127],
      red: [255, 0, 0], darkred: [139, 0, 0], orangered: [255, 69, 0], mediumvioletred: [199, 21, 133],
      palevioletred: [219, 112, 147], salmon: [250, 128, 114], darksalmon: [233, 150, 122],
      lightsalmon: [255, 160, 122], seashell: [255, 245, 238], sienna: [160, 82, 45],
      silver: [192, 192, 192], darkslategray: [47, 79, 79], snow: [255, 250, 250], tan: [210, 180, 140],
      teal: [0, 128, 128], thistle: [216, 191, 216], tomato: [255, 99, 71], turquoise: [64, 224, 208],
      darkturquoise: [0, 206, 209], mediumturquoise: [72, 209, 204], paleturquoise: [175, 238, 238],
      violet: [238, 130, 238], darkviolet: [148, 0, 211], blueviolet: [138, 43, 226], wheat: [245, 222, 179],
      white: [255, 255, 255], antiquewhite: [250, 235, 215], floralwhite: [255, 250, 240],
      ghostwhite: [248, 248, 255], navajowhite: [255, 222, 173], whitesmoke: [245, 245, 245],
      yellow: [255, 255, 0], lightyellow: [255, 255, 224], greenyellow: [173, 255, 47]
    ]
  }

  # Ruby: off unless both stdout and stderr are terminals, off for TERM=dumb, on for CLICOLOR_FORCE=1.
  def state = once {
    on = IO.tty?(IO.stdout) && IO.tty?(IO.stderr)
    on = false if ENV.get("TERM") == "dumb"
    on = true if ENV.get("CLICOLOR_FORCE") == "1"
    Hash[enabled: on]
  }

  def enabled = state[:enabled] || false
  def set_enabled(v) = state[:enabled] = v

  def uncolor(s) = String.gsub(s, /\e\[[0-9;]*m/, "")

  # Ruby's StringUtils.wrap_with_sgr: the codes go after any leading SGR sequences; one reset at the end.
  def wrap_with_sgr(s, codes)
    return s if Array.empty?(codes) || !enabled
    seq = "\e[" + Array.join(Array.map(codes) { Integer.to_s(it) }, ";") + "m"
    s = String.sub(s, /^(\e\[([\d;]+)m)*/) { |m| m + seq }
    return s if String.end_with?(s, "\e[0m")
    s + "\e[0m"
  end

  def valid_names = Array.join(Array.map(Hash.keys(named) + Hash.keys(x11_names)) { Symbol.to_s(it) }, ", ")

  # Ruby's Color.parse_hex_color.
  def parse_hex_color(hex)
    raise ArgumentError, "Invalid hexadecimal RGB triplet. Valid format: /^#?[a-f0-9]{6}/i" unless String.match?(hex, /^#?[a-f0-9]{6}/i)
    hex = String.sub(hex, /^#/, "")
    Array[String.to_i(hex[0..1] || "", 16), String.to_i(hex[2..3] || "", 16), String.to_i(hex[4..5] || "", 16)]
  end

  def to_ansi_domain(v) = Float.to_i(6 * (v / 256.0))

  # Ruby's Color::RGB#codes: 38;5;n / 48;5;n with n in the 6x6x6 cube.
  def rgb_codes(base, rgb)
    raise ArgumentError, "RGB value outside 0-255 range" if (Array.min(rgb) || 0) < 0 || (Array.max(rgb) || 0) > 255
    r, g, b = rgb
    Array[base + 8, 5, 16 + to_ansi_domain(r || 0) * 36 + to_ansi_domain(g || 0) * 6 + to_ansi_domain(b || 0)]
  end

  # Ruby's Color.build(ground, values).codes: an index, a name, three components, or "#rrggbb".
  def codes(ground, values)
    unless Array.size(values) == 1 || Array.size(values) == 3
      raise ArgumentError, "Wrong number of arguments for color definition, should be 1 or 3"
    end
    base = ground == :foreground ? 30 : 40
    if Array.size(values) == 3
      return rgb_codes(base, Array.map(values) { |v| (v in Integer) ? v : raise(TypeError, "RGB components must be Integers") })
    end
    color = Array.fetch(values, 0)
    case color
    in Integer then Array[color + base]
    in Symbol
      n = named[color]
      return Array[n + base] if n
      x = x11_names[color]
      raise ArgumentError, "Unknown color name, valid names: #{valid_names}" unless x
      rgb_codes(base, Tuple.to_a(x))
    in String then rgb_codes(base, parse_hex_color(color))
    end
  end

  # Disabled, the arguments are not even checked (Ruby's NullPresenter ignores them).
  def color(s, *values) = enabled ? wrap_with_sgr(s, codes(:foreground, values)) : s
  def foreground(s, *values) = color(s, *values)
  def fg(s, *values) = color(s, *values)
  def background(s, *values) = enabled ? wrap_with_sgr(s, codes(:background, values)) : s
  def bg(s, *values) = background(s, *values)

  def effect(s, name) = wrap_with_sgr(s, Array[term_effects[name] || 0])
  def reset(s) = effect(s, :reset)
  def bright(s) = effect(s, :bright)
  def bold(s) = effect(s, :bright)
  def faint(s) = effect(s, :faint)
  def dark(s) = effect(s, :faint)
  def italic(s) = effect(s, :italic)
  def underline(s) = effect(s, :underline)
  def blink(s) = effect(s, :blink)
  def inverse(s) = effect(s, :inverse)
  def hide(s) = effect(s, :hide)
  def cross_out(s) = effect(s, :cross_out)
  def strike(s) = effect(s, :cross_out)

  def black(s) = color(s, :black)
  def red(s) = color(s, :red)
  def green(s) = color(s, :green)
  def yellow(s) = color(s, :yellow)
  def blue(s) = color(s, :blue)
  def magenta(s) = color(s, :magenta)
  def cyan(s) = color(s, :cyan)
  def white(s) = color(s, :white)
end

# Ruby's Kernel#Rainbow(string): the String to colour (Ruby: a Presenter).
def Rainbow(s) = Kernel.to_s(s)
