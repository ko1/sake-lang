# Bug (actionview forms, 2026-10-20): an Array (or Hash) holding a Date (sakelib/date.sake, include Comparable) and a value of any
# other class is rejected: date.sake:59 "case/in: no in branch matches P", reached by Date.<=> (date.sake:140), though nothing
# compares the two. Ruby prints 2. Found through a form options Hash holding a record (object:) and a Date attribute
# value; the test uses Time for date fields instead.
require "date"
class P
  attr_reader n
end
xs = Any[P.new(1), Date.new(2026, 1, 2)]
p(Array.size(xs))
