def label(x) = String.+("top: ", x)

class Door
  def open(d) = label("door")              # Door.label wins over the top-level label
  def label(x) = String.+("door: ", x)
  def show(d) = puts(open(d))              # Door.open wins over the top-level open
end

def open(x) = label("top")

Door.show(1)
puts(open(1))
puts(Door.open(1))
