# (Sake only) Loads the en translations ActionView reads, as actionview-8.1.3/lib/action_view.rb's
# `ActiveSupport.on_load(:i18n) { I18n.load_path << ".../locale/en.yml" }` and active_support/i18n.rb do.
# locale/en.yml is actionview's file; locale/active_support_en.yml is a copy of activesupport's (date and time
# names and formats, number formats) until an activesupport i18n port owns it.

require "i18n"

I18n.load_yaml(File.join(__dir__, "locale/active_support_en.yml"))
I18n.load_yaml(File.join(__dir__, "locale/en.yml"))
