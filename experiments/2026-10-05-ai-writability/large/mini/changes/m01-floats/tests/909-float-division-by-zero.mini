fn try_it(f)
  try
    print(f())
  catch e
    print(e.kind, e.message, e.line, e.col)
  end
end
try_it(fn () return 1.0 / 0 end)
try_it(fn () return 1 / 0.0 end)
try_it(fn () return 1.5 % 0 end)
try_it(fn () return 2 % -0.0 end)
try_it(fn () return 0.0 / 0.0 end)
let y = 2.5
try_it(fn () y /= 0.0 end)
print(y)
print(1.0 / 0)
