# A shape catalogue (circle, rect, triangle, regular polygon) sharing a Shape mixin: areas,
# perimeters, compactness, scaling and grouping through module dispatch.
# Shows: a mixin module whose default functions raise, Shape.area(s) dispatching to s's type,
# group_by, format.

def pi = 3.141592653589793

module Shape
  def area(s) = raise("#{name(s)}: area not implemented")
  def perimeter(s) = raise("#{name(s)}: perimeter not implemented")
  def name(s) = "shape"
  def scale(s, k) = raise("#{name(s)}: scale not implemented")

  def describe(s)
    format("%-10s area=%8.3f perimeter=%7.3f", name(s), area(s), perimeter(s))
  end

  def compactness(s) = 4 * pi * area(s) / (perimeter(s) * perimeter(s))
end

class Circle
  attr_reader r
  include Shape
  def area(c) = pi * @r * @r
  def perimeter(c) = 2 * pi * @r
  def name(c) = "circle"
  def scale(c, k) = Circle.new(@r * k)
end

class Rect
  attr_reader w, h
  include Shape
  def area(r) = @w * @h * 1.0
  def perimeter(r) = 2.0 * (@w + @h)
  def name(r) = @w == @h ? "square" : "rect"
  def scale(r, k) = Rect.new(@w * k, @h * k)
end

class Triangle
  attr_reader a, b, c
  include Shape
  def area(t)
    s = perimeter(t) / 2.0
    Math.sqrt(s * (s - @a) * (s - @b) * (s - @c))
  end
  def perimeter(t) = (@a + @b + @c) * 1.0
  def name(t) = "triangle"
  def scale(t, k) = Triangle.new(@a * k, @b * k, @c * k)
  def valid?(t) = @a + @b > @c && @a + @c > @b && @b + @c > @a
end

class RegularPolygon
  attr_reader sides, len
  include Shape
  def area(g) = @sides * @len * @len / (4.0 * Math.tan(pi / @sides))
  def perimeter(g) = @sides * @len * 1.0
  def name(g) = "#{@sides}-gon"
  def scale(g, k) = RegularPolygon.new(@sides, @len * k)
end

def build_shapes
  shapes = Array[]
  Array.push(shapes, Circle.new(1.5))
  Array.push(shapes, Rect.new(3, 4))
  Array.push(shapes, Rect.new(2.5, 2.5))
  t = Triangle.new(3, 4, 5)
  Array.push(shapes, t) if Triangle.valid?(t)
  bad = Triangle.new(1, 2, 10)
  Array.push(shapes, bad) if Triangle.valid?(bad)
  Array.push(shapes, RegularPolygon.new(6, 2))
  Array.push(shapes, RegularPolygon.new(5, 1.2))
  Array.push(shapes, Circle.new(0.5))
  shapes
end

shapes = build_shapes
puts("== all shapes ==")
Array.each(shapes) { |s| puts(Shape.describe(s)) }

total = Array.sum(shapes) { |s| Shape.area(s) }
puts(format("total area: %.3f", total))

puts("== by area ==")
sorted = Array.sort_by(shapes) { |s| Shape.area(s) }
Array.each_with_index(sorted) { |s, i| puts(format("%d. %s (%.2f)", i + 1, Shape.name(s), Shape.area(s))) }

largest = Array.max_by(shapes) { |s| Shape.perimeter(s) }
puts("longest perimeter: #{Shape.name(largest)}") if largest

puts("== compactness ==")
Array.each(shapes) do |s|
  c = Shape.compactness(s)
  label = c > 0.9 ? "round" : (c > 0.7 ? "chunky" : "thin")
  puts(format("%-10s %.4f %s", Shape.name(s), c, label))
end

puts("== doubled ==")
doubled = Array.map(shapes) { |s| Shape.scale(s, 2) }
Array.each_with_index(doubled) do |d, i|
  ratio = Shape.area(d) / Shape.area(shapes[i])
  puts(format("%-10s x%.1f", Shape.name(d), ratio))
end

groups = Array.group_by(shapes) { |s| Shape.name(s) }
puts("== groups ==")
Hash.each(groups) { |name, members| puts("#{name}: #{Array.size(members)}") }

big = Array.select(shapes) { |s| Shape.area(s) > 10 }
puts("big: #{Array.join(Array.map(big) { |s| Shape.name(s) }, ", ")}")
first_small = Array.find(shapes) { |s| Shape.area(s) < 1 }
if first_small
  puts("first small: #{Shape.describe(first_small)}")
else
  puts("no small shape")
end
