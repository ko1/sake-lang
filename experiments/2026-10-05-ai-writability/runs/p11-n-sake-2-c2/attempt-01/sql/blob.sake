# BLOB values (7.1). A Blob keeps its bytes as upper-case hex digits, two per byte, so two Blobs are
# equal exactly when their hex is, and comparing the hex texts is comparing the bytes (0-9 sort
# before A-F, and a prefix sorts first).
Blob = Struct.new(:hex)

module Blobs
  module_function

  def hex_digit?(c) = NumText.digit?(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)

  # The Blob of these byte values (0..255).
  def from_bytes(bytes) = Blob.new(Array.join(Array.map(bytes) { |b| format("%02X", b) }, ""))

  # The Blob of the bytes of a text (CAST ... AS BLOB, hex).
  def from_text(s) = from_bytes(String.bytes(s))

  # The hex digits of a value that is a Blob, "" for any other value.
  def hex_of(v)
    case v
    in Blob then Blob.hex(v)
    else ""
    end
  end

  def size(b) = String.size(Blob.hex(b)) / 2

  # The text form (7.1): the bytes read as characters. Only ASCII is meaningful; other bytes become "?".
  def text(b)
    hex = Blob.hex(b)
    out = String[]
    i = 0
    n = String.size(hex)
    while i < n
      code = String.hex(Text.slice(hex, i, 2))
      Array.push(out, code < 128 ? Integer.chr(code) : "?")
      i += 2
    end
    Array.join(out, "")
  end

  # 1-based byte position of the first occurrence of y's bytes in x's, or 0.
  def instr(x, y)
    hx = Blob.hex(x)
    hy = Blob.hex(y)
    pos = 0
    loop do
      i = String.index(hx, hy, pos)
      return 0 if i == nil
      return i / 2 + 1 if i % 2 == 0
      pos = i + 1
    end
    0
  end
end
