# SQLite3::Statement (the gem's prepared statement) and total_changes, as ActiveRecord's sqlite3 adapter uses them.
db = SQLite3::Database.new(":memory:")
SQLite3::Database.execute(db, "create table posts (id integer primary key, title varchar(255) not null, score real, body)")
ins = SQLite3::Database.prepare(db, "insert into posts (title, score, body) values (?, ?, ?)")
p([ins, SQLite3::Statement.column_count(ins), SQLite3::Statement.columns(ins)])
before = SQLite3::Database.total_changes(db)
SQLite3::Statement.execute(ins, Any["hello", 1.5, nil])
SQLite3::Statement.execute(ins, Any["world", nil, "text"])
p(SQLite3::Database.total_changes(db) - before, SQLite3::Database.changes(db))
SQLite3::Statement.close(ins)
p(SQLite3::Statement.closed?(ins))

q = SQLite3::Statement.new(db, "select id, title, score, body, length(title) as n from posts where id >= ? order by id")
p(SQLite3::Statement.columns(q), SQLite3::Statement.types(q))
SQLite3::Statement.bind_params(q, Any[1])
while (row = SQLite3::Statement.step(q))
  id, title = row
  p([id, title])
end
p(SQLite3::Statement.done?(q), SQLite3::Statement.step(q))
p(SQLite3::Statement.to_a(SQLite3::Statement.reset!(q)))
p(SQLite3::Statement.execute(q, Any[2]))
begin
  SQLite3::Database.prepare(db, "selec 1")
rescue SQLite3::SQLException => e
  p(String.split(Exception.message(e), "\n")[0])
end
SQLite3::Statement.close(q)
SQLite3::Statement.step(q)
