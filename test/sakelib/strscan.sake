require "strscan"

# basic scanning (the example from Ruby's docs)
ss = StringScanner.new("This is an example string")
p(StringScanner.eos?(ss))
p(StringScanner.scan(ss, /\w+/))
p(StringScanner.scan(ss, /\w+/))
p(StringScanner.scan(ss, /\s+/))
p(StringScanner.scan(ss, /\s+/))
p(StringScanner.scan(ss, /\w+/))
p(StringScanner.pos(ss))
p(ss)
p(StringScanner.scan_until(ss, /ex/))
p(StringScanner.matched(ss))
p(StringScanner.pre_match(ss))
p(StringScanner.post_match(ss))
p(StringScanner.skip(ss, /ample/))
p(StringScanner.skip_until(ss, /str/))
p(StringScanner.match?(ss, /ing/))
p(StringScanner.check(ss, /in/))
p(StringScanner.pos(ss))
p(StringScanner.rest(ss))
p(StringScanner.rest_size(ss))
p(StringScanner.getch(ss))
p(StringScanner.peek(ss, 10))
p(StringScanner.check_until(ss, /g/))
p(StringScanner.exist?(ss, /g/))
p(StringScanner.exist?(ss, /z/))
p(StringScanner.terminate(ss))
p(StringScanner.eos?(ss))
p(StringScanner.getch(ss))
p(StringScanner.scan(ss, /./))
p(StringScanner.rest(ss))

# groups, captures, named groups
ss = StringScanner.new("Fri Dec 12 1975 14:39")
p(StringScanner.scan(ss, /(\w+) (\w+) (\d+) /))
p(ss[0])
p(ss[1])
p(ss[3])
p(ss[4])
p(StringScanner.captures(ss))
p(StringScanner.size(ss))
p(StringScanner.matched_size(ss))
p(StringScanner.scan(ss, /(?<year>\d+) (?<h>\d+):(?<m>\d+)/))
p(ss["year"])
p(ss[:m])
p(StringScanner.named_captures(ss))
p(StringScanner.scan(ss, /x/))
p(ss[0])
p(StringScanner.matched(ss))
p(StringScanner.matched?(ss))
p(StringScanner.captures(ss))

# String patterns
ss = StringScanner.new("key=value; next")
p(StringScanner.scan(ss, "key"))
p(StringScanner.scan(ss, "value"))
p(StringScanner.skip(ss, "="))
p(StringScanner.scan_until(ss, ";"))
p(ss[0])
p(StringScanner.pre_match(ss))

# unscan, reset, pos=, charpos, bol?
ss = StringScanner.new("ab\ncd")
p(StringScanner.scan(ss, /ab/))
p(StringScanner.unscan(ss))
p(StringScanner.pos(ss))
p(StringScanner.skip(ss, /ab\n/))
p(StringScanner.beginning_of_line?(ss))
p(StringScanner.set_pos(ss, 1))
p(StringScanner.bol?(ss))
p(StringScanner.scan(ss, /b/))
p(StringScanner.set_pos(ss, -2))
p(StringScanner.rest(ss))
p(StringScanner.reset(ss))
p(StringScanner.pos(ss))
begin
  StringScanner.scan(ss, /zz/)
  StringScanner.unscan(ss)
rescue ScanError => e
  puts("ScanError: #{Exception.message(e)}")
end
begin
  StringScanner.set_pos(ss, 99)
rescue RangeError => e
  puts("RangeError: #{Exception.message(e)}")
end
begin
  StringScanner.peek(ss, -1)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end

# string=, concat, scan_integer, peek_byte, empty input
ss = StringScanner.new("")
p(StringScanner.eos?(ss))
p(StringScanner.scan(ss, /\w*/))
p(StringScanner.matched?(ss))
p(StringScanner.getch(ss))
p(StringScanner.peek(ss, 3))
p(StringScanner.peek_byte(ss))
p(ss)
StringScanner.set_string(ss, "12 -34 +5x")
p(StringScanner.string(ss))
p(StringScanner.scan_integer(ss))
StringScanner.skip(ss, / /)
p(StringScanner.scan_integer(ss))
StringScanner.skip(ss, / /)
p(StringScanner.scan_integer(ss))
p(StringScanner.scan_integer(ss))
p(StringScanner.peek_byte(ss))
StringScanner.concat(ss, "yz")
p(StringScanner.rest(ss))

# anchors: \A and ^ match at the pointer
ss = StringScanner.new("aaXbb")
StringScanner.skip(ss, /aa/)
p(StringScanner.scan(ss, /\AX/))
p(StringScanner.scan(ss, /^b/))
p(StringScanner.scan(ss, /b$/))

# unicode: pos and sizes count bytes, charpos counts characters
ss = StringScanner.new("日本語 text")
p(StringScanner.scan(ss, /\p{Han}+/))
p(StringScanner.pos(ss))
p(StringScanner.charpos(ss))
p(StringScanner.matched_size(ss))
p(StringScanner.getch(ss))
p(StringScanner.rest_size(ss))
StringScanner.reset(ss)
p(StringScanner.getch(ss))
p(StringScanner.peek(ss, 6))
p(StringScanner.set_pos(ss, 6))
p(StringScanner.scan(ss, /./))

# a small tokenizer
def tokenize(src)
  ss = StringScanner.new(src)
  out = Array[]
  until StringScanner.eos?(ss)
    if StringScanner.skip(ss, /\s+/)
      next
    elsif (t = StringScanner.scan(ss, /\d+(\.\d+)?/))
      Array.push(out, [:num, t])
    elsif (t = StringScanner.scan(ss, /[a-z_]\w*/))
      Array.push(out, [:ident, t])
    elsif (t = StringScanner.scan(ss, /[-+*\/()=]/))
      Array.push(out, [:op, t])
    else
      raise ArgumentError, "unexpected #{Kernel.inspect(StringScanner.peek(ss, 1))} at #{StringScanner.pos(ss)}"
    end
  end
  out
end
p(tokenize("x = 3.14 * (y + 42)"))
begin
  tokenize("a $ b")
rescue ArgumentError => e
  puts(Exception.message(e))
end

# scan_full / search_full: the flags pick advancing and the result's type
ss = StringScanner.new("abc def")
p(StringScanner.scan_full(ss, /ab/, false, true))
p(StringScanner.scan_full(ss, /ab/, true, false))
p(StringScanner.search_full(ss, /e/, false, true))
p(StringScanner.search_full(ss, /e/, true, false))
p(StringScanner.pointer(ss))
p(StringScanner.fixed_anchor?(ss))

# << appends; a group name that does not exist
ss = StringScanner.new("ab")
ss << "cd" << "e"
p(StringScanner.rest(ss))
StringScanner.scan(ss, "a")
begin
  p(ss[:x])
rescue IndexError => e
  puts("IndexError: #{Exception.message(e)}")
end
StringScanner.scan(ss, /(?<y>b)/)
begin
  p(ss["x"])
rescue IndexError => e
  p(String.end_with?(Exception.message(e), "undefined group name reference: x"))   # Sake prefixes "MatchData.[]: "
end
p([StringScanner.rest?(StringScanner.new("a")), StringScanner.rest?(StringScanner.new(""))])

# phase 2: flags and look-before patterns at the pointer
ss = StringScanner.new("abCD efg\nhi日本x")
StringScanner.skip(ss, /ab/)
p(StringScanner.scan(ss, /cd/i))
StringScanner.skip(ss, / /)
p(StringScanner.scan(ss, / e # a comment
                          f/x))
p(StringScanner.scan(ss, /g.h/m))
p(StringScanner.scan(ss, /[^\s]+/))
p([StringScanner.pos(ss), StringScanner.charpos(ss)])
p(StringScanner.scan_until(ss, /x/))
StringScanner.set_pos(ss, 2)
p(StringScanner.scan(ss, /\bC/))
p(StringScanner.scan(ss, /^D/))
p(StringScanner.scan(ss, /\A /))
p(StringScanner.scan_until(ss, /(?<=e)f/))
p(StringScanner.scan(ss, /(?<=b)C/))
p(StringScanner.scan(ss, /\bD/))
p(StringScanner.check_until(ss, /\bf/))
p(StringScanner.scan(ss, "D e"))
p(StringScanner.scan_until(ss, "本"))
p(StringScanner.rest(ss))

# scan_integer(base: 16): a keyword, as in Ruby
ss = StringScanner.new("0xFFz -1aG +0x 0XF")
p(StringScanner.scan_integer(ss, base: 16))
StringScanner.skip(ss, /z /)
p(StringScanner.scan_integer(ss, base: 16))
p(StringScanner.pos(ss))
StringScanner.skip(ss, /G /)
p(StringScanner.scan_integer(ss, base: 16))
p(StringScanner.matched(ss))
StringScanner.skip(ss, /x /)
p(StringScanner.scan_integer(ss, base: 16))
p(StringScanner.scan_integer(ss, base: 10))
begin
  StringScanner.scan_integer(ss, base: 8)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
