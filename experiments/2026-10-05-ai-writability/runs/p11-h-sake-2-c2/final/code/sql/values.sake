# SQL values (1.3, 1.9, 1.10, 7.1). A value is nil (NULL), an Integer, a Float (REAL), a String (TEXT)
# or a Blob (BLOB). Truth values are the values nil (unknown), 0 (false) and 1 (true).

# A BLOB: its bytes as upper case hex digits, two per byte. Hex strings of the same bytes are equal,
# and ordering the hex strings orders the bytes (unsigned, a prefix first), so no byte is ever decoded
# to compare, hash or sort a BLOB.
Blob = Struct.new(:hex)

module Values
  module_function

  # --- printing (1.3) ---

  # A REAL as printf("%.15g"), always with a ".0" or an exponent that has a fraction.
  def format_real(x)
    return "0.0" if x == 0.0
    s = format("%.15g", x)
    e = String.index(s, "e")
    if e == nil
      String.include?(s, ".") ? s : s + ".0"
    else
      mantissa = Text.slice(s, 0, e)
      String.include?(mantissa, ".") ? s : mantissa + ".0" + Text.slice(s, e, String.size(s) - e)
    end
  end

  # The text form of a value that is not NULL. A BLOB's is its bytes read as characters (7.1).
  def text_of(v)
    case v
    in Integer then Integer.to_s(v)
    in Float then format_real(v)
    in String then v
    in Blob then blob_text(v)
    else "NULL"
    end
  end

  # What a result row prints for a value: a BLOB as X'..' (7.1).
  def display(v)
    case v
    in nil then "NULL"
    in Blob then "X'#{Blob.hex(v)}'"
    else text_of(v)
    end
  end

  # 'null', 'integer', 'real', 'text' or 'blob'
  def type_name(v)
    case v
    in Integer then "integer"
    in Float then "real"
    in String then "text"
    in Blob then "blob"
    else "null"
    end
  end

  # --- BLOBs (7.1) ---

  def blob?(v)
    case v
    in Blob then true
    else false
    end
  end

  # The hex digits of a BLOB; "" for any other value.
  def hex_of(v)
    case v
    in Blob then Blob.hex(v)
    else ""
    end
  end

  # Two upper case hex digits for each byte of the text.
  def hex_of_text(s) = Array.join(Array.map(String.bytes(s)) { |b| format("%02X", b) }, "")

  # The BLOB of the bytes of a text.
  def blob_of_text(s) = Blob.new(hex_of_text(s))

  # A BLOB's bytes as characters; meant for printable ASCII bytes only, as the specification promises.
  def blob_text(b)
    h = Blob.hex(b)
    out = ""
    i = 0
    n = String.size(h)
    while i < n
      out = out + Integer.chr(String.hex(Text.byteslice(h, i, 2)))
      i += 2
    end
    out
  end

  # --- numbers ---

  # A value that is not NULL as a number: text, and a BLOB through its text form, is read by numeric
  # prefix (1.8, 7.5).
  def to_number(v)
    case v
    in Integer then v
    in Float then v
    in String then NumText.parse_prefix(v)
    in Blob then NumText.parse_prefix(blob_text(v))
    else 0
    end
  end

  # --- truth (1.10) ---

  # The truth value of a value: nil, 0 or 1.
  def truth(v)
    return nil if v == nil
    n = to_number(v)
    n == 0 ? 0 : 1
  end

  def from_bool(b) = b ? 1 : 0

  # --- order of values (1.9) ---

  def rank(v)
    case v
    in Integer then 1
    in Float then 1
    in String then 2
    in Blob then 3
    else 0
    end
  end

  # -1, 0 or 1: NULL < numbers < text < blobs; numbers by value; text and blobs byte by byte (7.2).
  def compare(a, b)
    ra = rank(a)
    rb = rank(b)
    return (ra < rb ? -1 : 1) if ra != rb
    return 0 if ra == 0
    if ra == 1
      x = to_number(a)
      y = to_number(b)
      return x < y ? -1 : (x > y ? 1 : 0)
    end
    x = ra == 3 ? hex_of(a) : text_of(a)
    y = ra == 3 ? hex_of(b) : text_of(b)
    x == y ? 0 : (x < y ? -1 : 1)
  end

  # --- affinity (1.9) ---

  # a and b are values neither of which is NULL; aff_a and aff_b are :integer, :real, :text or :none.
  # Returns the pair as they are compared.
  def apply_affinity(a, aff_a, b, aff_b)
    a_num = aff_a == :integer || aff_a == :real
    b_num = aff_b == :integer || aff_b == :real
    if a_num && (aff_b == :text || aff_b == :none)
      return [a, numeric_text(b)]
    end
    if b_num && (aff_a == :text || aff_a == :none)
      return [numeric_text(a), b]
    end
    if aff_a == :text && aff_b == :none
      return [a, number_to_text(b)]
    end
    if aff_b == :text && aff_a == :none
      return [number_to_text(a), b]
    end
    [a, b]
  end

  # Text that is a numeric literal becomes that number; anything else, a BLOB too (7.3), is unchanged.
  def numeric_text(v)
    case v
    in String
      n = NumText.parse_whole(v)
      n == nil ? v : n
    else v
    end
  end

  def number_to_text(v)
    case v
    in Integer then Integer.to_s(v)
    in Float then format_real(v)
    else v
    end
  end
end
