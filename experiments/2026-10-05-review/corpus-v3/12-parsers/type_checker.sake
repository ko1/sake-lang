class SyntaxErr < Exception
  attr_reader token
end

class TypeErr < Exception
end

def keywords = once { Array["let", "in", "if", "then", "else"] }

class Stream
  attr_reader tokens, pos
  def initialize(s) = @pos = 0

  def peek(s) = @tokens[@pos]

  def take(s)
    t = @tokens[@pos]
    raise SyntaxErr.new("unexpected end of input", "end") if t == nil
    @pos += 1
    t
  end

  def expect(s, want)
    t = take(s)
    raise SyntaxErr.new("expected '#{want}'", t) unless t == want
  end

  def expr(s)
    case peek(s)
    in "let"
      take(s)
      name = take(s)
      raise SyntaxErr.new("expected a name", name) unless String.match?(name, /\A[a-z_]\w*\z/)
      expect(s, "=")
      value = expr(s)
      expect(s, "in")
      [:let, name, value, expr(s)]
    in "if"
      take(s)
      c = expr(s)
      expect(s, "then")
      a = expr(s)
      expect(s, "else")
      [:if, c, a, expr(s)]
    else
      compare(s)
    end
  end

  def compare(s)
    left = concat(s)
    return [:bin, take(s), left, concat(s)] if peek(s) == "==" || peek(s) == "<"
    left
  end

  def concat(s)
    left = additive(s)
    left = [:bin, take(s), left, additive(s)] while peek(s) == "++"
    left
  end

  def additive(s)
    left = term(s)
    left = [:bin, take(s), left, term(s)] while peek(s) == "+" || peek(s) == "-"
    left
  end

  def term(s)
    left = atom(s)
    left = [:bin, take(s), left, atom(s)] while peek(s) == "*"
    left
  end

  def atom(s)
    t = take(s)
    if t == "("
      e = expr(s)
      expect(s, ")")
      e
    elsif String.match?(t, /\A\d+\z/)
      [:lit, String.to_i(t)]
    elsif String.start_with?(t, "\"")
      [:lit, t[1...-1]]
    elsif t == "true" || t == "false"
      [:lit, t == "true"]
    elsif String.match?(t, /\A[a-z_]\w*\z/) && !Array.include?(keywords, t)
      if peek(s) == "("
        take(s)
        arg = expr(s)
        expect(s, ")")
        return [:call, t, arg]
      end
      [:var, t]
    else
      raise SyntaxErr.new("unexpected token", t)
    end
  end
end

def parse(src)
  s = Stream.new(String.scan(src, /"[^"]*"|\d+|[a-z_]\w*|\+\+|==|\S/))
  e = Stream.expr(s)
  raise SyntaxErr.new("unexpected token", Stream.peek(s)) if Stream.peek(s)
  e
end

def builtins = once do
  Hash["len" => [:str, :int], "show" => [:int, :str], "not" => [:bool, :bool], "upcase" => [:str, :str]]
end

def type_of_value(v)
  case v
  in Integer then :int
  in String then :str
  in true | false then :bool
  end
end

def check(e, env)
  case e[0]
  in :lit then type_of_value(e[1])
  in :var
    _, name = e
    t = env[name]
    raise TypeErr, "unbound variable #{name}" if t == nil
    t
  in :let
    _, name, value, body = e
    check(body, Hash.merge(env, Hash[name => check(value, env)]))
  in :if
    _, cond, yes, no = e
    c = check(cond, env)
    raise TypeErr, "condition must be bool, got #{c}" unless c == :bool
    a = check(yes, env)
    b = check(no, env)
    raise TypeErr, "branches differ: #{a} vs #{b}" unless a == b
    a
  in :call
    _, fn, arg_expr = e
    sig = builtins[fn]
    raise TypeErr, "unknown function #{fn}" if sig == nil
    param, result = sig
    arg = check(arg_expr, env)
    raise TypeErr, "#{fn} expects #{param}, got #{arg}" unless arg == param
    result
  in :bin
    _, op, lhs, rhs = e
    l = check(lhs, env)
    r = check(rhs, env)
    case op
    in "+" | "-" | "*"
      raise TypeErr, "'#{op}' needs int operands, got #{l} and #{r}" unless l == :int && r == :int
      :int
    in "++"
      raise TypeErr, "'++' needs str operands, got #{l} and #{r}" unless l == :str && r == :str
      :str
    in "<"
      raise TypeErr, "'<' needs int operands, got #{l} and #{r}" unless l == :int && r == :int
      :bool
    in "=="
      raise TypeErr, "'==' compares #{l} with #{r}" unless l == r
      :bool
    end
  end
end

def evaluate(e, env)
  case e[0]
  in :lit then e[1]
  in :var then env[e[1]]
  in :let
    _, name, value, body = e
    evaluate(body, Hash.merge(env, Hash[name => evaluate(value, env)]))
  in :if
    _, cond, yes, no = e
    evaluate(cond, env) ? evaluate(yes, env) : evaluate(no, env)
  in :call
    _, fn, arg = e
    v = evaluate(arg, env)
    case fn
    in "len" then String.size(v)
    in "show" then Integer.to_s(v)
    in "not" then !v
    in "upcase" then String.upcase(v)
    end
  in :bin
    _, op, lhs, rhs = e
    a = evaluate(lhs, env)
    b = evaluate(rhs, env)
    case op
    in "+" then a + b
    in "-" then a - b
    in "*" then a * b
    in "++" then a + b
    in "<" then a < b
    in "==" then a == b
    end
  end
end

def show_value(v) = (v in String) ? Kernel.inspect(v) : Kernel.to_s(v)

programs = Array[
  "1 + 2 * 3",
  "let x = 5 in let y = x * x in y - x",
  "\"ab\" ++ show(len(\"hello\") + 1)",
  "if len(\"abc\") < 4 then upcase(\"short\") else \"long\"",
  "let ok = not(1 == 2) in if ok then 10 else 20",
  "let s = \"x\" in s == \"x\"",
  "1 + \"two\"",
  "if 1 then 2 else 3",
  "if true then 1 else \"one\"",
  "len(42)",
  "let a = 1 in b",
  "frob(1)",
  "\"a\" == 1",
  "let x = in 3",
  "(1 + 2",
  "1 2"
]
Array.each(programs) do |src|
  e = parse(src)
  t = check(e, Hash[])
  puts("#{src}\n  : #{t} = #{show_value(evaluate(e, Hash[]))}")
rescue SyntaxErr => err
  puts("#{src}\n  syntax error: #{Exception.message(err)} at '#{SyntaxErr.token(err)}'")
rescue TypeErr => err
  puts("#{src}\n  type error: #{Exception.message(err)}")
end
