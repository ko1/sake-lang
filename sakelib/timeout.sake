# timeout: Ruby's Timeout.timeout(sec) { ... }, as far as Sake allows.
#
# Ruby interrupts the block (Thread#raise). Sake has no way to interrupt a running thread, so the block runs
# in a Thread of its own and the caller waits for it, polling `Thread.alive?` until the deadline:
#   - finished in time: its value is returned, an exception in it is raised here (through Thread.value);
#   - not finished: TimeoutError is raised, and THE BLOCK KEEPS RUNNING in its thread until it ends by itself
#     (or the program ends). Its side effects after the deadline still happen; a loop that never ends
#     keeps a thread busy.
# A block run this way is in a thread: `break` and `return` out of it are errors, and the locals of the
# blocks around the call are copies (spec §15, Threads). `Timeout.timeout(nil) { }` and `0` run the block
# directly, as Ruby.
#
# Ruby's `timeout(sec, klass = nil, message = nil)`: `klass`, an exception class to raise instead, has no
# counterpart (exception types are not values); it is accepted only as nil, so Ruby's
# `Timeout.timeout(5, nil, "msg")` reads unchanged. Ruby's Timeout::Error is `TimeoutError` (no nested names).

class TimeoutError < StandardError
end

module Timeout
  module_function

  def timeout(sec, klass = nil, message = nil)
    return yield if sec == nil || sec == 0
    raise ArgumentError, "Timeout sec must be a non-negative number" if sec < 0
    raise ArgumentError, "Timeout.timeout: klass is not supported (exception types are not values)" if klass != nil
    deadline = Process.clock_gettime(Process.CLOCK_MONOTONIC) + sec
    t = Thread.new { yield }
    while Thread.alive?(t)
      remaining = deadline - Process.clock_gettime(Process.CLOCK_MONOTONIC)
      raise TimeoutError, (message || "execution expired") if remaining <= 0
      sleep(remaining < 0.005 ? remaining : 0.005)
    end
    Thread.value(t)
  end
end
