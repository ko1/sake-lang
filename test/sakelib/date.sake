require "date"

def show(label, x)
  puts("#{label}: #{Kernel.inspect(x)}")
end

def try_civil(y, m, d)
  begin
    Date.to_s(Date.civil(y, m, d))
  rescue DateError => e
    "Date::Error: #{Exception.message(e)}"
  end
end

def try_parse(s)
  begin
    Date.to_s(Date.parse(s))
  rescue DateError => e
    "Date::Error: #{Exception.message(e)}"
  end
end

def try_iso(s)
  begin
    Date.to_s(Date.iso8601(s))
  rescue DateError => e
    "Date::Error: #{Exception.message(e)}"
  end
end

def try_strptime(s, f)
  begin
    Date.to_s(Date.strptime(s, f))
  rescue DateError => e
    "Date::Error: #{Exception.message(e)}"
  end
end

# construction and validation
d = Date.civil(2024, 1, 31)
p(d)
puts(d)
show("fields", [Date.year(d), Date.month(d), Date.mon(d), Date.day(d), Date.mday(d)])
show("jd", [Date.jd(d), Date.mjd(d), Date.ld(d), Date.ajd(d)])
show("wday/yday", [Date.wday(d), Date.yday(d), Date.cwday(d), Date.cweek(d), Date.cwyear(d)])
show("negative", [try_civil(2024, -1, -1), try_civil(2024, 2, -1), try_civil(2023, 2, -1), try_civil(2024, 2, -30)])
show("invalid", [try_civil(2024, 2, 30), try_civil(2023, 2, 29), try_civil(2024, 13, 1), try_civil(2024, 0, 1), try_civil(2024, 4, 31)])
show("valid_date?", [Date.valid_date?(2024, 2, 29), Date.valid_date?(2023, 2, 29), Date.valid_date?(2024, 12, 31), Date.valid_civil?(2024, 6, 31)])
show("leap?", [Date.leap?(2024), Date.leap?(1900), Date.leap?(2000), Date.leap?(2023)])
show("leap? date", [Date.leap?(Date.civil(1500, 1, 1)), Date.leap?(Date.civil(1900, 1, 1)), Date.leap?(d)])
show("gregorian_leap?", [Date.gregorian_leap?(1500), Date.julian_leap?(1500)])
show("Date.jd", [Date.jd(0), Date.jd(2460341), Date.jd(2299160), Date.jd(2299161)])
show("ordinal", [Date.ordinal(2024, 60), Date.ordinal(2024, -1), Date.valid_ordinal?(2023, 366)])
show("commercial", [Date.commercial(2024, 1, 1), Date.commercial(2020, 53, 7), Date.valid_commercial?(2021, 53, 1)])

# calendar reform (Date::ITALY): Julian before 1582-10-15
show("reform", [Date.civil(1582, 10, 4) + 1, Date.civil(1582, 10, 15) - 1, try_civil(1582, 10, 10)])
show("julian", [Date.julian?(Date.civil(1582, 10, 4)), Date.gregorian?(Date.civil(1582, 10, 15))])
show("old diff", Date.civil(1000, 3, 1) - Date.civil(1000, 2, 28))
show("year 0 and negative", [Date.civil(0, 1, 1), Date.civil(-1, 12, 31), Date.civil(10000, 1, 1)])

# arithmetic
show("+", [d + 1, d + 30, d + -31, d - 365])
show("date - date", [Date.civil(2024, 3, 1) - Date.civil(2024, 2, 1), d - d, Date.civil(2023, 1, 1) - d])
show("to_i of diff", Rational.to_i(Date.civil(2025, 1, 1) - Date.civil(2024, 1, 1)))
show(">>", [d >> 1, d >> 2, d >> 12, d >> -1, Date.civil(2024, 2, 29) >> 12, d >> 13])
show("<<", [d << 1, d << 2, Date.civil(2024, 3, 31) << 1, Date.civil(2024, 1, 15) << 13])
show("next/prev", [Date.next_day(d), Date.prev_day(d), Date.next_month(d), Date.prev_month(d), Date.next_year(d), Date.prev_year(d)])
show("succ", [Date.succ(Date.civil(2023, 12, 31)), Date.next(d)])
show("leap next_year", Date.next_year(Date.civil(2024, 2, 29)))

# comparison
e = Date.civil(2024, 2, 1)
show("cmp", [d < e, d <= e, d > e, d >= e, d == Date.civil(2024, 1, 31), d != e, d <=> e, e <=> d, d <=> d])
show("== nil", d == nil)
show("sort", Array.sort(Array[e, d, Date.civil(2023, 5, 5)]))
show("max/min", [Array.max(Array[d, e]), Array.min(Array[d, e])])
show("include?", Array.include?(Array[d, e], Date.civil(2024, 2, 1)))

# iteration
xs = Array[]
Date.step(Date.civil(2024, 1, 1), Date.civil(2024, 1, 10), 3) { |x| Array.push(xs, Date.day(x)) }
show("step", xs)
xs = Array[]
Date.step(Date.civil(2024, 1, 10), Date.civil(2024, 1, 1), -4) { |x| Array.push(xs, Date.day(x)) }
show("step down", xs)
xs = Array[]
Date.upto(Date.civil(2024, 2, 27), Date.civil(2024, 3, 2)) { |x| Array.push(xs, Date.to_s(x)) }
show("upto", xs)
xs = Array[]
Date.downto(Date.civil(2024, 1, 2), Date.civil(2023, 12, 30)) { |x| Array.push(xs, Date.wday(x)) }
show("downto", xs)
xs = Array[]
Date.upto(Date.civil(2024, 1, 2), Date.civil(2024, 1, 1)) { |x| Array.push(xs, x) }
show("upto empty", xs)

# day predicates
show("weekday?", [Date.sunday?(d), Date.monday?(d), Date.wednesday?(d), Date.saturday?(Date.civil(2024, 2, 3))])

# week numbers around the year boundary
Array.each(Array[Date.civil(2020, 12, 31), Date.civil(2021, 1, 1), Date.civil(2021, 1, 4), Date.civil(2024, 12, 30), Date.civil(2027, 1, 1)]) do |x|
  puts("#{x} cw=#{Date.cwyear(x)}-#{Date.cweek(x)}-#{Date.cwday(x)} #{Date.strftime(x, "%U %W %V %G %g %j %u %w")}")
end

# formatting
puts(Date.strftime(d, "%Y-%m-%d %y %C %e %j %a %A %b %B %h"))
puts(Date.strftime(d, "%F | %D | %x | %T | %X | %R | %r | %c | %v | %+"))
puts(Date.strftime(d, "%-m/%-d %_m %^a %^B %10A|%-10A|%010A|%3N|%L|%N|%s|%Q"))
puts(Date.strftime(d, "%z %:z %::z %Z %H:%M:%S %I %l %p %P %% %n|%t|"))
puts(Date.strftime(Date.civil(5, 3, 7), "%Y %C %y %-d %e %10Y"))
puts(Date.strftime(Date.civil(-1, 1, 1), "%Y|%C|%y|%G"))
puts(Date.strftime(d, "no directives"))
puts(Date.strftime(d, ""))
puts(Date.strftime(d, "%Q%"))
puts(Date.strftime(Date.civil(2024, 7, 4), "%B %-d, %Y (%A)"))
show("iso8601", [Date.iso8601(d), Date.xmlschema(d), Date.rfc3339(d)])
show("httpdate", [Date.httpdate(d), Date.rfc2822(Date.civil(2024, 2, 5))])
show("to_time", Time.year(Date.to_time(d)))
show("to_date", Date.to_date(d) == d)
show("names", [Date.monthnames, Date.abbr_daynames])

# parsing
show("parse", Array.map(Array["2024-01-05", "2024/1/5", "20240105", "Jan 5 2024", "5 January 2024",
                              "January 5, 2024", "Fri, 5 Jan 2024", "2024-01-05T10:00:00+09:00",
                              "5th Mar 2024", "5 Jan 24", "5 Jan 99", "-0044-03-15"]) { |s| try_parse(s) })
show("parse bad", Array.map(Array["", "foo", "2024-02-30", "Foo 5 2024"]) { |s| try_parse(s) })
show("iso8601 parse", Array.map(Array["2024-01-05", "20240105", "2024-005", "2024005", "2024-W01-5",
                                      "2024W015", "2024-01-05T00:00:00Z", "2024-1-5", "x", "2024-13-01"]) { |s| try_iso(s) })
show("strptime", [try_strptime("2024-01-05", "%Y-%m-%d"), try_strptime("05/01/2024", "%d/%m/%Y"),
                  try_strptime("24/1/5", "%y/%m/%d"), try_strptime("Jan 5 2024", "%b %d %Y"),
                  try_strptime("2024 60", "%Y %j"), try_strptime("2024", "%Y"),
                  try_strptime("Friday, January 5, 2024", "%A, %B %d, %Y"),
                  try_strptime("2024-01-05", "%F"), try_strptime("01/05/24", "%D"),
                  try_strptime("100%", "100%%")])
show("strptime bad", [try_strptime("x", "%Y"), try_strptime("2024-02-30", "%Y-%m-%d"),
                      try_strptime("2024/01/05", "%Y-%m-%d"), try_strptime("", "%Y")])

# today
t = Time.now
today = Date.today
show("today", today == Date.civil(Time.year(t), Time.month(t), Time.day(t)) || Date.today != today)
