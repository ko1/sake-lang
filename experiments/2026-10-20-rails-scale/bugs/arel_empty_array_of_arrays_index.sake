# An empty `Array[]` (an Array of Arrays) makes its element type a bare Array, and indexing an element of the
# field then fails: "the receiver is Array, which cannot be indexed; defined for (Array, Integer), ...".
# Ruby: [] then [[1]] map(&:first) is fine. Expected: no error (the empty literal adds no element type).
# (Array.drop(Array[Any[nil]], 1) fails the same way.) Workaround in sakelib/rails/activerecord/active_record/result.sake: Any[].
class R
  attr_reader rows
end
def first_cells(r) = Array.map(R.rows(r)) { |row| row[0] }
db = SQLite3::Database.new(":memory:")
p(first_cells(R.new(Array.drop(SQLite3::Database.execute2(db, "select 1"), 1))))
p(first_cells(R.new(Array[])))
