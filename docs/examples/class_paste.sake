# B < A: A's definitions written again in B. Point3 is not a Point.
class Point
  attr_reader x, y
  def sum(pt) = @x + @y
  def describe(pt) = "#{name(pt)}(#{@x}, #{@y}) sum=#{sum(pt)}"
  def name(pt) = "Point"
end
class Point3 < Point
  attr_accessor z
  def initialize(p)
    @z = 0 if @z == nil
  end
  def sum(pt) = @x + @y + @z
  def name(pt) = "Point3"
end
class ParseError < Exception
  attr_reader line
end
puts(Point.describe(Point.new(1, 2)))
puts(Point3.describe(Point3.new(1, 2, 3)))
p(Point3.new(4, 5))
begin
  raise ParseError.new("bad", 3)
rescue ParseError => e
  p([Exception.message(e), e.ParseError.line])
end
