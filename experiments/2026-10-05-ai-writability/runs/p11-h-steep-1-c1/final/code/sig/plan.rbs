module Sql
  class Plan
    def column_count: () -> Integer
    def result_names: () -> Array[String?]
    def result_types: () -> Array[column_type?]
    def result_collations: () -> Array[collation?]
    def result_explicit: () -> Array[bool]
    def column_collations: () -> Array[collation]
    def outer_width: () -> Integer
  end
end
