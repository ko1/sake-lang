require "xml"

src = <<~XML
  <?xml version="1.0" encoding="UTF-8"?>
  <!-- top comment -->
  <library name="City" open='yes'>
    <book id="b1" lang="en">
      <title>Ruby &amp; Sake</title>
      <author>Matz</author>
      <year>1995</year>
    </book>
    <book id="b2">
      <title><![CDATA[<Types> & Operations]]></title>
      <author>Ko1</author>
      <tags><tag>lang</tag><tag>types</tag></tags>
    </book>
    <!-- a note -->
    <magazine id="m1"><title>Weekly &#65;&#x42;</title></magazine>
    <empty/>
  </library>
XML

doc = REXML::Document.new(src)
p(REXML::Document.version(doc))
p(REXML::Document.encoding(doc))
root = REXML::Document.root(doc)
root => REXML::Element
p(REXML::Element.name(root))
p(root["name"])
p(REXML::Element.attributes(root)["open"])
Hash.each(REXML::Element.attributes(root)) { |k, v| puts("#{k}=#{v}") }
p(REXML::Element.has_attributes?(root))
p(REXML::Element.has_elements?(root))

puts("== elements")
es = REXML::Element.elements(root)
p(REXML::Elements.size(es))
p(Array.map(REXML::Elements.to_a(es)) { |e| REXML::Element.name(e) })
first = es[1]
first => REXML::Element
p(first["id"])
p(REXML::Element.text(first, "title"))
p(REXML::Element.text(first))
b2 = es["book[@id='b2']"]
b2 => REXML::Element
p(REXML::Element.text(b2, "title"))
p(Array.map(REXML::Element.cdatas(REXML::Elements.[](REXML::Element.elements(b2), "title") || REXML::Element.new("x"))) { |c| REXML::CData.value(c) })
mt = es["magazine/title"]
p(mt ? REXML::Element.text(mt) : nil)
p(es[9])
p(es["nothing"])
REXML::Elements.each(es, "book") { |b| puts("book #{b["id"]}: #{REXML::Element.text(b, "author")}") }
REXML::Element.each_element(root) { |e| print(REXML::Element.name(e), " ") }
puts
p(Array.map(REXML::Element.comments(root)) { |c| REXML::Comment.string(c) })
p(Array.size(REXML::Element.texts(root)))
p(REXML::Element.has_text?(REXML::Element.new("x")))
p(REXML::Element.text(REXML::Elements.[](es, "empty") || REXML::Element.new("x")))

puts("== xpath")
def names(es) = Array.map(es) { |e| "#{REXML::Element.name(e)}#{e["id"] ? "#" + (e["id"] || "") : ""}" }
p(names(REXML::XPath.match(doc, "/library/book")))
p(names(REXML::XPath.match(doc, "//title")))
p(names(REXML::XPath.match(doc, "//tag")))
p(names(REXML::XPath.match(doc, "/library/*")))
p(names(REXML::XPath.match(doc, "//book[2]/author")))
p(names(REXML::XPath.match(doc, "//book[last()]")))
p(names(REXML::XPath.match(doc, "//*[@id]")))
p(names(REXML::XPath.match(doc, "//book[@lang='en']")))
p(names(REXML::XPath.match(doc, "//book[tags]")))
p(names(REXML::XPath.match(doc, "//tags/tag[1]")))
p(names(REXML::XPath.match(root, "book/title")))
p(names(REXML::XPath.match(root, "/library/magazine")))
p(names(REXML::XPath.match(root, ".")))
p(names(REXML::XPath.match(first, "..")))
p(names(REXML::XPath.match(doc, "/nothing")))
t = REXML::XPath.first(doc, "//tag[2]")
p(t ? REXML::Element.text(t) : nil)
REXML::XPath.each(doc, "//author") { |a| p(REXML::Element.text(a)) }
p(names(REXML::Element.get_elements(root, "book")))

puts("== children")
p(Array.size(REXML::Element.children(root)))
p(Array.map(REXML::Document.children(doc)) { |c| Kernel.to_s(c) })

puts("== to_s")
puts(Kernel.to_s(first))
puts(REXML::Document.to_s(REXML::Document.new("<a x=\"1\"><b>t &lt; u</b><c/><!--c--><![CDATA[d]]></a>")))
p(REXML::Document.to_s(REXML::Document.new("<a><b/></a>")))
p(REXML::Element.text(REXML::Document.root(REXML::Document.new("<a>\n<b>x</b>\n</a>")) || REXML::Element.new("x")))
p(REXML::Document.root(REXML::Document.new("")))
p(REXML::Element.text(REXML::Document.root(REXML::Document.new("<a>&foo; &lt;</a>")) || REXML::Element.new("x")))

puts("== building")
e = REXML::Element.new("new")
REXML::Element.add_attribute(e, "k", "a&b<c\"d'e")
REXML::Element.add_text(e, "x < y > z & w")
c = REXML::Element.add_element(e, "child", Hash["a" => "1"])
REXML::Element.add_attribute(c, "b", "2")
puts(Kernel.to_s(e))
p(REXML::Element.text(e))
p(REXML::Element.attributes(e)["k"])
p(REXML::Element.name(REXML::Element.parent(c) || REXML::Element.new("none")))
p(REXML::Element.name(REXML::Element.root(c)))
p(REXML::Element.name(REXML::Element.root(REXML::XPath.first(doc, "//tag") || e)))

puts("== errors")
Array.each(Array["<a><b></a>", "<a>", "<a/><b/>", "<a x=1/>", "<a x=\"1\" x=\"2\"/>", "text", "<a></b>", "<a><!-- x</a>", "</a>"]) do |s|
  begin
    REXML::Document.new(s)
    puts("ok: #{s}")
  rescue REXML::ParseException
    puts("ParseException: #{s}")
  end
end
