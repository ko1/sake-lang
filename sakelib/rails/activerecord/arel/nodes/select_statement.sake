# Port of activerecord-8.1.3/lib/arel/nodes/select_statement.rb (partial: no hash/eql?)

module Arel
  module Nodes
    class SelectStatement
      attr_reader cores
      attr_accessor limit, orders, lock, offset, with
      include NodeExpression
      def initialize(o) = @orders ||= Any[]

      # Ruby: SelectStatement.new(relation = nil); here the relation is given as the first field's seed
      # (SelectStatement.build(relation)), since `new` takes the fields.
      def build(relation = nil) = SelectStatement.new(SelectCore[SelectCore.build(relation)], orders: Any[])
    end
  end
end
