print(7 / 2, 7 / 2.0, 0.1 + 0.2, 1 == 1.0, -0.5 * 0)
print(int(-2.7), float("2"), min(3, 2.5), sort([2, 1.0, 1]), 2.5 > 2)
print(1.5, 007.50, 1_000.000_1, -0.0, 0.0001, 0.00009)
print(10.0 ** 15, 10.0 ** 16, 1234567890123456.5, 12345678901234567.0, 0.30000000000000004, 100.0, 123.456)
print(-7.5 % 2, -4.0 % 2, 2 ** -1.0, 2 ** 53 + 1 > 9007199254740992.0, [1] == [1.0], 0 == -0.0)
print(float("-0"), float(10 ** 20), type(1.5), min(1, 1.0), max(1.0, 1), 1.0 in [1])
print(10 ** 400 + 1 > 1.0)
try print(10.0 ** 400) catch e print(e) end
try print((-8.0) ** 0.5) catch e print(e) end
try print(10 ** 400 + 1.0) catch e print(e) end
try print(1.0 / 0) catch e print(e) end
try print(5 % -0.0) catch e print(e) end
try print(float("1.")) catch e print(e) end
try print(float("1e5")) catch e print(e) end
try print(float(10 ** 400)) catch e print(e) end
try print(float([])) catch e print(e) end
try print({1.0: 2}) catch e print(e) end
try print(range(1.0)) catch e print(e) end
try print(sort([1.5, "a"])) catch e print(e) end
try print(int([])) catch e print(e) end
try print(min(1, "a")) catch e print(e) end
