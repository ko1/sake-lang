require "rails/actionpack/action_dispatch/http/filter_parameters"

# config.filter_parameters (Rails 8's default list) reaches the request as "action_dispatch.parameter_filter"
filters = Any[:passw, :email, :secret, :token, :_key, :crypt, :salt, :certificate, :otp, :ssn, :cvv, :cvc]
env = Rack::MockRequest.env_for("/login?user=ann&password=hunter2&token=abc;page=2", method: "POST",
  params: Hash.of("user" => Hash.of("email" => "a@example.com", "name" => "Ann", "password" => "x"), "api_key" => "k"))
req = ActionDispatch::Request.new(env)
ActionDispatch::Request.env_config(req)["action_dispatch.parameter_filter"] = filters
p(ActionDispatch::Request.filtered_parameters(req))
p(ActionDispatch::Request.filtered_path(req))
p(Hash.slice(ActionDispatch::Request.filtered_env(req), "QUERY_STRING", "PATH_INFO", "REQUEST_METHOD"))   # (Rack caches the form in rack.request.form_vars, masked; Sake keeps it in rack.input)

# without filters nothing is masked, but the raw body still is in the env
req = ActionDispatch::Request.new(Rack::MockRequest.env_for("/x?password=1"))
p([ActionDispatch::Request.filtered_parameters(req), ActionDispatch::Request.filtered_path(req)])
