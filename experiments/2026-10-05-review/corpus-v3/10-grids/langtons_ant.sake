class Ant
  attr_accessor x, y, heading
end

def turn_right = once { Hash[north: :east, east: :south, south: :west, west: :north] }
def turn_left = once { Hash[north: :west, west: :south, south: :east, east: :north] }

def step_for(heading)
  case heading
  in :north then [0, -1]
  in :south then [0, 1]
  in :east then [1, 0]
  in :west then [-1, 0]
  end
end

class World
  attr_reader rule, cells, ant, steps

  def create(rule) = World.new(String.chars(rule), Hash.new(0), Ant.new(0, 0, :north), 0)

  def tick(w)
    ant = @ant
    pos = [Ant.get_x(ant), Ant.get_y(ant)]
    colour = @cells[pos]
    table = @rule[colour] == "R" ? turn_right : turn_left
    Ant.set_heading(ant, table[Ant.get_heading(ant)])
    nxt = (colour + 1) % Array.size(@rule)
    if nxt == 0
      Hash.delete(@cells, pos)
    else
      @cells[pos] = nxt
    end
    dx, dy = step_for(Ant.get_heading(ant))
    Ant.set_x(ant, Ant.get_x(ant) + dx)
    Ant.set_y(ant, Ant.get_y(ant) + dy)
    @steps += 1
  end

  def run(w, n)
    Integer.times(n) { tick(w) }
    w
  end

  def bounds(w)
    return nil if Hash.empty?(@cells)
    xs = Array.map(Hash.keys(@cells)) { |x, _y| x }
    ys = Array.map(Hash.keys(@cells)) { |_x, y| y }
    [Array.min(xs), Array.min(ys), Array.max(xs), Array.max(ys)]
  end

  def picture(w)
    b = bounds(w)
    return "(empty)" unless b
    x0, y0, x1, y1 = b
    glyphs = ".#o+*"
    Range.map(y0..y1) do |y|
      Range.map(x0..x1) do |x|
        x == Ant.get_x(@ant) && y == Ant.get_y(@ant) ? "A" : glyphs[@cells[[x, y]]]
      end.Array.join
    end.Array.join("\n")
  end

  def summary(w)
    counts = Array.tally(Hash.values(@cells))
    parts = Array.map(Array.sort(Hash.keys(counts))) { |c| "#{c}:#{counts[c]}" }
    "step #{@steps}: #{Hash.size(@cells)} coloured cells (#{Array.join(parts, " ")}), ant at (#{Ant.get_x(@ant)},#{Ant.get_y(@ant)}) facing #{Ant.get_heading(@ant)}"
  end
end

Array.each(Array[["RL", Array[11, 100, 389]], ["LLRR", Array[50, 200]], ["RLR", Array[120]]]) do |rule, checkpoints|
  puts("rule #{rule}")
  w = World.create(rule)
  Array.each(checkpoints) do |target|
    World.run(w, target - World.get_steps(w))
    puts("  #{World.summary(w)}")
  end
  puts(World.picture(w))
end
