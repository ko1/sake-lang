# Port of activerecord-8.1.3/lib/rails/generators/active_record/model/model_generator.rb and its template model.rb.tt (partial: no --parent/--database abstract classes, no namespaced module file)
#
# The model file is Ruby's class body as Rails writes it (app/models/post.rb): the Sake app keeps a model's
# class-body lines in that file, which ActiveRecord's generator reads at boot (railties' boot generator).

require "migration_generator"

module ActiveRecord
  module Generators
    module ModelGenerator
      A = Rails::Generators::GeneratedAttribute
      module_function

      # model.rb.tt
      def model_source(class_name, attributes, parent: "ApplicationRecord")
        s = "class #{class_name} < #{parent}\n"
        Array.each(Array.select(attributes) { |x| A.reference?(x) }) do |x|
          s += "  belongs_to :#{A.name(x)}#{A.polymorphic?(x) ? ", polymorphic: true" : ""}\n"
        end
        Array.each(Array.select(attributes) { |x| A.rich_text?(x) }) { |x| s += "  has_rich_text :#{A.name(x)}\n" }
        Array.each(Array.select(attributes) { |x| A.attachment?(x) }) { |x| s += "  has_one_attached :#{A.name(x)}\n" }
        Array.each(Array.select(attributes) { |x| A.attachments?(x) }) { |x| s += "  has_many_attached :#{A.name(x)}\n" }
        Array.each(Array.select(attributes) { |x| A.token?(x) }) do |x|
          s += "  has_secure_token#{A.name(x) != "token" ? " :#{A.name(x)}" : ""}\n"
        end
        s += "  has_secure_password\n" if Array.any?(attributes) { |x| A.password_digest?(x) }
        s + "end\n"
      end

      # Ruby: create_migration_file, create_model_file (hook_for :test_framework is not ported)
      def run(g, name, args, migration: true)
        n = Rails::Generators::Name.make(name, args)
        attrs = Rails::Generators::Name.attributes(n)
        Array.each(attrs) { |x| Rails::Generators::GeneratedAttribute.set_required(x, true) }
        Rails::Generators::Base.invoke(g, "active_record") do
          if migration
            table = Rails::Generators::Name.table_name(n)
            Rails::Generators::Migration.migration_template(g, "create_#{table}", MigrationGenerator.create_table_source(ActiveSupport::Inflector.camelize("create_#{table}"), table, attrs))
          end
          Rails::Generators::Base.create_file(g, "app/models/#{Rails::Generators::Name.file_name(n)}.rb", model_source(Rails::Generators::Name.class_name(n), attrs))
        end
        nil
      end
    end
  end
end
