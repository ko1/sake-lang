# Port of actionview-8.1.3/lib/action_view/helpers/sanitize_helper.rb (partial: no sanitizer_vendor switch (HTML4, Rails' default), no :scrubber option)
#
# Rails' class methods full_sanitizer / link_sanitizer / safe_list_sanitizer memoize one sanitizer per view
# class; here one per program (`once`). The sanitizers are rails/html/sanitizer.sake.

require "../../rails/html/sanitizer"
require "../../../activesupport/active_support/core_ext/string/output_safety"

module ActionView
  module Helpers
    module SanitizeHelper
      # Ruby: sanitize(html, options = {}) with tags: / attributes:
      def sanitize(v, html, tags: nil, attributes: nil)
        s = Rails::HTML4::SafeListSanitizer.sanitize(SanitizeHelper.safe_list_sanitizer, SanitizeHelper.html_string(html), tags: tags, attributes: attributes)
        s ? String.html_safe(s) : nil
      end

      def sanitize_css(v, style) = Rails::HTML4::SafeListSanitizer.sanitize_css(SanitizeHelper.safe_list_sanitizer, style)

      def strip_tags(v, html)
        s = Rails::HTML4::FullSanitizer.sanitize(SanitizeHelper.full_sanitizer, SanitizeHelper.html_string(html))
        s ? String.html_safe(s) : nil
      end

      def strip_links(v, html) = Rails::HTML4::LinkSanitizer.sanitize(SanitizeHelper.link_sanitizer, SanitizeHelper.html_string(html))

      module_function

      # Ruby's ClassMethods
      def full_sanitizer = once { Rails::HTML4::FullSanitizer.make }
      def link_sanitizer = once { Rails::HTML4::LinkSanitizer.make }
      def safe_list_sanitizer = once { Rails::HTML4::SafeListSanitizer.make }
      def sanitized_allowed_tags = Rails::HTML4::SafeListSanitizer.allowed_tags
      def sanitized_allowed_attributes = Rails::HTML4::SafeListSanitizer.allowed_attributes

      # (Sake only) the html as a String (a SafeBuffer's text), nil kept
      def html_string(html) = html == nil ? nil : Object.html_text(html)
    end
  end
end
