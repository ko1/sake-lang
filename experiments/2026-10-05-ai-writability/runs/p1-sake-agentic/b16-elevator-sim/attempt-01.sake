def ints_of(line)
  toks = String.split(String.strip(line), /\s+/)
  return nil unless Array.all?(toks) { |t| String.match?(t, /\A\d+\z/) }
  Array.map(toks) { |t| String.to_i(t) }
end

def valid_req?(v, n, prev)
  return false if v == nil
  return false if Array.size(v) != 3
  tt = v[0]
  ff = v[1]
  gg = v[2]
  return false if ff < 1 || ff > n || gg < 1 || gg > n
  return false if ff == gg
  return false if tt > 1000 || tt < prev
  true
end

def main
  lines = IO.readlines(IO.stdin)
  hv = lines[0] == nil ? nil : ints_of(lines[0])
  if hv == nil || Array.size(hv) != 3 || hv[0] < 2 || hv[0] > 50 || hv[1] > 5 || hv[2] < 1 || hv[2] > 20
    puts("invalid header")
    return
  end
  n = hv[0]
  dd = hv[1]
  cap = hv[2]
  ts = Integer[]
  fs = Integer[]
  gs = Integer[]
  prev = 0
  k = 1
  while k < Array.size(lines)
    line = lines[k]
    k += 1
    next if String.strip(line) == ""
    v = ints_of(line)
    if valid_req?(v, n, prev)
      Array.push(ts, v[0])
      Array.push(fs, v[1])
      Array.push(gs, v[2])
      prev = v[0]
    else
      puts("line #{k}: invalid request")
    end
  end
  m = Array.size(ts)
  if m == 0
    puts("no passengers")
    return
  end
  st = Array.new(m, 0)
  pick = Array.new(m, 0)
  drop = Array.new(m, 0)
  f = 1
  t = 0
  dir = 0
  done = 0
  while done < m
    Integer.times(m) { |i| st[i] = 1 if st[i] == 0 && ts[i] <= t }
    acted = false
    Integer.times(m) do |i|
      if st[i] == 2 && gs[i] == f
        st[i] = 3
        drop[i] = t
        done += 1
        acted = true
        puts("t=#{t} floor #{f} drop P#{i + 1}")
      end
    end
    break if done == m
    up = false
    down = false
    best = 0
    bestd = 1000
    any = false
    Integer.times(m) do |i|
      tg = 0
      if st[i] == 2
        tg = gs[i]
      elsif st[i] == 1
        tg = fs[i]
      else
        next
      end
      any = true
      up = true if tg > f
      down = true if tg < f
      d = tg > f ? tg - f : f - tg
      if d < bestd || (d == bestd && tg < best)
        bestd = d
        best = tg
      end
    end
    if dir == 1
      dir = up ? 1 : (down ? -1 : 0)
    elsif dir == -1
      dir = down ? -1 : (up ? 1 : 0)
    end
    if dir == 0 && any
      if best > f
        dir = 1
      elsif best < f
        dir = -1
      else
        found = false
        Integer.times(m) do |i|
          if !found && st[i] == 1 && fs[i] == f
            found = true
            dir = gs[i] > fs[i] ? 1 : -1
          end
        end
      end
    end
    riders = 0
    Integer.times(m) { |i| riders += 1 if st[i] == 2 }
    Integer.times(m) do |i|
      if st[i] == 1 && fs[i] == f && riders < cap
        idir = gs[i] > fs[i] ? 1 : -1
        if idir == dir
          st[i] = 2
          pick[i] = t
          riders += 1
          acted = true
          puts("t=#{t} floor #{f} pick P#{i + 1}")
        end
      end
    end
    if acted
      t += dd
    else
      f += dir
      t += 1
    end
  end
  sw = 0
  sr = 0
  Integer.times(m) do |i|
    w = pick[i] - ts[i]
    r = drop[i] - pick[i]
    sw += w
    sr += r
    puts("P#{i + 1} wait #{w} ride #{r}")
  end
  puts(format("average wait %.2f ride %.2f", sw / m.to_f, sr / m.to_f))
  puts("done at t=#{t}")
end

main
