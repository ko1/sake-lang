# Port of activerecord-8.1.3/lib/rails/generators/active_record/migration/migration_generator.rb and its templates migration.rb.tt and create_table_migration.rb.tt (partial: no join tables, no --primary-key-type, no --database)
#
# The template writes a Sake migration (the shape of ActiveRecord::Migration in this port: a class with name and
# version that includes ActiveRecord::Migration, `def change(m)`, the table definition through T):
#
#   Ruby (create_table_migration.rb.tt)            Sake
#   class CreatePosts < ActiveRecord::Migration[8.1]   class CreatePosts
#     def change                                       attr_reader name, version
#       create_table :posts do |t|                     include ActiveRecord::Migration
#         t.string :title                              ...
#                                                      create_table m, :posts do |t|
#                                                        T.string(t, :title)

require "rails/railties/rails/generators/named_base"
require "rails/railties/rails/generators/migration"

module ActiveRecord
  module Generators
    module MigrationGenerator
      A = Rails::Generators::GeneratedAttribute
      module_function

      def header(class_name)
        "class #{class_name}\n  attr_reader name, version\n  include ActiveRecord::Migration\n  T = ActiveRecord::ConnectionAdapters::TableDefinitionMethods\n\n"
      end

      # create_table_migration.rb.tt
      def create_table_source(class_name, table_name, attributes, timestamps: true)
        s = header(class_name)
        s += "  def change(m)\n    create_table m, :#{table_name} do |t|\n"
        Array.each(attributes) do |a|
          if Rails::Generators::GeneratedAttribute.password_digest?(a)
            s += "      T.string(t, :password_digest#{Rails::Generators::GeneratedAttribute.sake_options(a)})\n"
          elsif Rails::Generators::GeneratedAttribute.token?(a)
            s += "      T.string(t, :#{Rails::Generators::GeneratedAttribute.name(a)}#{Rails::Generators::GeneratedAttribute.sake_options(a)})\n"
          elsif !Rails::Generators::GeneratedAttribute.virtual?(a)
            s += "      T.#{Rails::Generators::GeneratedAttribute.type(a)}(t, :#{Rails::Generators::GeneratedAttribute.name(a)}#{Rails::Generators::GeneratedAttribute.sake_options(a)})\n"
          end
        end
        s += "\n" unless Array.empty?(attributes)
        s += "      T.timestamps(t)\n" if timestamps
        s += "    end\n"
        Array.each(Array.select(attributes) { |a| Rails::Generators::GeneratedAttribute.token?(a) }) do |a|
          s += "    add_index m, :#{table_name}, #{Rails::Generators::GeneratedAttribute.index_name(a)}, Hash.of(unique: true)\n"
        end
        Array.each(attributes_with_index(attributes)) do |a|
          s += "    add_index m, :#{table_name}, #{Rails::Generators::GeneratedAttribute.index_name(a)}#{Rails::Generators::GeneratedAttribute.sake_index_options(a)}\n"
        end
        s + "  end\nend\n"
      end

      def attributes_with_index(attributes) = Array.select(attributes) { |a| !Rails::Generators::GeneratedAttribute.reference?(a) && Rails::Generators::GeneratedAttribute.has_index?(a) }

      # migration.rb.tt: add_x_to_y, remove_x_from_y, or an empty change
      def migration_source(class_name, action, table_name, attributes)
        s = header(class_name) + "  def change(m)\n"
        Array.each(attributes) do |a|
          n = A.name(a)
          if action == "add"
            if A.reference?(a)
              s += "    add_reference m, :#{table_name}, :#{n}#{A.sake_options(a)}\n"
            elsif A.token?(a)
              s += "    add_column m, :#{table_name}, :#{n}, :string#{A.sake_options(a)}\n"
              s += "    add_index m, :#{table_name}, #{A.index_name(a)}, Hash.of(unique: true)\n"
            elsif !A.virtual?(a)
              s += "    add_column m, :#{table_name}, :#{n}, :#{A.type(a)}#{A.sake_options(a)}\n"
              s += "    add_index m, :#{table_name}, #{A.index_name(a)}#{A.sake_index_options(a)}\n" if A.has_index?(a)
            end
          elsif action == "remove"
            if A.reference?(a)
              s += "    remove_reference m, :#{table_name}, :#{n}#{A.sake_options(a)}\n"
            else
              s += "    remove_index m, :#{table_name}, #{A.index_name(a)}#{A.sake_index_options(a)}\n" if A.has_index?(a)
              s += "    remove_column m, :#{table_name}, :#{n}, :#{A.type(a)}#{A.sake_options(a)}\n" unless A.virtual?(a)
            end
          end
        end
        s + "  end\nend\n"
      end

      # Ruby: set_local_assigns! on the file name, then migration_template
      def run(g, name, args)
        n = Rails::Generators::Name.make(name, args)
        file_name = Rails::Generators::Name.file_name(n)
        raise Rails::Generators::Error, "Illegal name for migration file: #{file_name}\n\t(only lower case letters, numbers, and '_' allowed)." unless String.match?(file_name, /\A[_a-z0-9]+\z/)
        attrs = Rails::Generators::Name.attributes(n)
        Array.each(attrs) { |a| Rails::Generators::GeneratedAttribute.set_required(a, true) }
        class_name = ActiveSupport::Inflector.camelize(file_name)
        Rails::Generators::Base.invoke(g, "active_record") do
          if (m = String.match(file_name, /\A(add)_.*_to_(.*)/) || String.match(file_name, /\A(remove)_.*?_from_(.*)/))
            content = migration_source(class_name, Kernel.to_s(m[1]), ActiveSupport::Inflector.pluralize(Kernel.to_s(m[2])), attrs)
          elsif (m = String.match(file_name, /\Acreate_(.+)/))
            content = create_table_source(class_name, ActiveSupport::Inflector.pluralize(Kernel.to_s(m[1])), attrs)
          else
            content = migration_source(class_name, "", "", attrs)
          end
          Rails::Generators::Migration.migration_template(g, file_name, content)
        end
        nil
      end
    end
  end
end
