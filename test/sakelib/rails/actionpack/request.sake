require "rails/actionpack/action_dispatch/http/request"

# (Rails finds a controller's encoding template through the controller class; Sake has none to find.)

def show(label, v) = puts("#{label}: #{Kernel.inspect(v)}")
def mimes(list) = Array.map(list) { |m| Mime::Type.to_s(m) }

puts("-- a GET with a query string")
env = Rack::MockRequest.env_for("http://www.example.com:8080/posts/1.json?a[b]=1&c=2&list[]=x&list[]=y&page=3",
  headers: Hash.of("HTTP_ACCEPT" => "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "HTTP_USER_AGENT" => "Mozilla/5.0", "REMOTE_ADDR" => "127.0.0.1", "HTTP_X_REQUEST_ID" => "abc-123"))
req = ActionDispatch::Request.new(env)
show("request_method", ActionDispatch::Request.request_method(req))
show("request_method_symbol", ActionDispatch::Request.request_method_symbol(req))
show("method", ActionDispatch::Request.method(req))
show("get?", ActionDispatch::Request.get?(req))
show("head?", ActionDispatch::Request.head?(req))
show("path", ActionDispatch::Request.path(req))
show("fullpath", ActionDispatch::Request.fullpath(req))
show("original_fullpath", ActionDispatch::Request.original_fullpath(req))
show("url", ActionDispatch::Request.url(req))
show("original_url", ActionDispatch::Request.original_url(req))
show("protocol", ActionDispatch::Request.protocol(req))
show("host", ActionDispatch::Request.host(req))
show("port", ActionDispatch::Request.port(req))
show("host_with_port", ActionDispatch::Request.host_with_port(req))
show("standard_port?", ActionDispatch::Request.standard_port?(req))
show("optional_port", ActionDispatch::Request.optional_port(req))
show("port_string", ActionDispatch::Request.port_string(req))
show("domain", ActionDispatch::Request.domain(req))
show("subdomain", ActionDispatch::Request.subdomain(req))
show("subdomains", ActionDispatch::Request.subdomains(req))
show("domain(2)", ActionDispatch::Request.domain(req, 2))
show("user_agent", ActionDispatch::Request.user_agent(req))
show("accept", ActionDispatch::Request.accept(req))
show("x_request_id", ActionDispatch::Request.x_request_id(req))
show("remote_ip", ActionDispatch::Request.remote_ip(req))
show("ip", ActionDispatch::Request.ip(req))
show("local?", ActionDispatch::Request.local?(req))
show("xhr?", ActionDispatch::Request.xhr?(req))
show("ssl?", ActionDispatch::Request.ssl?(req))
show("query_parameters", ActionDispatch::Request.query_parameters(req))
show("request_parameters", ActionDispatch::Request.request_parameters(req))
ActionDispatch::Request.set_path_parameters(req, Hash.of(controller: "posts", action: "show", id: "1", format: "json"))
show("path_parameters", ActionDispatch::Request.path_parameters(req))
show("parameters", ActionDispatch::Request.parameters(req))
show("formats", mimes(ActionDispatch::Request.formats(req)))
show("format", Mime::Type.to_s(ActionDispatch::Request.format(req)))
show("format.ref", Mime::Type.ref(ActionDispatch::Request.format(req)))
show("accepts", mimes(ActionDispatch::Request.accepts(req)))
show("content_mime_type", ActionDispatch::Request.content_mime_type(req))
show("media_type", ActionDispatch::Request.media_type(req))
show("content_length", ActionDispatch::Request.content_length(req))
show("headers[User-Agent]", ActionDispatch::Request.headers(req)["User-Agent"])
show("headers[Content-Type]", ActionDispatch::Request.headers(req)["Content-Type"])
show("headers[REMOTE_ADDR]", ActionDispatch::Request.headers(req)["REMOTE_ADDR"])
show("headers.key?(Accept)", ActionDispatch::Http::Headers.key?(ActionDispatch::Request.headers(req), "Accept"))
show("headers.fetch(X-Missing, none)", ActionDispatch::Http::Headers.fetch(ActionDispatch::Request.headers(req), "X-Missing", "none"))
ActionDispatch::Request.headers(req)["X-Custom"] = "yes"
show("env HTTP_X_CUSTOM", ActionDispatch::Request.get_header(req, "HTTP_X_CUSTOM"))
show("inspect", ActionDispatch::Request.inspect(req))

puts("-- formats without a format parameter")
def formats_for(path, headers) = mimes(ActionDispatch::Request.formats(ActionDispatch::Request.new(Rack::MockRequest.env_for(path, headers: headers))))
show("browser Accept", formats_for("/posts", Hash.of("HTTP_ACCEPT" => "text/html,application/xhtml+xml,*/*;q=0.8")))
show("json Accept", formats_for("/posts", Hash.of("HTTP_ACCEPT" => "application/json")))
show("two types", formats_for("/posts", Hash.of("HTTP_ACCEPT" => "application/json, text/plain;q=0.5")))
show("path extension", formats_for("/posts.csv", Hash.new))
show("xhr", formats_for("/posts", Hash.of("HTTP_X_REQUESTED_WITH" => "XMLHttpRequest")))
show("nothing", formats_for("/posts", Hash.new))
r = ActionDispatch::Request.new(Rack::MockRequest.env_for("/posts", headers: Hash.of("HTTP_ACCEPT" => "application/json")))
html = Mime.fetch(:html) || Mime.ALL
json = Mime.fetch(:json) || Mime.ALL
show("negotiate_mime", Mime::Type.to_s(ActionDispatch::Request.negotiate_mime(r, Mime::Type[html, json]) || Mime.ALL))
show("negotiate_mime none", ActionDispatch::Request.negotiate_mime(r, Mime::Type[html]))
show("should_apply_vary_header?", ActionDispatch::Request.should_apply_vary_header?(r))

puts("-- a POST with a form body")
env = Rack::MockRequest.env_for("/posts?x=1", method: "POST", input: "post[title]=Hello+World&post[tags][]=a&post[tags][]=b&commit=Save")
env["CONTENT_TYPE"] = "application/x-www-form-urlencoded"
req = ActionDispatch::Request.new(env)
show("post?", ActionDispatch::Request.post?(req))
show("form_data?", ActionDispatch::Request.form_data?(req))
show("media_type", ActionDispatch::Request.media_type(req))
show("content_length", ActionDispatch::Request.content_length(req))
show("raw_post", ActionDispatch::Request.raw_post(req))
show("request_parameters", ActionDispatch::Request.request_parameters(req))
show("parameters", ActionDispatch::Request.parameters(req))

puts("-- a POST with a JSON body")
env = Rack::MockRequest.env_for("/api/posts", method: "POST", input: "{\"post\":{\"title\":\"Hi\",\"n\":3,\"tags\":[\"a\",null]},\"ok\":true}")
env["CONTENT_TYPE"] = "application/json; charset=utf-8"
req = ActionDispatch::Request.new(env)
show("content_mime_type", Mime::Type.to_s(ActionDispatch::Request.content_mime_type(req) || Mime.ALL))
show("media_type", ActionDispatch::Request.media_type(req))
show("request_parameters", ActionDispatch::Request.request_parameters(req))
env = Rack::MockRequest.env_for("/api/posts", method: "POST", input: "[1,2]")
env["CONTENT_TYPE"] = "application/json"
show("JSON array", ActionDispatch::Request.request_parameters(ActionDispatch::Request.new(env)))
env = Rack::MockRequest.env_for("/api/posts", method: "POST", input: "{oops")
env["CONTENT_TYPE"] = "application/json"
begin
  ActionDispatch::Request.request_parameters(ActionDispatch::Request.new(env))
rescue ActionDispatch::Http::Parameters::ParseError => e
  show("ParseError", Exception.message(e))
end

puts("-- errors")
begin
  ActionDispatch::Request.query_parameters(ActionDispatch::Request.new(Rack::MockRequest.env_for("/?a[]=1&a[b]=2")))
rescue ActionController::BadRequest => e
  show("BadRequest", Exception.message(e))
end
begin
  ActionDispatch::Request.request_method(ActionDispatch::Request.new(Rack::MockRequest.env_for("/", method: "BREW")))
rescue ActionController::UnknownHttpMethod => e
  show("UnknownHttpMethod", Exception.message(e))
end

puts("-- forwarded host, https")
req = ActionDispatch::Request.new(Rack::MockRequest.env_for("https://app.example.co.uk/x", headers: Hash.of("HTTP_X_FORWARDED_HOST" => "a.example.com, shop.example.co.uk")))
show("raw_host_with_port", ActionDispatch::Request.raw_host_with_port(req))
show("host", ActionDispatch::Request.host(req))
show("port", ActionDispatch::Request.port(req))
show("url", ActionDispatch::Request.url(req))
show("domain(2)", ActionDispatch::Request.domain(req, 2))
show("subdomain(2)", ActionDispatch::Request.subdomain(req, 2))
show("ip host domain", ActionDispatch::Request.domain(ActionDispatch::Request.new(Rack::MockRequest.env_for("http://192.168.1.10/"))))
req = ActionDispatch::Request.new(Rack::MockRequest.env_for("/", method: "PATCH"))
show("patch?", ActionDispatch::Request.patch?(req))
ActionDispatch::Request.set_request_method(req, "DELETE")
show("request_method=", [ActionDispatch::Request.request_method(req), ActionDispatch::Request.delete?(req), ActionDispatch::Request.method(req)])

puts("-- conditional GET")
res = ActionDispatch::Response.new
ActionDispatch::Response.set_etag(res, "post-1")
req = ActionDispatch::Request.new(Rack::MockRequest.env_for("/", headers: Hash.of("HTTP_IF_NONE_MATCH" => "#{ActionDispatch::Response.etag(res)}, \"other\"")))
show("if_none_match_etags", ActionDispatch::Request.if_none_match_etags(req))
show("fresh? by etag", ActionDispatch::Request.fresh?(req, res))
show("fresh? no headers", ActionDispatch::Request.fresh?(ActionDispatch::Request.new(Rack::MockRequest.env_for("/")), res))
ActionDispatch::Response.set_last_modified(res, Time.utc(2026, 10, 1))
req = ActionDispatch::Request.new(Rack::MockRequest.env_for("/", headers: Hash.of("HTTP_IF_MODIFIED_SINCE" => "Tue, 20 Oct 2026 00:00:00 GMT")))
show("if_modified_since", ActionDispatch::Request.if_modified_since(req))
show("fresh? by date", ActionDispatch::Request.fresh?(req, res))
req = ActionDispatch::Request.new(Rack::MockRequest.env_for("/", headers: Hash.of("HTTP_IF_MODIFIED_SINCE" => "Tue, 01 Sep 2026 00:00:00 GMT")))
show("stale by date", ActionDispatch::Request.fresh?(req, res))
