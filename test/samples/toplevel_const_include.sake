# `include ::Comparable` names the top-level Comparable even where Outer::Comparable hides it.
class Outer
  module Comparable
    def <(a, b) = (a <=> b) == -1
  end
  class V
    attr_reader n
    include ::Comparable
    def <=>(a, b) = @n <=> V.n(b)
  end
end
p(Outer::V.new(1) <=> Outer::V.new(2))
p(Outer::V.new(1) < Outer::V.new(2))
