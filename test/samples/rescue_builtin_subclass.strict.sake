# A class declared under a built-in exception is caught by that built-in's rescue (and its Ruby parents'), as in Ruby.
class ConvError < RangeError
end
class MissingKey < KeyError
end
def conv(k)
  raise ConvError, "conv" if k == 0
  raise MissingKey, "missing" if k == 1
  raise FloatDomainError, "domain" if k == 2
  k
end
Array.each(Any[0, 1, 2, 3]) do |k|
  begin
    p conv(k)
  rescue RangeError => e
    puts "range: " + Exception.message(e)
  rescue IndexError => e
    puts "index: " + Exception.message(e)
  end
end
