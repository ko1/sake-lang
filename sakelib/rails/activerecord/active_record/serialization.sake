# Port of activerecord-8.1.3/lib/active_record/serialization.rb
#
# Over ActiveModel::Serializers::JSON (as_json, to_json, from_json, serializable_hash), which Ruby's module
# includes and the model includes here just before this one (a module including it would check its functions
# without a model); include_root_in_json is false as Ruby's included block sets it. Ruby's `super(options)` is ActiveModel's body by name.

module ActiveRecord
  module Serialization
    def include_root_in_json = false

    # Ruby excludes the inheritance column ("type") when the table has it
    def serializable_hash(r, options = nil)
      return super_serializable_hash(r, options) unless Array.include?(column_names, inheritance_column)
      opts = options ? Hash.dup(options) : Hash.new
      except = Array.map(Array.wrap(opts[:except])) { |x| Kernel.to_s(x) }
      Array.push(except, inheritance_column) unless Array.include?(except, inheritance_column)
      opts[:except] = except
      super_serializable_hash(r, opts)
    end

    def inheritance_column = "type"

    def attribute_names_for_serialization(r) = attribute_names_of(r)
  end
end
