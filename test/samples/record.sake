# `{...}` is a Record; its type is its set of (field, type) pairs.
def stats(xs)
  total = Array.sum(xs)
  {count: Array.size(xs), total: total, mean: total / Array.size(xs)}
end

r = stats(Array[1, 2, 3, 6])
p(r)
r => {count:, mean: avg}
puts(count)
puts(avg)
p({y: 2, x: 1})
p([{a: 1}, {a: "s"}])
puts(r == nil)
pt = {x: 1}
pt => {z:}
