# Collations (7.1-7.4): the rule by which two TEXT values compare. A collation is named by one of the
# lower-case words "binary", "nocase" and "rtrim"; those names are what columns, sort terms and
# keys carry (the user's spelling is checked once, by canonical).

# The collation of an expression: strength 0 none, 1 implicit (a column's), 2 explicit (COLLATE).
# name is "binary" when the strength is 0, so the name alone is what a comparison under it uses.
Coll = Struct.new(:strength, :name)

module Collation
  module_function

  def none = Coll.new(0, "binary")

  def implicit(name) = Coll.new(1, name)

  def explicit(name) = Coll.new(2, name)

  # The lower-case name of the collation written `written` (any case); the error if there is none.
  def canonical(written)
    k = String.downcase(written)
    Errors.sql_error("no such collation sequence: #{written}") unless k == "binary" || k == "nocase" || k == "rtrim"
    k
  end

  # The text as it is compared under the collation: texts are equal under it exactly when their
  # folds are equal, and they order as their folds do.
  def fold(name, s)
    case name
    in "nocase" then ascii_lower(s)
    in "rtrim" then StrFn.trim(s, " ", :right)
    else s
    end
  end

  # The text with only the ASCII letters A-Z changed to lower case.
  def ascii_lower(s)
    return String.downcase(s) if String.ascii_only?(s)
    Array.join(Array.map(String.chars(s)) { |c| String.ord(c) >= 65 && String.ord(c) <= 90 ? String.downcase(c) : c }, "")
  end

  # --- the collation of an expression (7.3), on a resolved expression ---

  def of(e)
    case Expr.kind(e)
    in :collate | :ref then Expr.coll(e)
    in :pos | :cast then of(Expr.args(e)[0])
    else none
    end
  end

  # --- which collation a comparison uses (7.4) ---

  # The name of the collation of `a op b`: an explicit one (a's first), else an implicit one (a's
  # first), else binary.
  def pick(a, b)
    return Coll.name(a) if Coll.strength(a) == 2
    return Coll.name(b) if Coll.strength(b) == 2
    return Coll.name(a) if Coll.strength(a) == 1
    return Coll.name(b) if Coll.strength(b) == 1
    "binary"
  end

  # The same for the operand expressions `left` and `right` of a comparison.
  def choose(left, right) = pick(of(left), of(right))

  # The name of the collation the values of one expression are compared under among themselves.
  def name_of(e) = Coll.name(of(e))

  # The names of the collations.
  def names(colls)
    out = String[]
    Array.each(colls) { |c| Array.push(out, Coll.name(c)) }
    out
  end
end
