def digits?(s) = String.match?(s, /\A[0-9]+\z/)

def all_digits?(toks) = Array.all?(toks) { |s| digits?(s) }

lines = IO.readlines(IO.stdin)
head = Array.size(lines) > 0 ? String.split(String.strip(lines[0])) : Array[]
ok = Array.size(head) == 3 && all_digits?(head)
if ok
  nn = String.to_i(head[0])
  dd = String.to_i(head[1])
  cc = String.to_i(head[2])
  ok = nn >= 2 && nn <= 50 && dd <= 5 && cc >= 1 && cc <= 20
end
unless ok
  puts("invalid header")
  exit(0)
end

ts = Integer[]
fs = Integer[]
gs = Integer[]
prev = 0
k = 1
while k < Array.size(lines)
  toks = String.split(String.strip(lines[k]))
  if Array.size(toks) > 0
    good = Array.size(toks) == 3 && all_digits?(toks)
    if good
      t = String.to_i(toks[0])
      f = String.to_i(toks[1])
      g = String.to_i(toks[2])
      good = f >= 1 && f <= nn && g >= 1 && g <= nn && f != g && t <= 1000 && t >= prev
      if good
        Array.push(ts, t)
        Array.push(fs, f)
        Array.push(gs, g)
        prev = t
      end
    end
    puts("line #{k + 1}: invalid request") unless good
  end
  k += 1
end

n = Array.size(ts)
if n == 0
  puts("no passengers")
  exit(0)
end

pick = Array.new(n, 0)
drop = Array.new(n, 0)
waiting = Integer[]
riders = Integer[]
nxt = 0
t = 0
f = 1
dir = 0
dropped = 0
while dropped < n
  while nxt < n && ts[nxt] <= t
    Array.push(waiting, nxt)
    nxt += 1
  end
  drops = Array.sort(Array.select(riders) { |id| gs[id] == f })
  riders = Array.reject(riders) { |id| gs[id] == f }
  Array.each(drops) do |id|
    puts("t=#{t} floor #{f} drop P#{id + 1}")
    drop[id] = t
    dropped += 1
  end
  has_up = Array.any?(riders) { |id| gs[id] > f } || Array.any?(waiting) { |id| fs[id] > f }
  has_dn = Array.any?(riders) { |id| gs[id] < f } || Array.any?(waiting) { |id| fs[id] < f }
  if dir == 1
    dir = has_up ? 1 : (has_dn ? -1 : 0)
  elsif dir == -1
    dir = has_dn ? -1 : (has_up ? 1 : 0)
  end
  if dir == 0 && (Array.size(riders) > 0 || Array.size(waiting) > 0)
    targets = Array.map(riders) { |id| gs[id] } + Array.map(waiting) { |id| fs[id] }
    best = Array.min(Array.map(targets) { |x| [Integer.abs(x - f), x] })
    bf = best[1]
    if bf > f
      dir = 1
    elsif bf < f
      dir = -1
    else
      w = Array.find(waiting) { |id| fs[id] == f }
      dir = gs[w] > f ? 1 : -1
    end
  end
  picked = Integer[]
  if dir != 0
    Array.each(waiting) do |id|
      d2 = gs[id] > fs[id] ? 1 : -1
      if fs[id] == f && d2 == dir && Array.size(riders) < cc
        Array.push(riders, id)
        Array.push(picked, id)
      end
    end
  end
  Array.each(picked) do |id|
    puts("t=#{t} floor #{f} pick P#{id + 1}")
    pick[id] = t
  end
  waiting = Array.reject(waiting) { |id| Array.include?(picked, id) }
  if Array.size(drops) > 0 || Array.size(picked) > 0
    t += dd
  else
    f += dir
    t += 1
  end
end

sw = 0
sr = 0
i = 0
while i < n
  w = pick[i] - ts[i]
  r = drop[i] - pick[i]
  puts("P#{i + 1} wait #{w} ride #{r}")
  sw += w
  sr += r
  i += 1
end
puts(format("average wait %.2f ride %.2f", Integer.fdiv(sw, n), Integer.fdiv(sr, n)))
puts("done at t=#{Array.max(drop)}")
