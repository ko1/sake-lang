# Port of activesupport-8.1.3/lib/active_support/core_ext/string/access.rb

class String
  def at(s, position) = s[position]
  def from(s, position) = String.[](s, position, String.length(s))

  def to(s, position)
    position += String.size(s) if position < 0
    String.[](s, 0, position + 1) || ""
  end

  def first(s, limit = 1) = String.[](s, 0, limit) || raise(ArgumentError, "negative limit")

  def last(s, limit = 1)
    String.[](s, Array.max(Integer[String.length(s) - limit, 0]) || 0, limit) || raise(ArgumentError, "negative limit")
  end
end
