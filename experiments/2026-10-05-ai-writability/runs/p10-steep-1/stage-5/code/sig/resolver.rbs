module Sql
  class Resolver
    type mode = :allow | :where | :group_by | :order

    COMPARISONS: Array[String]

    @scope: Scope
    @aliases: Hash[String, Ast::Expr]
    @mode: mode
    @slots: AggregateSlots?

    def initialize: (Scope scope, Hash[String, Ast::Expr] aliases, ?mode mode, ?AggregateSlots? slots) -> void
    def resolve: (Ast::Expr expr) -> Ast::Expr

    private

    def resolve_column: (Ast::ColumnRef ref) -> Ast::Expr
    def resolve_binary: (Ast::Binary expr) -> Ast::Binary
    def resolve_is: (Ast::Is expr) -> Ast::Is
    def operand: (Ast::Expr expr) -> Ast::Expr
    def plan_of: (Ast::Query select) -> Plan
    def resolve_scalar: (Ast::ScalarSubquery expr, bool compared) -> Ast::ScalarPlan
    def resolve_in_subquery: (Ast::InSubquery expr) -> Ast::InPlan
    def reject_aggregate: (String name, bool by_alias) -> bot
    def resolve_case: (Ast::CaseExpr expr) -> Ast::CaseExpr
    def resolve_call: (Ast::FunctionCall call) -> Ast::Expr
    def resolve_aggregate: (Ast::FunctionCall call, String function) -> Ast::Expr
    def argument_resolver: () -> Resolver
  end
end
