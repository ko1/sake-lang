# Port of actionview-8.1.3/lib/action_view/unbound_template.rb (partial: no per-locals Template cache)

require "template"
require "template_details"

module ActionView
  class UnboundTemplate
    attr_reader source, identifier, details, virtual_path

    def locale(u) = TemplateDetails.locale(@details)
    def format(u) = TemplateDetails.format(@details)
    def variant(u) = TemplateDetails.variant(@details)
    def handler(u) = TemplateDetails.handler(@details)

    def bind_locals(u, locals) = build_template(u, Array.sort(Array.uniq(locals)))

    def build_template(u, locals)
      v = variant(u)
      Template.make(@source, @identifier, handler(u), locals: locals, format: TemplateDetails.format_or_default(@details),
                    variant: v ? Symbol.to_s(v) : nil, virtual_path: @virtual_path)
    end
  end
end
