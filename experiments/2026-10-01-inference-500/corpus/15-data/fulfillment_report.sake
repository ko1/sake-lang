Product = Struct.new(:sku, :name, :category, :price, :weight_g)
Order = Struct.new(:id, :customer, :placed, :promised, :lines)
OrderLine = Struct.new(:sku, :qty)
Shipment = Struct.new(:order_id, :sku, :qty, :shipped, :carrier)

def products
  Product[
    Product.new("TEA-01", "Sencha 100g", :tea, 1290, 120),
    Product.new("TEA-02", "Genmaicha 200g", :tea, 990, 220),
    Product.new("TEA-03", "Matcha 30g", :tea, 2450, 45),
    Product.new("POT-01", "Kyusu teapot", :ware, 5800, 650),
    Product.new("CUP-01", "Yunomi cup", :ware, 1600, 210),
    Product.new("ACC-01", "Bamboo whisk", :accessory, 1850, 40)
  ]
end

def orders
  Order[
    Order.new(501, "Hana", 2, 5, OrderLine[OrderLine.new("TEA-01", 2), OrderLine.new("CUP-01", 2)]),
    Order.new(502, "Ivo", 2, 4, OrderLine[OrderLine.new("POT-01", 1), OrderLine.new("TEA-03", 1), OrderLine.new("ACC-01", 1)]),
    Order.new(503, "Jun", 3, 6, OrderLine[OrderLine.new("TEA-02", 5)]),
    Order.new(504, "Kai", 4, 7, OrderLine[OrderLine.new("TEA-09", 1), OrderLine.new("CUP-01", 4)]),
    Order.new(505, "Lea", 5, 8, OrderLine[OrderLine.new("TEA-03", 3), OrderLine.new("ACC-01", 1)]),
    Order.new(506, "Mo", 6, 9, OrderLine[OrderLine.new("POT-01", 2)])
  ]
end

def shipments
  Shipment[
    Shipment.new(501, "TEA-01", 2, 3, "post"), Shipment.new(501, "CUP-01", 2, 4, "post"),
    Shipment.new(502, "POT-01", 1, 6, "courier"), Shipment.new(502, "TEA-03", 1, 3, "post"),
    Shipment.new(503, "TEA-02", 3, 5, "post"), Shipment.new(504, "CUP-01", 4, 6, "courier"),
    Shipment.new(505, "TEA-03", 3, 6, "post"), Shipment.new(505, "ACC-01", 1, 6, "post"),
    Shipment.new(507, "TEA-01", 1, 7, "post")
  ]
end

def yen(n) = "¥" + String.reverse(Array.join(String.scan(String.reverse(Integer.to_s(n)), /\d{1,3}/), ","))

def fulfillment(order, shipped_qty)
  lines = Order.lines(order)
  wanted = Array.sum(lines) { OrderLine.qty(it) }
  sent = Array.sum(lines) { |l| shipped_qty[[Order.id(order), OrderLine.sku(l)]] }
  if sent == 0 then :pending
  elsif sent < wanted then :partial
  else :complete
  end
end

catalog = Hash[]
Array.each(products) { |p| catalog[Product.sku(p)] = p }
all_orders = orders
order_ids = Set[]
Array.each(all_orders) { Set.add(order_ids, Order.id(it)) }

shipped_qty = Hash.new(0)
last_ship = Hash[]
stray = Shipment[]
all_shipments = shipments
Array.each(all_shipments) do |s|
  unless Set.include?(order_ids, Shipment.order_id(s))
    Array.push(stray, s)
    next
  end
  key = [Shipment.order_id(s), Shipment.sku(s)]
  shipped_qty[key] += Shipment.qty(s)
  prev = last_ship[Shipment.order_id(s)]
  last_ship[Shipment.order_id(s)] = Shipment.shipped(s) if prev == nil || Shipment.shipped(s) > prev
end

puts("Orders")
revenue_by_cat = Hash.new(0)
problems = Array[]
Array.each(all_orders) do |o|
  id = Order.id(o)
  total = 0
  weight = 0
  Array.each(Order.lines(o)) do |l|
    begin
      p = Hash.fetch(catalog, OrderLine.sku(l))
    rescue KeyError
      Array.push(problems, "order #{id}: unknown sku #{OrderLine.sku(l)}")
      next
    end
    amount = Product.price(p) * OrderLine.qty(l)
    total += amount
    weight += Product.weight_g(p) * OrderLine.qty(l)
    revenue_by_cat[Product.category(p)] += amount
  end
  status = fulfillment(o, shipped_qty)
  done = last_ship[id]
  timing = case status
           in :complete then done && done > Order.promised(o) ? "late by #{done - Order.promised(o)}d" : "on time"
           in :partial then "waiting"
           in :pending then "not shipped"
           end
  puts(format("  #%d %-5s %10s %5.2fkg  %-8s %s", id, Order.customer(o), yen(total), weight / 1000.0, Symbol.to_s(status), timing))
end

puts
puts("Open lines")
Array.each(all_orders) do |o|
  Array.each(Order.lines(o)) do |l|
    sent = shipped_qty[[Order.id(o), OrderLine.sku(l)]]
    missing = OrderLine.qty(l) - sent
    next if missing <= 0
    p = catalog[OrderLine.sku(l)]
    name = p ? Product.name(p) : "?"
    puts(format("  #%d %-7s %-15s %d of %d outstanding", Order.id(o), OrderLine.sku(l), name, missing, OrderLine.qty(l)))
  end
end

puts
puts("Revenue by category")
cat_total = Array.sum(Hash.values(revenue_by_cat))
Array.each(Hash.sort_by(revenue_by_cat) { |c, v| 0 - v }) do |c, v|
  puts(format("  %-10s %10s %5.1f%%", Symbol.to_s(c), yen(v), v * 100.0 / cat_total))
end

puts
puts("Carriers")
by_carrier = Array.group_by(Array.reject(all_shipments) { Array.include?(stray, it) }) { Shipment.carrier(it) }
Hash.each(by_carrier) do |carrier, list|
  days = Array.map(list) do |s|
    o = Array.find(all_orders) { Order.id(it) == Shipment.order_id(s) }
    o ? Shipment.shipped(s) - Order.placed(o) : 0
  end
  puts(format("  %-8s %d parcels, avg %.1f days after order", carrier, Array.size(list), Array.sum(days) * 1.0 / Array.size(days)))
end

puts
puts("Problems")
Array.each(problems) { puts("  #{it}") }
Array.each(stray) { |s| puts("  shipment for unknown order #{Shipment.order_id(s)} (#{Shipment.sku(s)})") }
never = Array.reject(products) { |p| Array.any?(all_orders) { |o| Array.any?(Order.lines(o)) { |l| OrderLine.sku(l) == Product.sku(p) } } }
Array.each(never) { |p| puts("  #{Product.sku(p)} was never ordered") }
