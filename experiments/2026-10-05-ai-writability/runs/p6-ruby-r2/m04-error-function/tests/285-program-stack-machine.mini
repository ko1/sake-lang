fn run(code)
  let stack = []
  for op in split(code, " ") do
    match op
    when "+" then push(stack, pop(stack) + pop(stack))
    when "*" then push(stack, pop(stack) * pop(stack))
    when "dup" then
      let top = pop(stack)
      push(stack, top)
      push(stack, top)
    else push(stack, int(op))
    end
  end
  return stack
end
print(run("2 3 + dup *"), run("1 2 3"))
try
  run("1 +")
catch e
  print("error:", e.message)
end
