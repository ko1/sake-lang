# FIXED in 23307e9a (the lead); the ActionController workaround was removed.
# Generated code cannot add a function to a namespaced class the program declares. A generator may only write
# `def K.f` (the spec: generated source is read first, so it must not open the class), but for K = Admin::PostsController
# `def Admin::PostsController.f` is rejected ("def A::B.f"), and inside `module Admin`, `def PostsController.f` is
# rejected too ("write `def f` (it defines Admin.f)"). Opening `module Admin; class PostsController` in generated code
# makes it the first class, so the program's `class PostsController < ActionController::Base` is then an error.
# Ruby: Admin::PostsController.define_method / class_eval work. Found by part 8: the controllers generator writes
# `def Admin::PostsController._class_name(c)` for a namespaced controller (Rails' admin/ namespace), a syntax error.
module Admin
  def PostsC.f(c) = "gen #{g(c)}"     # error: `def PostsC.f` inside `Admin`: write `def f`
end
module Admin
  class PostsC
    attr_reader x
    def g(c) = @x
  end
end
p(Admin::PostsC.f(Admin::PostsC.new(1)))   # wanted: "gen 1"
