Book = Struct.new(:isbn, :title, :author, :copies, :on_loan)
Member = Struct.new(:id, :name, :limit, :fines)
Loan = Struct.new(:isbn, :member_id, :out_day, :due_day, :back_day)
LoanError = Exception.new(:code)

def loan_days = 14
def fine_per_day = 25
def fine_cap = 500

class Book
  def available(b) = @copies - @on_loan
end

class Library
  attr_reader books, members, loans
  def create = Library.new(Hash[], Hash[], Loan[])

  def add_book(lib, isbn, title, author, copies)
    @books[isbn] = Book.new(isbn, title, author, copies, 0)
  end

  def add_member(lib, id, name, limit)
    @members[id] = Member.new(id, name, limit, 0)
  end

  def open_loans_of(lib, member_id)
    Array.select(@loans) { |l| Loan.member_id(l) == member_id && Loan.back_day(l) == nil }
  end

  def checkout(lib, member_id, isbn, day)
    member = @members[member_id]
    raise LoanError.new("no such member #{member_id}", :member) if member == nil
    book = @books[isbn]
    raise LoanError.new("no such book #{isbn}", :book) if book == nil
    if Member.fines(member) > 0
      raise LoanError.new("#{Member.name(member)} owes #{Member.fines(member)} cents", :fines)
    end
    if Array.size(open_loans_of(lib, member_id)) >= Member.limit(member)
      raise LoanError.new("#{Member.name(member)} reached the limit", :limit)
    end
    if Book.available(book) <= 0
      raise LoanError.new("'#{Book.title(book)}' is not available", :copies)
    end
    Book.set_on_loan(book, Book.on_loan(book) + 1)
    loan = Loan.new(isbn, member_id, day, day + loan_days, nil)
    Array.push(@loans, loan)
    loan
  end

  def checkin(lib, member_id, isbn, day)
    loan = Array.find(@loans) do |l|
      Loan.member_id(l) == member_id && Loan.isbn(l) == isbn && Loan.back_day(l) == nil
    end
    raise LoanError.new("#{member_id} has no open loan of #{isbn}", :loan) unless loan
    Loan.set_back_day(loan, day)
    book = Hash.fetch(@books, isbn)
    Book.set_on_loan(book, Book.on_loan(book) - 1)
    late = day - Loan.due_day(loan)
    fine = 0
    if late > 0
      fine = Integer.clamp(late * fine_per_day, 0, fine_cap)
      member = Hash.fetch(@members, member_id)
      Member.set_fines(member, Member.fines(member) + fine)
    end
    fine
  end

  def pay(lib, member_id, amount)
    member = Hash.fetch(@members, member_id)
    paid = Integer.clamp(amount, 0, Member.fines(member))
    Member.set_fines(member, Member.fines(member) - paid)
    paid
  end

  def overdue(lib, today)
    Array.select(@loans) { |l| Loan.back_day(l) == nil && Loan.due_day(l) < today }
  end
end

def money(cents) = format("$%d.%02d", cents / 100, cents % 100)

def try(label)
  result = yield
  puts("ok   #{label}: #{result}")
rescue LoanError => e
  puts("FAIL #{label}: #{Exception.message(e)} [#{LoanError.code(e)}]")
end

lib = Library.create
Library.add_book(lib, "978-0", "The Pragmatic Programmer", "Hunt", 2)
Library.add_book(lib, "978-1", "Refactoring", "Fowler", 1)
Library.add_book(lib, "978-2", "Domain-Driven Design", "Evans", 1)
Library.add_book(lib, "978-3", "Clean Architecture", "Martin", 3)
Library.add_member(lib, 1, "Ana", 2)
Library.add_member(lib, 2, "Ben", 3)
Library.add_member(lib, 3, "Cho", 1)

events = Array[
  [1, :out, 1, "978-0"], [2, :out, 1, "978-1"], [2, :out, 2, "978-1"],
  [3, :out, 1, "978-3"], [3, :out, 2, "978-0"], [4, :out, 3, "978-0"],
  [5, :out, 3, "978-2"], [6, :out, 2, "978-3"], [9, :out, 4, "978-2"], [10, :in, 2, "978-1"],
  [12, :out, 2, "978-1"], [20, :in, 1, "978-0"], [21, :in, 3, "978-2"],
  [22, :out, 3, "978-3"], [23, :pay, 3, "300"], [24, :in, 1, "978-1"],
  [30, :in, 2, "978-0"], [31, :pay, 3, "1000"], [32, :out, 3, "978-3"],
  [40, :in, 1, "978-3"]
]

Array.each(events) do |day, kind, who, arg|
  label = "day #{day} #{kind} m#{who} #{arg}"
  case kind
  in :out
    try(label) { "due day #{Loan.due_day(Library.checkout(lib, who, arg, day))}" }
  in :in
    try(label) { "fine #{money(Library.checkin(lib, who, arg, day))}" }
  in :pay
    try(label) { "paid #{money(Library.pay(lib, who, String.to_i(arg)))}" }
  end
end

puts
puts("Overdue on day 40:")
Array.each(Library.overdue(lib, 40)) do |l|
  book = Hash.fetch(Library.books(lib), Loan.isbn(l))
  member = Hash.fetch(Library.members(lib), Loan.member_id(l))
  days = 40 - Loan.due_day(l)
  puts(format("  %-28s %-4s %3d days late", Book.title(book), Member.name(member), days))
end

puts
puts("Shelf:")
Hash.each_value(Library.books(lib)) do |b|
  puts(format("  %-28s %-7s %d/%d available", Book.title(b), Book.author(b), Book.available(b), Book.copies(b)))
end

puts
puts("Members:")
Hash.each_value(Library.members(lib)) do |m|
  n = Array.size(Library.open_loans_of(lib, Member.id(m)))
  puts(format("  %-4s loans=%d fines=%s", Member.name(m), n, money(Member.fines(m))))
end

counts = Array.tally(Array.map(Library.loans(lib)) { |l| Loan.isbn(l) })
top_n = Array.max(Hash.values(counts))
tops = Hash.keys(Hash.select(counts) { |isbn, n| n == top_n })
titles = Array.map(tops) { |isbn| Book.title(Hash.fetch(Library.books(lib), isbn)) }
puts("Most borrowed (#{top_n} loans): #{Array.join(titles, ", ")}")
