# GROUP BY and aggregate evaluation (spec 3.3): turns the rows that passed WHERE into group rows.
#
# A group row is the group's representative source row followed by one value per Aggregate of the
# plan, so the plan's expressions (which read aggregates as Cols past the table's columns) evaluate
# on it with the ordinary Evaluator.
module Grouping
  module_function

  # The group rows of `rows` that pass HAVING, in order of first appearance.
  def group_rows(plan, rows, prefix)
    aggs = Plan.aggregates(plan)
    out = Array[]
    Array.each(partition(Plan.group(plan), rows)) do |members|
      group_row = Array.dup(representative(plan, members, prefix))
      Array.concat(group_row, Array.map(aggs) { Aggregates.compute(it, members) })
      Array.push(out, group_row) if Evaluator.passes?(Plan.having(plan), group_row)
    end
    out
  end

  # The rows split by the values of the GROUP BY terms; without terms, one group (even of no rows).
  def partition(terms, rows)
    return Array[rows] if Array.empty?(terms)
    index = Hash[]
    groups = Array[]
    colls = Array.map(terms) { ExprCollation.of(it) }
    Array.each(rows) do |row|
      key = terms_key(terms, colls, row)
      slot = index[key]
      if slot == nil
        index[key] = Array.size(groups)
        Array.push(groups, Array[row])
      else
        Array.push(Array.fetch(groups, slot), row)
      end
    end
    groups
  end

  # The row bare columns read: with a single aggregate that is min / max, the row that gave the
  # extreme; else the first row; the prefix and NULLs for a group of no rows.
  def representative(plan, members, prefix)
    aggs = Plan.aggregates(plan)
    if Array.size(aggs) == 1
      agg = Array.fetch(aggs, 0)
      if Aggregate.fn(agg) == "min" || Aggregate.fn(agg) == "max"
        best = Aggregates.extreme_row(agg, members)
        return best unless best == nil
      end
    end
    return Array.fetch(members, 0) unless Array.empty?(members)
    Array.concat(Array.dup(prefix), Array.new(Plan.width(plan), nil))
  end

  # The Hash key of `row` under GROUP BY / PARTITION BY `terms`, each under its collation in `colls`.
  def terms_key(terms, colls, row) = Array.map(Array.each_with_index(terms)) { |t, k| key_of(Evaluator.evaluate(t, row), Array.fetch(colls, k)) }

  # A row of values as a Hash key (see key_of), column k under the collation colls[k].
  def row_key(vals, colls) = Array.map(Array.each_with_index(vals)) { |v, k| key_of(v, Array.fetch(colls, k)) }

  # A value as a Hash key that treats equal values as one (a whole REAL is the INTEGER it equals, TEXT
  # equal under `coll` is the same text).
  def key_of(v, coll)
    case v
    in Float then Coercion.whole_in_64_bits?(v) ? Float.to_i(v) : v
    in String then Collation.fold(v, coll)
    else v
    end
  end
end
