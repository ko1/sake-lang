# Port of activerecord-8.1.3/lib/arel/nodes/inner_join.rb, outer_join.rb, right_outer_join.rb,
# full_outer_join.rb, string_join.rb and leading_join.rb (one file: six one-line subclasses of Join)

module Arel
  module Nodes
    class InnerJoin
      attr_accessor left, right
      include Join
    end

    class OuterJoin
      attr_accessor left, right
      include Join
    end

    class RightOuterJoin
      attr_accessor left, right
      include Join
    end

    class FullOuterJoin
      attr_accessor left, right
      include Join
    end

    class StringJoin
      attr_accessor left, right
      include Join
    end

    class LeadingJoin
      attr_accessor left, right
      include Join
    end
  end
end
