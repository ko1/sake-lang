# Port of activerecord-8.1.3/lib/arel/nodes/homogeneous_in.rb (partial: no hash/eql?)
#
# Ruby's proc_for_binds is a lambda that wraps each value in an ActiveModel::Attribute named after the
# column; here it is that name, and the Bind collector makes the Attributes (Arel::Collectors::Bind.add_binds).

module Arel
  module Nodes
    class HomogeneousIn
      attr_reader values, attribute, type
      include Node
      def equality?(o) = @type == :in
      def invert(o) = HomogeneousIn.new(@values, @attribute, @type == :in ? :notin : :in)
      def left(o) = @attribute
      def right(o) = Arel::Attributes::Attribute.quoted_array(@attribute, @values)
      def casted_values(o)
        type = Arel::Attributes::Attribute.type_caster(@attribute)
        casted = Array.map(@values) do |raw_value|
          ActiveModel::Type::Value.serializable?(type, raw_value) ? ActiveModel::Type::Value.serialize(type, raw_value) : nil
        end
        Array.compact!(casted)
        casted
      end
      def proc_for_binds(o) = Arel::Attributes::Attribute.name(@attribute)
    end
  end
end
