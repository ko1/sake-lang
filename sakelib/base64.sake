# base64: Ruby's Base64 module (base64 0.3) in Sake.
#
# Encoding works on the bytes of any String; decoding gives a binary (ASCII-8BIT) String, as Ruby's
# does (relabel it with String.force_encoding(s, "UTF-8") for text).
# Ruby's keyword option becomes a Record as the optional second argument:
#   Ruby  Base64.urlsafe_encode64(s, padding: false)
#   Sake  Base64.urlsafe_encode64(s, {padding: false})

module Base64
  module_function

  def encode64(bin) = Array.pack(Array[bin], "m")

  # unpack1("m") always gives a String; the `|| ""` is for the checker.
  def decode64(str) = String.unpack1(str, "m") || ""

  def strict_encode64(bin) = Array.pack(Array[bin], "m0")

  # Ruby's message, without the built-in's "String.unpack1: " prefix.
  def strict_decode64(str)
    String.unpack1(str, "m0") || ""
  rescue ArgumentError
    raise ArgumentError, "invalid base64"
  end

  # Option: padding (default true).
  def urlsafe_encode64(bin, o = {padding: true})
    s = String.tr(strict_encode64(bin), "+/", "-_")
    padding = (o in {padding: x}) ? x : true
    padding ? s : String.delete_suffix(String.delete_suffix(s, "="), "=")
  end

  # Missing padding is accepted, as in Ruby.
  def urlsafe_decode64(str)
    s = str
    if !String.end_with?(s, "=") && String.size(s) % 4 != 0
      s = String.ljust(s, (String.size(s) + 3) & ~3, "=")
    end
    strict_decode64(String.tr(s, "-_", "+/"))
  end
end
