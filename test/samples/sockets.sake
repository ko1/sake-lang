# sake: --strict
# A server and a client in one program: TCPServer on a free port, a thread accepting one connection.
srv = TCPServer.new("127.0.0.1", 0)
port = TCPServer.port(srv)
server = Thread.new do
  c = TCPServer.accept(srv)
  line = Socket.gets(c)
  Socket.write(c, "echo: #{line}")
  Socket.close(c)
end
s = Socket.connect("127.0.0.1", port)
Socket.write(s, "hello\n")
puts(Socket.gets(s))
Socket.close(s)
Thread.join(server)
TCPServer.close(srv)
