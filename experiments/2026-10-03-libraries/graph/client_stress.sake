# Stress: one program, several node types (Integer, Symbol, String, Tuple), and a large graph.

# 1. Integer nodes: a 60x60 grid-like graph with pseudo-random weights (LCG, reproducible).
def lcg(s) = (s * 1103515245 + 12345) % 2147483648

n = 40
big = Graph.undirected_graph
seed = 42
Integer.times(n * n) do |i|
  r = i / n
  c = i % n
  if c + 1 < n
    seed = lcg(seed)
    Graph.add_edge(big, i, i + 1, seed % 9 + 1)
  end
  if r + 1 < n
    seed = lcg(seed)
    Graph.add_edge(big, i, i + n, seed % 9 + 1)
  end
end
t0 = Time.now
far = Graph.shortest_path(big, 0, n * n - 1)
t1 = Time.now
if far
  cost, path = far
  puts("int grid: #{Graph.size(big)} nodes, #{Array.size(Graph.edges(big))} edges; 0 -> #{n * n - 1} cost #{cost}, #{Array.size(path)} nodes")
end
puts(format("  dijkstra took %.2fs", Time.to_f(t1) - Time.to_f(t0)))
puts("  bfs visits #{Array.size(Graph.bfs(big, 0))}, dfs visits #{Array.size(Graph.dfs(big, 0))}")

# 2. Symbol nodes: a long chain, topologically sorted (deep recursion in topo_visit).
chain = Graph.directed_graph
Integer.times(3000) { |i| Graph.add_edge(chain, String.to_sym("s#{i}"), String.to_sym("s#{i + 1}")) }
order = Graph.topo_sort(chain)
puts("symbol chain: #{Array.size(order)} nodes, first #{order[0]}, last #{order[-1]}")

# 3. Tuple nodes and String nodes in the same program as above.
words = Graph.undirected_graph
dict = Array["cold", "cord", "card", "ward", "warm", "word", "worm", "wore", "core", "care"]
Array.each(dict) do |a|
  Array.each(dict) do |b|
    diff = Array.count(Array.zip(String.chars(a), String.chars(b))) { |x, y| x != y }
    Graph.add_edge(words, a, b) if diff == 1 && a < b
  end
end
ladder = Graph.bfs_path(words, "cold", "warm")
puts("word ladder: #{Array.join(ladder, " > ")}") if ladder

knight = Graph.undirected_graph
Integer.times(8) do |r|
  Integer.times(8) do |c|
    Array.each(Array[[1, 2], [2, 1], [2, -1], [1, -2]]) do |dr, dc|
      nr = r + dr
      nc = c + dc
      Graph.add_edge(knight, [r, c], [nr, nc]) if nr < 8 && nc >= 0 && nc < 8
    end
  end
end
moves = Graph.bfs_path(knight, [0, 0], [7, 7])
puts("knight a1 -> h8: #{Array.size(moves) - 1} moves via #{Array.join(Array.map(moves) { |r, c| "#{Integer.chr(97 + c)}#{r + 1}" }, " ")}") if moves

# 4. Mixed node types in ONE graph: Ruby would allow it; does Sake?
mixed = Graph.directed_graph
Graph.add_edge(mixed, 1, "one")
Graph.add_edge(mixed, "one", :one)
Graph.add_edge(mixed, :one, [1, 1])
p(Graph.topo_sort(mixed))
p(Graph.components(mixed))
