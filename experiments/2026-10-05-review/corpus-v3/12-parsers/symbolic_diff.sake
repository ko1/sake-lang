class Num
  attr_reader value
end

class Var
  attr_reader name
end

class Bin
  attr_reader op, left, right
end

class Fn
  attr_reader name, arg
end

class ParseError < Exception
  attr_reader pos
end

class Parser
  attr_reader tokens, pos
  def initialize(p) = @pos = 0

  def peek(ps) = @tokens[@pos]

  def advance(ps)
    t = @tokens[@pos]
    @pos += 1
    t
  end

  def expect(ps, t)
    raise ParseError.new("expected #{t}", @pos) unless peek(ps) == t
    advance(ps)
  end

  def expr(ps)
    e = term(ps)
    e = Bin.new(advance(ps), e, term(ps)) while peek(ps) == "+" || peek(ps) == "-"
    e
  end

  def term(ps)
    e = unary(ps)
    e = Bin.new(advance(ps), e, unary(ps)) while peek(ps) == "*" || peek(ps) == "/"
    e
  end

  def unary(ps)
    if peek(ps) == "-"
      advance(ps)
      return Bin.new("*", Num.new(-1), unary(ps))
    end
    power(ps)
  end

  def power(ps)
    base = primary(ps)
    if peek(ps) == "^"
      advance(ps)
      return Bin.new("^", base, unary(ps))
    end
    base
  end

  def primary(ps)
    t = advance(ps)
    raise ParseError.new("unexpected end", @pos) if t == nil
    if t == "("
      e = expr(ps)
      expect(ps, ")")
      e
    elsif String.match?(t, /\A\d+\z/)
      Num.new(String.to_i(t))
    elsif String.match?(t, /\A\d+\.\d+\z/)
      Num.new(String.to_f(t))
    elsif Array.include?(Array["sin", "cos", "exp", "ln"], t)
      expect(ps, "(")
      e = expr(ps)
      expect(ps, ")")
      Fn.new(t, e)
    elsif String.match?(t, /\A[a-z]\z/)
      Var.new(t)
    else
      raise ParseError.new("unexpected '#{t}'", @pos - 1)
    end
  end
end

def parse(src)
  ps = Parser.new(String.scan(src, /\d+\.\d+|\d+|[a-z]+|\S/))
  e = Parser.expr(ps)
  raise ParseError.new("trailing '#{Parser.peek(ps)}'", Parser.pos(ps)) if Parser.peek(ps)
  e
end

def num?(e, v) = (e in Num) && Num.value(e) == v

def add(a, b)
  return b if num?(a, 0)
  return a if num?(b, 0)
  return Num.new(Num.value(a) + Num.value(b)) if (a in Num) && (b in Num)
  Bin.new("+", a, b)
end

def sub(a, b)
  return a if num?(b, 0)
  return Num.new(Num.value(a) - Num.value(b)) if (a in Num) && (b in Num)
  Bin.new("-", a, b)
end

def mul(a, b)
  return Num.new(0) if num?(a, 0) || num?(b, 0)
  return b if num?(a, 1)
  return a if num?(b, 1)
  return Num.new(Num.value(a) * Num.value(b)) if (a in Num) && (b in Num)
  Bin.new("*", a, b)
end

def div(a, b)
  return a if num?(b, 1)
  return Num.new(0) if num?(a, 0)
  Bin.new("/", a, b)
end

def pow(a, b)
  return Num.new(1) if num?(b, 0)
  return a if num?(b, 1)
  Bin.new("^", a, b)
end

def derive(e, x)
  case e
  in Num then Num.new(0)
  in Var then Num.new(Var.name(e) == x ? 1 : 0)
  in Fn
    u = Fn.arg(e)
    du = derive(u, x)
    case Fn.name(e)
    in "sin" then mul(Fn.new("cos", u), du)
    in "cos" then mul(mul(Num.new(-1), Fn.new("sin", u)), du)
    in "exp" then mul(e, du)
    in "ln" then div(du, u)
    end
  in Bin
    l = Bin.left(e)
    r = Bin.right(e)
    dl = derive(l, x)
    dr = derive(r, x)
    case Bin.op(e)
    in "+" then add(dl, dr)
    in "-" then sub(dl, dr)
    in "*" then add(mul(dl, r), mul(l, dr))
    in "/" then div(sub(mul(dl, r), mul(l, dr)), pow(r, Num.new(2)))
    in "^"
      if r in Num
        mul(mul(r, pow(l, Num.new(Num.value(r) - 1))), dl)
      else
        mul(e, add(mul(dr, Fn.new("ln", l)), div(mul(r, dl), l)))
      end
    end
  end
end

def prec = once { Hash["+" => 1, "-" => 1, "*" => 2, "/" => 2, "^" => 3] }

def show(e, outer)
  case e
  in Num
    s = Kernel.to_s(Num.value(e))
    Num.value(e) < 0 && outer > 0 ? "(#{s})" : s
  in Var then Var.name(e)
  in Fn then "#{Fn.name(e)}(#{show(Fn.arg(e), 0)})"
  in Bin
    op = Bin.op(e)
    p = prec[op]
    left = show(Bin.left(e), op == "^" ? p + 1 : p)
    right = show(Bin.right(e), op == "^" ? p : p + 1)
    s = op == "^" ? "#{left}^#{right}" : "#{left} #{op} #{right}"
    p < outer ? "(#{s})" : s
  end
end

def evaluate(e, env)
  case e
  in Num then Num.value(e)
  in Var then env[Var.name(e)]
  in Fn
    v = evaluate(Fn.arg(e), env)
    case Fn.name(e)
    in "sin" then Math.sin(v)
    in "cos" then Math.cos(v)
    in "exp" then Math.exp(v)
    in "ln" then Math.log(v)
    end
  in Bin
    a = evaluate(Bin.left(e), env)
    b = evaluate(Bin.right(e), env)
    case Bin.op(e)
    in "+" then a + b
    in "-" then a - b
    in "*" then a * b
    in "/" then a / b
    in "^" then a ** b
    end
  end
end

inputs = Array["x^3 + 2*x", "sin(x) * x", "exp(2*x) / x", "ln(x^2 + 1)", "3 * y + x * y",
               "-x^2", "x^x", "(1 + x) * (1 - x)", "cos(sin(x))", "2 * (x + ", "x $ 2", "sqrt(x)"]
x0 = 1.5
h = 0.000001
Array.each(inputs) do |src|
  f = parse(src)
  df = derive(f, "x")
  exact = Float.round(evaluate(df, Hash["x" => x0, "y" => 2.0]), 4)
  numeric = Float.round((evaluate(f, Hash["x" => x0 + h, "y" => 2.0]) - evaluate(f, Hash["x" => x0 - h, "y" => 2.0])) / (2 * h), 4)
  puts("f(x)  = #{show(f, 0)}")
  puts("f'(x) = #{show(df, 0)}")
  puts("f'(#{x0}) = #{exact} (numeric #{numeric})#{Float.abs(exact - numeric) < 0.001 ? "" : " MISMATCH"}")
rescue ParseError => e
  puts("#{src}: parse error at token #{ParseError.pos(e)}: #{Exception.message(e)}")
end
