<% post = @post || raise(ArgumentError, "@post is not set") %>
<% content_for view, :title do %>Post <%= Post.title(post) %><% end %>
<%= render post %>
<%= render "form", post: post %>
<%= render partial: "posts/form", locals: {post: post, title: "Again"} %>
<h3>Comments</h3>
<%= render @comments %>
<%= render partial: "comments/comment", collection: Any[] %>
<%= render "shared" %>
