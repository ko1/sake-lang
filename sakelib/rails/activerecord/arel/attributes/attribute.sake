# Port of activerecord-8.1.3/lib/arel/attributes/attribute.rb
#
# Ruby's Attribute < Struct.new(:relation, :name) and the constant alias Arel::Attribute. The relation is a
# Table or a TableAlias; Ruby sends it messages, here a `case` picks the type.

module Arel
  module Attributes
    class Attribute
      attr_accessor relation, name
      include Arel::Expressions
      include Arel::Predications
      include Arel::AliasPredication
      include Arel::OrderPredications
      include Arel::Math

      def type_caster(a)
        rel = @relation
        case rel
        in Arel::Table then Arel::Table.type_for_attribute(rel, @name)
        in Arel::Nodes::TableAlias then Arel::Nodes::TableAlias.type_for_attribute(rel, @name)
        end
      end

      def lower(a)
        rel = @relation
        case rel
        in Arel::Table then Arel::Table.lower(rel, a)
        in Arel::Nodes::TableAlias then Arel::Nodes::TableAlias.lower(rel, a)
        end
      end

      def type_cast_for_database(a, value)
        rel = @relation
        case rel
        in Arel::Table then Arel::Table.type_cast_for_database(rel, @name, value)
        in Arel::Nodes::TableAlias then Arel::Nodes::TableAlias.type_cast_for_database(rel, @name, value)
        end
      end

      def able_to_type_cast?(a)
        rel = @relation
        case rel
        in Arel::Table then Arel::Table.able_to_type_cast?(rel)
        in Arel::Nodes::TableAlias then Arel::Nodes::TableAlias.able_to_type_cast?(rel)
        end
      end
    end
  end

  Attribute = Attributes::Attribute
end
