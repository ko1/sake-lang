# Port of actionpack-8.1.3/lib/action_dispatch/routing/route_set.rb (partial: no mounted helpers/engines, no append/prepend blocks, no `direct` (CustomUrlHelper), no polymorphic mappings, no default_scope)
#
# Rails' NamedRouteCollection defines a `*_path` and a `*_url` method per named route with define_method, in
# anonymous modules that `url_helpers` includes. Sake defines no functions at run time: the helpers are generated
# Sake source (routing/generate/url_helpers.sake prints them from a drawn RouteSet), and each generated helper calls
# NamedRouteCollection::UrlHelper.call here, Rails' UrlHelper#call (and OptimizedUrlHelper#call) with the route's name.
#
# Rails' Dispatcher finds the controller with `req.controller_class` (constantize "PostsController"); here the
# RouteSet holds a value of a type including Routing::Controllers (generated by railties: a `case` over the
# controller names), and the Dispatcher calls `Controllers.dispatch(c, controller_name, action, req)`.
#
# `url_strategy` (Rails' PATH and UNKNOWN lambdas) is the Symbol :path or :url.

require "mapper"
require "url_for"
require "../http/request"
require "../../action_controller/metal/exceptions"

module ActionDispatch
  module Routing
    # (Sake only) the app's controllers, for the Dispatcher: railties generates the includer
    module Controllers
      def dispatch(c, controller, action, req) = raise(NotImplementedError)
    end

    class RouteSet
      attr_reader set, named_routes, router
      attr_accessor disable_clear_and_finalize, resources_path_names
      attr_accessor default_url_options, draw_paths, controllers
      attr_reader env_key, config
      private attr_accessor finalized, _formatter
      attr_reader custom_url_helpers                # `direct` helpers: name => defaults (Rails' CustomUrlHelper)
      attr_reader drawer                            # the Routing::Draw type the routes were drawn with
      def formatter(rs) = @_formatter || raise(ArgumentError, "RouteSet without a formatter")

      Config = Struct.new(:relative_url_root, :api_only, :default_scope)

      class Dispatcher
        attr_reader raise_on_name_error
        include Endpoint
        def dispatcher?(d) = true
        def inspect(d) = "#<ActionDispatch::Routing::RouteSet::Dispatcher>"

        def serve(d, req)
          params = Request.path_parameters(req)
          set = Request.routes(req)
          cs = set ? RouteSet.controllers(set) : nil
          begin
            raise ActionController::RoutingError.new("uninitialized constant #{_controller_class_name(params[:controller])}", Any[]) unless cs
            Controllers.dispatch(cs, Kernel.to_s(params[:controller]), Kernel.to_s(params[:action] || "index"), req)
          rescue ActionController::RoutingError
            raise if @raise_on_name_error
            [404, Hash.of("x-cascade" => "pass"), Any[]]
          end
        end

        def _controller_class_name(name) = "#{ActiveSupport::Inflector.camelize(Kernel.to_s(name))}Controller"
      end

      class NamedRouteCollection
        private attr_reader routes, path_helpers, url_helpers
        include Enum

        def make = NamedRouteCollection.new(Hash.new, Set.new, Set.new)

        def route_defined?(nr, name)
          key = String.to_sym(Kernel.to_s(name))
          Set.include?(@path_helpers, key) || Set.include?(@url_helpers, key)
        end

        def helper_names(nr) = Array.map(Set.to_a(@path_helpers)) { |h| Symbol.to_s(h) } + Array.map(Set.to_a(@url_helpers)) { |h| Symbol.to_s(h) }

        def clear!(nr)
          Hash.clear(@routes)
          Set.clear(@path_helpers)
          Set.clear(@url_helpers)
          nil
        end
        def clear(nr) = clear!(nr)

        def add(nr, name, route)
          key = String.to_sym(Kernel.to_s(name))
          @routes[key] = route
          Set.add(@path_helpers, String.to_sym("#{name}_path"))
          Set.add(@url_helpers, String.to_sym("#{name}_url"))
          route
        end

        def get(nr, name) = @routes[String.to_sym(Kernel.to_s(name))]
        def key?(nr, name) = name != nil && Hash.key?(@routes, String.to_sym(Kernel.to_s(name)))
        def each(nr) = Hash.each(@routes) { |k, v| yield([k, v]) }
        def names(nr) = Hash.keys(@routes)
        def length(nr) = Hash.length(@routes)

        module UrlHelper
          module_function

          def optimize_helper?(route)
            Hash.empty?(Journey::Path::Pattern.requirements(Journey::Route.path(route))) && !Journey::Route.glob?(route)
          end

          # UrlHelper#call (OptimizedUrlHelper#call when the route can be): `t` is a UrlFor includer
          def call(t, route_name, url_strategy, args, inner_options)
            routes = UrlFor._routes(t)
            route = NamedRouteCollection.get(RouteSet.named_routes(routes), route_name)
            raise ArgumentError, "no route named #{route_name}" unless route
            route_defaults = Journey::Route.defaults(route)
            required_parts = Journey::Route.required_parts(route)
            if optimize_helper?(route) && Array.size(args) == Array.size(required_parts) && inner_options == nil && UrlFor.optimize_routes_generation?(t)
              options = Hash.merge(UrlFor.url_options(t), route_defaults)
              path = optimized_helper(route, args)
              path += "/" if options[:trailing_slash] && !String.end_with?(path, "/")
              options[:path] = path
              original_script_name = options[:original_script_name]
              Hash.delete(options, :original_script_name)
              script_name = RouteSet.find_script_name(routes, options)
              script_name = Kernel.to_s(original_script_name) + script_name if original_script_name
              options[:script_name] = script_name
              return RouteSet.call_strategy(url_strategy, options)
            end
            controller_options = UrlFor.url_options(t)
            options = Hash.merge(controller_options, route_defaults)
            segment_keys = Array.uniq(Journey::Route.segment_keys(route))
            hash = handle_positional_args(controller_options, inner_options || Hash.new, args, options, segment_keys)
            RouteSet.url_for(routes, hash, route_name, url_strategy, "#{route_name}_#{url_strategy}")
          end

          def optimized_helper(route, args)
            params = parameterize_args(route, args) { raise_generation_error(route, args) }
            Journey::Route.format(route, params)
          end

          def parameterize_args(route, args)
            params = Hash.new
            Array.each_with_index(Journey::Route.required_parts(route)) do |key, i|
              value = Journey::Formatter.to_param(args[i])
              yield(key) if value == nil || value == ""
              params[key] = value
            end
            params
          end

          def raise_generation_error(route, args)
            missing_keys = Symbol[]
            params = parameterize_args(route, args) { |missing_key| Array.push(missing_keys, missing_key) }
            all = Hash.merge(Journey::Route.requirements(route), params)
            constraints = Array.to_h(Array.sort_by(Hash.to_a(all)) { |k, _v| Kernel.to_s(k) })
            message = "No route matches #{Kernel.inspect(constraints)}"
            message += ", missing required keys: #{Kernel.inspect(Array.sort(missing_keys))}"
            raise ActionController::UrlGenerationError.new(message, nil, nil, nil)
          end

          def handle_positional_args(controller_options, inner_options, args, result, path_params)
            unless Array.empty?(args)
              path_params_size = Array.include?(path_params, :format) ? Array.size(path_params) - 1 : Array.size(path_params)
              if Array.size(args) < path_params_size
                path_params = path_params - Hash.keys(controller_options)
                pp = result[:path_params]
                path_params = path_params - Hash.keys(Hash.merge((pp in Hash) ? pp : Hash.new, result))
              else
                path_params = Array.dup(path_params)
              end
              Hash.each_key(inner_options) { |key| Array.delete(path_params, key) }
              Array.each_with_index(args) do |arg, index|
                param = path_params[index]
                result[param] = arg if param
              end
            end
            Hash.merge!(result, inner_options)
          end
        end
      end

      def default_resources_path_names = Hash.of(new: "new", edit: "edit")

      # RouteSet.new(config = DEFAULT_CONFIG.dup)
      def make(config = nil)
        set = Journey::Routes.make
        rs = RouteSet.new(set, NamedRouteCollection.make, Journey::Router.new(set), false, default_resources_path_names,
                          Hash.new, String[], nil, "ROUTES_SCRIPT_NAME", config || Config.new(nil, false, nil), false, nil,
                          Hash.new, nil)
        RouteSet.write_field(rs, :_formatter, Journey::Formatter.make(rs))
        rs
      end
      def new_with_config(api_only: false, relative_url_root: nil) = make(Config.new(relative_url_root, api_only, nil))

      def routes(rs) = @set
      def url_helpers(rs) = RoutesProxy.new(rs)
      def relative_url_root(rs) = Config.relative_url_root(@config)
      def api_only?(rs) = Config.api_only(@config) == true
      def request_class(rs) = "ActionDispatch::Request"

      # draw { |map| ... }: Rails runs the block with instance_exec on the Mapper; here the block receives it
      def draw(rs)
        clear!(rs) unless @disable_clear_and_finalize
        yield(Mapper.make(rs))
        finalize!(rs) unless @disable_clear_and_finalize
        nil
      end

      # draw_with(set, routes): the routes of a type that includes Routing::Draw (`def draw(r, map)`), as railties does
      def draw_with(rs, drawer)
        clear!(rs) unless @disable_clear_and_finalize
        @drawer = drawer
        Draw.draw(drawer, Mapper.make_with(rs, drawer))
        finalize!(rs) unless @disable_clear_and_finalize
        nil
      end

      def finalize!(rs)
        return nil if @finalized
        @finalized = true
        nil
      end

      def clear!(rs)
        @finalized = false
        NamedRouteCollection.clear(@named_routes)
        Journey::Routes.clear(@set)
        Journey::Formatter.clear(formatter(rs))
        nil
      end

      def empty?(rs) = Journey::Routes.empty?(@set)

      # direct :homepage do ... end: the block is the routes' `direct_for(r, t, :homepage, args, options)`
      def add_url_helper(rs, name, options)
        @custom_url_helpers[String.to_sym(Kernel.to_s(name))] = options
        nil
      end

      # Rails' CustomUrlHelper#call(t, args, only_path): the url of what the block returns
      module CustomUrlHelper
        module_function
        def call(t, name, args, options, only_path)
          routes = UrlFor._routes(t)
          d = RouteSet.drawer(routes)
          raise ArgumentError, "direct :#{name} needs routes drawn by a Routing::Draw type" unless d
          defaults = RouteSet.custom_url_helpers(routes)[name] || Hash.new
          target = Draw.direct_for(d, t, name, args, Hash.merge(defaults, options))
          url = UrlFor.full_url_for(t, target)
          only_path ? "/" + Kernel.to_s(String.partition(url, %r{(?<!/)/(?!/)})[2]) : url
        end
      end

      def add_route(rs, mapping, name)
        raise ArgumentError, "Invalid route name: '#{name}'" unless name == nil || name == "" || String.match?(Kernel.to_s(name), /^[_a-z]\w*$/i)
        if name && NamedRouteCollection.get(@named_routes, name)
          raise ArgumentError, "Invalid route name, already in use: '#{name}' \n" \
            "You may have defined two routes with the same name using the `:as` option, or " \
            "you may be overriding a route already defined by a resource with the same naming. " \
            "For the latter, you can restrict the routes created with `resources` as explained here: \n" \
            "https://guides.rubyonrails.org/routing.html#restricting-the-routes-created"
        end
        route = Journey::Routes.add_route(@set, name == nil ? nil : Kernel.to_s(name), mapping)
        NamedRouteCollection.add(@named_routes, name, route) if name
        route
      end

      class Generator
        attr_reader named_route, options, recall, set

        def make(named_route, options, recall, set)
          g = Generator.new(named_route, options, recall, set)
          normalize_options!(g)
          normalize_controller_action_id!(g)
          use_relative_controller!(g)
          normalize_controller!(g)
          g
        end

        def controller(g) = @options[:controller]
        def current_controller(g) = @recall[:controller]

        def use_recall_for(g, key)
          rk = @recall[key]
          if rk && (!Hash.key?(@options, key) || @options[key] == rk)
            if !named_route_exists?(g) || Array.include?(segment_keys(g), key)
              @options[key] = rk
            end
          end
        end

        def normalize_options!(g)
          c = @options[:controller]
          if c
            @options[:action] ||= "index"
            @options[:controller] = Kernel.to_s(c)
          end
          @options[:action] = Kernel.to_s(@options[:action] || "index") if Hash.key?(@options, :action)
          nil
        end

        def normalize_controller_action_id!(g)
          use_recall_for(g, :controller) || return
          use_recall_for(g, :action) || return
          use_recall_for(g, :id)
        end

        def use_relative_controller!(g)
          c = controller(g)
          cc = current_controller(g)
          if !@named_route && different_controller?(g) && c && cc && !String.start_with?(Kernel.to_s(c), "/")
            old_parts = String.split(Kernel.to_s(cc), "/")
            size = String.count(Kernel.to_s(c), "/") + 1
            parts = Array.[](old_parts, 0...(Array.size(old_parts) - size)) || String[]
            Array.push(parts, Kernel.to_s(c))
            @options[:controller] = Array.join(parts, "/")
          end
        end

        def normalize_controller!(g)
          c = controller(g)
          return nil unless c
          s = Kernel.to_s(c)
          @options[:controller] = String.start_with?(s, "/") ? (String.[](s, 1..) || "") : s
          nil
        end

        def generate(g) = Journey::Formatter.generate(RouteSet.formatter(@set), @named_route, @options, @recall)

        def different_controller?(g)
          cc = current_controller(g)
          return false unless cc
          Kernel.to_s(controller(g)) != Kernel.to_s(cc)
        end

        def named_route_exists?(g) = @named_route != nil && NamedRouteCollection.get(RouteSet.named_routes(@set), @named_route) != nil
        def segment_keys(g)
          r = NamedRouteCollection.get(RouteSet.named_routes(@set), @named_route)
          r ? Journey::Route.segment_keys(r) : Symbol[]
        end
      end

      def extra_keys(rs, options, recall = Hash.new) = generate_extras(rs, options, recall)[1]

      def generate_extras(rs, options, recall = Hash.new)
        options = Hash.merge(options, Hash.of(_recall: recall)) if recall
        route_name = options[:use_route]
        Hash.delete(options, :use_route)
        g = generate(rs, route_name, options, recall)
        path_info = path_for(rs, options, route_name, Symbol[])
        params = (g in Journey::Formatter::RouteWithParams) ? Journey::Formatter::RouteWithParams.params(g) : Journey::Formatter::MissingRoute.params(g)
        [URI.path(URI.parse(path_info)) || "", Hash.keys(Hash.except(params, :_recall))]
      end

      def generate(rs, route_name, options, recall = Hash.new)
        Generator.generate(Generator.make(route_name == nil ? nil : Kernel.to_s(route_name), options, recall, rs))
      end

      def reserved_options
        Symbol[:host, :protocol, :port, :subdomain, :domain, :tld_length, :trailing_slash, :anchor, :params, :only_path,
               :script_name, :original_script_name]
      end

      def optimize_routes_generation?(rs) = Hash.empty?(@default_url_options)

      def find_script_name(rs, options)
        sn = options[:script_name]
        Hash.delete(options, :script_name)
        return Kernel.to_s(sn) if sn
        relative_url_root(rs) || ""
      end

      def path_for(rs, options, route_name = nil, reserved = nil)
        url_for(rs, options, route_name, :path, nil, reserved || reserved_options)
      end

      # url_for(options, route_name, url_strategy, method_name, reserved): Rails' RouteSet#url_for
      def url_for(rs, options, route_name = nil, url_strategy = :url, method_name = nil, reserved = nil)
        options = Hash.merge(@default_url_options, options)
        user = nil
        password = nil
        if options[:user] && options[:password]
          user = Hash.delete(options, :user)
          password = Hash.delete(options, :password)
        end
        rc = options[:_recall]
        Hash.delete(options, :_recall)
        recall = (rc in Hash) ? rc : Hash.new
        original_script_name = options[:original_script_name]
        Hash.delete(options, :original_script_name)
        script_name = find_script_name(rs, options)
        script_name = Kernel.to_s(original_script_name) + script_name if original_script_name

        path_options = Hash.dup(options)
        Array.each(reserved || reserved_options) { |ro| Hash.delete(path_options, ro) }
        route_with_params = generate(rs, route_name, path_options, recall)
        path, params = case route_with_params
        in Journey::Formatter::RouteWithParams
          [Journey::Formatter::RouteWithParams.path(route_with_params, method_name),
           Journey::Formatter::RouteWithParams.params(route_with_params)]
        in Journey::Formatter::MissingRoute
          [Journey::Formatter::MissingRoute.path(route_with_params, method_name), Hash.new]
        end
        path += "/" if options[:trailing_slash] && !options[:format] && !String.end_with?(path, "/")
        if Hash.key?(options, :params)
          op = options[:params]
          if op in Hash
            Hash.merge!(params, op)
          else
            params[:params] = op
          end
        end
        options[:path] = path
        options[:script_name] = script_name
        options[:params] = params
        options[:user] = user
        options[:password] = password
        call_strategy(url_strategy, options)
      end

      # PATH = ->(options) { Http::URL.path_for(options) }; UNKNOWN = ->(options) { Http::URL.url_for(options) }
      def call_strategy(url_strategy, options)
        url_strategy == :path ? Http::URL.path_for(options) : Http::URL.url_for(options)
      end

      # Rails' RouteSet#call(env); the RouteSet is the innermost ActionDispatch::App of the stack
      include App
      def call(rs, req)
        Request.set_routes(req, rs)
        Request.set_path_info(req, Journey::Router::Utils.normalize_path(Request.path_info(req)))
        Journey::Router.serve(@router, req)
      end

      # recognize_path("/posts/1", method: :get) # => {controller: "posts", action: "show", id: "1"}
      def recognize_path(rs, path, method: nil, extras: nil)
        m = String.upcase(Kernel.to_s(method || "GET"))
        path = Journey::Router::Utils.normalize_path(path) unless path != nil && String.include?(path, "://")
        env = Rack::MockRequest.env_for(path, method: m)
        req = Request.new(env)
        recognize_path_with_request(rs, req, path, extras || Hash.new)
      end

      def recognize_path_with_request(rs, req, path, extras, raise_on_missing: true)
        Journey::Router.recognize(@router, req) do |route, params|
          Hash.merge!(params, extras)
          Hash.each(params) do |key, value|
            params[key] = Rack::Utils.unescape_path(value) if value in String
          end
          Request.set_path_parameters(req, params)
          app = Journey::Route.app(route)
          if Endpoint.matches?(app, req) && Endpoint.dispatcher?(app)
            # Rails also checks here that the controller class exists (constantize); Sake's controllers are generated
            return Request.path_parameters(req)
          end
        end
        raise ActionController::RoutingError.new("No route matches #{Kernel.inspect(path)}", Any[]) if raise_on_missing
        nil
      end
    end
  end
end
