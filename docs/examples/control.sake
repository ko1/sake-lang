def fizzbuzz(n)
  if n % 15 == 0
    "FizzBuzz"
  elsif n % 3 == 0
    "Fizz"
  elsif n % 5 == 0
    "Buzz"
  else
    Integer.to_s(n)
  end
end

i = 1
while i <= 15
  print(fizzbuzz(i), " ")
  i += 1
end
puts

n = 27
steps = 0
until n == 1
  n = Integer.even?(n) ? n / 2 : 3 * n + 1
  steps += 1
end
puts("collatz(27) steps: #{steps}")
puts("small") unless steps > 100
puts("ok") if steps == 111
