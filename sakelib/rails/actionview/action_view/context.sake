# Port of actionview-8.1.3/lib/action_view/context.rb
#
# A mixin of the view: Rails' `attr_accessor :output_buffer, :view_flow` are fields the includer declares
# (ActionView::Base does).

require "buffers"
require "flows"
require "template"

module ActionView
  module Context
    def output_buffer(v) = raise(NotImplementedError)
    def set_output_buffer(v, b) = raise(NotImplementedError)
    def view_flow(v) = raise(NotImplementedError)
    def set_view_flow(v, f) = raise(NotImplementedError)
    def set_virtual_path(v, p) = raise(NotImplementedError)
    def virtual_path(v) = raise(NotImplementedError)
    def current_template(v) = raise(NotImplementedError)
    def set_current_template(v, t) = raise(NotImplementedError)
    def lookup_context(v) = raise(NotImplementedError)
    def view_renderer(v) = raise(NotImplementedError)
    def prefix_partial_path_with_controller_namespace(v) = raise(NotImplementedError)

    # Ruby: ActionView::Base#_run(method, template, locals, buffer, add_to_stack:, has_strict_locals:, &block):
    # the view's buffer, virtual path and current template while the compiled function (the block) runs
    def _run(v, template, buffer, add_to_stack = true)
      old_output_buffer = output_buffer(v)
      old_virtual_path = virtual_path(v)
      old_template = current_template(v)
      set_current_template(v, template) if add_to_stack
      set_output_buffer(v, buffer)
      begin
        yield
      ensure
        set_output_buffer(v, old_output_buffer)
        set_virtual_path(v, old_virtual_path)
        set_current_template(v, old_template)
      end
    end

    # Ruby: public_send(method_name, local_assigns, output_buffer) for a template without locals; the view class
    # generated by generate/templates.sake defines it as a `case` over its compiled functions
    def _compiled(v, method_name, buffer)
      raise Template::Error.new("#{method_name} is not a compiled template of this view (no templates were generated for it)", method_name)
    end

    def _prepare_context(v)
      set_view_flow(v, OutputFlow.make)
      set_output_buffer(v, OutputBuffer.make)
      set_virtual_path(v, nil)
    end

    # Ruby: _layout_for(name = nil): the layout's `yield` and `yield :name`
    def _layout_for(v, name = nil)
      ActiveSupport::SafeBuffer.html_safe(OutputFlow.get(view_flow(v), name || :layout))
    end
  end
end
