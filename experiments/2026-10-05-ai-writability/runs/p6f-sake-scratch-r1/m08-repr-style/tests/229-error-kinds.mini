fn kind_of(f)
  try
    f()
  catch e
    return e.kind
  end
  return "none"
end
print(kind_of(fn() return 1 + "a" end), kind_of(fn() return [][0] end))
print(kind_of(fn() return {}["k"] end), kind_of(fn() return 1 % 0 end))
print(kind_of(fn() let l = len; return l() end), kind_of(fn() return int("x") end))
print(kind_of(fn() assert false end), kind_of(fn() return 1 end))
