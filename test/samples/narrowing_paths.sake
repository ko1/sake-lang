# `if !x` narrows x on the else path; `@x => T` in initialize narrows the field;
# a class pasted from another (`class B < A`) has its own containers.
def f(a)
  last = Array.last(a)
  if !last
    0
  else
    String.size(last)
  end
end
p f(Array["ab"])
p f(Array[])

class Cfg
  attr_reader port
  def initialize(c)
    @port => Integer
    raise ArgumentError, "bad" unless @port > 0
  end
  def next_port(c) = @port + 1
end
p Cfg.next_port(Cfg.new(80))
begin
  Cfg.new(Array.fetch(Array[1, "big"], 1))
rescue NoMatchingPatternError
  puts "no"
end

class Box
  attr_reader items
  def initialize(b) = @items = Array[]
  def add(b, x)
    Array.push(@items, x)
    Array.all?(@items) { |y| y <= x }
  end
end
class Words < Box
end
def fill(b, w)
  p Box.add(b, 2)
  p Words.add(w, "a")
end
fill(Box.new, Words.new)
