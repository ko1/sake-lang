# Port of actionview-8.1.3/lib/action_view/view_paths.rb (partial: no PathRegistry: a controller's view paths are those its view class was compiled from; no class-level append_view_path/prepend_view_path)
#
# A controller's mixin. Rails' @_lookup_context is the controller's field, read through required readers (a mixin
# reads no fields); `self.class._view_paths` is generated per controller (action_controller/generate/controller.sake).

require "lookup_context"

module ActionView
  module ViewPaths
    def _lookup_context(c) = raise(NotImplementedError)
    def set__lookup_context(c, l) = raise(NotImplementedError)
    def _view_paths(c) = raise(NotImplementedError)
    def _prefixes(c) = raise(NotImplementedError)

    # LookupContext is the object which is responsible for holding all information required for looking up
    # templates, i.e. view paths and details.
    def lookup_context(c)
      l = _lookup_context(c)
      return l if l
      l = LookupContext.make(_view_paths(c), details_for_lookup(c), _prefixes(c))
      set__lookup_context(c, l)
      l
    end

    def details_for_lookup(c) = nil

    # delegate :template_exists?, :any_templates?, :view_paths, :formats, :formats=, :locale, to: :lookup_context
    def template_exists?(c, name, prefixes = String[], partial = false) = LookupContext.template_exists?(lookup_context(c), name, prefixes, partial)
    def any_templates?(c, name, prefixes = String[], partial = false) = LookupContext.any?(lookup_context(c), name, prefixes, partial)
    def view_paths(c) = LookupContext.view_paths(lookup_context(c))
    def formats(c) = LookupContext.formats(lookup_context(c))
    def set_formats(c, values) = LookupContext.set_formats(lookup_context(c), values)
    def locale(c) = LookupContext.locale(lookup_context(c))

    # Append a path to the list of view paths for the current LookupContext.
    def append_view_path(c, path) = LookupContext.append_view_paths(lookup_context(c), String[path])
    # Prepend a path to the list of view paths for the current LookupContext.
    def prepend_view_path(c, path) = LookupContext.prepend_view_paths(lookup_context(c), String[path])
  end
end
