# Positions, bytes, replacement blocks: String.index(s, t, start), Regexp.match(re, s, pos),
# byteslice, unpack, sub/gsub with a Hash or a block, warn (to stderr), exit with a status.
s = "a,b;c,d"
p([String.index(s, ",", 2), String.rindex(s, ",", 2), String.index(s, "x")])
m = Regexp.match(/\G\w/, s, 2)
p(m && m[0])
p(String.match?(s, /;/, 4))
u = "héllo"
p([String.bytesize(u), String.byteslice(u, 1, 2), String.byteindex(u, "l")])
p(String.unpack("\x01\x02\x00\x03", "C*"))
p(String.unpack1("\x00\x00\x01\x00", "N"))
p(String.unpack("abc", "a2"))
p(String.gsub("cat hat", /[ch]at/, Hash["cat" => "dog", "hat" => "cap"]))
p(String.gsub("a1b22", /\d+/) { |d| Integer.to_s(String.size(d)) })
p(String.sub("x-y-z", "-", "+"))
p(String.b("é") == "é")
warn("to stderr")
x = Integer.to_s(ARGV.Array.size)
exit(3) unless x == "0"
puts("args: #{x}")
exit(4)
puts("not reached")
