require "digest"

# One-shot digests of a String (Ruby's class methods).
inputs = Array["", "abc", "The quick brown fox jumps over the lazy dog", "日本語のテキスト", "héllo ✓ 😀",
               String.*("a", 55), String.*("a", 56), String.*("a", 64), String.*("a", 65),
               String.*("b", 111), String.*("b", 112), String.*("b", 128), String.*("xyz", 100),
               Array.pack(Integer[0, 255, 128, 1, 127], "C*")]
Array.each(inputs) do |s|
  puts("#{String.bytesize(s)} bytes")
  puts(Digest::MD5.hexdigest(s))
  puts(Digest::SHA1.hexdigest(s))
  puts(Digest::SHA256.hexdigest(s))
  puts(Digest::SHA384.hexdigest(s))
  puts(Digest::SHA512.hexdigest(s))
  puts(Digest::MD5.base64digest(s))
  puts(Digest::SHA256.base64digest(s))
end
p(Digest::MD5.digest("abc"))
p(String.bytesize(Digest::SHA1.digest("abc")))
p(String.encoding(Digest::SHA256.digest("abc")))
puts(Digest.hexencode(Digest::MD5.digest("abc")))

# Incremental: the same digest whatever the pieces.
md = Digest::SHA256.new
md << "The quick brown "
md << "fox jumps over "
Digest::SHA256.update(md, "the lazy dog")
puts(Digest::SHA256.hexdigest(md))
puts(Digest::SHA256.hexdigest(md))            # digest leaves md as it is
puts(Digest::SHA256.base64digest(md))
p(String.bytesize(Digest::SHA256.digest(md)))
puts(Digest::SHA256.to_s(md))
puts("#{md}")
p(md)
whole = Digest::SHA256.update(Digest::SHA256.new, "The quick brown fox jumps over the lazy dog")
p(md == whole)
p(md == Digest::SHA256.new)

m5 = Digest::MD5.new
Integer.times(10) { |i| m5 << String.*("#{i}", 13) }
puts(Digest::MD5.hexdigest(m5))
puts(Digest::MD5.hexdigest!(m5))              # returns it and resets
puts(Digest::MD5.hexdigest(m5))
p(m5 == Digest::MD5.new)
m5 << "abc"
p(Digest::MD5.digest!(m5))
m5 << "abc"
puts(Digest::MD5.base64digest!(m5))
puts(Digest::MD5.hexdigest(m5))
puts(Digest::MD5.hexdigest(Digest::MD5.reset(Digest::MD5.update(Digest::MD5.new, "zzz"))))

s1 = Digest::SHA1.new
Array.each(Array["日本", "語の", "テキスト"]) { |piece| s1 << piece }
puts(Digest::SHA1.hexdigest(s1))
s5 = Digest::SHA512.new
Integer.times(3) { s5 << String.*("q", 100) }
puts(Digest::SHA512.hexdigest(s5))
s3 = Digest::SHA384.new
s3 << ""
puts(Digest::SHA384.hexdigest(s3))

# Sizes.
p(Array[Digest::MD5.digest_length(Digest::MD5.new), Digest::SHA1.digest_length(Digest::SHA1.new), Digest::SHA256.digest_length(Digest::SHA256.new),
        Digest::SHA384.digest_length(Digest::SHA384.new), Digest::SHA512.digest_length(Digest::SHA512.new)])
p(Array[Digest::MD5.block_length(Digest::MD5.new), Digest::SHA1.block_length(Digest::SHA1.new), Digest::SHA256.block_length(Digest::SHA256.new),
        Digest::SHA384.block_length(Digest::SHA384.new), Digest::SHA512.block_length(Digest::SHA512.new)])
p(Array[Digest::MD5.size(Digest::MD5.new), Digest::SHA256.length(Digest::SHA256.new)])

# Files.
puts(Digest::SHA256.hexdigest(Digest::SHA256.file("digest.rb")))
begin
  Digest::MD5.file("no-such-file")
rescue IOError
  puts("no file")
end

# The instance form with a String: a one-shot digest that leaves md reset.
m1 = Digest::SHA1.new
m1 << "zzz"
puts(Digest::SHA1.hexdigest(m1, "abc"))
puts(Digest::SHA1.hexdigest(m1))
p(Digest::MD5.digest(Digest::MD5.new, "abc") == Digest::MD5.digest("abc"))
puts(Digest::SHA512.base64digest(Digest::SHA512.new, "x"))
puts(Digest::SHA384.hexdigest(Digest::SHA384.update(Digest::SHA384.new, "q"), "日本語"))

# 2026-10-05: dup gives an independent copy; the instance form of file updates md.
d1 = Digest::SHA256.new
d1 << "abc"
d2 = dup(d1)
d2 << "def"
puts(Digest::SHA256.hexdigest(d1))
puts(Digest::SHA256.hexdigest(d2))
p(d1 == Digest::SHA256.update(Digest::SHA256.new, "abc"))
m6 = Digest::MD5.new
m6 << "x"
p(Digest::MD5.file(m6, "digest.rb") == m6)
puts(Digest::MD5.hexdigest(m6))
s4 = dup(Digest::SHA384.new)
puts(Digest::SHA384.hexdigest(s4))
