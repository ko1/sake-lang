require "logger"

def fixed = Time.new(2026, 10, 3, 12, 34, 56)

log = Logger.new(:stdout)
Logger.set_fixed_time(log, fixed)
p(Logger.get_level(log))
Logger.debug(log, "debug message")
Logger.info(log, "info message")
Logger.warn(log, "warn message")
Logger.error(log, "error message")
Logger.fatal(log, "fatal message")
Logger.unknown(log, "unknown message")
Logger.info(log, Array[1, "two", :three])
Logger.info(log, nil)
Logger.info(log, "ユニコード ✓")
Logger.info(log, "")

Logger.set_progname(log, "myapp")
Logger.info(log, "with progname")
Logger.add(log, Logger.WARN, "via add", "other")
Logger.add(log, Logger.ERROR, nil, "message in progname slot")
Logger.add(log, nil, "nil severity", nil)
Logger.log(log, 9, "severity 9", nil)

Logger.set_level(log, Logger.WARN)
p(Logger.get_level(log))
Logger.info(log, "hidden")
Logger.warn(log, "shown")
p([Logger.debug?(log), Logger.info?(log), Logger.warn?(log), Logger.error?(log), Logger.fatal?(log)])
Logger.set_level(log, :error)
p(Logger.get_level(log))
Logger.set_level(log, "INFO")
p(Logger.get_level(log))
Logger.set_level(log, "fatal")
p(Logger.get_level(log))
begin
  Logger.set_level(log, :verbose)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
Logger.debug!(log)
p(Logger.get_level(log))
Logger.error!(log)
p(Logger.error?(log))
# A logger of its own: Ruby's logger 1.7.0 keeps the with_level level after the block when the old level was set
wl = Logger.new(:stdout)
Logger.set_fixed_time(wl, fixed)
Logger.error!(wl)
Logger.with_level(wl, :debug) do
  Logger.debug(wl, "inside with_level")
end
p(Logger.get_level(wl))
Logger.debug(wl, "after with_level: hidden")
Logger.info!(log)

Logger.set_datetime_format(log, "%H:%M:%S")
Logger.info(log, "short datetime")
Logger.set_datetime_format(log, nil)

Logger.set_formatter(log, "%<severity>s [%<progname>s] %<msg>s\n")
Logger.info(log, "custom format")
Logger.set_formatter(log, "%-5<severity>s %<datetime>s: %<msg>s\n")
Logger.set_datetime_format(log, "%Y/%m/%d")
Logger.error(log, "custom with time")
Logger.set_formatter(log, nil)
Logger.set_datetime_format(log, nil)

p(Logger.<<(log, "raw text\n"))

# optional arguments: no message, add/log without message or progname
Logger.info(log)
Logger.add(log, Logger.WARN)
Logger.add(log, Logger.INFO, "add with a message")
Logger.log(log, Logger.ERROR, "log with a message")
Logger.unknown(log)

# stderr as the device (not compared: the test reads stdout)
elog = Logger.new(:stderr)
Logger.info(elog, "to stderr")

quiet = Logger.new(nil)
p(Logger.info(quiet, "nothing"))


path = "/tmp/sakelib-logger-test.log"
File.write(path, "")
flog = Logger.new(path)
Logger.set_fixed_time(flog, fixed)
Logger.set_progname(flog, "file")
Logger.info(flog, "first line")
Logger.warn(flog, "second line")
Logger.debug(flog, "third line")
Logger.close(flog)
Logger.info(flog, "after close")
lines = File.readlines(path)
p(Array.size(lines))
first = Array.fetch(lines, 0)
p(String.[](first, 0, 21))
Array.each(Array.drop(lines, 1)) { |l| print(l) }
File.write(path, "")
