def split_tokens(line)
  stripped = String.strip(line)
  parts = Array[]
  current = ""
  in_space = true

  Array.each(String.chars(stripped)) do |ch|
    if ch == " " || ch == "\t"
      if !in_space && current != ""
        Array.push(parts, current)
        current = ""
      end
      in_space = true
    else
      in_space = false
      current = current + ch
    end
  end

  if current != ""
    Array.push(parts, current)
  end

  parts
end

def is_number?(token)
  if String.size(token) == 0
    return false
  end

  first = String.slice(token, 0, 1)
  rest = String.slice(token, 1)

  if first == "-"
    if String.size(token) == 1
      return false
    end
    rest_ok = true
    Array.each(String.chars(rest)) do |ch|
      if ch < "0" || ch > "9"
        rest_ok = false
      end
    end
    return rest_ok
  else
    digit_ok = true
    Array.each(String.chars(token)) do |ch|
      if ch < "0" || ch > "9"
        digit_ok = false
      end
    end
    return digit_ok
  end
end

def is_builtin?(word)
  Array.include?(Array["+", "-", "*", "/", "mod", "=", "<", ">", "dup", "drop", "swap", "over", ".", "if", "then", "else", ";"], word)
end

def check_syntax(tokens)
  if_count = 0
  i = 0

  Array.each_with_index(tokens) do |token, idx|
    if token == "if"
      if_count += 1
      # Find matching then
      then_count = 0
      else_count = 0
      j = idx + 1
      while j < Array.size(tokens)
        if Array.at(tokens, j) == "then"
          then_count += 1
        elsif Array.at(tokens, j) == "else" && then_count == 0
          else_count += 1
        elsif Array.at(tokens, j) == "if"
          return false
        end
        if then_count > 0
          break
        end
        j += 1
      end

      if then_count == 0
        return false
      end
      if else_count > 1
        return false
      end
    elsif token == ":"
      return false
    elsif token == "then" || token == "else"
      return false
    elsif token == ";"
      return false
    end
  end

  colon_count = 0
  Array.each(tokens) do |token|
    if token == ":"
      colon_count += 1
    elsif token == ";"
      colon_count -= 1
    end
  end

  if colon_count != 0
    return false
  end

  true
end

def run_line(tokens, stack, definitions, line_num)
  if !check_syntax(tokens)
    puts("line #{line_num}: syntax error")
    return [stack, definitions]
  end

  saved_stack = Array.dup(stack)
  call_depth = 0

  begin
    result = run_tokens(tokens, stack, definitions, call_depth, line_num)
    if result in [new_stack, new_definitions, error_msg] if error_msg != nil
      puts("line #{line_num}: error: #{error_msg}")
      return [saved_stack, definitions]
    end

    result => [new_stack, new_definitions, _]
    [new_stack, new_definitions]
  rescue
    puts("line #{line_num}: error: unknown")
    [saved_stack, definitions]
  end
end

def run_tokens(tokens, stack, definitions, call_depth, line_num)
  i = 0
  while i < Array.size(tokens)
    token = Array.at(tokens, i)

    if token == ":"
      i += 1
      name = Array.at(tokens, i)
      i += 1
      body = Array[]
      while i < Array.size(tokens) && Array.at(tokens, i) != ";"
        Array.push(body, Array.at(tokens, i))
        i += 1
      end
      definitions[name] = body
      i += 1
      next
    end

    if is_number?(token)
      num = String.to_i(token)
      Array.push(stack, num)
    elsif token == "+"
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in +"]
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a + b)
    elsif token == "-"
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in -"]
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a - b)
    elsif token == "*"
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in *"]
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a * b)
    elsif token == "/"
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in /"]
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      if b == 0
        return [stack, definitions, "division by zero"]
      end
      Array.push(stack, Integer.div(a, b))
    elsif token == "mod"
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in mod"]
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      if b == 0
        return [stack, definitions, "division by zero"]
      end
      Array.push(stack, a % b)
    elsif token == "="
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in ="]
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a == b ? 1 : 0)
    elsif token == "<"
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in <"]
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a < b ? 1 : 0)
    elsif token == ">"
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in >"]
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a > b ? 1 : 0)
    elsif token == "dup"
      if Array.size(stack) < 1
        return [stack, definitions, "stack underflow in dup"]
      end
      top = Array.last(stack)
      Array.push(stack, top)
    elsif token == "drop"
      if Array.size(stack) < 1
        return [stack, definitions, "stack underflow in drop"]
      end
      Array.pop(stack)
    elsif token == "swap"
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in swap"]
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, b)
      Array.push(stack, a)
    elsif token == "over"
      if Array.size(stack) < 2
        return [stack, definitions, "stack underflow in over"]
      end
      b = Array.last(stack)
      a = Array.at(stack, Array.size(stack) - 2)
      Array.push(stack, a)
    elsif token == "."
      if Array.size(stack) < 1
        return [stack, definitions, "stack underflow in ."]
      end
      val = Array.pop(stack)
      puts(val)
    elsif token == "if"
      if Array.size(stack) < 1
        return [stack, definitions, "stack underflow in if"]
      end
      cond = Array.pop(stack)
      i += 1
      then_idx = nil
      else_idx = nil
      brace_depth = 0
      while i < Array.size(tokens)
        if Array.at(tokens, i) == "if"
          brace_depth += 1
        elsif Array.at(tokens, i) == "then"
          if brace_depth == 0
            then_idx = i
            break
          else
            brace_depth -= 1
          end
        elsif Array.at(tokens, i) == "else" && brace_depth == 0
          else_idx = i
        end
        i += 1
      end

      if then_idx == nil
        return [stack, definitions, "syntax error"]
      end

      if_body = nil
      else_body = nil

      if else_idx
        if_body = Array.slice(tokens, i - then_idx + 1, else_idx - (i - then_idx + 1))
        else_body = Array.slice(tokens, else_idx + 1, then_idx - else_idx - 1)
      else
        if_body = Array.slice(tokens, i - then_idx + 1, then_idx - (i - then_idx + 1))
      end

      if cond != 0
        result = run_tokens(if_body, stack, definitions, call_depth, line_num)
        result => [new_stack, new_definitions, error_msg]
        if error_msg != nil
          return result
        end
        stack = new_stack
        definitions = new_definitions
      elsif else_body
        result = run_tokens(else_body, stack, definitions, call_depth, line_num)
        result => [new_stack, new_definitions, error_msg]
        if error_msg != nil
          return result
        end
        stack = new_stack
        definitions = new_definitions
      end

      i = then_idx
    elsif token == "then" || token == "else" || token == ";"
      # Skip (handled by if/definition)
    else
      # User word
      if !Hash.has_key?(definitions, token)
        return [stack, definitions, "unknown word #{token}"]
      end

      if call_depth >= 100
        return [stack, definitions, "too deep"]
      end

      body = definitions[token]
      result = run_tokens(body, stack, definitions, call_depth + 1, line_num)
      result => [new_stack, new_definitions, error_msg]
      if error_msg != nil
        return result
      end
      stack = new_stack
      definitions = new_definitions
    end

    i += 1
  end

  [stack, definitions, nil]
end

stack = Array[]
definitions = Hash[]

lines = IO.readlines(IO.stdin)
Array.each_with_index(lines) do |line, idx|
  line_num = idx + 1

  if String.strip(line) == ""
    next
  end

  tokens = split_tokens(String.chomp(line))

  if Array.size(tokens) == 0
    next
  end

  result = run_line(tokens, stack, definitions, line_num)
  stack = Array.at(result, 0)
  definitions = Array.at(result, 1)
end

if Array.size(stack) == 0
  puts("stack: (empty)")
else
  stack_str = Array.join(stack, " ")
  puts("stack: #{stack_str}")
end
