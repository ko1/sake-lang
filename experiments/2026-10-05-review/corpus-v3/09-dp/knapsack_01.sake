class Item
  attr_reader name, weight, value

  def to_s(it) = "#{@name} (w=#{@weight}, v=#{@value})"
end

def build_table(items, capacity)
  n = Array.size(items)
  table = Range.map(0..n) { Range.map(0..capacity) { 0 } }
  Integer.upto(1, n) do |i|
    item = items[i - 1]
    w = Item.weight(item)
    v = Item.value(item)
    Integer.upto(0, capacity) do |c|
      best = table[i - 1][c]
      if w <= c
        with_item = table[i - 1][c - w] + v
        best = with_item if with_item > best
      end
      table[i][c] = best
    end
  end
  table
end

def chosen_items(items, table, capacity)
  picked = Array[]
  c = capacity
  i = Array.size(items)
  while i > 0
    if table[i][c] != table[i - 1][c]
      item = items[i - 1]
      Array.unshift(picked, item)
      c -= Item.weight(item)
    end
    i -= 1
  end
  picked
end

def solve(label, items, capacity)
  table = build_table(items, capacity)
  best = table[Array.size(items)][capacity]
  picked = chosen_items(items, table, capacity)
  used = Array.sum(Array.map(picked) { |it| Item.weight(it) })
  puts("== #{label} (capacity #{capacity}) ==")
  puts("best value: #{best}")
  puts("weight used: #{used}/#{capacity}")
  Array.each(picked) { |it| puts("  #{it}") }
  skipped = Array.reject(items) { |it| Array.include?(picked, it) }
  names = Array.map(skipped) { |it| Item.name(it) }
  puts("skipped: #{Array.join(names, ", ")}")
  best
end

camping = Item[
  Item.new("tent", 11, 40),
  Item.new("stove", 4, 15),
  Item.new("water", 6, 30),
  Item.new("food", 5, 25),
  Item.new("camera", 2, 12),
  Item.new("book", 1, 3),
  Item.new("rope", 3, 9),
  Item.new("lantern", 2, 8)
]

results = Array[]
Array.each(Array[10, 20, 30]) do |cap|
  Array.push(results, [cap, solve("camping", camping, cap)])
end

parts = Item[
  Item.new("cpu", 3, 120),
  Item.new("gpu", 7, 300),
  Item.new("ram", 2, 60),
  Item.new("ssd", 2, 70),
  Item.new("fan", 1, 10)
]
Array.push(results, [12, solve("parts", parts, 12)])

puts("== summary ==")
Array.each(results) do |cap, value|
  ratio = Float.round(value / Integer.to_f(cap), 2)
  puts(format("%3d -> %4d (%.2f per unit)", cap, value, ratio))
end
