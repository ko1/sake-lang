require "optparse"

def build
  op = OptionParser.new
  OptionParser.set_banner(op, "Usage: tool [options]")
  OptionParser.separator(op, "")
  OptionParser.separator(op, "Specific options:")
  OptionParser.on(op, "-v", "--[no-]verbose", "Run verbosely")
  OptionParser.on(op, "-n", "--name NAME", "Name to use")
  OptionParser.on_type(op, "-c", "--count N", :Integer, "How many")
  OptionParser.on_type(op, "-r", "--ratio R", :Float, "Ratio")
  OptionParser.on(op, "-l", "--level [LEVEL]", "Optional level")
  OptionParser.on_type(op, "-t", "--type TYPE", Array["text", "binary", "bits"], "Select type")
  OptionParser.on(op, "-q", "", "Quiet")
  OptionParser.on(op, "", "--dry-run", "Dry run")
  OptionParser.on(op, "", "--debug", "Debug")
  OptionParser.on(op, "", "--a-very-long-option-name-here VALUE", "Long one")
  OptionParser.on(op, "-x VALUE", "", "Short with an argument")
  OptionParser.on(op, "-u", "--unicode-é", "Ünïcode ✓")
  OptionParser.on(op, "", "--nodesc", "")
  OptionParser.on_tail(op, "-h", "--help", "Show this message")
  OptionParser.separator(op, "Common options:")
  op
end

op = build
puts(OptionParser.help(op))
puts("--")
puts(op)
p(OptionParser.get_summary_width(op))
p(OptionParser.get_summary_indent(op))

cases = Array[
  String["-v", "-n", "foo", "a", "b"], String["--no-verbose", "--name=bar", "-c", "3", "x"],
  String["-vq", "-nfoo", "--", "-v"], String["-l"], String["-l", "3", "rest"], String["--level=4"],
  String["--verb", "--dry-"], String["-t", "bin"], String["-xval", "-x", "val2"],
  String["-z"], String["--zzz"], String["--name"], String["-c", "abc"], String["--dry-run=1"], String["--d"],
  String["-c"], String["-c", "0x10"], String["-r", "1e3"], String["-t", "foo"], String["-t", "bi"], String["-"],
  String["x", "-v", "y"], String["--count=-5"], String["-vn"], String["-v", "-n", "-c"], String["--n"],
  String["--na", "x"], String["--no-v"], String["--no-verbose=1"], String["-vz"], String["--no-name", "x"],
  String["--no-dry-run"], String["--de"], String["--level", "-v"], String["-l3"], String["-c", "-5"],
  String["--count="], String["--name="], String["a", "--", "-b"], String["--no-"], String["-c", "1_000"],
  String["-c", "08"], String["-c", "1.5"], String["-cabc"], String["--count", "abc"], String["-r", ".5"],
  String["-r", "x"], String["-u", "--unicode-é", "ü"], String["-h"], String[], String["--help", "--nodesc"]
]

def show(h) = "{" + Array.join(Hash.map(h) { |k, v| "#{k}: #{Kernel.inspect(v)}" }, ", ") + "}"

Array.each(cases) do |argv|
  h = Hash[]
  begin
    rest = OptionParser.parse(op, argv, h)
    puts("#{show(h)} #{Kernel.inspect(rest)}")
  rescue OptionParserError => e
    puts("#{OptionParserError.get_kind(e)}: #{Exception.message(e)} #{Kernel.inspect(OptionParserError.get_args(e))} #{OptionParserError.reason(e)}")
  end
  h2 = Hash[]
  copy = Array.dup(argv)
  begin
    r = OptionParser.order!(op, copy, h2)
    puts("#{show(h2)} #{Kernel.inspect(r)} #{Kernel.inspect(copy)}")
  rescue OptionParserError => e
    puts("order: #{Exception.message(e)} #{show(h2)}")
  end
end

args = String["-v", "file1", "--name", "n", "file2"]
h = Hash[]
r = OptionParser.parse!(op, args, h)
p(r)
p(args)
puts(show(h))

args = String["-a", "-b", "1", "--foo", "--bar=x", "rest"]
p(OptionParser.getopts(OptionParser.new, args, "ab:c", String["foo", "bar:", "baz"]))
p(args)

plain = OptionParser.new
OptionParser.set_program_name(plain, "plain")
OptionParser.on(plain, "-a", "", "")
print(OptionParser.help(plain))
