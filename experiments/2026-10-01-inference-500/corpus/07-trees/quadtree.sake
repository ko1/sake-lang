Rect = Struct.new(:x, :y, :w, :h)
Pt = Struct.new(:x, :y, :label)
Quad = Struct.new(:bounds, :points, :kids, :depth)
OutOfBounds = Exception.new(:point)

class Rect
  def contains?(r, p) = @x <= Pt.x(p) && Pt.x(p) < @x + @w && @y <= Pt.y(p) && Pt.y(p) < @y + @h
  def intersects?(r, o) = @x < Rect.x(o) + Rect.w(o) && Rect.x(o) < @x + @w && @y < Rect.y(o) + Rect.h(o) && Rect.y(o) < @y + @h
  def to_s(r) = "(#{@x},#{@y} #{@w}x#{@h})"
end

def capacity = 3
def max_depth = 5

class Quad
  def create(bounds, depth) = Quad.new(bounds, Array[], Array[], depth)

  def subdivide(q)
    b = @bounds
    hw = Rect.w(b) / 2
    hh = Rect.h(b) / 2
    x = Rect.x(b)
    y = Rect.y(b)
    Array.push(@kids, create(Rect.new(x, y, hw, hh), @depth + 1), create(Rect.new(x + hw, y, hw, hh), @depth + 1),
               create(Rect.new(x, y + hh, hw, hh), @depth + 1), create(Rect.new(x + hw, y + hh, hw, hh), @depth + 1))
    old = @points
    @points = Array[]
    Array.each(old) { |p| insert(q, p) }
  end

  def insert(q, p)
    raise OutOfBounds.new("#{Pt.label(p)} at (#{Pt.x(p)},#{Pt.y(p)}) is outside #{@bounds}", p) unless Rect.contains?(@bounds, p)
    if Array.empty?(@kids)
      if Array.size(@points) < capacity || @depth == max_depth
        Array.push(@points, p)
        return q
      end
      subdivide(q)
    end
    kid = Array.find(@kids) { |k| Rect.contains?(Quad.bounds(k), p) }
    insert(kid, p)
  end

  def query(q, area, out, stats)
    stats[:visited] += 1
    return out unless Rect.intersects?(@bounds, area)
    Array.each(@points) { |p| Array.push(out, p) if Rect.contains?(area, p) }
    Array.each(@kids) { |k| query(k, area, out, stats) }
    out
  end

  def count(q) = Array.size(@points) + Array.sum(Array.map(@kids) { |k| count(k) })
  def nodes(q) = 1 + Array.sum(Array.map(@kids) { |k| nodes(k) })
  def height(q) = Array.empty?(@kids) ? 1 : 1 + Array.max(Array.map(@kids) { |k| height(k) })

  def dump(q, indent)
    if Array.empty?(@kids)
      labels = Array.map(@points) { |p| Pt.label(p) }
      puts("#{indent}#{@bounds} #{Array.empty?(labels) ? "-" : Array.join(labels, " ")}")
    else
      puts("#{indent}#{@bounds}")
      Array.each(@kids) { |k| dump(k, indent + "  ") }
    end
  end
end

world = Quad.create(Rect.new(0, 0, 64, 64), 0)
readings = <<~TXT
  a 3 4
  b 60 2
  c 10 12
  d 12 10
  e 33 40
  f 35 41
  g 34 44
  h 36 46
  i 50 50
  j 8 9
  k 11 11
  l 70 5
  m 9 13
  n 62 62
TXT
String.each_line(readings) do |line|
  f = String.split(line, " ")
  begin
    Quad.insert(world, Pt.new(String.to_i(f[1]), String.to_i(f[2]), f[0]))
  rescue OutOfBounds => e
    puts("skip: #{Exception.message(e)}")
  end
end
puts("points #{Quad.count(world)}, nodes #{Quad.nodes(world)}, height #{Quad.height(world)}")
Quad.dump(world, "")

areas = Array[Rect.new(0, 0, 16, 16), Rect.new(30, 38, 8, 8), Rect.new(40, 0, 24, 24), Rect.new(0, 0, 64, 64)]
Array.each(areas) do |area|
  stats = Hash[visited: 0]
  hits = Quad.query(world, area, Array[], stats)
  names = Array.sort(Array.map(hits) { |p| Pt.label(p) })
  puts("query #{area}: #{Array.size(hits)} hit(s) [#{Array.join(names, ",")}] visiting #{stats[:visited]} of #{Quad.nodes(world)} nodes")
end

dense = Quad.create(Rect.new(0, 0, 64, 64), 0)
Integer.times(6) { |i| Quad.insert(dense, Pt.new(1, 1, "p#{i}")) }
puts("same spot x6: nodes #{Quad.nodes(dense)}, height #{Quad.height(dense)} (depth capped at #{max_depth})")
