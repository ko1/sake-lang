# sake: --strict=2
# Tuples tagged by a Symbol stay apart; testing the tag narrows the other parts (`|kind, arg|`, `op[0]`).
ops = Array[[:copy, 3], [:literal, Integer[1, 2]]]
Array.each(ops) do |kind, arg|
  case kind
  in :copy then p(arg + 1)
  in :literal then p(Array.size(arg))
  end
end
Array.each(ops) do |op|
  case op[0]
  in :copy then p(op[1] + 1)
  in :literal then p(Array.size(op[1]))
  end
  p(op[1] * 2) if op[0] == :copy
end
