# Status (2026-10-03): fixed; raises a catchable ArgumentError ("String.match: invalid byte sequence in UTF-8").
# String.byteslice can cut a UTF-8 character; matching the piece with String.match then crashes the
# interpreter with Ruby's internal ArgumentError backtrace (and `rescue ArgumentError` does not catch
# it), where Ruby raises a catchable ArgumentError ("invalid byte sequence in UTF-8").
piece = String.byteslice("aé", 0, 2) || ""
begin
  p String.match(piece, /\Aa/)
rescue ArgumentError => e
  puts "ArgumentError: #{Exception.message(e)}"
end
