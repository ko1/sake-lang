# Port of actionview-8.1.3/lib/action_view/helpers/csrf_helper.rb
#
# Rails asks `defined?(protect_against_forgery?) && protect_against_forgery?`: here the view's
# protect_against_forgery?, form_authenticity_token and request_forgery_protection_token (ControllerHelper's
# defaults, false outside a controller; a controller's view class overrides them).

require "tag_helper"
require "controller_helper"

module ActionView
  module Helpers
    module CsrfHelper
      # Rails' view has these from the controller; ControllerHelper gives them (with the defaults of a view
      # without one). A required `def ... = raise(NotImplementedError)` here would hide those defaults, as a
      # later include does in Ruby.
      include ControllerHelper

      def csrf_meta_tags(v)
        return nil unless protect_against_forgery?(v)
        String.html_safe(Array.join(String[
          Object.html_text(tag(v, "meta", Hash.of(name: "csrf-param", content: request_forgery_protection_token(v)))),
          Object.html_text(tag(v, "meta", Hash.of(name: "csrf-token", content: form_authenticity_token(v))))
        ], "\n"))
      end

      def csrf_meta_tag(v) = csrf_meta_tags(v)
    end
  end
end
