# Port of actionpack-8.1.3/lib/abstract_controller/error.rb, with DoubleRenderError (abstract_controller/rendering.rb) and ActionNotFound (abstract_controller/base.rb)
#
# Rails' `class DoubleRenderError < Error` is a copy in Sake, so AbstractController::Error is a module the
# exceptions include: `rescue AbstractController::Error` catches them, as in Rails.

module AbstractController
  module Error
  end

  class DoubleRenderError < StandardError
    include Error
    def default_message = "Render and/or redirect were called multiple times in this action. Please note that you may only call render OR redirect, and at most once per action. Also note that neither redirect nor render terminate execution of the action, so if you want to exit an action after redirecting, you need to do something like \"redirect_to(...); return\"."
    def build = DoubleRenderError.new(DoubleRenderError.default_message)
  end

  # Ruby keeps the controller object; here its class name (a field holds one type, and every controller is one).
  class ActionNotFound < StandardError
    attr_reader controller, action
  end
end
