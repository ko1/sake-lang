# Port of activemodel-8.1.3/lib/active_model/type/time.rb (partial: no user_input_in_time_zone, no ::Date._parse fallback)

module ActiveModel
  module Type
    class Time
      attr_reader precision, scale, limit
      include Value
      include Helpers::Timezone
      include Helpers::AcceptsMultiparameterTime
      include Helpers::TimeValue

      def initialize(t) = nil
      def multiparameter_defaults(t) = Hash.of(1 => 2000, 2 => 1, 3 => 1, 4 => 0, 5 => 0)

      def type(t) = :time

      def cast_value(t, value)
        return apply_seconds_precision(t, value) unless value in ::String
        return nil if ::String.strip(value) == ""
        dummy_time_value = ::String.sub(value, /\A\d{4}-\d\d-\d\d(?:T|\s)|/, "2000-01-01 ")
        fast_string_to_time(t, dummy_time_value)
      end
    end
  end
end
