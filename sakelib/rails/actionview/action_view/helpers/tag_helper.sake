# Port of actionview-8.1.3/lib/action_view/helpers/tag_helper.rb (partial: TagBuilder's element methods are generated by tag_builder_elements.sake; the builder passes no argument to a block)
#
# A mixin of the view. Rails' TagBuilder defines one method per HTML element with class_eval and answers any
# other name with method_missing (`tag.my_widget`); here the element functions are generated from Rails' own
# list, and an unknown element is `TagBuilder.element(b, :my_widget, ...)`, method_missing's body.
# Options are a Hash (Rails' options Hash); helpers that Rails calls with trailing keywords take `**options` too.

require "../../../activesupport/active_support/core_ext/string/output_safety"
require "../../../activesupport/active_support/core_ext/string/inflections"
require "../../../activesupport/active_support/json"
require "capture_helper"
require "output_safety_helper"

module ActionView
  module Helpers
    module TagHelper
      include CaptureHelper
      include OutputSafetyHelper

      def tag_builder(v) = raise(NotImplementedError)

      class TagBuilder
        attr_reader view_context

        def attributes(b, attributes) = String.html_safe(String.strip(TagBuilder.tag_options(b, attributes) || ""))

        def content_tag_string(b, name, content, options, escape = true)
          tag_options = options ? TagBuilder.tag_options(b, options, escape) : nil
          if escape && TagHelper.present_content?(content)
            content = ActiveSupport::CoreExt::ERBUtil.unwrapped_html_escape(content)
          end
          String.html_safe("<#{name}#{tag_options}>#{TagHelper.pre_content_string(name)}#{Object.html_text(content)}</#{name}>")
        end

        def tag_options(b, options, escape = true)
          return nil if options == nil || Hash.empty?(options)
          output = ""
          sep = " "
          Hash.each(options) do |key, value|
            next if Object.blank?(key)
            type = TagHelper.tag_type(key)
            if type == :data && (value in Hash)
              Hash.each(value) do |k, v|
                next if Object.blank?(k) || v == nil
                output += sep
                output += prefix_tag_option(b, key, k, v, escape)
              end
            elsif type == :aria && (value in Hash)
              Hash.each(value) do |k, v|
                next if Object.blank?(k) || v == nil
                s = case v
                    in Array | Hash
                      tokens = TagHelper.build_tag_values(Any[v])
                      next if Array.empty?(tokens)
                      OutputSafetyHelper.safe_join(@view_context, tokens, " ")
                    else Kernel.to_s(v)
                    end
                output += sep
                output += prefix_tag_option(b, key, k, s, escape)
              end
            elsif type == :boolean
              if value != nil && value != false
                output += sep
                output += boolean_tag_option(b, key)
              end
            elsif value != nil
              output += sep
              output += tag_option(b, key, value, escape)
            end
          end
          String.empty?(output) ? nil : output
        end

        # private
        def tag_string(b, name, content, options, escape = true)
          content = CaptureHelper.capture(@view_context) { yield } if block_given?
          content_tag_string(b, name, content, options, escape)
        end

        def self_closing_tag_string(b, name, options, escape = true, tag_suffix = " />")
          String.html_safe("<#{name}#{TagBuilder.tag_options(b, options, escape)}#{tag_suffix}")
        end

        def boolean_tag_option(b, key) = "#{key}=\"#{key}\""

        def tag_option(b, key, value, escape)
          key_s = escape ? ERB::Util.xml_name_escape(Kernel.to_s(key)) : Kernel.to_s(key)
          s = case value
              in Array | Hash
                values = key_s == "class" ? TagHelper.build_tag_values(Any[value]) : value
                escape ? Object.html_text(OutputSafetyHelper.safe_join(@view_context, Any[values], " ")) : Array.join(Array.flatten(Any[values]), " ")
              in Regexp then escape ? ActiveSupport::CoreExt::ERBUtil.unwrapped_html_escape(Regexp.source(value)) : Regexp.source(value)
              else escape ? ActiveSupport::CoreExt::ERBUtil.unwrapped_html_escape(value) : Object.html_text(value)
              end
          s = String.gsub(s, '"', "&quot;") if String.include?(s, '"')
          "#{key_s}=\"#{s}\""
        end

        def prefix_tag_option(b, prefix, key, value, escape)
          key_s = "#{prefix}-#{String.dasherize(Kernel.to_s(key))}"
          v = case value
              in String | Symbol | ActiveSupport::SafeBuffer then value
              else ActiveSupport::JSON.encode(value)
              end
          tag_option(b, key_s, v, escape)
        end

        # Ruby: method_missing(called, *args, escape: true, **options, &block): `tag.my_widget`
        def element(b, called, content = nil, escape: true, **options)
          name = String.dasherize(Kernel.to_s(called))
          TagHelper.ensure_valid_html5_tag_name(name)
          return tag_string(b, name, content, options, escape) { yield } if block_given?
          tag_string(b, name, content, options, escape)
        end
      end

      # Ruby: tag(name = nil, options = nil, open = false, escape = true); `tag` alone is the TagBuilder
      def tag(v, name = nil, options = nil, open = false, escape = true)
        if name == nil
          tag_builder(v)
        else
          TagHelper.ensure_valid_html5_tag_name(name)
          String.html_safe("<#{name}#{options ? TagBuilder.tag_options(tag_builder(v), options, escape) : nil}#{open ? ">" : " />"}")
        end
      end

      # Ruby: content_tag(name, content_or_options_with_block = nil, options = nil, escape = true, &block);
      # Ruby's trailing keywords (`content_tag :p, "x", class: "y"`) are `**html_options`
      def content_tag(v, name, content_or_options_with_block = nil, options = nil, escape = true, **html_options)
        options = html_options if options == nil && !Hash.empty?(html_options)
        TagHelper.ensure_valid_html5_tag_name(name)
        if block_given?
          options = content_or_options_with_block if content_or_options_with_block in Hash
          TagBuilder.content_tag_string(tag_builder(v), name, capture(v) { yield }, options, escape)
        else
          TagBuilder.content_tag_string(tag_builder(v), name, content_or_options_with_block, options, escape)
        end
      end

      def token_list(v, *args)
        tokens = Array.uniq(Array.flat_map(TagHelper.build_tag_values(args)) { |value| String.split(CGI.unescape_html(Kernel.to_s(value)), /\s+/) })
        safe_join(v, tokens, " ")
      end

      def class_names(v, *args) = token_list(v, *args)

      def cdata_section(v, content)
        splitted = String.gsub(Object.html_text(content), /\]\]>/, "]]]]><![CDATA[>")
        String.html_safe("<![CDATA[#{splitted}]]>")
      end

      def escape_once(v, html) = ERB::Util.html_escape_once(html)

      # private

      # private, module_function (Rails: module_function :ensure_valid_html5_tag_name, :build_tag_values)
      module_function

      def boolean_attributes = once do
        Set.of("allowfullscreen", "allowpaymentrequest", "async", "autofocus", "autoplay", "checked", "compact",
               "controls", "declare", "default", "defaultchecked", "defaultmuted", "defaultselected", "defer",
               "disabled", "enabled", "formnovalidate", "hidden", "indeterminate", "inert", "ismap", "itemscope",
               "loop", "multiple", "muted", "nohref", "nomodule", "noresize", "noshade", "novalidate", "nowrap",
               "open", "pauseonexit", "playsinline", "readonly", "required", "reversed", "scoped", "seamless",
               "selected", "sortable", "truespeed", "typemustmatch", "visible")
      end

      # Ruby: TAG_TYPES[key] (String and Symbol keys)
      def tag_type(key)
        k = Kernel.to_s(key)
        return :boolean if Set.include?(boolean_attributes, k)
        return :data if k == "data"
        return :aria if k == "aria"
        nil
      end

      # Ruby: PRE_CONTENT_STRINGS[name]
      def pre_content_string(name) = Kernel.to_s(name) == "textarea" ? "\n" : ""

      # (Sake only) Ruby's `content.present?` of a tag's content (a String, a SafeBuffer, a number, nil)
      def present_content?(x) = x != nil && x != false && String.present?(Object.html_text(x))

      def ensure_valid_html5_tag_name(name)
        raise ArgumentError, "Invalid HTML5 tag name: #{Kernel.inspect(name)}" unless String.match?(Kernel.to_s(name), /\A[a-zA-Z][^\s\/>]*\z/)
      end

      # Ruby: build_tag_values(*args)
      def build_tag_values(args)
        tag_values = String[]
        Array.each(args) do |tag_value|
          case tag_value
          in Hash
            Hash.each(tag_value) { |key, val| Array.push(tag_values, Kernel.to_s(key)) if val != nil && val != false && Object.present?(Kernel.to_s(key)) }
          in Array then Array.concat(tag_values, build_tag_values(tag_value))
          else Array.push(tag_values, Object.html_text(tag_value)) if TagHelper.present_content?(tag_value)
          end
        end
        tag_values
      end

    end
  end
end
