module Sql
  module Joins
    def self.run: (FromPlan from, Array[Array[Array[value]]] row_sets, Array[value] outer) -> Array[Array[value]]
    def self.join_rows: (PlanJoin join, Array[Array[value]] left_rows, Array[Array[value]] right_rows, Array[value] outer) -> Array[Array[value]]
    def self.accepts?: (Ast::Expr? condition, Array[value] row) -> bool
  end
end
