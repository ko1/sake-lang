class Bk
  attr_reader id, room, day, s, e, who
end

def hm(m) = format("%02d:%02d", m / 60, m % 60)

def tm(t)
  m = String.match(t, /\A(\d\d):(\d\d)\z/)
  return nil unless m
  h = String.to_i(m[1])
  mi = String.to_i(m[2])
  v = h * 60 + mi
  return nil if mi >= 60 || mi % 15 != 0 || v < 480 || v > 1200
  v
end

def overlap(b, room, day, s, e) = Bk.room(b) == room && Bk.day(b) == day && Bk.s(b) < e && s < Bk.e(b)

days = Array["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
books = Array[]
next_id = 1
n = 0
Array.each(IO.readlines(IO.stdin)) do |raw|
  n += 1
  line = String.chomp(raw)
  next if String.empty?(String.strip(line))
  f = String.split(line, " ")
  cmd = f[0]
  want = cmd == "BOOK" ? 5 : (cmd == "CANCEL" ? 2 : (cmd == "FREE" ? 4 : 0))
  if want == 0
    puts("line #{n}: error: unknown command")
    next
  end
  if Array.size(f) != want
    puts("line #{n}: error: wrong field count")
    next
  end
  if cmd == "CANCEL"
    unless String.match?(f[1], /\A\d+\z/)
      puts("line #{n}: error: bad id")
      next
    end
    id = String.to_i(f[1])
    b = Array.find(books) { |x| Bk.id(x) == id }
    if b
      Array.delete(books, b)
      puts("CANCELLED ##{id}")
    else
      puts("NO BOOKING ##{id}")
    end
    next
  end
  room = f[1]
  day = f[2]
  unless String.match?(room, /\A[A-Z0-9]{1,8}\z/)
    puts("line #{n}: error: bad room")
    next
  end
  unless Array.include?(days, day)
    puts("line #{n}: error: bad day")
    next
  end
  if cmd == "FREE"
    unless String.match?(f[3], /\A\d+\z/) && String.to_i(f[3]) > 0 && String.to_i(f[3]) % 15 == 0
      puts("line #{n}: error: bad duration")
      next
    end
    dur = String.to_i(f[3])
    t = 480
    found = nil
    while t + dur <= 1200
      if Array.none?(books) { |b| overlap(b, room, day, t, t + dur) }
        found = t
        break
      end
      t += 15
    end
    if found
      puts("FREE #{room} #{day} #{hm(found)}-#{hm(found + dur)}")
    else
      puts("FULL #{room} #{day}")
    end
    next
  end
  mm = String.match(f[3], /\A([^-]*)-([^-]*)\z/)
  s = mm ? tm(mm[1]) : nil
  e = mm ? tm(mm[2]) : nil
  unless s && e && s < e
    puts("line #{n}: error: bad time")
    next
  end
  who = f[4]
  unless String.match?(who, /\A[a-z]{1,12}\z/)
    puts("line #{n}: error: bad name")
    next
  end
  clash = Array.sort_by(Array.select(books) { |b| overlap(b, room, day, s, e) }) { |b| Bk.s(b) }
  if !Array.empty?(clash)
    c = clash[0]
    puts("CONFLICT #{room} #{day} with ##{Bk.id(c)} (#{Bk.who(c)} #{hm(Bk.s(c))}-#{hm(Bk.e(c))})")
  elsif Array.count(books) { |b| Bk.who(b) == who && Bk.day(b) == day } >= 3
    puts("LIMIT #{who} #{day}")
  else
    Array.push(books, Bk.new(next_id, room, day, s, e, who))
    puts("OK ##{next_id} #{room} #{day} #{hm(s)}-#{hm(e)} #{who}")
    next_id += 1
  end
end
puts("== schedule ==")
puts("(none)") if Array.empty?(books)
sorted = Array.sort_by(books) { |b| [Array.index(days, Bk.day(b)), Bk.room(b), Bk.s(b)] }
Array.each(sorted) do |b|
  puts(format("%s %-8s %s-%s #%d %s", Bk.day(b), Bk.room(b), hm(Bk.s(b)), hm(Bk.e(b)), Bk.id(b), Bk.who(b)))
end
puts("== usage ==")
puts("(none)") if Array.empty?(books)
tot = Hash.new(0)
Array.each(books) { |b| tot[Bk.room(b)] += Bk.e(b) - Bk.s(b) }
Array.each(Array.sort(Hash.keys(tot))) do |r|
  puts(format("%-8s %dh%02dm", r, tot[r] / 60, tot[r] % 60))
end
