# Collatz (3n+1) statistics with a memo table: chain lengths, record holders,
# peak values, and the distribution of lengths.

class Chain
  attr_reader start, length, peak

  def to_s(c) = "#{@start}: length #{@length}, peak #{@peak}"
end

def next_term(n) = Integer.even?(n) ? n / 2 : 3 * n + 1

def chain_length(n, memo)
  path = Integer[]
  while n != 1 && memo[n] == nil
    Array.push(path, n)
    n = next_term(n)
  end
  len = n == 1 ? 1 : memo[n]
  Array.reverse_each(path) do |k|
    len += 1
    memo[k] = len
  end
  len
end

def peak(n)
  top = n
  while n != 1
    n = next_term(n)
    top = n if n > top
  end
  top
end

def trajectory(n)
  seq = Integer[n]
  while n != 1
    n = next_term(n)
    Array.push(seq, n)
  end
  seq
end

limit = 1200
memo = Hash[1 => 1]
chains = Range.map(1..limit) { |n| Chain.new(n, chain_length(n, memo), peak(n)) }

longest = Array.max_by(chains) { |c| Chain.length(c) }
puts("longest chain below #{limit}: #{longest}")
highest = Array.max_by(chains) { |c| Chain.peak(c) }
puts("highest peak below #{limit}: #{highest}")

puts("length records:")
best = 0
Array.each(chains) do |c|
  if Chain.length(c) > best
    best = Chain.length(c)
    puts("  #{c}") if Chain.start(c) > 20
  end
end

puts("trajectory of 27 (first 20): #{Array.join(Array.take(trajectory(27), 20), " ")} ...")

buckets = Array.group_by(chains) { |c| Chain.length(c) / 25 }
puts("length distribution:")
Array.each(Array.sort(Hash.keys(buckets))) do |b|
  n = Array.size(buckets[b])
  puts(format("  %3d-%3d %5d %s", b * 25, b * 25 + 24, n, "#" * ((n + 19) / 20)))
end

pairs = 0
Array.each_cons(chains, 2) do |a, b|
  pairs += 1 if Chain.length(a) == Chain.length(b)
end
puts("consecutive starts with equal length: #{pairs}")

pow2 = Array.select(chains) { |c| Chain.peak(c) == Chain.start(c) && Chain.start(c) > 1 }
puts("starts that never exceed themselves: #{Array.size(pow2)}")
puts("memo entries: #{Hash.size(memo)}")
avg = Float.round(Array.sum(chains) { |c| Chain.length(c) } / Integer.to_f(limit), 3)
puts("average length: #{avg}")
