Point = Struct.new(:x, :y)

class Point
  def norm2(p) = @x * @x + @y * @y           # @x is Point.get_x(p): p is the first argument
  def move(p, dx, dy)
    @x += dx                                 # Point.set_x(p, Point.get_x(p) + dx)
    @y += dy
    p
  end
end

pt = Point.new(3, 4)
puts(Point.norm2(pt))
Point.move(pt, 1, 1)
p(pt)
puts(Point.norm2(7))
