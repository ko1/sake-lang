# Ruby's x.class.name, as Rails formats errors and keys with it.
module Shop
  class Order
    attr_reader id
  end
  class RecordNotFound < StandardError
  end
end
Point = Struct.new(:x, :y)
values = Any[1, 2.5, 3r, "s", :sym, nil, true, false, [1, "a"], Any[1], {a: 1}, Hash.new, Set.new, 1..2, /re/,
             Time.at(0), Point.new(1, 2), Shop::Order.new(1), Shop::RecordNotFound.new("gone"), KeyError.new("k")]
puts Array.map(values) { |v| Kernel.class_name(v) }.Array.join(" ")
begin
  Hash.fetch(Hash.new, :missing)
rescue => e
  puts "#{Kernel.class_name(e)}: #{Exception.message(e)}"
end
