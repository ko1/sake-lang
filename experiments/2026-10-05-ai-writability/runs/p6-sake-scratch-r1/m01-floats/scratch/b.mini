fn t(f)
  try f() catch e print(e["kind"], e["message"], e["line"], e["col"]) end
end
t(fn() return 10.0 ** 400 end)
t(fn() return (-8.0) ** 0.5 end)
t(fn() return 1.0 % 0 end)
t(fn() return 1 / -0.0 end)
t(fn() return 10 ** 400 * 1.0 end)
t(fn() return float("1.") end)
t(fn() return float(10 ** 400) end)
t(fn() return {}[1.5] end)
t(fn() return sort([1.0, "a"]) end)
t(fn() return min(1, "a") end)
t(fn() return slice([1], 0.5) end)
t(fn() return 1.5 < "a" end)
t(fn() return 2.0 ** -1 end)
t(fn() return (-8.0) ** 3 end)
t(fn() return 5 % 2.5 end)
t(fn() return 1 + 10 ** 400 / 1.0 end)
t(fn() return int(10 ** 300 * 1.0) end)
print(2 ** 53 + 1 > 9007199254740992.0, 2 ** 53 + 1 == 9007199254740992.0, 3 < 3.5, [2, 1.0, 1.5, 1], 0.1 * 3)
