# `x => T` asserts x's type (Ruby's rightward pattern match): after it, x is a T. A value that does not
# match raises NoMatchingPatternError, and is reported before running when the checker sees it.
class Config
  attr_reader host, port = 80
  def set_port(c, p)
    p => Integer
    @port = p
  end
  def next_port(c) = @port + 1
end
c = Config.new("h")
Config.set_port(c, 8080)
p(Config.next_port(c))

def width(x)
  x => Integer | Float
  x * 2
end
p(width(3))
p(width(1.5))
v = Array.first(Array[1, 2])   # Integer or nil
v => Integer
p(v + 1)
