# abbrev: the set of unambiguous abbreviations of a list of words (Ruby's abbrev).

module Abbrev
  module_function

  # pattern: nil, a Regexp the abbreviations must match, or a String they must start with.
  def abbrev(words, pattern = nil)
    table = Hash[]
    seen = Hash.new(0)
    words = Array.uniq(words)
    Array.each(words) do |word|
      next if String.empty?(word)
      Integer.downto(String.length(word), 1) do |len|
        abbrev = String.[](word, 0, len) || ""
        next unless fits?(abbrev, pattern)
        seen[abbrev] += 1
        n = seen[abbrev]
        if n == 1
          table[abbrev] = word
        elsif n == 2
          Hash.delete(table, abbrev)
        else
          break
        end
      end
    end
    Array.each(words) do |word|
      next unless fits?(word, pattern)
      table[word] = word
    end
    table
  end

  def fits?(s, pattern)
    case pattern
    in nil then true
    in Regexp then Regexp.match?(pattern, s)
    in String then String.start_with?(s, pattern)
    end
  end
end

# Ruby: %w[car cone].abbrev (Array#abbrev, added by require "abbrev").
class Array
  def abbrev(words, pattern = nil) = Abbrev.abbrev(words, pattern)
end
