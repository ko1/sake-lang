# Operations from the delegation table (lib/sake/stdlib_table.rb).
p(String.partition("a=b=c", "="))
p(String.rpartition("a=b=c", "="))
p(String.delete_prefix("unhappy", "un"))
p(String.codepoints("AB"))
p(String.rindex("hello", "l"))
String.upto("a", "c") { print(it) }
puts
p(Symbol.upcase(:abc))
p(Integer.ceildiv(7, 2)); p(Integer.round(1234, -2)); p(Integer.gcdlcm(4, 6))
p(Float.fdiv(1.0, 4))
a = Array[3, 1, 4, 1, 5]
p(Array.filter_map(a) { it > 2 ? it * 10 : nil })
p(Array.take_while(a) { it < 4 })
p(Array.minmax(a))
p(Array.combination(Array[1, 2, 3], 2))
p(Array.chunk_while(Array[1, 2, 4, 5, 7]) { |x, y| y == x + 1 })
p(Array.transpose(Array[Array[1, 2], Array[3, 4]]))
p(Array.union(Array[1, 2], Array[2, 3]))
p(Array.to_set(a))
p(Array.values_at(a, 0, 2, 9))
p(Range.group_by(1..6) { it % 3 })
p(Range.partition(1..6) { Integer.even?(it) })
p(Range.each_with_object(1..3, Array[]) { |i, acc| Array.push(acc, i * i) })
Range.each_slice(1..5, 2) { p(it) }
p(Range.flat_map(1..3) { Array[it, it] })
s = Set[3, 1, 2]
p(Set.sort(s)); p(Set.join(s, "-")); p(Set.sum(s)); p(Set.reduce(s, 0) { |acc, x| acc + x })
h = Hash["a" => 1, "b" => nil, "c" => 3]
p(Hash.compact(h)); p(Hash.except(h, "a")); p(Hash.values_at(h, "a", "z"))
p(Hash.group_by(h) { |k, v| v == nil })
p(Hash.partition(h) { |k, v| v == nil })
p(Hash.each_with_object(h, Array[]) { |kv, acc| Array.push(acc, kv) })
p(Hash.reduce(Hash["x" => 2, "y" => 3], 0) { |acc, kv| acc + Tuple.size(kv) })
p(Hash.first(h)); p(Hash.filter_map(h) { |k, v| v })
p(Time.iso8601(Time.utc(Time.at(0))))
p(Time.thursday?(Time.utc(Time.at(0))))
