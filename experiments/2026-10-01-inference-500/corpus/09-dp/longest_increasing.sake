Envelope = Struct.new(:label, :w, :h)

# O(n^2) version: lengths and predecessors
def lis_quadratic(xs)
  n = Array.size(xs)
  return Array[] if n == 0
  len = Array.fill(Range.to_a(0...n), 1)
  prev = Array.fill(Range.to_a(0...n), nil)
  Integer.times(n) do |i|
    Integer.times(i) do |j|
      if xs[j] < xs[i] && len[j] + 1 > len[i]
        len[i] = len[j] + 1
        prev[i] = j
      end
    end
  end
  best = Array.max(len)
  k = Array.index(len, best)
  out = Array[]
  while k != nil
    Array.unshift(out, xs[k])
    k = prev[k]
  end
  out
end

# patience sorting: tails[i] = index of smallest tail of an increasing run of length i+1
def lower_bound(xs, tails, x)
  lo = 0
  hi = Array.size(tails)
  while lo < hi
    mid = (lo + hi) / 2
    if xs[tails[mid]] < x
      lo = mid + 1
    else
      hi = mid
    end
  end
  lo
end

def lis_fast(xs)
  tails = Array[]
  parent = Array[]
  Array.each_with_index(xs) do |x, i|
    pos = lower_bound(xs, tails, x)
    Array.push(parent, pos > 0 ? tails[pos - 1] : nil)
    if pos == Array.size(tails)
      Array.push(tails, i)
    else
      tails[pos] = i
    end
  end
  out = Array[]
  k = Array.last(tails)
  while k != nil
    Array.unshift(out, xs[k])
    k = parent[k]
  end
  out
end

def nested_envelopes(envs)
  # sort by width ascending and height descending, so equal widths cannot nest
  sorted = Array.sort_by(envs) { |e| Envelope.w(e) * 10000 - Envelope.h(e) }
  heights = Array.map(sorted) { |e| Envelope.h(e) }
  chain = lis_fast(heights)
  picked = Array[]
  idx = 0
  Array.each(sorted) do |e|
    if idx < Array.size(chain) && Envelope.h(e) == chain[idx]
      if Array.empty?(picked) || Envelope.w(Array.last(picked)) < Envelope.w(e)
        Array.push(picked, e)
        idx += 1
      end
    end
  end
  picked
end

sequences = Array[
  Array[10, 9, 2, 5, 3, 7, 101, 18],
  Array[0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15],
  Array[5, 4, 3, 2, 1],
  Array[1, 2, 3, 4],
  Array[3, 10, 2, 1, 20, 4, 6, 7, 30, 5],
  Array[]
]
Array.each(sequences) do |xs|
  slow = lis_quadratic(xs)
  fast = lis_fast(xs)
  agree = Array.size(slow) == Array.size(fast) ? "agree" : "DISAGREE"
  puts("#{xs}")
  puts("  n^2:     #{slow} (#{Array.size(slow)})")
  puts("  n log n: #{fast} (#{Array.size(fast)}) #{agree}")
end

prices = Array[31, 29, 33, 35, 30, 28, 36, 40, 37, 41, 39, 44, 42, 38, 45]
run = lis_fast(prices)
puts("longest rising run of prices: #{Array.join(run, " < ")}")
days = Array.map(run) { |v| Array.index(prices, v) + 1 }
puts("on days #{Array.join(days, ", ")}")

envs = Envelope[
  Envelope.new("A", 5, 4), Envelope.new("B", 6, 4), Envelope.new("C", 6, 7),
  Envelope.new("D", 2, 3), Envelope.new("E", 8, 9), Envelope.new("F", 7, 8),
  Envelope.new("G", 3, 2), Envelope.new("H", 9, 10)
]
nest = nested_envelopes(envs)
labels = Array.map(nest) { |e| "#{Envelope.label(e)}(#{Envelope.w(e)}x#{Envelope.h(e)})" }
puts("envelopes nest #{Array.size(nest)} deep: #{Array.join(labels, " in ")}")
