let m = {true: "yes", 1: "one", nil: "none"}
m[false] = "no"
m[nil] += "!"
print(m, m[true], m[1], nil in m, keys(m), [] in m, has(m, false), del(m, 1), type(keys(m)[2]))
print({true: 1} == {1: 1}, {true: 1, nil: 2, true: 3})
for k, v in m do print(k, v) end
print(get({false: 0}, false), get({}, [1], 0))
