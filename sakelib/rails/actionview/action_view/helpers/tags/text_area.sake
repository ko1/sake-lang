# Port of actionview-8.1.3/lib/action_view/helpers/tags/text_area.rb

require "text_field"

module ActionView
  module Helpers
    module Tags
      class TextArea < Base
        # Ruby: include Placeholderable
        def after_initialize(t)
          tag_value = @options[:placeholder]
          @options[:placeholder] = Placeholderable.placeholder(@object, @object_name, @method_name, tag_value) if tag_value != nil && tag_value != false
        end

        def render(t)
          options = Hash.stringify_keys(@options)
          add_default_name_and_field(t, options)
          size = Hash.delete(options, "size")
          if size in String
            cols, rows = String.split(size, "x")
            options["cols"] = cols
            options["rows"] = rows
          end
          content = Hash.key?(options, "value") ? Hash.delete(options, "value") : value_before_type_cast(t)
          content_tag(t, "textarea", content, options)
        end
      end
    end
  end
end
