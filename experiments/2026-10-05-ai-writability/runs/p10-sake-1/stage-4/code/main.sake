# A small SQL engine (a subset of SQLite): reads a script on standard input, runs it, prints results.
#
#   sql_error  - the engine's single error type
#   lexer      - script text -> tokens
#   ast        - the syntax tree node types
#   parser / expression_parser - tokens of one statement -> a statement node
#   value      - the value model: printing, order, truth, arithmetic
#   coercion   - storing into typed columns, comparison affinity
#   database   - tables, columns, rows
#   scope      - what names mean while an expression is resolved (sources, enclosing queries)
#   names      - column lookup: bare and qualified names, aliases, enclosing queries
#   resolver   - binds names in an expression; plans subqueries; reports unknown names and functions
#   functions / text_functions / rounding - scalar SQL functions
#   like_pattern - LIKE matching
#   constraints - the checks a row passes before it is stored
#   evaluator  - evaluates a resolved expression on a row
#   sorter     - ORDER BY
#   expr_key   - text keys that tell identical expressions apart
#   aggregates - aggregate functions over the rows of a group
#   grouping   - GROUP BY: rows -> group rows (HAVING applied)
#   plan       - the data types of a planned SELECT
#   from_planner - plans FROM: sources, joins, ON / USING
#   planner    - resolves a SELECT's clauses into a Plan (all name errors are found here)
#   joiner     - executes FROM: the rows of the joined sources
#   ddl / dml / query - CREATE/DROP TABLE, INSERT/UPDATE/DELETE, SELECT (query executes a Plan)
#   executor   - dispatches a statement to ddl / dml / query
#   script     - splits the input into statements and reports errors
require "sql_error"
require "lexer"
require "ast"
require "parser"
require "expression_parser"
require "value"
require "coercion"
require "database"
require "scope"
require "names"
require "resolver"
require "functions"
require "text_functions"
require "rounding"
require "like_pattern"
require "constraints"
require "evaluator"
require "sorter"
require "expr_key"
require "aggregates"
require "grouping"
require "plan"
require "from_planner"
require "planner"
require "joiner"
require "ddl"
require "dml"
require "query"
require "executor"
require "script"

Script.run(IO.read(IO.stdin))
