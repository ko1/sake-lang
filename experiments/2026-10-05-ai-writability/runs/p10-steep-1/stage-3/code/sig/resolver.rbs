module Sql
  class Resolver
    type mode = :allow | :where | :group_by | :order

    @columns: Array[Column]
    @aliases: Hash[String, Ast::Expr]
    @mode: mode
    @slots: AggregateSlots?

    def initialize: (Array[Column] columns, Hash[String, Ast::Expr] aliases, ?mode mode, ?AggregateSlots? slots) -> void
    def resolve: (Ast::Expr expr) -> Ast::Expr

    private

    def resolve_name: (String name) -> Ast::Expr
    def reject_aggregate: (String name, bool by_alias) -> bot
    def resolve_case: (Ast::CaseExpr expr) -> Ast::CaseExpr
    def resolve_call: (Ast::FunctionCall call) -> Ast::Expr
    def resolve_aggregate: (Ast::FunctionCall call, String function) -> Ast::Expr
    def argument_resolver: () -> Resolver
  end
end
