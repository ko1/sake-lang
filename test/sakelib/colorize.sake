require "colorize"

# one colour, a background, a mode (Ruby: "x".red, "x".red.on_blue, ...)
p(Colorize.red("x"))
p(Colorize.on_blue("x"))
p(Colorize.bold("x"))
p(Colorize.on_blue(Colorize.red("x")))
p("x".Colorize.red.Colorize.on_blue.Colorize.bold)
p("x".Colorize.light_yellow.Colorize.on_light_black.Colorize.underline)

# colorize with a Symbol, keywords, a Record (Ruby: a Symbol or a Hash)
p(Colorize.colorize("hello", :light_cyan))
p(Colorize.colorize("hello", color: :green, background: :black, mode: :underline))
p(Colorize.colorize("hello", {color: :yellow, mode: :italic}))
p(Colorize.colorize("hello", {background: :magenta}))
p(Colorize.colorize("hello", {color: :red}, mode: :dim))
p(Colorize.colorize(Colorize.red("x"), background: :white))

# a String with plain and coloured runs: each run keeps its own codes
s = "plain " + Colorize.red("red") + " and " + Colorize.on_green("green") + " end"
p(s)
p(Colorize.bold(s))
p(Colorize.blue(s))
p(Colorize.uncolorize(Colorize.bold(s)))
p(Colorize.uncolorize("nothing"))
p(Colorize.colorized?(s))
p(Colorize.colorized?("nothing"))
p(Colorize.colorized?(""))
p(Colorize.red(""))
p(Colorize.underline("two\nlines"))

# an unknown name keeps what is there
p(Colorize.colorize("x", :nope))
p(Colorize.colorize(Colorize.red("x"), color: :nope, mode: :blink))

# the tables
p(Colorize.colors)
p(Colorize.modes)
p(Colorize.color(:red))
p(Colorize.background_color(:light_red))
p(Colorize.mode(:bold))
p(Colorize.color(:nope))
Array.each(Colorize.colors) { |c| p(Colorize.colorize(Symbol.to_s(c), color: c)) }
Array.each(Colorize.modes) { |m| p(Colorize.colorize(Symbol.to_s(m), mode: m)) }
p([Colorize.light_black("1"), Colorize.on_light_white("2"), Colorize.invert("3"), Colorize.strike("4"), Colorize.default("5"), Colorize.on_default("6")])

# an alias (Ruby: String.add_color_alias(:grey, :light_black))
Colorize.add_color_alias(:grey, :light_black)
p(Colorize.colorize("x", :grey))
p(Colorize.colorize("x", background: :grey))
begin
  Colorize.add_color_alias(:grey, :red)
rescue RuntimeError => e
  puts(Exception.message(e))
end
begin
  Colorize.add_color_alias(:pink, :rose)
rescue RuntimeError => e
  puts(Exception.message(e))
end

# switching colours off (Ruby: String.disable_colorization = true)
p(Colorize.disable_colorization)
Colorize.disable_colorization(true)
p(Colorize.disable_colorization)
p(Colorize.red("x"))
p(Colorize.colorize("x", color: :red, mode: :bold))
Colorize.set_disable_colorization(false)
p(Colorize.red("x"))
