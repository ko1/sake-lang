#!/usr/bin/env ruby
# frozen_string_literal: true

# Thread stack sizes are read when Ruby boots, so re-exec once with room for deep recursion. The
# re-exec drops command-line flags such as --yjit, so YJIT is turned on through the environment
# instead: it makes the checker about 1.25x faster (experiments/2026-10-09-typer-speed). Set
# RUBY_YJIT_ENABLE=0 to run without it.
unless ENV.key?("RUBY_THREAD_VM_STACK_SIZE")
  require "rbconfig"
  env = { "RUBY_THREAD_VM_STACK_SIZE" => (256 << 20).to_s, "RUBY_THREAD_MACHINE_STACK_SIZE" => (1 << 30).to_s }
  env["RUBY_YJIT_ENABLE"] = "1" if defined?(RubyVM::YJIT) && !ENV.key?("RUBY_YJIT_ENABLE")
  exec(env, RbConfig.ruby, __FILE__, *ARGV)
end

require_relative "../lib/sake/cli"
exit Sake::CLI.main(ARGV)
