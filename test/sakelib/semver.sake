require "semver"

# parse and print
Array.each(Array["1.2.3", "0.0.0", "10.20.30", "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0+build.7",
                 "1.0.0-rc.1+exp.sha.5114f85", " 2.0.0 "]) do |s|
  v = SemVer.parse(s)
  puts "#{s.String.strip} -> #{v} major=#{SemVer.major(v)} minor=#{SemVer.minor(v)} patch=#{SemVer.patch(v)} pre=#{SemVer.pre(v)} build=#{SemVer.build(v)} prerelease?=#{SemVer.prerelease?(v)}"
end
p SemVer.parse("1.2.3")
p SemVer.new(1, 2, 3, String["beta", "2"])

# invalid versions
Array.each(Array["1.2", "1.2.3.4", "01.2.3", "1.2.3-", "1.2.3-01", "v1.2.3", "1.2.3-a..b", "", "a.b.c"]) do |s|
  begin
    SemVer.parse(s)
    puts "#{s.Kernel.inspect}: parsed?"
  rescue SemVerError => e
    puts "#{s.Kernel.inspect}: #{Exception.message(e)}"
  end
end
p Array.map(Array["1.2.3", "1.2", "x"]) { |s| SemVer.valid?(s) }
begin
  SemVer.parse(123)
rescue SemVerError => e
  puts Exception.message(e)
end
begin
  SemVer.new(1, -1, 0)
rescue SemVerError => e
  puts Exception.message(e)
end

# comparing: the precedence example of semver.org
order = Array["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2",
              "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0", "1.0.1", "1.1.0", "2.0.0"]
vs = Array.map(order) { |s| SemVer.parse(s) }
shuffled = Array.map(Array[5, 0, 10, 3, 7, 1, 9, 2, 8, 4, 6]) { |i| Array.fetch(vs, i) }
puts Array.join(Array.sort(shuffled), " < ")
p Array.all?(Array.each_cons(vs, 2)) { |a, b| a < b }
p SemVer.parse("1.0.0+a") == SemVer.parse("1.0.0+b")
p SemVer.parse("1.0.0") <=> SemVer.parse("1.0.0-rc.1")
p SemVer.parse("1.2.3") <=> SemVer.parse("1.10.0")
p Array.max(vs)
p Array.min(vs)

# bump
v = SemVer.parse("1.2.3")
Array.each(Array[:major, :minor, :patch, :pre]) { |part| puts "#{v} bump #{part} -> #{SemVer.bump(v, part)}" }
Array.each(Array["1.2.3-alpha", "1.2.3-alpha.1", "1.2.3-rc.9", "2.0.0+b"]) do |s|
  w = SemVer.parse(s)
  puts "#{w}: patch -> #{SemVer.bump(w, :patch)}, pre -> #{SemVer.bump(w, :pre)}"
end
begin
  SemVer.bump(v, :micro)
rescue SemVerError => e
  puts Exception.message(e)
end

# requirements
reqs = Array["~> 1.2", "~> 1.2.3", "~> 1", ">= 1.0, < 2", "^1.2.3", "^0.2.3", "^0.0.3", "= 1.2.3",
             "!= 1.2.3", "> 1.2.3", "<= 1.2.3", "1.2.3", ">= 1.0.0-beta, < 1.0.0"]
cands = Array.map(Array["0.0.3", "0.0.4", "0.2.5", "0.3.0", "1.0.0-beta.2", "1.0.0", "1.2.0", "1.2.3",
                        "1.2.9", "1.3.0", "1.9.9", "2.0.0-alpha", "2.0.0"]) { |s| SemVer.parse(s) }
Array.each(reqs) do |rs|
  r = SemVerRequirement.parse(rs)
  ok = Array.select(cands) { |c| SemVerRequirement.satisfied_by?(r, c) }
  puts "#{rs} (#{r}): #{Array.join(ok, " ")}"
end
p SemVer.satisfies?(SemVer.parse("1.4.0"), "~> 1.2")
p SemVer.max_satisfying(cands, ">= 1.0, < 1.3")
p SemVer.max_satisfying(cands, "> 5")
Array.each(Array["", "~>", ">= x", "1.2.3.4", ">= 1.0,", "=> 1.0"]) do |s|
  begin
    SemVerRequirement.parse(s)
    puts "#{s.Kernel.inspect}: parsed?"
  rescue SemVerError => e
    puts "#{s.Kernel.inspect}: #{Exception.message(e)}"
  end
end
