def stops = Array["Mill", "Park", "Quay", "Rise", "Stn", "Uni", "Vale", "Wharf"]

def legs
  Array[
    ["Mill", "Park", 4.5], ["Park", "Stn", 3.0], ["Stn", "Quay", 6.5],
    ["Quay", "Rise", 2.0], ["Rise", "Uni", 5.5], ["Uni", "Stn", 4.0],
    ["Mill", "Uni", 12.0], ["Park", "Quay", 11.0], ["Vale", "Mill", 7.0]
  ]
end

def build_matrix(names, edges)
  n = Array.size(names)
  index = Hash[]
  Array.each_with_index(names) { |s, i| index[s] = i }
  dist = Range.map(0...n) { |i| Range.map(0...n) { |j| i == j ? 0.0 : nil } }
  nxt = Range.map(0...n) { |i| Range.map(0...n) { |j| i == j ? j : nil } }
  Array.each(edges) do |a, b, w|
    i = index[a]
    j = index[b]
    # lines run both ways
    dist[i][j] = w
    dist[j][i] = w
    nxt[i][j] = j
    nxt[j][i] = i
  end
  [dist, nxt]
end

def floyd!(dist, nxt)
  n = Array.size(dist)
  Integer.times(n) do |k|
    Integer.times(n) do |i|
      ik = dist[i][k]
      next if ik == nil
      Integer.times(n) do |j|
        kj = dist[k][j]
        next if kj == nil
        cur = dist[i][j]
        if cur == nil || ik + kj < cur
          dist[i][j] = ik + kj
          nxt[i][j] = nxt[i][k]
        end
      end
    end
  end
end

def path(nxt, names, i, j)
  return nil if nxt[i][j] == nil
  out = Array[names[i]]
  while i != j
    i = nxt[i][j]
    Array.push(out, names[i])
  end
  out
end

def cell(d) = d == nil ? "   -" : format("%4.1f", d)

names = stops
dist, nxt = build_matrix(names, legs)
floyd!(dist, nxt)

puts("      " + Array.join(Array.map(names) { |s| String.rjust(s, 5) }, ""))
Array.each_with_index(names) do |s, i|
  puts(String.ljust(s, 5) + " " + Array.join(Array.map(dist[i]) { |d| " " + cell(d) }, ""))
end

# eccentricity over the stops each stop can reach; isolated stops are left out
eccentricity = Array.map(Range.to_a(0...Array.size(names))) { |i| Array.max(Array.compact(dist[i])) }
isolated = Array.select(Range.to_a(0...Array.size(names))) { |i| Array.size(Array.compact(dist[i])) == 1 }
candidates = Array.reject(Range.to_a(0...Array.size(names))) { |i| Array.include?(isolated, i) }
center = Array.min_by(candidates) { |i| eccentricity[i] }
if center
  puts("best hub: #{names[center]} (worst trip #{eccentricity[center]} min)")
  puts("diameter: #{Array.max(eccentricity)} min")
end
puts("isolated: #{Array.join(Array.map(isolated) { |i| names[i] }, ", ")}")

Array.each(Array[["Vale", "Rise"], ["Mill", "Quay"], ["Uni", "Park"], ["Wharf", "Mill"]]) do |from, to|
  i = Array.index(names, from)
  j = Array.index(names, to)
  route = path(nxt, names, i, j)
  if route
    puts("#{from} to #{to}: #{dist[i][j]} min via #{Array.join(route, ", ")}")
  else
    puts("#{from} to #{to}: no route")
  end
end

total = 0.0
pairs = 0
Integer.times(Array.size(names)) do |i|
  Integer.upto(i + 1, Array.size(names) - 1) do |j|
    d = dist[i][j]
    next unless d
    total += d
    pairs += 1
  end
end
puts(format("average trip over %d pairs: %.2f min", pairs, total / pairs))
