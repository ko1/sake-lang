# Port of actionpack-8.1.3/lib/action_dispatch/journey/routes.rb (partial: no visualizer)

require "route"
require "gtg/simulator"
require "../routing/route_set"           # Routes.add_route calls Mapper::Mapping.make_route

module ActionDispatch
  module Journey
    class Routes
      attr_reader routes, custom_routes, anchored_routes
      private attr_accessor _simulator
      include Enum

      def make(routes = nil) = Routes.new(routes || Route[], Route[], Route[], nil)

      def simulator(rs)
        sim = @_simulator
        return sim if sim
        sim = GTG::Simulator.new(GTG::Builder.transition_table(GTG::Builder.make(@anchored_routes)))
        @_simulator = sim
        sim
      end

      def each(rs) = Array.each(@routes) { |r| yield(r) }
      def empty?(rs) = Array.empty?(@routes)
      def length(rs) = Array.length(@routes)
      def size(rs) = length(rs)
      def last(rs) = Array.last(@routes)

      def clear(rs)
        Array.clear(@routes)
        Array.clear(@anchored_routes)
        Array.clear(@custom_routes)
        @_simulator = nil
        nil
      end

      def partition_route(rs, route)
        pt = Route.path(route)
        if Path::Pattern.anchored(pt) && Path::Pattern.requirements_anchored?(pt)
          Array.push(@anchored_routes, route)
        else
          Array.push(@custom_routes, route)
        end
      end

      def add_route(rs, name, mapping)
        route = Routing::Mapper::Mapping.make_route(mapping, name, Array.length(@routes))
        Array.push(@routes, route)
        partition_route(rs, route)
        @_simulator = nil                      # clear_cache!
        route
      end
    end
  end
end
