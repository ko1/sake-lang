# Day-of-week computations: Sakamoto's method, Zeller's congruence, and a
# cross-check between them, then a scan for Friday-the-13ths.

def day_names = Array["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]

def leap?(y) = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0

def sakamoto(y, m, d)
  t = Array[0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
  y -= 1 if m < 3
  (y + y / 4 - y / 100 + y / 400 + t[m - 1] + d) % 7
end

# Zeller gives 0 = Saturday; convert to 0 = Sunday.
def zeller(y, m, d)
  if m < 3
    m += 12
    y -= 1
  end
  k = y % 100
  j = y / 100
  h = (d + (13 * (m + 1)) / 5 + k + k / 4 + j / 4 + 5 * j) % 7
  (h + 6) % 7
end

def parse_date(s)
  parts = Array.map(String.split(s, "-")) { |x| String.to_i(x) }
  [parts[0], parts[1], parts[2]]
end

events = Array[
  ["1969-07-20", "Moon landing"],
  ["1989-11-09", "Berlin Wall opens"],
  ["2000-01-01", "Y2K"],
  ["2000-02-29", "Leap day 2000"],
  ["1900-03-01", "After non-leap 1900"],
  ["2026-10-01", "Today in the experiment"],
  ["1752-09-14", "Gregorian adoption in Britain"]
]

puts("Historic dates:")
mismatches = 0
Array.each(events) do |date, label|
  y, m, d = parse_date(date)
  a = sakamoto(y, m, d)
  b = zeller(y, m, d)
  mismatches += 1 if a != b
  name = day_names[a]
  puts(format("  %s  %-9s %s", date, name, label))
end
puts("Methods disagree on #{mismatches} dates")

# Exhaustive cross-check over a few years.
checked = 0
bad = Array[]
Range.each(1999..2004) do |y|
  Range.each(1..12) do |m|
    dim = Array[31, leap?(y) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1]
    Range.each(1..dim) do |d|
      checked += 1
      Array.push(bad, [y, m, d]) if sakamoto(y, m, d) != zeller(y, m, d)
    end
  end
end
puts("Cross-checked #{checked} days, #{Array.size(bad)} differences")

# Friday the 13th per year.
puts("Friday the 13th:")
per_year = Hash[]
Range.each(2024..2030) do |y|
  months = Range.select(1..12) { |m| sakamoto(y, m, 13) == 5 }
  per_year[y] = months
  names = Array.map(months) { |m| Array["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][m - 1] }
  puts(format("  %d: %d (%s)", y, Array.size(months), Array.join(names, ", ")))
end
best = Hash.max_by(per_year) { |y, ms| Array.size(ms) }
if best
  year, months = best
  puts("Most in #{year}: #{Array.size(months)}")
end

# Distribution of the weekday of January 1st over a 400-year cycle.
counts = Hash.new(0)
Range.each(2001..2400) { |y| counts[sakamoto(y, 1, 1)] += 1 }
puts("January 1st over 400 years:")
Range.each(0..6) { |w| puts(format("  %-9s %3d", day_names[w], counts[w])) }
