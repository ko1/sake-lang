# Mustermann: sinatra-type patterns and Regexp patterns (mustermann 3.1.1); mustermann.rb is the same program.
require "mustermann"

def show(pattern, path)
  m = Mustermann.new(pattern)
  puts("#{Kernel.inspect(pattern)} #{Kernel.inspect(path)} => #{Kernel.inspect(Mustermann::Pattern.params(m, path))} #{Kernel.inspect(Mustermann::Pattern.===(m, path))}")
end

show("/hello/:name", "/hello/world")
show("/hello/:name", "/hello/a%20b")
show("/hello/:name", "/hello/a/b")
show("/say/*/to/*", "/say/hello/to/the/world")
show("/posts/:id(.:format)?", "/posts/1.json")
show("/posts/:id(.:format)?", "/posts/1")
show("/posts/:id(.:format)?", "/posts/v1.2.xml")
show("/:name.:ext", "/a.b.c")
show("/foo/?", "/foo")
show("/foo/?", "/foo/")
show("/a/:b?", "/a/")
show("/files/*.*", "/files/dir/x.tar.gz")
show("/x/{id}", "/x/9")
show("/p/:id/edit", "/p/3/edit")
show("/*path/raw", "/a/b/raw")
show("/(en|de)/:page", "/de/home")
show("/a\\(b\\)", "/a(b)")
show(%r{/num/(?<n>\d+)}, "/num/12")
show(%r{/num/(\d+)}, "/num/x")

m = Mustermann.new("/hello/:name")
p(Mustermann::Pattern.names(m))
md = Mustermann::Pattern.match(m, "/hello/x")
p(md ? md[0] : nil)
p(Mustermann::Pattern.peek_size(m, "/hello/x/more"))
p(Mustermann::Pattern.names(Mustermann.new("/say/*/to/:name")))

Array.each(Array["/a(b", "/a)b"]) do |bad|
  begin
    Mustermann.new(bad)
  rescue Mustermann::Error => e
    puts(Kernel.inspect(e))
  end
end
