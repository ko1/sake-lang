class Mapper
  attr_accessor routes

  def resources(m, kind)
    return resources(m, 0) { yield } if kind == 1
    return resources(m, 0) { yield } if kind == 2
    return resources(m, 0) { yield } if kind == 3
    return resources(m, 0) { yield } if kind == 4
    return resources(m, 0) { yield } if kind == 5
    return resources(m, 0) { yield } if kind == 6
    return resources(m, 0) { yield } if kind == 7
    return resources(m, 0) { yield } if kind == 8
    return resources(m, 0) { yield } if kind == 9
    return resources(m, 0) { yield } if kind == 10
    return resources(m, 0) { yield } if kind == 11
    return resources(m, 0) { yield } if kind == 12
    return resources(m, 0) { yield } if kind == 13
    return resources(m, 0) { yield } if kind == 14
    return resources(m, 0) { yield } if kind == 15
    return resources(m, 0) { yield } if kind == 16
    return resources(m, 0) { yield } if kind == 17
    return resources(m, 0) { yield } if kind == 18
    return resources(m, 0) { yield } if kind == 19
    return resources(m, 0) { yield } if kind == 20
    return resources(m, 0) { yield } if kind == 21
    return resources(m, 0) { yield } if kind == 22
    return resources(m, 0) { yield } if kind == 23
    return resources(m, 0) { yield } if kind == 24
    return resources(m, 0) { yield } if kind == 25
    return resources(m, 0) { yield } if kind == 26
    return resources(m, 0) { yield } if kind == 27
    return resources(m, 0) { yield } if kind == 28
    return resources(m, 0) { yield } if kind == 29
    return resources(m, 0) { yield } if kind == 30
    return resources(m, 0) { yield } if kind == 31
    return resources(m, 0) { yield } if kind == 32
    return resources(m, 0) { yield } if kind == 33
    return resources(m, 0) { yield } if kind == 34
    return resources(m, 0) { yield } if kind == 35
    return resources(m, 0) { yield } if kind == 36
    return resources(m, 0) { yield } if kind == 37
    return resources(m, 0) { yield } if kind == 38
    return resources(m, 0) { yield } if kind == 39
    return resources(m, 0) { yield } if kind == 40
    return resources(m, 0) { yield } if kind == 41
    return resources(m, 0) { yield } if kind == 42
    return resources(m, 0) { yield } if kind == 43
    return resources(m, 0) { yield } if kind == 44
    return resources(m, 0) { yield } if kind == 45
    return resources(m, 0) { yield } if kind == 46
    return resources(m, 0) { yield } if kind == 47
    return resources(m, 0) { yield } if kind == 48
    return resources(m, 0) { yield } if kind == 49
    return resources(m, 0) { yield } if kind == 50
    return resources(m, 0) { yield } if kind == 51
    return resources(m, 0) { yield } if kind == 52
    return resources(m, 0) { yield } if kind == 53
    return resources(m, 0) { yield } if kind == 54
    return resources(m, 0) { yield } if kind == 55
    return resources(m, 0) { yield } if kind == 56
    return resources(m, 0) { yield } if kind == 57
    return resources(m, 0) { yield } if kind == 58
    return resources(m, 0) { yield } if kind == 59
    return resources(m, 0) { yield } if kind == 60
    return resources(m, 0) { yield } if kind == 61
    return resources(m, 0) { yield } if kind == 62
    return resources(m, 0) { yield } if kind == 63
    return resources(m, 0) { yield } if kind == 64

    yield
    Array.push(@routes, kind)
    nil
  end
end
m = Mapper.new(Integer[])
Mapper.resources(m, 1) { Mapper.resources(m, 0) { Array.push(Mapper.routes(m), -1) } }
p(Mapper.routes(m))
