# A generator (stage 0 of `generate`): reads a table of record types and prints a class per line, with
# the fields and a describe function. ARGV[0]: the table, relative to the directory sake runs in.
path = Array.first(ARGV) || "lib/gen/records.txt"
Array.each_with_index(String.lines(File.read(path))) do |line, i|
  next if String.strip(line) == ""
  name, fields = String.split(String.strip(line), ":")
  names = Array.map(String.split(fields || "", ",")) { |f| String.strip(f) }
  puts "# sake-origin: #{path}:#{i + 1}"
  puts "class #{name}"
  puts "  attr_reader #{Array.join(names, ", ")}"
  shown = Array.join(Array.map(names) { |f| "#{f}=\#{@#{f}}" }, ", ")
  puts "  def describe(r) = \"#{name}(#{shown})\""
  puts "end"
end
