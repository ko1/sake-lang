def header_ok(f)
  n = Array.size(f)
  return false if n < 2 || n > 5
  return false unless String.match?(f[0], /\A\d+\z/)
  start = String.to_i(f[0])
  return false if start < 2 || start > 1001
  names = Array.drop(f, 1)
  Array.each(names) { |nm| return false unless String.match?(nm, /\A[a-z]{1,10}\z/) }
  Array.size(Array.uniq(names)) == Array.size(names)
end

# nil for an invalid dart, else [points, is_double]
def dart_value(tok)
  return [0, false] if tok == "MISS"
  return [50, true] if tok == "BULL"
  return [25, false] if tok == "25"
  m = String.match(tok, /\A([SDT])([1-9]\d?)\z/)
  return nil unless m
  num = String.to_i(m[2])
  return nil if num > 20
  kind = m[1]
  return [num, false] if kind == "S"
  return [num * 2, true] if kind == "D"
  [num * 3, false]
end

all = IO.readlines(IO.stdin)
hf = Array.empty?(all) ? Array[] : String.split(all[0], " ")
if !header_ok(hf)
  puts("invalid header")
  exit
end
start = String.to_i(hf[0])
names = Array.drop(hf, 1)
left = Hash[]
turns = Hash[]
darts = Hash[]
Array.each(names) do |nm|
  left[nm] = start
  turns[nm] = 0
  darts[nm] = 0
end
winner = nil

Array.each_with_index(all) do |raw, idx|
  next if idx == 0
  n = idx + 1
  f = String.split(raw, " ")
  next if Array.empty?(f)
  name = f[0]
  ds = Array.drop(f, 1)
  if winner != nil
    puts("line #{n}: game over")
  elsif !Hash.key?(left, name)
    puts("line #{n}: unknown player #{name}")
  elsif Array.size(ds) < 1 || Array.size(ds) > 3
    puts("line #{n}: expected 1 to 3 darts")
  else
    bad = Array.find(ds) { |t| dart_value(t) == nil }
    if bad != nil
      puts("line #{n}: bad dart #{bad}")
    else
      begin_left = left[name]
      cur = begin_left
      total = 0
      state = 0
      lastdart = ""
      Array.each(ds) do |t|
        pts, dbl = dart_value(t)
        darts[name] += 1
        nxt = cur - pts
        if nxt < 0 || nxt == 1 || (nxt == 0 && !dbl)
          cur = begin_left
          state = 1
          break
        elsif nxt == 0
          cur = 0
          state = 2
          lastdart = t
          break
        else
          cur = nxt
          total += pts
        end
      end
      left[name] = cur
      turns[name] += 1
      if state == 1
        puts("#{name} busts, #{cur} left")
      elsif state == 2
        winner = name
        puts("#{name} checks out with #{lastdart}")
      else
        puts("#{name} scores #{total}, #{cur} left")
      end
    end
  end
end

puts("STANDINGS")
order = Array.sort_by(Array.each_with_index(names)) { |nm, i| [left[nm], i] }
Array.each_with_index(order) do |pr, r|
  nm = pr[0]
  th = darts[nm]
  avg = th == 0 ? "-" : format("%.2f", Integer.fdiv((start - left[nm]) * 3, th))
  puts(format("%d. %-10s %4d %3d %6s", r + 1, nm, left[nm], turns[nm], avg))
end
puts(winner == nil ? "no winner" : "winner: #{winner}")
