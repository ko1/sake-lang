# Extended Hamming(8,4) SECDED code: encode a message nibble by nibble, push it through a
# noisy channel with scripted bit flips, then correct single errors and detect double errors.

class Decoded
  attr_reader nibble, status, flipped
end

def bit(v, i) = (v >> i) & 1

# Codeword bit layout (index 1..7 Hamming positions, index 0 overall parity):
# pos: 1=p1 2=p2 3=d0 4=p4 5=d1 6=d2 7=d3
def encode_nibble(n)
  d0 = bit(n, 0)
  d1 = bit(n, 1)
  d2 = bit(n, 2)
  d3 = bit(n, 3)
  p1 = d0 ^ d1 ^ d3
  p2 = d0 ^ d2 ^ d3
  p4 = d1 ^ d2 ^ d3
  word = (p1 << 1) | (p2 << 2) | (d0 << 3) | (p4 << 4) | (d1 << 5) | (d2 << 6) | (d3 << 7)
  overall = 0
  Range.each(1..7) { |i| overall ^= bit(word, i) }
  word | overall
end

def extract(word) = bit(word, 3) | (bit(word, 5) << 1) | (bit(word, 6) << 2) | (bit(word, 7) << 3)

def decode_word(word)
  syndrome = 0
  Range.each(1..7) { |i| syndrome ^= i if bit(word, i) == 1 }
  parity = 0
  Range.each(0..7) { |i| parity ^= bit(word, i) }
  if syndrome == 0 && parity == 0
    Decoded.new(extract(word), :ok, nil)
  elsif parity == 1
    fixed = word ^ (1 << syndrome)
    Decoded.new(extract(fixed), :corrected, syndrome)
  else
    Decoded.new(nil, :double, nil)
  end
end

def to_nibbles(text)
  out = Integer[]
  Array.each(String.bytes(text)) do |b|
    Array.push(out, b >> 4)
    Array.push(out, b & 15)
  end
  out
end

def from_nibbles(nibbles)
  s = ""
  Array.each_slice(nibbles, 2) do |hi, lo|
    s += hi == nil || lo == nil ? "?" : Integer.chr((hi << 4) | lo)
  end
  s
end

message = "SECDED!"
nibbles = to_nibbles(message)
words = Array.map(nibbles) { |n| encode_nibble(n) }
puts("message: #{message}")
puts("codewords: #{Array.join(Array.map(words) { |w| format("%02x", w) }, " ")}")

# scripted noise: word index -> bits to flip
noise = Hash[1 => Integer[4], 3 => Integer[0], 6 => Integer[2, 5], 9 => Integer[7], 12 => Integer[1, 6]]

received = Array.dup(words)
Array.each_with_index(words) do |w, i|
  flips = noise[i]
  if flips
    Array.each(flips) { |b| w ^= 1 << b }
  end
  received[i] = w
end

counts = Hash.new(0)
out_nibbles = Array[]
Array.each_with_index(received) do |w, i|
  r = decode_word(w)
  status = Decoded.get_status(r)
  counts[status] += 1
  case status
  in :ok
    Array.push(out_nibbles, Decoded.get_nibble(r))
  in :corrected
    puts(format("word %2d: %08b -> fixed bit %d", i, w, Decoded.get_flipped(r)))
    Array.push(out_nibbles, Decoded.get_nibble(r))
  in :double
    puts(format("word %2d: %08b -> double error, nibble lost", i, w))
    Array.push(out_nibbles, nil)
  end
end

puts("decoded: #{from_nibbles(out_nibbles)}")
puts("ok=#{counts[:ok]} corrected=#{counts[:corrected]} double=#{counts[:double]}")

all_ok = Range.all?(0..15) do |n|
  w = encode_nibble(n)
  Range.all?(0..7) { |b| Decoded.get_nibble(decode_word(w ^ (1 << b))) == n }
end
puts("every single-bit error corrected for all 16 nibbles: #{all_ok}")
