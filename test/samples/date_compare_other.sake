# Date#<=> as Ruby's: a number is compared with the astronomical day number, anything else gives nil, so a
# Date can share an Array with values of other types.
require "date"
class P
  attr_reader n
end
d = Date.new(2026, 1, 2)
p(d <=> 1, d <=> "x", d <=> Date.new(2026, 1, 1), d == 1, d <=> Rational(4922 * 1000, 2))
xs = Any[P.new(1), d]
p(Array.size(xs))
