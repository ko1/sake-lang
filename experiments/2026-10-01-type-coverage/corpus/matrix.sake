Matrix = Data.define(:a, :b, :c, :d)

class Matrix
  def identity = Matrix.new(1, 0, 0, 1)

  def multiply(m, n)
    Matrix.new(
      get_a(m) * get_a(n) + get_b(m) * get_c(n),
      get_a(m) * get_b(n) + get_b(m) * get_d(n),
      get_c(m) * get_a(n) + get_d(m) * get_c(n),
      get_c(m) * get_b(n) + get_d(m) * get_d(n)
    )
  end

  def power(m, k)
    result = identity
    Integer.times(k) { result = multiply(result, m) }
    result
  end

  def to_s(m)
    "[[" + Integer.to_s(get_a(m)) + ", " + Integer.to_s(get_b(m)) + "], [" +
      Integer.to_s(get_c(m)) + ", " + Integer.to_s(get_d(m)) + "]]"
  end
end

fib = Matrix.new(1, 1, 1, 0)
puts(String.+("identity: ", Matrix.to_s(Matrix.identity)))
puts(String.+("square: ", Matrix.to_s(Matrix.multiply(fib, fib))))
puts(String.+("cube: ", Matrix.to_s(Matrix.power(fib, 3))))
