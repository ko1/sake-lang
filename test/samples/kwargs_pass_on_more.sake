# sake: --strict
# `**opts` passed on: opts is copied where `**opts` stands, as Ruby's, so a later keyword's value that
# changes opts is not seen; a keyword written after `**opts` wins, also for the checker; and a function
# with no keyword parameters takes `**opts` while it is empty (Ruby's unknown keyword error otherwise).
def g(x: 0, **rest) = p([x, rest])
def f(**opts)
  g(**opts, x: (Hash.store(opts, :b, 2); 3))
end
f(a: 1)

def h(x:) = String.upcase(x)
def pass(**opts) = h(**opts)
def ok(**opts) = pass(**opts, x: "ok")
p ok(x: false)

def plain = 1
def wrap(**opts) = plain(**opts)
p wrap
