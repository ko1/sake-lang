# Port of actionpack-8.1.3/lib/action_controller/metal/default_headers.rb
#
# ClassMethods#make_response!: a Response with ActionDispatch::Response.default_headers. Called by the generated
# dispatch (Ruby's class method; here a module function, since a class method and an instance method share a name space).

require "rails/actionpack/action_dispatch/http/response"

module ActionController
  module DefaultHeaders
    module_function

    def make_response!(request)
      res = ActionDispatch::Response.create
      ActionDispatch::Response.set_request(res, request)
      res
    end
  end
end
