# strscan: tokenize "ab 12 " x 16000 (96 KB) with scan/skip at the pointer.
require "strscan"
s = String.*("ab 12 ", 16000)
ss = StringScanner.new(s)
words = 0
nums = 0
until StringScanner.eos?(ss)
  if StringScanner.scan(ss, /\d+/)
    nums += 1
  elsif StringScanner.scan(ss, /[a-z]+/)
    words += 1
  else
    StringScanner.skip(ss, /\s+/)
  end
end
p([words, nums, StringScanner.pos(ss)])
