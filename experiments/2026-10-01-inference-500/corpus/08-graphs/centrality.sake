def undirected(edges)
  adj = Hash[]
  Array.each(edges) do |a, b|
    adj[a] ||= Array[]
    adj[b] ||= Array[]
    Array.push(adj[a], b)
    Array.push(adj[b], a)
  end
  Hash.transform_values(adj) { |ns| Array.sort(ns) }
end

def bfs_distances(adj, s)
  dist = Hash[s => 0]
  queue = Array[s]
  until Array.empty?(queue)
    v = Array.shift(queue)
    Array.each(adj[v]) do |w|
      next if Hash.key?(dist, w)
      dist[w] = dist[v] + 1
      Array.push(queue, w)
    end
  end
  dist
end

def closeness(adj, v)
  d = bfs_distances(adj, v)
  reach = Hash.size(d) - 1
  return 0.0 if reach == 0
  # Wasserman-Faust correction for disconnected graphs
  total = Array.sum(Hash.values(d))
  (reach / Float(total)) * (reach / Float(Hash.size(adj) - 1))
end

# Brandes' algorithm for betweenness centrality.
def betweenness(adj)
  cb = Hash.new(0.0)
  Hash.each_key(adj) do |s|
    stack = Array[]
    preds = Hash[]
    sigma = Hash.new(0)
    sigma[s] = 1
    dist = Hash[s => 0]
    queue = Array[s]
    until Array.empty?(queue)
      v = Array.shift(queue)
      Array.push(stack, v)
      Array.each(adj[v]) do |w|
        unless Hash.key?(dist, w)
          dist[w] = dist[v] + 1
          Array.push(queue, w)
        end
        if dist[w] == dist[v] + 1
          sigma[w] += sigma[v]
          preds[w] ||= Array[]
          Array.push(preds[w], v)
        end
      end
    end
    delta = Hash.new(0.0)
    until Array.empty?(stack)
      w = Array.pop(stack)
      Array.each(Hash.fetch(preds, w, Array[])) do |v|
        delta[v] += sigma[v] / Float(sigma[w]) * (1.0 + delta[w])
      end
      cb[w] += delta[w] if w != s
    end
  end
  # each undirected path was counted from both ends
  Hash.transform_values(cb) { |x| x / 2.0 }
end

def clustering(adj, v)
  ns = adj[v]
  k = Array.size(ns)
  return 0.0 if k < 2
  links = Array.count(Array.combination(ns, 2)) { |pair| Array.include?(adj[pair[0]], pair[1]) }
  2.0 * links / (k * (k - 1))
end

edges = Array[
  ["ann", "bea"], ["ann", "cal"], ["bea", "cal"], ["cal", "dov"], ["dov", "eli"],
  ["eli", "fin"], ["eli", "gil"], ["fin", "gil"], ["gil", "hus"], ["hus", "ida"],
  ["ida", "jon"], ["jon", "hus"], ["dov", "kai"], ["lux", "mia"]
]
adj = undirected(edges)
bc = betweenness(adj)
names = Array.sort(Hash.keys(adj))
puts(format("%-5s %3s %6s %7s %6s", "who", "deg", "close", "between", "clust"))
Array.each(names) do |n|
  puts(format("%-5s %3d %6.3f %7.2f %6.2f", n, Array.size(adj[n]), closeness(adj, n),
              Hash.fetch(bc, n, 0.0), clustering(adj, n)))
end
broker = Array.max_by(names) { |n| Hash.fetch(bc, n, 0.0) }
central = Array.max_by(names) { |n| closeness(adj, n) }
puts("top broker: #{broker}, most central: #{central}")
avg_clust = Array.sum(Array.map(names) { |n| clustering(adj, n) }) / Array.size(names)
puts(format("average clustering: %.3f", avg_clust))
far = Array.max(Array.map(names) { |n| Array.max(Hash.values(bfs_distances(adj, n))) })
puts("diameter (within components): #{far}")
