class InvalidAmount < StandardError
  attr_reader amount
end

def check_inputs(coins, amount)
  raise InvalidAmount.new("negative amount", amount) if amount < 0
  raise ArgumentError, "no coins given" if Array.empty?(coins)
  Array.each(coins) do |c|
    raise ArgumentError, "bad coin #{c}" if c <= 0
  end
end

# fewest coins; nil when the amount cannot be made
def min_coins(coins, amount)
  check_inputs(coins, amount)
  best = Array[0]
  last = Array[nil]
  Integer.upto(1, amount) do |a|
    Array.push(best, nil)
    Array.push(last, nil)
    Array.each(coins) do |c|
      next if c > a
      prev = best[a - c]
      next if prev == nil
      cur = best[a]
      if cur == nil || prev + 1 < cur
        best[a] = prev + 1
        last[a] = c
      end
    end
  end
  count = best[amount]
  return nil if count == nil
  used = Array[]
  a = amount
  while a > 0
    c = last[a]
    Array.push(used, c)
    a -= c
  end
  [count, Array.sort(used)]
end

def count_ways(coins, amount)
  check_inputs(coins, amount)
  ways = Array.new(amount + 1, 0)
  ways[0] = 1
  Array.each(coins) do |c|
    Integer.upto(c, amount) { |a| ways[a] += ways[a - c] }
  end
  ways[amount]
end

def describe(coins, amount)
  result = min_coins(coins, amount)
  ways = count_ways(coins, amount)
  if result
    count, used = result
    tally = Array.tally(used)
    parts = Hash.map(tally) { |c, k| "#{k}x#{c}" }
    puts(format("%-14s %4d: %2d coins [%s], %d ways", Array.join(coins, "/"), amount, count, Array.join(parts, " "), ways))
  else
    puts(format("%-14s %4d: impossible, %d ways", Array.join(coins, "/"), amount, ways))
  end
end

systems = Array[
  Array[1, 5, 10, 25],
  Array[1, 3, 4],
  Array[2, 5],
  Array[7, 11, 13],
  Array[1, 2, 5, 10, 20, 50]
]
amounts = Array[6, 23, 63, 3, 100]

Array.each(systems) do |coins|
  Array.each(amounts) { |amount| describe(coins, amount) }
end

# greedy is not always optimal; find where it fails
def greedy(coins, amount)
  n = 0
  Array.each(Array.reverse(Array.sort(coins))) do |c|
    n += amount / c
    amount %= c
  end
  amount == 0 ? n : nil
end

Array.each(Array[Array[1, 3, 4], Array[1, 5, 10, 25], Array[1, 6, 10]]) do |coins|
  bad = Range.find(1..60) do |a|
    g = greedy(coins, a)
    r = min_coins(coins, a)
    g && r && g > r[0]
  end
  if bad
    puts("#{Array.join(coins, ",")}: greedy fails first at #{bad}")
  else
    puts("#{Array.join(coins, ",")}: greedy optimal up to 60")
  end
end

Array.each(Array[[Array[1, 2], -5], [Array[], 4], [Array[3, 0], 4]]) do |coins, amount|
  begin
    describe(coins, amount)
  rescue InvalidAmount => e
    puts("invalid amount #{InvalidAmount.amount(e)}: #{Exception.message(e)}")
  rescue ArgumentError => e
    puts("argument error: #{Exception.message(e)}")
  end
end
