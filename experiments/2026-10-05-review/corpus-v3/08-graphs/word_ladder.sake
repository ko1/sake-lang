def dictionary
  String.split("cold cord card ward warm word worm wore core care dare date gate game " \
               "came come cole hole hold bold bolt boat coat cost most mist list lost " \
               "lust last cast case cave gave give live life wife wire fire fine mine " \
               "mind wind kind king ring rink sink sing song long lung hung", " ")
end

def pattern(word, i) = "#{word[0...i]}_#{word[i + 1..]}"

def buckets(words)
  index = Hash[]
  Array.each(words) do |w|
    Integer.times(String.size(w)) do |i|
      key = pattern(w, i)
      index[key] ||= Array[]
      Array.push(index[key], w)
    end
  end
  index
end

def ladder(index, from, to)
  return Array[from] if from == to
  prev = Hash[from => nil]
  queue = Array[from]
  until Array.empty?(queue)
    word = Array.shift(queue)
    Integer.times(String.size(word)) do |i|
      key = pattern(word, i)
      Array.each(Hash.fetch(index, key, Array[])) do |nb|
        next if Hash.key?(prev, nb)
        prev[nb] = word
        if nb == to
          path = Array[nb]
          cur = word
          while cur
            Array.unshift(path, cur)
            cur = prev[cur]
          end
          return path
        end
        Array.push(queue, nb)
      end
    end
  end
  nil
end

def reachable_count(index, from)
  seen = Set[from]
  frontier = Array[from]
  depth = 0
  until Array.empty?(frontier)
    nxt = Array[]
    Array.each(frontier) do |word|
      Integer.times(String.size(word)) do |i|
        key = pattern(word, i)
        Array.each(Hash.fetch(index, key, Array[])) do |nb|
          Array.push(nxt, nb) if Set.add?(seen, nb)
        end
      end
    end
    depth += 1 unless Array.empty?(nxt)
    frontier = nxt
  end
  [Set.size(seen), depth]
end

words = dictionary
index = buckets(words)
busiest = Hash.max_by(index) { |k, ws| Array.size(ws) }
puts("#{Array.size(words)} words, #{Hash.size(index)} patterns; busiest #{busiest[0]} (#{Array.size(busiest[1])})")

Array.each(Array[["cold", "warm"], ["cost", "fire"], ["king", "hung"], ["game", "lost"],
                 ["mind", "boat"], ["cold", "cold"], ["jazz", "cold"]]) do |from, to|
  path = ladder(index, from, to)
  if path
    puts("#{from} -> #{to}: #{Array.size(path) - 1} steps: #{Array.join(path, " > ")}")
  else
    puts("#{from} -> #{to}: impossible")
  end
end

Array.each(Array["cold", "king"]) do |w|
  count, depth = reachable_count(index, w)
  puts("from #{w}: #{count} words reachable, farthest #{depth} steps")
end
