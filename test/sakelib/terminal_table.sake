require "terminal_table"

rows = Array[Array["Alice", 30, "Tokyo"], Array["Bob", 4, "Osaka"], Array["Christopher", 125, "Kyoto"]]
t = TerminalTable.new(headings: Array["Name", "Age", "City"], rows: rows)
puts t
p TerminalTable.number_of_columns(t)

# a title, a separator, right-aligned numbers
t2 = TerminalTable.new(title: "Population", headings: Array["Name", "Age", "City"], rows: rows)
TerminalTable.add_separator(t2)
TerminalTable.add_row(t2, Array["Total", 159, ""])
TerminalTable.align_column(t2, 1, :right)
puts t2
p Array.size(rows)

# unicode borders, centered, short rows and other values
t3 = TerminalTable.new(rows: Array[Array[1, 2.5, nil], Array[:sym, true], Array["日本"]], border: :unicode,
                       alignment: :center)
TerminalTable.<<(t3, Array[Array[1, 2], [3, "x"]])
puts t3

# a title wider than the columns
puts TerminalTable.new(title: "A rather long title", rows: Array[Array["a", "b"]])

# markdown
md = TerminalTable.new(headings: Array["Lib", "Lines", "Status"], border: :markdown)
TerminalTable.add_row(md, Array["semver", 163, "ok"])
TerminalTable.add_row(md, Array["text", 120, "ok"])
TerminalTable.add_separator(md)
TerminalTable.align_column(md, 1, :right)
TerminalTable.align_column(md, 2, :center)
puts md

# no headings; empty
puts TerminalTable.new(rows: Array[Array["x"]])
p TerminalTable.to_s(TerminalTable.new)
puts TerminalTable.new(headings: Array["only", "headings"])

# errors
begin
  TerminalTable.new(border: :fancy)
rescue ArgumentError => e
  puts Exception.message(e)
end
begin
  TerminalTable.align_column(t, 0, :justify)
rescue ArgumentError => e
  puts Exception.message(e)
end
begin
  TerminalTable.new(title: "T", border: :markdown)
rescue ArgumentError => e
  puts Exception.message(e)
end
