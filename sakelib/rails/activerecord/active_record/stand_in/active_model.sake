# Port of activemodel-8.1.3/lib/active_model/{error,errors,naming,validations,validator}.rb and
# validations/{presence,absence,length,numericality,inclusion,exclusion}.rb (partial: what ActiveRecord's model layer
# calls; no i18n lookup of per-model messages (Rails' English defaults), no :message procs, no strict validations)
#
# A stand-in kept under activerecord until part 5 (activemodel) lands its own; the names are Rails'. A validator
# is an object (Rails' `validates_with`): the generator makes them from `validates` lines and runs each as a
# callback of the :validate chain, so they keep their order among `validate :method` lines.

require "rails/activesupport/active_support/inflector"

module ActiveModel
  class Name
    attr_reader klass, namespace
    attr_accessor name, singular, plural, element, human_, param_key, route_key, singular_route_key, i18n_key, collection
    def initialize(n)
      @name ||= @klass
      @collection = ActiveSupport::Inflector.tableize(@name)
      @element = ActiveSupport::Inflector.underscore(ActiveSupport::Inflector.demodulize(@name))
      @singular = String.tr(ActiveSupport::Inflector.underscore(@name), "/", "_")
      @plural = ActiveSupport::Inflector.pluralize(@singular)
      @human_ = ActiveSupport::Inflector.humanize(@element)
      @param_key = @singular
      @route_key = @plural
      @route_key = "#{@route_key}_index" if @plural == @singular
      @singular_route_key = @singular
      @i18n_key = String.to_sym(ActiveSupport::Inflector.underscore(@name))
    end
    def human(n) = @human_
    def to_s(n) = @name
  end

  class Error
    attr_reader base, attribute, raw_type, options
    def type(e) = @raw_type

    def MESSAGES = Hash.of(
      blank: "can't be blank", present: "must be blank", empty: "can't be empty", invalid: "is invalid",
      inclusion: "is not included in the list", exclusion: "is reserved", accepted: "must be accepted",
      confirmation: "doesn't match %{attribute}", not_a_number: "is not a number", not_an_integer: "must be an integer",
      greater_than: "must be greater than %{count}", greater_than_or_equal_to: "must be greater than or equal to %{count}",
      less_than: "must be less than %{count}", less_than_or_equal_to: "must be less than or equal to %{count}",
      equal_to: "must be equal to %{count}", other_than: "must be other than %{count}", odd: "must be odd", even: "must be even",
      taken: "has already been taken", required: "must exist", restrict_dependent_destroy_has_one: "Cannot delete record because a dependent %{record} exists",
      restrict_dependent_destroy_has_many: "Cannot delete record because dependent %{record} exist")

    def plural_message(type, count)
      one = count == 1
      case type
      in :too_long then one ? "is too long (maximum is 1 character)" : "is too long (maximum is %{count} characters)"
      in :too_short then one ? "is too short (minimum is 1 character)" : "is too short (minimum is %{count} characters)"
      in :wrong_length then one ? "is the wrong length (should be 1 character)" : "is the wrong length (should be %{count} characters)"
      else nil
      end
    end

    def message(e)
      custom = @options[:message]
      return Kernel.to_s(custom) if custom in String
      rt = @raw_type
      return rt if rt in String
      key = (custom in Symbol) ? custom : rt
      count = @options[:count]
      template = plural_message(key, (count in Integer) ? count : 0) || Error.MESSAGES[key] || Symbol.to_s(key)
      String.gsub(template, /%\{(\w+)\}/) do |m|
        k = String.to_sym(String.slice(m, 2...-1) || "")
        k == :attribute ? ActiveSupport::Inflector.humanize(Kernel.to_s(@attribute)) : Kernel.to_s(@options[k])
      end
    end

    def details(e) = Hash.merge(Hash.of(error: @raw_type), Hash.except(@options, :message))

    def full_message(e)
      return message(e) if @attribute == :base
      "#{ActiveSupport::Inflector.humanize(Kernel.to_s(@attribute))} #{message(e)}"
    end

    def match?(e, attribute, type = nil) = @attribute == attribute && (type == nil || @raw_type == type)
    def inspect(e) = "#<ActiveModel::Error attribute=#{@attribute}, type=#{@raw_type}, options=#{Kernel.inspect(@options)}>"
  end

  class Errors
    attr_reader base
    attr_reader errors
    include Enum
    include Indexable
    def initialize(es)
      @errors = Error[] if @errors == nil
    end

    def each(es) = Array.each(@errors) { |e| yield e }
    def add(es, attribute, type = :invalid, **options) = add_with(es, attribute, type, options)
    def add_with(es, attribute, type, options)
      e = Error.new(@base, attribute, type, options)
      Array.push(@errors, e)
      e
    end
    def added?(es, attribute, type = :invalid) = Array.any?(@errors) { |e| Error.match?(e, attribute, type) }
    def include?(es, attribute) = Array.any?(@errors) { |e| Error.match?(e, attribute) }
    def [](es, attribute) = messages_for(es, attribute)
    def messages_for(es, attribute) = Array.select(@errors) { |e| Error.match?(e, attribute) }.Array.map { |e| Error.message(e) }
    def full_messages(es) = Array.map(@errors) { |e| Error.full_message(e) }
    def full_messages_for(es, attribute) = Array.select(@errors) { |e| Error.match?(e, attribute) }.Array.map { |e| Error.full_message(e) }
    def where(es, attribute, type = nil) = Array.select(@errors) { |e| Error.match?(e, attribute, type) }
    def delete(es, attribute) = Array.reject!(@errors) { |e| Error.match?(e, attribute) }
    def clear(es) = Array.clear(@errors)
    def empty?(es) = Array.empty?(@errors)
    def any?(es) = !Array.empty?(@errors)
    def size(es) = Array.size(@errors)
    def count(es) = Array.size(@errors)
    def attribute_names(es) = Array.map(@errors) { |e| Error.attribute(e) }.Array.uniq
    def messages(es)
      h = Hash.new
      Array.each(@errors) do |e|
        h[Error.attribute(e)] = String[] unless Hash.key?(h, Error.attribute(e))
        Array.push(h[Error.attribute(e)] || String[], Error.message(e))
      end
      h
    end
    def details(es)
      h = Hash.new
      Array.each(@errors) do |e|
        h[Error.attribute(e)] = Any[] unless Hash.key?(h, Error.attribute(e))
        Array.push(h[Error.attribute(e)] || Any[], Error.details(e))
      end
      h
    end
    def to_s(es) = Kernel.inspect(messages(es))
  end

  module Validations
    def errors(r) = raise(NotImplementedError)
    def read_attribute_for_validation(r, attribute) = raise(NotImplementedError)
    def validation_context(r) = raise(NotImplementedError)

    def validates_with_validator(r, v) = EachValidator.validate(v, r)

    module_function :blank?
    def blank?(value)
      return true if value in nil
      return String.strip(value) == "" if value in String
      return Array.empty?(value) if value in Array
      return Hash.empty?(value) if value in Hash
      Kernel.equal?(value, false)
    end

    module EachValidator
      def attributes(v) = raise(NotImplementedError)
      def options(v) = raise(NotImplementedError)
      def validate_each(v, record, attribute, value) = raise(NotImplementedError)

      def validate(v, record)
        Array.each(attributes(v)) do |attribute|
          value = ActiveModel::Validations.read_attribute_for_validation(record, attribute)
          next if (value in nil) && (options(v)[:allow_nil] in true)
          next if Validations.blank?(value) && (options(v)[:allow_blank] in true)
          validate_each(v, record, attribute, value)
        end
      end

      def error_options(v, extra = Hash.new) = Hash.merge(Hash.slice(options(v), :message), extra)
      def errors_of(v, record) = ActiveModel::Validations.errors(record)
    end

    class PresenceValidator
      attr_reader attributes, options
      include EachValidator
      def validate_each(v, record, attribute, value)
        ActiveModel::Errors.add_with(errors_of(v, record), attribute, :blank, error_options(v)) if Validations.blank?(value)
      end
    end

    class AbsenceValidator
      attr_reader attributes, options
      include EachValidator
      def validate_each(v, record, attribute, value)
        ActiveModel::Errors.add_with(errors_of(v, record), attribute, :present, error_options(v)) if !Validations.blank?(value)
      end
    end

    class LengthValidator
      attr_reader attributes, options
      include EachValidator
      def validate_each(v, record, attribute, value)
        size = case value
               in String then String.size(value)
               in Array then Array.size(value)
               in nil then 0
               else String.size(Kernel.to_s(value))
               end
        o = options(v)
        is = o[:is]
        min = o[:minimum]
        max = o[:maximum]
        if (is in Integer) && size != is
          ActiveModel::Errors.add_with(errors_of(v, record), attribute, :wrong_length, error_options(v, Hash.of(count: is)))
        end
        if (min in Integer) && size < min
          ActiveModel::Errors.add_with(errors_of(v, record), attribute, :too_short, error_options(v, Hash.of(count: min)))
        end
        if (max in Integer) && size > max
          ActiveModel::Errors.add_with(errors_of(v, record), attribute, :too_long, error_options(v, Hash.of(count: max)))
        end
      end
    end

    class NumericalityValidator
      attr_reader attributes, options
      include EachValidator
      def CHECKS = Symbol[:greater_than, :greater_than_or_equal_to, :equal_to, :less_than, :less_than_or_equal_to, :other_than]
      def validate_each(v, record, attribute, value)
        n = case value
            in Integer | Float then value
            in String then (Float(value) rescue nil)
            else nil
            end
        if (n in nil)
          ActiveModel::Errors.add_with(errors_of(v, record), attribute, :not_a_number, error_options(v))
          return nil
        end
        o = options(v)
        if (o[:only_integer] in true) && !(n in Integer) && !(String.match?(Kernel.to_s(value), /\A[+-]?\d+\z/))
          ActiveModel::Errors.add_with(errors_of(v, record), attribute, :not_an_integer, error_options(v))
          return nil
        end
        Array.each(NumericalityValidator.CHECKS) do |check|
          limit = o[check]
          next unless limit in Integer | Float
          ok = case check
               in :greater_than then n > limit
               in :greater_than_or_equal_to then n >= limit
               in :equal_to then n == limit
               in :less_than then n < limit
               in :less_than_or_equal_to then n <= limit
               else n != limit
               end
          ActiveModel::Errors.add_with(errors_of(v, record), attribute, check, error_options(v, Hash.of(count: limit))) unless ok
        end
      end
    end

    class InclusionValidator
      attr_reader attributes, options
      include EachValidator
      def validate_each(v, record, attribute, value)
        list = options(v)[:in]
        ok = (list in Array) ? Array.any?(list) { |x| ActiveModel::Type.same_value?(value, x) } : false
        ActiveModel::Errors.add_with(errors_of(v, record), attribute, :inclusion, error_options(v)) unless ok
      end
    end

    class ExclusionValidator
      attr_reader attributes, options
      include EachValidator
      def validate_each(v, record, attribute, value)
        list = options(v)[:in]
        bad = (list in Array) ? Array.any?(list) { |x| ActiveModel::Type.same_value?(value, x) } : false
        ActiveModel::Errors.add_with(errors_of(v, record), attribute, :exclusion, error_options(v)) if bad
      end
    end
  end

  class ValidationError < StandardError
  end
end
