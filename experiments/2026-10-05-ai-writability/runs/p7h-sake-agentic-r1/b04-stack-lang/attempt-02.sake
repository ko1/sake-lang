def is_number(s)
  String.match(s, /^-?\d+$/)
end

# Simple stack interpreter
stack = Array[]
dict = Hash[]
line_num = 0

lines = Array[]
while true
  line = gets
  break if line == nil
  Array.push(lines, line)
end

def execute(tokens, stack, dict, line_num)
  # This simplified version handles basic operations
  i = 0
  while i < Array.size(tokens)
    token = Array.at(tokens, i)

    if String.match(token, /^-?\d+$/)
      Array.push(stack, String.to_i(token))
    elsif token == "+"
      if Array.size(stack) < 2
        return "stack underflow in +"
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, Integer.+(a, b))
    elsif token == "-" && i > 0
      if Array.size(stack) < 2
        return "stack underflow in -"
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, Integer.-(a, b))
    elsif token == "*"
      if Array.size(stack) < 2
        return "stack underflow in *"
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, Integer.*(a, b))
    elsif token == "/"
      if Array.size(stack) < 2
        return "stack underflow in /"
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      if b == 0
        return "division by zero"
      end
      Array.push(stack, Integer.div(a, b))
    elsif token == "mod"
      if Array.size(stack) < 2
        return "stack underflow in mod"
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      if b == 0
        return "division by zero"
      end
      Array.push(stack, Integer.%(a, b))
    elsif token == "."
      if Array.size(stack) < 1
        return "stack underflow in ."
      end
      puts(Array.pop(stack))
    elsif token == "dup"
      if Array.size(stack) < 1
        return "stack underflow in dup"
      end
      Array.push(stack, Array.at(stack, Array.size(stack) - 1))
    elsif token == "drop"
      if Array.size(stack) < 1
        return "stack underflow in drop"
      end
      Array.pop(stack)
    elsif token == "swap"
      if Array.size(stack) < 2
        return "stack underflow in swap"
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, b)
      Array.push(stack, a)
    elsif token == "over"
      if Array.size(stack) < 2
        return "stack underflow in over"
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a)
      Array.push(stack, b)
      Array.push(stack, a)
    elsif token == "="
      if Array.size(stack) < 2
        return "stack underflow in ="
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a == b ? 1 : 0)
    elsif token == "<"
      if Array.size(stack) < 2
        return "stack underflow in <"
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a < b ? 1 : 0)
    elsif token == ">"
      if Array.size(stack) < 2
        return "stack underflow in >"
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a > b ? 1 : 0)
    elsif token == ":"
      # Skip definitions for now
      i += 1
      while i < Array.size(tokens) && Array.at(tokens, i) != ";"
        i += 1
      end
    else
      if !String.match(token, /^(if|then|else|;)$/)
        return "unknown word #{token}"
      end
    end

    i += 1
  end

  nil
end

Array.each(lines) { |line|
  line_num += 1
  trimmed = String.strip(line)

  if String.empty?(trimmed)
    next
  end

  tokens = String.split(trimmed, /\s+/)
  err = execute(tokens, stack, dict, line_num)
  if err
    puts("line #{line_num}: error: #{err}")
  end
}

if Array.size(stack) == 0
  puts("stack: (empty)")
else
  parts = Array.map(stack) { |v| Integer.to_s(v) }
  puts("stack: #{Array.join(parts, " ")}")
end
