def forward_diff(x, h) = (yield(x + h) - yield(x)) / h
def backward_diff(x, h) = (yield(x) - yield(x - h)) / h
def central_diff(x, h) = (yield(x + h) - yield(x - h)) / (2.0 * h)
def five_point(x, h) = (yield(x - 2.0 * h) - 8.0 * yield(x - h) + 8.0 * yield(x + h) - yield(x + 2.0 * h)) / (12.0 * h)
def second_diff(x, h) = (yield(x + h) - 2.0 * yield(x) + yield(x - h)) / (h * h)

# Richardson table on the central difference
def richardson(x, h, levels)
  table = Array[]
  Range.each(0...levels) do |i|
    hi = h / 2 ** i
    row = Float[central_diff(x, hi) { |t| yield(t) }]
    Range.each(1..i) do |j|
      f = 4.0 ** j
      Array.push(row, (f * row[j - 1] - table[i - 1][j - 1]) / (f - 1.0))
    end
    Array.push(table, row)
  end
  Array.last(Array.last(table))
end

def fn(name, x)
  case name
  in :sin then Math.sin(x)
  in :exp then Math.exp(x)
  in :log then Math.log(x)
  in :rational then 1.0 / (1.0 + x * x)
  end
end

def exact_d(name, x)
  case name
  in :sin then Math.cos(x)
  in :exp then Math.exp(x)
  in :log then 1.0 / x
  in :rational then -2.0 * x / (1.0 + x * x) ** 2
  end
end

x0 = 0.7
puts(format("errors at x = %.1f, h = 1e-3:", x0))
puts(format("%-9s %10s %10s %10s %10s %10s", "f", "forward", "backward", "central", "5-point", "richard."))
errors = Hash[]
Array.each(Array[:sin, :exp, :log, :rational]) do |name|
  ex = exact_d(name, x0)
  vals = Array[
    forward_diff(x0, 1e-3) { |t| fn(name, t) },
    backward_diff(x0, 1e-3) { |t| fn(name, t) },
    central_diff(x0, 1e-3) { |t| fn(name, t) },
    five_point(x0, 1e-3) { |t| fn(name, t) },
    richardson(x0, 0.1, 4) { |t| fn(name, t) }
  ]
  errs = Array.map(vals) { |v| Float.abs(v - ex) }
  errors[name] = errs
  puts(format("%-9s %s", name, Array.join(Array.map(errs) { |e| format("%10.2e", e) }, " ")))
end
labels = Array["forward", "backward", "central", "5-point", "richardson"]
best_counts = Hash.new(0)
Hash.each(errors) do |name, errs|
  i = Array.index(errs, Array.min(errs))
  best_counts[labels[i]] += 1
end
puts("most accurate: #{Array.join(Array.map(Hash.to_a(best_counts)) { |l, c| "#{l} x#{c}" }, ", ")}")

puts("central difference of sin at 1.0 vs step size:")
best_h = nil
best_err = nil
Range.each(1..12) do |k|
  h = 10.0 ** (0 - k)
  err = Float.abs(central_diff(1.0, h) { |t| Math.sin(t) } - Math.cos(1.0))
  if best_err == nil || err < best_err
    best_err = err
    best_h = h
  end
  puts(format("  h=1e-%02d err=%.3e", k, err)) if k % 2 == 0
end
puts(format("  best h = %.0e (err %.2e); theory ~ cbrt(eps) = %.1e", best_h, best_err, Math.cbrt(2.220446049250313e-16)))

puts(format("second derivative of exp at 0: %.8f", second_diff(0.0, 1e-4) { |t| Math.exp(t) }))

# Jacobian of F(x, y) = (x^2 y - 1, sin(x) + y^3) by central differences
def big_f(v)
  x = v[0]
  y = v[1]
  Float[x * x * y - 1.0, Math.sin(x) + y ** 3]
end

def jacobian(v, h)
  n = Array.size(v)
  cols = Range.map(0...n) do |j|
    plus = Array.dup(v)
    minus = Array.dup(v)
    plus[j] += h
    minus[j] -= h
    fp = big_f(plus)
    fm = big_f(minus)
    Range.map(0...Array.size(fp)) { |i| (fp[i] - fm[i]) / (2.0 * h) }
  end
  Range.map(0...n) { |i| Range.map(0...n) { |j| cols[j][i] } }
end

pt = Float[1.2, 0.8]
jac = jacobian(pt, 1e-5)
px = pt[0]
py = pt[1]
exact = Array[Float[2.0 * px * py, px * px], Float[Math.cos(px), 3.0 * py * py]]
Array.each_with_index(jac) do |row, i|
  puts(format("J row %d: %s  (exact %s)", i, Array.join(Array.map(row) { |v| format("%.6f", v) }, " "), Array.join(Array.map(exact[i]) { |v| format("%.6f", v) }, " ")))
end
