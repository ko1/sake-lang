require "base64"

# 6 KB of every byte value: encode64, decode64, strict, urlsafe.
bin = Array.pack(Array.map(Range.to_a(0...6000)) { |i| (i * 7) % 256 }, "C*")
t0 = Time.now
e = Base64.encode64(bin)
d = Base64.decode64(e)
s = Base64.strict_encode64(bin)
d2 = Base64.strict_decode64(s)
u = Base64.urlsafe_decode64(Base64.urlsafe_encode64(bin))
el = Time.to_f(Time.now) - Time.to_f(t0)
p [String.size(e), d == bin, d2 == bin, u == bin]
warn "work #{Float.round(el * 1000)}ms"
