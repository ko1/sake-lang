# The same events, dispatched with case/in on a tagged Tuple (current Sake style).
log = String[]
users = Array[]
ticks = 0
events = Array[[:tick, 3], [:tick, 4], [:msg, "hello"], [:user, {name: "ko1", age: 20}]]
Array.each(events) do |kind, arg|
  case kind
  in :tick then ticks = ticks + arg
  in :msg
    Array.push(log, String.upcase(arg))
    Array.push(log, "len=#{String.size(arg)}")
  in :user
    arg => {name:}
    Array.push(users, name)
  end
end
p ticks
p log
p users
