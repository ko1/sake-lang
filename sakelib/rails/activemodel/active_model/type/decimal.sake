# Port of activemodel-8.1.3/lib/active_model/type/decimal.rb (over sakelib/bigdecimal)

module ActiveModel
  module Type
    class Decimal
      attr_reader precision, scale, limit
      include Value
      include Helpers::Immutable
      include Helpers::Numeric

      def initialize(t) = nil

      def bigdecimal_precision = 18

      def type(t) = :decimal

      def type_cast_for_schema(t, value) = Kernel.inspect(Kernel.to_s(value))

      def cast_value(t, value)
        casted = case value
                 in ::Float then convert_float_to_big_decimal(t, value)
                 in ::Integer then BigDecimal.from_i(value)
                 in ::Rational then BigDecimal.from_r(value, @precision || bigdecimal_precision)
                 in BigDecimal then value
                 in ::String then (BigDecimal.parse(::String.strip(value)) rescue BigDecimal.from_i(0))
                 else (BigDecimal.parse(Kernel.to_s(value)) rescue BigDecimal.from_i(0))
                 end
        apply_scale(t, casted)
      end

      def convert_float_to_big_decimal(t, value)
        prec = @precision
        if prec
          BigDecimal.from_f(value, prec > 16 ? 16 : prec)
        else
          BigDecimal.from_f(value, 0)
        end
      end

      def apply_scale(t, value)
        s = @scale
        s ? BigDecimal.round(value, s) : value
      end
    end
  end
end
