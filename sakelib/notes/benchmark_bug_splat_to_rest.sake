# Status (2026-10-05): fixed.
# A splat into a user function's *rest is rejected, so a *rest cannot be passed on as Ruby's
# bm(label_width = 0, *labels, &blk) does with benchmark(CAPTION, label_width, FORMAT, *labels, &blk):
# "`*xs`: splat arguments go only to built-ins that take any number of arguments"
def f(a, *rest) = p(rest)
def g(*xs) = f(1, *xs)
g(2, 3)
