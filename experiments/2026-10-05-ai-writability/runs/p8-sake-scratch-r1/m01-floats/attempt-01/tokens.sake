# Tokens (SPEC section 2.3).
#
# kind is one of
#   :int         int_value holds the value, text the digits as written
#   :float       text the digits and point as written, without underscores
#   :string      parts holds the pieces (see below); text is "\""
#   :name        text is the name
#   :keyword     text is the keyword
#   :op          text is the operator or punctuation
#   :newline     a statement-ending newline (2.2)
#   :interp_end  the `}` that closes an interpolation
#   :eof         the end of the input
#
# A string's parts are, in order, Strings (literal text, escapes already
# applied) and Arrays of Tokens (the code of one interpolation, ending with an
# :interp_end token).
class Token
  attr_reader kind, text, line, col, int_value, parts
end

module Tokens
  module_function

  def make(kind, text, line, col) = Token.new(kind, text, line, col, 0, Array[])

  def keywords
    once do
      Set["and", "assert", "break", "catch", "const", "continue", "do", "elif", "else", "end",
          "false", "finally", "fn", "for", "if", "in", "let", "match", "nil", "not", "or",
          "return", "then", "throw", "true", "try", "when", "while"]
    end
  end

  def keyword?(word) = Set.include?(keywords, word)

  # Operators after which a newline does not end the statement (2.2).
  def continuation_ops
    once do
      Set["+", "-", "*", "/", "%", "**", "==", "!=", "<", "<=", ">", ">=",
          "=", "+=", "-=", "*=", "/=", "%=", ",", "."]
    end
  end

  def continuation_keywords = once { Set["and", "or", "not", "in"] }

  # True when a newline right after tok continues the expression.
  def continues_line?(tok)
    case Token.kind(tok)
    in :op then Set.include?(continuation_ops, Token.text(tok))
    in :keyword then Set.include?(continuation_keywords, Token.text(tok))
    else false
    end
  end

  # Keywords that end a block: a statement may end right before them (3.1).
  def block_end_keywords = once { Set["end", "elif", "else", "catch", "finally", "when"] }

  # How a token is named in a syntax error (3.3).
  def describe(tok)
    case Token.kind(tok)
    in :string then "string"
    in :newline then "end of line"
    in :eof then "end of input"
    in :interp_end then "'}'"
    else "'#{Token.text(tok)}'"
    end
  end
end
