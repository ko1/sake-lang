# Status (2026-10-04): fixed.
# Bug: an IO value is not == to itself (Ruby: io == io is true). Prints false four times; Ruby prints true.
# Workaround in test/sakelib/json.sake: print the returned IO with p (#<File:...>) instead of comparing.
o = IO.stdout
p(o == o)
p(IO.stdout == IO.stdout)
def same(x) = x
p(same(o) == o)
File.open("r3.tmp", "w") { |f| p(f == f) }
File.delete("r3.tmp")
