# Port of activerecord-8.1.3/lib/active_record/counter_cache.rb (partial: the class methods; the belongs_to side
# (counter_cache: true) is the associations' (associations/builder/belongs_to))
#
# Ruby's CounterCache#_create_record / #destroy_row in the super chain (persistence.sake): after the INSERT, and
# after the DELETE, the counters of each belongs_to with counter_cache change by one.

module ActiveRecord
  module CounterCache
    def counter_cache__create_record(r, extra_names = String[])
      id = persistence__create_record(r, extra_names)
      each_counter_cached_association_change(r, 1)
      id
    end

    def counter_cache_destroy_row(r)
      affected = persistence_destroy_row(r)
      each_counter_cached_association_change(r, -1) if affected > 0
      affected
    end

    # Ruby: update_counters(id, counters) / increment_counter / decrement_counter
    def update_counters(id, counters) = Relation.update_counters(Relation.where(unscoped, Hash.of((primary_key || "id") => id)), counters)
    def increment_counter(counter_name, id, by = 1) = update_counters(id, Hash.of(counter_name => by))
    def decrement_counter(counter_name, id, by = 1) = update_counters(id, Hash.of(counter_name => -by))
  end
end
