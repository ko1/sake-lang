# Port of activemodel-8.1.3/lib/active_model/type/binary.rb

module ActiveModel
  module Type
    class Binary
      attr_reader precision, scale, limit
      include Value

      def initialize(t) = nil

      def type(t) = :binary
      def binary?(t) = true

      def cast(t, value)
        return Data.to_s(value) if value in Data
        v = super_cast(t, value)
        (v in ::String) ? ::String.b(v) : v
      end

      def serialize(t, value)
        return nil if value in nil
        Data.new(Kernel.to_s(value))
      end

      def changed_in_place?(t, raw_old_value, value) = !ActiveModel::Type.same_value?(deserialize(t, raw_old_value), value)

      # Ruby: Data.new(value) holds value.to_s as binary
      class Data
        attr_reader value
        def initialize(d) = @value = ::String.b(@value)
        def to_s(d) = @value
        def hex(d) = ::String.unpack1(@value, "H*")
      end
    end
  end
end
