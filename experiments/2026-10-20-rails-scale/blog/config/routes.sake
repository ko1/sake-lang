require "rails/actionpack/action_dispatch/routing"

# Rails: Rails.application.routes.draw do ... end; the block is a function of the reopened Mapper, so its calls are bare
class ActionDispatch::Routing::Mapper
  def application_routes(map)
    resource map, :session
    resources map, :articles do
      resources map, :comments, only: Any[:create, :destroy]
    end

    get map, "up", to: "rails/health#show", as: :rails_health_check

    root map, "articles#index"
  end
end
