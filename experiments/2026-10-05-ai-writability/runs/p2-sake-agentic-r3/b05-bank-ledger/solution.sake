class Acct
  attr_accessor bal, low, txns, wd
  attr_reader limit
end

def money(c)
  sign = c < 0 ? "-" : ""
  a = Integer.abs(c)
  "#{sign}#{a / 100}.#{String.rjust(Integer.to_s(a % 100), 2, "0")}"
end

def amount?(s) = String.match?(s, /\A\d+(\.\d{1,2})?\z/)

def cents(s)
  parts = String.split(s, ".")
  frac = parts[1] || ""
  String.to_i(parts[0]) * 100 + String.to_i(String.ljust(frac, 2, "0"))
end

def name?(s) = String.match?(s, /\A[a-z]{1,16}\z/)

def change(a, delta)
  Acct.set_bal(a, Acct.bal(a) + delta)
  Acct.set_low(a, Acct.bal(a)) if Acct.bal(a) < Acct.low(a)
end

accts = Hash[]
month = 0
n = 0
Array.each(IO.readlines(IO.stdin)) do |raw|
  n += 1
  line = String.chomp(raw)
  next if String.empty?(String.strip(line))
  f = String.split(line, " ")
  cmd = f[0]
  want = Hash["OPEN" => 3, "DEPOSIT" => 3, "WITHDRAW" => 3, "TRANSFER" => 4, "MONTHEND" => 1][cmd]
  if want == nil
    puts("line #{n}: error: unknown command")
    next
  end
  if Array.size(f) != want
    puts("line #{n}: error: wrong field count")
    next
  end
  if cmd == "MONTHEND"
    month += 1
    puts("== month #{month} ==")
    Array.each(Array.sort(Hash.keys(accts))) do |name|
      a = accts[name]
      b = Acct.bal(a)
      if b < 0
        od = -b
        ch = (od * 15 + 999) / 1000
        if ch > 0
          change(a, -ch)
          puts("#{name} interest -#{money(ch)}")
        end
      elsif b > 0
        ad = b * 25 / 10000
        if ad > 0
          change(a, ad)
          puts("#{name} interest +#{money(ad)}")
        end
      end
      if Acct.wd(a) > 4
        change(a, -200)
        puts("#{name} fee -2.00")
      end
      Acct.set_wd(a, 0)
    end
    next
  end
  names = cmd == "TRANSFER" ? Array[f[1], f[2]] : Array[f[1]]
  bad = Array.find(names) { |x| !name?(x) }
  if bad
    puts("line #{n}: error: bad name")
    next
  end
  astr = f[-1]
  unless amount?(astr) && (cmd == "OPEN" || cents(astr) > 0)
    puts("line #{n}: error: bad amount")
    next
  end
  amt = cents(astr)
  if cmd == "OPEN"
    if accts[f[1]]
      puts("line #{n}: error: account #{f[1]} exists")
    else
      accts[f[1]] = Acct.new(0, 0, 0, 0, amt)
    end
    next
  end
  missing = Array.find(names) { |x| accts[x] == nil }
  if missing
    puts("line #{n}: error: no account #{missing}")
    next
  end
  if cmd == "TRANSFER" && f[1] == f[2]
    puts("line #{n}: error: same account")
    next
  end
  a = accts[f[1]]
  if cmd == "DEPOSIT"
    change(a, amt)
    Acct.set_txns(a, Acct.txns(a) + 1)
    next
  end
  if Acct.bal(a) - amt < -Acct.limit(a)
    puts("line #{n}: error: insufficient funds in #{f[1]}")
    next
  end
  change(a, -amt)
  Acct.set_txns(a, Acct.txns(a) + 1)
  Acct.set_wd(a, Acct.wd(a) + 1)
  if cmd == "TRANSFER"
    d = accts[f[2]]
    change(d, amt)
    Acct.set_txns(d, Acct.txns(d) + 1)
  end
end
if Hash.empty?(accts)
  puts("no accounts")
else
  names = Array.sort_by(Hash.keys(accts)) { |k| [-Acct.bal(accts[k]), k] }
  puts(format("%-16s %12s %12s %5s", "account", "balance", "lowest", "txns"))
  total = 0
  Array.each(names) do |k|
    a = accts[k]
    total += Acct.bal(a)
    puts(format("%-16s %12s %12s %5d", k, money(Acct.bal(a)), money(Acct.low(a)), Acct.txns(a)))
  end
  puts("total: #{money(total)}")
end
