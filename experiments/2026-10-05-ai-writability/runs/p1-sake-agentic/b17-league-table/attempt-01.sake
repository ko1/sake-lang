def valid_name?(s) = String.match?(s, /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/)

def team_id(idx, names, rows, name)
  i = idx[name]
  return i if i != nil
  Array.push(names, name)
  Array.push(rows, Array[0, 0, 0, 0, 0, 0])
  i = Array.size(names) - 1
  idx[name] = i
  i
end

# stats row: 0 P, 1 W, 2 D, 3 L, 4 GF, 5 GA
def record(row, gfor, gagainst)
  row[0] += 1
  row[4] += gfor
  row[5] += gagainst
  if gfor > gagainst
    row[1] += 1
  elsif gfor == gagainst
    row[2] += 1
  else
    row[3] += 1
  end
end

def pts(row) = row[1] * 3 + row[2]

def main
  lines = IO.readlines(IO.stdin)
  idx = Hash[]
  names = String[]
  rows = Array[]
  games = Array[]
  n = 0
  Array.each(lines) do |raw|
    n += 1
    line = String.chomp(raw)
    next if String.strip(line) == ""
    toks = String.split(String.strip(line), /\s+/)
    ok = Array.size(toks) == 3 && valid_name?(toks[0]) && valid_name?(toks[2]) && toks[0] != toks[2]
    played = false
    hg = 0
    ag = 0
    if ok && toks[1] != "P-P"
      md = String.match(toks[1], /\A(\d{1,2})-(\d{1,2})\z/)
      if md == nil
        ok = false
      else
        played = true
        hg = String.to_i(md[1])
        ag = String.to_i(md[2])
      end
    end
    if !ok
      puts("invalid line #{n}: #{line}")
      next
    end
    hi = team_id(idx, names, rows, toks[0])
    ai = team_id(idx, names, rows, toks[2])
    if played
      record(rows[hi], hg, ag)
      record(rows[ai], ag, hg)
      Array.push(games, [hi, ai, hg, ag])
    end
  end
  nt = Array.size(names)
  if nt == 0
    puts("no teams")
    return
  end
  # key of the first three criteria, per team
  keys = Array.map(rows) { |r| [pts(r), r[4] - r[5], r[4]] }
  h2h = Array.new(nt, 0)
  Array.each(games) do |g|
    hi, ai, hg, ag = g
    if keys[hi] == keys[ai]
      if hg > ag
        h2h[hi] += 3
      elsif hg < ag
        h2h[ai] += 3
      else
        h2h[hi] += 1
        h2h[ai] += 1
      end
    end
  end
  order = Array.sort_by(Range.to_a(0...nt)) do |i|
    k = keys[i]
    [-k[0], -k[1], -k[2], -h2h[i], names[i]]
  end
  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
  Array.each(order) do |i|
    k = keys[i]
    above = Array.count(Range.to_a(0...nt)) do |j|
      kj = keys[j]
      kj[0] > k[0] || (kj[0] == k[0] && (kj[1] > k[1] || (kj[1] == k[1] && (kj[2] > k[2] || (kj[2] == k[2] && h2h[j] > h2h[i])))))
    end
    r = rows[i]
    gd = r[4] - r[5]
    gds = gd > 0 ? "+#{gd}" : "#{gd}"
    puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", above + 1, names[i], r[0], r[1], r[2], r[3], r[4], r[5], gds, k[0]))
  end
end

main
