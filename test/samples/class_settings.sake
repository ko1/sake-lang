# sake: --strict=0
# Fields in the class body: attr_reader x, attr_accessor n = 0, attr_writer w; `class E < Exception` for an exception type.
class Point
  attr_accessor x, y
  def norm2(p) = @x * @x + @y * @y
end
class Account
  attr_reader owner
  attr_accessor balance
  def deposit(a, n) = @balance += n
  def rename(a, s) = @owner = s
end
class Config
  attr_reader host, port = 80
end
class ParseError < Exception
  attr_reader line
end
p(Point.norm2(Point.new(3, 4)))
a = Account.new("ann", 10)
Account.deposit(a, 5)
Account.rename(a, "bob")
p(a)
p(Config.new("example.com"))
p(Config.get_port(Config.new("h", 8080)))
begin
  raise ParseError.new("bad", 3)
rescue ParseError => e
  p([Exception.message(e), ParseError.get_line(e)])
end
Config.new("h", "eighty")
