# Port of actionpack-8.1.3/lib/action_dispatch/http/param_error.rb (partial: no === matching Rack's errors)
#
# Rails: `class ParamError < ActionDispatch::Http::Parameters::ParseError` and three subclasses. Sake has no
# subclasses: ParamError is a module the three include (`rescue ActionDispatch::ParamError` catches them), and a
# `rescue Http::Parameters::ParseError` does not catch them (it does in Rails).

module ActionDispatch
  module ParamError
  end
  class ParameterTypeError < StandardError
    include ParamError
  end
  class InvalidParameterError < StandardError
    include ParamError
  end
  class ParamsTooDeepError < StandardError
    include ParamError
  end
end
