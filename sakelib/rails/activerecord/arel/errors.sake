# Port of activerecord-8.1.3/lib/arel/errors.rb
#
# Ruby's EmptyJoinError < ArelError and BindError < ArelError: `rescue Arel::ArelError` catches the types
# that include the module ArelError here.

module Arel
  module ArelError
  end

  class EmptyJoinError < StandardError
    include ArelError
  end

  # Ruby: BindError.new(message, sql = nil) appends " in: #{sql.inspect}"; here `new` takes the message and
  # the sql, and initialize writes the message.
  class BindError < StandardError
    attr_reader sql
    include ArelError
    def initialize(e)
      sql = @sql
      @message = "#{@message} in: #{Kernel.inspect(sql)}" if sql
    end
  end
end
