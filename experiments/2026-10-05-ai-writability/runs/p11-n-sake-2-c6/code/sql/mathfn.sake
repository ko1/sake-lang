# ceil, ceiling, floor, trunc, mod, pow, power, sqrt and pi (7.1, 7.2). Arity is checked by Functions.arity.
module MathFn
  module_function

  # The argument as a number, or nil (7.1): text counts only if it is wholly a numeric literal, not by prefix.
  def number(v)
    case v
    in Integer then v
    in Float then v
    in String then NumText.parse_whole(v)
    else nil
    end
  end

  # args has no NULL (Functions.call); the result is NULL if an argument is not a number.
  def call(name, args)
    return Math.PI() if name == "pi"
    x = number(args[0])
    return nil if x == nil
    case name
    in "ceil" | "ceiling" then ceil(x)
    in "floor" then floor(x)
    in "trunc" then trunc(x)
    in "sqrt" then sqrt(Arithmetic.to_f(x))
    else
      y = number(args[1])
      return nil if y == nil
      name == "mod" ? mod(Arithmetic.to_f(x), Arithmetic.to_f(y)) : pow(Arithmetic.to_f(x), Arithmetic.to_f(y))
    end
  end

  # An INTEGER stays one; a REAL gives a whole REAL.
  def ceil(n)
    case n
    in Float then Arithmetic.to_f(Float.ceil(n))
    else n
    end
  end

  def floor(n)
    case n
    in Float then Arithmetic.to_f(Float.floor(n))
    else n
    end
  end

  def trunc(n)
    case n
    in Float then Arithmetic.to_f(Float.truncate(n))
    else n
    end
  end

  # C's fmod: the remainder of the magnitudes (exact), with x's sign. Float `%` alone takes y's sign.
  def mod(x, y)
    return nil if y == 0.0
    r = Float.abs(x) % Float.abs(y)
    x < 0.0 ? -r : r
  end

  # A negative base needs a whole exponent, else the result is not a real number (Ruby would give a Complex).
  def pow(x, y)
    return nil if x < 0.0 && y != Arithmetic.to_f(Float.floor(y))
    x ** y
  end

  def sqrt(x) = x < 0.0 ? nil : Math.sqrt(x)
end
