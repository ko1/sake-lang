def passage
  "It was the best of times, it was the worst of times, it was the age of wisdom, " +
  "it was the age of foolishness, it was the epoch of belief, it was the epoch of " +
  "incredulity, it was the season of Light, it was the season of Darkness."
end

def break_lines(words, width)
  lines = Array[]
  current = Array[]
  len = 0
  Array.each(words) do |w|
    needed = Array.empty?(current) ? String.size(w) : len + 1 + String.size(w)
    if needed > width && Array.empty?(current) == false
      Array.push(lines, current)
      current = Array[w]
      len = String.size(w)
    else
      Array.push(current, w)
      len = needed
    end
  end
  Array.push(lines, current) unless Array.empty?(current)
  lines
end

def justify_line(words, width)
  return Array.first(words) if Array.size(words) == 1
  letters = Array.sum(Array.map(words) { |w| String.size(w) })
  gaps = Array.size(words) - 1
  spaces = width - letters
  base, extra = Integer.divmod(spaces, gaps)
  out = ""
  Array.each_with_index(words) do |w, i|
    out += w
    if i < gaps
      out += " " * (base + (i < extra ? 1 : 0))
    end
  end
  out
end

def align(words, width, mode, last)
  text = Array.join(words, " ")
  case mode
  in :left then text
  in :right then String.rjust(text, width)
  in :center then String.rstrip(String.center(text, width))
  in :justify then last ? text : justify_line(words, width)
  end
end

def badness(lines, width)
  total = 0
  Array.each_with_index(lines) do |words, i|
    next if i == Array.size(lines) - 1
    slack = width - String.size(Array.join(words, " "))
    total += slack * slack
  end
  total
end

def frame(rows, width)
  border = "+" + "-" * width + "+"
  puts(border)
  Array.each(rows) { |r| puts("|" + String.ljust(r, width) + "|") }
  puts(border)
end

words = String.split(passage, " ")
puts("words: #{Array.size(words)}, characters: #{String.size(passage)}")
Array.each(Integer[30, 42]) do |width|
  lines = break_lines(words, width)
  puts("width #{width}: #{Array.size(lines)} lines, badness #{badness(lines, width)}")
  Array.each(Array[:left, :right, :center, :justify]) do |mode|
    puts("[#{mode}]")
    rendered = Array[]
    Array.each_with_index(lines) do |ws, i|
      Array.push(rendered, align(ws, width, mode, i == Array.size(lines) - 1))
    end
    frame(rendered, width)
  end
end
