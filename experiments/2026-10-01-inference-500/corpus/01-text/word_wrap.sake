Paragraph = Struct.new(:indent, :bullet, :words)

def sample_text
  "Sake keeps the syntax of Ruby but writes the type on every operation.\n" +
  "This makes the program a little longer, yet every call says exactly which code runs.\n" +
  "\n" +
  "* Wrapping text is a classic exercise that is surprisingly full of corner cases.\n" +
  "* Extraordinarily-long-hyphenated-identifiers-must-be-split-somewhere when they exceed the width.\n" +
  "\n" +
  "  An indented paragraph keeps its indentation on every wrapped line, which matters for quoted text."
end

def parse_paragraphs(text)
  paras = Paragraph[]
  current = nil
  Array.each(String.split(text, "\n")) do |line|
    if String.empty?(String.strip(line))
      current = nil
      next
    end
    stripped = String.lstrip(line)
    indent = String.size(line) - String.size(stripped)
    bullet = String.start_with?(stripped, "* ")
    body = bullet ? String.lstrip(stripped[2..]) : stripped
    if current == nil || bullet
      current = Paragraph.new(indent, bullet, Array[])
      Array.push(paras, current)
    end
    Array.concat(Paragraph.get_words(current), String.split(body, " "))
  end
  paras
end

def split_long(word, width)
  pieces = Array[]
  rest = word
  while String.size(rest) > width
    Array.push(pieces, rest[0...width])
    rest = rest[width..]
  end
  Array.push(pieces, rest) unless String.empty?(rest)
  pieces
end

def wrap_words(words, width)
  lines = Array[]
  line = ""
  Array.each(words) do |w|
    Array.each(split_long(w, width)) do |piece|
      if String.empty?(line)
        line = piece
      elsif String.size(line) + 1 + String.size(piece) <= width
        line = line + " " + piece
      else
        Array.push(lines, line)
        line = piece
      end
    end
  end
  Array.push(lines, line) unless String.empty?(line)
  lines
end

def render(paras, width)
  out = Array[]
  Array.each_with_index(paras) do |para, i|
    Array.push(out, "") if i > 0 && Paragraph.get_bullet(para) == false
    pad = " " * Paragraph.get_indent(para)
    first_prefix = Paragraph.get_bullet(para) ? pad + "* " : pad
    rest_prefix = Paragraph.get_bullet(para) ? pad + "  " : pad
    inner = width - String.size(first_prefix)
    lines = wrap_words(Paragraph.get_words(para), inner)
    Array.each_with_index(lines) do |l, j|
      Array.push(out, (j == 0 ? first_prefix : rest_prefix) + l)
    end
  end
  out
end

def ruler(width)
  marks = ""
  Integer.upto(1, width) { |i| marks += i % 10 == 0 ? Integer.to_s(i / 10 % 10) : "." }
  marks
end

paras = parse_paragraphs(sample_text)
puts("paragraphs: #{Array.size(paras)}")
Array.each(Integer[28, 45]) do |width|
  puts(ruler(width))
  lines = render(paras, width)
  Array.each(lines) { |l| puts(String.rstrip(l)) }
  longest = Array.max(Array.map(lines) { |l| String.size(l) })
  puts("-- width #{width}: #{Array.size(lines)} lines, longest #{longest}")
end
