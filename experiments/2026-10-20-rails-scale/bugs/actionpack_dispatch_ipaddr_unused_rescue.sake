# Any use of sakelib/ipaddr's IPAddr.new prints two `unused-rescue` warnings at ipaddr.sake:247 and :257
# (IPAddr.== and IPAddr.<=>: `begin coerce(a, b) rescue IPAddr::Error ... end`), although nothing here compares
# addresses. Ruby: no warning (it has none). Seen from the HostAuthorization port (hosts may be IPAddrs).
# Expected: no warning, since == / <=> are not reached; or, if they are checked anyway, coerce of a String
# can raise InvalidAddressError, so the rescue is used.
require "ipaddr"
p(IPAddr.new("10.0.0.0/8"))
