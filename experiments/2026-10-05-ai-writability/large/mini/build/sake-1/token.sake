# Tokens (SPEC section 2.3).
#
# `type` is one of :int, :name, :keyword, :op, :string, :newline, :eof and
# :interp_end (the `}` that closes an interpolation). `text` is the source
# text. `value` is the Integer of an :int, and the parts of a :string: an
# Array whose elements are Strings (literal text) or Arrays of tokens (an
# interpolation, ending with its :interp_end token).
class Token
  attr_reader type, text, line, col, value
end

def keywords
  once do
    Set["and", "assert", "break", "catch", "const", "continue", "do", "elif", "else", "end",
        "false", "finally", "fn", "for", "if", "in", "let", "match", "nil", "not", "or",
        "return", "then", "throw", "true", "try", "when", "while"]
  end
end

# Tokens after which a newline does not end the statement (SPEC 2.2).
def continuation_texts
  once do
    Set["+", "-", "*", "/", "%", "**", "==", "!=", "<", "<=", ">", ">=", "=",
        "+=", "-=", "*=", "/=", "%=", ",", ".", "and", "or", "not", "in"]
  end
end

def two_char_operators
  once { Set["**", "==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "%="] }
end

def one_char_operators
  once { Set["+", "-", "*", "/", "%", "<", ">", "=", "(", ")", "[", "]", "{", "}", ",", ":", ";", "."] }
end

# Whether `t` is the operator or keyword `text`.
def token_is?(t, text)
  type = Token.type(t)
  (type == :op || type == :keyword) && Token.text(t) == text
end

# How a token is named in a syntax error (SPEC 3.3).
def describe_token(t)
  case Token.type(t)
  in :string then "string"
  in :newline then "end of line"
  in :eof then "end of input"
  else "'#{Token.text(t)}'"
  end
end
