class Reading
  attr_reader day, temp
end

def readings
  temps = Float[
    3.2, 4.1, 2.8, 5.5, 6.0, 7.4, 6.9, 8.8, 9.1, 10.4, 9.7, 11.2, 12.5, 11.9,
    13.4, 14.8, 13.9, 15.2, 21.7, 16.1, 17.3, 16.8, 18.2, 17.5, 19.0, 18.4, 17.7, 16.2,
    15.8, 14.1, 14.9, 12.6, 11.8, 10.2, 2.0, 9.3, 8.1, 7.7, 6.2, 5.9
  ]
  out = Reading[]
  Array.each_with_index(temps) { |t, i| Array.push(out, Reading.new(i + 1, t)) }
  out
end

def sma(xs, w)
  out = Array[]
  Array.each_cons(xs, w) { |win| Array.push(out, Array.sum(win) / w) }
  out
end

def ema(xs, alpha)
  out = Float[]
  prev = nil
  Array.each(xs) do |x|
    prev = prev == nil ? x : alpha * x + (1.0 - alpha) * prev
    Array.push(out, prev)
  end
  out
end

def rolling_std(xs, w)
  out = Array[]
  Array.each_cons(xs, w) do |win|
    m = Array.sum(win) / w
    Array.push(out, Math.sqrt(Array.sum(Array.map(win) { |x| (x - m) ** 2 }) / (w - 1)))
  end
  out
end

def median_of(xs)
  s = Array.sort(xs)
  n = Array.size(s)
  Integer.odd?(n) ? s[n / 2] : (s[n / 2 - 1] + s[n / 2]) / 2.0
end

# Hampel filter: replace points far from the rolling median
def hampel(xs, half, k)
  cleaned = Array.dup(xs)
  flagged = Array[]
  Array.each_with_index(xs) do |x, i|
    lo = Array.max(Array[0, i - half])
    hi = Array.min(Array[Array.size(xs) - 1, i + half])
    win = xs[lo..hi]
    med = median_of(win)
    mad = median_of(Array.map(win) { |v| Float.abs(v - med) })
    if Float.abs(x - med) > k * 1.4826 * mad
      cleaned[i] = med
      Array.push(flagged, [i, x, med])
    end
  end
  [cleaned, flagged]
end

def local_extrema(xs)
  result = Array[]
  Range.each(1...(Array.size(xs) - 1)) do |i|
    if xs[i] > xs[i - 1] && xs[i] > xs[i + 1]
      Array.push(result, [:max, i])
    elsif xs[i] < xs[i - 1] && xs[i] < xs[i + 1]
      Array.push(result, [:min, i])
    end
  end
  result
end

data = readings
temps = Array.map(data) { |r| Reading.temp(r) }
puts(format("%d readings, raw mean %.3f", Array.size(temps), Array.sum(temps) / Array.size(temps)))

cleaned, flagged = hampel(temps, 3, 3.0)
Array.each(flagged) do |i, was, now|
  puts(format("day %2d: %.1f looks wrong, replaced by %.2f", Reading.day(data[i]), was, now))
end

s7 = sma(cleaned, 7)
e3 = ema(cleaned, 0.3)
sd = rolling_std(cleaned, 7)
puts(" day   temp  sma7   ema   std7")
Array.each_with_index(cleaned) do |t, i|
  next unless i % 4 == 0 || i == Array.size(cleaned) - 1
  sm = i >= 6 ? format("%5.2f", s7[i - 6]) : "    -"
  st = i >= 6 ? format("%5.2f", sd[i - 6]) : "    -"
  puts(format("%4d %6.2f %s %5.2f %s", i + 1, t, sm, e3[i], st))
end

ext = local_extrema(s7)
Array.each(ext) do |kind, i|
  label = kind == :max ? "peak" : "trough"
  puts(format("smoothed %s on day %d (%.3f)", label, i + 7, s7[i]))
end

warm = Array.slice_when(cleaned) { |a, b| (a >= 15.0) != (b >= 15.0) }
runs = Array.select(warm) { |run| Array.first(run) >= 15.0 }
longest = Array.max_by(runs) { |run| Array.size(run) }
if longest
  puts(format("longest warm spell: %d days, mean %.2f", Array.size(longest), Array.sum(longest) / Array.size(longest)))
end

diffs = Array.map(Array.zip(Array.drop(cleaned, 1), cleaned)) { |b, a| b - a }
up, down = Array.partition(diffs) { |d| d > 0.0 }
puts(format("rises: %d (avg %.3f), falls: %d (avg %.3f)", Array.size(up), Array.sum(up) / Array.size(up), Array.size(down), Array.sum(down) / Array.size(down)))
biggest = Array.max_by(Range.to_a(0...Array.size(diffs))) { |i| Float.abs(diffs[i]) }
puts(format("biggest day-to-day change: day %d -> %d (%+.2f)", biggest + 1, biggest + 2, diffs[biggest]))
