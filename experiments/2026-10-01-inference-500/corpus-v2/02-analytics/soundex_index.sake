Person = Struct.new(:id, :first, :last)

def code_table
  table = Hash[]
  groups = Hash["1" => "bfpv", "2" => "cgjkqsxz", "3" => "dt", "4" => "l", "5" => "mn", "6" => "r"]
  Hash.each(groups) { |digit, letters| String.each_char(letters) { |c| table[c] = digit } }
  table
end

def soundex(name, table)
  s = String.downcase(String.gsub(name, /[^A-Za-z]/, ""))
  return "0000" if String.empty?(s)
  first = String.upcase(s[0])
  digits = ""
  prev = table[s[0]]
  Array.each(Array.drop(String.chars(s), 1)) do |c|
    d = table[c]
    if d
      digits += d if d != prev
      prev = d
    elsif c != "h" && c != "w"
      prev = nil
    end
  end
  String.ljust(first + digits, 4, "0")[0..3]
end

def people
  Person[
    Person.new(1, "Robert", "Rupert"), Person.new(2, "Ann", "Ashcraft"), Person.new(3, "Tom", "Tymczak"),
    Person.new(4, "Jo", "Pfister"), Person.new(5, "Eva", "Robert"), Person.new(6, "Li", "Lee"),
    Person.new(7, "Sam", "Smith"), Person.new(8, "Kim", "Smyth"), Person.new(9, "Pat", "Schmidt"),
    Person.new(10, "Al", "Ashcroft"), Person.new(11, "Max", "Lea"), Person.new(12, "Ida", "Honeyman"),
    Person.new(13, "Bo", "Rubin"), Person.new(14, "Cy", "Smithe"), Person.new(15, "Di", "Tymczack")
  ]
end

table = code_table
index = Hash[]
Array.each(people) do |pr|
  code = soundex(Person.get_last(pr), table)
  index[code] ||= Array[]
  Array.push(index[code], pr)
end

puts("reference codes:")
Array.each(Array["Robert", "Rupert", "Rubin", "Ashcraft", "Tymczak", "Pfister", "Honeyman"]) do |n|
  puts("  #{String.ljust(n, 9)} #{soundex(n, table)}")
end

puts("index (#{Hash.size(index)} codes):")
Array.each(Array.sort(Hash.keys(index))) do |code|
  names = Array.map(index[code]) { |pr| "#{Person.get_first(pr)} #{Person.get_last(pr)}" }
  puts("  #{code}: #{Array.join(names, "; ")}")
end

spellings = Hash[]
Hash.each(index) do |code, list|
  variants = Array.uniq(Array.map(list) { |pr| Person.get_last(pr) })
  spellings[code] = variants if Array.size(variants) > 1
end
puts("possible duplicate surnames:")
Hash.each(spellings) { |code, vs| puts("  #{code} #{Array.join(Array.sort(vs), " ~ ")}") }

def lookup(index, table, query)
  found = index[soundex(query, table)]
  return "none" unless found
  ids = Array.map(found) { |pr| Person.get_id(pr) }
  "ids #{Array.join(ids, ",")}"
end

Array.each(Array["Smitt", "Robbert", "Leigh", "Ashcroff", "Zhang", ""]) do |q|
  puts(format("lookup %-10s -> %s", "'#{q}'", lookup(index, table, q)))
end
