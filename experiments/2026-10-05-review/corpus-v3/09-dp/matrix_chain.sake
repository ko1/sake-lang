# a matrix known only by its shape, plus the multiplications spent to build it
class DimensionError < StandardError
  attr_reader left, right
end

class Shape
  attr_reader name, rows, cols, cost
  include Arithmetic
  def *(a, b)
    raise DimensionError.new("cannot multiply", @name, Shape.name(b)) if @cols != Shape.rows(b)
    work = @rows * @cols * Shape.cols(b)
    Shape.new("(#{@name}#{Shape.name(b)})", @rows, Shape.cols(b), @cost + Shape.cost(b) + work)
  end
  def to_s(s) = "#{@name} [#{@rows}x#{@cols}] cost=#{@cost}"
end

def optimal_order(dims)
  n = Array.size(dims) - 1
  cost = Array.new(n) { Array.new(n, 0) }
  split = Array.new(n) { Array.new(n, 0) }
  Integer.upto(2, n) do |len|
    Integer.upto(0, n - len) do |i|
      j = i + len - 1
      best = nil
      Integer.upto(i, j - 1) do |k|
        c = cost[i][k] + cost[k + 1][j] + dims[i] * dims[k + 1] * dims[j + 1]
        if best == nil || c < best
          best = c
          split[i][j] = k
        end
      end
      cost[i][j] = best
    end
  end
  [cost[0][n - 1], split]
end

def parens(names, split, i, j)
  return names[i] if i == j
  k = split[i][j]
  "(" + parens(names, split, i, k) + parens(names, split, k + 1, j) + ")"
end

def evaluate(shapes, split, i, j)
  return shapes[i] if i == j
  k = split[i][j]
  evaluate(shapes, split, i, k) * evaluate(shapes, split, k + 1, j)
end

def left_to_right(shapes)
  Array.reduce(Array.drop(shapes, 1), shapes[0]) { |acc, s| acc * s }
end

def make_shapes(dims)
  names = Range.map(0...(Array.size(dims) - 1)) { |i| Integer.chr(65 + i) }
  shapes = Shape[]
  Array.each_with_index(names) { |nm, i| Array.push(shapes, Shape.new(nm, dims[i], dims[i + 1], 0)) }
  shapes
end

chains = Array[
  Array[10, 30, 5, 60],
  Array[40, 20, 30, 10, 30],
  Array[30, 35, 15, 5, 10, 20, 25],
  Array[5, 10, 3, 12, 5, 50, 6],
  Array[2, 3]
]

Array.each(chains) do |dims|
  shapes = make_shapes(dims)
  names = Array.map(shapes) { |s| Shape.name(s) }
  best, split = optimal_order(dims)
  n = Array.size(shapes)
  puts("dims #{Array.join(dims, "x")}")
  puts("  optimal: #{parens(names, split, 0, n - 1)} = #{best} multiplications")
  result = evaluate(shapes, split, 0, n - 1)
  naive = left_to_right(shapes)
  puts("  check:   #{result}")
  puts("  naive:   #{naive}")
  saved = Shape.cost(naive) - Shape.cost(result)
  pct = Shape.cost(naive) == 0 ? 0.0 : 100.0 * saved / Shape.cost(naive)
  puts(format("  saved %d (%.1f%%)", saved, pct))
end

bad = Shape[Shape.new("P", 4, 5, 0), Shape.new("Q", 6, 2, 0)]
begin
  left_to_right(bad)
rescue DimensionError => e
  puts("#{Exception.message(e)}: #{DimensionError.left(e)} and #{DimensionError.right(e)}")
end
