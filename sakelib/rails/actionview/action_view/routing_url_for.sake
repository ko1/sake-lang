# Port of actionview-8.1.3/lib/action_view/routing_url_for.rb (partial: no ActionController::Parameters, no Class arguments)
#
# Rails includes this module (with the routes' url_helpers) into a view class that has routes; its url_for
# overrides UrlHelper#url_for and calls ActionDispatch::Routing::UrlFor's with `super`, here `full_url_for`.
# The view's routes are its `routes` field (Rails' class_attribute :_routes); url_options are the controller's
# when the view has one (a view class overrides url_options), else default_url_options.

require "../../actionpack/action_dispatch/routing/url_for"
require "../../actionpack/action_dispatch/routing/polymorphic_routes"
require "record_identifier"

module ActionView
  module RoutingUrlFor
    include ActionDispatch::Routing::UrlFor
    include RecordIdentifier

    def routes(v) = raise(NotImplementedError)
    def _routes(v) = routes(v) || raise(ArgumentError, "arguments passed to url_for can't be handled. Please require routes or provide your own implementation")
    def url_options(v) = default_url_options(v)

    def url_for(v, options = nil)
      case options
      in String then options
      in nil then full_url_for(v, Hash.of(only_path: _generate_paths_by_default(v)))
      in Hash
        opts = Hash.transform_keys(options) { |k| String.to_sym(Kernel.to_s(k)) }
        ensure_only_path_option(v, opts)
        full_url_for(v, opts)
      in :back then _back_url(v)
      in Array
        last = Array.last(options)
        opts = (last in Hash) ? last : Hash.new
        # Ruby: components.extract_options!
        components = Array.compact(Array.map(options) do |c|
          case c
          in Hash then nil
          else c
          end
        end)
        ensure_only_path_option(v, opts)
        opts[:only_path] ? polymorphic_path(v, components, opts) : polymorphic_url(v, components, opts)
      in Symbol then ActionDispatch::Routing::PolymorphicRoutes::HelperMethodBuilder.polymorphic_method(v, options, nil, _generate_paths_by_default(v) ? :path : :url, Hash.new)
      else ActionDispatch::Routing::PolymorphicRoutes::HelperMethodBuilder.polymorphic_method(v, options, nil, _generate_paths_by_default(v) ? :path : :url, Hash.new)
      end
    end

    # private
    def _generate_paths_by_default(v) = true

    def ensure_only_path_option(v, options)
      unless Hash.key?(options, :only_path)
        options[:only_path] = _generate_paths_by_default(v) unless options[:host]
      end
    end
  end
end
