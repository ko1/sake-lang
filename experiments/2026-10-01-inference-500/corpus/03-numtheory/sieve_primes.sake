# Sieve of Eratosthenes with a small report: prime counts per block,
# twin primes, largest gaps, and primes of a few special forms.

def sieve(limit)
  is_prime = Array[]
  Integer.times(limit + 1) { Array.push(is_prime, true) }
  is_prime[0] = false
  is_prime[1] = false
  i = 2
  while i * i <= limit
    if is_prime[i]
      j = i * i
      while j <= limit
        is_prime[j] = false
        j += i
      end
    end
    i += 1
  end
  primes = Integer[]
  Array.each_with_index(is_prime) { |flag, n| Array.push(primes, n) if flag }
  primes
end

def counts_per_block(primes, block, limit)
  counts = Hash.new(0)
  Array.each(primes) { |p| counts[p / block] += 1 }
  rows = Array[]
  b = 0
  while b * block <= limit
    lo = b * block
    hi = lo + block - 1
    Array.push(rows, [lo, hi, counts[b]])
    b += 1
  end
  rows
end

def twin_primes(primes)
  pairs = Array[]
  Array.each_cons(primes, 2) do |w|
    a = w[0]
    b = w[1]
    Array.push(pairs, [a, b]) if b - a == 2
  end
  pairs
end

def largest_gaps(primes, k)
  gaps = Array[]
  Array.each_cons(primes, 2) { |w| Array.push(gaps, {from: w[0], to: w[1], size: w[1] - w[0]}) }
  # Tuple keys cannot be compared in sort_by, so fold (size desc, from asc) into one Integer
  sorted = Array.sort_by(gaps) { |g| g => {size:, from:}; (0 - size) * 1_000_000 + from }
  Array.take(sorted, k)
end

def mersenne_exponents(primes, max_exp)
  Array.select(Array.take_while(primes) { |p| p <= max_exp }) do |p|
    m = 2 ** p - 1
    is_p = m > 1
    d = 2
    while d * d <= m
      if m % d == 0
        is_p = false
        break
      end
      d += 1
    end
    is_p
  end
end

limit = 2000
primes = sieve(limit)
puts("primes up to #{limit}: #{Array.size(primes)}")
puts("first 15: #{Array.join(Array.take(primes, 15), " ")}")
tail = Array.drop(primes, Array.size(primes) - 5)
puts("last 5: #{Array.join(tail, " ")}")

puts("per block of 500:")
Array.each(counts_per_block(primes, 500, limit - 1)) do |lo, hi, c|
  puts(format("  %4d-%4d %4d %s", lo, hi, c, "*" * (c / 5)))
end

twins = twin_primes(primes)
puts("twin pairs: #{Array.size(twins)}")
last_twin = Array.last(twins)
if last_twin
  a, b = last_twin
  puts("largest twin pair: (#{a}, #{b})")
end

puts("largest gaps:")
Array.each(largest_gaps(primes, 4)) do |g|
  g => {from:, to:, size:}
  puts("  #{from} -> #{to}: #{size}")
end

puts("Mersenne prime exponents <= 30: #{Array.join(mersenne_exponents(primes, 30), ", ")}")

sophie = Array.select(primes) { |p| p < 500 && Array.include?(primes, 2 * p + 1) }
puts("Sophie Germain primes < 500: #{Array.size(sophie)} (max #{Array.max(sophie)})")
