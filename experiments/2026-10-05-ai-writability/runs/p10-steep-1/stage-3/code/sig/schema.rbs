module Sql
  module Names
    def self.fold: (String name) -> String
  end

  class Column
    attr_reader name: String
    attr_reader type: column_type
    attr_reader not_null: bool
    attr_reader default: value

    def initialize: (String name, column_type type, bool not_null, value default) -> void
    def type_name: () -> String
    def store: (value value, String table_name) -> value

    private

    def store_integer: (value value, String table_name) -> value
    def store_real: (value value, String table_name) -> value
    def reject: (value value, String table_name) -> bot
  end

  class Catalog
    @tables: Hash[String, Table]

    def initialize: () -> void
    def find: (String name) -> Table?
    def fetch: (String name) -> Table
    def add: (Table table) -> void
    def remove: (String name) -> void
  end
end
