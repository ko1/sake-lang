# CREATE TABLE and DROP TABLE.
module Ddl
  module_function

  def create_table(db, st)
    name = CreateTable.name(st)
    if Database.table?(db, name)
      return if CreateTable.if_not_exists(st)
      raise SqlError.new("table #{name} already exists")
    end
    Database.add_table(db, Table.new(name, columns_of(CreateTable.columns(st)), Array[]))
  end

  def columns_of(defs)
    columns = Array[]
    Array.each(defs) do |d|
      key = Value.lower(ColumnDef.name(d))
      if Array.any?(columns) { Column.key(it) == key }
        raise SqlError.new("duplicate column name: #{ColumnDef.name(d)}")
      end
      Array.push(columns, Column.new(ColumnDef.name(d), key, ColumnDef.type(d)))
    end
    columns
  end

  def drop_table(db, st)
    name = DropTable.name(st)
    unless Database.table?(db, name)
      return if DropTable.if_exists(st)
      raise SqlError.new("no such table: #{name}")
    end
    Database.remove_table(db, name)
  end
end
