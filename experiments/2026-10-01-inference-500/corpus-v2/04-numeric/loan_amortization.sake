Loan = Struct.new(:name, :principal, :annual_rate, :months)
Row = Struct.new(:month, :payment, :interest, :principal, :balance)
NoSolution = Exception.new(:low, :high)

def round2(x) = Float.round(x, 2)

def payment_for(principal, monthly_rate, months)
  return principal / months if monthly_rate == 0.0
  principal * monthly_rate / (1.0 - (1.0 + monthly_rate) ** -months)
end

def schedule(loan, extras)
  r = Loan.annual_rate(loan) / 12.0
  pay = round2(payment_for(Loan.principal(loan), r, Loan.months(loan)))
  balance = Loan.principal(loan)
  rows = Row[]
  month = 0
  while balance > 0.005
    month += 1
    interest = round2(balance * r)
    extra = Hash.fetch(extras, month, 0.0)
    amount = pay + extra
    amount = balance + interest if amount > balance + interest
    principal_part = round2(amount - interest)
    balance = round2(balance - principal_part)
    Array.push(rows, Row.new(month, round2(amount), interest, principal_part, balance))
    break if month > 1000
  end
  rows
end

def by_year(rows)
  years = Hash[]
  Array.each(rows) do |row|
    y = (Row.month(row) - 1) / 12 + 1
    paid, interest = years[y] || [0.0, 0.0]
    years[y] = [paid + Row.payment(row), interest + Row.interest(row)]
  end
  years
end

# monthly rate that makes the payment stream worth the principal (bisection)
def implied_rate(principal, payment, months)
  lo = 0.0
  hi = 0.05
  pv = payment_for(principal, hi, months)
  raise NoSolution.new("payment too large for any rate below 60%/yr", lo, hi) if payment > pv
  raise NoSolution.new("payment does not cover the principal", lo, hi) if payment * months < principal
  Integer.times(100) do
    mid = (lo + hi) / 2.0
    if payment_for(principal, mid, months) < payment
      lo = mid
    else
      hi = mid
    end
  end
  (lo + hi) / 2.0
end

def money(x) = format("%10.2f", x)

loans = Loan[
  Loan.new("car", 18500.0, 0.069, 60),
  Loan.new("mortgage", 240000.0, 0.0425, 360),
  Loan.new("interest-free", 1200.0, 0.0, 12)
]

Array.each(loans) do |loan|
  rows = schedule(loan, Hash[])
  total_interest = Array.sum(Array.map(rows) { |r| Row.interest(r) })
  first = Array.first(rows)
  last = Array.last(rows)
  puts(format("== %s: %.2f at %.2f%% over %d months", Loan.name(loan), Loan.principal(loan), Loan.annual_rate(loan) * 100.0, Loan.months(loan)))
  puts("  payment #{money(Row.payment(first))}, total interest #{money(total_interest)}, final payment #{money(Row.payment(last))} in month #{Row.month(last)}")
  if Array.size(rows) <= 72
    Array.each(rows) do |r|
      m = Row.month(r)
      next unless m <= 3 || m > Array.size(rows) - 2
      puts(format("  %3d %s %s %s %s", m, money(Row.payment(r)), money(Row.interest(r)), money(Row.principal(r)), money(Row.balance(r))))
    end
  end
  years = by_year(rows)
  shown = Array.select(Hash.keys(years)) { |y| y <= 2 || y == Hash.size(years) }
  Array.each(shown) do |y|
    paid, interest = years[y]
    puts(format("  year %2d paid %s of which interest %s", y, money(paid), money(interest)))
  end
end

mortgage = loans[1]
base = schedule(mortgage, Hash[])
extras = Hash[]
Range.each(1..60) { |m| extras[m] = 200.0 }
extras[12] = 5000.0
faster = schedule(mortgage, extras)
saved = Array.sum(Array.map(base) { |r| Row.interest(r) }) - Array.sum(Array.map(faster) { |r| Row.interest(r) })
puts(format("extra payments: paid off in %d months instead of %d, interest saved %.2f", Array.size(faster), Array.size(base), saved))
cross = Array.find(faster) { |r| Row.balance(r) < Loan.principal(mortgage) / 2.0 }
puts("half the mortgage repaid by month #{Row.month(cross)}") if cross

offers = Array[[10000.0, 220.0, 60], [10000.0, 180.0, 60], [10000.0, 50000.0, 60], [5000.0, 95.0, 48]]
Array.each(offers) do |principal, pay, months|
  begin
    r = implied_rate(principal, pay, months)
    puts(format("offer %.0f for %d x %.2f: APR %.3f%%", principal, months, pay, r * 1200.0))
  rescue NoSolution => e
    puts(format("offer %.0f for %d x %.2f: %s", principal, months, pay, Exception.message(e)))
  end
end
