def money(c) = format("%d.%02d", c / 100, c % 100)

def fee(mins, first, step, cap, grace)
  return 0 if mins <= grace
  d = mins / 1440
  r = mins % 1440
  part = 0
  if r > 0
    extra = r - 60
    extra = 0 if extra < 0
    periods = (extra + 29) / 30
    part = first + step * periods
  end
  part = cap if part > cap
  d * cap + part
end

def solve_main
  lines = IO.readlines(IO.stdin)
  hdr = String.split(String.strip(String.chomp(lines[0])), /\s+/)
  first = String.to_i(hdr[1])
  step = String.to_i(hdr[2])
  cap = String.to_i(hdr[3])
  grace = String.to_i(hdr[4])
  inside = Hash[]
  exits = Hash.new(0)
  rev = Hash.new(0)
  total_exits = 0
  total_rev = 0
  day = 0
  prev = nil
  k = 1
  while k < Array.size(lines)
    lineno = k + 1
    s = String.strip(String.chomp(lines[k]))
    k += 1
    next if String.empty?(s)
    m = String.match(s, /\A(\d\d):(\d\d) +(IN|OUT) +([A-Z0-9]{1,8})\z/)
    hh = 99
    mm = 99
    if m
      hh = String.to_i(m[1])
      mm = String.to_i(m[2])
    end
    if m == nil || hh > 23 || mm > 59
      puts("line #{lineno}: invalid")
      next
    end
    kind = m[3]
    plate = m[4]
    tm = hh * 60 + mm
    day += 1 if prev != nil && tm < prev
    prev = tm
    at = day * 1440 + tm
    if kind == "IN"
      if Hash.key?(inside, plate)
        puts("line #{lineno}: #{plate} already inside")
      else
        inside[plate] = at
      end
    else
      if Hash.key?(inside, plate)
        mins = at - inside[plate]
        Hash.delete(inside, plate)
        f = fee(mins, first, step, cap, grace)
        puts("#{plate} #{mins / 60}:#{format("%02d", mins % 60)} #{money(f)}")
        exits[plate] += 1
        rev[plate] += f
        total_exits += 1
        total_rev += f
      else
        puts("line #{lineno}: #{plate} not inside")
      end
    end
  end
  puts("--- summary")
  plates = Array.sort_by(Hash.keys(exits)) { |pl| [-rev[pl], pl] }
  Array.each(plates) { |pl| puts("#{pl} #{exits[pl]} #{money(rev[pl])}") }
  puts("total #{total_exits} #{money(total_rev)}")
  left = Array.sort(Hash.keys(inside))
  if Array.empty?(left)
    puts("inside: none")
  else
    puts("inside: #{Array.join(left, ", ")}")
  end
end

solve_main
