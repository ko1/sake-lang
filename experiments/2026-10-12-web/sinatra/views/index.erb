<h1>Todos</h1>
<ul>
<% todos.each do |todo| %>
  <li><a href="/todos/<%= todo[:id] %>"><%= h(todo[:title]) %></a><% if todo[:done] %> (done)<% else %>
    <form method="post" action="/todos/<%= todo[:id] %>/done"><button>done</button></form><% end %></li>
<% end %>
</ul>
<form method="post" action="/todos">
  <input name="title"> <button>add</button>
</form>
