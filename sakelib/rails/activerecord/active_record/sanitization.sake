# Port of activerecord-8.1.3/lib/active_record/sanitization.rb (partial: no named binds (:name) through
# sanitize_sql_hash, no sanitize_sql_for_order with arrays)

module ActiveRecord
  module Sanitization
    module_function

    # Ruby: sanitize_sql_array(["name = ?", value]): each ? replaced by the quoted value
    def sanitize_sql_array(statement, values)
      conn = ActiveRecord::Base.connection
      i = -1
      String.gsub(statement, /\?/) do |_|
        i += 1
        quote_bound_value(conn, values[i])
      end
    end

    def quote_bound_value(conn, value)
      case value
      in Array then Array.empty?(value) ? "NULL" : Array.join(Array.map(value) { |v| ConnectionAdapters::SQLite3Adapter.quote(conn, v) }, ",")
      else ConnectionAdapters::SQLite3Adapter.quote(conn, value)
      end
    end

    def sanitize_sql_like(string, escape_character = "\\")
      String.gsub(String.gsub(string, escape_character, escape_character + escape_character), /[%_]/) { |m| escape_character + m }
    end
  end
end
