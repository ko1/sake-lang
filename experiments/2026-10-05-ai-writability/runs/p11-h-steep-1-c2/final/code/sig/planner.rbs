module Sql
  module Planner
    def self.build: (Ast::Query query, Namespace namespace, Scope? parent) -> Plan
    def self.plan_body: (Ast::QueryBody body, Namespace namespace, Scope? parent) -> Plan
    def self.bind_ctes: (Ast::Query query, Namespace namespace) -> Namespace
    def self.plan_cte: (Cte cte) -> Plan
    def self.plan_view: (View view, Catalog catalog) -> Plan
    def self.self_referencing?: (Ast::CteDef definition) -> bool
  end
end
