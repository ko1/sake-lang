# The 26 built-in functions (SPEC section 10).
#
# A call checks the argument count, then each argument in order (its type,
# then its value); every error is reported at the `(` of the call.

module Builtins
  module_function

  def names
    once do
      String["print", "len", "push", "pop", "keys", "values", "has", "get", "del", "str", "int",
             "float", "type", "range", "join", "split", "slice", "sort", "contains", "min", "max", "upper",
             "lower", "reverse", "map", "filter"]
    end
  end

  # One value per built-in, in the order of names.
  def values = once { Array.map(names) { |name| Builtin.new(name) } }

  # [least, most] arguments; most is -1 when there is no maximum.
  def arity(name)
    case name
    in "print" then [0, -1]
    in "min" | "max" then [1, -1]
    in "get" | "slice" then [2, 3]
    in "range" then [1, 3]
    in "push" | "has" | "del" | "join" | "split" | "contains" | "map" | "filter" then [2, 2]
    else [1, 1]
    end
  end

  def type_error(name, n, expected, v, line, col)
    Fail.runtime("type", line, col, "#{name}: argument #{n} must be #{expected}, got #{Values.type_name(v)}")
  end

  def want_int(name, args, n, line, col)
    v = args[n - 1]
    return v if (v in Integer)
    type_error(name, n, "an int", v, line, col)
  end

  def want_number(name, args, n, line, col)
    v = args[n - 1]
    return v if (v in Integer | Float)
    type_error(name, n, "an int or float", v, line, col)
  end

  def want_string(name, args, n, line, col)
    v = args[n - 1]
    return v if (v in String)
    type_error(name, n, "a string", v, line, col)
  end

  # The items of an array argument.
  def want_array(name, args, n, line, col)
    v = args[n - 1]
    return MiniArray.items(v) if (v in MiniArray)
    type_error(name, n, "an array", v, line, col)
  end

  # The entries of a map argument.
  def want_map(name, args, n, line, col)
    v = args[n - 1]
    return MiniMap.entries(v) if (v in MiniMap)
    type_error(name, n, "a map", v, line, col)
  end

  def want_key(name, args, n, line, col)
    v = args[n - 1]
    return v if (v in String | Integer)
    type_error(name, n, "a string or int", v, line, col)
  end

  def want_function(name, args, n, line, col)
    v = args[n - 1]
    return v if (v in Closure | Builtin)
    type_error(name, n, "a function", v, line, col)
  end

  def call(vm, b, args, line, col)
    name = Builtin.name(b)
    min, max = arity(name)
    n = Array.size(args)
    if n < min || (max >= 0 && n > max)
      Fail.runtime("arity", line, col, Fail.arity_message(name, min, max, n))
    end
    case name
    in "print"
      Kernel.print(Array.join(Array.map(args) { |a| Text.str(a) }, " ") + "\n")
      nil
    in "len" then len(args, line, col)
    in "push"
      Array.push(want_array(name, args, 1, line, col), args[1])
      nil
    in "pop"
      a = want_array(name, args, 1, line, col)
      Fail.runtime("value", line, col, "pop: array is empty") if Array.empty?(a)
      Array.pop(a)
    in "keys" then MiniArray.new(Hash.keys(want_map(name, args, 1, line, col)))
    in "values" then MiniArray.new(Hash.values(want_map(name, args, 1, line, col)))
    in "has"
      m = want_map(name, args, 1, line, col)
      Hash.key?(m, want_key(name, args, 2, line, col))
    in "get"
      m = want_map(name, args, 1, line, col)
      k = want_key(name, args, 2, line, col)
      Hash.key?(m, k) ? m[k] : args[2]
    in "del"
      m = want_map(name, args, 1, line, col)
      k = want_key(name, args, 2, line, col)
      Ops.missing_key(k, line, col) unless Hash.key?(m, k)
      Hash.delete(m, k)
    in "str" then Text.str(args[0])
    in "int" then to_int(args[0], line, col)
    in "float" then to_float(args[0], line, col)
    in "type" then Values.type_name(args[0])
    in "range" then range(args, line, col)
    in "join"
      a = want_array(name, args, 1, line, col)
      sep = want_string(name, args, 2, line, col)
      Array.join(Array.map(a) { |e| Text.str(e) }, sep)
    in "split" then split(args, line, col)
    in "slice" then slice(args, line, col)
    in "sort" then sort(args, line, col)
    in "contains" then contains(args, line, col)
    in "min" | "max" then extreme(name, args, line, col)
    in "upper" then String.upcase(want_string(name, args, 1, line, col))
    in "lower" then String.downcase(want_string(name, args, 1, line, col))
    in "reverse"
      x = args[0]
      case x
      in MiniArray then MiniArray.new(Array.reverse(MiniArray.items(x)))
      in String then String.reverse(x)
      else type_error(name, 1, "an array or string", x, line, col)
      end
    in "map" | "filter" then map_or_filter(vm, name, args, line, col)
    end
  end

  def len(args, line, col)
    x = args[0]
    case x
    in String then String.length(x)
    in MiniArray then Array.size(MiniArray.items(x))
    in MiniMap then Hash.size(MiniMap.entries(x))
    else type_error("len", 1, "a string, array or map", x, line, col)
    end
  end

  # An optional `-` then one or more digits, nothing else.
  def to_int(x, line, col)
    case x
    in Integer then x
    in Float then Float.to_i(x)
    in String
      Fail.runtime("value", line, col, "int: cannot convert #{Text.repr(x, 0)} to int") unless String.match?(x, /\A-?[0-9]+\z/)
      String.to_i(x)
    else type_error("int", 1, "an int, float or string", x, line, col)
    end
  end

  # An optional `-`, digits, then optionally `.` and digits; an infinite result is an error.
  def to_float(x, line, col)
    r = nil
    case x
    in Float then r = x
    in Integer then r = Ops.to_float(x)
    in String then r = String.to_f(x) if String.match?(x, /\A-?[0-9]+(\.[0-9]+)?\z/)
    else type_error("float", 1, "an int, float or string", x, line, col)
    end
    return r if (r in Float) && Float.finite?(r)
    Fail.runtime("value", line, col, "float: cannot convert #{Text.repr(x, 0)} to float")
  end

  def range(args, line, col)
    Array.each_index(args) { |i| want_int("range", args, i + 1, line, col) }
    n = Array.size(args)
    start = n == 1 ? 0 : want_int("range", args, 1, line, col)
    stop = n == 1 ? want_int("range", args, 1, line, col) : want_int("range", args, 2, line, col)
    step = n == 3 ? want_int("range", args, 3, line, col) : 1
    Fail.runtime("value", line, col, "range: step must not be zero") if step == 0
    out = Array[]
    i = start
    while (step > 0 && i < stop) || (step < 0 && i > stop)
      Array.push(out, i)
      i += step
    end
    MiniArray.new(out)
  end

  # The pieces between occurrences of sep, keeping empty ones.
  def split(args, line, col)
    s = want_string("split", args, 1, line, col)
    sep = want_string("split", args, 2, line, col)
    Fail.runtime("value", line, col, "split: separator must not be empty") if String.empty?(sep)
    pieces = Array[]
    start = 0
    while true
      found = String.index(s, sep, start)
      break unless found
      Array.push(pieces, String.slice(s, start, found - start) || "")
      start = found + String.length(sep)
    end
    Array.push(pieces, String.slice(s, start, String.length(s) - start) || "")
    MiniArray.new(pieces)
  end

  def slice(args, line, col)
    x = args[0]
    type_error("slice", 1, "an array or string", x, line, col) unless (x in MiniArray | String)
    lo = want_int("slice", args, 2, line, col)
    hi = Array.size(args) == 3 ? want_int("slice", args, 3, line, col) : nil
    Ops.slice(x, lo, hi, line, col)
  end

  # All ints or all strings: each element after the first is checked against
  # the first.
  def sort(args, line, col)
    a = want_array("sort", args, 1, line, col)
    return MiniArray.new(Array.dup(a)) if Array.size(a) <= 1
    first = a[0]
    Array.each(Array.drop(a, 1)) do |e|
      same = (Ops.number?(first) && Ops.number?(e)) || ((first in String) && (e in String))
      next if same
      Fail.runtime("type", line, col, "sort: cannot compare #{Values.type_name(first)} and #{Values.type_name(e)}")
    end
    keyed = Array[]
    Array.each_index(a) { |i| Array.push(keyed, [a[i], i]) }
    MiniArray.new(Array.map(Array.sort(keyed)) { |pair| pair[0] })
  end

  def contains(args, line, col)
    c = args[0]
    x = args[1]
    case c
    in MiniArray | MiniMap then Ops.member?(x, c, line, col)
    in String then String.include?(c, want_string("contains", args, 2, line, col))
    else type_error("contains", 1, "an array, map or string", c, line, col)
    end
  end

  def extreme(name, args, line, col)
    best = want_number(name, args, 1, line, col)
    Integer.upto(2, Array.size(args)) do |n|
      v = want_number(name, args, n, line, col)
      best = v if (name == "min" && v < best) || (name == "max" && v > best)
    end
    best
  end

  # map and filter call f with one argument, over a snapshot of the array.
  def map_or_filter(vm, name, args, line, col)
    a = Array.dup(want_array(name, args, 1, line, col))
    f = want_function(name, args, 2, line, col)
    if name == "map"
      MiniArray.new(Array.map(a) { |e| Interp.call_value(vm, f, Array[e], line, col) })
    else
      MiniArray.new(Array.select(a) { |e| Values.truthy?(Interp.call_value(vm, f, Array[e], line, col)) })
    end
  end
end
