# Ruby-style option parsing: each option's handler block is stored and called by parse.
class Option
  attr_reader short, long, arg, handler
end
class Parser
  attr_reader options, banner
  def on(op, short, long, arg, &blk)
    Array.push(@options, Option.new(short, long, arg, blk))
    op
  end

  def find(op, name) = Array.find(@options) { |o| o.Option.short == name || o.Option.long == name }

  def parse(op, argv)
    rest = Array[]
    i = 0
    while i < Array.size(argv)
      a = argv[i]
      o = String.start_with?(a, "-") ? find(op, a) : nil
      if o == nil
        Array.push(rest, a)
      elsif o.Option.arg
        i += 1
        Proc.call(o.Option.handler, argv[i])
      else
        Proc.call(o.Option.handler, true)
      end
      i += 1
    end
    rest
  end
end

opts = {verbose: false, count: 1, output: "-", tags: Array[], level: :info}
verbose = false
count = 1
output = "-"
tags = String[]
level = :info
op = Parser.new(Array[], "usage: prog [options]")
Parser.on(op, "-v", "--verbose", false) { |v| verbose = v }
Parser.on(op, "-n", "--count", true) { |v| count = Integer(v) }
Parser.on(op, "-o", "--output", true) { |v| output = v }
Parser.on(op, "-t", "--tag", true) { |v| Array.push(tags, v) }
Parser.on(op, "-l", "--level", true) { |v| level = String.to_sym(v) }
rest = Parser.parse(op, Array["-v", "-n", "3", "--tag", "a", "-t", "b", "file1", "-l", "debug", "-o", "out.txt"])
p verbose
p count
p output
p tags
p level
p rest
p Integer.*(count, 2)
p String.upcase(output)
