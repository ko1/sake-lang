# Values as text (SPEC section 8.1): `str` for print, join and interpolation,
# `repr` for everything else.

module Text
  module_function

  def str(v) = (v in String) ? v : repr(v, 0)

  # level counts the containers entered; a value at level 101 is written "...".
  def repr(v, level)
    return "..." if level > 100
    case v
    in Integer then Integer.to_s(v)
    in Float then float_text(v)
    in String then quote(v)
    in true then "true"
    in false then "false"
    in nil then "nil"
    in MiniArray then "[#{Array.join(Array.map(MiniArray.items(v)) { |e| repr(e, level + 1) }, ", ")}]"
    in MiniMap
      entries = Hash.map(MiniMap.entries(v)) { |k, e| "#{repr(k, level + 1)}: #{repr(e, level + 1)}" }
      "{#{Array.join(entries, ", ")}}"
    in Closure
      name = FnLit.name(Closure.fn(v))
      name == "" ? "<fn>" : "<fn #{name}>"
    in Builtin then "<builtin #{Builtin.name(v)}>"
    end
  end

  # The fewest digits that read back (Float.to_s), laid out by the rules of SPEC 8.1.
  def float_text(v)
    s = Float.to_s(v)
    sign = String.start_with?(s, "-") ? "-" : ""
    body = String.delete_prefix(s, "-")
    ex = 0
    if String.include?(body, "e")
      pieces = String.split(body, "e")
      body = pieces[0]
      ex = String.to_i(pieces[1])
    end
    halves = String.split(body, ".")
    int_part = halves[0]
    all = int_part + (halves[1] || "")
    first = String.index(all, /[1-9]/)
    return "#{sign}0.0" unless first
    digits = String.sub(String.delete_prefix(all, String.slice(all, 0, first) || ""), /0+\z/, "")
    e = String.length(int_part) - 1 - first + ex
    n = String.length(digits)
    if e < -4 || e >= 16 || (e >= 15 && n <= e + 1)
      rest = String.slice(digits, 1, n - 1) || ""
      rest = "0" if rest == ""
      esign = e < 0 ? "-" : "+"
      mag = String.rjust(Integer.to_s(Integer.abs(e)), 2, "0")
      "#{sign}#{String.slice(digits, 0, 1)}.#{rest}e#{esign}#{mag}"
    elsif e >= 0
      if n <= e + 1
        zeros = "0" * (e + 1 - n)
        "#{sign}#{digits}#{zeros}.0"
      else
        "#{sign}#{String.slice(digits, 0, e + 1)}.#{String.slice(digits, e + 1, n - e - 1)}"
      end
    else
      zeros = "0" * (-e - 1)
      "#{sign}0.#{zeros}#{digits}"
    end
  end

  def quote_escapes = once { Hash["\\" => "\\\\", "\"" => "\\\"", "{" => "\\{", "\n" => "\\n", "\t" => "\\t"] }

  def quote(s) = "\"#{String.gsub(s, /[\\"{\n\t]/, quote_escapes)}\""
end
