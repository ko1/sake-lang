def words_of(line) = Array.reject(String.split(line, /[ \t]+/)) { |w| String.empty?(w) }

def pieces(word, w)
  out = Any[]
  rest = word
  while String.size(rest) > w
    Array.push(out, String.slice(rest, 0, w - 1) + "-")
    rest = String.slice(rest, w - 1, String.size(rest) - (w - 1))
  end
  Array.push(out, rest)
  out
end

def justify(ws, w)
  return Array.join(ws, " ") if Array.size(ws) == 1
  total = Array.sum(Array.map(ws) { |x| String.size(x) })
  gaps = Array.size(ws) - 1
  spaces = w - total
  base = spaces / gaps
  extra = spaces % gaps
  out = ""
  Array.each_with_index(ws) do |x, i|
    out += x
    if i < gaps
      out += String.*(" ", base + (i < extra ? 1 : 0))
    end
  end
  out
end

lines = String.split(IO.read(IO.stdin), "\n")
m = lines[0] == nil ? nil : String.match(lines[0], /\A *(\d+) *\z/)
w = m == nil ? 0 : String.to_i(MatchData.captures(m)[0])
if m == nil || w < 2 || w > 80
  puts("invalid width")
  exit
end
paras = Any[]
cur = Any[]
nwords = 0
Array.each(Array.drop(lines, 1)) do |l|
  ws = words_of(l)
  if Array.empty?(ws)
    if !Array.empty?(cur)
      Array.push(paras, cur)
      cur = Any[]
    end
  else
    nwords += Array.size(ws)
    Array.concat(cur, ws)
  end
end
Array.push(paras, cur) unless Array.empty?(cur)
border = "+" + String.*("-", w) + "+"
puts(border)
nlines = 0
Array.each_with_index(paras) do |para, pi|
  puts("|" + String.*(" ", w) + "|") if pi > 0
  ps = Array.flat_map(para) { |x| pieces(x, w) }
  rows = Any[]
  curw = Any[]
  curlen = 0
  Array.each(ps) do |x|
    if Array.empty?(curw)
      curw = Any[x]
      curlen = String.size(x)
    elsif curlen + 1 + String.size(x) <= w
      Array.push(curw, x)
      curlen += 1 + String.size(x)
    else
      Array.push(rows, curw)
      curw = Any[x]
      curlen = String.size(x)
    end
  end
  Array.push(rows, curw)
  Array.each_with_index(rows) do |r, ri|
    txt = ri == Array.size(rows) - 1 ? Array.join(r, " ") : justify(r, w)
    puts("|" + String.ljust(txt, w) + "|")
    nlines += 1
  end
end
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{nwords}")
