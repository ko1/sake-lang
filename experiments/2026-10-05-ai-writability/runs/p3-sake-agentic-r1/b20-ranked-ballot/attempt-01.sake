def pct(v, active)
  return "0.0%" if active == 0
  q = (2000 * v + active) / (2 * active)
  "#{q / 10}.#{q % 10}%"
end

lines = Array.map(IO.readlines(IO.stdin())) { String.chomp(it) }
cands = String[]
if lines[0] != nil
  Array.each(String.split(lines[0])) { |c| Array.push(cands, c) unless Array.include?(cands, c) }
end
if Array.empty?(cands)
  puts("no candidates")
  exit(0)
end

ballots = Array[]
rejected = 0
Array.each_with_index(lines) do |line, i|
  next if i == 0
  next if String.strip(line) == ""
  ranks = Array.map(String.split(line, ">", -1)) { String.strip(it) }
  seen = String[]
  reason = nil
  Array.each(ranks) do |r|
    if reason == nil
      if r == ""
        reason = "empty rank"
      elsif !Array.include?(cands, r)
        reason = "unknown candidate #{r}"
      elsif Array.include?(seen, r)
        reason = "duplicate #{r}"
      else
        Array.push(seen, r)
      end
    end
  end
  if reason == nil
    Array.push(ballots, ranks)
  else
    rejected += 1
    puts("rejected line #{i + 1}: #{reason}")
  end
end
nb = Array.size(ballots)
puts("ballots: #{nb} valid, #{rejected} rejected")

elim = Hash[]
hist = Array[]
round = 0
done = false
while !done
  round += 1
  votes = Hash[]
  Array.each(cands) { |c| votes[c] = 0 unless elim[c] }
  exhausted = 0
  Array.each(ballots) do |b|
    pick = Array.find(b) { |c| elim[c] == nil }
    if pick == nil
      exhausted += 1
    else
      votes[pick] += 1
    end
  end
  active = nb - exhausted
  Array.push(hist, votes)
  puts("round #{round}")
  live = Array.sort_by(Hash.keys(votes)) { |c| [-votes[c], c] }
  Array.each(live) { |c| puts("  #{c} #{votes[c]} #{pct(votes[c], active)}") }
  puts("  exhausted #{exhausted}")
  if active == 0
    puts("no winner")
    done = true
  else
    win = Array.find(live) { |c| votes[c] * 2 > active }
    if win != nil
      puts("winner #{win}")
      done = true
    else
      lo = Array.min(Array.map(live) { |c| votes[c] })
      tied = Array.select(live) { |c| votes[c] == lo }
      r = round - 2
      while Array.size(tied) > 1 && r >= 0
        m = Array.min(Array.map(tied) { |c| hist[r][c] })
        tied = Array.select(tied) { |c| hist[r][c] == m }
        r -= 1
      end
      victim = Array.max(tied)
      elim[victim] = true
      puts("  eliminated #{victim}")
    end
  end
end
