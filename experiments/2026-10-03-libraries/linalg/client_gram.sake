# Unusual use: exact Gram-Schmidt with Rational vectors, then a projection matrix,
# exercising the vector operators, indexing, and the rest of the API.
def gram_schmidt(vs)
  out = Vec[]
  Array.each(vs) do |v|
    w = Vec.exact(v)
    Array.each(out) { |u| w = w - u * ((w * u) / (u * u)) }
    Array.push(out, w)
  end
  out
end

basis = Vec[Vec.of(Array[1, 1, 0]), Vec.of(Array[1, 0, 1]), Vec.of(Array[0, 1, 1])]
ortho = gram_schmidt(basis)
Array.each_with_index(ortho) { |u, i| puts("u#{i} = #{u}") }
puts("u0.u1 = #{la_fmt(Array.fetch(ortho, 0) * Array.fetch(ortho, 1))}, u1.u2 = #{la_fmt(Array.fetch(ortho, 1) * Array.fetch(ortho, 2))}")

# Projection onto the plane spanned by u0 and u1: P = sum u u^T / (u.u)
p = Mat.exact(Mat.zero(3, 3))
Array.each(Array.take(ortho, 2)) do |u|
  n = u * u
  p = p + Mat.build(3, 3) { |i, j| u[i] * u[j] / n }
end
puts("P =")
puts(p)
puts("P*P == P: #{p * p == p}")
puts("P symmetric: #{Mat.transpose(p) == p}")
q = Mat.exact(Mat.identity(3)) - p
puts("rank-1 complement Q = I - P, det(P) = #{la_fmt(Mat.det(p))}, trace(Q) = #{la_fmt(q[0, 0] + q[1, 1] + q[2, 2])}")
v = Vec.of(Array[3, -1, 2])
pv = p * v
puts("v = #{v}, Pv = #{pv}, v - Pv = #{v - pv}, -v = #{-v}, v/2 = #{Vec.exact(v) / 2}")
v[0] = 10
puts("after v[0] = 10: #{v}, row 0 of P = #{Mat.row(p, 0)}, col 2 = #{Mat.col(p, 2)}, -P[0,0] = #{la_fmt(Mat.at(-p, 0, 0))}")
puts("zero vector: #{Vec.zero(3)}")
