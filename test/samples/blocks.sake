def each_pair(a)
  Array.each(a) { |x| yield([x, x * 2]) }
  nil
end

def find_first_even(a)
  Array.each(a) { |x| return x if Integer.even?(x) }
  -1
end

nums = Array[1, 3, 4, 5, 6]
each_pair(nums) { |x, y| puts(String.+(Integer.to_s(x), String.+(" ", Integer.to_s(y)))) }
puts(find_first_even(nums))
odds = Array.map(nums) { |x| next 0 if Integer.even?(x); x }
p(odds)
puts(Array.reduce(nums, 0) { |acc, x| acc + x })
Array.each_with_index(Array["a", "b"]) { |s, i| puts(String.+(s, Integer.to_s(i))) }
pairs = Array[[1, "one"], [2, "two"]]
Array.each(pairs) { |n, s| puts(s) }
i = 0
while true
  i += 1
  next if i == 2
  break if i > 3
  puts(i)
end
Integer.times(2) { puts("hi") }
p(Array.select(nums) { |x| x > 3 })
p(Array.sort(Array[3, 1, 2]))
puts(Array.join(Array[1, 2, 3], ","))
