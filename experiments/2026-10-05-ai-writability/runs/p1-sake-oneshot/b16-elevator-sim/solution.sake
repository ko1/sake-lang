def tokens(line) = String.split(String.strip(line), /\s+/)

def all_digits?(toks) = Array.all?(toks) { |s| String.match?(s, /\A\d+\z/) }

def simulate(pt, pf, pg, d, c)
  m = Array.size(pt)
  st = Array.new(m, 0)
  pick = Array.new(m, 0)
  drop = Array.new(m, 0)
  t = 0
  f = 1
  dir = 0
  left = m
  last = 0
  while left > 0
    i = 0
    while i < m
      st[i] = 1 if st[i] == 0 && pt[i] <= t
      i += 1
    end
    changed = false
    i = 0
    while i < m
      if st[i] == 2 && pg[i] == f
        puts("t=#{t} floor #{f} drop P#{i + 1}")
        st[i] = 3
        drop[i] = t
        left -= 1
        last = t
        changed = true
      end
      i += 1
    end
    above = false
    below = false
    has = false
    nearest = 0
    nd = 1000000
    i = 0
    while i < m
      tg = nil
      tg = pg[i] if st[i] == 2
      tg = pf[i] if st[i] == 1
      if tg
        has = true
        above = true if tg > f
        below = true if tg < f
        dist = Integer.abs(tg - f)
        if dist < nd || (dist == nd && tg < nearest)
          nd = dist
          nearest = tg
        end
      end
      i += 1
    end
    if dir == 1
      if !above
        dir = below ? -1 : 0
      end
    elsif dir == -1
      if !below
        dir = above ? 1 : 0
      end
    end
    if dir == 0 && has
      if nearest > f
        dir = 1
      elsif nearest < f
        dir = -1
      else
        i = 0
        while i < m
          if st[i] == 1 && pf[i] == f
            dir = pg[i] > f ? 1 : -1
            break
          end
          i += 1
        end
      end
    end
    riding = 0
    i = 0
    while i < m
      riding += 1 if st[i] == 2
      i += 1
    end
    if dir != 0
      i = 0
      while i < m
        if st[i] == 1 && pf[i] == f && riding < c
          pd = pg[i] > f ? 1 : -1
          if pd == dir
            puts("t=#{t} floor #{f} pick P#{i + 1}")
            st[i] = 2
            pick[i] = t
            riding += 1
            changed = true
          end
        end
        i += 1
      end
    end
    if changed
      t += d
    else
      f += dir
      t += 1
    end
  end
  sw = 0
  sr = 0
  i = 0
  while i < m
    w = pick[i] - pt[i]
    r = drop[i] - pick[i]
    puts("P#{i + 1} wait #{w} ride #{r}")
    sw += w
    sr += r
    i += 1
  end
  puts(format("average wait %.2f ride %.2f", Integer.fdiv(sw, m), Integer.fdiv(sr, m)))
  puts("done at t=#{last}")
end

def solve_main
  lines = IO.readlines(IO.stdin)
  if Array.empty?(lines)
    puts("invalid header")
    return
  end
  htoks = tokens(String.chomp(lines[0]))
  if Array.size(htoks) != 3 || !all_digits?(htoks)
    puts("invalid header")
    return
  end
  hn = Array.map(htoks) { String.to_i(it) }
  n, d, c = hn
  if n < 2 || n > 50 || d > 5 || c < 1 || c > 20
    puts("invalid header")
    return
  end
  pt = Integer[]
  pf = Integer[]
  pg = Integer[]
  prev = 0
  k = 1
  while k < Array.size(lines)
    toks = tokens(String.chomp(lines[k]))
    if !Array.empty?(toks)
      valid = false
      if Array.size(toks) == 3 && all_digits?(toks)
        rq = Array.map(toks) { String.to_i(it) }
        rt, rf, rg = rq
        if rf >= 1 && rf <= n && rg >= 1 && rg <= n && rf != rg && rt <= 1000 && rt >= prev
          valid = true
          Array.push(pt, rt)
          Array.push(pf, rf)
          Array.push(pg, rg)
          prev = rt
        end
      end
      puts("line #{k + 1}: invalid request") unless valid
    end
    k += 1
  end
  if Array.empty?(pt)
    puts("no passengers")
    return
  end
  simulate(pt, pf, pg, d, c)
end

solve_main
