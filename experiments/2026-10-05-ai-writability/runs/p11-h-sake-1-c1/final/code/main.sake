# A small SQL engine (a subset of SQLite): reads a script on standard input, runs it, prints results.
#
#   sql_error  - the engine's single error type
#   lexer      - script text -> tokens
#   ast        - the syntax tree node types
#   parser / expression_parser / window_parser - tokens of one statement -> a statement node
#   value      - the value model: printing, order, truth, arithmetic
#   collations - collating sequences (COLLATE): TEXT comparison, and the collation of an expression
#   coercion   - storing into typed columns, comparison affinity
#   database   - tables, columns, rows
#   scope      - what names mean while an expression is resolved (sources, enclosing queries)
#   names      - column lookup: bare and qualified names, aliases, enclosing queries
#   resolver   - binds names in an expression; plans subqueries; reports unknown names and functions
#   functions / text_functions / rounding - scalar SQL functions
#   like_pattern - LIKE matching
#   constraints - the checks a row passes before it is stored
#   evaluator  - evaluates a resolved expression on a row
#   sorter     - ORDER BY
#   expr_key   - text keys that tell identical expressions apart
#   aggregates - aggregate functions over the rows of a group
#   grouping   - GROUP BY: rows -> group rows (HAVING applied)
#   plan       - the data types of a planned SELECT
#   from_planner - plans FROM: sources, joins, ON / USING
#   planner    - resolves a SELECT's clauses into a Plan (all name errors are found here)
#   window_planner - plans window calls (OVER, WINDOW, frames); window_functions - the functions' names and values
#   windowing / window_frames - execute the windows of a select (partitions, peers, frames)
#   joiner     - executes FROM: the rows of the joined sources
#   query_planner / cte_planner - plans compound selects and WITH (a simple select: planner)
#   compound / recursion - execute compound selects and recursive ctes
#   ddl / views / indexes / alter - CREATE/DROP TABLE, VIEW, INDEX and ALTER TABLE
#   dml        - INSERT (VALUES or SELECT), UPDATE, DELETE
#   query      - runs a query plan
#   transactions - BEGIN / COMMIT / ROLLBACK (the snapshot is kept by database)
#   executor   - dispatches a statement to ddl / views / indexes / alter / dml / query / transactions
#   script     - splits the input into statements and reports errors
require "sql_error"
require "lexer"
require "ast"
require "parser"
require "expression_parser"
require "window_parser"
require "value"
require "collations"
require "coercion"
require "database"
require "scope"
require "names"
require "resolver"
require "functions"
require "text_functions"
require "rounding"
require "like_pattern"
require "constraints"
require "evaluator"
require "sorter"
require "expr_key"
require "aggregates"
require "grouping"
require "plan"
require "from_planner"
require "window_functions"
require "window_frames"
require "windowing"
require "window_planner"
require "planner"
require "joiner"
require "query_planner"
require "cte_planner"
require "ddl"
require "views"
require "indexes"
require "alter"
require "transactions"
require "dml"
require "compound"
require "recursion"
require "query"
require "executor"
require "script"

Script.run(IO.read(IO.stdin))
