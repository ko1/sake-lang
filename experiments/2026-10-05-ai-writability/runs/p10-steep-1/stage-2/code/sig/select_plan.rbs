module Sql
  class SelectPlan
    attr_reader results: Array[Ast::Expr]
    attr_reader where: Ast::Expr?
    attr_reader order_by: Array[Ast::OrderTerm]
    attr_reader limit: Ast::Expr?
    attr_reader offset: Ast::Expr?

    def self.build: (Ast::Select select, Table? table) -> SelectPlan
    def self.plan_term: (Ast::OrderTerm term, Integer index, Array[Ast::Expr] results, Hash[String, Ast::Expr] aliases, Resolver scope) -> Ast::OrderTerm
    def self.literal_position: (Ast::Expr expr) -> Integer?
    def self.ordinal: (Integer n) -> String
    def initialize: (Array[Ast::Expr] results, Ast::Expr? where, Array[Ast::OrderTerm] order_by, Ast::Expr? limit, Ast::Expr? offset) -> void
  end
end
