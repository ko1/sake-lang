# Values as text (SPEC 8.1): `str` for print, join and interpolation; `repr` for the rest.

def to_str(v) = (v in String) ? v : repr(v)

def repr(v)
  out = String[]
  write_repr(out, v, 0)
  Array.join(out, "")
end

# Appends the repr of v, which is `level` levels inside the value being written, to out.
def write_repr(out, v, level)
  if level > max_nesting
    Array.push(out, "...")
    return
  end
  case v
  in Integer then Array.push(out, Integer.to_s(v))
  in String then Array.push(out, quote(v))
  in true then Array.push(out, "true")
  in false then Array.push(out, "false")
  in nil then Array.push(out, "nil")
  in Array
    Array.push(out, "[")
    Array.each_with_index(v) do |x, i|
      Array.push(out, ", ") if i > 0
      write_repr(out, x, level + 1)
    end
    Array.push(out, "]")
  in Hash
    Array.push(out, "{")
    first = true
    Hash.each(v) do |k, x|
      Array.push(out, ", ") unless first
      first = false
      write_repr(out, k, level + 1)
      Array.push(out, ": ")
      write_repr(out, x, level + 1)
    end
    Array.push(out, "}")
  in Closure
    name = FnDef.name(Closure.fn(v))
    Array.push(out, name ? "<fn #{name}>" : "<fn>")
  in Builtin then Array.push(out, "<builtin #{Builtin.name(v)}>")
  else raise InternalError.new("not a Mini value")
  end
end

# A string in double quotes, with \ " { newline and tab escaped.
def quote(s)
  out = String["\""]
  String.each_char(s) do |c|
    Array.push(out, quote_char(c))
  end
  Array.push(out, "\"")
  Array.join(out, "")
end

def quote_char(c)
  case c
  in "\\" then "\\\\"
  in "\"" then "\\\""
  in "{" then "\\{"
  in "\n" then "\\n"
  in "\t" then "\\t"
  else c
  end
end
