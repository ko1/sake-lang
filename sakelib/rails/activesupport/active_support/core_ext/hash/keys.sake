# Port of activesupport-8.1.3/lib/active_support/core_ext/hash/keys.rb and hash/deep_transform_values.rb (Sake needs them together)

require "../array/access"

class Hash
  # Ruby: `Symbol === k ? k.name : k.to_s`
  def stringify_key(k) = (k in Symbol) ? Symbol.name(k) : Kernel.to_s(k)
  # Ruby: `key.to_sym rescue key`
  def symbolize_key(k) = (k in String) ? String.to_sym(k) : k

  def stringify_keys(h) = Hash.transform_keys(h) { |k| Hash.stringify_key(k) }
  def stringify_keys!(h) = Hash.transform_keys!(h) { |k| Hash.stringify_key(k) }
  def symbolize_keys(h) = Hash.transform_keys(h) { |k| Hash.symbolize_key(k) }
  def to_options(h) = Hash.symbolize_keys(h)
  def symbolize_keys!(h) = Hash.transform_keys!(h) { |k| Hash.symbolize_key(k) }
  def to_options!(h) = Hash.symbolize_keys!(h)

  def assert_valid_keys(h, *valid_keys)
    valid = Array.flatten1(valid_keys)
    Hash.each_key(h) do |k|
      unless Array.include?(valid, k)
        raise ArgumentError, "Unknown key: #{Kernel.inspect(k)}. Valid keys are: #{Array.map(valid) { |v| Kernel.inspect(v) }.join(", ")}"
      end
    end
    h
  end

  def deep_transform_keys(h, &block) = Hash.deep_transform_keys_in_object(h, &block)

  def deep_stringify_keys(h) = Hash.deep_transform_keys(h) { |k| Hash.stringify_key(k) }
  def deep_symbolize_keys(h) = Hash.deep_transform_keys(h) { |k| Hash.symbolize_key(k) }

  # private
  def deep_transform_keys_in_object(object, &block)
    case object
    in Hash
      Hash.each_with_object(object, Hash.new) do |(key, value), result|
        result[yield(key)] = Hash.deep_transform_keys_in_object(value, &block)
      end
    in Array then Array.map(object) { |e| Hash.deep_transform_keys_in_object(e, &block) }
    else object
    end
  end

  # deep_transform_values.rb
  def deep_transform_values(h, &block) = Hash.deep_transform_values_in_object(h, &block)

  def deep_transform_values_in_object(object, &block)
    case object
    in Hash then Hash.transform_values(object) { |value| Hash.deep_transform_values_in_object(value, &block) }
    in Array then Array.map(object) { |e| Hash.deep_transform_values_in_object(e, &block) }
    else yield(object)
    end
  end
end
