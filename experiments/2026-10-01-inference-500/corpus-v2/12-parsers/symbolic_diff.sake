Num = Struct.new(:value)
Var = Struct.new(:name)
Bin = Struct.new(:op, :left, :right)
Fn = Struct.new(:name, :arg)
ParseError = Exception.new(:pos)
Parser = Struct.new(:tokens, :pos)

class Parser
  def peek(ps) = @tokens[@pos]

  def advance(ps)
    t = @tokens[@pos]
    @pos += 1
    t
  end

  def expect(ps, t)
    raise ParseError.new("expected #{t}", @pos) unless peek(ps) == t
    advance(ps)
  end

  def expr(ps)
    e = term(ps)
    while peek(ps) == "+" || peek(ps) == "-"
      op = advance(ps)
      e = Bin.new(op, e, term(ps))
    end
    e
  end

  def term(ps)
    e = unary(ps)
    while peek(ps) == "*" || peek(ps) == "/"
      op = advance(ps)
      e = Bin.new(op, e, unary(ps))
    end
    e
  end

  def unary(ps)
    if peek(ps) == "-"
      advance(ps)
      return Bin.new("*", Num.new(-1), unary(ps))
    end
    power(ps)
  end

  def power(ps)
    base = primary(ps)
    if peek(ps) == "^"
      advance(ps)
      return Bin.new("^", base, unary(ps))
    end
    base
  end

  def primary(ps)
    t = advance(ps)
    raise ParseError.new("unexpected end", @pos) if t == nil
    if t == "("
      e = expr(ps)
      expect(ps, ")")
      e
    elsif String.match?(t, /\A\d+\z/)
      Num.new(String.to_i(t))
    elsif String.match?(t, /\A\d+\.\d+\z/)
      Num.new(String.to_f(t))
    elsif Array.include?(Array["sin", "cos", "exp", "ln"], t)
      expect(ps, "(")
      e = expr(ps)
      expect(ps, ")")
      Fn.new(t, e)
    elsif String.match?(t, /\A[a-z]\z/)
      Var.new(t)
    else
      raise ParseError.new("unexpected '#{t}'", @pos - 1)
    end
  end
end

def parse(src)
  ps = Parser.new(String.scan(src, /\d+\.\d+|\d+|[a-z]+|\S/), 0)
  e = Parser.expr(ps)
  raise ParseError.new("trailing '#{Parser.peek(ps)}'", Parser.get_pos(ps)) if Parser.peek(ps) != nil
  e
end

def num?(e, v) = (e in Num) && Num.get_value(e) == v

def add(a, b)
  return b if num?(a, 0)
  return a if num?(b, 0)
  return Num.new(Num.get_value(a) + Num.get_value(b)) if (a in Num) && (b in Num)
  Bin.new("+", a, b)
end

def sub(a, b)
  return a if num?(b, 0)
  return Num.new(Num.get_value(a) - Num.get_value(b)) if (a in Num) && (b in Num)
  Bin.new("-", a, b)
end

def mul(a, b)
  return Num.new(0) if num?(a, 0) || num?(b, 0)
  return b if num?(a, 1)
  return a if num?(b, 1)
  return Num.new(Num.get_value(a) * Num.get_value(b)) if (a in Num) && (b in Num)
  Bin.new("*", a, b)
end

def div(a, b)
  return a if num?(b, 1)
  return Num.new(0) if num?(a, 0)
  Bin.new("/", a, b)
end

def pow(a, b)
  return Num.new(1) if num?(b, 0)
  return a if num?(b, 1)
  Bin.new("^", a, b)
end

def derive(e, x)
  case e
  in Num then Num.new(0)
  in Var then Num.new(Var.get_name(e) == x ? 1 : 0)
  in Fn
    u = Fn.get_arg(e)
    du = derive(u, x)
    case Fn.get_name(e)
    in "sin" then mul(Fn.new("cos", u), du)
    in "cos" then mul(mul(Num.new(-1), Fn.new("sin", u)), du)
    in "exp" then mul(e, du)
    in "ln" then div(du, u)
    end
  in Bin
    l = Bin.get_left(e)
    r = Bin.get_right(e)
    dl = derive(l, x)
    dr = derive(r, x)
    case Bin.get_op(e)
    in "+" then add(dl, dr)
    in "-" then sub(dl, dr)
    in "*" then add(mul(dl, r), mul(l, dr))
    in "/" then div(sub(mul(dl, r), mul(l, dr)), pow(r, Num.new(2)))
    in "^"
      if r in Num
        mul(mul(r, pow(l, Num.new(Num.get_value(r) - 1))), dl)
      else
        mul(e, add(mul(dr, Fn.new("ln", l)), div(mul(r, dl), l)))
      end
    end
  end
end

def prec(op)
  case op
  in "+" | "-" then 1
  in "*" | "/" then 2
  in "^" then 3
  end
end

def show(e, outer)
  case e
  in Num
    v = Num.get_value(e)
    s = Kernel.to_s(v)
    v < 0 && outer > 0 ? "(#{s})" : s
  in Var then Var.get_name(e)
  in Fn then "#{Fn.get_name(e)}(#{show(Fn.get_arg(e), 0)})"
  in Bin
    op = Bin.get_op(e)
    p = prec(op)
    left = show(Bin.get_left(e), op == "^" ? p + 1 : p)
    right = show(Bin.get_right(e), op == "^" ? p : p + 1)
    s = op == "^" ? "#{left}^#{right}" : "#{left} #{op} #{right}"
    p < outer ? "(#{s})" : s
  end
end

def evaluate(e, env)
  case e
  in Num then Num.get_value(e)
  in Var then env[Var.get_name(e)]
  in Fn
    v = evaluate(Fn.get_arg(e), env)
    case Fn.get_name(e)
    in "sin" then Math.sin(v)
    in "cos" then Math.cos(v)
    in "exp" then Math.exp(v)
    in "ln" then Math.log(v)
    end
  in Bin
    a = evaluate(Bin.get_left(e), env)
    b = evaluate(Bin.get_right(e), env)
    case Bin.get_op(e)
    in "+" then a + b
    in "-" then a - b
    in "*" then a * b
    in "/" then a / b
    in "^" then a ** b
    end
  end
end

inputs = Array["x^3 + 2*x", "sin(x) * x", "exp(2*x) / x", "ln(x^2 + 1)", "3 * y + x * y",
               "-x^2", "x^x", "(1 + x) * (1 - x)", "cos(sin(x))", "2 * (x + ", "x $ 2", "sqrt(x)"]
x0 = 1.5
h = 0.000001
Array.each(inputs) do |src|
  begin
    f = parse(src)
    df = derive(f, "x")
    env = Hash["x" => x0, "y" => 2.0]
    exact = Float.round(evaluate(df, env), 4)
    numeric = Float.round((evaluate(f, Hash["x" => x0 + h, "y" => 2.0]) - evaluate(f, Hash["x" => x0 - h, "y" => 2.0])) / (2 * h), 4)
    puts("f(x)  = #{show(f, 0)}")
    puts("f'(x) = #{show(df, 0)}")
    puts("f'(#{x0}) = #{exact} (numeric #{numeric})#{Float.abs(exact - numeric) < 0.001 ? "" : " MISMATCH"}")
  rescue ParseError => e
    puts("#{src}: parse error at token #{ParseError.get_pos(e)}: #{Exception.message(e)}")
  end
end
