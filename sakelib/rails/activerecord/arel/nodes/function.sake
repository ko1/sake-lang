# Port of activerecord-8.1.3/lib/arel/nodes/function.rb, count.rb and named_function.rb (one file: Ruby's
# Function is the superclass of all three files' classes) (partial: no hash/eql?)
#
# Ruby's class Function is a module here. Ruby makes Sum, Exists, Max, Min and Avg with Class.new(Function).

module Arel
  module Nodes
    module Function
      include NodeExpression
      include Arel::WindowPredications
      include Arel::FilterPredications
      def expressions(f) = raise(NotImplementedError)
      def distinct(f) = raise(NotImplementedError)
    end

    class Sum
      attr_accessor expressions, distinct
      include Function
      def initialize(f) = @distinct ||= false
    end

    class Exists
      attr_accessor expressions, distinct
      include Function
      def initialize(f) = @distinct ||= false
    end

    class Max
      attr_accessor expressions, distinct
      include Function
      def initialize(f) = @distinct ||= false
    end

    class Min
      attr_accessor expressions, distinct
      include Function
      def initialize(f) = @distinct ||= false
    end

    class Avg
      attr_accessor expressions, distinct
      include Function
      def initialize(f) = @distinct ||= false
    end

    class Count
      attr_accessor expressions, distinct
      include Function
      def initialize(f) = @distinct ||= false
    end

    # Ruby: NamedFunction.new(name, expr); the fields are in Ruby's argument order.
    class NamedFunction
      attr_accessor name, expressions, distinct
      include Function
      def initialize(f) = @distinct ||= false
    end
  end
end
