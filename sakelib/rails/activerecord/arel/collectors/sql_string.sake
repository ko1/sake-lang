# Port of activerecord-8.1.3/lib/arel/collectors/sql_string.rb
#
# Ruby's SQLString < PlainString; here SQLString writes PlainString's three functions itself (they are three lines).

module Arel
  module Collectors
    class SQLString
      attr_reader str
      attr_accessor preparable, retryable
      private attr_accessor bind_index
      include Collector

      def initialize(c)
        @str ||= ""
        @bind_index = 1
      end

      def value(c) = @str

      def <<(c, s)
        @str += s
        c
      end

      def add_bind(c, bind)
        c << yield(@bind_index)
        @bind_index += 1
        c
      end

      def add_binds(c, binds, proc_for_binds = nil)
        last = @bind_index + Array.size(binds)
        c << Range.map(@bind_index...last) { |i| yield(i) }.Array.join(", ")
        @bind_index = last
        c
      end
    end
  end
end
