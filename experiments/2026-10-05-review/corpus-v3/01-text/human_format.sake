def delimit(n, sep)
  s = Integer.to_s(Integer.abs(n))
  groups = Array[]
  while String.size(s) > 3
    Array.unshift(groups, s[-3..])
    s = s[0...-3]
  end
  Array.unshift(groups, s)
  (n < 0 ? "-" : "") + Array.join(groups, sep)
end

def currency(amount, symbol)
  cents = Float.round(Float.abs(amount) * 100)
  whole, frac = Integer.divmod(cents, 100)
  body = "#{symbol}#{delimit(whole, ",")}.#{String.rjust(Integer.to_s(frac), 2, "0")}"
  amount < 0 ? "(#{body})" : body
end

def percent(part, total)
  return "n/a" if total == 0
  pct = part * 100.0 / total
  pct < 1 && pct > 0 ? "<1%" : "#{Float.round(pct, 1)}%"
end

def bytes(n, binary)
  base = binary ? 1024 : 1000
  units = binary ? Array["B", "KiB", "MiB", "GiB", "TiB"] : Array["B", "kB", "MB", "GB", "TB"]
  return "#{n} B" if n < base
  value = Integer.to_f(n)
  i = 0
  while value >= base && i < Array.size(units) - 1
    value /= base
    i += 1
  end
  digits = value >= 100 ? 0 : (value >= 10 ? 1 : 2)
  format("%.#{digits}f %s", value, units[i])
end

def duration(seconds)
  return "0s" if seconds == 0
  parts = Array[]
  rest = seconds
  Array.each(Array[[86_400, "d"], [3600, "h"], [60, "m"], [1, "s"]]) do |size, label|
    q, rest = Integer.divmod(rest, size)
    Array.push(parts, Array.empty?(parts) ? "#{q}#{label}" : "#{String.rjust(Integer.to_s(q), 2, "0")}#{label}") if q > 0 || !Array.empty?(parts)
  end
  Array.join(Array.take(parts, 2), " ")
end

def relative(delta)
  future = delta < 0
  secs = Integer.abs(delta)
  text = if secs < 45
    "a few seconds"
  elsif secs < 90
    "a minute"
  elsif secs < 45 * 60
    "#{Float.round(secs / 60.0)} minutes"
  elsif secs < 90 * 60
    "an hour"
  elsif secs < 22 * 3600
    "#{Float.round(secs / 3600.0)} hours"
  elsif secs < 36 * 3600
    "a day"
  elsif secs < 26 * 86_400
    "#{Float.round(secs / 86_400.0)} days"
  else
    "#{Float.round(secs / (30 * 86_400.0))} months"
  end
  future ? "in #{text}" : "#{text} ago"
end

def sig_figs(x, n)
  return "0" if x == 0
  mag = Float.floor(Math.log10(Float.abs(x)))
  decimals = n - 1 - mag
  if decimals > 0
    format("%.#{decimals}f", x)
  else
    factor = 10 ** -decimals
    delimit(Float.round(x / factor) * factor, ",")
  end
end

puts("== delimit")
Array.each(Integer[0, 999, 1000, 1_234_567, -9_876_543_210]) { |n| puts("  #{String.rjust(Integer.to_s(n), 12)} -> #{delimit(n, ",")} | #{delimit(n, " ")}") }
puts("== currency")
Array.each(Float[0.0, 5.5, 1234.567, -42.0, 1_000_000.004]) { |a| puts("  #{String.rjust(Float.to_s(a), 12)} -> #{currency(a, "$")}") }
puts("== percent")
Array.each(Array[[1, 3], [2, 1000], [0, 7], [7, 7], [5, 0]]) { |p, t| puts("  #{p}/#{t} -> #{percent(p, t)}") }
puts("== bytes")
Array.each(Integer[512, 1024, 1536, 1_000_000, 123_456_789, 5_000_000_000_000_000]) do |n|
  puts("  #{String.rjust(Integer.to_s(n), 16)} -> #{String.ljust(bytes(n, false), 10)} #{bytes(n, true)}")
end
puts("== duration")
Array.each(Integer[0, 59, 61, 3600, 3725, 86_399, 90_061, 1_000_000]) { |s| puts("  #{String.rjust(Integer.to_s(s), 8)}s -> #{duration(s)}") }
puts("== relative")
Array.each(Integer[10, 75, 600, 4000, 30_000, 100_000, 400_000, 5_000_000, -120, -200_000]) { |d| puts("  #{String.rjust(Integer.to_s(d), 8)} -> #{relative(d)}") }
puts("== significant figures")
Array.each(Float[3.14159, 0.000123456, 98765.4, 12.0]) { |x| puts("  #{x} -> #{sig_figs(x, 3)}") }
