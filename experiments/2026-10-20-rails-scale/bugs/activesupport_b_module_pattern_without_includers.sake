# `in M` for a module M that no type includes is a static error, so a library cannot match "an object of a
# type that includes M" unless the program happens to define one.
#   bin/sake --strict activesupport_b_module_pattern_without_includers.sake
#   → error: `in Filter`: no type includes Filter
# Ruby: `when Filter` is just false for every value. Expected: the branch is dead (or a warning), not an error.
# Workaround in sakelib/rails/activesupport/active_support/callbacks.sake: `else` instead of `in Filter`.
module Filter
  def match?(f, t) = raise(NotImplementedError)
end

def conditions(x)
  case x
  in Symbol then "a method name"
  in Filter then "a filter object"
  else "other"
  end
end

p(conditions(:published?))
