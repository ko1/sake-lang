# Port of actionpack-8.1.3/lib/action_dispatch/http/param_builder.rb (partial: no UploadedFile, no encoding templates, no deprecated ignore_leading_brackets)
#
# Rails builds HashWithIndifferentAccess params; here a Hash with String keys (what HashWithIndifferentAccess
# stores: `params[:id]` is `params["id"]`). `ParamBuilder.default` (a cattr_accessor) is the builder with
# param_depth_limit 100, and the class-level `from_query_string`/`from_pairs`/`from_hash` (delegated to it) are
# ParamBuilder.from_query_string(...) etc. on that default.

require "query_parser"
require "param_error"
require "../request/utils"

module ActionDispatch
  class ParamBuilder
    attr_reader param_depth_limit

    def make_default(param_depth_limit) = ParamBuilder.new(param_depth_limit)
    def default = once { make_default(100) }

    # Class-level delegation to the default builder (Rails: delegate ... to: :default)
    def from_query_string(qs, separator: nil, encoding_template: nil)
      build_from_query_string(default, qs, separator: separator)
    end
    def from_pairs(pairs, encoding_template: nil) = build_from_pairs(default, pairs)
    def from_hash(hash, encoding_template: nil) = Request::Utils.normalize_encode_params(hash)

    def build_from_query_string(b, qs, separator: nil)
      build_from_pairs(b, QueryParser.pairs(qs, separator))
    end

    def build_from_pairs(b, pairs)
      params = make_params
      Array.each(pairs) { |k, v| store_nested_param(b, params, k, v, 0) }
      params
    rescue ArgumentError => e
      raise InvalidParameterError, Exception.message(e)
    end

    def store_nested_param(b, params, name, v, depth)
      raise ParamsTooDeepError, "ActionDispatch::ParamsTooDeepError" if depth >= @param_depth_limit   # Rails' message is the class name

      k = ""
      after = ""
      if name == nil
        k = ""
      elsif depth == 0
        start = String.index(name, "[", 1)
        if start
          k = String.[](name, 0, start) || ""
          after = String.[](name, start, String.length(name)) || ""
        else
          k = name
        end
      elsif String.start_with?(name, "[]")
        k = "[]"
        after = String.[](name, 2, String.length(name)) || ""
      elsif String.start_with?(name, "[") && (start = String.index(name, "]", 1))
        k = String.[](name, 1, start - 1) || ""
        after = String.[](name, start + 1, String.length(name)) || ""
      else
        k = name
      end

      return nil if String.empty?(k)

      raise InvalidParameterError, "Invalid encoding for parameter: #{k}" unless String.valid_encoding?(k)
      if depth == 0 && (v in String) && !String.valid_encoding?(v)
        raise InvalidParameterError, "Invalid encoding for parameter: #{String.scrub(v)}"
      end

      if after == ""
        if k == "[]" && depth != 0
          return v ? Any[v] : Any[]                        # perform_deep_munge
        else
          params[k] = v
        end
      elsif after == "["
        params[name || ""] = v
      elsif after == "[]"
        list = params[k] ||= Any[]
        raise ParameterTypeError, "expected Array (got #{class_name(list)}) for param `#{k}'" unless list in Array
        Array.push(list, v) if v
      elsif String.start_with?(after, "[]")
        # Recognize x[][y] (hash inside array) parameters
        child_key = String.[](after, 3, String.length(after) - 4)
        unless after[2] == "[" && String.end_with?(after, "]") && child_key && !String.empty?(child_key) && !String.include?(child_key, "[") && !String.include?(child_key, "]")
          # Handle other nested array parameters
          child_key = String.[](after, 2, String.length(after))
        end
        ck = child_key || ""
        list = params[k] ||= Any[]
        raise ParameterTypeError, "expected Array (got #{class_name(list)}) for param `#{k}'" unless list in Array
        last = Array.last(list)
        if (last in Hash) && !params_hash_has_key?(last, ck)
          store_nested_param(b, last, ck, v, depth + 1)
        else
          Array.push(list, store_nested_param(b, make_params, ck, v, depth + 1))
        end
      else
        sub = params[k] ||= make_params
        raise ParameterTypeError, "expected Hash (got #{class_name(sub)}) for param `#{k}'" unless sub in Hash
        params[k] = store_nested_param(b, sub, after, v, depth + 1)
      end

      params
    end

    def make_params = Hash.new

    def class_name(x)
      case x
      in nil then "NilClass"
      in String then "String"
      in Array then "Array"
      in Hash then "ActiveSupport::HashWithIndifferentAccess"
      else "Object"
      end
    end

    def params_hash_has_key?(hash, key)
      return false if String.include?(key, "[]")
      h = hash
      Array.each(String.split(key, /[\[\]]+/)) do |part|
        next if part == ""
        return false unless (h in Hash) && Hash.key?(h, part)
        h = h[part]
      end
      true
    end
  end
end
