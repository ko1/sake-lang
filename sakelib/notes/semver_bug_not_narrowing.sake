# Status (2026-10-05): fixed.
# `if !x ... else` does not narrow x to non-nil in the else branch (`if x == nil` does).
# bin/sake --strict=2 -c: String.size: argument 1 may be nil (nil | String) [nil]
def f(a)
  last = Array.last(a)
  if !last
    0
  else
    String.size(last)
  end
end
p f(Array["ab"])
