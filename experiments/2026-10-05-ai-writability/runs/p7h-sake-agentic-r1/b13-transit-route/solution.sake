# Read input
input_lines = Array[]
Array.each(IO.readlines(IO.stdin())) { |line|
  input_lines.push(String.chomp(line))
}

# Parse penalty
penalty_str = String.strip(Array.at(input_lines, 0))
penalty = Kernel.Integer(penalty_str) rescue nil

if penalty == nil
  penalty = 0
end

# Parse segments
segments = Array[]  # Array of [line_name, from_station, to_station, minutes]
stations = Set[]
queries_index = nil
line_num = 1

Integer.upto(1, Integer.-(Array.length(input_lines), 1)) { |i|
  line = Array.at(input_lines, i)
  line_num = Integer.+(line_num, 1)

  if String.strip(line) == "QUERIES"
    queries_index = i
    break
  elsif String.empty?(String.strip(line))
    # Skip blank lines
  else
    fields = String.split(String.strip(line))
    if Array.length(fields) != 4
      puts("invalid segment at line #{line_num}")
    else
      line_name = Array.at(fields, 0)
      from_st = Array.at(fields, 1)
      to_st = Array.at(fields, 2)
      minutes_str = Array.at(fields, 3)

      # Validate
      minutes = Kernel.Integer(minutes_str) rescue nil
      if minutes == nil || minutes < 1 || minutes > 999 || from_st == to_st
        puts("invalid segment at line #{line_num}")
      else
        # Check for leading zeros
        if minutes_str != Kernel.to_s(minutes)
          puts("invalid segment at line #{line_num}")
        else
          Array.push(segments, Array[line_name, from_st, to_st, minutes])
          Set.add(stations, from_st)
          Set.add(stations, to_st)
        end
      end
    end
  end
}

# Parse queries
if queries_index == nil
  Kernel.exit(0)
end

Integer.upto(Integer.+(queries_index, 1), Integer.-(Array.length(input_lines), 1)) { |i|
  line = Array.at(input_lines, i)
  line_num = Integer.+(i, 1)

  if String.empty?(String.strip(line))
    # Skip blank lines
  else
    fields = String.split(String.strip(line))
    if Array.length(fields) != 2
      puts("invalid query at line #{line_num}")
    else
      from_station = Array.at(fields, 0)
      to_station = Array.at(fields, 1)

      # Check if stations are known
      if !Set.include?(stations, from_station)
        puts("#{from_station} -> #{to_station}: unknown station #{from_station}")
      elsif !Set.include?(stations, to_station)
        puts("#{from_station} -> #{to_station}: unknown station #{to_station}")
      elsif from_station == to_station
        puts("#{from_station} -> #{to_station}: 0 min, 0 transfers")
      else
        # Find shortest path using Dijkstra
        # We need to track: cost, transfers, station path, line path
        # State: (station, line_we_came_from)

        puts("#{from_station} -> #{to_station}: no route")
      end
    end
  end
}
