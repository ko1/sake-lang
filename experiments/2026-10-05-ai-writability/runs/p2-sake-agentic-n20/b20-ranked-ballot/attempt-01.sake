lines = String.split(IO.read(IO.stdin), "\n")
cands = Array.uniq(String.split(lines[0] == nil ? "" : lines[0], " "))
rej = Array[]
ballots = Array[]
Array.each_with_index(lines) do |raw, i|
  next if i == 0
  next if String.strip(raw) == ""
  ranks = Array.map(String.split(raw, ">", -1)) { |x| String.strip(x) }
  seen = Array[]
  reason = nil
  Array.each(ranks) do |nm|
    if nm == ""
      reason = "empty rank"
    elsif !Array.include?(cands, nm)
      reason = "unknown candidate #{nm}"
    elsif Array.include?(seen, nm)
      reason = "duplicate #{nm}"
    end
    break if reason
    Array.push(seen, nm)
  end
  if reason
    Array.push(rej, "rejected line #{i + 1}: #{reason}")
  else
    Array.push(ballots, ranks)
  end
end
if Array.empty?(cands)
  puts("no candidates")
  exit
end
puts(*rej) unless Array.empty?(rej)
puts("ballots: #{Array.size(ballots)} valid, #{Array.size(rej)} rejected")
alive = Array.dup(cands)
history = Array[]
k = 0
while true
  k += 1
  counts = Hash[]
  Array.each(alive) { |c| counts[c] = 0 }
  active = 0
  Array.each(ballots) do |b|
    pick = Array.find(b) { |c| Array.include?(alive, c) }
    if pick != nil
      counts[pick] += 1
      active += 1
    end
  end
  Array.push(history, counts)
  puts("round #{k}")
  order = Array.sort_by(alive) { |c| [-counts[c], c] }
  Array.each(order) do |c|
    t = active == 0 ? 0 : (counts[c] * 2000 + active) / (2 * active)
    puts("  #{c} #{counts[c]} #{t / 10}.#{t % 10}%")
  end
  puts("  exhausted #{Array.size(ballots) - active}")
  if active == 0
    puts("no winner")
    break
  end
  win = Array.find(alive) { |c| counts[c] * 2 > active }
  if win
    puts("winner #{win}")
    break
  end
  s = alive
  mn = Array.min(Array.map(s) { |c| counts[c] })
  s = Array.select(s) { |c| counts[c] == mn }
  r = k - 2
  while Array.size(s) > 1 && r >= 0
    hc = history[r]
    mn = Array.min(Array.map(s) { |c| hc[c] })
    s = Array.select(s) { |c| hc[c] == mn }
    r -= 1
  end
  out = Array.max(s)
  puts("  eliminated #{out}")
  alive = Array.reject(alive) { |c| c == out }
end
