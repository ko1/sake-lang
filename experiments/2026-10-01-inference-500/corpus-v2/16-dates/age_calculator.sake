# Exact ages in years, months and days, next-birthday countdowns (with
# Feb-29 birthdays), zodiac signs and a few roster statistics.

Person = Struct.new(:name, :year, :month, :day)

def leap?(y) = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0

def dim(y, m)
  return 29 if m == 2 && leap?(y)
  Array[31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1]
end

def ordinal(y, m, d)
  n = 0
  Range.each(1...m) { |mm| n += dim(y, mm) }
  n + d
end

def serial(y, m, d)
  yy = y - 1
  yy * 365 + yy / 4 - yy / 100 + yy / 400 + ordinal(y, m, d)
end

# Calendar difference with borrowing, as a Record.
def age_between(y1, m1, d1, y2, m2, d2)
  years = y2 - y1
  months = m2 - m1
  days = d2 - d1
  if days < 0
    months -= 1
    pm = m2 == 1 ? 12 : m2 - 1
    py = m2 == 1 ? y2 - 1 : y2
    days = Array.max(Array[dim(py, pm) - d1, 0]) + d2
  end
  if months < 0
    years -= 1
    months += 12
  end
  {years: years, months: months, days: days}
end

# A Feb-29 birthday is celebrated on Feb 28 in common years.
def birthday_in(p, y)
  m = Person.month(p)
  d = Person.day(p)
  d = 28 if m == 2 && d == 29 && !leap?(y)
  [m, d]
end

def next_birthday(p, y, m, d)
  today = serial(y, m, d)
  by = y
  bm, bd = birthday_in(p, by)
  if serial(by, bm, bd) < today
    by += 1
    bm, bd = birthday_in(p, by)
  end
  [by, serial(by, bm, bd) - today]
end

def zodiac(m, d)
  cutoffs = Array[[1, 20, "Capricorn"], [2, 19, "Aquarius"], [3, 21, "Pisces"], [4, 20, "Aries"],
                  [5, 21, "Taurus"], [6, 21, "Gemini"], [7, 23, "Cancer"], [8, 23, "Leo"],
                  [9, 23, "Virgo"], [10, 23, "Libra"], [11, 22, "Scorpio"], [12, 22, "Sagittarius"]]
  found = Array.find(cutoffs) { |cm, cd, name| cm == m }
  return "?" if found == nil
  cm, cd, name = found
  if d < cd
    name
  else
    i = Array.index(cutoffs, found)
    nxt = cutoffs[(i + 1) % 12]
    nxt == nil ? "?" : nxt[2]
  end
end

roster = Person[
  Person.new("Aiko", 1990, 5, 17),
  Person.new("Bram", 2000, 2, 29),
  Person.new("Chen", 1985, 10, 1),
  Person.new("Dana", 2012, 12, 31),
  Person.new("Emil", 1958, 3, 3),
  Person.new("Fay", 2026, 1, 15),
  Person.new("Gus", 1999, 10, 2)
]

ty = 2026
tm = 10
td = 1
puts("As of #{format("%04d-%02d-%02d", ty, tm, td)}:")
ages = Hash[]
Array.each(roster) do |p|
  age = age_between(Person.year(p), Person.month(p), Person.day(p), ty, tm, td)
  age => {years:, months:, days:}
  ages[Person.name(p)] = years
  ny, wait = next_birthday(p, ty, tm, td)
  turning = ny - Person.year(p)
  lived = serial(ty, tm, td) - serial(Person.year(p), Person.month(p), Person.day(p))
  sign = zodiac(Person.month(p), Person.day(p))
  note = wait == 0 ? "today!" : "in #{wait} days"
  puts(format("  %-5s %2dy %2dm %2dd  %6d days lived  %-11s turns %d %s", Person.name(p), years, months, days, lived, sign, turning, note))
end

puts
oldest = Array.min_by(roster) { |p| serial(Person.year(p), Person.month(p), Person.day(p)) }
youngest = Array.max_by(roster) { |p| serial(Person.year(p), Person.month(p), Person.day(p)) }
puts("Oldest: #{Person.name(oldest)}, youngest: #{Person.name(youngest)}") if oldest && youngest
adults = Array.select(roster) { |p| Hash.fetch(ages, Person.name(p)) >= 18 }
puts("Adults: #{Array.join(Array.map(adults) { |p| Person.name(p) }, ", ")}")
decades = Array.tally(Array.map(Hash.values(ages)) { |a| a / 10 * 10 })
Array.each(Array.sort(Hash.keys(decades))) { |dcd| puts(format("  %2ds: %d", dcd, decades[dcd])) }

# The leap-day birthday over a few years.
bram = Array.find(roster) { |p| Person.name(p) == "Bram" }
if bram
  parties = Range.map(2026..2032) do |y|
    m, d = birthday_in(bram, y)
    "#{y}-#{format("%02d-%02d", m, d)}"
  end
  puts("Bram celebrates: #{Array.join(parties, " ")}")
  real = Range.count(2001..2032) { |y| leap?(y) }
  puts("Real birthdays up to 2032: #{real}")
end

# Month-end edge cases for the borrowing rule.
cases = Array[[2026, 1, 31, 2026, 3, 1], [2024, 1, 31, 2024, 3, 1], [2026, 3, 31, 2026, 4, 30], [2025, 12, 31, 2026, 1, 1]]
Array.each(cases) do |y1, m1, d1, y2, m2, d2|
  r = age_between(y1, m1, d1, y2, m2, d2)
  r => {years:, months:, days:}
  puts(format("  %04d-%02d-%02d -> %04d-%02d-%02d: %dy %dm %dd", y1, m1, d1, y2, m2, d2, years, months, days))
end
