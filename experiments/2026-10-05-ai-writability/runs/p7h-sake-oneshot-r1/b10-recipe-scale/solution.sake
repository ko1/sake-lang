def parse_serves(line)
  parts = String.split(String.strip(line), /\s+/)
  if Array.size(parts) != 4 || Array.at(parts, 0) != "SERVES" || Array.at(parts, 2) != "->"
    nil
  else
    n_str = Array.at(parts, 1)
    m_str = Array.at(parts, 3)

    if !String.match?(n_str, /^[0-9]+$/) || !String.match?(m_str, /^[0-9]+$/)
      nil
    else
      n = String.to_i(n_str)
      m = String.to_i(m_str)
      if n >= 1 && n <= 100 && m >= 1 && m <= 100
        {n: n, m: m}
      else
        nil
      end
    end
  end
end

def valid_quantity?(s)
  String.match?(s, /^[0-9]+(\.[0-9]+)?$/) || String.match?(s, /^[0-9]+\/[0-9]+$/)
end

def valid_unit?(s)
  s == "tsp" || s == "tbsp" || s == "cup" || s == "g" || s == "kg" || s == "ml" || s == "l" || s == "-"
end

serves_line = gets
if serves_line == nil
  puts("line 1: error: bad servings")
else
  line_no = 1
  serves_info = parse_serves(serves_line)

  if serves_info == nil
    puts("line #{line_no}: error: bad servings")
  else
    n = serves_info[:n]
    m = serves_info[:m]
    factor = Float(m) / Float(n)

    puts("serves #{m} (x #{format('%.2f', factor)})")

    loop do
      line = gets
      break if line == nil
      line_no += 1

      if String.empty?(String.strip(line))
        next
      end

      if String.start_with?(String.strip(line), "#")
        next
      end

      parts = String.split(String.strip(line), /\s+/)
      if Array.size(parts) < 2
        puts("line #{line_no}: error: missing unit")
        next
      end

      qty_str = Array.at(parts, 0)
      unit = Array.at(parts, 1)
      name_parts = Array.drop(parts, 2)
      name = Array.join(name_parts, " ")

      if !valid_quantity?(qty_str)
        puts("line #{line_no}: error: bad quantity")
      elsif !valid_unit?(unit)
        puts("line #{line_no}: error: unknown unit #{unit}")
      elsif Array.size(name_parts) == 0
        puts("line #{line_no}: error: missing name")
      else
        puts("#{qty_str} #{unit} #{name}")
      end
    end
  end
end
