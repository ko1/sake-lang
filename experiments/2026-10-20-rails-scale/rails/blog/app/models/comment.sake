# Ruby (app/models/comment.rb):
#   class Comment < ApplicationRecord
#     belongs_to :post
#     validates :commenter, presence: true
#     validates :body, presence: true
#   end
class Comment
  # belongs_to :post
  def post(comment) = Post.find(@post_id)

  def validate(comment)
    # belongs_to's own check (Rails: "Post must exist")
    ActiveModel::Errors.add(@errors, :post, :required) if @post_id == nil || Post.find_by({id: @post_id}) == nil
    validates comment, :commenter, {presence: true}
    validates comment, :body, {presence: true}
  end
end
