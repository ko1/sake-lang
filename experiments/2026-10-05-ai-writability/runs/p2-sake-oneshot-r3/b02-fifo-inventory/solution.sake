def parse_money(s)
  m = String.match(s, /\A(\d+)(?:\.(\d{1,2}))?\z/)
  return nil unless m
  frac = m[2]
  f = frac ? String.to_i(String.ljust(frac, 2, "0")) : 0
  String.to_i(m[1]) * 100 + f
end

def money(c)
  sign = c < 0 ? "-" : ""
  a = Integer.abs(c)
  "#{sign}#{a / 100}.#{String.rjust(Integer.to_s(a % 100), 2, "0")}"
end

def report(inv)
  puts(format("%-12s %5s %10s", "SKU", "QTY", "VALUE"))
  tq = 0
  tv = 0
  Array.each(Array.sort(Hash.keys(inv))) do |sku|
    q = 0
    v = 0
    Array.each(inv[sku]) do |lot|
      q += lot[0]
      v += lot[0] * lot[1]
    end
    tq += q
    tv += v
    puts(format("%-12s %5d %10s", sku, q, money(v)))
  end
  puts(format("%-12s %5d %10s", "TOTAL", tq, money(tv)))
end

def handle(inv, tot, n, f)
  cmd = f[0]
  unless cmd == "RECEIVE" || cmd == "SHIP" || cmd == "REPORT"
    puts("line #{n}: error: unknown command #{cmd}")
    return
  end
  want = cmd == "REPORT" ? 1 : 4
  if Array.size(f) != want
    puts("line #{n}: error: wrong field count")
    return
  end
  if cmd == "REPORT"
    report(inv)
    return
  end
  sku = f[1]
  unless String.match?(sku, /\A[A-Z0-9-]{1,12}\z/)
    puts("line #{n}: error: bad sku")
    return
  end
  qs = f[2]
  unless String.match?(qs, /\A\d+\z/) && String.to_i(qs) >= 1 && String.to_i(qs) <= 1000000
    puts("line #{n}: error: bad quantity")
    return
  end
  qty = String.to_i(qs)
  price = parse_money(f[3])
  if price == nil
    puts("line #{n}: error: bad price")
    return
  end
  lots = inv[sku]
  if cmd == "RECEIVE"
    if lots == nil
      lots = Array[]
      inv[sku] = lots
    end
    Array.push(lots, Array[qty, price])
    return
  end
  if lots == nil
    puts("line #{n}: error: unknown sku #{sku}")
    return
  end
  have = 0
  Array.each(lots) { |lot| have += lot[0] }
  if have < qty
    puts("line #{n}: error: insufficient stock for #{sku} (have #{have}, need #{qty})")
    return
  end
  need = qty
  cost = 0
  while need > 0
    lot = lots[0]
    take = lot[0] < need ? lot[0] : need
    cost += take * lot[1]
    lot[0] -= take
    need -= take
    Array.shift(lots) if lot[0] == 0
  end
  rev = qty * price
  tot[0] += rev
  tot[1] += cost
  puts("line #{n}: shipped #{qty} #{sku}: revenue #{money(rev)}, cost #{money(cost)}")
end

inv = Hash[]
tot = Array[0, 0]
lines = IO.readlines(IO.stdin)
Array.each_with_index(lines) do |raw, i|
  f = String.split(String.chomp(raw), " ")
  next if Array.empty?(f)
  handle(inv, tot, i + 1, f)
end
puts("== final ==")
report(inv)
puts("revenue: #{money(tot[0])}")
puts("cost of goods sold: #{money(tot[1])}")
puts("gross profit: #{money(tot[0] - tot[1])}")
