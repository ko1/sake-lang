# The program `generate "generate"` (config/application.sake) runs before the app is checked: it draws the routes
# and prints the source Rails defines while it boots (Rails::Generate.application).
require "routes"
require "rails/railties/rails/generate/application"

set = ActionDispatch::Routing::RouteSet.make
ActionDispatch::Routing::RouteSet.draw(set) { |map| ActionDispatch::Routing::Mapper.application_routes(map) }
print(Rails::Generate.application(File.expand_path("..", __dir__), set))
