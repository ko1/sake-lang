# A chain step without a type continues with the type the chain names last: `T.g(x).f` is `T.g(x).T.f`.
class User
  attr_reader name, team, active
end
users = User[User.new("b", "x", true), User.new("c", "y", false), User.new("a", "x", true)]
p Array.select(users) { |u| User.active(u) }.map { |u| User.name(u) }.sort.first(5)
p String.strip("  ab ").upcase.reverse
# a step whose value has another type names it, and the steps after it continue with that type
counts = Array.group_by(users) { |u| User.team(u) }.Hash.transform_values { |ms| Array.size(ms) }
p Hash.sort_by(counts) { |t, n| -n }.Array.first
p User.new("d", "z", true).name
p Array.map(users) { |u| User.name(u) }.join(",").String.size
