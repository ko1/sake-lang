print(1 == 1.0, 1.0 == 1, 0 == -0.0, 0.1 + 0.2 == 0.3, 1.5 != 1.5, 2 != 2.0)
print([1, 2.0] == [1.0, 2], {"a": 1} == {"a": 1.0}, 1.0 == "1", 1.0 == true, 0.0 == nil)
print(1.0 in [3, 1], 2.5 in [2, 3], contains([0], -0.0), "1.5" in ["1.5"])
let m = {1: "one"}
print(1.0 in m, 1 in m, contains(m, 1.0))
match 3
  when 1.5, 3.0 then print("matched 3.0")
  else print("no match")
end
match 2.0
  when 2 then print("matched 2")
end
let n = {"k": 1.5}
print(n.k, n["k"] == 1.5)
print(m[1.0])
