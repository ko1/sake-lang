Entry = Struct.new(:key, :value, :prev, :next)

class LRUCache
  attr_reader capacity, index
  attr_accessor newest, oldest, hits, misses, evicted
  def create(capacity) = LRUCache.new(capacity, Hash[], nil, nil, 0, 0, Array[])

  def unlink(c, e)
    p = Entry.prev(e)
    n = Entry.next(e)
    if p
      Entry.set_next(p, n)
    else
      @newest = n
    end
    if n
      Entry.set_prev(n, p)
    else
      @oldest = p
    end
    Entry.set_prev(e, nil)
    Entry.set_next(e, nil)
  end

  def link_front(c, e)
    first = @newest
    Entry.set_next(e, first)
    Entry.set_prev(e, nil)
    if first
      Entry.set_prev(first, e)
    else
      @oldest = e
    end
    @newest = e
  end

  def get(c, key)
    e = @index[key]
    if e == nil
      @misses += 1
      return nil
    end
    @hits += 1
    unlink(c, e)
    link_front(c, e)
    Entry.value(e)
  end

  def put(c, key, value)
    e = @index[key]
    if e
      Entry.set_value(e, value)
      unlink(c, e)
      link_front(c, e)
      return c
    end
    if Hash.size(@index) >= @capacity
      victim = @oldest
      if victim
        unlink(c, victim)
        Hash.delete(@index, Entry.key(victim))
        Array.push(@evicted, Entry.key(victim))
      end
    end
    fresh = Entry.new(key, value, nil, nil)
    @index[key] = fresh
    link_front(c, fresh)
    c
  end

  def keys(c)
    out = Array[]
    e = @newest
    while e
      Array.push(out, Entry.key(e))
      e = Entry.next(e)
    end
    out
  end

  def hit_rate(c)
    total = @hits + @misses
    total == 0 ? 0.0 : @hits * 100.0 / total
  end
end

def slow_square(n, calls)
  calls[0] += 1
  total = 0
  Integer.times(n) { total += n }
  total
end

def cached_square(cache, n, calls)
  v = LRUCache.get(cache, n)
  return v if v
  v = slow_square(n, calls)
  LRUCache.put(cache, n, v)
  v
end

cache = LRUCache.create(3)
LRUCache.put(cache, "a", 1)
LRUCache.put(cache, "b", 2)
LRUCache.put(cache, "c", 3)
puts("order: #{Kernel.inspect(LRUCache.keys(cache))}")
puts("get a: #{LRUCache.get(cache, "a")}")
LRUCache.put(cache, "d", 4)
puts("after put d: #{Kernel.inspect(LRUCache.keys(cache))}")
puts("get b: #{Kernel.inspect(LRUCache.get(cache, "b"))}")
LRUCache.put(cache, "c", 30)
puts("after update c: #{Kernel.inspect(LRUCache.keys(cache))} c=#{LRUCache.get(cache, "c")}")
LRUCache.put(cache, "e", 5)
LRUCache.put(cache, "f", 6)
puts("final: #{Kernel.inspect(LRUCache.keys(cache))} evicted=#{Kernel.inspect(LRUCache.evicted(cache))}")
puts(format("hits=%d misses=%d rate=%.1f%%", LRUCache.hits(cache), LRUCache.misses(cache), LRUCache.hit_rate(cache)))

Array.each(Array[2, 4, 8]) do |size|
  memo = LRUCache.create(size)
  calls = [0]
  requests = Array[5, 7, 5, 9, 11, 5, 7, 13, 9, 5, 7, 11, 5, 15, 7, 5]
  results = Array.map(requests) { |n| cached_square(memo, n, calls) }
  puts(format("size %d: calls=%2d hit rate %5.1f%% sum=%d evicted=%s", size, calls[0], LRUCache.hit_rate(memo), Array.sum(results), Array.join(LRUCache.evicted(memo), ",")))
end

pages = LRUCache.create(2)
Array.each(Array[[:home, "<h1>Home</h1>"], [:about, "<p>About</p>"], [:home, "<h1>Home v2</h1>"], [:blog, "<ul></ul>"]]) do |route, html|
  LRUCache.put(pages, route, html)
end
Array.each(Array[:home, :about, :blog]) do |route|
  html = LRUCache.get(pages, route)
  puts("#{route}: #{html || "(evicted)"}")
end
