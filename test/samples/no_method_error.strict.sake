# NoMethodError is a built-in exception type: raised by `raise`, rescued by name, a parent for a program's classes.
class DelegationError < NoMethodError
end
def call(name)
  raise NoMethodError, "undefined method '#{name}' for nil" if name == "missing"
  raise DelegationError, "delegated to nil" if name == "delegated"
  "called #{name}"
end
Array.each(Any["ok", "missing", "delegated"]) do |name|
  puts(call(name))
rescue NoMethodError => e
  puts("#{Kernel.class_name(e)}: #{Exception.message(e)}")
end
e = NoMethodError.new("made")
p(e, NoMethodError.message(e))
call("missing")
