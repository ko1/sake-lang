# A feature-usage survey: all eight Venn regions of three Sets by chained - & |, an
# inclusion-exclusion check, exactly-k counts and per-plan percentages.
# Shows: Set operators and Set.size, Regexp split, format.

def responses
  Any[
    ["u01", "free", "search export"], ["u02", "pro", "search sync api"], ["u03", "free", "search"],
    ["u04", "team", "sync api"], ["u05", "pro", "export sync"], ["u06", "free", ""],
    ["u07", "team", "search export sync api"], ["u08", "pro", "api"], ["u09", "free", "search sync"],
    ["u10", "team", "export"], ["u11", "pro", "search export sync"], ["u12", "free", "search export"]
  ]
end

def users_of(rows, feature)
  Array.filter_map(rows) { |id, plan, feats| Array.include?(String.split(feats, " "), feature) ? id : nil }.to_set
end

def label(s) = Set.empty?(s) ? "-" : Array.join(Set.sort(s), " ")

rows = responses
all = Array.map(rows) { |id, plan, feats| id }.to_set
s = users_of(rows, "search")
e = users_of(rows, "export")
y = users_of(rows, "sync")
puts("respondents: #{Set.size(all)}")
puts("search=#{Set.size(s)} export=#{Set.size(e)} sync=#{Set.size(y)}")

regions = Hash.of(
  "search only" => s - e - y,
  "export only" => e - s - y,
  "sync only" => y - s - e,
  "search+export" => (s & e) - y,
  "search+sync" => (s & y) - e,
  "export+sync" => (e & y) - s,
  "all three" => s & e & y,
  "none" => all - (s | e | y)
)
puts("== Venn regions ==")
Hash.each(regions) { |name, members| puts(format("%-14s %2d  %s", name, Set.size(members), label(members))) }

covered = Hash.sum(regions) { |name, members| Set.size(members) }
puts("regions add up: #{covered == Set.size(all)}")
union_size = Set.size(s) + Set.size(e) + Set.size(y) - Set.size(s & e) - Set.size(s & y) - Set.size(e & y) + Set.size(s & e & y)
puts("inclusion-exclusion: #{union_size} == #{Set.size(s | e | y)}")
names = Hash.keys(regions)
overlapping = Array.combination(names, 2).select { |a, b| Set.intersect?(regions[a], regions[b]) }
puts("overlapping regions: #{Array.size(overlapping)}")

puts("== Exactly k features (of search/export/sync) ==")
counts = Hash.new(0)
Set.each(all) { |u| counts[u] = Array.count(Any[s, e, y]) { |set| Set.include?(set, u) } }
Array.each(Range.to_a(0..3)) do |k|
  who = Hash.select(counts) { |u, n| n == k }.keys.Array.sort
  puts("  #{k}: #{Array.size(who)} #{Array.join(who, " ")}")
end

puts("== By plan ==")
plans = Array.group_by(rows) { |id, plan, feats| plan }
Hash.keys(plans).Array.sort.each do |plan|
  ids = Array.map(plans[plan]) { |id, pl, f| id }.to_set
  shares = Array.map(Any[["search", s], ["export", e], ["sync", y]]) do |name, set|
    format("%s %3.0f%%", name, Set.size(ids & set) * 100.0 / Set.size(ids))
  end
  puts(format("  %-5s n=%d  %s", plan, Set.size(ids), Array.join(shares, "  ")))
end

api = users_of(rows, "api")
puts("api users: #{label(api)}; all on paid plans? #{Set.all?(api) { |u| Array.any?(rows) { |id, plan, f| id == u && plan != "free" } }}")
puts("api users without sync: #{label(api - y)}")
feature_counts = Array.flat_map(rows) { |id, plan, feats| String.split(feats, " ") }.tally
puts("popularity: #{Hash.sort_by(feature_counts) { |f, n| [-n, f] }.Array.map { |f, n| "#{f}(#{n})" }.join(" ")}")
