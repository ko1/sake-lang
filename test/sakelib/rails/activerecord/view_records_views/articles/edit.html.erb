<% article = @article || raise(ArgumentError, "@article is not set") %>
<% content_for view, :title, "Editing article" %>

<h1>Editing article</h1>

<%= render "form", article: article %>

<br>

<div>
  <%= link_to view, "Show this article", article %> |
  <%= link_to view, "Back to articles", articles_path(view) %>
</div>
