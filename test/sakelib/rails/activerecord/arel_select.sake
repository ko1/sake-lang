require "rails/activerecord/active_record"

# Arel's SQL for SQLite: the adapter is the engine (as ActiveRecord::Base's connection is in Rails)
conn = ActiveRecord::ConnectionAdapters::SQLite3Adapter.new(Hash.of(adapter: "sqlite3", database: ":memory:"))
Arel::Table.set_engine(conn)
users = Arel::Table.new(:users)
posts = Arel::Table.new(:posts)

# Ruby's bind.value_for_database (the binds are Attributes here)
def value_for_database(x) = (x in ActiveModel::Attribute) ? ActiveModel::Attribute.value_for_database(x) : x

# Ruby's node.to_sql: a node or a manager
def to_sql(n)
  case n
  in Arel::SelectManager then Arel::SelectManager.to_sql(n)
  else Arel::Nodes::Node.to_sql(n)
  end
end

puts("-- select")
puts(Arel::Table.project(users, Arel.star).Arel::SelectManager.to_sql)
puts(Arel::Table.project(users, users[:id], users[:name]).Arel::SelectManager.where(Arel::Nodes::Node.and(Arel::Attribute.eq(users[:name], "o'x"), Arel::Attribute.gt(users[:age], 3))).order(Arel::Attribute.desc(users[:id])).take(5).skip(2).to_sql)
puts(Arel::Table.project(users, users[:id]).Arel::SelectManager.skip(10).to_sql)
puts(Arel::Table.project(users, "id", :name).Arel::SelectManager.order("name", Arel::Attribute.asc(users[:age]).Arel::Nodes::Ascending.nulls_first).to_sql)
puts(Arel::Table.project(users, users[:id]).Arel::SelectManager.distinct.where(Arel::Attribute.eq(users[:deleted_at], nil)).where(Arel::Attribute.not_eq(users[:role], nil)).to_sql)

puts("-- predications")
puts(to_sql(Arel::Attribute.not_eq(users[:id], 1)))
puts(to_sql(Arel::Nodes::Node.or(Arel::Attribute.lt(users[:age], 10), Arel::Attribute.gteq(users[:age], 65))))
puts(to_sql(Arel::Attribute.lteq(users[:age], 3.5).Arel::Nodes::Node.not))
puts(to_sql(Arel::Attribute.in(users[:id], Any[1, 2, 3])))
puts(to_sql(Arel::Attribute.in(users[:id], Any[])))
puts(to_sql(Arel::Attribute.not_in(users[:id], Any[4, 5])))
puts(to_sql(Arel::Attribute.not_in(users[:id], Any[])))
puts(to_sql(Arel::Attribute.between(users[:id], 1..3)))
puts(to_sql(Arel::Attribute.between(users[:id], 1...3)))
puts(to_sql(Arel::Attribute.between(users[:id], 1..)))
puts(to_sql(Arel::Attribute.between(users[:id], ..9)))
puts(to_sql(Arel::Attribute.not_between(users[:id], 1..3)))
puts(to_sql(Arel::Attribute.in(users[:id], 4..6)))
puts(to_sql(Arel::Attribute.matches(users[:name], "%ko%")))
puts(to_sql(Arel::Attribute.does_not_match(users[:name], "a\\_%", "\\")))
puts(to_sql(Arel::Attribute.eq_any(users[:id], Any[1, 2])))
puts(to_sql(Arel::Attribute.not_eq_all(users[:id], Any[1, 2])))
puts(to_sql(Arel::Attribute.matches_any(users[:name], Any["a%", "b%"])))
puts(to_sql(Arel::Attribute.gt_all(users[:id], Any[1, 2])))
puts(to_sql(Arel::Attribute.is_distinct_from(users[:id], 3)))
puts(to_sql(Arel::Attribute.is_not_distinct_from(users[:id], nil)))
puts(to_sql(Arel::Attribute.eq(users[:id], users[:parent_id])))

puts("-- values")
puts(to_sql(Arel::Attribute.eq(users[:name], :sym)))
puts(to_sql(Arel::Attribute.eq(users[:ok], true)))
puts(to_sql(Arel::Attribute.eq(users[:ok], false)))
puts(to_sql(Arel::Attribute.eq(users[:score], 1.25)))
puts(to_sql(Arel::Attribute.eq(users[:score], BigDecimal.parse("12.50"))))
puts(to_sql(Arel::Attribute.eq(users[:score], Float.INFINITY)))
puts(to_sql(Arel::Attribute.eq(users[:at], Time.utc(2020, 1, 2, 3, 4, 5))))
puts(to_sql(Arel::Attribute.eq(users[:at], Time.utc(2020, 1, 2, 3, 4, 5 + Rational(120, 1_000_000)))))
puts(to_sql(Arel::Attribute.eq(users[:on], Date.new(2020, 1, 2))))
puts(to_sql(Arel::Attribute.eq(users[:name], "back\\slash")))

puts("-- joins")
puts(Arel::Table.join(users, posts).Arel::SelectManager.on(Arel::Attribute.eq(posts[:user_id], users[:id])).project(users[:name], posts[:title]).to_sql)
puts(Arel::Table.outer_join(users, posts).Arel::SelectManager.on(Arel::Attribute.eq(posts[:user_id], users[:id])).project(Arel.star).to_sql)
puts(Arel::Table.join(users, Arel.sql("INNER JOIN comments ON comments.user_id = users.id")).Arel::SelectManager.project(Arel.star).to_sql)
authors = Arel::Table.alias(users, "authors")
puts(Arel::Table.join(posts, authors).Arel::SelectManager.on(Arel::Attribute.eq(authors[:id], posts[:user_id])).project(authors[:name]).to_sql)
puts(Arel::Table.from(users).Arel::SelectManager.from(Arel::Table.alias(users)).project(Arel.star).to_sql)

puts("-- aggregates")
puts(Arel::Table.project(posts, posts[:user_id], Arel::Attribute.count(posts[:id]).Arel::Nodes::Count.as("n")).Arel::SelectManager.group(posts[:user_id]).having(Arel::Attribute.count(posts[:id]).Arel::Nodes::Count.gt(1)).to_sql)
puts(Arel::Table.project(posts, Arel::Attribute.sum(posts[:score]), Arel::Attribute.maximum(posts[:score]), Arel::Attribute.minimum(posts[:score]), Arel::Attribute.average(posts[:score])).Arel::SelectManager.to_sql)
puts(Arel::Table.project(posts, Arel::Attribute.count(posts[:user_id], true)).Arel::SelectManager.to_sql)
puts(Arel::Table.project(posts, Arel::Nodes::NamedFunction.new("COALESCE", Any[posts[:title], Arel::Nodes.build_quoted("")])).Arel::SelectManager.to_sql)
puts(Arel::Table.project(posts, posts[:score] + 1, posts[:score] * 2, posts[:score] - posts[:bonus], posts[:score] / 3).Arel::SelectManager.to_sql)
puts(Arel::Table.project(posts, Arel::Table.lower(posts, posts[:title])).Arel::SelectManager.to_sql)
puts(Arel::Table.project(posts, posts[:id]).Arel::SelectManager.lock.to_sql)

puts("-- set operations")
a = Arel::Table.project(users, users[:id]).Arel::SelectManager.where(Arel::Attribute.gt(users[:age], 18))
b = Arel::Table.project(users, users[:id]).Arel::SelectManager.where(Arel::Attribute.eq(users[:admin], true))
puts(to_sql(Arel::SelectManager.union(a, b)))
puts(to_sql(Arel::SelectManager.union(a, :all, b)))
puts(to_sql(Arel::SelectManager.intersect(a, b)))
puts(to_sql(Arel::SelectManager.except(a, b)))
puts(Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel::SelectManager.exists(a)).to_sql)
puts(Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel::Attribute.in(users[:id], b)).to_sql)

puts("-- case, window, with")
c = Arel::Nodes::Case.new(users[:age]).Arel::Nodes::Case.when(1).then("one").when(2).then("two").else("many")
puts(Arel::Table.project(users, Arel::Nodes::Case.as(c, "word")).Arel::SelectManager.to_sql)
puts(Arel::Table.project(users, Arel::Attribute.when(users[:age], 18).Arel::Nodes::Case.then("adult")).Arel::SelectManager.to_sql)
w = Arel::Nodes::Window.new.Arel::Nodes::Window.partition(users[:team]).order(Arel::Attribute.desc(users[:age]))
puts(Arel::Table.project(users, Arel::Attribute.count(users[:id]).Arel::Nodes::Count.over(w)).Arel::SelectManager.to_sql)
puts(Arel::Table.project(users, Arel::Attribute.count(users[:id]).Arel::Nodes::Count.over).Arel::SelectManager.to_sql)
sm = Arel::Table.project(users, Arel.star)
Arel::SelectManager.window(sm, "w").Arel::Nodes::NamedWindow.order(users[:id])
puts(Arel::SelectManager.to_sql(sm))
recent = Arel::Table.new(:recent)
cte = Arel::Nodes::As.new(recent, Arel::Table.project(posts, posts[:id]).Arel::SelectManager.where(Arel::Attribute.gt(posts[:id], 10)))
puts(Arel::Table.project(recent, Arel.star).Arel::SelectManager.with(cte).to_sql)

puts("-- literals and binds")
puts(Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel.sql("age > ?", 21)).to_sql)
puts(Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel.sql("name IN (?)", Any["a", "b"])).to_sql)
puts(Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel.sql("id = :id AND x = :x", Hash.of(id: 1, x: "y"))).to_sql)
begin
  Arel.sql("a = ? AND b = ?", 1)
rescue Arel::BindError => e
  puts("BindError: #{Exception.message(e)}")
end
bind = Arel::Nodes::BindParam.new(ActiveRecord::Relation::QueryAttribute.new("id", "7", ActiveModel::Type::Integer.new))
stmt = Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel::Attribute.eq(users[:id], bind)).where(Arel::Attribute.eq(users[:name], "x"))
puts(Arel::SelectManager.to_sql(stmt))
sql, binds, preparable = ActiveRecord::ConnectionAdapters::SQLite3Adapter.to_sql_and_binds(conn, Arel::SelectManager.ast(stmt))
p([sql, Array.map(binds) { |x| value_for_database(x) }, preparable])
sql, binds, preparable = ActiveRecord::ConnectionAdapters::SQLite3Adapter.to_sql_and_binds(conn, Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel::Attribute.eq(users[:id], bind)))
p([sql, Array.map(binds) { |x| value_for_database(x) }, preparable])
begin
  puts(Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel::Nodes::Equality.new(users[:id], "raw")).to_sql)
rescue Arel::Visitors::UnsupportedVisitError => e
  puts("UnsupportedVisitError: #{Exception.message(e)}")
end
