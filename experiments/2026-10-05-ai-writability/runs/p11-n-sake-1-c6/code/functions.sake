# Scalar functions (spec 1.11, 2.4). The resolver checks name and arity once; `call` runs one.
# Text functions are in text_functions.sake, round in rounding.sake; the math functions (spec 7) are here.
module Functions
  module_function

  def known?(fn)
    case fn
    in "length" | "upper" | "lower" | "abs" | "typeof" | "coalesce" | "ifnull" | "nullif" then true
    in "substr" | "trim" | "ltrim" | "rtrim" | "replace" | "instr" | "round" | "max" | "min" then true
    in "ceil" | "ceiling" | "floor" | "trunc" | "mod" | "pow" | "power" | "sqrt" | "pi" then true
    else false
    end
  end

  def arity_ok?(fn, count)
    case fn
    in "length" | "upper" | "lower" | "abs" | "typeof" then count == 1
    in "coalesce" | "max" | "min" then count >= 2
    in "ifnull" | "nullif" | "instr" then count == 2
    in "substr" then count == 2 || count == 3
    in "trim" | "ltrim" | "rtrim" | "round" then count == 1 || count == 2
    in "replace" then count == 3
    in "ceil" | "ceiling" | "floor" | "trunc" | "sqrt" then count == 1
    in "mod" | "pow" | "power" then count == 2
    in "pi" then count == 0
    else false
    end
  end

  # `args` are already-evaluated values.
  def call(fn, args)
    return Math.PI() if fn == "pi"
    x = Array.fetch(args, 0)
    case fn
    in "typeof" then type_of(x)
    in "coalesce" then Array.find(args) { it != nil }
    in "ifnull" then x == nil ? Array.fetch(args, 1) : x
    in "nullif" then null_if(x, Array.fetch(args, 1))
    in "ceil" | "ceiling" | "floor" | "trunc" | "mod" | "pow" | "power" | "sqrt" then math_call(fn, args)
    else Array.any?(args) { it == nil } ? nil : call_non_null(fn, args)
    end
  end

  # The functions whose result is NULL when any argument is NULL.
  def call_non_null(fn, args)
    x = Array.fetch(args, 0)
    y = Array.size(args) > 1 ? Array.fetch(args, 1) : nil
    case fn
    in "length" then String.length(Value.text_form(x))
    in "upper" then Value.upper(Value.text_form(x))
    in "lower" then Value.lower(Value.text_form(x))
    in "abs" then absolute(x)
    in "substr" then substr(args)
    in "trim" then trim_with(args, true, true)
    in "ltrim" then trim_with(args, true, false)
    in "rtrim" then trim_with(args, false, true)
    in "replace" then TextFunctions.replace(Value.text_form(x), Value.text_form(y), Value.text_form(Array.fetch(args, 2)))
    in "instr" then TextFunctions.instr(Value.text_form(x), Value.text_form(y))
    in "round" then Rounding.round(Value.to_number(x), y == nil ? 0 : Integer.clamp(integer_arg(y), 0, 1000))
    in "max" then extreme(args, 1)
    in "min" then extreme(args, -1)
    end
  end

  # ---- Math functions (spec 7) ----

  # NULL if any argument is NULL or TEXT that is not a whole numeric literal (7.1).
  def math_call(fn, args)
    nums = Array.map(args) { math_arg(it) }
    return nil if Array.any?(nums) { it == nil }
    x = Array.fetch(nums, 0)
    case fn
    in "ceil" | "ceiling" then whole_real(x, :up)
    in "floor" then whole_real(x, :down)
    in "trunc" then whole_real(x, :zero)
    in "mod" then fmod(float_of(x), float_of(Array.fetch(nums, 1)))
    in "pow" | "power" then power(float_of(x), float_of(Array.fetch(nums, 1)))
    in "sqrt" then square_root(float_of(x))
    end
  end

  # Unlike to_number, TEXT must be a complete numeric literal: nil otherwise.
  def math_arg(v)
    case v
    in String then Value.parse_numeric(v)
    else v
    end
  end

  def float_of(v)
    case v
    in Integer | Float then Arithmetic.to_f(v)
    else raise SqlError.new("internal error: #{Value.text_form(v)} read as a number")
    end
  end

  # An INTEGER stays; a REAL becomes the whole REAL in `direction` (:up, :down or :zero).
  def whole_real(x, direction)
    case x
    in Integer then x
    in Float
      case direction
      in :up then Arithmetic.to_f(Float.ceil(x))
      in :down then Arithmetic.to_f(Float.floor(x))
      in :zero then Arithmetic.to_f(Float.truncate(x))
      end
    else raise SqlError.new("internal error: #{Value.text_form(x)} read as a number")
    end
  end

  # C's fmod: the remainder of the magnitudes, with the sign of x. NULL for a zero y.
  def fmod(x, y)
    return nil if y == 0.0
    r = Float.abs(x) % Float.abs(y)
    x < 0.0 ? -r : r
  end

  # NULL for a negative base with a fractional exponent (not a real number).
  def power(x, y)
    return nil if x < 0.0 && y != Arithmetic.to_f(Float.floor(y))
    r = x ** y
    (r in Float) ? r : nil
  end

  def square_root(x) = x < 0.0 ? nil : Math.sqrt(x)

  # An argument read as an integer (numeric prefix for TEXT, truncating REALs).
  def integer_arg(v)
    n = Value.to_number(v)
    (n in Integer) ? n : Float.to_i(n)
  end

  def substr(args)
    len = Array.size(args) == 3 ? integer_arg(Array.fetch(args, 2)) : TextFunctions.unbounded
    TextFunctions.substr(Value.text_form(Array.fetch(args, 0)), integer_arg(Array.fetch(args, 1)), len)
  end

  def trim_with(args, left, right)
    chars = Array.size(args) == 2 ? Value.text_form(Array.fetch(args, 1)) : " "
    TextFunctions.trim(Value.text_form(Array.fetch(args, 0)), chars, left, right)
  end

  # The largest (direction 1) or smallest (-1) of the arguments; the first of equal values.
  def extreme(args, direction)
    best = Array.fetch(args, 0)
    Array.each(args) { best = it if Value.compare(it, best) == direction }
    best
  end

  def absolute(x)
    case x
    in nil then nil
    in Integer then Integer.abs(x)
    in Float then Float.abs(x)
    in String then Float.abs(Arithmetic.to_f(Value.numeric_prefix(x)))
    end
  end

  def type_of(x)
    case x
    in nil then "null"
    in Integer then "integer"
    in Float then "real"
    in String then "text"
    end
  end

  # x unless x = y (no affinity); a NULL on either side never equals.
  def null_if(x, y)
    return x if x == nil || y == nil
    Value.compare(x, y) == 0 ? nil : x
  end
end
