# Port of activemodel-8.1.3/lib/active_model/attribute_assignment.rb
#
# Ruby's `public_send("#{k}=", v)` is the generated `_assign_attribute(r, k, v)`, a `case` over the class's
# writable attributes (attr_accessor fields and `attribute`s), whose else calls attribute_writer_missing.
# Ruby's `attributes=` is `attributes=(r, h)`, written `person.Person.attributes = h`.

require "errors"
require "forbidden_attributes_protection"
require "send"

module ActiveModel
  module AttributeAssignment
    include ActiveModel::ForbiddenAttributesProtection

    # Required (generated): Ruby's public_send(:"#{k}=", v).
    def _assign_attribute(r, k, v) = raise(NotImplementedError)
    # Required (generated): the class's name, for messages (Ruby's self.class).
    include ActiveModel::Send

    def assign_attributes(r, new_attributes)
      return nil if new_attributes == nil
      attributes = sanitize_for_mass_assignment(r, new_attributes)
      return nil if Hash.empty?(attributes)
      _assign_attributes(r, attributes)
    end

    def attributes=(r, new_attributes)
      assign_attributes(r, new_attributes)
    end

    def attribute_writer_missing(r, name, value)
      raise UnknownAttributeError.new("unknown attribute '#{name}' for #{__class_name}.", r, name)
    end

    def _assign_attributes(r, attributes)
      Hash.each(attributes) { |k, v| _assign_attribute(r, Kernel.to_s(k), v) }
    end
  end
end
