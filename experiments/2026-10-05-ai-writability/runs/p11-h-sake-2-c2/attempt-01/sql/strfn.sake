# The text functions substr, trim, replace and instr (2.4), on texts and integers already read.
module StrFn
  module_function

  # Where substr(x, start[, len]) cuts (2.4) when x has l characters (or bytes): [p, q], the 0-based
  # first position and the count; nothing is selected if q <= 0. len is nil when absent.
  def cut(l, start, len)
    p = start
    q = len == nil ? 4611686018427387904 : len
    if p < 0
      p += l
      if p < 0
        q += p
        p = 0
        q = 0 if q < 0
      end
    elsif p > 0
      p -= 1
    else
      q -= 1 if q > 0
    end
    if q < 0
      q = -q
      p -= q
      if p < 0
        q += p
        p = 0
      end
    end
    [p, q]
  end

  def substr(text, start, len)
    l = String.length(text)
    p, q = cut(l, start, len)
    return "" if q <= 0
    Text.slice(text, p, q > l ? l : q)
  end

  # substr of a BLOB: the bytes selected, as a BLOB (7.6). Two hex digits make a byte.
  def substr_blob(b, start, len)
    h = Blob.hex(b)
    l = String.size(h) / 2
    p, q = cut(l, start, len)
    return Blob.new("") if q <= 0
    Blob.new(Text.slice(h, p * 2, (q > l ? l : q) * 2))
  end

  # mode: :both, :left or :right; chars: the characters to remove.
  def trim(text, chars, mode)
    cs = String.chars(text)
    drop = Array.to_set(String.chars(chars))
    first = 0
    last = Array.size(cs)
    first += 1 while mode != :right && first < last && Set.include?(drop, cs[first])
    last -= 1 while mode != :left && last > first && Set.include?(drop, cs[last - 1])
    Text.slice(text, first, last - first)
  end

  # Every non-overlapping occurrence of `from`, left to right, replaced by `to`.
  def replace(text, from, to)
    return text if from == ""
    out = ""
    pos = 0
    step = String.length(from)
    loop do
      i = String.index(text, from, pos)
      break if i == nil
      out = out + Text.slice(text, pos, i - pos) + to
      pos = i + step
    end
    out + Text.slice(text, pos, String.length(text) - pos)
  end

  # 1-based position of the first occurrence, or 0.
  def instr(text, part)
    i = String.index(text, part)
    i == nil ? 0 : i + 1
  end

  # The same for two BLOBs given as hex digits: a match counts only on a byte boundary.
  def instr_bytes(hay, needle)
    pos = 0
    while pos <= String.size(hay)
      i = String.index(hay, needle, pos)
      return 0 if i == nil
      return i / 2 + 1 if i % 2 == 0
      pos = i + 1
    end
    0
  end
end
