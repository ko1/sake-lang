# raise / rescue / else / ensure / retry, def ... rescue, x rescue y, and an exception that is not rescued.
ParseError = Exception.new(:line)

def parse(s)
  raise ParseError.new("empty input", 1) if String.empty?(s)
  raise ArgumentError, "too long" if String.size(s) > 5
  raise "bad char" if String.include?(s, "!")
  String.to_i(s)
end

Array.each(Array["", "123456", "a!", "42"]) do |s|
  begin
    p(parse(s))
  rescue ParseError => e
    puts(String.+("parse error at line ", Integer.to_s(ParseError.get_line(e))))
    p(e)
  rescue ArgumentError, RuntimeError => e
    puts(String.+("other: ", Exception.message(e)))
  else
    puts("ok")
  ensure
    puts("done")
  end
end

def safe_div(a, b)
  a / b
rescue ZeroDivisionError => e
  p(e)
  0
end
p(safe_div(1, 0))
x = Hash.fetch(Hash["a" => 1], "b") rescue -1
p(x)
tries = 0
begin
  tries += 1
  raise "flaky" if tries < 3
  p(tries)
rescue
  retry
end
def wrap
  yield
rescue => e
  puts(String.+("wrapped: ", Exception.message(e)))
  raise
end
wrap { raise ParseError.new("deep", 9) }
