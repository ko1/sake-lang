# Port of activemodel-8.1.3/lib/active_model/callbacks.rb
#
# define_model_callbacks and the before_/around_/after_ class methods it defines are class-body lines: the
# generator (generate/callbacks.sake) maps them onto ActiveSupport::Callbacks' define_callbacks/set_callback,
# as Ruby's define_singleton_method bodies do. What is left at run time is the after callbacks' condition,
# Ruby's `Conditionals::Value.new { |v| v != false }` (an after callback does not run when the block
# returned false): ActiveSupport::Callbacks' conditions are method names and do not see the block's value, so
# the generated `_run_save_callbacks` keeps it here and the condition `__callback_value_not_false?` reads it.

require "rails/activesupport/active_support/callbacks"

module ActiveModel
  module Callbacks
    include ActiveSupport::Callbacks

    def __callback_value_not_false?(r) = Callbacks.value != false

    module_function

    class Value
      attr_accessor value
    end

    def last = once { Value.new(true) }
    def value = Value.value(last)

    # Runs the block as Ruby's run_callbacks block; its value is what the after callbacks' condition sees.
    def record_value(v)
      Value.set_value(last, v == false ? false : true)
      v
    end
  end
end
