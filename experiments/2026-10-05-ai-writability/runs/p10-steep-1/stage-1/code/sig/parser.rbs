module Sql
  class Parser
    @tokens: Array[Token]
    @pos: Integer

    def initialize: (Array[Token] tokens) -> void
    def parse_statement: () -> Ast::Statement?

    private

    def syntax_error: () -> bot
    def peek: () -> Token
    def advance: () -> Token
    def accept_keyword: (String word) -> bool
    def expect_keyword: (String word) -> void
    def accept_op: (String symbol) -> bool
    def expect_op: (String symbol) -> void
    def name: () -> String
    def create_table: () -> Ast::CreateTable
    def column_def: () -> Ast::ColumnDef
    def column_type: (String word) -> column_type?
    def drop_table: () -> Ast::DropTable
    def insert: () -> Ast::Insert
    def value_row: () -> Array[Ast::Expr]
    def select: () -> Ast::Select
    def select_item: () -> Ast::SelectItem
    def order_terms: () -> Array[Ast::OrderTerm]
    def order_term: () -> Ast::OrderTerm
    def expression: () -> Ast::Expr
    def conjunction: () -> Ast::Expr
    def negation: () -> Ast::Expr
    def equality: () -> Ast::Expr
    def comparison: () -> Ast::Expr
    def additive: () -> Ast::Expr
    def multiplicative: () -> Ast::Expr
    def concatenation: () -> Ast::Expr
    def unary: () -> Ast::Expr
    def primary: () -> Ast::Expr
    def function_call: (String function) -> Ast::FunctionCall
  end
end
