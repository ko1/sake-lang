class Job
  attr_reader name, priority, seq, arrival, duration
  include Comparable
  def <=>(a, b)
    c = @priority <=> Job.priority(b)
    c == 0 ? @seq <=> Job.seq(b) : c
  end
  def to_s(j) = "#{@name}(p#{@priority})"
end

class MinHeap
  attr_reader items

  def initialize(h)
    @items = nil
    @items = Array[]
  end
  def size(h) = Array.size(@items)
  def empty?(h) = Array.empty?(@items)
  def peek(h) = Array.first(@items)

  def push(h, x)
    Array.push(@items, x)
    sift_up(h, Array.size(@items) - 1)
    h
  end

  def pop(h)
    return nil if Array.empty?(@items)
    top = @items[0]
    last = Array.pop(@items)
    unless Array.empty?(@items)
      @items[0] = last
      sift_down(h, 0)
    end
    top
  end

  def sift_up(h, i)
    while i > 0
      parent = (i - 1) / 2
      break unless @items[i] < @items[parent]
      swap(h, i, parent)
      i = parent
    end
  end

  def sift_down(h, i)
    n = Array.size(@items)
    while true
      l = 2 * i + 1
      r = l + 1
      smallest = i
      smallest = l if l < n && @items[l] < @items[smallest]
      smallest = r if r < n && @items[r] < @items[smallest]
      break if smallest == i
      swap(h, i, smallest)
      i = smallest
    end
  end

  def swap(h, i, j)
    @items[i], @items[j] = @items[j], @items[i]
  end
end

def parse_jobs(text)
  jobs = Array[]
  String.each_line(text) do |line|
    line = String.strip(line)
    next if String.empty?(line) || String.start_with?(line, "#")
    name, pri, arr, dur = String.split(line, ",")
    Array.push(jobs, Job.new(String.strip(name), String.to_i(pri), Array.size(jobs), String.to_i(arr), String.to_i(dur)))
  end
  jobs
end

data = <<~CSV
  # name, priority, arrival, duration
  backup, 5, 0, 4
  email, 2, 1, 2
  compile, 3, 1, 5
  # urgent ones
  alert, 1, 3, 1
  report, 4, 4, 3
  index, 3, 6, 2
  cleanup, 9, 6, 1
  deploy, 1, 9, 3
CSV

jobs = parse_jobs(data)
pending = Array.sort_by(jobs) { |j| Job.arrival(j) }
heap = MinHeap.new
clock = 0
waits = Hash[]
log = Array[]
while !Array.empty?(pending) || !MinHeap.empty?(heap)
  while !Array.empty?(pending) && Job.arrival(Array.first(pending)) <= clock
    MinHeap.push(heap, Array.shift(pending))
  end
  if MinHeap.empty?(heap)
    clock = Job.arrival(Array.first(pending))
    next
  end
  job = MinHeap.pop(heap)
  waits[Job.name(job)] = clock - Job.arrival(job)
  Array.push(log, format("t=%2d run %-12s for %d (queue %d)", clock, Kernel.to_s(job), Job.duration(job), MinHeap.size(heap)))
  clock += Job.duration(job)
end
Array.each(log) { |l| puts(l) }
puts("finished at t=#{clock}")
worst = Hash.max_by(waits) { |_n, w| w }
puts("longest wait: #{worst[0]} (#{worst[1]})")
avg = Array.sum(Hash.values(waits)) / Float(Hash.size(waits))
puts(format("average wait: %.2f", avg))

# heap sort of numbers via the same heap
nums = MinHeap.new
Array.each(Array[42, 7, 19, 3, 88, 7, 51, 0, 23]) { |x| MinHeap.push(nums, x) }
peek = MinHeap.peek(nums)
puts("min peek: #{peek}")
sorted = Array[]
while (x = MinHeap.pop(nums))
  Array.push(sorted, x)
end
puts("sorted: #{Array.join(sorted, " ")}")
p(MinHeap.pop(nums))
