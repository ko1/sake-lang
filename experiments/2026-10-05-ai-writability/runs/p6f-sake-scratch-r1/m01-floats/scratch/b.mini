try
  print(10.0 ** 400)
catch e
  print(e)
end
try
  print((-8.0) ** 0.5)
catch e
  print(e)
end
try
  print(1.0 / -0.0)
catch e
  print(e)
end
try
  print(5 % 0.0)
catch e
  print(e)
end
try
  print(float("1."))
catch e
  print(e)
end
try
  print(float(10 ** 400))
catch e
  print(e)
end
try
  print(min("a", 1))
catch e
  print(e)
end
try
  print({1.5: 2})
catch e
  print(e)
end
try
  print(sort([1.5, "a"]))
catch e
  print(e)
end
try
  print(10 ** 400 * 1.5)
catch e
  print(e)
end
try
  print(2 ** -1)
catch e
  print(e)
end
try
  print(int({}))
catch e
  print(e)
end
try
  print(1.5 in {"a": 1})
catch e
  print(e)
end
try
  print(0 == -0.0)
catch e
  print(e)
end
try
  print([1.5,1] == [1.5, 1.0])
catch e
  print(e)
end
try
  print("{1.50}")
catch e
  print(e)
end
try
  print(-(0.0))
catch e
  print(e)
end
try
  print(float("1_0"))
catch e
  print(e)
end
try
  print(float(" 1"))
catch e
  print(e)
end
