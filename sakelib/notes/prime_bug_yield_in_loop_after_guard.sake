# Status (2026-10-04): fixed.
# Bug: `return n unless block_given?` guards the yield below it, but the checker still reports
# "yield: no block is given" when that yield is inside a while loop (without the loop it passes).
# Ruby prints 2. Workaround in prime.sake: put the loop in the `if block_given?` branch.
def c(n)
  return n unless block_given?
  i = 0
  while i < n
    yield(i)
    i += 1
  end
end
p(c(2))
