# rescue with a module: the body raises none of its types, or an earlier clause already catches the type.
module WSError
end
module Empty
end
class ParseError < Exception
  include WSError
end
def run(k)
  raise ParseError, "bad" if k == 0
  k
end
begin
  run(0)
rescue ParseError => e
  puts "never"
end
begin
  run(0)
rescue WSError => e
  puts "ws"
rescue ParseError => e
  puts "dead"
end
begin
  1
rescue WSError
  puts "never raised"
end
class Base < StandardError
end
class ChildError < Base
end
begin
  raise ChildError, "x"
rescue Base => e
  puts "base"
rescue ChildError => e
  puts "child"
end
