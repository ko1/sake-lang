require "pqueue"

# A job orders by priority (higher first), then by name (earlier first).
class Job
  attr_reader priority, name
  include Comparable
  def <=>(a, b)
    c = @priority <=> Job.priority(b)
    c == 0 ? Job.name(b) <=> @name : c
  end
  def to_s(j) = "#{@name}(#{@priority})"
end

# One queue type per element type: a field has one type for all instances of its type.
class WordQueue < PQueue
end
class JobQueue < PQueue
end
class TaskQueue < PQueue
end

# numbers: the largest first by default, the smallest with order: :min
q = PQueue.new(Array[5, 3, 8, 1, 9, 2])
p PQueue.size(q)
p PQueue.top(q)
PQueue.push(q, 7, 10)
PQueue.<<(q, 0)
p PQueue.length(q)
p PQueue.pop(q)
p PQueue.pop(q)
p PQueue.to_a(q)
p PQueue.size(q)
p PQueue.shift(q, 3)
p q
mq = PQueue.new(Array[5, 3, 8, 1, 9, 2], order: :min)
out = Integer[]
PQueue.each_pop(mq) { |x| Array.push(out, x) }
p out
p PQueue.empty?(mq)
p PQueue.pop(mq)
p PQueue.top(mq)

# heap sort of many values, against Array.sort
nums = Array.map(Range.to_a(1..200)) { |i| i * 7919 % 211 }
hq = PQueue.new(nums, order: :min)
p PQueue.to_a(hq) == Array.sort(nums)
p PQueue.size(hq)

# Strings, and merge
sq = WordQueue.new(Array["pear", "apple", "fig"], order: :min)
WordQueue.merge(sq, WordQueue.new(Array["kiwi", "banana"]))
p WordQueue.to_a(sq)
p WordQueue.pop(sq)
WordQueue.clear(sq)
p WordQueue.empty?(sq)

# a custom order: the element type's own <=>
jobs = JobQueue.new(Job[Job.new(2, "backup"), Job.new(5, "deploy"), Job.new(2, "alert"), Job.new(1, "lint")])
JobQueue.push(jobs, Job.new(5, "build"))
puts Array.join(JobQueue.to_a(jobs), " ")
p JobQueue.pop(jobs)
p JobQueue.pop(jobs)
lazy = JobQueue.new(Job[Job.new(2, "backup"), Job.new(5, "deploy"), Job.new(2, "alert")], order: :min)
puts Array.join(JobQueue.to_a(lazy), " ")

# Tuples: [priority, insertion number, task] keeps equal priorities in insertion order
tq = TaskQueue.new(Array[], order: :min)
seq = 0
Array.each(Array[[3, "c"], [1, "a"], [3, "d"], [1, "b"], [2, "x"]]) do |pr, task|
  TaskQueue.push(tq, [pr, seq, task])
  seq += 1
end
TaskQueue.each_pop(tq) { |pr, _, task| puts "#{pr} #{task}" }

# errors
begin
  PQueue.new(Array[1], order: :biggest)
rescue ArgumentError => e
  puts Exception.message(e)
end
