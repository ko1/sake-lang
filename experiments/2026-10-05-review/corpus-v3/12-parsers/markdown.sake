class Block
  attr_reader kind, lines, level = 0
end

def escape_html(s) = s.String.gsub("&", "&amp;").String.gsub("<", "&lt;").String.gsub(">", "&gt;")

def inline(s)
  out = ""
  i = 0
  while i < String.size(s)
    c = s[i]
    if c == "`"
      if (close = String.index(s, "`", i + 1))
        out += "<code>#{escape_html(s[(i + 1)...close])}</code>"
        i = close + 1
        next
      end
    elsif c == "*" && s[i + 1] == "*"
      if (close = String.index(s, "**", i + 2))
        out += "<strong>#{inline(s[(i + 2)...close])}</strong>"
        i = close + 2
        next
      end
    elsif c == "*"
      if (close = String.index(s, "*", i + 1))
        out += "<em>#{inline(s[(i + 1)...close])}</em>"
        i = close + 1
        next
      end
    elsif c == "["
      mid = String.index(s, "](", i + 1)
      close = mid && String.index(s, ")", mid + 2)
      if close
        out += "<a href=\"#{s[(mid + 2)...close]}\">#{inline(s[(i + 1)...mid])}</a>"
        i = close + 1
        next
      end
    end
    out += escape_html(c)
    i += 1
  end
  out
end

def parse_blocks(text)
  blocks = Block[]
  current = nil
  fence = nil
  Array.each(String.lines(text)) do |raw|
    line = String.chomp(raw)
    if fence
      if String.start_with?(line, "```")
        fence = nil
        current = nil
      else
        Array.push(Block.lines(fence), line)
      end
      next
    end
    content = line
    if String.start_with?(line, "```")
      fence = Block.new(:code, Array[])
      Array.push(blocks, fence)
      current = nil
      next
    elsif String.strip(line) == ""
      current = nil
      next
    elsif (m = String.match(line, /\A(\#{1,6})\s+(.*)\z/))
      Array.push(blocks, Block.new(:heading, Array[m[2]], String.size(m[1])))
      current = nil
      next
    elsif (m = String.match(line, /\A[-*]\s+(.*)\z/))
      kind = :ul
      content = m[1]
    elsif (m = String.match(line, /\A\d+\.\s+(.*)\z/))
      kind = :ol
      content = m[1]
    elsif (m = String.match(line, /\A>\s?(.*)\z/))
      kind = :quote
      content = m[1]
    else
      kind = :para
    end
    if current != nil && Block.kind(current) == kind
      Array.push(Block.lines(current), content)
    elsif current != nil && Block.kind(current) != :para && kind == :para && String.start_with?(line, "  ")
      Block.lines(current)[-1] += " " + String.strip(content)
    else
      current = Block.new(kind, Array[content])
      Array.push(blocks, current)
    end
  end
  blocks
end

def render(blocks)
  Array.map(blocks) do |b|
    lines = Block.lines(b)
    case Block.kind(b)
    in :heading then "<h#{Block.level(b)}>#{inline(lines[0])}</h#{Block.level(b)}>"
    in :para then "<p>#{inline(Array.join(lines, " "))}</p>"
    in :quote then "<blockquote>#{inline(Array.join(lines, " "))}</blockquote>"
    in :code then "<pre><code>#{escape_html(Array.join(lines, "\n"))}</code></pre>"
    in :ul | :ol
      items = Array.map(lines) { |l| "  <li>#{inline(l)}</li>" }
      "<#{Block.kind(b)}>\n#{Array.join(items, "\n")}\n</#{Block.kind(b)}>"
    end
  end.Array.join("\n")
end

def document
  <<~MD
    # Sake *notes*

    Sake writes the type on **every operation**, e.g. `String.upcase(s)`.
    It keeps Ruby's syntax & semantics where it can.

    ## Checklist
    - parse **headings** and *lists*
    - inline `code <tags>` stays escaped
      and continuation lines join
    * links like [the spec](docs/spec.md)

    1. tokenize
    2. parse
    3. render

    > Quotes can span
    > two lines with a [link](http://example.com/?a=1&b=2).

    ```
    def f(x) = x * 2   # <not> **markup**
    ```

    Unclosed *emphasis and a lone ` backtick, plus 2 * 3 * 4 = 24.
    ###### Deep heading
  MD
end

blocks = parse_blocks(document)
puts("#{Array.size(blocks)} blocks: #{Array.join(Array.map(blocks) { |b| Symbol.to_s(Block.kind(b)) }, " ")}")
puts(render(blocks))
