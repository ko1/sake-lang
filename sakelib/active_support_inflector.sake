# active_support_inflector: ActiveSupport::Inflector, now in the Rails tree (sakelib/rails/activesupport/).
#
# The rules live in `ActiveSupport::Inflector.inflections` (an `Inflections`, as in Ruby); the functions below
# keep the flat port's names (2026-10-09) for `inflect.plural ...` & co. on the :en table.

require "rails/activesupport/active_support/inflector"

module ActiveSupport
  module Inflector
    module_function

    def plural(rule, replacement) = Inflections.plural(inflections, rule, replacement)
    def singular(rule, replacement) = Inflections.singular(inflections, rule, replacement)
    def irregular(sing, plur) = Inflections.irregular(inflections, sing, plur)
    def uncountable(*words) = Inflections.uncountable(inflections, *words)
    def human(rule, replacement) = Inflections.human(inflections, rule, replacement)
    def acronym(word) = Inflections.acronym(inflections, word)
  end
end
