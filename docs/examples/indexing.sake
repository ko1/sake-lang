words = String.split("the quick brown fox", " ")
p(words[0])
p(words[-1])
p(words[10])                   # outside the Array: nil, as in Ruby
words[1] = "slow"
p(words)

counts = Array[0, 0, 0]
counts[1] += 1
p(counts)

t = [1, "one"]
t[0] = 2                       # a Tuple keeps the type of each position
p(t)

best = nil
best ||= Array.max(Array[3, 9, 4])
p(best)
p(t[2])                        # a Tuple's length is part of its type
