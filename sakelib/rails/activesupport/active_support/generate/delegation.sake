# (Sake only) The generator for Module#delegate (core_ext/module/delegation): Ruby's
#   class Post; delegate :name, :email, to: :author, prefix: true, allow_nil: true; end
# is
#   generate "rails/activesupport/active_support/generate/delegation", "Post", "to=author:User", "prefix=true", "allow_nil=true", "name", "email"
# The options come first as key=value; the rest are method names ("name/1" takes one argument).

require "../delegation"

owner = Array.first(ARGV) || raise(ArgumentError, "delegation: the owner class first")
to = ""
prefix = nil
allow_nil = false
methods = String[]
Array.each(Array.drop(ARGV, 1)) do |arg|
  if (m = String.match(arg, /\A(to|prefix|allow_nil)=(.*)\z/))
    case m[1]
    in "to" then to = m[2] || ""
    in "prefix" then prefix = m[2]
    else allow_nil = m[2] == "true"
    end
  else
    Array.push(methods, arg)
  end
end
print(ActiveSupport::Delegation.generate(owner, methods, to, prefix, allow_nil))
