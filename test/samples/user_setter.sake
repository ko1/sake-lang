# A function named like a generated setter (set_body) replaces it, also for `x.B.body = v` and `+=`.
class A
  attr_accessor body
end
class B < A
  def set_body(b, v)
    @body = (v in String) ? Any[v] : v
    v
  end
end
b = B.new(Any["x"])
B.set_body(b, "y")
p(B.body(b))
b.B.body = "z"
p(B.body(b))
b.B.body += Any["w"]
p(B.body(b))
a = A.new(Any["x"])
a.A.body = Any["q"]
p(A.body(a))
