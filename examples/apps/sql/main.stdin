CREATE TABLE cities (name TEXT, country TEXT, pop INTEGER);
INSERT INTO cities VALUES ('Tokyo', 'JP', 13960000), ('Osaka', 'JP', 2750000), ('Paris', 'FR', 2140000), ('Lyon', 'FR', 520000), ('Berlin', 'DE', 3650000);
SELECT name, pop FROM cities WHERE pop > 2000000 ORDER BY pop DESC;
SELECT country, COUNT(*), SUM(pop) FROM cities GROUP BY country ORDER BY country;
SELECT name, RANK() OVER (ORDER BY pop DESC) AS r FROM cities ORDER BY r LIMIT 3;
WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 5) SELECT SUM(i) FROM n;
SELECT typeof(X'0102'), length(X'0102'), hex(X'0102');
SELECT 1 / 0;
SELECT * FROM nowhere;
