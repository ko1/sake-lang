require "rails/activesupport/active_support/string_inquirer"
require "rails/activesupport/active_support/array_inquirer"
generate "rails/activesupport/active_support/generate/inquirers", "production", "development", "phone", "tablet"

# StringInquirer and ArrayInquirer (string_inquirer, array_inquirer, core_ext/string/inquiry, core_ext/array/inquiry)
env = String.inquiry("production")
p(ActiveSupport::StringInquirer.production?(env), ActiveSupport::StringInquirer.development?(env), ActiveSupport::StringInquirer.inquire(env, :staging?))
p(env == "production", ActiveSupport::StringInquirer.to_s(env), ActiveSupport::StringInquirer.respond_to_missing?(env, :anything?))
puts("env: #{env}")
begin
  ActiveSupport::StringInquirer.inquire(env, :production)
rescue ActiveSupport::NoMethodError => e
  puts Exception.message(e)
end
variants = Array.inquiry(Any[:phone, "desktop"])
p(ActiveSupport::ArrayInquirer.phone?(variants), ActiveSupport::ArrayInquirer.tablet?(variants), ActiveSupport::ArrayInquirer.inquire(variants, :desktop?))
p(ActiveSupport::ArrayInquirer.any?(variants, :tablet, :desktop), ActiveSupport::ArrayInquirer.any?(variants), ActiveSupport::ArrayInquirer.any?(Array.inquiry(Any[])))
