# In a mixin, a bare call of a name the includers define is theirs, even when a top-level function has the name (Ruby: a call on self).
module Jar
  def purpose(j) = "cookie.#{request(j)}"
end
class CookieJar
  attr_reader request
  include Jar
end
def request(a, b) = a + b
p(Jar.purpose(CookieJar.new("a")))
