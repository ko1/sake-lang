# Run with --strict: only the unchecked uses (bad, bad_arith) are reported.
Node = Data.define(:value, :next)

def sum(n)
  total = 0
  while n
    total += Node.get_value(n)
    n = Node.get_next(n)
  end
  total
end

def second(n)
  m = Node.get_next(n)
  return 0 if m == nil
  Node.get_value(m)
end

def with_and(n)
  m = Node.get_next(n)
  m != nil && Node.get_value(m) > 0
end

def with_unless(n)
  m = Node.get_next(n)
  return 0 unless m
  Node.get_value(m) + 1
end

def with_else(n)
  m = Node.get_next(n)
  if m == nil
    0
  else
    Node.get_value(m)
  end
end

def bad(n) = Node.get_value(Node.get_next(n))

def bad_arith(n)
  m = Node.get_next(n)
  v = m && Node.get_value(m)
  v + 1
end

list = Node.new(1, Node.new(2, nil))
p([sum(list), second(list), with_and(list), with_unless(list), with_else(list), bad(list), bad_arith(list)])
