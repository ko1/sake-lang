# Port of activerecord-8.1.3/lib/arel/nodes/casted.rb (partial: no hash/eql?)
#
# Ruby's `nil?` overrides (a Casted of nil is nil? for `right.nil?` in the visitor) are `nil_value?` here:
# Sake's nil test is `x == nil` on the value itself.

module Arel
  module Nodes
    class Casted
      attr_reader value, attribute
      include NodeExpression
      def value_before_type_cast(o) = @value
      def nil_value?(o) = @value == nil
      def value_for_database(o)
        if Arel::Attributes::Attribute.able_to_type_cast?(@attribute)
          Arel::Attributes::Attribute.type_cast_for_database(@attribute, @value)
        else
          @value
        end
      end
    end

    class Quoted
      attr_accessor expr
      include Unary
      def value_for_database(o) = @expr
      def value_before_type_cast(o) = @expr
      def nil_value?(o) = @expr == nil
      def infinite?(o)
        v = @expr
        case v
        in Float then Float.infinite?(v) != nil
        else false
        end
      end
    end

    module_function

    # Ruby's Nodes.build_quoted(other, attribute = nil)
    def build_quoted(other, attribute = nil)
      case other
      in Node | Arel::Attributes::Attribute | Arel::Table | Arel::SelectManager | SqlLiteral | ActiveModel::Attribute
        other
      else
        case attribute
        in Arel::Attributes::Attribute then Casted.new(other, attribute)
        else Quoted.new(other)
        end
      end
    end
  end
end
