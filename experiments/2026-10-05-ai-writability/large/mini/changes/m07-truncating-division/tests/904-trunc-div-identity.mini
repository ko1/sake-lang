let bad = 0
let count = 0
for a in range(-12, 13) do
  for b in [-5, -3, -2, -1, 1, 2, 3, 7] do
    let q = a / b
    let r = a % b
    count += 1
    if q * b + r != a then bad += 1 end
    if r != 0 and (r < 0) != (a < 0) then bad += 1 end
    if (r < 0 and -r >= max(b, -b)) or (r > 0 and r >= max(b, -b)) then bad += 1 end
  end
end
print(count, bad)
print(-12 / 5, -12 % 5, 12 / -5, 12 % -5)
