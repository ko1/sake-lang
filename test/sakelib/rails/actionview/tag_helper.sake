require "rails/actionview/action_view/base"

view = ActionView::Base.empty
T = ActionView::Helpers::TagHelper::TagBuilder

# content_tag
puts ActionView::Base.content_tag(view, :p, "Hello world!")
puts ActionView::Base.content_tag(view, :div, ActionView::Base.content_tag(view, :p, "Hello world!"), class: "strong")
puts ActionView::Base.content_tag(view, :div, "Hello world!", class: Any["strong", "highlight"])
puts ActionView::Base.content_tag(view, :div, "Hello world!", class: Any["strong", Hash.of(highlight: true, muted: false)])
puts ActionView::Base.content_tag(view, "select", "", multiple: true)
puts ActionView::Base.content_tag(view, :p, "<script>alert(1)</script>")
puts ActionView::Base.content_tag(view, :p, "<b>raw</b>", nil, false)
puts ActionView::Base.content_tag(view, :div, class: "box") { "inside <block>" }
puts ActionView::Base.content_tag(view, :textarea, "text")
puts ActionView::Base.content_tag(view, :div, "x", data: Hash.of(controller: "hello", turbo_confirm: "Sure?", count: 3, list: Any[1, 2]))
puts ActionView::Base.content_tag(view, :div, "x", aria: Hash.of(label: "Close", describedby: Any["a", "b"], hidden: true))
puts ActionView::Base.content_tag(view, :a, "x", href: "/a?b=1&c=\"2\"", title: nil, disabled: false, checked: true)
# tag (legacy)
puts ActionView::Base.tag(view, :br)
puts ActionView::Base.tag(view, :br, nil, true)
puts ActionView::Base.tag(view, :input, Hash.of(type: "text", disabled: true))
puts ActionView::Base.tag(view, :img, Hash.of(src: "open & shut.png"))
puts ActionView::Base.tag(view, :img, Hash.of(src: "open &amp; shut.png"), false, false)
# tag builder
tb = ActionView::Base.tag(view)
puts T.div(tb, "Hello", class: "greeting")
puts T.br(tb)
puts T.input(tb, type: "text", value: "<x>")
puts T.p(tb, "Escaped <b>")
puts T.p(tb, "Not escaped <b>", escape: false)
puts T.span(tb, id: "s") { "block" }
puts T.circle(tb, cx: 10)
puts T.circle(tb, "c")
puts T.animate_motion(tb, dur: "10s")
puts T.element(tb, :my_widget, "custom", data: Hash.of(x: 1))
puts T.attributes(tb, Hash.of(id: "a", class: Any["b", "c"], required: true))
# token_list / class_names
puts ActionView::Base.token_list(view, "foo", Hash.of(bar: true, baz: false), Any["qux", nil], "foo")
puts ActionView::Base.class_names(view, "btn", Hash.of("btn-primary": true))
puts ActionView::Base.cdata_section(view, "<hello world>")
puts ActionView::Base.escape_once(view, "1 < 2 &amp; 3")
begin
  ActionView::Base.content_tag(view, "bad tag", "x")
rescue ArgumentError => e
  puts Exception.message(e)
end
# capture, content_for, provide
c = ActionView::Base.capture(view) { "<em>captured</em>" }
puts c, Object.html_safe?(c)
puts ActionView::Base.capture(view) { String.html_safe("<em>safe</em>") }
ActionView::Base.content_for(view, :title, "Hello")
ActionView::Base.content_for(view, :title, " <World>")
puts ActionView::Base.content_for(view, :title)
p(ActionView::Base.content_for?(view, :title), ActionView::Base.content_for?(view, :nothing))
ActionView::Base.content_for(view, :title, "Replaced", flush: true)
puts ActionView::Base.content_for(view, :title)
ActionView::Base.content_for(view, :sidebar) { "side" }
puts ActionView::Base.content_for(view, :sidebar)
ActionView::Base.provide(view, :head, "provided")
puts ActionView::Base.content_for(view, :head)
# output safety
puts ActionView::Base.raw(view, "<b>raw</b>")
puts ActionView::Base.safe_join(view, Any["<p>foo</p>", String.html_safe("<p>bar</p>")], String.html_safe("<br />"))
puts ActionView::Base.safe_join(view, Any["a", Any["b", "c"]], " & ")
puts ActionView::Base.to_sentence(view, Any["one", "<two>", String.html_safe("<b>three</b>")])
puts ActionView::Base.to_sentence(view, Any["a", "b"])
puts ActionView::Base.to_sentence(view, Any["a", "b", "c"], last_word_connector: " or ")
