# A coin turnstile: an Fsm whose moves are published on a Bus, which an audit log
# and an alarm subscribe to.

class Turnstile
  attr_reader fare, credit = 0, passed = 0
  include Hooks
  def guard?(t, name, fsm, data)
    case name
    in :paid then @credit + data >= @fare
    in :has_credit then @credit >= @fare
    end
  end
  def act(t, name, fsm, data)
    case name
    in :take_coin then @credit += data
    in :charge
      @credit -= @fare
      @passed += 1
    end
  end
  def enter(t, state, fsm, data) = puts("  [turnstile] now #{state}")
end

class Audit
  attr_reader lines = nil
  include Handler
  def initialize(a) = @lines = String[]
  def handle(a, bus, ev)
    name, data = ev
    Array.push(@lines, "#{name} #{data}")
  end
end

class Alarm
  attr_reader rings = 0
  include Handler
  def handle(al, bus, ev)
    @rings += 1
    puts("  [alarm] #{ev}")
  end
end

ts = Turnstile.new(50)
fsm = Fsm.new("gate", :locked, ts)
Fsm.allow(fsm, :locked, :coin, :unlocked, guard: :paid, action: :take_coin)
Fsm.allow(fsm, :locked, :coin, :locked, action: :take_coin)   # not enough yet
Fsm.allow(fsm, :unlocked, :push, :locked, guard: :has_credit, action: :charge)
Fsm.allow(fsm, :unlocked, :coin, :unlocked, action: :take_coin)   # extra coins kept as credit

bus = Bus.new
audit = Audit.new
alarm = Alarm.new
Bus.on(bus, :*, audit)
Bus.on(bus, :fsm_rejected, alarm)
Fsm.attach(fsm, bus)

inputs = Array[[:push, 0], [:coin, 20], [:coin, 30], [:push, 0], [:push, 0], [:coin, 100], [:push, 0], [:push, 0]]
Array.each(inputs) do |event, amount|
  puts("#{event} #{amount}:")
  Fsm.fire(fsm, event, amount)
end

puts("state=#{Fsm.state(fsm)} credit=#{Turnstile.credit(ts)} passed=#{Turnstile.passed(ts)} alarms=#{Alarm.rings(alarm)}")
puts("next events from :locked: #{Fsm.events_from(fsm, :locked)}")
puts("audit trail (#{Array.size(Audit.lines(audit))} lines):")
Array.each(Audit.lines(audit)) { puts("  #{it}") }
