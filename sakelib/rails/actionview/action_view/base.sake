# Port of actionview-8.1.3/lib/action_view/base.rb (partial: no with_empty_template_cache (compiled templates are generated functions), no instrumentation)
#
# Rails' view is an instance of an ActionView::Base subclass: helpers are its methods, assigns its instance
# variables, compiled templates its methods. Here ActionView::Base is a class with Rails' instance variables as
# fields, including Helpers and Context; an app's view class is `class BlogView < ActionView::Base` with the
# assigns as fields and the compiled templates as functions (generate/templates.sake writes it). A helper is an
# operation with the view first: `link_to(view, "Show", post)`.

require "helpers"
require "context"
require "routing_url_for"
require "lookup_context"
require "renderer/renderer"

module ActionView
  class Base
    attr_accessor lookup_context, view_renderer, current_template
    attr_accessor output_buffer, view_flow, virtual_path
    attr_accessor tag_builder, _cycles, routes, request
    include Helpers
    include Context
    include RoutingUrlFor

    def initialize(v)
      @view_flow = OutputFlow.make if @view_flow == nil
      @output_buffer = OutputBuffer.make if @output_buffer == nil
      @tag_builder = Helpers::TagHelper::TagBuilder.new(v) if @tag_builder == nil
      @lookup_context = LookupContext.make(default_view_paths(v)) if @lookup_context == nil
      @view_renderer = Renderer.new(@lookup_context || LookupContext.make(String[])) if @view_renderer == nil
    end

    # Ruby: ActionView::Base.with_view_paths(paths): a generated view class gives its paths here
    def default_view_paths(v) = String[]

    # Ruby: ActionView::Base.empty
    def empty = Base.new

    def xss_safe? = true

    # Ruby: cattr_accessor :field_error_proc (a Proc): wraps a field with errors
    def field_error_proc(v, html_tag, instance) = content_tag(v, :div, html_tag, Hash.of(class: "field_with_errors"))

    def automatically_disable_submit_tag(v) = true
    def remove_hidden_field_autocomplete(v) = false
    def prefix_partial_path_with_controller_namespace(v) = true
  end
end
