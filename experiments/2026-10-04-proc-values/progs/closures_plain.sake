# The same without stored blocks: state in Structs, the formatter as a format string.
class Counter
  attr_accessor n
  def next(c) = @n = @n + 1
end
class Logger
  attr_reader format, lines
  def info(l, msg) = Array.push(@lines, String.%(@format, ["INFO", msg]))
end
c1 = Counter.new(0)
c2 = Counter.new(10)
Counter.next(c1)
Counter.next(c1)
p Counter.next(c1)
p Counter.next(c2)
p 5 * 2 + 1
lg = Logger.new("[%s] %s", String[])
Logger.info(lg, "started")
Logger.info(lg, "done")
p lg.Logger.lines
