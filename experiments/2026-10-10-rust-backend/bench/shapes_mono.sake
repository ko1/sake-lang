# shapes.sake with one class only: the same mixin call, but every element is a Circle, so the call
# target is fixed before running (the control for the cost of dispatch).
module Shape
  def area(s) = raise NotImplementedError
  def name(s) = raise NotImplementedError
  def describe(s) = "#{Shape.name(s)}: #{Shape.area(s)}"
end

class Circle
  include Shape
  attr_reader r
  def area(c) = 3 * @r * @r
  def name(c) = "circle"
end

rounds = String.to_i(Array.fetch(ARGV, 0))
shapes = Array[]
i = 0
while i < 1000
  Array.push(shapes, Circle.new(i))
  i += 1
end
total = 0
k = 0
while k < rounds
  Array.each(shapes) { |s| total += Shape.area(s) }
  k += 1
end
puts(total)
puts(Shape.describe(Array.fetch(shapes, 1)))
