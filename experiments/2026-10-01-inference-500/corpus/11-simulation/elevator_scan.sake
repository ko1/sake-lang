Rider = Struct.new(:name, :from, :to, :called_at, :boarded_at, :arrived_at)
Car = Struct.new(:id, :floor, :dir, :riders, :stops, :moves)

def top_floor = 9

def direction_to(from, to)
  if to > from
    :up
  elsif to < from
    :down
  else
    :idle
  end
end

class Car
  def to_s(c) = "car #{@id} @#{@floor} #{@dir} load=#{Array.size(@riders)}"

  def cost(c, floor, dir)
    distance = Integer.abs(@floor - floor)
    return distance if @dir == :idle
    heading = direction_to(@floor, floor)
    return distance if heading == @dir && (dir == @dir || heading == :idle)
    distance + 2 * top_floor
  end

  def next_dir(c)
    return :idle if Set.empty?(@stops)
    ahead = Set.select(@stops) { |s| @dir == :up ? s > @floor : s < @floor }
    return @dir if @dir != :idle && Array.empty?(ahead) == false
    target = Array.min_by(Set.to_a(@stops)) { |s| Integer.abs(s - @floor) }
    direction_to(@floor, target)
  end

  def step(c, tick, waiting, done)
    @dir = next_dir(c)
    if @dir == :up
      @floor += 1
      @moves += 1
    elsif @dir == :down
      @floor -= 1
      @moves += 1
    end
    return unless Set.include?(@stops, @floor)
    Set.delete(@stops, @floor)
    leaving = Array.select(@riders) { Rider.get_to(it) == @floor }
    Array.each(leaving) do |r|
      Rider.set_arrived_at(r, tick)
      Array.push(done, r)
      puts("t=#{tick} #{Rider.get_name(r)} leaves car #{@id} at #{@floor}")
    end
    Array.delete_if(@riders) { Rider.get_to(it) == @floor }
    boarding = Array.select(waiting) { |r| Rider.get_from(r) == @floor && Rider.get_boarded_at(r) == nil }
    Array.each(boarding) do |r|
      Rider.set_boarded_at(r, tick)
      Array.push(@riders, r)
      Set.add(@stops, Rider.get_to(r))
      puts("t=#{tick} #{Rider.get_name(r)} boards car #{@id} at #{@floor} -> #{Rider.get_to(r)}")
    end
    Array.delete_if(waiting) { Rider.get_boarded_at(it) != nil }
    @dir = next_dir(c) if Set.empty?(@stops)
  end
end

def dispatch(cars, rider)
  dir = direction_to(Rider.get_from(rider), Rider.get_to(rider))
  best = Array.min_by(cars) { |c| Car.cost(c, Rider.get_from(rider), dir) }  # first car wins ties
  Set.add(Car.get_stops(best), Rider.get_from(rider))
  best
end

calls = Array[
  [0, "ann", 0, 7], [0, "ben", 5, 1], [2, "cat", 3, 9], [3, "dan", 8, 0],
  [4, "eve", 1, 4], [6, "fay", 9, 2], [7, "gus", 4, 6], [9, "hal", 0, 3],
  [11, "ivy", 6, 0], [12, "jon", 2, 8], [15, "kim", 7, 5], [16, "lou", 0, 9]
]
riders = Array.map(calls) { |t, name, from, to| Rider.new(name, from, to, t, nil, nil) }
cars = Car[Car.new("A", 0, :idle, Rider[], Set[], 0), Car.new("B", 9, :idle, Rider[], Set[], 0)]
waiting = Rider[]
done = Rider[]
pending = Array.dup(riders)

tick = 0
while tick < 60
  arriving = Array.select(pending) { Rider.get_called_at(it) == tick }
  Array.each(arriving) do |r|
    car = dispatch(cars, r)
    Array.push(waiting, r)
    puts("t=#{tick} #{Rider.get_name(r)} calls at #{Rider.get_from(r)}, assigned #{Car.get_id(car)}")
  end
  Array.delete_if(pending) { Rider.get_called_at(it) == tick }
  Array.each(cars) do |c|
    Car.step(c, tick, waiting, done)
  end
  break if Array.empty?(pending) && Array.empty?(waiting) && Array.all?(cars) { Array.empty?(Car.get_riders(it)) }
  tick += 1
end

puts("--- finished at t=#{tick}")
Array.each(cars) { puts(it) }
total_wait = 0
total_ride = 0
Array.each(Array.sort_by(done) { Rider.get_name(it) }) do |r|
  wait = Rider.get_boarded_at(r) - Rider.get_called_at(r)
  ride = Rider.get_arrived_at(r) - Rider.get_boarded_at(r)
  total_wait += wait
  total_ride += ride
  puts(format("%-4s %d->%d wait %2d ride %2d", Rider.get_name(r), Rider.get_from(r), Rider.get_to(r), wait, ride))
end
n = Array.size(done)
puts(format("avg wait %.2f, avg ride %.2f, moves %s", total_wait / Integer.to_f(n), total_ride / Integer.to_f(n),
  Array.join(Array.map(cars) { |c| "#{Car.get_id(c)}=#{Car.get_moves(c)}" }, " ")))
unserved = Array.select(riders) { Rider.get_arrived_at(it) == nil }
puts("unserved: #{Array.size(unserved)}")
