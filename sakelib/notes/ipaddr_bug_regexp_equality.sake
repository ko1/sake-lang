# Status (2026-10-05): fixed.
# Regexp == Regexp is always false, even for the same object; Ruby gives true for equal source and
# options. Array.include? (same equality, per spec §8.1) finds it, so the two disagree.
r = /a/
p(r == r)                          # Sake: false, Ruby: true
p(/a/ == /a/)                      # Sake: false, Ruby: true
p Array.include?(Array[r], /a/)    # Sake: true
