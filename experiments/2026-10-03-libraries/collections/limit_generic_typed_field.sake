# Same as limit_generic_field.sake, but each Box gets its own typed Array (Integer[] / String[]):
# the push into Integer[] is still reported, because the field holds Integer[] | String[].
# One Struct type used with two element types in one program: the field's element type is
# inferred once per definition, so each Box sees both Integer and String.
class Box < {reader: [items]}
  def create = Box.new(Array[])
  def add(b, x) = Array.push(@items, x)
  def smallest(b) = Array.reduce(@items, Array.fetch(@items, 0)) { |m, x| x < m ? x : m }
end

ints = Box.new(Integer[])
Box.add(ints, 3)
Box.add(ints, 1)
strs = Box.new(String[])
Box.add(strs, "b")
Box.add(strs, "a")
p(Box.smallest(ints))
p(Box.smallest(strs))
