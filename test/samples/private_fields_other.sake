# A private field is read and written by the functions of its class, on any of its values
class Unit
  private attr_accessor num
  def mul(a, b) = Unit.new(@num * b.Unit.num)
  def bump(a, b) = b.Unit.num += 1
  def show(u) = p(@num)
end
a = Unit.new(2)
b = Unit.new(3)
Unit.show(Unit.mul(a, b))
Unit.bump(a, b)
Unit.show(b)
