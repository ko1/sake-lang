# Ruby (db/schema.rb):
#   ActiveRecord::Schema[8.1].define(version: 2026_10_12_000001) do
#     create_table "posts", force: :cascade do |t|
#       t.string "title"
#       t.text "body"
#       t.timestamps
#     end
#     create_table "comments", force: :cascade do |t|
#       t.string "commenter"
#       t.text "body"
#       t.references "post", null: false, foreign_key: true
#       t.timestamps
#     end
#   end
class ActiveRecord::Schema
  def define(s)
    create_table s, "posts" do |t|
      string t, "title"
      text t, "body"
      timestamps t
    end
    create_table s, "comments" do |t|
      string t, "commenter"
      text t, "body"
      references t, "post"
      timestamps t
    end
  end
end
