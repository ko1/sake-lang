def pct(v, a)
  return "0.0%" if a == 0
  t = (2000 * v + a) / (2 * a)
  "#{t / 10}.#{t % 10}%"
end

lines = Array.map(String.split(IO.read(IO.stdin), "\n")) { |l| String.chomp(l) }
cands = Array[]
if Array.size(lines) > 0
  Array.each(String.split(lines[0])) do |nm|
    Array.push(cands, nm) unless Array.include?(cands, nm)
  end
end

if Array.size(cands) == 0
  puts("no candidates")
else
  ballots = Array[]
  rej = 0
  i = 1
  while i < Array.size(lines)
    line = lines[i]
    no = i + 1
    i += 1
    next if String.strip(line) == ""
    segs = String.split(line, ">", -1)
    names = Array.map(segs) { |sg| String.strip(sg) }
    reason = nil
    seen = Array[]
    Array.each(names) do |nm|
      if reason == nil
        if nm == ""
          reason = "empty rank"
        elsif !Array.include?(cands, nm)
          reason = "unknown candidate #{nm}"
        elsif Array.include?(seen, nm)
          reason = "duplicate #{nm}"
        else
          Array.push(seen, nm)
        end
      end
    end
    if reason == nil
      Array.push(ballots, names)
    else
      puts("rejected line #{no}: #{reason}")
      rej += 1
    end
  end

  nv = Array.size(ballots)
  puts("ballots: #{nv} valid, #{rej} rejected")

  cont = Array.dup(cands)
  history = Hash[]
  Array.each(cands) { |nm| history[nm] = Array[] }
  k = 0
  while true
    k += 1
    cnt = Hash[]
    Array.each(cont) { |nm| cnt[nm] = 0 }
    exhausted = 0
    Array.each(ballots) do |b|
      pick = nil
      Array.each(b) do |nm|
        pick = nm if pick == nil && Hash.key?(cnt, nm)
      end
      if pick == nil
        exhausted += 1
      else
        cnt[pick] += 1
      end
    end
    active = nv - exhausted
    Array.each(cont) { |nm| Array.push(history[nm], cnt[nm]) }

    puts("round #{k}")
    sorted = Array.sort_by(cont) { |nm| [-cnt[nm], nm] }
    Array.each(sorted) { |nm| puts("  #{nm} #{cnt[nm]} #{pct(cnt[nm], active)}") }
    puts("  exhausted #{exhausted}")
    if active == 0
      puts("no winner")
      break
    end
    winner = nil
    Array.each(cont) { |nm| winner = nm if cnt[nm] * 2 > active }
    if winner != nil
      puts("winner #{winner}")
      break
    end

    mn = Array.min(Array.map(cont) { |nm| cnt[nm] })
    tied = Array.select(cont) { |nm| cnt[nm] == mn }
    r = k - 2
    while Array.size(tied) > 1 && r >= 0
      m2 = Array.min(Array.map(tied) { |nm| history[nm][r] })
      tied = Array.select(tied) { |nm| history[nm][r] == m2 }
      r -= 1
    end
    elim = Array.max(tied)
    puts("  eliminated #{elim}")
    cont = Array.select(cont) { |nm| nm != elim }
  end
end
