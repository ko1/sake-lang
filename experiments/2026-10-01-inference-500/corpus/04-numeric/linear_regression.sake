Obs = Struct.new(:site, :temp, :yield_kg)
Fit = Struct.new(:slope, :intercept, :r2, :se_slope, :n)

class Fit
  def predict(f, x) = @intercept + @slope * x
  def to_s(f) = format("y = %.4f + %.4f x  (r^2=%.4f, se=%.4f, n=%d)", @intercept, @slope, @r2, @se_slope, @n)
end

def least_squares(xs, ys)
  n = Array.size(xs)
  return nil if n < 3
  mx = Array.sum(xs) / n
  my = Array.sum(ys) / n
  sxx = 0.0
  sxy = 0.0
  syy = 0.0
  Array.each(Array.zip(xs, ys)) do |x, y|
    sxx += (x - mx) ** 2
    sxy += (x - mx) * (y - my)
    syy += (y - my) ** 2
  end
  return nil if sxx == 0.0
  slope = sxy / sxx
  intercept = my - slope * mx
  sse = Array.sum(Array.map(Array.zip(xs, ys)) { |x, y| (y - intercept - slope * x) ** 2 })
  r2 = 1.0 - sse / syy
  se = Math.sqrt(sse / (n - 2) / sxx)
  Fit.new(slope, intercept, r2, se, n)
end

def weighted_fit(xs, ys, ws)
  sw = Array.sum(ws)
  mx = Array.sum(Array.map(Array.zip(xs, ws)) { |x, w| x * w }) / sw
  my = Array.sum(Array.map(Array.zip(ys, ws)) { |y, w| y * w }) / sw
  num = 0.0
  den = 0.0
  Array.each_with_index(xs) do |x, i|
    num += ws[i] * (x - mx) * (ys[i] - my)
    den += ws[i] * (x - mx) ** 2
  end
  slope = num / den
  [slope, my - slope * mx]
end

data = Obs[
  Obs.new("north", 14.2, 310.0), Obs.new("north", 15.8, 342.5), Obs.new("north", 17.1, 360.2),
  Obs.new("north", 18.4, 391.0), Obs.new("north", 19.9, 405.8), Obs.new("north", 21.3, 441.1),
  Obs.new("south", 22.5, 512.4), Obs.new("south", 24.1, 530.0), Obs.new("south", 25.0, 548.9),
  Obs.new("south", 26.7, 551.3), Obs.new("south", 28.2, 590.6), Obs.new("south", 29.0, 588.1),
  Obs.new("south", 30.4, 499.7),
  Obs.new("valley", 19.0, 400.0), Obs.new("valley", 19.0, 410.0),
  Obs.new("coast", 18.0, 380.0), Obs.new("coast", 18.0, 375.0), Obs.new("coast", 18.0, 390.0)
]

groups = Array.group_by(data) { |o| Obs.get_site(o) }
fits = Hash[]
Hash.each(groups) do |site, obs|
  xs = Array.map(obs) { |o| Obs.get_temp(o) }
  ys = Array.map(obs) { |o| Obs.get_yield_kg(o) }
  f = least_squares(xs, ys)
  if f
    fits[site] = f
    puts("#{site}: #{f}")
    worst = Array.max_by(obs) { |o| Float.abs(Obs.get_yield_kg(o) - Fit.predict(f, Obs.get_temp(o))) }
    puts(format("  largest residual at %.1f C: %+.2f", Obs.get_temp(worst), Obs.get_yield_kg(worst) - Fit.predict(f, Obs.get_temp(worst))))
  else
    puts("#{site}: not enough spread to fit (#{Array.size(obs)} points)")
  end
end

all_x = Array.map(data) { |o| Obs.get_temp(o) }
all_y = Array.map(data) { |o| Obs.get_yield_kg(o) }
pooled = least_squares(all_x, all_y)
puts("pooled: #{pooled}") if pooled

# down-weight the suspicious last south reading and refit
south = groups["south"]
if south
  ws = Array.map(south) { |o| Obs.get_temp(o) > 30.0 ? 0.1 : 1.0 }
  slope, intercept = weighted_fit(Array.map(south) { |o| Obs.get_temp(o) }, Array.map(south) { |o| Obs.get_yield_kg(o) }, ws)
  puts(format("south weighted: y = %.4f + %.4f x", intercept, slope))
end

puts("predictions at 23.0 C:")
Array.each(Array.sort_by(Hash.to_a(fits)) { |site, f| 0.0 - Fit.predict(f, 23.0) }) do |site, f|
  puts(format("  %-6s %8.2f", site, Fit.predict(f, 23.0)))
end

best = Hash.max_by(fits) { |site, f| Fit.get_r2(f) }
if best
  site, f = best
  puts("best linear fit: #{site}")
end
missing = Array.reject(Array["north", "south", "valley", "coast", "east"]) { |s| Hash.key?(fits, s) }
puts("no fit for: #{Array.join(missing, ", ")}")
