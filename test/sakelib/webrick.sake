require "webrick"
require "net_http"

# --- handlers: a type per mount_proc block; its fields are what the block closed over ---
class Hello
  attr_reader greeting
  include WEBrick::HTTPHandler
  def call(h, req, res)
    res["Content-Type"] = "text/plain"
    res.WEBrick::HTTPResponse.body = "#{@greeting}, #{WEBrick::HTTPRequest.query(req)["name"] || "world"}!\n"
  end
end

class Echo
  include WEBrick::HTTPHandler
  def call(h, req, res)
    WEBrick::HTTPResponse.set_content_type(res, "text/plain")
    q = WEBrick::HTTPRequest.query(req)
    body = WEBrick::HTTPRequest.body(req)
    res.WEBrick::HTTPResponse.body = "#{WEBrick::HTTPRequest.request_method(req)} script=#{WEBrick::HTTPRequest.script_name(req)} info=#{WEBrick::HTTPRequest.path_info(req)} path=#{WEBrick::HTTPRequest.path(req)} qs=#{Kernel.inspect(WEBrick::HTTPRequest.query_string(req))} q=#{Kernel.inspect(Hash.sort_by(q) { |k, v| k })} ct=#{Kernel.inspect(WEBrick::HTTPRequest.content_type(req))} len=#{Kernel.inspect(req["content-length"])} body=#{Kernel.inspect(body)} token=#{Kernel.inspect(req["X-Token"])} host=#{Kernel.inspect(WEBrick::HTTPRequest.host(req))}"
  end
end

class Created
  attr_reader code
  include WEBrick::HTTPHandler
  def call(h, req, res)
    WEBrick::HTTPResponse.set_status(res, @code)
    res["X-Reason"] = WEBrick::HTTPResponse.reason_phrase(res) || ""
    res.WEBrick::HTTPResponse.body = "made" if @code == 201
  end
end

class Redirector
  attr_reader to
  include WEBrick::HTTPHandler
  def call(h, req, res) = WEBrick::HTTPResponse.set_redirect(res, 302, @to)
end

class Boom
  include WEBrick::HTTPHandler
  def call(h, req, res) = raise("kaboom")
end

class Teapot
  include WEBrick::HTTPHandler
  def call(h, req, res) = raise(WEBrick::HTTPStatus.error(422, "short and stout"))
end

srv = WEBrick::HTTPServer.new("127.0.0.1", 0)
port = WEBrick::HTTPServer.port(srv)
p(WEBrick::HTTPServer.status(srv))
WEBrick::HTTPServer.mount(srv, "/hello", Hello.new("Hi"))
WEBrick::HTTPServer.mount_proc(srv, "/echo", Echo.new)
WEBrick::HTTPServer.mount(srv, "/echo/deeper", Created.new(201))
WEBrick::HTTPServer.mount(srv, "/nothing", Created.new(204))
WEBrick::HTTPServer.mount(srv, "/go", Redirector.new("/hello?name=there"))
WEBrick::HTTPServer.mount(srv, "/boom", Boom.new)
WEBrick::HTTPServer.mount(srv, "/teapot", Teapot.new)
t = Thread.new { WEBrick::HTTPServer.start(srv) }

def url(port, path) = URI.parse("http://127.0.0.1:#{port}#{path}")

def show(res)
  body = Net::HTTPResponse.body(res)
  puts("#{Net::HTTPResponse.code(res)} #{Net::HTTPResponse.message(res)} type=#{Kernel.inspect(res["content-type"])} length=#{Kernel.inspect(res["content-length"])} body=#{Kernel.inspect(body)}")
end

puts("-- GET")
show(Net::HTTP.get_response(url(port, "/hello")))
show(Net::HTTP.get_response(url(port, "/hello?name=Sake&name=two")))
show(Net::HTTP.get_response(url(port, "/hello/")))
show(Net::HTTP.get_response(url(port, "/echo")))
show(Net::HTTP.get_response(url(port, "/echo/sub/path?x=1&y=a+b%21")))
show(Net::HTTP.get_response(url(port, "/echo/deeper/x")))
show(Net::HTTP.get_response(url(port, "/echo"), Hash["X-Token" => "t0k"]))

puts("-- POST")
show(Net::HTTP.post_form(url(port, "/echo"), Hash["k" => "v w", "n" => "1"]))
show(Net::HTTP.post(url(port, "/echo"), "{\"a\":1}", Hash["Content-Type" => "application/json"]))

puts("-- HEAD, 204, redirect, errors")
res = Net::HTTP.start("127.0.0.1", port) { |http| Net::HTTP.head(http, "/hello") }
show(res)
show(Net::HTTP.get_response(url(port, "/nothing")))
res = Net::HTTP.get_response(url(port, "/go"))
puts("#{Net::HTTPResponse.code(res)} location=#{String.sub(res["location"] || "", /:\d+\//, ":PORT/")} body=#{Kernel.inspect(Net::HTTPResponse.body(res))}")
res = Net::HTTP.get_response(url(port, "/echo/deeper"))
puts("#{Net::HTTPResponse.code(res)} #{Net::HTTPResponse.message(res)} reason=#{res["x-reason"]} body=#{Kernel.inspect(Net::HTTPResponse.body(res))}")
res = Net::HTTP.get_response(url(port, "/missing"))
puts("#{Net::HTTPResponse.code(res)} #{Net::HTTPResponse.message(res)} type=#{res["content-type"]} html=#{String.include?(Net::HTTPResponse.body(res) || "", "<H1>Not Found</H1>")} path=#{String.include?(Net::HTTPResponse.body(res) || "", "'/missing' not found.")}")
res = Net::HTTP.get_response(url(port, "/boom"))
puts("#{Net::HTTPResponse.code(res)} #{Net::HTTPResponse.message(res)} kaboom=#{String.include?(Net::HTTPResponse.body(res) || "", "kaboom")}")
res = Net::HTTP.get_response(url(port, "/teapot"))
puts("#{Net::HTTPResponse.code(res)} #{Net::HTTPResponse.message(res)} msg=#{String.include?(Net::HTTPResponse.body(res) || "", "short and stout")}")

res = Net::HTTP.start("127.0.0.1", port) { |http| Net::HTTP.patch(http, "/echo", "x", Hash["Content-Type" => "text/plain"]) }
puts("#{Net::HTTPResponse.code(res)} #{Net::HTTPResponse.message(res)} msg=#{String.include?(Net::HTTPResponse.body(res) || "", "unsupported method &#39;PATCH&#39;.") || String.include?(Net::HTTPResponse.body(res) || "", "unsupported method 'PATCH'.")}")
res = Net::HTTP.start("127.0.0.1", port) { |http| Net::HTTP.put(http, "/echo", "x", Hash["Content-Type" => "text/plain"]) }
show(res)
res = Net::HTTP.start("127.0.0.1", port) { |http| Net::HTTP.send_request(http, "OPTIONS", "/echo") }
puts("#{Net::HTTPResponse.code(res)} allow=#{res["allow"]} body=#{Kernel.inspect(Net::HTTPResponse.body(res))}")

puts("-- raw HTTP/1.0 and a bad request")
c = Socket.connect("127.0.0.1", port)
Socket.write(c, "GET /hello?name=raw HTTP/1.0\r\n\r\n")
Socket.close_write(c)
status = Socket.gets(c) || ""
rest = String[]
l = Socket.gets(c)
while l != nil
  Array.push(rest, l)
  l = Socket.gets(c)
end
Socket.close(c)
puts(String.chomp(status))
puts(Array.last(rest) || "")
c = Socket.connect("127.0.0.1", port)
Socket.write(c, "NOT A REQUEST\r\n\r\n")
Socket.close_write(c)
puts(String.chomp(Socket.gets(c) || ""))
Socket.close(c)

puts("-- unmount, shutdown")
WEBrick::HTTPServer.unmount(srv, "/hello")
res = Net::HTTP.get_response(url(port, "/hello"))
puts("#{Net::HTTPResponse.code(res)} #{Net::HTTPResponse.message(res)} type=#{res["content-type"]}")
p(WEBrick::HTTPServer.status(srv))
WEBrick::HTTPServer.shutdown(srv)
Thread.join(t)
p(WEBrick::HTTPServer.status(srv))
begin
  Net::HTTP.get_response(url(port, "/hello"))
  puts("still up?")
rescue IOError
  puts("refused")
end

puts("-- WEBrick::HTTPStatus, WEBrick::HTTPUtils")
p([WEBrick::HTTPStatus.reason_phrase(200), WEBrick::HTTPStatus.reason_phrase(422), WEBrick::HTTPStatus.reason_phrase(599)])
p([WEBrick::HTTPStatus.success?(204), WEBrick::HTTPStatus.redirect?(301), WEBrick::HTTPStatus.client_error?(404), WEBrick::HTTPStatus.server_error?(503), WEBrick::HTTPStatus.error?(200)])
p(WEBrick::HTTPUtils.parse_query("a=1&b=x+y%21&a=2;c&=d"))
p(WEBrick::HTTPUtils.parse_query(nil))
p([WEBrick::HTTPUtils.escape_form("a b&c!"), WEBrick::HTTPUtils.unescape_form("a+b%26c"), WEBrick::HTTPUtils.escape("a b/c?d\"é"), WEBrick::HTTPUtils.unescape("a%20b"), WEBrick::HTTPUtils.escape_path("/a b/c?d=é/:x")])
p([WEBrick::HTTPUtils.mime_type("index.html"), WEBrick::HTTPUtils.mime_type("x.PNG"), WEBrick::HTTPUtils.mime_type("Makefile")])
puts("end")
