# Port of activesupport-8.1.3/lib/active_support/core_ext/array/conversions.rb (partial: no to_xml, no I18n connectors)

class Array
  def to_sentence(xs, words_connector: ", ", two_words_connector: " and ", last_word_connector: ", and ")
    case Array.length(xs)
    in 0 then ""
    in 1 then "#{xs[0]}"
    in 2 then "#{xs[0]}#{two_words_connector}#{xs[1]}"
    else "#{Array.join(Array.[](xs, 0...-1) || Any[], words_connector)}#{last_word_connector}#{xs[-1]}"
    end
  end

  # Ruby: to_fs(:db) joins the elements' ids; here the elements are the ids (no `id` to call).
  def to_fs(xs, format = :default)
    case format
    in :db then Array.empty?(xs) ? "null" : Array.join(xs, ",")
    else Kernel.to_s(xs)
    end
  end

  def to_formatted_s(xs, format = :default) = Array.to_fs(xs, format)
end
