module Sql
  class AggregateSlots
    attr_reader calls: Array[Ast::Aggregate]

    @width: Integer
    @by_signature: Hash[String, Ast::Aggregate]

    def initialize: (Integer width) -> void
    def empty?: () -> bool
    def width: () -> Integer
    def add: (String name, String function, Array[Ast::Expr] args, bool distinct, bool star, Array[Ast::OrderTerm] order_by) -> Ast::Aggregate
  end
end
