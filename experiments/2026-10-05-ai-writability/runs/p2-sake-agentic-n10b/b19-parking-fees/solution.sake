def money(c) = "#{c / 100}.#{String.rjust(Integer.to_s(c % 100), 2, "0")}"

def part(r, first, step)
  return 0 if r == 0
  extra = r > 60 ? r - 60 : 0
  first + step * ((extra + 29) / 30)
end

def fee(stay, first, step, cap, grace)
  return 0 if stay <= grace
  d = stay / 1440
  r = stay % 1440
  p1 = part(r, first, step)
  d * cap + (p1 < cap ? p1 : cap)
end

lines = Array.map(String.lines(IO.read(IO.stdin))) { |l| String.chomp(l) }
hf = String.split(lines[0])
first = String.to_i(hf[1])
step = String.to_i(hf[2])
cap = String.to_i(hf[3])
grace = String.to_i(hf[4])

inside = Hash[]
exits = Hash.new(0)
revenue = Hash.new(0)
out = String[]
day = 0
prev = -1

Array.each_with_index(lines) do |raw, idx|
  next if idx == 0
  f = String.split(raw)
  next if Array.empty?(f)
  n = idx + 1
  m = Array.size(f) == 3 ? String.match(f[0], /\A([01][0-9]|2[0-3]):([0-5][0-9])\z/) : nil
  if m == nil || (f[1] != "IN" && f[1] != "OUT") || !String.match?(f[2], /\A[A-Z0-9]{1,8}\z/)
    Array.push(out, "line #{n}: invalid")
    next
  end
  tod = String.to_i(m[1]) * 60 + String.to_i(m[2])
  day += 1 if tod < prev
  prev = tod
  now = day * 1440 + tod
  plate = f[2]
  if f[1] == "IN"
    if Hash.key?(inside, plate)
      Array.push(out, "line #{n}: #{plate} already inside")
    else
      inside[plate] = now
    end
  elsif !Hash.key?(inside, plate)
    Array.push(out, "line #{n}: #{plate} not inside")
  else
    stay = now - inside[plate]
    Hash.delete(inside, plate)
    c = fee(stay, first, step, cap, grace)
    exits[plate] += 1
    revenue[plate] += c
    Array.push(out, "#{plate} #{stay / 60}:#{String.rjust(Integer.to_s(stay % 60), 2, "0")} #{money(c)}")
  end
end

Array.push(out, "--- summary")
plates = Array.sort_by(Hash.keys(exits)) { |pl| [-revenue[pl], pl] }
te = 0
tr = 0
Array.each(plates) do |pl|
  Array.push(out, "#{pl} #{exits[pl]} #{money(revenue[pl])}")
  te += exits[pl]
  tr += revenue[pl]
end
Array.push(out, "total #{te} #{money(tr)}")
ins = Array.sort(Hash.keys(inside))
Array.push(out, "inside: " + (Array.empty?(ins) ? "none" : Array.join(ins, ", ")))
puts(*out)
