# active_support_core_ext: ActiveSupport's core extensions, now in the Rails tree (sakelib/rails/activesupport/).
#
# The tree adds them to the classes Rails extends (`String.squish(s)`, `Array.in_groups_of(xs, 3)`,
# `Integer.hours(2)`, `Object.blank?(x)` for any value). The flat port's names (2026-10-09) are kept as aliases.

require "rails/activesupport/active_support/core_ext"
require "rails/activesupport/active_support/time"
require "active_support_inflector"

StringExt = String
ArrayExt = Array
HashExt = Hash
IntegerExt = Integer
NumericExt = Numeric
Blank = Object
SoleItemExpectedError = Enumerable::SoleItemExpectedError
