def collatz_steps(n)
  steps = 0
  while n != 1
    if Integer.even?(n)
      n = n / 2
    else
      n = 3 * n + 1
    end
    steps += 1
  end
  steps
end

best_n = 1
best_steps = 0
Integer.upto(1, 30) { |n|
  s = collatz_steps(n)
  if s > best_steps
    best_n = n
    best_steps = s
  end
}
puts(String.+("max steps: n=", String.+(Integer.to_s(best_n), String.+(" steps=", Integer.to_s(best_steps)))))

def gcd(a, b)
  return a if b == 0
  gcd(b, a % b)
end

def lcm(a, b) = a / gcd(a, b) * b

puts(String.+("gcd(84, 36) = ", Integer.to_s(gcd(84, 36))))
puts(String.+("lcm(84, 36) = ", Integer.to_s(lcm(84, 36))))
