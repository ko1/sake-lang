# jwt: the ruby-jwt gem (3.2) in Sake: HS256/HS384/HS512 and none, encode / decode, the registered
# claims (exp, nbf, iat, iss, aud, sub, jti) with the gem's error names and messages.
#
#   token = JWT.encode(Hash["sub" => "1", "iat" => 1516239022], "secret", "HS256")
#   payload, header = JWT.decode(token, "secret", true, algorithm: "HS256")
#
# HMAC is written here over sakelib/digest.sake's SHA256/SHA384/SHA512 (RFC 2104); Base64url over the
# built-in "m0" pack format; JSON is sakelib/json.sake (keys in the order given, as the gem's
# JSON.generate), so a token is byte for byte the gem's.
#
# The gem's exception classes all descend from JWT::DecodeError; Sake has no hierarchy, so each is its
# own type (JWT::ExpiredSignature -> JWTExpiredSignature) and `rescue JWTDecodeError` catches only that
# one. JWT.decode_error?(e) tells whether e is any of them, for a `rescue => e`.
#
# Ruby's options Hash is keywords: JWT.decode(token, key, true, algorithm: "HS512", leeway: 10).

require "digest"
require "json"

class JWTDecodeError < Exception
end
class JWTEncodeError < Exception
end
class JWTVerificationError < Exception
end
class JWTExpiredSignature < Exception
end
class JWTImmatureSignature < Exception
end
class JWTInvalidIatError < Exception
end
class JWTIncorrectAlgorithm < Exception
end
class JWTInvalidIssuerError < Exception
end
class JWTInvalidAudError < Exception
end
class JWTInvalidSubError < Exception
end
class JWTInvalidJtiError < Exception
end
class JWTInvalidPayload < Exception
end
class JWTBase64DecodeError < Exception
end

module JWT
  module_function

  # ---- Base64url (RFC 7515 §2) ----

  def base64url_encode(s) = String.delete(String.tr(Array.pack(Array[s], "m0"), "+/", "-_"), "=")

  # The gem's JWT::Base64.url_decode: pads, then decodes strictly.
  def base64url_decode(s)
    t = String.tr(s, "-_", "+/")
    r = String.length(t) % 4
    raise JWTBase64DecodeError, "Invalid base64 encoding" if r == 1
    t += "=" * (4 - r) if r > 0
    begin
      String.unpack1(t, "m0") || ""
    rescue ArgumentError => e
      raise JWTBase64DecodeError, "Invalid base64 encoding"
    end
  end

  # ---- HMAC (RFC 2104) over digest.sake ----

  # The key, hashed when longer than the block, zero-padded to the block, xored with pad.
  def hmac_key(key, block, pad)
    k = String.bytesize(key) > block ? yield(key) : String.b(key)
    bytes = String.bytes(k)
    Array.push(bytes, 0) while Array.size(bytes) < block
    Array.pack(Array.map(bytes) { |b| b ^ pad }, "C*")
  end

  def hmac_sha256(key, msg)
    inner = SHA256.digest(hmac_key(key, 64, 0x36) { |k| SHA256.digest(k) } + String.b(msg))
    SHA256.digest(hmac_key(key, 64, 0x5c) { |k| SHA256.digest(k) } + inner)
  end

  def hmac_sha384(key, msg)
    inner = SHA384.digest(hmac_key(key, 128, 0x36) { |k| SHA384.digest(k) } + String.b(msg))
    SHA384.digest(hmac_key(key, 128, 0x5c) { |k| SHA384.digest(k) } + inner)
  end

  def hmac_sha512(key, msg)
    inner = SHA512.digest(hmac_key(key, 128, 0x36) { |k| SHA512.digest(k) } + String.b(msg))
    SHA512.digest(hmac_key(key, 128, 0x5c) { |k| SHA512.digest(k) } + inner)
  end

  def algorithms = Array["HS256", "HS384", "HS512", "none"]

  # The gem matches algorithm names case-insensitively and writes the canonical name in the header.
  def canonical_alg(name)
    u = String.upcase(name)
    u == "NONE" ? "none" : u
  end

  # The signature of the signing input for alg; "" for none.
  def sign(alg, key, input)
    return "" if alg == "none"
    raise JWTDecodeError, "No verification key available" if key == nil
    raise JWTDecodeError, "HMAC key cannot be empty" if key == ""
    case alg
    in "HS256" then hmac_sha256(key, input)
    in "HS384" then hmac_sha384(key, input)
    in "HS512" then hmac_sha512(key, input)
    else raise JWTEncodeError, "Unsupported signing method"
    end
  end

  # ---- claims ----

  # Ruby's class name of a JSON value, for the gem's messages.
  def type_name(v)
    case v
    in String then "String"
    in Array then "Array"
    in Hash then "Hash"
    in true then "TrueClass"
    in false then "FalseClass"
    in nil then "NilClass"
    in Symbol then "Symbol"
    else "Object"
    end
  end

  # exp, nbf, iat must be numbers when present (the gem checks this at encode and at decode).
  def validate_numeric_claims(payload)
    Array.each(Array["exp", "nbf", "iat"]) do |name|
      next unless Hash.key?(payload, name)
      v = payload[name]
      next if v in Integer | Float | Rational
      raise JWTInvalidPayload, "#{name} claim must be a Numeric value but it is a #{type_name(v)}"
    end
    nil
  end

  # The claim as the gem's `payload[name].to_i` reads it at decode: a String gives its leading digits.
  def numeric_claim(payload, name)
    v = payload[name]
    case v
    in Integer | Float | Rational then Arithmetic.to_i(v)
    in String then String.to_i(v)
    in nil then 0
    else raise JWTInvalidPayload, "#{name} claim must be a Numeric value but it is a #{type_name(v)}"
    end
  end

  # expected (a String, or an Array of them) matched against the claim, which may be an Array (aud).
  def claim_matches?(expected, actual)
    exp = (expected in Array) ? expected : Array[expected]
    act = (actual in Array) ? actual : Array[actual]
    Array.any?(exp) { |e| Array.include?(act, e) }
  end

  def shown(v) = v == nil ? "<none>" : Kernel.to_s(v)

  # The gem's verifiers, in its order; leeway applies where the claim's own leeway is not given.
  def verify_claims(payload, now, leeway, exp_leeway, nbf_leeway, verify_expiration,
                    verify_not_before, verify_iat, verify_iss, iss, verify_aud, aud, verify_sub, sub,
                    verify_jti)
    if verify_expiration && Hash.key?(payload, "exp")
      l = exp_leeway == nil ? leeway : exp_leeway
      raise JWTExpiredSignature, "Signature has expired" if numeric_claim(payload, "exp") <= now - l
    end
    if verify_not_before && Hash.key?(payload, "nbf")
      l = nbf_leeway == nil ? leeway : nbf_leeway
      raise JWTImmatureSignature, "Signature nbf has not been reached" if numeric_claim(payload, "nbf") > now + l
    end
    if verify_iat && Hash.key?(payload, "iat")
      # The gem (3.2) applies no leeway to iat, whatever leeway: or iat_leeway: says.
      iat = payload["iat"]
      raise JWTInvalidIatError, "Invalid iat" unless iat in Integer | Float | Rational
      raise JWTInvalidIatError, "Invalid iat" if Arithmetic.to_i(iat) > now
    end
    if verify_iss
      actual = payload["iss"]
      unless claim_matches?(iss, actual)
        expected = (iss in Array) ? iss : Array[iss]
        raise JWTInvalidIssuerError, "Invalid issuer. Expected #{Kernel.inspect(expected)}, received #{shown(actual)}"
      end
    end
    if verify_aud
      actual = payload["aud"]
      unless claim_matches?(aud, actual)
        raise JWTInvalidAudError, "Invalid audience. Expected #{shown(aud)}, received #{shown(actual)}"
      end
    end
    if verify_sub
      actual = payload["sub"]
      raise JWTInvalidSubError, "Invalid subject. Expected #{shown(sub)}, received #{shown(actual)}" if actual != sub
    end
    if verify_jti
      jti = payload["jti"]
      raise JWTInvalidJtiError, "Missing jti" if jti == nil || jti == ""
    end
    nil
  end

  # ---- encode / decode ----

  # JWT.encode(payload, key, algorithm = "HS256", header_fields = nil): payload a Hash (String or
  # Symbol keys, written in order), header_fields a Hash put before "alg" in the header, as the gem.
  def encode(payload, key, algorithm = "HS256", header_fields = nil)
    alg = canonical_alg(algorithm)
    raise JWTEncodeError, "Unsupported signing method" unless Array.include?(algorithms, alg)
    validate_numeric_claims(payload)
    header = Hash[]
    Hash.each(header_fields) { |k, v| header[Kernel.to_s(k)] = v } if header_fields != nil
    header["alg"] = alg
    input = base64url_encode(JSON.generate(header)) + "." + base64url_encode(JSON.generate(payload))
    input + "." + base64url_encode(sign(alg, key, input))
  end

  # A segment's JSON object; the gem's DecodeError when it is not one.
  def segment_object(s)
    v = begin
      JSON.parse(String.force_encoding(base64url_decode(s), "UTF-8"))
    rescue JSONParserError => e
      raise JWTDecodeError, "Invalid segment encoding"
    end
    v => Hash
    v
  end

  # The gem's validate_segment_count!: 3 segments, or 2 without verification or with alg none.
  def validate_segment_count(segments, verify)
    n = Array.size(segments)
    return nil if n == 3
    return nil if n == 2 && !verify
    return nil if n == 2 && segment_object(Array.fetch(segments, 0))["alg"] == "none"
    raise JWTDecodeError, "Not enough or too many segments"
  end

  # JWT.decode(token, key = nil, verify = true, options...): [payload, header]. With verify, the
  # header's alg must be `algorithm` (or one of `algorithms`), the signature must match, and the
  # claims must hold. Ruby's options Hash is these keywords.
  def decode(token, key = nil, verify = true, algorithm: "HS256", algorithms: nil, leeway: 0,
             exp_leeway: nil, nbf_leeway: nil, verify_expiration: true,
             verify_not_before: true, verify_iat: false, verify_iss: false, iss: nil,
             verify_aud: false, aud: nil, verify_sub: false, sub: nil, verify_jti: false)
    segments = String.split(token, ".")
    validate_segment_count(segments, verify)
    n = Array.size(segments)
    header = segment_object(Array.fetch(segments, 0))
    payload = segment_object(Array.fetch(segments, 1))
    if verify
      alg = header["alg"]
      alg = canonical_alg(alg) if alg in String
      allowed = Array.map(algorithms == nil ? Array[algorithm] : algorithms) { |a| canonical_alg(a) }
      raise JWTIncorrectAlgorithm, "Expected a different algorithm" unless Array.include?(allowed, alg)
      alg => String
      signature = n == 3 ? base64url_decode(Array.fetch(segments, 2)) : ""
      input = Array.fetch(segments, 0) + "." + Array.fetch(segments, 1)
      unless alg == "none" || signature == sign(alg, key, input)
        raise JWTVerificationError, "Signature verification failed"
      end
      verify_claims(payload, Time.to_i(Time.now), leeway, exp_leeway, nbf_leeway, verify_expiration, verify_not_before, verify_iat, verify_iss, iss, verify_aud, aud,
                    verify_sub, sub, verify_jti)
    end
    [payload, header]
  end

  # True for every exception type of this library (the gem's `rescue JWT::DecodeError`).
  def decode_error?(e)
    e in JWTDecodeError | JWTVerificationError | JWTExpiredSignature | JWTImmatureSignature |
         JWTInvalidIatError | JWTIncorrectAlgorithm | JWTInvalidIssuerError | JWTInvalidAudError |
         JWTInvalidSubError | JWTInvalidJtiError | JWTInvalidPayload | JWTBase64DecodeError
  end
end
