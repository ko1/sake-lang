# strscan: StringScanner, a lexical scanner over a String (Ruby's strscan).
#
# Positions: `pos` is in bytes, as in Ruby; `charpos` is in characters. Both are kept, updated
# together, so `set_pos` must land on a character boundary.
# Matching at the scan pointer: Regexp.match(re, string, charpos) with re wrapped as \G(?:re) for the
# anchored scans; a pattern that looks before the pointer (\A, ^, \b, look-behind) is matched on a
# copy of the rest instead, where it sees the pointer as the start, as in Ruby.

class ScanError < Exception              # Ruby: StringScanner::Error (alias ScanError)
end

# StringScanner.new(s, fixed_anchor: true) as Ruby. The rest is internal: the pointer in characters and
# bytes, and the last match: its text `mstr` (nil: none), MatchData `md` (nil for a String pattern), end `mend`.
class StringScanner
  attr_reader string
  private attr_reader fixed_anchor
  private attr_reader cpos, bpos, prev_cpos, prev_bpos, mend, md, mstr
  include Indexable
  include Bitwise                          # for <<

  # Ruby: StringScanner.new(str) raises TypeError for a non-String; the pointer starts at 0.
  def initialize(ss)
    @fixed_anchor = false if @fixed_anchor == nil
    @cpos = 0
    @bpos = 0
    @prev_cpos = 0
    @prev_bpos = 0
    @mend = 0
    @md = nil
    @mstr = nil
    @string => String
    @fixed_anchor = !!@fixed_anchor
    reset(ss)
  end

  # --- internal ---

  def clear_match(ss)
    @md = nil
    @mstr = nil
    nil
  end

  def rest_string(ss) = String.byteslice(@string, @bpos, String.bytesize(@string) - @bpos) || ""

  # Record the match `mstr` spanning characters b...e of the String (absolute); returns the text
  # from the pointer to e, the result of scan and scan_until.
  def set_match(ss, b, e, mstr, m, succptr)
    @prev_cpos = @cpos
    @prev_bpos = @bpos
    @mend = e
    @md = m
    @mstr = mstr
    consumed = b == @cpos ? mstr : String.[](@string, @cpos, e - @cpos) || ""
    if succptr
      @cpos = e
      @bpos += String.bytesize(consumed)
    end
    consumed
  end

  # A pattern that looks before the pointer (\A, ^, \b, \G, look-behind) must see the String as
  # starting at the pointer, as Ruby's does: it is matched on a copy of the rest.
  def sees_before?(src) = String.match?(src, /\\[AbBG]|(?<!\[)\^|\\\[\^|\(\?<[=!]/)

  # inspect of a pattern (and fixed_anchor) => \G(?flags:source), or false: match on the rest instead.
  def anchored_table = once { Hash[] }

  # With fixed_anchor, \A and ^ see the whole String, so every pattern is matched in place.
  def anchored(pattern, fixed)
    key = Kernel.inspect(pattern)
    table = anchored_table
    found = table[[key, fixed]]
    return found if found != nil
    src = Regexp.source(pattern)
    re = false
    if fixed || !sees_before?(src)
      flags = String.[](key, (String.rindex(key, "/") || 0) + 1..) || ""
      on = Array.join(Array.select(String["m", "i", "x"]) { |f| String.include?(flags, f) })
      off = Array.join(Array.reject(String["m", "i", "x"]) { |f| String.include?(flags, f) })
      nl = String.include?(flags, "x") ? "\n" : ""
      re = Regexp.new("\\G(?#{on}#{off == "" ? "" : "-" + off}:#{src}#{nl})")
    end
    table[[key, fixed]] = re
    re
  end

  # Ruby's strscan_do_scan: headonly anchors at the pointer. Returns the String up to the match
  # end; `len` turns it into the byte length (a getstr flag would type every result String | Integer).
  def do_scan(ss, pattern, succptr, headonly)
    b = nil
    e = 0
    m = nil
    case pattern
    in String
      if headonly
        b = @cpos if String.byteslice(@string, @bpos, String.bytesize(pattern)) == pattern
      else
        b = String.index(@string, pattern, @cpos)
      end
      e = b + String.length(pattern) if b
    in Regexp
      re = anchored(pattern, @fixed_anchor)
      if re in Regexp
        m = Regexp.match(headonly ? re : pattern, @string, @cpos)
        if m
          b = headonly ? @cpos : MatchData.begin(m, 0)
          e = MatchData.end(m, 0)
        end
      else
        # matched on the rest: offsets are moved by the pointer
        m = Regexp.match(pattern, rest_string(ss))
        if m
          b = @cpos + MatchData.begin(m, 0)
          e = @cpos + MatchData.end(m, 0)
          b = nil if headonly && b != @cpos
        end
      end
    end
    if b == nil
      clear_match(ss)
      return nil
    end
    set_match(ss, b, e, m ? MatchData.to_s(m) : String.[](@string, b, e - b) || "", m, succptr)
  end

  def len(s) = s ? String.bytesize(s) : nil

  # --- scanning ---

  def scan(ss, pattern) = do_scan(ss, pattern, true, true)
  def scan_until(ss, pattern) = do_scan(ss, pattern, true, false)
  def skip(ss, pattern) = len(do_scan(ss, pattern, true, true))
  def skip_until(ss, pattern) = len(do_scan(ss, pattern, true, false))
  def match?(ss, pattern) = len(do_scan(ss, pattern, false, true))
  def check(ss, pattern) = do_scan(ss, pattern, false, true)
  def check_until(ss, pattern) = do_scan(ss, pattern, false, false)
  def exist?(ss, pattern) = len(do_scan(ss, pattern, false, false))

  # Ruby's result type depends on the flag getstr: String if true, Integer if false.
  def scan_full(ss, pattern, advance, getstr)
    s = do_scan(ss, pattern, advance, true)
    getstr ? s : len(s)
  end

  def search_full(ss, pattern, advance, getstr)
    s = do_scan(ss, pattern, advance, false)
    getstr ? s : len(s)
  end

  def getch(ss)
    if eos?(ss)
      clear_match(ss)
      return nil
    end
    set_match(ss, @cpos, @cpos + 1, String.[](@string, @cpos, 1) || "", nil, true)
  end

  # Ruby 3.4: an optionally signed Integer at the pointer (base 10, or 16 with an optional 0x), or nil.
  def scan_integer(ss, base: 10)
    case base
    in 10
      s = do_scan(ss, /[+-]?\d+/, true, true)
      s ? String.to_i(s) : nil
    in 16
      s = do_scan(ss, /[+-]?(?:0x)?\h+/, true, true)
      s ? String.hex(s) : nil
    else raise ArgumentError, "Unsupported integer base: #{base}, expected 10 or 16"
    end
  end

  def peek(ss, len)
    raise ArgumentError, "negative string size (or size too big)" if len < 0
    String.byteslice(@string, @bpos, len) || ""
  end

  def peek_byte(ss) = String.getbyte(@string, @bpos)

  def unscan(ss)
    raise ScanError, "unscan failed: previous match record not exist" if @mstr == nil
    @cpos = @prev_cpos
    @bpos = @prev_bpos
    clear_match(ss)
    ss
  end

  # --- position ---

  def pos(ss) = @bpos
  def pointer(ss) = @bpos
  def charpos(ss) = @cpos

  # Ruby: ss.pos = n (bytes; negative counts from the end).
  # Returns n as given, as Ruby's assignment does.
  def set_pos(ss, n)
    size = String.bytesize(@string)
    b = n < 0 ? n + size : n
    raise RangeError, "index out of range" if b < 0 || b > size
    # a prefix cut inside a character counts its broken bytes as characters, so i chars are longer
    i = String.length(String.byteslice(@string, 0, b) || "")
    raise ArgumentError, "position #{b} is inside a character" unless String.bytesize(String.[](@string, 0, i) || "") == b
    @cpos = i
    @bpos = b
    n
  end

  def eos?(ss) = @bpos >= String.bytesize(@string)
  def rest?(ss) = !eos?(ss)
  def beginning_of_line?(ss) = @cpos == 0 || String.[](@string, @cpos - 1) == "\n"
  def bol?(ss) = beginning_of_line?(ss)

  def reset(ss)
    @cpos = 0
    @bpos = 0
    clear_match(ss)
    ss
  end

  def terminate(ss)
    @cpos = String.length(@string)
    @bpos = String.bytesize(@string)
    clear_match(ss)
    ss
  end

  # --- the String ---

  # Ruby: ss.string = s
  def set_string(ss, s)
    s => String
    @string = s
    reset(ss)
    s
  end

  # Ruby: ss.concat(s) / ss << s (Ruby appends to the same String object; here a new String).
  def concat(ss, s)
    @string = @string + s
    ss
  end

  def <<(ss, s) = concat(ss, s)

  def rest(ss) = rest_string(ss)
  def rest_size(ss) = String.bytesize(@string) - @bpos

  # --- the last match ---

  def matched?(ss) = @mstr != nil
  def matched(ss) = @mstr

  def matched_size(ss)
    s = @mstr
    s ? String.bytesize(s) : nil
  end

  def pre_match(ss)
    s = @mstr
    s ? String.[](@string, 0, @mend - String.length(s)) : nil
  end
  def post_match(ss) = @mstr != nil ? String.[](@string, @mend..) : nil

  def [](ss, i)
    return nil if @mstr == nil
    m = @md
    if m
      MatchData.[](m, i)
    elsif i in String | Symbol
      raise IndexError, "undefined group name reference: #{i}"
    else
      i == 0 ? @mstr : nil
    end
  end

  def captures(ss)
    return nil if @mstr == nil
    m = @md
    m ? MatchData.captures(m) : Array[]
  end

  def size(ss)
    return nil if @mstr == nil
    m = @md
    m ? Array.size(MatchData.to_a(m)) : 1
  end

  def named_captures(ss)
    m = @md
    m ? MatchData.named_captures(m) : Hash[]
  end

  def values_at(ss, *is)
    return nil if @mstr == nil
    Array.map(is) { |i| StringScanner.[](ss, i) }
  end

  def fixed_anchor?(ss) = @fixed_anchor

  # #<StringScanner 4/11 "test" @ " stri..."> (5 characters each side; Ruby counts bytes).
  def inspect(ss)
    return "#<StringScanner fin>" if eos?(ss)
    after = rest_string(ss)
    after = String.[](after, 0, 5) + "..." if String.length(after) > 5
    head = "#<StringScanner #{@bpos}/#{String.bytesize(@string)}"
    return "#{head} @ #{Kernel.inspect(after)}>" if @cpos == 0
    before = String.[](@string, 0, @cpos) || ""
    before = "..." + (String.[](before, -5, 5) || "") if String.length(before) > 5
    "#{head} #{Kernel.inspect(before)} @ #{Kernel.inspect(after)}>"
  end

end
