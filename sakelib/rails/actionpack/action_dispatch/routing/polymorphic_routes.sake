# Port of actionpack-8.1.3/lib/action_dispatch/routing/polymorphic_routes.rb (partial: no polymorphic mappings (`resolve`), no Class arguments)
#
# Rails builds the helper's name from the record's `model_name` ("post" + "_path") and calls it with public_send.
# Here a record is a value of a type that includes PolymorphicRoutes::Model (ActiveModel's naming and persisted?:
# route_key, singular_route_key, persisted?, and ToParam's to_param), and the named route is called through
# NamedRouteCollection::UrlHelper.call with the route's name, which is what the generated helper does; a name with
# no route raises NoMethodError as Rails' public_send does. A Class (`polymorphic_path(Post)`) is not a value in
# Sake: write the Symbol (`polymorphic_path(:posts)`) or a new record.

require "route_set"

module ActionDispatch
  module Routing
    module PolymorphicRoutes
      # (Sake only) what Rails reads from a record's to_model and model_name
      module Model
        def route_key(r) = raise(NotImplementedError)
        def singular_route_key(r) = raise(NotImplementedError)
        def persisted?(r) = raise(NotImplementedError)
      end

      class NoMethodError < StandardError
      end

      # HelperMethodBuilder: a prefix ("edit_", "new_" or "") and a suffix ("path" or "url"); `singular` for new
      class HelperMethodBuilder
        attr_reader singular, prefix, suffix

        def get(action, type)
          prefix = action ? "#{action}_" : ""
          HelperMethodBuilder.new(Kernel.to_s(action) == "new", prefix, Kernel.to_s(type))
        end

        def key_for(b, record) = @singular ? Model.singular_route_key(record) : Model.route_key(record)

        # polymorphic_method(recipient, record_or_hash_or_array, action, type, options)
        def polymorphic_method(recipient, record_or_hash_or_array, action, type, options)
          builder = get(action, type)
          method, args = case record_or_hash_or_array
          in Array
            list = Array.compact(record_or_hash_or_array)
            raise ArgumentError, "Nil location provided. Can't build URI." if Array.empty?(list)
            handle_list(builder, list)
          in String | Symbol then [get_method_for_string(builder, Kernel.to_s(record_or_hash_or_array)), Any[]]
          in nil then raise ArgumentError, "Nil location provided. Can't build URI."
          in Model then handle_model(builder, record_or_hash_or_array)
          else no_to_model(record_or_hash_or_array)
          end
          call_named_route(recipient, method, args, Hash.empty?(options) ? nil : options)
        end

        # recipient.public_send(method, *args, options)
        def call_named_route(recipient, method, args, options)
          m = String.match(method, /\A(.+)_(path|url)\z/)
          name = m ? (m[1] || "") : method
          kind = m && m[2] == "url" ? :url : :path
          named = RouteSet.named_routes(UrlFor._routes(recipient))
          raise NoMethodError, "undefined method '#{method}' for an instance of #{Kernel.class_name(recipient)}" unless RouteSet::NamedRouteCollection.key?(named, name)
          RouteSet::NamedRouteCollection::UrlHelper.call(recipient, String.to_sym(name), kind, args, options)
        end

        def handle_model(b, record)
          if Model.persisted?(record)
            [get_method_for_string(b, Model.singular_route_key(record)), Any[record]]
          else
            [get_method_for_string(b, key_for(b, record)), Any[]]
          end
        end

        def handle_list(b, list)
          record_list = Array.dup(list)
          record = Array.pop(record_list)
          args = Any[]
          route = Array.map(record_list) do |parent|
            case parent
            in Symbol then Symbol.to_s(parent)
            in String then raise ArgumentError, "Please use symbols for polymorphic route arguments."
            in Model
              Array.push(args, parent)
              Model.singular_route_key(parent)
            else no_to_model(parent)
            end
          end
          last = case record
          in Symbol then Symbol.to_s(record)
          in String then raise ArgumentError, "Please use symbols for polymorphic route arguments."
          in Model
            if Model.persisted?(record)
              Array.push(args, record)
              Model.singular_route_key(record)
            else
              key_for(b, record)
            end
          else no_to_model(record)
          end
          Array.push(route, last)
          Array.push(route, @suffix)
          [@prefix + Array.join(route, "_"), args]
        end

        def get_method_for_string(b, str) = "#{@prefix}#{str}_#{@suffix}"

        # Ruby calls to_model on what is not a String, Symbol, Class or Array
        def no_to_model(x)
          case x
          in nil | true | false then raise ::NoMethodError, "undefined method 'to_model' for #{Kernel.inspect(x)}"
          else raise ::NoMethodError, "undefined method 'to_model' for an instance of #{Kernel.class_name(x)}"
          end
        end
      end
    end

    module UrlFor
      # polymorphic_url(record_or_hash_or_array, options = {})
      def polymorphic_url(t, record_or_hash_or_array, options = Hash.new)
        if record_or_hash_or_array in Hash
          opts = Hash.merge(record_or_hash_or_array, options)
          record = Hash.delete(opts, :id)
          return polymorphic_url(t, record, opts)
        end
        opts = Hash.dup(options)
        action = Hash.delete(opts, :action)
        type = Hash.delete(opts, :routing_type) || :url
        PolymorphicRoutes::HelperMethodBuilder.polymorphic_method(t, record_or_hash_or_array, action, type, opts)
      end

      def polymorphic_path(t, record_or_hash_or_array, options = Hash.new)
        if record_or_hash_or_array in Hash
          opts = Hash.merge(record_or_hash_or_array, options)
          record = Hash.delete(opts, :id)
          return polymorphic_path(t, record, opts)
        end
        opts = Hash.dup(options)
        action = Hash.delete(opts, :action)
        PolymorphicRoutes::HelperMethodBuilder.polymorphic_method(t, record_or_hash_or_array, action, :path, opts)
      end

      def edit_polymorphic_url(t, record_or_hash, options = Hash.new) = polymorphic_url(t, record_or_hash, Hash.merge(options, Hash.of(action: "edit")))
      def edit_polymorphic_path(t, record_or_hash, options = Hash.new) = polymorphic_path(t, record_or_hash, Hash.merge(options, Hash.of(action: "edit")))
      def new_polymorphic_url(t, record_or_hash, options = Hash.new) = polymorphic_url(t, record_or_hash, Hash.merge(options, Hash.of(action: "new")))
      def new_polymorphic_path(t, record_or_hash, options = Hash.new) = polymorphic_path(t, record_or_hash, Hash.merge(options, Hash.of(action: "new")))
    end
  end
end
