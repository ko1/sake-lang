try
  print(10.0 ** 400)
catch e
  print(e)
end
try
  print((-8.0) ** 0.5)
catch e
  print(e)
end
try
  print(1.0 % 0)
catch e
  print(e)
end
try
  let m = {}
  m[1.5] = 2
catch e
  print(e)
end
try
  print(float("x"), 1)
catch e
  print(e)
end
try
  print(-"a")
catch e
  print(e)
end
try
  print(int([1]))
catch e
  print(e)
end
try
  print(sort([1, "a"]), range(1.5))
catch e
  print(e)
end
try
  print(2.0 < "a")
catch e
  print(e)
end
try
  print(min(1, "a"))
catch e
  print(e)
end
print(2.0 ** 10, 1.0 * 10 ** 400)
