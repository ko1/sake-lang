# One Struct type used with two element types in one program: the field's element type is
# inferred once per definition, so each Box sees both Integer and String.
class Box
  attr_reader items
  def create = Box.new(Array[])
  def add(b, x) = Array.push(@items, x)
  def smallest(b) = Array.reduce(@items, Array.fetch(@items, 0)) { |m, x| x < m ? x : m }
end

ints = Box.create
Box.add(ints, 3)
Box.add(ints, 1)
strs = Box.create
Box.add(strs, "b")
Box.add(strs, "a")
p(Box.smallest(ints))
p(Box.smallest(strs))
