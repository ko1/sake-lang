# Times with a fixed UTC offset: made with an offset, converted, and formatted (%z reflects it).
def try
  yield
rescue ArgumentError => e
  puts "ArgumentError: #{Exception.message(e)}"
end

t = Time.new(2024, 1, 2, 3, 4, 5, "+09:00")
p t
p Time.utc_offset(t)
p Time.zone(t)
p Time.utc?(t)
p Time.strftime(t, "%Y-%m-%d %H:%M:%S %z %:z")
p Time.iso8601(t)
p Time.hour(t)

u = Time.utc(t)
p u
p Time.zone(u)
p Time.utc?(u)
p Time.getutc(t) == u
p Time.gmtime(t)
p t == u
p Time.hour(t) # Time.utc gives a copy; t keeps its offset

p Time.getlocal(u, "-05:00")
p Time.localtime(u, "+05:30")
p Time.getlocal(u, 3600)
p Time.localtime(t, "Z")
p Time.utc_offset(Time.getlocal(u, "-08:00"))
p Time.gmt_offset(t)

p Time.new(2024, 1, 2, 3, 4, 5, in: "-03:00")
p Time.new(2024, 1, 2, in: "Z")
p Time.new(2024, 1, 2, 3, 4, 5.5, "+01:00")
p Time.at(0, in: "+09:00")
p Time.at(1700000000, in: "UTC")
p Time.at(t, in: "-01:00")
p Time.utc_offset(Time.now(in: "+02:00"))
p Time.strftime(Time.at(0, in: "-00:30"), "%z %:z %::z")

p t + 3600
p Time.getlocal(u, "+09:00") == t
p Time.new(2024, 1, 2, 3, 4, 5, "+09:00") - Time.new(2024, 1, 2, 3, 4, 5, "+00:00")

try { Time.new(2024, 1, 2, 3, 4, 5, "+9") }
try { Time.getlocal(t, "JST") }
try { Time.at(0, in: "bad") }
