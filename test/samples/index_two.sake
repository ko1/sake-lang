# `s[start, length]` slices a String or an Array; a type's own [] and []= may take two indexes.
p("abcdef"[1, 3])
p(Array[1, 2, 3, 4][2, 5])
p("abc"[5, 1])
Grid = Struct.new(:w, :cells)
class Grid
  include Indexable
  def [](g, r, c) = Array.fetch(@cells, r * @w + c)
  def []=(g, r, c, v)
    @cells[r * @w + c] = v
  end
end
g = Grid.new(2, Array[0, 0, 0, 0])
g[1, 0] = 7
p([g[1, 0], g[0, 1]])
