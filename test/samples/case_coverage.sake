# sake: -c --strict=3
# An else that no value reaches is not analyzed; `in true` and `in false` together take every Boolean.
# A reachable else still is, and `in true` alone leaves false.
class B
  attr_reader w
end
def pick(x)
  case x
  in B then B.w(x)
  else Integer.abs(x)                  # never reached when x is a B
  end
end
p(pick(B.new(3)))
def kind(v)
  case v
  in true then 1
  in false then 2
  in Integer then 3
  end
end
p(kind(true))
def bad(x)
  case x
  in Integer then x
  else String.upcase(x)                # reached by 2.5
  end
end
p(bad(2.5))
def half(v)
  case v
  in true then 1
  in Integer then 3
  end
end
p(half(false))
