# Stress: a 12x12 Integer system solved exactly, determinant cross-checked
# between Bareiss (Integer) and elimination (Rational) and Float.
n = 12
seed = 7
def next_rand(s) = (s * 1103515245 + 12345) % 2147483648
a = Mat.zero(n, n)
Integer.times(n) do |i|
  Integer.times(n) do |j|
    seed = next_rand(seed)
    a[i, j] = seed % 21 - 10
  end
end
xs = Vec.of(Array.new(n) { |i| i - 5 })
b = a * xs
d_int = Mat.det(a)
d_rat = Mat.det(Mat.exact(a))
d_flt = Mat.det(Mat.to_float(a))
puts("det (Bareiss, Integer) = #{d_int}")
puts("det (Rational elim)    = #{la_fmt(d_rat)}")
puts("det (Float elim)       = #{format("%.6e", d_flt)}")
puts("agree exactly: #{d_int == d_rat}")
x = Mat.solve(a, b)
puts("solve recovers x: #{x == Vec.exact(xs)}") if x
inv = Mat.inverse(a)
if inv
  puts("A * A^-1 == I: #{a * inv == Mat.exact(Mat.identity(n))}")
  big = Array.max(Array.map(Array.flatten(Mat.get_rows(inv))) { |e| (e in Rational) ? Rational.denominator(e) : 1 }) || 0
  puts("largest denominator in A^-1: #{big}")
end
# Mixed element types in one matrix
m = Mat.of(Array[Array[1, 1/2r], Array[0.5, 3]])
puts("mixed det = #{la_fmt(Mat.det(m))}")
