# sake: --strict
# Exception.backtrace(e): Ruby's "FILE:LINE:in 'FUNCTION'", innermost first; nil before e is raised.
# Exception.cause(e): the exception being rescued when e was raised, or nil.
class ParseError < Exception
  attr_reader line
end

def to_int(s) = Integer(s)

def parse(s, line)
  to_int(s)
rescue ArgumentError
  raise ParseError.new("line #{line}: not a number: #{s}", line)
end

def report(e)
  puts("#{Exception.message(e)}")
  bt = Exception.backtrace(e)
  Array.each(bt) { |l| puts("  #{l}") } if bt
  c = Exception.cause(e)
  report(c) if c
end

begin
  parse("z", 3)
rescue ParseError => e
  report(e)
  # a bare raise and `raise e` keep the first backtrace
  first = Exception.backtrace(e)
  begin
    raise
  rescue ParseError => again
    p(Exception.backtrace(again) == first)
  end
  begin
    raise e
  rescue ParseError => again
    p(Exception.backtrace(again) == first)
  end
end

# a cause also when the new exception is rescued inside the clause
begin
  raise "a"
rescue
  begin
    raise "b"
  rescue => x
    p(Exception.cause(x))
  end
end

# not raised yet: no backtrace, no cause
fresh = ParseError.new("x", 1)
p(Exception.backtrace(fresh))
p(Exception.cause(fresh))
