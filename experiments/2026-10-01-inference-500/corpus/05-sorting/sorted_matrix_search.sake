# Searching 2-D tables: a price table sorted along rows and columns (staircase
# search, k-th smallest by binary search on the value), and a row-major sorted
# table searched as one flat array.

def staircase_find(grid, target)
  r = 0
  c = Array.size(grid[0]) - 1
  steps = 0
  while r < Array.size(grid) && c >= 0
    steps += 1
    v = grid[r][c]
    return [r, c, steps] if v == target
    if v > target
      c -= 1
    else
      r += 1
    end
  end
  [nil, nil, steps]
end

def count_at_most(grid, x)
  n = 0
  c = Array.size(grid[0]) - 1
  Array.each(grid) do |row|
    c -= 1 while c >= 0 && row[c] > x
    n += c + 1
  end
  n
end

def kth_smallest(grid, k)
  lo = grid[0][0]
  hi = Array.last(Array.last(grid))
  while lo < hi
    mid = lo + (hi - lo) / 2
    if count_at_most(grid, mid) < k
      lo = mid + 1
    else
      hi = mid
    end
  end
  lo
end

def flat_search(table, target)
  cols = Array.size(table[0])
  lo = 0
  hi = Array.size(table) * cols - 1
  while lo <= hi
    mid = (lo + hi) / 2
    r, c = Integer.divmod(mid, cols)
    v = table[r][c]
    return [r, c] if v == target
    if v < target
      lo = mid + 1
    else
      hi = mid - 1
    end
  end
  nil
end

def ordinal(n)
  suffix = n % 100 >= 11 && n % 100 <= 13 ? "th" : Array["th", "st", "nd", "rd", "th", "th", "th", "th", "th", "th"][n % 10]
  "#{n}#{suffix}"
end

def show_grid(grid)
  Array.each(grid) { |row| puts("  " + Array.join(Array.map(row) { |v| String.rjust(Integer.to_s(v), 4) }, "")) }
end

# prices[size][topping count]: grows to the right and downwards
prices = Array[
  Array[5, 7, 9, 12, 15],
  Array[6, 8, 11, 14, 18],
  Array[9, 11, 13, 17, 21],
  Array[10, 14, 16, 20, 25],
  Array[12, 15, 19, 24, 30]
]
puts("price table:")
show_grid(prices)
sizes = Array["S", "M", "L", "XL", "XXL"]
Array.each(Array[14, 13, 4, 30, 22]) do |budget|
  r, c, steps = staircase_find(prices, budget)
  if r != nil && c != nil
    puts("exactly #{budget}: size #{sizes[r]} with #{c} toppings (#{steps} steps)")
  else
    puts("exactly #{budget}: none (#{steps} steps), #{count_at_most(prices, budget)} options cost at most #{budget}")
  end
end
total = Array.sum(Array.map(prices) { |row| Array.size(row) })
Array.each(Array[1, 5, 13, total]) do |k|
  puts("#{ordinal(k)} cheapest price: #{kth_smallest(prices, k)}")
end
median = kth_smallest(prices, (total + 1) / 2)
check = Array.sort(Array.flatten(prices))[(total + 1) / 2 - 1]
puts("median #{median} (by sorting: #{check})")

# seat numbers by row: fully sorted in row-major order
seats = Array[
  Array[101, 104, 105, 109],
  Array[110, 111, 115, 120],
  Array[121, 130, 133, 134],
  Array[140, 141, 150, 151]
]
Array.each(Array[115, 101, 151, 135, 99]) do |seat|
  hit = flat_search(seats, seat)
  case hit
  in nil then puts("seat #{seat}: not sold")
  in Tuple then puts("seat #{seat}: row #{hit[0] + 1}, position #{hit[1] + 1}")
  end
end
