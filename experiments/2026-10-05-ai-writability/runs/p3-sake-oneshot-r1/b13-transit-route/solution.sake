def valid_segment(f)
  Array.size(f) == 4 && String.match?(f[3], /\A[1-9]\d{0,2}\z/) && f[1] != f[2]
end

def add_edge(adj, a, b, line, mins)
  adj[a] = Array[] unless Hash.key?(adj, a)
  Array.push(adj[a], [b, line, mins])
end

def best_route(adj, from, to, pen)
  labels = Hash[]
  labels[[from, ""]] = [0, 0, Array[from], Array[]]
  changed = true
  while changed
    changed = false
    Array.each(Hash.to_a(labels)) do |key, lab|
      st, ln = key
      cost, tr, sts, lns = lab
      es = adj[st]
      next unless es
      Array.each(es) do |e|
        v, l, mins = e
        xfer = (ln != "" && ln != l)
        extra = xfer ? pen : 0
        ntr = xfer ? tr + 1 : tr
        nl = [cost + mins + extra, ntr, sts + Array[v], lns + Array[l]]
        k = [v, l]
        old = labels[k]
        if old == nil || nl < old
          labels[k] = nl
          changed = true
        end
      end
    end
  end
  best = nil
  Hash.each(labels) do |key, lab|
    if key[0] == to && (best == nil || lab < best)
      best = lab
    end
  end
  best
end

all = IO.readlines(IO.stdin)
pen = 0
seen_p = false
mode = 0
adj = Hash[]
Array.each_with_index(all) do |raw, idx|
  n = idx + 1
  line = String.strip(raw)
  next if String.empty?(line)
  unless seen_p
    pen = String.to_i(line)
    seen_p = true
    next
  end
  f = String.split(line, " ")
  if mode == 0
    if line == "QUERIES"
      mode = 1
    elsif valid_segment(f)
      mins = String.to_i(f[3])
      add_edge(adj, f[1], f[2], f[0], mins)
      add_edge(adj, f[2], f[1], f[0], mins)
    else
      puts("invalid segment at line #{n}")
    end
  elsif Array.size(f) != 2
    puts("invalid query at line #{n}")
  else
    from = f[0]
    to = f[1]
    if !Hash.key?(adj, from)
      puts("#{from} -> #{to}: unknown station #{from}")
    elsif !Hash.key?(adj, to)
      puts("#{from} -> #{to}: unknown station #{to}")
    elsif from == to
      puts("#{from} -> #{to}: 0 min, 0 transfers")
    else
      best = best_route(adj, from, to, pen)
      if best == nil
        puts("#{from} -> #{to}: no route")
      else
        cost, tr, sts, lns = best
        tword = tr == 1 ? "transfer" : "transfers"
        puts("#{from} -> #{to}: #{cost} min, #{tr} #{tword}")
        legs = Array[]
        i = 0
        cnt = Array.size(lns)
        while i < cnt
          j = i
          while j + 1 < cnt && lns[j + 1] == lns[i]
            j += 1
          end
          seg = Array.take(Array.drop(sts, i), j - i + 2)
          Array.push(legs, "#{lns[i]}: #{Array.join(seg, " > ")}")
          i = j + 1
        end
        puts("  " + Array.join(legs, "; "))
      end
    end
  end
end
