require "pathname"

# File's path-string functions
names = Array["a", "a.", ".a", ".a.b", "a.b.c", "a/b.c/", "a/", "/", "//", "", "a//b", "..", "...", "..a", "a..b", "/usr/lib/libc.so.6"]
Array.each(names) do |x|
  p [x, File.basename(x), File.dirname(x), File.extname(x), File.basename(x, ".*"), File.basename(x, ".c")]
  p File.split(x)
end
p File.basename(".c", ".c")
p File.basename("a.c", "c")
p File.join("a", "/b/", "c")
p File.join("a/", "/b")
p File.join
p File.join("", "")
p File.join("a", Array["b", Array["c"]])
p File.absolute_path?("/x")
p File.absolute_path?("x")

# construction and display
pn = Pathname.new("/usr/bin/ruby")
p pn
puts pn
p Pathname.to_s(pn)
p Pathname.to_path(pn)
p Pathname("lib/x.rb")
p Pathname(Pathname("same")) == Pathname("same")
p Pathname("a") == Pathname("a/")
begin
  Pathname.new("a\0b")
rescue ArgumentError => e
  puts "ArgumentError: #{Exception.message(e)}"
end

# components
paths = Array["/usr/bin/ruby", "lib/x.tar.gz", "a/b/", "/", ".", "..", "a", "./a/../b", "/a/./b/../../c/", "a//b//c", "../../x", "/../a", "a/..", "a/../.."]
Array.each(paths) do |s|
  x = Pathname.new(s)
  puts "#{s}: base=#{Pathname.basename(x)} dir=#{Pathname.dirname(x)} ext=#{Kernel.inspect(Pathname.extname(x))} parent=#{Pathname.parent(x)}"
  puts "  abs=#{Pathname.absolute?(x)} rel=#{Pathname.relative?(x)} root=#{Pathname.root?(x)} clean=#{Pathname.cleanpath(x)} conservative=#{Pathname.cleanpath(x, true)}"
  p Pathname.each_filename(x)
  p Pathname.split(x)
end
p Pathname.basename(Pathname.new("x.rb"), ".rb")
p Pathname.basename(Pathname.new("x.tar.gz"), ".*")

# + / join
pairs = Array[["a", "b"], ["a/", "b"], ["/a", "b"], ["a", "/b"], ["a", ".."], ["a/b", "../c"], ["/", ".."], ["/a", "../.."], [".", "b"], ["a", "."], ["..", "a"], ["a/b", "../../.."], ["a", ""]]
Array.each(pairs) do |a, b|
  puts "#{a} + #{b} = #{Pathname.new(a) + b}"
end
p Pathname.new("usr") / "lib" / "ruby"
p Pathname.new("/usr") + Pathname.new("local")
p Pathname.join(Pathname.new("a"), "b", "c")
p Pathname.join(Pathname.new("a"), "b", "/c", "d")
p Pathname.join(Pathname.new("a"))
p Pathname.join(Pathname.new("a"), Pathname.new("x"))

# ascend / descend
Pathname.ascend(Pathname.new("/a/b/c")) { |v| p v }
Pathname.descend(Pathname.new("a/b/c")) { |v| p v }
p Pathname.ascend(Pathname.new("x/y"))
p Pathname.descend(Pathname.new("/x/y"))
Pathname.each_filename(Pathname.new("/p/q/r")) { |f| print f, ";" }
puts

# relative_path_from
rel = Array[["/a/b/c", "/a"], ["/a", "/a/b/c"], ["/a/b", "/a/b"], ["a/b", "a/c"], ["/a/x", "/b/y"], ["a", "."], [".", "a"]]
Array.each(rel) do |a, b|
  puts "#{a} from #{b}: #{Pathname.relative_path_from(Pathname.new(a), b)}"
end
p Pathname.relative_path_from(Pathname.new("/a/b"), Pathname.new("/a"))
Array.each(Array[["/a", "b"], ["a", "../b"]]) do |a, b|
  begin
    p Pathname.relative_path_from(Pathname.new(a), b)
  rescue ArgumentError => e
    puts "ArgumentError: #{Exception.message(e)}"
  end
end

# sub_ext / sub / comparison
p Pathname.sub_ext(Pathname.new("a/b.rb"), ".txt")
p Pathname.sub_ext(Pathname.new("a/b"), ".txt")
p Pathname.sub_ext(Pathname.new(".bashrc"), ".bak")
p Pathname.sub(Pathname.new("src/main.c"), /\.c\z/, ".o")
p Pathname.<=>(Pathname.new("a/b"), Pathname.new("a-b"))
p Pathname.<=>(Pathname.new("a"), Pathname.new("a"))
sorted = Array.sort_by(Array.map(Array["b", "a/b", "a-b", "a"]) { |s| Pathname.new(s) }) { |x| String.tr(Pathname.to_s(x), "/", "\0") }
p sorted
h = Hash[Pathname.new("k") => 1]
p h[Pathname.new("k")]

# through File
tmp = Pathname.new("_pathname_test.txt")
p Pathname.exist?(tmp)
p Pathname.write(tmp, "one\ntwo\n")
p Pathname.exist?(tmp)
p Pathname.file?(tmp)
p Pathname.directory?(tmp)
p Pathname.read(tmp)
p Pathname.readlines(tmp)
Pathname.delete(tmp)
p Pathname.exist?(tmp)
p Pathname.directory?(Pathname.new("."))
p Pathname.file?(Pathname.new("."))
p Pathname.directory?(Pathname.new("_no_such_dir"))
begin
  Pathname.read(Pathname.new("_no_such_file"))
rescue IOError => e
  puts "IOError"
end
