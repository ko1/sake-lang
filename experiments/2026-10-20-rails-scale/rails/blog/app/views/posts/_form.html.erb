<%# locals: (post:) -%>
<%= form_with({model: post}) do |form| %>
  <% if ActiveModel::Errors.any?(Post.errors(post)) %>
    <div style="color: red">
      <h2><%= pluralize(ActiveModel::Errors.count(Post.errors(post)), "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% ActiveModel::Errors.each(Post.errors(post)) do |error| %>
          <li><%= ActiveModel::Error.full_message(error) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= label form, :title, {style: "display: block"} %>
    <%= text_field form, :title %>
  </div>

  <div>
    <%= label form, :body, {style: "display: block"} %>
    <%= text_area form, :body %>
  </div>

  <div>
    <%= submit form %>
  </div>
<% end %>
