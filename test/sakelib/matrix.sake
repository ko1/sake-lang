require "matrix"

def show(label, x) = puts("#{label}: #{Kernel.inspect(x)}")

# construction
a = Matrix.rows(Array[Array[1, 2], Array[3, 4]])
b = Matrix.columns(Array[Array[5, 6], Array[7, 8]])
show("a", a)
show("b", b)
puts(a)
show("build", Matrix.build(2, 3) { |i, j| i * 10 + j })
show("identity", Matrix.identity(3))
show("unit", Matrix.unit(2))
show("zero", Matrix.zero(2))
show("scalar", Matrix.scalar(2, 7))
show("diagonal", Matrix.diagonal(1, 2, 3))
show("row_vector", Matrix.row_vector(Array[1, 2, 3]))
show("column_vector", Matrix.column_vector(Vector.elements(Array[1, 2, 3])))
show("empty", Matrix.empty(0, 3))
show("empty.t", Matrix.transpose(Matrix.empty(0, 3)))
show("vstack", Matrix.vstack(a, b))
show("hstack", Matrix.hstack(a, b))

# access
show("a[0, 1]", a[0, 1])
show("a[-1, -1]", a[-1, -1])
show("a[5, 0]", a[5, 0])
show("element", Matrix.element(a, 1, 0))
show("row_count", Matrix.row_count(a))
show("column_count", Matrix.column_count(Matrix.build(2, 3) { |i, j| 0 }))
show("row", Matrix.row(a, 1))
show("column", Matrix.column(a, 0))
show("row out", Matrix.row(a, 2))
show("column out", Matrix.column(a, -3))
show("row_vectors", Matrix.row_vectors(a))
show("column_vectors", Matrix.column_vectors(a))
show("to_a", Matrix.to_a(a))
c = Matrix.rows(Matrix.to_a(a))
c[0, 0] = 100
show("set", c)
show("a unchanged", a)
xs = Array[]
Matrix.each(a) { |e| Array.push(xs, e) }
show("each", xs)
Matrix.each_with_index(a) { |e, i, j| print("(#{i},#{j})=#{e} ") }
puts
show("map", Matrix.map(a) { |e| e * e })
m3 = Matrix.rows(Array[Array[2, 0, 1], Array[1, 3, 2], Array[1, 1, 2]])
show("minor", Matrix.minor(m3, 1, 2, 0, 2))
show("first_minor", Matrix.first_minor(m3, 0, 1))
show("cofactor", Matrix.cofactor(m3, 0, 1))
show("adjugate", Matrix.adjugate(m3))

# arithmetic
show("a + b", a + b)
show("a - b", a - b)
show("a * b", a * b)
show("a * 2", a * 2)
show("a * 0.5", a * 0.5)
show("a * 1/3r", a * (1/3r))
show("a / 2", a / 2)
show("a / 2.0", a / 2.0)
show("a / b", a / b)
show("a * v", a * Vector.elements(Array[1, 1]))
show("-a", -a)
show("a ** 0", a ** 0)
show("a ** 1", a ** 1)
show("a ** 5", a ** 5)
show("a ** -1", a ** -1)
show("a ** -2", a ** -2)
show("hadamard", Matrix.hadamard_product(a, b))
show("rect * rect", Matrix.build(2, 3) { |i, j| i + j } * Matrix.build(3, 2) { |i, j| i * j + 1 })

# algebra
show("t", Matrix.t(Matrix.build(2, 3) { |i, j| i * 3 + j }))
show("trace", Matrix.trace(m3))
show("tr", Matrix.tr(a * 1.5))
show("det2", Matrix.determinant(a))
show("det3", Matrix.det(m3))
m4 = Matrix.build(4, 4) { |i, j| (i + 1) ** j }
show("det4", Matrix.det(m4))
m5 = Matrix.build(5, 5) { |i, j| i == j ? 2 : (i - j) ** 2 }
show("det5", Matrix.det(m5))
show("det5 float", Matrix.det(m5 * 0.1))
show("det5 rational", Matrix.det(m5 * (1/3r)))
show("det6 zero pivot", Matrix.det(Matrix.build(6, 6) { |i, j| (i + j) % 6 == 0 ? 0 : i * j + 1 }))
show("det singular", Matrix.det(Matrix.build(5, 5) { |i, j| i + j }))
show("det empty", Matrix.det(Matrix.empty(0, 0)))
show("det 1x1", Matrix.det(Matrix.rows(Array[Array[7]])))
show("det float3", Matrix.det(Matrix.rows(Array[Array[1.5, 2.0, 0.1], Array[0.3, 4.0, 5.5], Array[6.0, 7.25, 8.0]])))
show("inverse", Matrix.inverse(m3))
show("inv float", Matrix.inv(Matrix.rows(Array[Array[4.0, 7.0], Array[2.0, 6.0]])))
show("inv rational", Matrix.inverse(Matrix.rows(Array[Array[1/2r, 1/3r], Array[1/4r, 1/5r]])))
hilbert = Matrix.build(4, 4) { |i, j| Rational(1, i + j + 1) }
show("hilbert inv", Matrix.inverse(hilbert))
show("hilbert * inv", hilbert * Matrix.inverse(hilbert) == Matrix.identity(4))
show("inv pivot", Matrix.inverse(Matrix.rows(Array[Array[0, 1], Array[1, 0]])))
show("rank", Matrix.rank(m3))
show("rank 1", Matrix.rank(Matrix.rows(Array[Array[1, 2], Array[2, 4]])))
show("rank 0", Matrix.rank(Matrix.zero(3)))
show("rank rect", Matrix.rank(Matrix.build(3, 5) { |i, j| i * j + j }))
show("rank float", Matrix.rank(Matrix.rows(Array[Array[1.0, 2.0], Array[0.5, 1.0]])))
show("round", Matrix.round(Matrix.inverse(m3 * 1.0), 2))
show("round rational", Matrix.round(Matrix.inverse(hilbert) / 7, 1))

# predicates
show("square?", Matrix.square?(a))
show("square? rect", Matrix.square?(Matrix.build(2, 3) { |i, j| 0 }))
show("empty?", Matrix.empty?(Matrix.empty(2, 0)))
show("zero?", Matrix.zero?(Matrix.zero(2)))
show("diagonal?", Matrix.diagonal?(Matrix.diagonal(1, 2)))
show("upper?", Matrix.upper_triangular?(Matrix.rows(Array[Array[1, 2], Array[0, 3]])))
show("lower?", Matrix.lower_triangular?(Matrix.rows(Array[Array[1, 2], Array[0, 3]])))
show("symmetric?", Matrix.symmetric?(a + Matrix.transpose(a)))
show("antisymmetric?", Matrix.antisymmetric?(a - Matrix.transpose(a)))
show("orthogonal?", Matrix.orthogonal?(Matrix.rows(Array[Array[0, 1], Array[-1, 0]])))
show("permutation?", Matrix.permutation?(Matrix.rows(Array[Array[0, 1], Array[1, 0]])))
show("singular?", Matrix.singular?(Matrix.rows(Array[Array[1, 2], Array[2, 4]])))
show("regular?", Matrix.regular?(a))
show("==", a == Matrix.rows(Array[Array[1, 2], Array[3, 4]]))
show("== float", a == a * 1.0)
show("!=", a != b)
show("empty ==", Matrix.empty(0, 2) == Matrix.empty(0, 3))

# vectors
v = Vector.elements(Array[1, 2, 3])
w = Vector.elements(Array[4, 5, 6])
show("v", v)
puts(v)
show("v[0]", v[0])
show("v[-1]", v[-1])
show("v[9]", v[9])
show("size", Vector.size(v))
show("v + w", v + w)
show("v - w", v - w)
show("v * 2", v * 2)
show("v / 2", v / 2)
show("v / 2.0", v / 2.0)
show("-v", -v)
show("inner_product", Vector.inner_product(v, w))
show("dot", Vector.dot(v, w))
show("cross", Vector.cross_product(v, w))
show("norm", Vector.norm(Vector.elements(Array[3, 4])))
show("magnitude", Vector.magnitude(v))
show("r", Vector.r(Vector.elements(Array[1/2r, 1/2r])))
show("normalize", Vector.normalize(Vector.elements(Array[3, 4])))
show("angle 0", Vector.angle_with(v, v * 2))
show("angle pi", Vector.angle_with(v, -v))
show("angle", (Integer|Float).round(Vector.angle_with(Vector.elements(Array[1, 0]), Vector.elements(Array[1, 1])), 10))
show("to_a", Vector.to_a(v))
show("map", Vector.map(v) { |e| e * 10 })
show("map2", Vector.map2(v, w) { |x, y| x * y })
s = 0
Vector.each(v) { |e| s += e }
show("each", s)
Vector.each2(v, w) { |x, y| print(x + y, " ") }
puts
show("zero", Vector.zero(3))
show("zero?", Vector.zero?(Vector.zero(2)))
show("basis", Vector.basis(size: 3, index: 1))
show("basis kw order", Vector.basis(index: 0, size: 2))
show("covector", Vector.covector(v))
show("to_matrix", Vector.to_matrix(v))
show("v * matrix", v * Matrix.row_vector(Array[1, 2]))
show("v + col matrix", v + Matrix.column_vector(Array[1, 1, 1]))
show("v ==", v == Vector.elements(Array[1, 2, 3]))
show("v == float", v == Vector.elements(Array[1.0, 2.0, 3.0]))
show("v != w", v != w)
show("round", Vector.round(Vector.elements(Array[1.234, 5.678]), 1))
u = Vector.elements(Array[1, 2])
u[1] = 20
show("set", u)
show("complex dot", Vector.inner_product(Vector.elements(Array[Complex(1, 2), 3]), Vector.elements(Array[Complex(0, 1), 1])))
show("complex norm", Vector.norm(Vector.elements(Array[Complex(3, 4)])))
show("empty vector", Vector.elements(Array[]))

# aliases
show("component", Matrix.component(a, 0, 0))
show("row_size", Matrix.row_size(a))
show("column_size", Matrix.column_size(a))
show("+a", +a)
show("entrywise", Matrix.entrywise_product(a, a))
show("v.element", Vector.element(v, 1))
show("v.component", Vector.component(v, 2))
show("+v", +v)
show("cross", Vector.cross(w, v))
show("collect", Vector.collect(v) { |e| e - 1 })
show("to_matrix", Matrix.to_matrix(a))

# errors
def try(label)
  begin
    show(label, yield)
  rescue ErrDimensionMismatch => e
    puts("#{label}: ErrDimensionMismatch: #{Exception.message(e)}")
  rescue ErrNotRegular => e
    puts("#{label}: ErrNotRegular: #{Exception.message(e)}")
  rescue ErrOperationNotDefined => e
    puts("#{label}: ErrOperationNotDefined: #{Exception.message(e)}")
  rescue ZeroVectorError => e
    puts("#{label}: ZeroVectorError: #{Exception.message(e)}")
  rescue ArgumentError => e
    puts("#{label}: ArgumentError: #{Exception.message(e)}")
  rescue IndexError => e
    puts("#{label}: IndexError: #{Exception.message(e)}")
  rescue RuntimeError => e
    puts("#{label}: RuntimeError: #{Exception.message(e)}")
  end
end
rect = Matrix.build(2, 3) { |i, j| i + j }
try("ragged") { Matrix.rows(Array[Array[1, 2], Array[3]]) }
try("a + rect") { a + rect }
try("a * rect.t") { a * rect * 1 }
try("rect * a") { rect * a }
try("a + 1") { a + 1 }
try("a - 1.5") { a - 1.5 }
try("det rect") { Matrix.det(rect) }
try("inverse singular") { Matrix.inverse(Matrix.rows(Array[Array[1, 2], Array[2, 4]])) }
try("inverse rect") { Matrix.inverse(rect) }
try("rect ** 2") { rect ** 2 }
try("trace rect") { Matrix.trace(rect) }
try("singular ** -1") { Matrix.zero(2) ** -1 }
try("v + short") { v + Vector.elements(Array[1, 2]) }
try("v * v") { v * w }
try("v / v") { v / w }
try("dot short") { Vector.inner_product(v, Vector.elements(Array[1])) }
try("normalize zero") { Vector.normalize(Vector.zero(3)) }
try("angle zero") { Vector.angle_with(v, Vector.zero(3)) }
try("basis") { Vector.basis(size: 3, index: 3) }
try("v[5] =") { Vector.[]=(v, 5, 1) }
try("empty") { Matrix.empty(2, 2) }
try("first_minor") { Matrix.first_minor(a, 2, 0) }
try("cofactor empty") { Matrix.cofactor(Matrix.empty(0, 0), 0, 0) }

# a use: Fibonacci by matrix power, and solving a system exactly
fib = Matrix.rows(Array[Array[1, 1], Array[1, 0]])
show("fib(90)", (fib ** 90)[0, 1])
sys = Matrix.rows(Array[Array[2, 1, -1], Array[-3, -1, 2], Array[-2, 1, 2]])
show("solve", Matrix.inverse(sys) * Vector.elements(Array[8, -11, -3]))

# Ruby's optional arguments
show("zero r c", Matrix.zero(2, 3))
show("build n", Matrix.build(2) { |i, j| i - j })
show("empty()", Matrix.empty)
show("empty(2)", Matrix.empty(2))
show("round()", Matrix.round(Matrix.rows(Array[Array[1.5, 2.25], Array[-0.5, 3]])))
show("v.round()", Vector.round(Vector.elements(Array[1.5, 2.25])))
rr = Array[Array[1, 2], Array[3, 4]]
shared = Matrix.rows(rr, false)
copied = Matrix.rows(rr)
Array.fetch(rr, 0)[0] = 9
show("rows no copy", shared)
show("rows copy", copied)
rect3 = Matrix.rows(Array[Array[1, 2, 3], Array[4, 5, 6], Array[7, 8, 9], Array[10, 11, 12]])
Array.each(Array[:all, :diagonal, :off_diagonal, :lower, :strict_lower, :strict_upper, :upper]) do |w|
  zs = Array[]
  Matrix.each(rect3, w) { |e| Array.push(zs, e) }
  ix = Array[]
  Matrix.each_with_index(rect3, w) { |e, i, j| Array.push(ix, Array[i, j]) }
  show("each #{w}", zs)
  show("each_with_index #{w}", ix)
  show("collect #{w}", Matrix.collect(rect3, w) { |e| -e })
  show("map #{w}", Matrix.map(Matrix.t(rect3), w) { |e| e * 10 })
end
try("each :foo") { Matrix.each(rect3, :foo) { |e| e } }

# optional blocks: row/column with a block yield the elements and return the matrix; each
# without a block gives the elements (Ruby: an Enumerator, turned into an Array with to_a)
ob = Matrix.rows(Array[Array[1, 2], Array[3, 4]])
rs = Array[]
p(Matrix.row(ob, 1) { |e| Array.push(rs, e) })
p(Matrix.column(ob, 0) { |e| Array.push(rs, e * 10) })
p(Matrix.row(ob, 5) { |e| Array.push(rs, e) })
p(Matrix.column(ob, 2) { |e| Array.push(rs, e) })
p(rs)
p(Matrix.each(ob))
p(Matrix.each(ob, :diagonal))
p(Vector.each(Vector.elements(Array[1, 2])))

# 2026-10-05: rest parameters (diagonal, vstack, hstack, cross_product) and round with digits
show("vstack3", Matrix.vstack(a, b, Matrix.row_vector(Array[9, 9])))
show("hstack3", Matrix.hstack(a, b, Matrix.column_vector(Array[0, 0])))
show("vstack1", Matrix.vstack(a))
try("vstack bad") { Matrix.vstack(a, b, rect) }
try("hstack bad") { Matrix.hstack(a, Matrix.identity(3)) }
show("diagonal()", Matrix.diagonal())
show("cross 2d", Vector.cross_product(Vector.elements(Array[1, 2])))
try("cross args") { Vector.cross_product(Vector.elements(Array[1, 2, 3])) }
try("cross 1d") { Vector.cross_product(Vector.elements(Array[1])) }
show("round -1", Matrix.round(Matrix.rows(Array[Array[15, 1234.5], Array[1/3r, 25r]]), -1))
show("round 2", Matrix.round(Matrix.rows(Array[Array[15, 1234.5678], Array[1/3r, 2.5]]), 2))
