# CREATE INDEX and DROP INDEX (spec 5.7). An index changes no result; only a UNIQUE index has an effect,
# as a UniqueConstraint added to its table (declared last, so checked first) that remembers the index.
module Indexes
  module_function

  def create(db, st)
    name = CreateIndex.name(st)
    table = Database.table(db, CreateIndex.table(st))
    raise SqlError.new("there is already a table named #{name}") if Database.taken_by(db, name) != nil
    if Database.index(db, name) != nil
      return if CreateIndex.if_not_exists(st)
      raise SqlError.new("index #{name} already exists")
    end
    positions = Array.map(CreateIndex.columns(st)) do |c|
      i = Table.column_position(table, IndexColumn.name(c))
      raise SqlError.new("no such column: #{IndexColumn.name(c)}") if i == nil
      i
    end
    colls = Array.map(Array.each_with_index(CreateIndex.columns(st))) { |c, k| index_collation(table, Array.fetch(positions, k), c) }
    key = Value.lower(name)
    if CreateIndex.unique(st)
      check_existing_rows(table, positions, colls)
      constraint = UniqueConstraint.new(positions, colls, key)
      Database.add_table(db, Table.with_uniques(table, Array.concat(Array.dup(Table.uniques(table)), Array[constraint])))
    end
    Database.add_index(db, IndexDef.new(name, Value.lower(Table.name(table))))
  end

  # The collation an index compares the column at `position` under: the one written on it, else the column's own.
  def index_collation(table, position, c)
    written = IndexColumn.collation(c)
    written == "" ? Column.collation(Array.fetch(Table.columns(table), position)) : Collation.lookup(written)
  end

  # A new UNIQUE index fails with the constraint's error if rows already conflict on its columns.
  def check_existing_rows(table, positions, colls)
    rows = Table.rows(table)
    Array.each_with_index(rows) do |row, i|
      raise SqlError.new(Constraints.unique_message(table, positions)) if Constraints.conflict?(rows, i, positions, colls, row)
    end
  end

  def drop(db, st)
    name = DropIndex.name(st)
    index = Database.index(db, name)
    if index == nil
      return if DropIndex.if_exists(st)
      raise SqlError.new("no such index: #{name}")
    end
    key = Value.lower(name)
    table = Database.table(db, IndexDef.table(index))
    Database.add_table(db, Table.with_uniques(table, Array.reject(Table.uniques(table)) { UniqueConstraint.index_name(it) == key }))
    Database.remove_index(db, name)
  end
end
