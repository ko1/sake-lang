# Port of activerecord-8.1.3/lib/arel/nodes/join_source.rb
#
# Ruby: JoinSource.new(single_source, joinop = []); left is the FROM source, right the joins.

module Arel
  module Nodes
    class JoinSource
      attr_accessor left, right
      include Binary
      def initialize(o) = @right ||= Any[]
      def empty?(o) = !@left && Array.empty?(@right)
    end
  end
end
