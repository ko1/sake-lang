# The blog's routes (Rails' config/routes.rb) for the actionview tests, and the generator of their url helpers
require "rails/actionpack/action_dispatch/routing"

class ActionDispatch::Routing::Mapper
  def blog_routes(map)
    root map, "posts#index"
    resources map, :posts do
      resources map, :comments
    end
    get map, "about", to: "pages#about", as: :about
  end
end

def blog_route_set
  set = ActionDispatch::Routing::RouteSet.make
  ActionDispatch::Routing::RouteSet.draw(set) { |map| ActionDispatch::Routing::Mapper.blog_routes(map) }
  set
end
