# ActiveModel::SecurePassword: has_secure_password (password=, authenticate, the digest's validations,
# confirmation, challenge, the 72-byte limit) on bcrypt.
require "rails/activemodel/active_model"
generate "rails/activemodel/active_model/generate/active_model", "secure_password_decl.rb"
ActiveModel::SecurePassword.set_min_cost(true)

E = ActiveModel::Errors
u = User.new(name: "ko1")
p([User.valid?(u), E.full_messages(User.errors(u))])
u.User.password = "secret"
digest = Kernel.to_s(User.password_digest(u))
p([User.password(u), String.start_with?(digest, "$2"), String.size(digest), User.valid?(u)])
p([User.authenticate(u, "wrong"), User.authenticate(u, "secret") == u, User.authenticate_password(u, "secret") == u])
p(User.password_salt(u) == String.slice(digest, 0, 29))
u.User.password_confirmation = "other"
p([User.valid?(u), E.full_messages(User.errors(u))])
u.User.password_confirmation = "secret"
p(User.valid?(u))
u.User.password_challenge = "nope"
p([User.valid?(u), E.full_messages(User.errors(u))])
u.User.password_challenge = nil
u.User.password = "x" * 73
p([User.valid?(u), E.full_messages(User.errors(u)), E.details(User.errors(u))])
u.User.password = ""
p(String.size(Kernel.to_s(User.password(u))))
u.User.password = nil
p([User.password(u), User.password_digest(u), User.valid?(u)])
u.User.recovery_password = "r3c0v3ry"
p([User.authenticate_recovery_password(u, "r3c0v3ry") == u, User.authenticate_recovery_password(u, "x")])
