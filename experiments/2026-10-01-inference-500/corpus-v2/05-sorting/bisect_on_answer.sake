# Binary search on the answer: smallest truck capacity that ships parcels in D
# days, fairest split of book chapters among readers, and a loan's interest rate
# found by bisection on a Float.

Plan = Struct.new(:capacity, :days, :loads)

def days_needed(weights, cap)
  days = 1
  load = 0
  Array.each(weights) do |w|
    if load + w > cap
      days += 1
      load = 0
    end
    load += w
  end
  days
end

def min_capacity(weights, days)
  raise ArgumentError, "days must be positive" if days <= 0
  lo = Array.max(weights)
  hi = Array.sum(weights)
  probes = 0
  while lo < hi
    mid = (lo + hi) / 2
    probes += 1
    if days_needed(weights, mid) <= days
      hi = mid
    else
      lo = mid + 1
    end
  end
  [lo, probes]
end

def loads_for(weights, cap)
  loads = Array[Array[]]
  Array.each(weights) do |w|
    cur = Array.last(loads)
    if Array.sum(cur) + w > cap
      Array.push(loads, Array[w])
    else
      Array.push(cur, w)
    end
  end
  loads
end

def split_chapters(pages, readers)
  lo = Array.max(pages)
  hi = Array.sum(pages)
  while lo < hi
    mid = (lo + hi) / 2
    if days_needed(pages, mid) <= readers
      hi = mid
    else
      lo = mid + 1
    end
  end
  lo
end

def payment(principal, monthly_rate, months)
  return principal / months if monthly_rate == 0.0
  f = (1.0 + monthly_rate) ** months
  principal * monthly_rate * f / (f - 1.0)
end

def solve_rate(principal, pay, months)
  lo = 0.0
  hi = 1.0
  iterations = 0
  while hi - lo > 1.0e-10
    mid = (lo + hi) / 2.0
    iterations += 1
    if payment(principal, mid, months) < pay
      lo = mid
    else
      hi = mid
    end
  end
  [(lo + hi) / 2.0, iterations]
end

parcels = Array[12, 7, 30, 5, 18, 22, 9, 14, 3, 26, 11, 8, 16, 20, 4]
puts("parcels: #{parcels} (total #{Array.sum(parcels)})")
plans = Array[]
Array.each(Array[1, 3, 5, 8, 15]) do |d|
  cap, probes = min_capacity(parcels, d)
  Array.push(plans, Plan.new(cap, d, loads_for(parcels, cap)))
  puts(format("%2d days -> capacity %3d (%d probes, uses %d days)", d, cap, probes, days_needed(parcels, cap)))
end
tightest = Array.min_by(plans) do |pl|
  used = Array.sum(Array.map(Plan.loads(pl)) { |l| Array.sum(l) })
  Plan.capacity(pl) * Array.size(Plan.loads(pl)) - used
end
puts("least slack: #{Plan.days(tightest)} days, loads #{Array.map(Plan.loads(tightest)) { |l| Array.sum(l) }}")
begin
  min_capacity(parcels, 0)
rescue ArgumentError => e
  puts("error: #{Exception.message(e)}")
end

chapters = Hash["Intro" => 18, "Setup" => 42, "Basics" => 35, "Types" => 60, "Blocks" => 27,
                "Errors" => 33, "Modules" => 51, "Testing" => 24, "Appendix" => 12]
pages = Hash.values(chapters)
names = Hash.keys(chapters)
Array.each(Array[2, 3, 4]) do |readers|
  limit = split_chapters(pages, readers)
  groups = Array[]
  current = Array[]
  sum = 0
  Array.each_with_index(pages) do |pg, i|
    if sum + pg > limit
      Array.push(groups, current)
      current = Array[]
      sum = 0
    end
    Array.push(current, names[i])
    sum += pg
  end
  Array.push(groups, current)
  puts("#{readers} readers, max #{limit} pages each:")
  Array.each_with_index(groups) do |g, i|
    total = Array.sum(Array.map(g) { |nm| chapters[nm] })
    puts("  reader #{i + 1}: #{Array.join(g, ", ")} (#{total})")
  end
end

Array.each(Array[[10000.0, 299.71, 36], [250000.0, 1342.05, 300], [1200.0, 100.0, 12]]) do |principal, pay, months|
  rate, iters = solve_rate(principal, pay, months)
  puts(format("loan %.2f, %d x %.2f -> %.3f%% per year (%d iterations)", principal, months, pay, rate * 1200.0, iters))
end
