# Sake has no value constants. `once { ... }` computes a value the first time its place runs and
# keeps it for the whole program: a table built once, read by every call.
def squares = once do
  puts("building the table")
  Array.map(Range.to_a(0..9)) { |i| i * i }
end
def weekday(i) = once { String["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] }[i % 7]

p(squares[4])
p(Array.sum(squares))     # the same table: "building" is printed once
p(weekday(1))
p(weekday(10))
