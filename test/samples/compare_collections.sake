# Tuples and Arrays compare by contents and in dictionary order; Sets, Hashes, Records by contents.
p([1, "a"] == [1, "a"])
p([1, 2] < [1, 3])
p([2, "a"] <=> [1, "z"])
p(Array.sort_by(Array["bb", "a", "cc", "b"]) { |s| [-String.size(s), s] })
p(Array.max(Array[[1, "b"], [1, "c"], [0, "z"]]))
p(Array[1, 2] == Array[1, 2])
p(Array[1, 2] < Array[1, 2, 0])
p(Set[1, 2] == Set[2, 1])
p(Hash["a" => 1] != Hash["a" => 2])
p({x: 1, y: 2} == {x: 1, y: 2})
p({x: 1} == {y: 1})
