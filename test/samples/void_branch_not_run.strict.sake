# A branch that no value takes (`if x` with x only nil) is not run: its calls would run on the empty value
# and put their types where they write (here a Time among the Hash's values). A later call with a value runs it.
require "time"
def headers(last_modified = nil)
  h = Hash.new
  h["etag"] = "v1"
  h["last-modified"] = Time.httpdate(last_modified) if last_modified
  h
end
v = headers()["etag"]
p(String.size(v)) if v
def tag(x) = x && String.upcase(x)    # `x && f(x)` with x only nil: f is not called
p(tag(nil))
def first(xs)
  r = nil
  i = 0
  while i < Array.size(xs)
    r = xs[i] if r == nil
    i += 1
  end
  r
end
p(first(Any[1, 2]))
