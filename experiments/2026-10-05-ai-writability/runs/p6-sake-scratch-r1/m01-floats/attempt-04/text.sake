# Values as text (SPEC section 8.1): `str` for print, join and interpolation,
# `repr` for everything else.

module Text
  module_function

  def str(v) = (v in String) ? v : repr(v, 0)

  # level counts the containers entered; a value at level 101 is written "...".
  def repr(v, level)
    return "..." if level > 100
    case v
    in Integer then Integer.to_s(v)
    in Float then float_text(v)
    in String then quote(v)
    in true then "true"
    in false then "false"
    in nil then "nil"
    in MiniArray then "[#{Array.join(Array.map(MiniArray.items(v)) { |e| repr(e, level + 1) }, ", ")}]"
    in MiniMap
      entries = Hash.map(MiniMap.entries(v)) { |k, e| "#{repr(k, level + 1)}: #{repr(e, level + 1)}" }
      "{#{Array.join(entries, ", ")}}"
    in Closure
      name = FnLit.name(Closure.fn(v))
      name == "" ? "<fn>" : "<fn #{name}>"
    in Builtin then "<builtin #{Builtin.name(v)}>"
    end
  end

  # The fewest digits that read back (Float.to_s); a whole value of 10^15 up to
  # 10^16 is written in exponent form too (8.1).
  def float_text(f)
    s = Float.to_s(f)
    neg = String.start_with?(s, "-")
    body = neg ? String.slice(s, 1, String.length(s) - 1) : s
    if !String.include?(body, "e") && String.end_with?(body, ".0") && String.length(body) >= 18
      digits = String.delete_suffix(body, ".0")
      exponent = String.length(digits) - 1
      trimmed = String.sub(digits, /0+\z/, "")
      rest = String.slice(trimmed, 1, String.length(trimmed) - 1)
      rest = "0" if String.empty?(rest)
      body = "#{String.slice(trimmed, 0, 1)}.#{rest}e+#{exponent}"
    end
    neg ? "-#{body}" : body
  end

  def quote_escapes = once { Hash["\\" => "\\\\", "\"" => "\\\"", "{" => "\\{", "\n" => "\\n", "\t" => "\\t"] }

  def quote(s) = "\"#{String.gsub(s, /[\\"{\n\t]/, quote_escapes)}\""
end
