require "rails/actionview/action_view/base"

I18n.backend_store(:en, Hash.of(
  hello: "Hello %{name}",
  greeting_html: "<b>Hi %{name}</b>",
  list_html: Any["<i>one</i>", "<i>two</i>"],
  apples: Hash.of(one: "1 apple", other: "%{count} apples"),
  posts: Hash.of(index: Hash.of(title: "All posts", heading_html: "<h1>Posts</h1>"), form: Hash.of(submit: "Save")),
  fallback: "Fallback text"))
I18n.backend_store(:ja, Hash.of(hello: "こんにちは %{name}"))

view = ActionView::Base.empty
V = ActionView::Base

puts V.t(view, :hello, name: "<Ann>")
puts V.t(view, "hello", name: "Bob", locale: :ja)
puts V.t(view, :greeting_html, name: "<Ann>")
p Object.html_safe?(V.t(view, :greeting_html, name: "x"))
p V.t(view, :list_html)
puts V.t(view, :apples, count: 1), V.t(view, :apples, count: 3)
p V.t(view, Any[:hello, :fallback], name: "Z")
puts V.t(view, :missing)
puts V.t(view, :missing, name: "<x>", scope: :foo)
puts V.t(view, :missing, default: "Default text")
puts V.t(view, :missing, default: Any[:also_missing, :fallback])
puts V.t(view, :missing, default: Any[:also_missing, "Literal %{name}"], name: "N")
p V.t(view, :missing, default: nil)
puts V.t(view, :missing, raise: false)
begin
  V.t(view, :missing, raise: true)
rescue I18n::MissingTranslationData => e
  puts "raised"
end
V.set_virtual_path(view, "posts/index")
puts V.t(view, ".title")
puts V.t(view, ".heading_html")
puts V.t(view, ".nope")
V.set_virtual_path(view, "posts/_form")
puts V.t(view, ".submit")
V.t(view, :hello, name: "blk") { |translation, key| puts "#{key}: #{translation}" }
V.set_virtual_path(view, nil)
begin
  V.t(view, ".title")
rescue RuntimeError => e
  puts Exception.message(e)
end
puts V.l(view, Date.new(2026, 10, 20))
puts V.l(view, Time.utc(2026, 10, 20, 9, 5, 0), format: :short)
puts V.localize(view, Date.new(2026, 10, 20), format: :long)
