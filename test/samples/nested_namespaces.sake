# Namespaces nest: `class B` inside `module A` is A::B, as `class A::B` is. Inside `module A`, `B` means A::B
# when that exists (Ruby's lexical lookup), so the module's own code need not spell the prefix.
module Geo
  Point = Struct.new(:x, :y)

  class Point
    def norm2(p) = @x * @x + @y * @y
    def to_s(p) = "(#{@x}, #{@y})"
  end

  class Line
    attr_accessor a, b
    def length2(l) = Point.norm2(Point.new(Point.x(@b) - Point.x(@a), Point.y(@b) - Point.y(@a)))
  end

  module Util
    module_function
    def origin = Point.new(0, 0)
    def describe(p) = "<#{p}>"
  end

  module Measure                      # a mixin: Geo::Measure
    def double(x) = size(x) * 2
  end

  class Bad < Exception
    attr_reader code
  end
end

class Geo::Line                        # the Ruby spelling adds to the same class
  include Measure                      # Geo::Measure, found from inside Geo
  def size(l) = 2
end

module Geo::Util                       # reopened with the Ruby spelling; `def A::B.f` is not Ruby syntax
  module_function
  def unit = Point.new(1, 0)           # `Point` is Geo::Point here too
end
Point = Struct.new(:x, :y)             # a different, top-level Point

pt = Geo::Point.new(3, 4)
puts(Geo::Point.norm2(pt))             # => 25
puts(pt.Geo::Point.norm2)              # the chain form names the nested type too
ln = Geo::Line.new(Geo::Util.origin, pt)
puts(Geo::Line.length2(ln), Geo::Line.double(ln), Geo::Measure.double(ln))
puts(Geo::Util.describe(pt))
p(pt, Point.new(3, 4))
p((pt in Geo::Point), (pt in Point))
puts((Geo::Point|Integer).to_s(pt), (Geo::Point|Integer).to_s(5))
begin
  raise Geo::Bad.new("boom", 7)
rescue Geo::Bad => e
  puts(Exception.message(e), Geo::Bad.code(e))
end
ln.Geo::Line.a = Geo::Point.new(1, 1)
p(Geo::Line.a(ln))
xs = Geo::Point[pt, Geo::Util.origin, Geo::Util.unit]
p(Array.map(xs) { |q| Geo::Point.norm2(q) })
case Geo::Util.origin
in Geo::Point then puts("nested")
end
