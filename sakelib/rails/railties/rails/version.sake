# Port of railties-8.1.3/lib/rails/version.rb and gem_version.rb (two small files; Gem::Version is the String)

module Rails
  module VERSION
    module_function
    def MAJOR = 8
    def MINOR = 1
    def TINY = 3
    def PRE = nil
    def STRING = Array.join(Array.compact(Any[VERSION.MAJOR, VERSION.MINOR, VERSION.TINY, VERSION.PRE]), ".")
  end
end
