<p style="color: green"><%= notice view %></p>

<% content_for view, :title, "Articles" %>

<h1>Articles</h1>

<div id="articles">
  <% ActiveRecord::Relation.each(@articles || raise(ArgumentError, "@articles is not set")) do |article| %>
    <%= render article %>
    <p>
      <%= link_to view, "Show this article", article %>
    </p>
  <% end %>
</div>

<%= link_to view, "New article", new_article_path(view) %>
