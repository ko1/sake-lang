# bin/rails server: serve Blog with WEBrick on 127.0.0.1 (ARGV[0]: the port; 0 picks a free one, printed).
require "../config/application"
require "rackup"

port = Integer(Array.first(ARGV) || "3000")
Rackup::Handler::WEBrick.run(Blog.application, "127.0.0.1", port) do |srv|
  puts "Listening on http://127.0.0.1:#{WEBrick::HTTPServer.port(srv)}"
  IO.flush(IO.stdout)
end
