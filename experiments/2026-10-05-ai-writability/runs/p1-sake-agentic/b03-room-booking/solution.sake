Booking = Struct.new(:id, :room, :day, :s, :e, :who)

def days = once { Array["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] }

# minutes since midnight, or nil if not a valid time
def parse_time(s)
  return nil unless String.match?(s, /\A\d\d:\d\d\z/)
  h = String.to_i(s[0, 2])
  m = String.to_i(s[3, 2])
  return nil if m >= 60
  t = h * 60 + m
  return nil if t % 15 != 0 || t < 480 || t > 1200
  t
end

def hhmm(t) = format("%02d:%02d", t / 60, t % 60)

def overlap?(b, s, e) = Booking.s(b) < e && s < Booking.e(b)

def same_slot?(b, room, day) = Booking.room(b) == room && Booking.day(b) == day

bookings = Array[]
next_id = 1
n = 0
loop do
  line = gets
  break unless line
  n += 1
  f = String.split(String.chomp(line), " ")
  next if Array.size(f) == 0
  cmd = f[0]
  unless Array.include?(Array["BOOK", "CANCEL", "FREE"], cmd)
    puts("line #{n}: error: unknown command")
    next
  end
  want = cmd == "BOOK" ? 5 : (cmd == "CANCEL" ? 2 : 4)
  if Array.size(f) != want
    puts("line #{n}: error: wrong field count")
    next
  end
  if cmd == "CANCEL"
    unless String.match?(f[1], /\A\d+\z/)
      puts("line #{n}: error: bad id")
      next
    end
    id = String.to_i(f[1])
    b = Array.find(bookings) { |x| Booking.id(x) == id }
    if b
      Array.delete(bookings, b)
      puts("CANCELLED ##{id}")
    else
      puts("NO BOOKING ##{id}")
    end
    next
  end
  room = f[1]
  unless String.match?(room, /\A[A-Z0-9]{1,8}\z/)
    puts("line #{n}: error: bad room")
    next
  end
  day = f[2]
  unless Array.include?(days, day)
    puts("line #{n}: error: bad day")
    next
  end
  if cmd == "FREE"
    unless String.match?(f[3], /\A\d+\z/) && String.to_i(f[3]) > 0 && String.to_i(f[3]) % 15 == 0
      puts("line #{n}: error: bad duration")
      next
    end
    mins = String.to_i(f[3])
    t = 480
    found = nil
    while t + mins <= 1200
      if Array.none?(bookings) { |b| same_slot?(b, room, day) && overlap?(b, t, t + mins) }
        found = t
        break
      end
      t += 15
    end
    if found
      puts("FREE #{room} #{day} #{hhmm(found)}-#{hhmm(found + mins)}")
    else
      puts("FULL #{room} #{day}")
    end
    next
  end
  tr = String.split(f[3], "-")
  s = Array.size(tr) == 2 ? parse_time(tr[0]) : nil
  e = Array.size(tr) == 2 ? parse_time(tr[1]) : nil
  if s == nil || e == nil || s >= e
    puts("line #{n}: error: bad time")
    next
  end
  who = f[4]
  unless String.match?(who, /\A[a-z]{1,12}\z/)
    puts("line #{n}: error: bad name")
    next
  end
  hits = Array.select(bookings) { |b| same_slot?(b, room, day) && overlap?(b, s, e) }
  if Array.size(hits) > 0
    c = Array.min_by(hits) { |b| Booking.s(b) }
    puts("CONFLICT #{room} #{day} with ##{Booking.id(c)} (#{Booking.who(c)} #{hhmm(Booking.s(c))}-#{hhmm(Booking.e(c))})")
    next
  end
  if Array.count(bookings) { |b| Booking.who(b) == who && Booking.day(b) == day } >= 3
    puts("LIMIT #{who} #{day}")
    next
  end
  Array.push(bookings, Booking.new(next_id, room, day, s, e, who))
  puts("OK ##{next_id} #{room} #{day} #{hhmm(s)}-#{hhmm(e)} #{who}")
  next_id += 1
end

puts("== schedule ==")
sorted = Array.sort_by(bookings) { |b| [Array.index(days, Booking.day(b)), Booking.room(b), Booking.s(b)] }
puts("(none)") if Array.empty?(sorted)
Array.each(sorted) do |b|
  puts(format("%s %-8s %s-%s #%d %s", Booking.day(b), Booking.room(b), hhmm(Booking.s(b)), hhmm(Booking.e(b)), Booking.id(b), Booking.who(b)))
end
puts("== usage ==")
totals = Hash[]
Array.each(bookings) { |b| totals[Booking.room(b)] = (totals[Booking.room(b)] || 0) + Booking.e(b) - Booking.s(b) }
puts("(none)") if Hash.empty?(totals)
Array.each(Array.sort(Hash.keys(totals))) do |r|
  puts(format("%-8s %dh%02dm", r, totals[r] / 60, totals[r] % 60))
end
