# `g(**opts)` reports: a key g has no keyword for, a required keyword opts lacks, `**` of anything but the
# function's own `**` parameter, and opts written to before it is passed on (its keys no longer followed).
def parse(s, sep: ",", headers: false)
  fields = String.split(s, sep)
  headers ? Array.map(fields) { String.upcase(_1) } : fields
end
def read(s, **opts) = parse(s, **opts)
p read("a;b", sepp: ";")

def need(s, sep:) = String.split(s, sep)
def via(s, **opts) = need(s, **opts)
p via("a,b")

def dropped(s, **opts)
  Hash.delete(opts, :extra)
  parse(s, **opts)
end
p dropped("a,b", headers: true)
