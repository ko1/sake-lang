# FIXED 2026-10-11 (experiments/2026-10-11-libraries3/README.md); kept as the record of the bug.
# A module named Comparable inside Outer hides the built-in for operators, even with `include ::Comparable`:
# error: Comparable.<=>: Outer::V does not include Comparable (expected: -1, true)
class Outer
  module Comparable
    def <(a, b) = (a <=> b) == -1
  end
  class V
    attr_reader n
    include ::Comparable
    def <=>(a, b) = @n <=> V.n(b)
  end
end
p(Outer::V.new(1) <=> Outer::V.new(2))
p(Outer::V.new(1) < Outer::V.new(2))
