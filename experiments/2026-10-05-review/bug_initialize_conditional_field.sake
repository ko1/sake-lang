# A field that initialize writes only conditionally keeps the value new gave it, but the checker
# takes only what initialize writes: M.h is inferred as A, and the B.x below is reported.
class A
  attr_reader x
end
class B
  attr_reader x
end
class M
  attr_reader name, h = nil
  def initialize(m)
    @h = A.new(1) unless @h
  end
end
m = M.new("a", B.new(2))
p(B.x(M.h(m)))   # runs: 2
