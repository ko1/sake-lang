# A simplified Timsort for daily price series: find natural runs (reversing
# strictly descending ones), extend short runs with binary insertion sort,
# and merge runs from a stack while keeping the run lengths balanced.

Run = Struct.new(:start, :length)

Stats = Struct.new(:runs, :reversed, :merges, :compares)

def bump(stats, field)
  case field
  in :runs then Stats.set_runs(stats, Stats.runs(stats) + 1)
  in :reversed then Stats.set_reversed(stats, Stats.reversed(stats) + 1)
  in :merges then Stats.set_merges(stats, Stats.merges(stats) + 1)
  in :compares then Stats.set_compares(stats, Stats.compares(stats) + 1)
  end
end

def reverse_range(a, lo, hi)
  while lo < hi
    t = a[lo]
    a[lo] = a[hi]
    a[hi] = t
    lo += 1
    hi -= 1
  end
end

def count_run(a, lo, stats)
  n = Array.size(a)
  return 1 if lo == n - 1
  hi = lo + 1
  bump(stats, :compares)
  if a[hi] < a[lo]
    hi += 1 while hi < n - 1 && a[hi + 1] < a[hi]
    reverse_range(a, lo, hi)
    bump(stats, :reversed)
  else
    hi += 1 while hi < n - 1 && a[hi + 1] >= a[hi]
  end
  hi - lo + 1
end

def binary_insertion(a, lo, hi, start)
  Integer.upto(start, hi) do |i|
    x = a[i]
    left = lo
    right = i
    while left < right
      mid = (left + right) / 2
      if x < a[mid]
        right = mid
      else
        left = mid + 1
      end
    end
    j = i
    while j > left
      a[j] = a[j - 1]
      j -= 1
    end
    a[left] = x
  end
end

def merge_at(a, stack, i, stats)
  r1 = stack[i]
  r2 = stack[i + 1]
  lo = Run.start(r1)
  mid = lo + Run.length(r1)
  hi = mid + Run.length(r2)
  left = a[lo...mid]
  k = lo
  p = 0
  q = mid
  while p < Array.size(left) && q < hi
    bump(stats, :compares)
    if a[q] < left[p]
      a[k] = a[q]
      q += 1
    else
      a[k] = left[p]
      p += 1
    end
    k += 1
  end
  while p < Array.size(left)
    a[k] = left[p]
    p += 1
    k += 1
  end
  stack[i] = Run.new(lo, hi - lo)
  Array.delete_at(stack, i + 1)
  bump(stats, :merges)
end

def collapse(a, stack, stats)
  while Array.size(stack) > 1
    n = Array.size(stack) - 1
    if n >= 2 && Run.length(stack[n - 2]) <= Run.length(stack[n - 1]) + Run.length(stack[n])
      i = Run.length(stack[n - 2]) < Run.length(stack[n]) ? n - 2 : n - 1
      merge_at(a, stack, i, stats)
    elsif Run.length(stack[n - 1]) <= Run.length(stack[n])
      merge_at(a, stack, n - 1, stats)
    else
      break
    end
  end
end

def timsort(input, min_run)
  a = Array.dup(input)
  stats = Stats.new(0, 0, 0, 0)
  stack = Array[]
  lo = 0
  n = Array.size(a)
  while lo < n
    len = count_run(a, lo, stats)
    if len < min_run
      forced = Integer.clamp(min_run, 1, n - lo)
      binary_insertion(a, lo, lo + forced - 1, lo + len)
      len = forced
    end
    bump(stats, :runs)
    Array.push(stack, Run.new(lo, len))
    collapse(a, stack, stats)
    lo += len
  end
  merge_at(a, stack, Array.size(stack) - 2, stats) while Array.size(stack) > 1
  [a, stats]
end

def describe(label, data, min_run)
  sorted, st = timsort(data, min_run)
  ok = Array.join(sorted, " ") == Array.join(Array.sort(data), " ")
  puts(format("%-10s n=%3d runs=%2d reversed=%d merges=%2d compares=%4d ok=%s", label, Array.size(data),
              Stats.runs(st), Stats.reversed(st), Stats.merges(st), Stats.compares(st), ok))
  sorted
end

prices = Array[101.5, 102.0, 102.4, 103.1, 99.8, 98.2, 97.0, 96.5, 100.1, 100.1, 104.6, 105.0,
               103.3, 103.3, 101.0, 106.2, 107.8, 108.0, 95.4, 96.0]
sorted = describe("prices", prices, 4)
puts("  lowest #{Array.first(sorted)}, highest #{Array.last(sorted)}, median #{sorted[Array.size(sorted) / 2]}")

ascending = Range.to_a(1..64)
describe("ascending", ascending, 8)
describe("descending", Array.reverse(ascending), 8)
saw = Range.map(0...96) { |i| i % 24 < 12 ? i % 24 : 24 - i % 24 }
describe("sawtooth", saw, 8)
noise = Array[]
x = 5
Integer.times(120) do
  x = (x * 75 + 74) % 65537
  Array.push(noise, x % 500)
end
describe("noise", noise, 16)
describe("noise/4", noise, 4)
describe("one", Array[42], 4)
