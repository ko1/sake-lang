require "net_http"
require "open_uri"

# --- a tiny HTTP/1.1 server on an ephemeral port, in a thread ---
def respond(c, status, headers, body)
  Socket.write(c, "HTTP/1.1 #{status}\r\n#{headers}Connection: close\r\n\r\n")
  Socket.write(c, body) if body
  Socket.close(c)
end

def handle(c)
  line = Socket.gets(c)
  return Socket.close(c) unless line
  m = String.match(line, /\A(\S+) (\S+) HTTP/)
  return Socket.close(c) unless m
  verb = m[1] || ""
  path = m[2] || ""
  hdrs = Hash[]
  l = Socket.gets(c)
  while l != nil && String.chomp(l) != ""
    k, _sep, v = String.partition(String.chomp(l), ":")
    hdrs[String.downcase(k)] = String.strip(v)
    l = Socket.gets(c)
  end
  len = hdrs["content-length"]
  body = len ? (Socket.read(c, String.to_i(len)) || "") : ""
  head = verb == "HEAD"
  case path
  in "/hello"
    text = "Hello, world!\n"
    respond(c, "200 OK", "Content-Type: text/plain; charset=utf-8\r\nContent-Length: #{String.bytesize(text)}\r\nX-Custom: yes\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\n", head ? nil : text)
  in "/missing"
    respond(c, "404 Not Found", "Content-Type: text/plain\r\nContent-Length: 9\r\n", "not found")
  in "/chunked"
    chunks = "6;ext=1\r\n{\"ok\":\r\n5\r\ntrue}\r\n0\r\nX-Trailer: t\r\n\r\n"
    respond(c, "200 OK", "Content-Type: application/json\r\nTransfer-Encoding: chunked\r\n", chunks)
  in "/redirect"
    respond(c, "302 Found", "Location: /hello\r\nContent-Length: 0\r\n", "")
  in "/redirect-abs"
    respond(c, "301 Moved Permanently", "Location: http://#{hdrs["host"]}/chunked\r\nContent-Length: 0\r\n", "")
  in "/loop"
    respond(c, "302 Found", "Location: /loop2\r\nContent-Length: 0\r\n", "")
  in "/loop2"
    respond(c, "307 Temporary Redirect", "Location: /loop\r\nContent-Length: 0\r\n", "")
  in "/echo"
    text = "#{verb} #{hdrs["content-type"]} #{body}"
    respond(c, "200 OK", "Content-Type: text/plain\r\nContent-Length: #{String.bytesize(text)}\r\n", text)
  in "/headers"
    text = "ua=#{hdrs["user-agent"]} token=#{hdrs["x-token"]} auth=#{hdrs["authorization"]}"
    respond(c, "200 OK", "Content-Type: text/plain\r\nContent-Length: #{String.bytesize(text)}\r\n", text)
  in "/empty"
    respond(c, "204 No Content", "", nil)
  in "/nolength"
    respond(c, "200 OK", "Content-Type: text/plain\r\n", "until eof\n")
  in "/error"
    respond(c, "500 Internal Server Error", "Content-Length: 4\r\n", "boom")
  in "/html"
    text = "<p>日本語</p>\n"
    respond(c, "200 OK", "Content-Type: text/html\r\nContent-Length: #{String.bytesize(text)}\r\n", text)
  in "/binary"
    bin = Array.pack(Integer[0, 255, 10], "C*")
    respond(c, "200 OK", "Content-Type: application/octet-stream\r\nContent-Length: 3\r\nContent-Encoding: identity\r\n", bin)
  else
    respond(c, "404 Not Found", "Content-Length: 0\r\n", "")
  end
end

def serve(srv)
  loop { handle(TCPServer.accept(srv)) }
end

srv = TCPServer.new("127.0.0.1", 0)
port = TCPServer.port(srv)
server = Thread.new { serve(srv) }
def url(port, path) = "http://127.0.0.1:#{port}#{path}"

puts("-- Net::HTTP.get")
p(Net::HTTP.get(URI.parse(url(port, "/hello"))))
p(Net::HTTP.get("127.0.0.1", "/hello", port))
p(Net::HTTP.get(URI.parse(url(port, "/chunked"))))
p(Net::HTTP.get(URI.parse(url(port, "/nolength"))))
p(Net::HTTP.get(URI.parse(url(port, "/empty"))))
p(Net::HTTP.get(URI.parse(url(port, "/missing"))))
Net::HTTP.get_print(URI.parse(url(port, "/hello")))

puts("-- get_response")
res = Net::HTTP.get_response(URI.parse(url(port, "/hello")))
p(res)
p([Net::HTTPResponse.code(res), Net::HTTPResponse.message(res), Net::HTTPResponse.http_version(res)])
p(Net::HTTPResponse.body(res))
p(Net::HTTPResponse.header(res, "Content-Type"))
p(res["x-custom"])
p(res["X-Missing"])
p(Net::HTTPResponse.content_type(res))
p(Net::HTTPResponse.content_length(res))
p(Net::HTTPResponse.key?(res, "set-cookie"))
p(res["set-cookie"])
p(Net::HTTPResponse.get_fields(res, "set-cookie"))
p(Net::HTTPResponse.to_hash(res))
Net::HTTPResponse.each_header(res) { |k, v| puts("#{k}: #{v}") }
p([Net::HTTPResponse.success?(res), Net::HTTPResponse.redirection?(res), Net::HTTPResponse.client_error?(res), Net::HTTPResponse.server_error?(res)])
p(Net::HTTPResponse.value(res))

res = Net::HTTP.get_response(URI.parse(url(port, "/missing")))
p(res)
p([Net::HTTPResponse.code(res), Net::HTTPResponse.message(res), Net::HTTPResponse.body(res), Net::HTTPResponse.success?(res), Net::HTTPResponse.client_error?(res)])
begin
  Net::HTTPResponse.value(res)
rescue Net::HTTPClientException => e
  puts("Net::HTTPClientException: #{Exception.message(e)} #{Net::HTTPResponse.code(Net::HTTPClientException.response(e))}")
end
res = Net::HTTP.get_response(URI.parse(url(port, "/error")))
p(res)
begin
  Net::HTTPResponse.value(res)
rescue Net::HTTPFatalError => e
  puts("Net::HTTPFatalError: #{Exception.message(e)}")
end

puts("-- chunked, no body, redirect (not followed)")
res = Net::HTTP.get_response(URI.parse(url(port, "/chunked")))
p([Net::HTTPResponse.body(res), res["transfer-encoding"], res["content-length"], Net::HTTPResponse.content_type(res)])
res = Net::HTTP.get_response(URI.parse(url(port, "/empty")))
p([res, Net::HTTPResponse.body(res), Net::HTTPResponse.content_length(res)])
res = Net::HTTP.get_response(URI.parse(url(port, "/redirect")))
p([res, Net::HTTPResponse.redirection?(res), res["location"], Net::HTTPResponse.body(res)])
begin
  Net::HTTPResponse.value(res)
rescue Net::HTTPRetriableError => e
  puts("Net::HTTPRetriableError: #{Exception.message(e)}")
end
res = Net::HTTP.get_response(URI.parse(url(port, "/html")))
body = Net::HTTPResponse.body(res) || ""
p([String.encoding(body), String.force_encoding(body, "UTF-8")])
res = Net::HTTP.get_response(URI.parse(url(port, "/binary")))
p([Net::HTTPResponse.body(res), String.encoding(Net::HTTPResponse.body(res) || "")])

puts("-- post, post_form")
res = Net::HTTP.post(URI.parse(url(port, "/echo")), "{\"a\":1}", Hash["Content-Type" => "application/json"])
p([res, Net::HTTPResponse.body(res)])
res = Net::HTTP.post(URI.parse(url(port, "/echo")), "plain")
p(Net::HTTPResponse.body(res))
res = Net::HTTP.post_form(URI.parse(url(port, "/echo")), Hash["a" => "1", "b" => "two words"])
p(Net::HTTPResponse.body(res))

puts("-- requests")
req = Net::HTTP::Get.new("/headers", Hash["X-Token" => "t0k"])
p(req)
p([Net::HTTPRequest.method(req), Net::HTTPRequest.path(req), req["x-token"], req["User-Agent"]])
req["User-Agent"] = "sake-test"
Net::HTTPRequest.basic_auth(req, "user", "pw")
p(req["authorization"])
p(Net::HTTPRequest.key?(req, "X-TOKEN"))
p(Hash.except(Net::HTTPRequest.to_hash(req), "accept-encoding"))
Net::HTTPRequest.each_header(req) { |k, v| puts("#{k}: #{v}") unless k == "accept-encoding" }
p(Net::HTTPRequest.delete(req, "accept"))
p(Net::HTTPRequest.key?(req, "accept"))
Net::HTTPRequest.add_field(req, "Foo", "a")
Net::HTTPRequest.add_field(req, "foo", "b")
p([req["foo"], Net::HTTPRequest.get_fields(req, "foo")])
req["foo"] = nil
p(Net::HTTPRequest.key?(req, "foo"))
p([Net::HTTPRequest.request_body_permitted?(req), Net::HTTPRequest.response_body_permitted?(req)])
post = Net::HTTP::Post.new("/echo")
Net::HTTPRequest.set_form_data(post, Hash["k" => "v w", "x" => "1&2"])
p([Net::HTTPRequest.body(post), Net::HTTPRequest.content_type(post), post["content-type"]])
Net::HTTPRequest.set_form_data(post, Array[["k", "v"], ["k", "w"]], ";")
p(Net::HTTPRequest.body(post))
Net::HTTPRequest.set_content_type(post, "text/plain")
p(Net::HTTPRequest.content_type(post))
p([Net::HTTPRequest.request_body_permitted?(post), Net::HTTP::Head.new("/").Net::HTTPRequest.response_body_permitted?])
p([Net::HTTP::Put.new("/"), Net::HTTP::Delete.new("/"), Net::HTTP::Patch.new("/"), Net::HTTP::Head.new("/")])
begin
  Net::HTTP::Get.new("")
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
ureq = Net::HTTP::Get.new(URI.parse("http://example.com/a/b?c=1"))
p([Net::HTTPRequest.path(ureq), ureq["host"]])
ureq = Net::HTTP::Get.new(URI.parse("http://example.com:8080/"))
p([Net::HTTPRequest.path(ureq), ureq["host"]])

puts("-- start")
out = Net::HTTP.start("127.0.0.1", port) do |http|
  p(Net::HTTP.started?(http))
  p([Net::HTTP.address(http) == "127.0.0.1", Net::HTTP.port(http) == port])
  res = Net::HTTP.request(http, req)
  p(Net::HTTPResponse.body(res))
  res = Net::HTTP.request(http, post)
  p(Net::HTTPResponse.body(res))
  res = Net::HTTP.head(http, "/hello")
  p([res, Net::HTTPResponse.body(res), res["content-length"]])
  res = Net::HTTP.request_get(http, "/hello", Hash["X-Token" => "ignored"])
  p(Net::HTTPResponse.body(res))
  res = Net::HTTP.request_post(http, "/echo", "x=1", Hash["Content-Type" => "application/x-www-form-urlencoded"])
  p(Net::HTTPResponse.body(res))
  res = Net::HTTP.put(http, "/echo", "P", Hash["Content-Type" => "text/plain"])
  p(Net::HTTPResponse.body(res))
  res = Net::HTTP.patch(http, "/echo", "Q", Hash["Content-Type" => "text/plain"])
  p(Net::HTTPResponse.body(res))
  res = Net::HTTP.delete(http, "/echo")
  p(Net::HTTPResponse.body(res))
  res = Net::HTTP.send_request(http, "OPTIONS", "/echo")
  p(Net::HTTPResponse.body(res))
  res = Net::HTTP.request(http, Net::HTTP::Get.new("/hello")) { |r| puts("block: #{Net::HTTPResponse.code(r)}") }
  p(Net::HTTPResponse.code(res))
  :done
end
p(out)
http = Net::HTTP.new("127.0.0.1", port)
p(Net::HTTP.started?(http))
Net::HTTP.start(http)
p(Net::HTTP.started?(http))
begin
  Net::HTTP.start(http)
rescue IOError => e
  puts("IOError: #{Exception.message(e)}")
end
p(Net::HTTPResponse.body(Net::HTTP.request_get(http, "/hello")))
Net::HTTP.finish(http)
p(Net::HTTP.started?(http))
begin
  Net::HTTP.finish(http)
rescue IOError => e
  puts("IOError: #{Exception.message(e)}")
end

puts("-- connection refused")
closed = TCPServer.new("127.0.0.1", 0)
closed_port = TCPServer.port(closed)
TCPServer.close(closed)
begin
  Net::HTTP.get_response("127.0.0.1", "/", closed_port)
  puts("connected?")
rescue IOError => e
  puts("refused")
end

puts("-- OpenURI.open")
text = OpenURI.open(url(port, "/hello")) { |f| OpenURI::Meta.read(f) }
p(text)
f = OpenURI.open(url(port, "/hello"))
p(f)
p(OpenURI::Meta.status(f))
p(OpenURI::Meta.content_type(f))
p(OpenURI::Meta.charset(f))
p(OpenURI::Meta.meta(f))
p(OpenURI::Meta.metas(f))
p(OpenURI::Meta.content_encoding(f))
p(URI.path(OpenURI::Meta.base_uri(f)))
p([OpenURI::Meta.size(f), OpenURI::Meta.eof?(f)])
p(OpenURI::Meta.read(f, 5))
p(OpenURI::Meta.read(f, 0))
p(OpenURI::Meta.read(f))
p(OpenURI::Meta.read(f))
p(OpenURI::Meta.read(f, 3))
p(OpenURI::Meta.eof?(f))
p(OpenURI::Meta.rewind(f))
p(OpenURI::Meta.gets(f))
p(OpenURI::Meta.gets(f))
OpenURI::Meta.rewind(f)
p(OpenURI::Meta.readlines(f))
OpenURI::Meta.rewind(f)
OpenURI::Meta.each_line(f) { |l| p(l) }
p(OpenURI::Meta.string(f))
p(OpenURI::Meta.last_modified(f))

puts("-- redirects")
f = OpenURI.open(url(port, "/redirect"))
p([OpenURI::Meta.status(f), URI.path(OpenURI::Meta.base_uri(f)), OpenURI::Meta.read(f)])
f = OpenURI.open(url(port, "/redirect-abs"))
p([OpenURI::Meta.status(f), URI.path(OpenURI::Meta.base_uri(f)), OpenURI::Meta.read(f), OpenURI::Meta.content_type(f), OpenURI::Meta.charset(f)])
begin
  OpenURI.open(url(port, "/loop"))
rescue RuntimeError => e
  puts(String.split(Exception.message(e), ": ")[0])
end
begin
  OpenURI.open(url(port, "/redirect"), Hash[:redirect => false])
rescue OpenURI::HTTPRedirect => e
  puts("OpenURI::HTTPRedirect: #{Exception.message(e)} -> #{URI.path(OpenURI::HTTPRedirect.uri(e))}")
end
begin
  OpenURI.open(url(port, "/loop"), Hash[:max_redirects => 1])
rescue OpenURI::TooManyRedirects => e
  puts("OpenURI::TooManyRedirects: #{Exception.message(e)} #{OpenURI::Meta.status(OpenURI::TooManyRedirects.io(e))}")
end

puts("-- errors")
begin
  OpenURI.open(url(port, "/missing"))
rescue OpenURI::HTTPError => e
  io = OpenURI::HTTPError.io(e)
  puts("OpenURI::HTTPError: #{Exception.message(e)} #{OpenURI::Meta.status(io)} #{Kernel.inspect(OpenURI::Meta.read(io))}")
end
begin
  OpenURI.open(url(port, "/error"))
rescue OpenURI::HTTPError => e
  puts("OpenURI::HTTPError: #{Exception.message(e)}")
end
begin
  OpenURI.open("http://user:pw@127.0.0.1:#{port}/hello")
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end

puts("-- options, content types")
p(OpenURI.open(url(port, "/headers"), Hash["User-Agent" => "ua-x", "X-Token" => "tok"]) { |f| OpenURI::Meta.read(f) })
p(OpenURI.open(url(port, "/headers"), Hash[:http_basic_authentication => ["user", "pw"]]) { |f| OpenURI::Meta.read(f) })
p(OpenURI.open_uri(url(port, "/headers")) { |f| OpenURI::Meta.read(f) })
f = OpenURI.open(url(port, "/html"))
s = OpenURI::Meta.read(f)
p([OpenURI::Meta.content_type(f), OpenURI::Meta.charset(f), String.encoding(s), s])
f = OpenURI.open(url(port, "/binary"))
s = OpenURI::Meta.read(f)
p([OpenURI::Meta.content_type(f), OpenURI::Meta.charset(f), String.encoding(s), s, OpenURI::Meta.content_encoding(f)])
f = OpenURI.open(url(port, "/chunked"))
p([OpenURI::Meta.content_type(f), OpenURI::Meta.charset(f), OpenURI::Meta.read(f), OpenURI::Meta.meta(f)])
f = OpenURI.open(url(port, "/empty"))
p([OpenURI::Meta.status(f), OpenURI::Meta.read(f), OpenURI::Meta.content_type(f), OpenURI::Meta.charset(f), OpenURI::Meta.eof?(f), OpenURI::Meta.gets(f)])
f = OpenURI.open(URI.parse(url(port, "/nolength")))
p([OpenURI::Meta.read(f), OpenURI::Meta.meta(f)])

TCPServer.close(srv)
puts("end")
