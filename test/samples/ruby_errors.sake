# A Ruby error inside a built-in is a Sake exception of the same kind, and can be rescued.
begin
  Integer.chr(256)
rescue RangeError => e
  puts "RangeError: #{Exception.message(e)}"
end
begin
  Regexp.new("(")
rescue RegexpError => e
  puts "RegexpError: #{Exception.message(e)}"
end
begin
  Arithmetic.round(Float.NAN)
rescue FloatDomainError => e
  puts "FloatDomainError: #{Exception.message(e)}"
end
begin
  Integer.sqrt(-1)
rescue Math::DomainError => e
  puts "Math::DomainError: #{Exception.message(e)}"
end
begin
  "ab" * -1
rescue ArgumentError => e
  puts "ArgumentError: #{Exception.message(e)}"
end
begin
  Array.transpose(Array[[1, 2], [3]])
rescue IndexError => e
  puts "IndexError: #{Exception.message(e)}"
end
begin
  Array.insert(Array[1], 3, 2)
rescue IndexError => e
  puts "IndexError: #{Exception.message(e)}"
end
begin
  Set.subtract(Set[1], 1)
rescue TypeError => e
  puts "TypeError: #{Exception.message(e)}"
end
begin
  (-8.0) ** 0.5
rescue Math::DomainError => e
  puts "Math::DomainError: #{Exception.message(e)}"
end
begin
  rand(0)
rescue ArgumentError => e
  puts "ArgumentError: #{Exception.message(e)}"
end
# The function forms of == and != give false / true for another type, as the operators do.
p(Integer.==(1, "a"), String.!=("a", 1), Hash.==(Hash["a" => 1], nil), Range.==(1..5, 5))
# Behaviours fixed on 2026-10-10.
p(Range.include?("a".."z", "mm"), Range.cover?("a".."z", "mm"))
p(Array.transpose(Array[[1, 2], [3, 4]]))
p(Array.dig(Array[Array[1, 2], Array[3]], 1, 0), Hash.dig(Hash["a" => Hash["b" => 1]], "a", "b"), Hash.dig(Hash["a" => Hash["b" => 1]], "x", "b"))
p(Regexp.union(Array["a", "b"]), Regexp.new("a", "n"))
p(Math.log(8, 2), Rational(0.5), Arithmetic.round(1234.5, -2), Arithmetic.round(2.5, half: :even), Float.round(2.5, 0, half: :even))
p(4r ** 2r, 4r ** (1r / 2), Complex.abs(Complex(3r, 0)))
s = Kernel.dup("abc")
String.force_encoding(s, "ASCII-8BIT")
p(String.encoding(s))
p(Array.flat_map(Array[1, 2]) { |x| [x, x] }, Hash.flat_map(Hash["a" => 1]) { |k, v| [k, v] })
p(Integer.digits(123), Range.minmax(1.0..2.5), Process.clock_gettime(Process.CLOCK_MONOTONIC, :millisecond) > 0)
x = 1
puts "a#{x}" \
     "b"
