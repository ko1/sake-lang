module Sql
  module Query
    class Entry
      attr_reader values: Array[value]
      attr_reader keys: Array[value]

      def initialize: (Array[value] values, Array[value] keys) -> void
    end

    def self.run: (Ast::Query statement, Catalog catalog) -> Array[String]
    def self.result_rows: (Plan plan, Array[value] outer) -> Array[Array[value]]
    def self.select_rows: (SelectPlan plan, Array[value] outer) -> Array[Array[value]]
    def self.finish: (Array[Array[value]] rows, Array[Ast::OrderTerm] order_by, Ast::Expr? limit, Ast::Expr? offset) -> Array[Array[value]]
    def self.window: [T] (Array[T] items, Ast::Expr? limit_expr, Ast::Expr? offset_expr) -> Array[T]
    def self.source_rows: (SelectPlan plan, Array[value] outer) -> Array[Array[value]]
    def self.item_rows: (PlanSource item) -> Array[Array[value]]
    def self.entries: (SelectPlan plan, Array[Array[value]] rows) -> Array[Entry]
    def self.distinct: (Array[Entry] entries) -> Array[Entry]
    def self.bound: (Ast::Expr? expr) -> Integer?
  end
end
