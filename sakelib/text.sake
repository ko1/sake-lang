# text: string metrics and formatting.
#   Levenshtein.distance(a, b, max_distance = nil)       the text gem's Text::Levenshtein
#   Soundex.soundex(s)                                     the text gem's Text::Soundex
#   JaroWinkler.distance(a, b, ignore_case:, weight:, threshold:), JaroWinkler.jaro_distance
#                                                          the jaro_winkler gem
#   WordWrap.word_wrap(text, line_width: 80, break_sequence: "\n")   ActionView's word_wrap
# Ruby's Text::Levenshtein is a nested name; Sake has none, so each is a top-level module.

module Levenshtein
  module_function

  # Edit distance (insert, delete, substitute) over characters; with max_distance, a larger
  # distance is reported as max_distance.
  def distance(a, b, max_distance = nil)
    a => String
    b => String
    t = String.chars(b)
    prev = Range.to_a(0..Array.size(t))
    String.chars(a).Array.each_with_index do |sc, i|
      cur = Integer[i + 1]
      Array.each_with_index(t) do |tc, j|
        cost = sc == tc ? 0 : 1
        Array.push(cur, Tuple.min([Array.fetch(cur, j) + 1, Array.fetch(prev, j + 1) + 1, Array.fetch(prev, j) + cost]))
      end
      prev = cur
    end
    d = Array.fetch(prev, -1)
    max_distance && d > max_distance ? max_distance : d
  end
end

module Soundex
  module_function

  def codes = once do
    h = Hash[]
    Array.each(Array[["BFPV", "1"], ["CGJKQSXZ", "2"], ["DT", "3"], ["L", "4"], ["MN", "5"], ["R", "6"]]) do |letters, code|
      String.each_char(letters) { |c| h[c] = code }
    end
    h
  end

  # American Soundex: the first letter, then up to three digits; nil when there is no letter.
  def soundex(str)
    letters = String.gsub(String.upcase(str), /[^A-Z]/, "")
    return nil if String.empty?(letters)
    first = String.chr(letters)
    out = first
    last = codes[first]
    Array.each(Array.drop(String.chars(letters), 1)) do |c|
      code = codes[c]
      if code
        out += code if code != last
        last = code
      elsif c != "H" && c != "W"
        last = nil
      end
      break if String.size(out) == 4
    end
    String.ljust(out, 4, "0")
  end
end

module JaroWinkler
  module_function

  def jaro_distance(s1, s2, ignore_case: false)
    a = String.chars(ignore_case ? String.downcase(s1) : s1)
    b = String.chars(ignore_case ? String.downcase(s2) : s2)
    return 1.0 if Array.empty?(a) && Array.empty?(b)
    return 0.0 if Array.empty?(a) || Array.empty?(b)
    window = Tuple.max([Tuple.max([Array.size(a), Array.size(b)]) / 2 - 1, 0])
    a_match = Array.new(Array.size(a), false)
    b_match = Array.new(Array.size(b), false)
    matches = 0
    Array.each_with_index(a) do |c, i|
      lo = Tuple.max([i - window, 0])
      hi = Tuple.min([i + window, Array.size(b) - 1])
      Range.each(lo..hi) do |j|
        next if b_match[j] || b[j] != c
        a_match[i] = true
        b_match[j] = true
        matches += 1
        break
      end
    end
    return 0.0 if matches == 0
    as = Array.each_with_index(a).Array.select { |_, i| a_match[i] }.Array.map { |c, _| c }
    bs = Array.each_with_index(b).Array.select { |_, j| b_match[j] }.Array.map { |c, _| c }
    transpositions = Array.count(Array.zip(as, bs)) { |x, y| x != y } / 2
    m = Integer.to_f(matches)
    (m / Array.size(a) + m / Array.size(b) + (m - transpositions) / m) / 3.0
  end

  # Jaro similarity, raised for a common prefix (up to 4 characters) when it is above threshold.
  def distance(s1, s2, ignore_case: false, weight: 0.1, threshold: 0.7)
    raise ArgumentError, "weight should not exceed 0.25" if weight > 0.25
    j = jaro_distance(s1, s2, ignore_case:)
    return j if j <= threshold
    a = ignore_case ? String.downcase(s1) : s1
    b = ignore_case ? String.downcase(s2) : s2
    prefix = 0
    prefix += 1 while prefix < 4 && prefix < String.size(a) && prefix < String.size(b) && a[prefix] == b[prefix]
    j + prefix * weight * (1 - j)
  end
end

module WordWrap
  module_function

  # ActionView's word_wrap: break lines longer than line_width at whitespace.
  def word_wrap(text, line_width: 80, break_sequence: "\n")
    raise ArgumentError, "line_width must be positive" unless line_width > 0
    String.split(text, "\n").Array.map do |line|
      String.length(line) > line_width ? String.rstrip(String.gsub(line, /(.{1,#{line_width}})(\s+|$)/, "\\1#{break_sequence}")) : line
    end.Array.join(break_sequence)
  end
end
