# Port of activemodel-8.1.3/lib/active_model/forbidden_attributes_protection.rb
#
# Ruby asks `attributes.respond_to?(:permitted?)` (ActionController::Parameters). Here a type that includes
# ForbiddenAttributesProtection::Parameters (Sake only) answers permitted? and to_h; a Hash is taken as is.

module ActiveModel
  class ForbiddenAttributesError < StandardError
  end

  module ForbiddenAttributesProtection
    module Parameters
      def permitted?(p) = raise(NotImplementedError)
      def to_h(p) = raise(NotImplementedError)
    end

    def sanitize_for_mass_assignment(r, attributes)
      case attributes
      in Hash then attributes
      else
        raise ActiveModel::ForbiddenAttributesError, "ActiveModel::ForbiddenAttributesError" if !Parameters.permitted?(attributes)
        Parameters.to_h(attributes)
      end
    end
    def sanitize_forbidden_attributes(r, attributes) = sanitize_for_mass_assignment(r, attributes)
  end
end
