# Gift shopping with a sorted price list: the pair that best uses a budget
# (two pointers), all pairs summing to an exact amount, the three-item bundle
# closest to a target, and pairs whose prices differ by a fixed step.

Item = Struct.new(:name, :cents)

class Item
  def to_s(i) = "#{@name} #{price(@cents)}"
end

def price(c) = format("$%d.%02d", c / 100, c % 100)

def best_pair(items, budget)
  i = 0
  j = Array.size(items) - 1
  best = nil
  best_sum = 0
  while i < j
    s = Item.cents(items[i]) + Item.cents(items[j])
    if s > budget
      j -= 1
    else
      if s > best_sum
        best_sum = s
        best = [items[i], items[j]]
      end
      i += 1
    end
  end
  best
end

def exact_pairs(items, total)
  out = Array[]
  i = 0
  j = Array.size(items) - 1
  while i < j
    s = Item.cents(items[i]) + Item.cents(items[j])
    if s == total
      Array.push(out, "#{Item.name(items[i])}+#{Item.name(items[j])}")
      i += 1
      j -= 1
    elsif s < total
      i += 1
    else
      j -= 1
    end
  end
  out
end

def closest_triple(items, target)
  n = Array.size(items)
  best = nil
  best_diff = nil
  Integer.upto(0, n - 3) do |a|
    lo = a + 1
    hi = n - 1
    while lo < hi
      s = Item.cents(items[a]) + Item.cents(items[lo]) + Item.cents(items[hi])
      d = Integer.abs(s - target)
      if best_diff == nil || d < best_diff
        best_diff = d
        best = Array[items[a], items[lo], items[hi]]
      end
      return [best, 0] if s == target
      if s < target
        lo += 1
      else
        hi -= 1
      end
    end
  end
  [best, best_diff]
end

def pairs_with_gap(items, gap)
  out = Array[]
  j = 0
  Array.each_with_index(items) do |x, i|
    j = i + 1 if j <= i
    j += 1 while j < Array.size(items) && Item.cents(items[j]) - Item.cents(x) < gap
    if j < Array.size(items) && Item.cents(items[j]) - Item.cents(x) == gap
      Array.push(out, [Item.name(x), Item.name(items[j])])
    end
  end
  out
end

catalog = Hash[
  "candle" => 1250, "socks" => 899, "mug" => 1450, "book" => 2399, "scarf" => 3100,
  "puzzle" => 1999, "tea set" => 4250, "plant" => 1650, "notebook" => 750, "headphones" => 5999,
  "chocolate" => 650, "poster" => 1100
]
items = Array.sort_by(Hash.map(catalog) { |n, c| Item.new(n, c) }) { |it| Item.cents(it) }
puts("sorted: #{Array.join(Array.map(items) { |it| Item.name(it) }, ", ")}")

Array.each(Array[2000, 5000, 1000, 1200]) do |budget|
  pair = best_pair(items, budget)
  if pair
    a, b = pair
    puts("budget #{price(budget)}: #{a} + #{b} = #{price(Item.cents(a) + Item.cents(b))}")
  else
    puts("budget #{price(budget)}: nothing fits")
  end
end

puts("exactly $27.50: #{exact_pairs(items, 2750)}")
puts("exactly $99.99: #{exact_pairs(items, 9999)}")

Array.each(Array[5000, 10000]) do |target|
  trio, diff = closest_triple(items, target)
  names = Array.join(Array.map(trio) { |it| Item.name(it) }, ", ")
  total = Array.sum(Array.map(trio) { |it| Item.cents(it) })
  puts("bundle near #{price(target)}: #{names} = #{price(total)} (off by #{price(diff)})")
end

Array.each(pairs_with_gap(items, 200)) { |cheap, dear| puts("#{dear} costs $2.00 more than #{cheap}") }
under = Array.take_while(items) { |it| Item.cents(it) < 1500 }
puts("#{Array.size(under)} gifts under $15: #{Array.join(under, "; ")}")
