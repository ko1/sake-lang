# Values as text (SPEC section 8.1): `str` for print, join and interpolation,
# `repr` for everything else.

module Text
  module_function

  def str(v) = (v in String) ? v : repr(v, 0)

  # level counts the containers entered; a value at level 101 is written "...".
  def repr(v, level)
    return "..." if level > 100
    case v
    in Integer then Integer.to_s(v)
    in Float then float_text(v)
    in String then quote(v)
    in true then "true"
    in false then "false"
    in nil then "nil"
    in MiniArray then "[#{Array.join(Array.map(MiniArray.items(v)) { |e| repr(e, level + 1) }, ", ")}]"
    in MiniMap
      entries = Hash.map(MiniMap.entries(v)) { |k, e| "#{repr(k, level + 1)}: #{repr(e, level + 1)}" }
      "{#{Array.join(entries, ", ")}}"
    in Closure
      name = FnLit.name(Closure.fn(v))
      name == "" ? "<fn>" : "<fn #{name}>"
    in Builtin then "<builtin #{Builtin.name(v)}>"
    end
  end

  # The fewest digits that read back, in the SPEC 8.1 plain or exponent form.
  def float_text(v)
    s = Float.to_s(v)
    neg = String.start_with?(s, "-")
    body = neg ? String.delete_prefix(s, "-") : s
    return s if body == "0.0"
    digits, e10 = decimal_digits(body)
    n = String.length(digits)
    exp_form = e10 < -4 || e10 >= 16 || (e10 >= 15 && n <= e10 + 1)
    return s unless exp_form
    sign = neg ? "-" : ""
    first = String.slice(digits, 0, 1) || "0"
    rest = n > 1 ? (String.slice(digits, 1, n - 1) || "0") : "0"
    esign = e10 < 0 ? "-" : "+"
    mag = Integer.to_s(e10 < 0 ? -e10 : e10)
    "#{sign}#{first}.#{rest}e#{esign}#{String.rjust(mag, 2, "0")}"
  end

  # The significant digits of Float#to_s text (no leading or trailing zeros)
  # and the decimal exponent of the first one.
  def decimal_digits(body)
    if String.include?(body, "e")
      halves = String.split(body, "e")
      mant = halves[0] || ""
      return trim_zeros(String.delete(mant, ".")), String.to_i(halves[1] || "0")
    end
    halves = String.split(body, ".")
    ip = halves[0] || ""
    fp = halves[1] || ""
    return trim_zeros(ip + fp), String.length(ip) - 1 if ip != "0"
    lead = String.sub(fp, /\A0+/, "")
    return trim_zeros(lead), -(String.length(fp) - String.length(lead) + 1)
  end

  def trim_zeros(ds) = String.sub(ds, /0+\z/, "")

  def quote_escapes = once { Hash["\\" => "\\\\", "\"" => "\\\"", "{" => "\\{", "\n" => "\\n", "\t" => "\\t"] }

  def quote(s) = "\"#{String.gsub(s, /[\\"{\n\t]/, quote_escapes)}\""
end
