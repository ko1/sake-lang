# An SQLite3 error that nothing rescues ends the program with the gem's class and message.
db = SQLite3::Database.new(":memory:")
SQLite3::Database.execute(db, "create table t (id integer primary key)")
SQLite3::Database.execute(db, "insert into t values (1)")
p(SQLite3::Database.execute(db, "select ?, ?", Any[1]))
begin
  SQLite3::Database.execute(db, "select ?", Any[1, 2])
rescue SQLite3::RangeException => e
  p(e)
end
SQLite3::Database.transaction(db) { |d|
  SQLite3::Database.execute(d, "insert into t values (2)")
  SQLite3::Database.execute(d, "insert into t values (1)")
}
