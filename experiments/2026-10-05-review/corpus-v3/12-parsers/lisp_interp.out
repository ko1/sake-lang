-- program 1
(define (fact n) (if (< n 2) 1 (* n (fact (- n 1))))) => fact
(fact 10) => 3628800
(fact 20) => 2432902008176640000
-- program 2
(define (fib n) (cond ((< n 2) n) (else (+ (fib (- n 1)) (fib (- n 2)))))) => fib
(fib 12) => 144
-- program 3
(define (map f xs) (if (null? xs) (quote ()) (cons (f (car xs)) (map f (cdr xs))))) => map
(define (filter p xs) (cond ((null? xs) (quote ())) ((p (car xs)) (cons (car xs) (filter p (cdr xs)))) (else (filter p (cdr xs))))) => filter
(define (foldl f acc xs) (if (null? xs) acc (foldl f (f acc (car xs)) (cdr xs)))) => foldl
(map (lambda (x) (* x x)) (quote (1 2 3 4 5))) => (1 4 9 16 25)
(filter (lambda (x) (< 2 x)) (list 5 1 4 2 3)) => (5 4 3)
(foldl + 0 (map (lambda (x) (* 2 x)) (quote (1 2 3)))) => 12
(foldl (lambda (acc x) (cons x acc)) (quote ()) (quote (a b c d))) => (d c b a)
-- program 4
(define (make-counter) (let ((n 0)) (lambda () (set! n (+ n 1)) n))) => make-counter
(define c1 (make-counter)) => c1
(define c2 (make-counter)) => c2
(c1) => 1
(c1) => 2
(c2) => 1
(c1) => 3
(list (c1) (c2)) => (4 2)
make-counter => #<lambda make-counter>
car => #<primitive car>
