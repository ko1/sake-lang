# Runs one parsed statement; returns the lines it prints (only SELECT prints any).
module Executor
  module_function

  def execute(db, stmt)
    case stmt
    in CreateTable
      Ddl.create_table(db, stmt)
      Array[]
    in DropTable
      Ddl.drop_table(db, stmt)
      Array[]
    in Insert
      Dml.insert(db, stmt)
      Array[]
    in Update
      Dml.update(db, stmt)
      Array[]
    in Delete
      Dml.delete(db, stmt)
      Array[]
    in Select then Query.run(db, stmt)
    end
  end
end
