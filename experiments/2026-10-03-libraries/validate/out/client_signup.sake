# ---- validate: Result values and record validation ------------------------

# Result: a Record, {ok: value} or {err: error}.
# Not a Struct type: a Struct field has one type for the whole program, so an
# Ok(String) and an Ok(Integer) would blur together. A Record's type is its
# shape, so each {ok: T} keeps its own T.
module Result
  module_function
  def ok(v) = {ok: v}
  def err(e) = {err: e}
  def ok?(r) = (r in {ok:})
  def err?(r) = (r in {err:})

  # The value, or raise UnwrapError carrying the error's text.
  def unwrap(r)
    case r
    in {ok:} then ok
    in {err:} then raise UnwrapError.new("unwrap on Err: #{err}")
    end
  end

  def unwrap_or(r, default)
    case r
    in {ok:} then ok
    in {err:} then default
    end
  end

  # map: the block turns an ok value into a new value; an err passes through.
  def map(r)
    case r
    in {ok:} then {ok: yield(ok)}
    in {err:} then r
    end
  end

  # and_then: the block returns a Result itself.
  def and_then(r)
    case r
    in {ok:} then yield(ok)
    in {err:} then r
    end
  end

  def map_err(r)
    case r
    in {ok:} then r
    in {err:} then {err: yield(err)}
    end
  end

  # all: {ok: every value}, or {err: every error} (not just the first).
  def all(results)
    values = Array[]
    errors = Array[]
    Array.each(results) do |r|
      case r
      in {ok:} then Array.push(values, ok)
      in {err:} then Array.push(errors, err)
      end
    end
    Array.empty?(errors) ? {ok: values} : {err: errors}
  end

  def to_s(r)
    case r
    in {ok:} then "Ok(#{ok})"
    in {err:} then "Err(#{err})"
    end
  end

  # attempt: run the block, turning a raised ValidationError into an err.
  def attempt
    {ok: yield}
  rescue ValidationError => e
    {err: Exception.message(e)}
  end
end

class UnwrapError < StandardError
end

class ValidationError < StandardError
  attr_reader field
end

# ---- Validation: check a Hash of String inputs, collect every problem -------

class FieldError
  attr_reader field, message
  def to_s(e) = "#{@field}: #{@message}"
end

# A Checker holds the input and the errors found so far.
class Checker
  attr_reader input, errors = nil
  def initialize(c) = @errors = FieldError[]

  def add(c, field, message)
    Array.push(@errors, FieldError.new(field, message))
    nil
  end

  def ok?(c) = Array.empty?(@errors)
  def messages(c) = Array.map(@errors) { |e| FieldError.to_s(e) }

  # The raw String for a field, or nil (after recording an error) when missing or blank.
  def required(c, field)
    v = Hash.fetch(@input, field, nil)
    if v == nil || String.empty?(String.strip(v))
      add(c, field, "is required")
      return nil
    end
    String.strip(v)
  end

  # Missing is fine; blank counts as missing.
  def optional(c, field)
    v = Hash.fetch(@input, field, nil)
    return nil if v == nil || String.empty?(String.strip(v))
    String.strip(v)
  end

  def length(c, field, s, min, max)
    return nil unless s
    n = String.size(s)
    if n < min || n > max
      add(c, field, "must be #{min}..#{max} characters (got #{n})")
      return nil
    end
    s
  end

  def matches(c, field, s, re, what)
    return nil unless s
    unless String.match?(s, re)
      add(c, field, "must be #{what}")
      return nil
    end
    s
  end

  def integer(c, field, s, lo, hi)
    return nil unless s
    unless String.match?(s, /\A-?\d+\z/)
      add(c, field, "must be an integer (got #{Kernel.inspect(s)})")
      return nil
    end
    n = String.to_i(s)
    if n < lo || n > hi
      add(c, field, "must be in #{lo}..#{hi} (got #{n})")
      return nil
    end
    n
  end

  def one_of(c, field, s, choices)
    return nil unless s
    unless Array.include?(choices, s)
      add(c, field, "must be one of #{Array.join(choices, ", ")}")
      return nil
    end
    s
  end

  # A custom rule: the block says whether v is acceptable.
  def check(c, field, v, message)
    return nil unless v
    unless yield(v)
      add(c, field, message)
      return nil
    end
    v
  end

  # The value as a Result: {ok: value} when no error was recorded, else {err: messages}.
  def result(c, value) = ok?(c) ? {ok: value} : {err: messages(c)}

  # The exception style: raise the first problem.
  def raise_first(c)
    e = Array.first(@errors)
    return nil unless e          # level 2 does not know ok?(c) means non-empty
    raise ValidationError.new(FieldError.message(e), FieldError.field(e))
  end
end

# ---- Rules as values: blocks cannot be stored, so a stored rule is a Struct
# value whose type includes Rule; Rule.check dispatches on that type.

module Rule
  # The error message for v, or nil when v passes.
  def check(rule, v) = raise(NotImplementedError)
end

class MinLen
  attr_reader n
  include Rule
  def check(r, v) = String.size(v) < @n ? "must be at least #{@n} characters" : nil
end

class MaxLen
  attr_reader n
  include Rule
  def check(r, v) = String.size(v) > @n ? "must be at most #{@n} characters" : nil
end

class Pattern
  attr_reader re, what
  include Rule
  def check(r, v) = String.match?(v, @re) ? nil : "must be #{@what}"
end

class IntRange
  attr_reader lo, hi
  include Rule
  def check(r, v)
    return "must be an integer" unless String.match?(v, /\A-?\d+\z/)
    n = String.to_i(v)
    n < @lo || n > @hi ? "must be in #{@lo}..#{@hi}" : nil
  end
end

# A schema: field name => [required?, rules]. Rules run in order; the first failing one is reported.
class Schema
  attr_reader fields = nil
  def initialize(s) = @fields = Hash[]
  def field(s, name, rules, required: true)
    @fields[name] = [required, rules]
    s
  end

  def validate(s, input)
    c = Checker.new(input)
    Hash.each(@fields) do |name, spec|
      required, rules = spec
      v = required ? Checker.required(c, name) : Checker.optional(c, name)
      next unless v
      Array.each(rules) do |rule|
        msg = Rule.check(rule, v)
        if msg
          Checker.add(c, name, msg)
          break
        end
      end
    end
    c
  end
end

# ---- end of validate ----------------------------------------------------
# A signup form: every problem is reported at once, with its field.

def validate_signup(form)
  c = Checker.new(form)
  name = Checker.length(c, "name", Checker.required(c, "name"), 2, 20)
  email = Checker.matches(c, "email", Checker.required(c, "email"), /\A[^@\s]+@[^@\s]+\.[a-z]+\z/i, "an email address")
  age = Checker.integer(c, "age", Checker.required(c, "age"), 13, 130)
  pw = Checker.length(c, "password", Checker.required(c, "password"), 8, 64)
  Checker.check(c, "password", pw, "must contain a digit") { |s| String.match?(s, /\d/) }
  plan = Checker.one_of(c, "plan", Checker.optional(c, "plan") || "free", Array["free", "pro"])
  Checker.result(c, {name: name, email: email, age: age, plan: plan})
end

forms = Array[
  Hash["name" => "Ann", "email" => "ann@example.com", "age" => "31", "password" => "s3cretpass"],
  Hash["name" => "B", "email" => "bob(at)example", "age" => "12", "password" => "short"],
  Hash["email" => "  ", "age" => "x1", "password" => "longenough", "plan" => "gold"],
]

Array.each_with_index(forms) do |form, i|
  r = validate_signup(form)
  case r
  in {ok:}
    ok => {name:, email:, age:, plan:}
    puts("form #{i}: welcome #{name} <#{email}>, age #{age}, plan #{plan}")
  in {err:}
    puts("form #{i}: rejected")
    Array.each(err) { |m| puts("  - #{m}") }
  end
end
