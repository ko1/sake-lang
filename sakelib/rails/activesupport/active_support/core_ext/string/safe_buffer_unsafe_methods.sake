# (Sake only) The generator for string/output_safety.sake: Ruby's
#   UNSAFE_STRING_METHODS.each do |unsafe_method|
#     class_eval "def #{unsafe_method}(*args, &block) = to_str.#{unsafe_method}(*args, &block)" ... "def #{unsafe_method}!"
# as Sake source. Each name keeps the String operation's own parameters (Sake has no *args forwarding to a built-in).

def arities = once do
  Hash.of("capitalize" => "", "chomp" => "", "chop" => "", "delete" => ", chars", "delete_prefix" => ", prefix",
          "delete_suffix" => ", suffix", "downcase" => "", "lstrip" => "", "next" => "", "reverse" => "",
          "rstrip" => "", "scrub" => "", "squeeze" => "", "strip" => "", "succ" => "", "swapcase" => "",
          "tr" => ", from, to", "tr_s" => ", from, to", "unicode_normalize" => "", "upcase" => "")
end

puts "module ActiveSupport"
puts "  class SafeBuffer"
Hash.each(arities) do |name, params|
  args = String.delete_prefix(params, ", ")
  call_args = String.empty?(args) ? "" : ", #{args}"
  puts "    def #{name}(b#{params}) = String.#{name}(@str#{call_args})"
  bang = name == "next" ? nil : "#{name}!"
  if bang
    puts "    def #{bang}(b#{params})"
    puts "      @html_unsafe = true"
    puts "      String.#{bang}(@str#{call_args})"
    puts "    end"
  end
end
puts "  end"
puts "end"
