Clock = Struct.new(:minutes)
Booking = Struct.new(:client, :start, :finish, :fee)

class Clock
  include Comparable
  def <=>(a, b) = @minutes <=> Clock.get_minutes(b)
  def parse(text)
    m = String.match(text, /\A(\d\d):(\d\d)\z/)
    raise ArgumentError, "bad time #{text}" if m == nil
    Clock.new(String.to_i(m[1]) * 60 + String.to_i(m[2]))
  end
  def to_s(c) = format("%02d:%02d", @minutes / 60, @minutes % 60)
end

class Booking
  def parse(line)
    fields = String.split(line, ",")
    span = String.split(fields[1], "-")
    Booking.new(fields[0], Clock.parse(span[0]), Clock.parse(span[1]), String.to_i(fields[2]))
  end
  def hours(b) = (Clock.get_minutes(@finish) - Clock.get_minutes(@start)) / 60.0
  def to_s(b) = "#{@start}-#{@finish} #{String.ljust(@client, 7)} $#{@fee}"
end

# latest booking (by index in finish order) that ends no later than booking i starts
def last_compatible(sorted, i)
  start = Booking.get_start(sorted[i])
  lo = 0
  hi = i - 1
  found = nil
  while lo <= hi
    mid = (lo + hi) / 2
    if Booking.get_finish(sorted[mid]) <= start
      found = mid
      lo = mid + 1
    else
      hi = mid - 1
    end
  end
  found
end

def schedule(bookings)
  sorted = Array.sort_by(bookings) { |b| Clock.get_minutes(Booking.get_finish(b)) }
  n = Array.size(sorted)
  p_of = Array.map(Range.to_a(0...n)) { |i| last_compatible(sorted, i) }
  best = Array[0]
  Integer.times(n) do |i|
    prior = p_of[i]
    take = Booking.get_fee(sorted[i]) + (prior == nil ? 0 : best[prior + 1])
    skip = best[i]
    Array.push(best, take > skip ? take : skip)
  end
  chosen = Array[]
  i = n - 1
  while i >= 0
    prior = p_of[i]
    take = Booking.get_fee(sorted[i]) + (prior == nil ? 0 : best[prior + 1])
    if take >= best[i]
      Array.unshift(chosen, sorted[i])
      i = prior == nil ? -1 : prior
    else
      i -= 1
    end
  end
  [best[n], chosen]
end

requests = <<~CSV
  Avery,09:00-10:30,120
  Blake,09:30-11:00,200
  Casey,10:30-12:00,150
  Devon,11:00-11:45,90
  Emery,11:30-13:00,210
  Finley,12:00-12:30,40
  Gray,13:00-14:30,160
  Harper,12:45-15:00,260
  Indy,14:30-15:30,80
  Jules,15:00-17:00,180
  Kai,15:30-16:15,70
  Lane,16:15-17:30,110
CSV

bookings = Array.map(String.lines(requests)) { |line| Booking.parse(String.strip(line)) }
total, chosen = schedule(bookings)
puts("accepted bookings (revenue $#{total}):")
Array.each(chosen) { |b| puts("  #{b}") }
hours = Array.sum(Array.map(chosen) { |b| Booking.hours(b) })
puts(format("studio busy %.2f h, $%.2f per hour", hours, total / hours))
declined = Array.reject(bookings) { |b| Array.include?(chosen, b) }
puts("declined: #{Array.join(Array.map(declined) { |b| Booking.get_client(b) }, ", ")}")

earliest = Array.min_by(bookings) { |b| Booking.get_start(b) }
latest = Array.max(Array.map(bookings) { |b| Booking.get_finish(b) })
puts("day spans #{Booking.get_start(earliest)} to #{latest}")

Array.each(Array["Mo,08:00-09:00,50", "Ni,9:00-10:00,50"]) do |line|
  begin
    b = Booking.parse(line)
    Array.push(bookings, b)
    puts("added #{b}; revenue now $#{schedule(bookings)[0]}")
  rescue ArgumentError => e
    puts("rejected #{Kernel.inspect(line)}: #{Exception.message(e)}")
  end
end
