# railties: a call in `initialize` on a field that `new` was given (here @paths) silently ends the check of the program:
# everything after `Conf.make` (the String.upcase(42) below, every function the rest reaches) is never analyzed, and
# `bin/sake -c --strict` prints "OK" (exit 0). With `Rails::Paths::Root.add(p, "app") if p` the error below is reported.
# Ruby: initialize sees the fields new stored; the program runs and raises TypeError at the last line. In the blog,
# this made `bin/sake -c --strict bin/rails.sake` print OK in 7 s while checking none of the app (the real check: see
# examples/apps/rails_blog/README.md).
require "rails/railties/rails/paths"
class Conf
  attr_accessor root, paths
  def make(root) = Conf.new(root: root, paths: Rails::Paths::Root.new(root, Hash.new))
  def initialize(c)
    Conf.add_paths(c)
  end
  def add_paths(c)
    p = @paths
    Rails::Paths::Root.add(p, "app", eager_load: true, glob: "{*,*/concerns}")
  end
end
x = Conf.make("/tmp")
p(String.upcase(42))
