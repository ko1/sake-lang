# A mixin function through a type's name (`A.get(x)`) is that type's copy: a value of another includer is a type error.
module Jar
  def name(j) = raise(NotImplementedError)
  def get(j) = "get from #{name(j)}"
end
class A
  attr_reader v
  include Jar
  def name(a) = "A"
end
class B
  attr_reader v
  include Jar
  def name(b) = "B"
end
def pick(flag) = flag ? A.new(1) : B.new(2)
puts A.get(pick(true))
puts A.get(pick(false))
puts Jar.get(pick(false))
