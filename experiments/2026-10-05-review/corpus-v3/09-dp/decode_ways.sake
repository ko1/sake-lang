# "A" = 1 ... "Z" = 26; count and list the ways to read a digit string
def letter(code) = Integer.chr(64 + code)

def single_ok?(s, i) = s[i] != "0"

def pair_code(s, i)
  return nil if i + 1 >= String.size(s) || s[i] == "0"
  code = String.to_i(s[i..(i + 1)])
  code <= 26 ? code : nil
end

# ways[i]: readings of the suffix starting at i
def count_ways(s)
  n = String.size(s)
  ways = Array.new(n + 1, 0)
  ways[n] = 1
  Integer.downto(n - 1, 0) do |i|
    total = 0
    total += ways[i + 1] if single_ok?(s, i)
    total += ways[i + 2] if pair_code(s, i)
    ways[i] = total
  end
  ways[0]
end

def readings(s, i, memo)
  return Array[""] if i == String.size(s)
  memo[i] ||= begin
    out = Array[]
    if single_ok?(s, i)
      head = letter(String.to_i(s[i]))
      Array.each(readings(s, i + 1, memo)) { |rest| Array.push(out, head + rest) }
    end
    code = pair_code(s, i)
    if code
      head = letter(code)
      Array.each(readings(s, i + 2, memo)) { |rest| Array.push(out, head + rest) }
    end
    out
  end
end

def encode(word) = Array.join(Array.map(String.chars(word)) { |c| Integer.to_s(String.ord(c) - 64) }, "")

# with "*" standing for any digit 1-9, modulo a prime
def count_wild(s, modulus)
  n = String.size(s)
  ways = Array.new(n + 1, 0)
  ways[n] = 1
  Integer.downto(n - 1, 0) do |i|
    c = s[i]
    single = c == "*" ? 9 : (c == "0" ? 0 : 1)
    total = single * ways[i + 1]
    if i + 1 < n
      d = s[i + 1]
      pairs = 0
      if c == "*" && d == "*"
        pairs = 15
      elsif c == "*"
        pairs = String.to_i(d) <= 6 ? 2 : 1
      elsif d == "*"
        pairs = c == "1" ? 9 : (c == "2" ? 6 : 0)
      else
        code = String.to_i(c + d)
        pairs = c != "0" && code <= 26 ? 1 : 0
      end
      total += pairs * ways[i + 2]
    end
    ways[i] = total % modulus
  end
  ways[0]
end

inputs = Array["12", "226", "06", "11106", "1201234", "27", "100", "2611055971756562"]
Array.each(inputs) do |s|
  n = count_ways(s)
  line = format("%-18s %5d", s, n)
  if n > 0 && n <= 6
    all = readings(s, 0, Hash[])
    line += "  " + Array.join(Array.sort(all), " ")
  end
  puts(line)
end

Array.each(Array["DYNAMIC", "TABLE", "KNAPSACK"]) do |word|
  code = encode(word)
  n = count_ways(code)
  all = readings(code, 0, Hash[])
  others = Array.reject(all) { |r| r == word }
  shown = Array.take(Array.sort(others), 3)
  puts("#{word} -> #{code}: #{n} readings, e.g. #{Array.join(shown, ", ")}")
end

modulus = 1_000_000_007
Array.each(Array["*", "1*", "**", "*1*0", "2*2*2*2*", "***********"]) do |s|
  puts(format("%-12s %d", s, count_wild(s, modulus)))
end
long = "1" * 80
puts("80 ones: #{count_ways(long)}")
