Req = Struct.new(:id, :time, :from, :to)
Event = Struct.new(:type, :time, :floor, :pid)

def parse_num(s)
  if String.match(s, /^\d+$/)
    String.to_i(s)
  else
    nil
  end
end

def main
  first = gets
  return if first == nil

  parts = String.split(String.strip(first), " ")
  return if Array.size(parts) != 3

  n = parse_num(Array.at(parts, 0))
  d = parse_num(Array.at(parts, 1))
  c = parse_num(Array.at(parts, 2))

  if !n || !d || !c || n < 2 || n > 50 || d < 0 || d > 5 || c < 1 || c > 20
    puts("invalid header")
    return
  end

  reqs = Array[]
  line = 2
  errs = Array[]
  last_t = 0

  loop do
    s = gets
    break if s == nil
    s = String.strip(s)
    next if String.empty?(s)

    p = String.split(s, " ")
    if Array.size(p) != 3
      Array.push(errs, line)
      line += 1
      next
    end

    t = parse_num(Array.at(p, 0))
    f = parse_num(Array.at(p, 1))
    g = parse_num(Array.at(p, 2))

    if !t || !f || !g || f < 1 || f > n || g < 1 || g > n || f == g || t > 1000 || t < last_t
      Array.push(errs, line)
      line += 1
      next
    end

    Array.push(reqs, Req.new(Array.size(reqs) + 1, t, f, g))
    last_t = t
    line += 1
  end

  Array.each(errs) { |l| puts("line #{l}: invalid request") }

  if Array.empty?(reqs)
    puts("no passengers")
    return
  end

  sim(n, d, c, reqs)
end

def sim(n, d, c, reqs)
  floor = 1
  time = 0
  dir = :idle
  riders = Array[]
  waiting = Hash.new(Array[])

  pick_events = Array[]
  drop_events = Array[]

  req_idx = 0

  loop do
    # Add new requests
    while req_idx < Array.size(reqs)
      r = Array.at(reqs, req_idx)
      break if Req.time(r) > time
      f = Req.from(r)
      old_w = Hash[](waiting, f)
      Hash.store(waiting, f, Array.+(old_w, Array[Req.id(r)]))
      req_idx += 1
    end

    # Check done
    if Array.empty?(riders) && req_idx >= Array.size(reqs)
      all_e = true
      Integer.times(n + 1) do |i|
        if !Array.empty?(Hash[](waiting, i))
          all_e = false
        end
      end
      break if all_e
    end

    # Drop off
    riders2 = Array[]
    Array.each(riders) do |pid|
      dest = nil
      Array.each(reqs) { |r| dest = Req.to(r) if Req.id(r) == pid }
      if dest == floor
        Array.push(drop_events, Event.new(:drop, time, floor, pid))
      else
        Array.push(riders2, pid)
      end
    end
    riders = riders2

    # Direction
    targets = Set[]
    Array.each(riders) do |pid|
      Array.each(reqs) { |r| Set.add(targets, Req.to(r)) if Req.id(r) == pid }
    end
    Integer.times(n + 1) do |i|
      Set.add(targets, i) if !Array.empty?(Hash[](waiting, i))
    end

    case dir
    in :up
      above = false
      below = false
      Set.each(targets) { |f| above = true if f > floor }
      Set.each(targets) { |f| below = true if f < floor }
      if above
        dir = :up
      elsif below
        dir = :down
      else
        dir = :idle
      end
    in :down
      above = false
      below = false
      Set.each(targets) { |f| above = true if f > floor }
      Set.each(targets) { |f| below = true if f < floor }
      if below
        dir = :down
      elsif above
        dir = :up
      else
        dir = :idle
      end
    in :idle
      if !Set.empty?(targets)
        nearest = nil
        best_d = nil
        Set.each(targets) do |f|
          d_dist = Arithmetic.abs(f - floor)
          if best_d == nil || d_dist < best_d || (d_dist == best_d && (nearest == nil || f < nearest))
            nearest = f
            best_d = d_dist
          end
        end

        if nearest == floor
          w_at_f = Hash[](waiting, floor)
          lowest = nil
          Array.each(w_at_f) { |p| lowest = p if lowest == nil || p < lowest }
          if lowest
            dest = nil
            Array.each(reqs) { |r| dest = Req.to(r) if Req.id(r) == lowest }
            dir = dest > floor ? :up : :down
          end
        else
          dir = nearest > floor ? :up : :down
        end
      end
    end

    # Pick up
    w_at_f = Hash[](waiting, floor)
    w_sorted = Array.sort(w_at_f)
    picked = 0
    w_new = Array[]

    Array.each(w_sorted) do |pid|
      if picked < c
        dest = nil
        Array.each(reqs) { |r| dest = Req.to(r) if Req.id(r) == pid }
        pdir = dest > floor ? :up : :down

        if dir == pdir || dir == :idle
          Array.push(riders, pid)
          Array.push(pick_events, Event.new(:pick, time, floor, pid))
          picked += 1
        else
          Array.push(w_new, pid)
        end
      else
        Array.push(w_new, pid)
      end
    end
    Hash.store(waiting, floor, w_new)

    # Advance
    dropped_now = Array.size(drop_events) > 0
    riders_before = Array.size(riders)

    if picked > 0 || dropped_now
      time += d
    else
      case dir
      in :idle
      in :up
        floor += 1
      in :down
        floor -= 1
      end
      time += 1
    end
  end

  # Merge and sort events
  all_events = Array.+(pick_events, drop_events)
  sorted = Array.sort_by(all_events) do |e|
    t = Event.time(e)
    typ = Event.type(e)
    [t, typ == :drop ? 0 : 1]
  end

  Array.each(sorted) do |e|
    puts("t=#{Event.time(e)} floor #{Event.floor(e)} #{Event.type(e)} P#{Event.pid(e)}")
  end

  # Summary
  tw = 0
  tr = 0
  Array.each(reqs) do |r|
    id = Req.id(r)
    rt = Req.time(r)
    pt = nil
    dt = nil
    Array.each(pick_events) { |e| pt = Event.time(e) if Event.pid(e) == id }
    Array.each(drop_events) { |e| dt = Event.time(e) if Event.pid(e) == id }
    wt = pt - rt
    rd = dt - pt
    tw += wt
    tr += rd
    puts("P#{id} wait #{wt} ride #{rd}")
  end

  n_reqs = Array.size(reqs)
  avg_w = Float(tw) / n_reqs
  avg_r = Float(tr) / n_reqs
  puts(format("average wait %.2f ride %.2f", avg_w, avg_r))

  last_d = nil
  Array.each(drop_events) { |e| last_d = Event.time(e) }
  puts("done at t=#{last_d}")
end

main
