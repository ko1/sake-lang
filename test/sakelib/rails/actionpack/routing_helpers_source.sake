# The generator of routing_generate.sake's helpers: prints the Sake source of the shop's named route helpers
# (run by `generate "routing_helpers_source", "ShopUrlHelpers"`; run alone, it shows the source)
require "fixtures/shop_routes"
require "rails/actionpack/action_dispatch/routing/generate/url_helpers"

name = Array.first(ARGV) || "ShopUrlHelpers"
print(ActionDispatch::Routing::Generate.url_helpers(shop_route_set, name))
