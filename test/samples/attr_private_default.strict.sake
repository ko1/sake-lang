# `private attr_*`: a field with no get_/set_ outside its class (new still takes it).
# A default may be any expression; it is evaluated by each new that leaves the field out.
class Parser
  attr_reader tokens
  private attr_accessor pos = 0
  def next_token(p)
    t = @tokens[@pos]
    @pos += 1
    t
  end
end
pr = Parser.new(Array["a", "b"])
p(Parser.next_token(pr))
p(Parser.next_token(pr))
p(Parser.new(Array["x"], 1))

class Bag
  attr_reader name, items = Array[], counts = Hash[]
  def add(b, x)
    Array.push(@items, x)
    @counts[x] = (@counts[x] || 0) + 1
  end
end
a = Bag.new("a")
b = Bag.new("b")
Bag.add(a, "x")
p([Array.size(a.Bag.items), Array.size(b.Bag.items)])
