roles:
  viewer   00000001 {read}
  editor   00001011 {read,write,share}
  owner    00001111 {read,write,delete,share}
  finance  01100001 {read,billing,audit}
  ops      11000001 {read,audit,deploy}
  root     11111111 {read,write,delete,share,admin,billing,audit,deploy}
users:
  ann  01001011 {read,write,share,audit}                 (4 flags)
  bob  00100001 {read,billing}                           (2 flags)
  cyd  11001011 {read,write,share,audit,deploy}          (5 flags)
  dee  00000000 {}                                       (0 flags)
  eve  01011111 {read,write,delete,share,admin,audit}    (6 flags)
checks:
  ann write+share: allowed
  bob audit: denied
  cyd deploy+read: allowed
  dee read: denied
  eve admin+delete: allowed
  ann: unknown flag teleport
set algebra:
  ann & cyd = {read,write,share,audit}
  ann | cyd = {read,write,share,audit,deploy}
  ann ^ cyd = {deploy}
  cyd - ann = {deploy}
  ann << 1  = {write,delete,admin,deploy}
  shared by everyone: nothing
toggling:
  {write,deploy} write? true read? false
most granted flag: read (4 users)
