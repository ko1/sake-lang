# sake: --strict
# An alias of a built-in type is that type everywhere: Hash.of and Hash[...] (an Array of Hashes), the constants
# Math::PI and Float::INFINITY, and `raise NotImplementedError` marking a required function.
H = Hash
M = Math
F = Float
module Shapes
  N = NotImplementedError
  module Area
    module_function
    def area(s) = raise N
  end
end
class Sq
  include Shapes::Area
  attr_reader n
  def area(s) = s.Sq.n * s.Sq.n
end
p H.of("a" => 1)
p H[H.new]
p H.of(a: 1)
p M::PI
p F::INFINITY
p Shapes::Area.area(Sq.new(3))
