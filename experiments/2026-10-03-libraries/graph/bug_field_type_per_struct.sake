# Two Box values with different contents: each compare is between same-typed values,
# but the field type is one union for the whole Struct type, so --strict (level 1, too) rejects it.
class Box
  attr_reader items
  def make = Box.new(Array[])
  def add(b, x) = Array.push(@items, x)
  def smallest_first?(b) = Array.fetch(@items, 0) < Array.fetch(@items, 1)
end
ints = Box.make
Box.add(ints, 1)
Box.add(ints, 2)
strs = Box.make
Box.add(strs, "a")
Box.add(strs, "b")
p(Box.smallest_first?(ints))
