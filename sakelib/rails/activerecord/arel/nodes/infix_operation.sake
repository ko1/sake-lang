# Port of activerecord-8.1.3/lib/arel/nodes/infix_operation.rb
#
# Ruby's subclasses pass their operator to super's initialize (Multiplication.new(l, r) is
# InfixOperation.new(:*, l, r)); here new takes left and right and initialize fills the operator, the last field.

module Arel
  module Nodes
    module InfixOperationMethods
      include Binary
      def operator(o) = raise(NotImplementedError)
    end

    class InfixOperation
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
    end

    class Multiplication
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :*
    end

    class Division
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :/
    end

    class Addition
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :+
    end

    class Subtraction
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :-
    end

    class Concat
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :"||"
    end

    class Contains
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :"@>"
    end

    class Overlaps
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :"&&"
    end

    class BitwiseAnd
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :&
    end

    class BitwiseOr
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :|
    end

    class BitwiseXor
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :^
    end

    class BitwiseShiftLeft
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :<<
    end

    class BitwiseShiftRight
      attr_accessor left, right
      attr_reader operator
      include InfixOperationMethods
      def initialize(o) = @operator = :>>
    end
  end
end
