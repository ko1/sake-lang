# Port of activesupport-8.1.3/lib/active_support/core_ext/array/access.rb

class Array
  def from(xs, position) = Array.[](xs, position, Array.length(xs)) || Any[]

  def to(xs, position)
    if position >= 0
      Array.take(xs, position + 1)
    else
      Array.[](xs, 0..position) || Any[]
    end
  end

  # Ruby's elements.flatten(1): each argument an element, or an Array of them.
  def flatten1(elements) = Array.flat_map(elements) { |e| (e in Array) ? e : Any[e] }

  def including(xs, *elements) = xs + Array.flatten1(elements)
  def excluding(xs, *elements) = xs - Array.flatten1(elements)
  def without(xs, *elements) = xs - Array.flatten1(elements)

  def second(xs) = xs[1]
  def third(xs) = xs[2]
  def fourth(xs) = xs[3]
  def fifth(xs) = xs[4]
  def forty_two(xs) = xs[41]
  def third_to_last(xs) = xs[-3]
  def second_to_last(xs) = xs[-2]
end
