# Port of the class side of activemodel-8.1.3/lib/active_model/secure_password.rb (Sake only): the generator
#
# `has_secure_password :password, validations: true` becomes the accessors (fields password,
# password_confirmation, password_challenge), password= (the field's writer: set_password), authenticate_password
# (and authenticate for :password), password_salt, and with validations three validate methods and
# `validates_confirmation_of :password, allow_nil: true`, as Ruby's has_secure_password.

require "model"

module ActiveModel
  module SecurePassword
    module Generate
      module_function

      # The class-body line as [attribute, validations?, line] and the declarations it adds.
      def expand(info, d, rest)
        n = ActiveSupport::Generate::Declaration.line(d)
        pos, opts = ActiveModel::Generate.split(d)
        attr = pos[0] ? String.delete_prefix(pos[0] || "", ":") : "password"
        validations = ActiveModel::Generate.opt(opts, "validations") != "false"
        reset = ActiveModel::Generate.opt(opts, "reset_token")
        Array.push(ActiveModel::Generate::Info.secure_passwords(info), [attr, validations, n, ActiveModel::Generate::Info.current(info)])
        if validations
          Array.push(rest, ActiveSupport::Generate::Declaration.new(n, "validate", String[":__#{attr}_digest_presence", ":__#{attr}_challenge_matches", ":__#{attr}_length"]))
          Array.push(rest, ActiveSupport::Generate::Declaration.new(n, "validates_confirmation_of", String[":#{attr}", "allow_nil: true"]))
        end
        reset
      end

      def fields(info, attr) = String[attr, "#{attr}_confirmation", "#{attr}_challenge"]

      def source(info)
        k = ActiveModel::Generate::Info.name(info)
        path = ActiveModel::Generate::Info.path(info)
        s = ""
        Array.each(ActiveModel::Generate::Info.secure_passwords(info)) do |x|
          attr, validations, n, owner = x
          next unless owner == k
          digest = "#{attr}_digest"
          s += "# sake-origin: #{path}:#{n}\n"
          s += "def #{k}.set_#{attr}(r, unencrypted_password)\n"
          s += "  if unencrypted_password == nil\n    @#{attr} = nil\n    r.#{k}.#{digest} = nil\n"
          s += "  elsif !String.empty?(password = ActiveModel::SecurePassword.password_string(unencrypted_password))\n    @#{attr} = password\n"
          s += "    r.#{k}.#{digest} = ActiveModel::SecurePassword.digest(password)\n  end\nend\n"
          s += "def #{k}.authenticate_#{attr}(r, unencrypted_password)\n  ActiveModel::SecurePassword.authenticate_digest(r, #{digest}(r), unencrypted_password)\nend\n"
          s += "def #{k}.authenticate(r, unencrypted_password) = authenticate_password(r, unencrypted_password)\n" if attr == "password"
          s += "def #{k}.#{attr}_salt(r) = ActiveModel::SecurePassword.digest_salt(#{digest}(r))\n"
          if validations
            was = Array.include?(ActiveModel::Generate::Info.attr_method_names(info), digest) && ActiveModel::Generate.dirty?(info) ? "#{digest}_was(r)" : "nil"
            s += "def #{k}.__#{attr}_digest_presence(r)\n  ActiveModel::SecurePassword.validate_digest(errors(r), :#{attr}, #{digest}(r))\nend\n"
            s += "def #{k}.__#{attr}_challenge_matches(r)\n  ActiveModel::SecurePassword.validate_challenge(errors(r), :#{attr}, #{attr}_challenge(r), #{was})\nend\n"
            s += "def #{k}.__#{attr}_length(r)\n  ActiveModel::SecurePassword.validate_length(errors(r), :#{attr}, #{attr}(r))\nend\n"
          end
          s += "# sake-origin: none\n"
        end
        s
      end
    end
  end
end
