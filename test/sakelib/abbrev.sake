require "abbrev"

p(Abbrev.abbrev(String["car", "cone"]))
p(Abbrev.abbrev(String["ruby", "rules"]))
p(Abbrev.abbrev(String["car", "box", "cone", "crab"], /b/))
p(Abbrev.abbrev(String["car", "box", "cone"], "ca"))
p(Abbrev.abbrev(String["car", "box", "cone"], /\Az/))
p(Array.abbrev(String["list", "load", "lint"]))
p(Array.abbrev(String["list", "load", "lint"], "li"))
p(Array.abbrev(String["list", "load", "lint"], /\Alo/))
p(Abbrev.abbrev(String[]))
p(Abbrev.abbrev(String["", "a"]))
p(Abbrev.abbrev(String["same", "same", "sam"]))
p(Abbrev.abbrev(String["日本", "日曜"]))

# a command dispatcher: unique prefixes of command names
table = Abbrev.abbrev(String["start", "stop", "status", "restart"])
Array.each(String["sta", "sto", "st", "re", "status", "x"]) do |input|
  cmd = table[input]
  puts("#{input} -> #{cmd ? cmd : "(ambiguous or unknown)"}")
end
