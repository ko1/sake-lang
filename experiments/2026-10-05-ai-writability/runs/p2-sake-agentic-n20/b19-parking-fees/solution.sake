def money(c) = format("%d.%02d", c / 100, c % 100)

lines = String.split(IO.read(IO.stdin), "\n")
h = String.split(lines[0], " ")
first = String.to_i(h[1])
step = String.to_i(h[2])
cap = String.to_i(h[3])
grace = String.to_i(h[4])
inside = Hash[]
exits = Hash.new(0)
rev = Hash.new(0)
day = 0
prev = -1
Array.each_with_index(lines) do |raw, i|
  next if i == 0
  n = i + 1
  f = String.split(raw, " ")
  next if Array.empty?(f)
  m = Array.size(f) == 3 ? String.match(f[0], /\A([01]\d|2[0-3]):([0-5]\d)\z/) : nil
  if m == nil || (f[1] != "IN" && f[1] != "OUT") || !String.match?(f[2], /\A[A-Z0-9]{1,8}\z/)
    puts("line #{n}: invalid")
    next
  end
  c = MatchData.captures(m)
  tod = String.to_i(c[0]) * 60 + String.to_i(c[1])
  day += 1 if prev >= 0 && tod < prev
  prev = tod
  now = day * 1440 + tod
  plate = f[2]
  if f[1] == "IN"
    if inside[plate] != nil
      puts("line #{n}: #{plate} already inside")
    else
      inside[plate] = now
    end
  else
    if inside[plate] == nil
      puts("line #{n}: #{plate} not inside")
    else
      stay = now - inside[plate]
      Hash.delete(inside, plate)
      fee = 0
      if stay > grace
        d = stay / 1440
        r = stay % 1440
        part = 0
        if r > 0
          part = first
          part += step * ((r - 60 + 29) / 30) if r > 60
        end
        fee = d * cap + (part < cap ? part : cap)
      end
      exits[plate] += 1
      rev[plate] += fee
      puts("#{plate} #{stay / 60}:#{String.rjust(Integer.to_s(stay % 60), 2, "0")} #{money(fee)}")
    end
  end
end
puts("--- summary")
te = 0
tr = 0
Array.each(Array.sort_by(Hash.keys(exits)) { |p| [-rev[p], p] }) do |p|
  puts("#{p} #{exits[p]} #{money(rev[p])}")
  te += exits[p]
  tr += rev[p]
end
puts("total #{te} #{money(tr)}")
ins = Array.sort(Hash.keys(inside))
puts("inside: " + (Array.empty?(ins) ? "none" : Array.join(ins, ", ")))
