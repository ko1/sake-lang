# Port of activerecord-8.1.3/lib/arel/nodes/case.rb (partial: no hash/eql?)
#
# Ruby's methods `when`, `then` and `else` are Sake functions of those names: `Case.when(c, cond)`.

module Arel
  module Nodes
    class Case
      attr_accessor :case
      attr_accessor conditions, default
      include NodeExpression

      def initialize(c)
        @conditions = Any[]
      end

      def when(o, condition, expression = nil)
        Array.push(@conditions, When.new(Nodes.build_quoted(condition), expression))
        o
      end

      def then(o, expression)
        last = Array.last(@conditions)
        When.set_right(last, Nodes.build_quoted(expression)) if last
        o
      end

      def else(o, expression)
        @default = Else.new(Nodes.build_quoted(expression))
        o
      end
    end

    class When
      attr_accessor left, right
      include Binary
    end

    class Else
      attr_accessor expr
      include Unary
    end
  end
end
