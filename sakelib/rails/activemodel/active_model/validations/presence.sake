# Port of activemodel-8.1.3/lib/active_model/validations/presence.rb and absence.rb (two small validators)

module ActiveModel
  module Validations
    class PresenceValidator < EachValidator
      def validate_each(v, record, attr_name, value)
        ActiveModel::Errors.add_with(ActiveModel::Validations.errors(record), attr_name, :blank, @options) if Object.blank?(value)
      end
    end

    class AbsenceValidator < EachValidator
      def validate_each(v, record, attr_name, value)
        ActiveModel::Errors.add_with(ActiveModel::Validations.errors(record), attr_name, :present, @options) if Object.present?(value)
      end
    end
  end
end
