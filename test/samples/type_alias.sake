# `Name = A::B` gives another name to a type. The name is a constant of the namespace it is written in,
# looked up as type names are (inside, then outward), and `Outer::Name` from outside.
module WebSocket
  module Handshake
    class Client
      attr_reader url
      def describe(c) = "client #{@url}"
    end

    class Error < StandardError
    end
  end

  Client = Handshake::Client           # WebSocket::Client
  HandshakeError = Handshake::Error

  module Session
    module_function
    def open(url) = Client.new(url)    # Client here is WebSocket::Client
  end

  module_function
  def check(c)
    raise HandshakeError, "no host" if c.Client.url == ""
    c.Client.describe
  end
end

C = WebSocket::Client # an alias of an alias

c = WebSocket::Session.open("ws://example.com")
puts WebSocket::Client.describe(c)
puts c.C.describe
puts WebSocket.check(c)

# Patterns and rescue mean the type the alias names.
case c
in WebSocket::Client then puts "in WebSocket::Client"
end
p((c in C))
p((c in WebSocket::Handshake::Client))

begin
  WebSocket.check(C.new(""))
rescue WebSocket::HandshakeError => e
  puts "rescued #{Exception.message(e)}"
end

# A built-in type has another name too.
Str = String
puts Str.upcase("abc")
p((1 in Str))

# `def Alias.f` defines f of the type.
def C.port(c) = 80
p WebSocket::Handshake::Client.port(c)

# `include` and `<` take an alias as they take the type's name.
module Greeting
  def greet(x) = "hi #{name(x)}"
end
G = Greeting
class Person
  include G
  attr_reader name
end
class Admin < Person
end
Base = Person
class Guest < Base
end
puts Admin.greet(Admin.new("root"))
puts Guest.greet(Guest.new("anon"))

# An alias of a module names what is inside it; `raise` and `(A|B).f` take aliases too.
W = WebSocket
p W::Handshake::Client.port(W::Client.new("x"))
p (Str|Integer).to_s(3)
begin
  raise W::HandshakeError
rescue WebSocket::Handshake::Error => e
  puts Exception.message(e)
end
