# Kernel.p with several arguments, Array.shift(a, n), String.squeeze(s, chars), Float.divmod by an Integer, Regexp.new flags, IO.tty?, a /n Regexp.
r = p(1, "a")
p(r)
x = p
p(x)
a = Array[1, 2, 3]
b = Array.shift(a, 2)
p(b, a)
p(String.squeeze("aaabbbccc", "ab"))
p(Float.divmod(7.5, 2))
re = Regexp.new("ab", "i")
p(String.match?("xAB", re))
p(IO.tty?(IO.stdout))
s = String.b("\x7f\xff\x41")
p(String.match?(s, /[\x7f-\xff]/n))
