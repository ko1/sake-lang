ShellSyntaxError = Exception.new(:index)
Word = Struct.new(:kind, :text)

class Word
  def to_s(w) = @kind == :op ? @text : Kernel.inspect(@text)
end

def operator_chars = "|;&<>"

def expand_var(name, env) = Hash.fetch(env, name, "")

def split_words(line, env)
  words = Array[]
  cur = ""
  in_word = false
  state = :normal
  var = ""
  resume = :normal
  i = 0
  chars = String.chars(line)
  n = Array.size(chars)
  while i <= n
    c = chars[i]
    case state
    in :var
      if c != nil && String.match?(c, /\w/)
        var += c
        i += 1
        next
      end
      cur += expand_var(var, env)
      var = ""
      state = resume
      next
    in :escape
      raise ShellSyntaxError.new("trailing backslash", i) if c == nil
      cur += c
      in_word = true
      state = resume
    in :single
      raise ShellSyntaxError.new("unterminated single quote", i) if c == nil
      if c == "'"
        state = :normal
      else
        cur += c
      end
    in :double
      raise ShellSyntaxError.new("unterminated double quote", i) if c == nil
      if c == "\""
        state = :normal
      elsif c == "\\" && chars[i + 1] != nil && String.include?("\"\\$", chars[i + 1])
        resume = :double
        state = :escape
      elsif c == "$"
        resume = :double
        state = :var
      else
        cur += c
      end
    in :normal
      if c == nil || c == " " || c == "\t"
        Array.push(words, Word.new(:word, cur)) if in_word
        cur = ""
        in_word = false
      elsif String.include?(operator_chars, c)
        Array.push(words, Word.new(:word, cur)) if in_word
        cur = ""
        in_word = false
        op = c
        nxt = chars[i + 1]
        if nxt != nil && Array.include?(Array["&&", "||", ">>"], c + nxt)
          op = c + nxt
          i += 1
        end
        Array.push(words, Word.new(:op, op))
      else
        in_word = true
        case c
        in "'" then state = :single
        in "\"" then state = :double
        in "\\"
          resume = :normal
          state = :escape
        in "$"
          resume = :normal
          state = :var
        else cur += c
        end
      end
    end
    i += 1
  end
  words
end

def pipeline_stages(words)
  stages = Array[Array[]]
  Array.each(words) do |w|
    if Word.kind(w) == :op && Word.text(w) == "|"
      Array.push(stages, Array[])
    else
      Array.push(Array.last(stages), w)
    end
  end
  stages
end

env = Hash["HOME" => "/home/ann", "USER" => "ann", "EMPTY" => ""]
lines = Array[
  "echo hello   world",
  "ls -l $HOME/src | grep 'foo bar' > out.txt",
  "printf \"%s says \\\"hi\\\" in $HOME\" $USER && echo done",
  "a\\ b c\\\\d 'it''s' x$EMPTY\"\"y",
  "cat <in >>log; echo $UNSET.",
  "echo 'unterminated",
  "echo \"also",
  "trailing \\"
]
Array.each(lines) do |line|
  puts(line)
  begin
    words = split_words(line, env)
    puts("  => #{Array.join(words, " ")}")
    stages = pipeline_stages(words)
    puts("  stages: #{Array.size(stages)}, ops: #{Array.count(words) { Word.kind(it) == :op }}") if Array.size(stages) > 1
  rescue ShellSyntaxError => e
    puts("  error at #{ShellSyntaxError.index(e)}: #{Exception.message(e)}")
  end
end
