# The nil hint blames field Box.v, but the nil in t comes from `return nil`, not from the field.
# bin/sake --strict: "hint: Box.v may be nil (nil is stored at line 6, 13)"
class Box
  attr_reader v
  def initialize(b) = @v = nil
  def take(b, s)
    if s == ""
      @v = nil
      return nil
    end
    @v = s
    s
  end
end
b = Box.new
t = Box.take(b, String.upcase("x"))
p(String.upcase(t))
