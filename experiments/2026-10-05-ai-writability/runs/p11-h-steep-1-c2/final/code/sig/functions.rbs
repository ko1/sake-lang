module Sql
  module Functions
    class Spec
      attr_reader min: Integer
      attr_reader max: Integer?

      def initialize: (Integer min, Integer? max) -> void
      def accepts?: (Integer count) -> bool
    end

    SPECS: Hash[String, Spec]

    def self.lookup: (String name) -> Spec?
    def self.call: (String name, Array[value] args) -> value
    def self.non_null: (String function, Array[present] args) -> value
    def self.absolute: (present arg) -> number
    def self.integer: (present arg) -> Integer
    def self.substr_value: (present arg, Integer start, Integer? len) -> (String | Blob)
    def self.instr: (present x, present y) -> Integer
    def self.substr: (String text, Integer start, Integer? len) -> String
    def self.trim: (String which, String text, String chars) -> String
    def self.replace: (String text, String from, String to) -> String
    def self.round: (present arg, Integer digits) -> Float
    def self.extreme: (Array[present] args, Integer direction) -> present
  end
end
