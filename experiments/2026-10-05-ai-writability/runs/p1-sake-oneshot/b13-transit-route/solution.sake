def relax(labels, key, v, ln)
  id = v + "|" + ln
  cur = Hash.fetch(labels, id, nil)
  if cur == nil || key < cur
    labels[id] = key
    true
  else
    false
  end
end

def best_trip(adj, pen, from, to)
  labels = Hash[]
  Array.each(Hash.fetch(adj, from)) do |e|
    v, ln, mn = e
    relax(labels, [mn, 0, Array[from, v], Array[ln]], v, ln)
  end
  changed = true
  while changed
    changed = false
    Array.each(Hash.keys(labels)) do |id|
      t, k, sts, lns = Hash.fetch(labels, id)
      u = Array.last(sts)
      l = Array.last(lns)
      Array.each(Hash.fetch(adj, u)) do |e|
        v, ln, mn = e
        nt = t + mn
        nk = k
        if ln != l
          nt += pen
          nk += 1
        end
        if relax(labels, [nt, nk, sts + Array[v], lns + Array[ln]], v, ln)
          changed = true
        end
      end
    end
  end
  best = nil
  Array.each(Hash.keys(labels)) do |id|
    lab = Hash.fetch(labels, id)
    if Array.last(lab[2]) == to
      best = lab if best == nil || lab < best
    end
  end
  best
end

def route_line(sts, lns)
  legs = Array[]
  cur = Array[]
  cur_line = ""
  Array.each_with_index(lns) do |ln, i|
    if ln != cur_line
      cur = Array[sts[i]]
      Array.push(legs, [ln, cur])
      cur_line = ln
    end
    Array.push(cur, sts[i + 1])
  end
  parts = Array.map(legs) { |ln, arr| "#{ln}: #{Array.join(arr, " > ")}" }
  "  " + Array.join(parts, "; ")
end

def main
  lines = String.lines(IO.read(IO.stdin))
  pen = String.to_i(String.strip(Array.first(lines)))
  adj = Hash[]
  in_queries = false
  Array.each_with_index(lines) do |raw, i|
    next if i == 0
    n = i + 1
    line = String.strip(raw)
    next if String.empty?(line)
    if !in_queries
      if line == "QUERIES"
        in_queries = true
      else
        f = String.split(line)
        if Array.size(f) != 4 || !String.match?(f[3], /\A[1-9]\d{0,2}\z/) || f[1] == f[2]
          puts("invalid segment at line #{n}")
        else
          ln, a, b, mn = f
          m = String.to_i(mn)
          adj[a] = Array[] unless Hash.key?(adj, a)
          adj[b] = Array[] unless Hash.key?(adj, b)
          Array.push(Hash.fetch(adj, a), [b, ln, m])
          Array.push(Hash.fetch(adj, b), [a, ln, m])
        end
      end
    else
      f = String.split(line)
      if Array.size(f) != 2
        puts("invalid query at line #{n}")
      else
        from, to = f
        head = "#{from} -> #{to}:"
        if !Hash.key?(adj, from)
          puts("#{head} unknown station #{from}")
        elsif !Hash.key?(adj, to)
          puts("#{head} unknown station #{to}")
        elsif from == to
          puts("#{head} 0 min, 0 transfers")
        else
          best = best_trip(adj, pen, from, to)
          if best == nil
            puts("#{head} no route")
          else
            t, k, sts, lns = best
            puts("#{head} #{t} min, #{k} #{k == 1 ? "transfer" : "transfers"}")
            puts(route_line(sts, lns))
          end
        end
      end
    end
  end
end

main
