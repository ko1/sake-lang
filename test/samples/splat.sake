# `*` takes the rest of a multiple assignment or of block parameters (an Array), and spreads a Tuple
# or an Array into a built-in's rest arguments.
first, *rest = Array[1, 2, 3, 4]
p([first, rest])
a, *mid, z = Array[1, 2, 3, 4, 5]
p([a, mid, z])
a, *mid, z = Array[1]
p([a, mid, z])
h, *t = [1, "two", :three]
p([h, t])
x, * = Array[7, 8]
p(x)
Array.each(Array[[1, 2, 3], [4, 5, 6]]) { |k, *vs| p([k, vs]) }
def three
  yield(1, 2, 3)
end
three { |*all| p(all) }
three { |q, *r| p([q, r]) }
three { |q, *r, s| p([q, r, s]) }
xs = Array[1, 2]
ys = Array[*xs, 3, *xs]
p(ys)
p(Set.size(Set[*ys]))
row = Array["a", 1]
puts(format("%s=%d", *row))
puts(format("%s=%d", *["b", 2]))
Array.push(ys, *xs)
p(ys)
p(Array.values_at(Array[10, 20, 30], *Array[0, 2]))
puts(*Array["p", "q"])
