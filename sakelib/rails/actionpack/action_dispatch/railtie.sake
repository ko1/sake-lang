# Port of actionpack-8.1.3/lib/action_dispatch/railtie.rb (partial: the class-level settings its configure initializer copies; the config defaults are Rails::Application::Configuration's)

module ActionDispatch
  module Railtie
    module_function

    def initializers
      list = Rails::Initializable::Initializer[]
      Rails::Initializable.add(list, :"action_dispatch.configure", :action_dispatch)
      list
    end

    def run(config, name)
      case name
      in :"action_dispatch.configure" then configure(config)
      else raise ArgumentError, "no initializer #{name}"
      end
      nil
    end

    def configure(config)
      ad = Rails::Application::Configuration.action_dispatch(config)
      t = ad[:tld_length]
      ActionDispatch::Http::URL.set_tld_length(t) if t in Integer
      ActionDispatch::Http::MimeNegotiation.set_ignore_accept_header(ad[:ignore_accept_header] == true)
      c = ad[:default_charset]
      ActionDispatch::Response.set_default_charset(c) if c in String
      h = ad[:default_headers]
      ActionDispatch::Response.set_default_headers(h) if h in Hash
      # Ruby: ActionDispatch::ExceptionWrapper.rescue_responses.merge!(config.action_dispatch.rescue_responses)
      rr = ad[:rescue_responses]
      Hash.each(rr) { |k, v| ActionDispatch::ExceptionWrapper.rescue_responses[Kernel.to_s(k)] = v if v in Symbol } if rr in Hash
      nil
    end
  end
end
