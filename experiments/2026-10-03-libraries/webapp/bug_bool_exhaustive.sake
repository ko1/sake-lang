# `in true` + `in false` cover every Boolean, but level 3 reports the case as not exhaustive.
def show(v)
  case v
  in true then "yes"
  in false then "no"
  in Integer then "n"
  end
end
p(show(true))
p(show(false))
p(show(1))
# Same with one branch `in true | false`:
def show2(v)
  case v
  in true | false then "bool"
  in Integer then "n"
  end
end
p(show2(true))
p(show2(2))
