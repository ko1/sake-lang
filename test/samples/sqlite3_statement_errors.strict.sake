# Rejected before running: a statement's binds are those of execute; a row value is Integer|Float|String|nil.
db = SQLite3::Database.new(":memory:")
st = SQLite3::Database.prepare(db, "select ?")
SQLite3::Statement.bind_params(st, Any[:sym])
SQLite3::Statement.execute(st, Any[true])
row = SQLite3::Statement.step(st)
p(Array.first(row || Any[]) + 1)
SQLite3::Statement.columns(db)
