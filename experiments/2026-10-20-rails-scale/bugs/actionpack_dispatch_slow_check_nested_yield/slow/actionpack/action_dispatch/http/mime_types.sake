# Port of actionpack-8.1.3/lib/action_dispatch/http/mime_types.rb
#
# Build list of Mime types for HTTP responses
# https://www.iana.org/assignments/media-types/

require "mime_type"

Mime::Type.register("text/html", :html, String["application/xhtml+xml"], String["xhtml"])
Mime::Type.register("text/plain", :text, String[], String["txt"])
Mime::Type.register("text/javascript", :js, String["application/javascript", "application/x-javascript"])
Mime::Type.register("text/css", :css)
Mime::Type.register("text/calendar", :ics)
Mime::Type.register("text/csv", :csv)
Mime::Type.register("text/vcard", :vcf)
Mime::Type.register("text/vtt", :vtt, String[], String["vtt"])
Mime::Type.register("text/markdown", :md, String[], String["md", "markdown"])

Mime::Type.register("image/png", :png, String[], String["png"])
Mime::Type.register("image/jpeg", :jpeg, String[], String["jpg", "jpeg", "jpe", "pjpeg"])
Mime::Type.register("image/gif", :gif, String[], String["gif"])
Mime::Type.register("image/bmp", :bmp, String[], String["bmp"])
Mime::Type.register("image/tiff", :tiff, String[], String["tif", "tiff"])
Mime::Type.register("image/svg+xml", :svg)
Mime::Type.register("image/webp", :webp, String[], String["webp"])

Mime::Type.register("video/mpeg", :mpeg, String[], String["mpg", "mpeg", "mpe"])

Mime::Type.register("audio/mpeg", :mp3, String[], String["mp1", "mp2", "mp3"])
Mime::Type.register("audio/ogg", :ogg, String[], String["oga", "ogg", "spx", "opus"])
Mime::Type.register("audio/aac", :m4a, String["audio/mp4"], String["m4a", "mpg4", "aac"])

Mime::Type.register("video/webm", :webm, String[], String["webm"])
Mime::Type.register("video/mp4", :mp4, String[], String["mp4", "m4v"])

Mime::Type.register("font/otf", :otf, String[], String["otf"])
Mime::Type.register("font/ttf", :ttf, String[], String["ttf"])
Mime::Type.register("font/woff", :woff, String[], String["woff"])
Mime::Type.register("font/woff2", :woff2, String[], String["woff2"])

Mime::Type.register("application/xml", :xml, String["text/xml", "application/x-xml"])
Mime::Type.register("application/rss+xml", :rss)
Mime::Type.register("application/atom+xml", :atom)
Mime::Type.register("application/x-yaml", :yaml, String["text/yaml"], String["yml", "yaml"])

Mime::Type.register("multipart/form-data", :multipart_form)
Mime::Type.register("application/x-www-form-urlencoded", :url_encoded_form)

# https://www.ietf.org/rfc/rfc4627.txt
# http://www.json.org/JSONRequest.html
# https://www.ietf.org/rfc/rfc7807.txt
Mime::Type.register("application/json", :json, String["text/x-json", "application/jsonrequest", "application/problem+json"])

Mime::Type.register("application/pdf", :pdf, String[], String["pdf"])
Mime::Type.register("application/zip", :zip, String[], String["zip"])
Mime::Type.register("application/gzip", :gzip, String["application/x-gzip"], String["gz"])
