# Port of activerecord-8.1.3/lib/arel/factory_methods.rb
#
# Ruby's create_join(to, constraint = nil, klass = Nodes::InnerJoin) takes the class to build; Sake has no
# class values, so `klass` is a Symbol (:inner, :outer, :string, ...) and Arel::Nodes.build_join builds it.

module Arel
  module FactoryMethods
    def create_true(f) = Nodes::True.new
    def create_false(f) = Nodes::False.new
    def create_table_alias(f, relation, name) = Nodes::TableAlias.new(relation, name)
    def create_join(f, to, constraint = nil, klass = :inner) = Nodes.build_join(klass, to, constraint)
    def create_string_join(f, to) = create_join(f, to, nil, :string)
    def create_and(f, clauses) = Nodes::And.new(clauses)
    def create_on(f, expr) = Nodes::On.new(expr)
    def grouping(f, expr) = Nodes::Grouping.new(expr)
    def lower(f, column) = Nodes::NamedFunction.new("LOWER", Any[Nodes.build_quoted(column)])
    def coalesce(f, *exprs) = Nodes::NamedFunction.new("COALESCE", exprs)
    def cast(f, name, type) = Nodes::NamedFunction.new("CAST", Any[AliasPredication.as(name, type)])
  end

  module Nodes
    module_function

    # Sake only: the join class named by a Symbol (Ruby passes the class itself).
    def build_join(klass, to, constraint)
      case klass
      in :inner then InnerJoin.new(to, constraint)
      in :outer then OuterJoin.new(to, constraint)
      in :right_outer then RightOuterJoin.new(to, constraint)
      in :full_outer then FullOuterJoin.new(to, constraint)
      in :string then StringJoin.new(to, constraint)
      in :leading then LeadingJoin.new(to, constraint)
      end
    end
  end
end
