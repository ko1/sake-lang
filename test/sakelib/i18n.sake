require "i18n"

def en_data
  Hash[foo: Hash[bar: "Bar", baz: "Baz"],
       hi: "Hi %{name}",
       both: "%{a} and %{b}",
       apples: Hash[zero: "none", one: "%{count} apple", other: "%{count} apples"],
       cats: Hash[one: "a cat"],
       list: Array["a", "b"],
       answer: 42,
       date: Hash[formats: Hash[default: "%Y-%m-%d", short: "%b %d", long: "%B %d, %Y"],
                  day_names: Array["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
                  abbr_day_names: Array["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"],
                  month_names: Array[nil, "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"],
                  abbr_month_names: Array[nil, "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]],
       time: Hash[formats: Hash[default: "%a, %d %b %Y %H:%M:%S %z", short: "%d %b %H:%M", long: "%B %d, %Y %H:%M"], am: "am", pm: "pm"]]
end

def ja_data = Hash[foo: Hash[bar: "バー"], apples: Hash[one: "りんご%{count}個", other: "りんご%{count}個"],
                   date: Hash[formats: Hash[default: "%Y年%m月%d日"]]]

def t0 = Time.new(2024, 7, 1, 13, 5, 9, "+09:00")

puts "-- store and look up"
I18n.backend_store(:en, en_data)
I18n.backend_store(:ja, ja_data)
I18n.backend_store(:en, Hash["str" => Hash["k" => "v"], foo: Hash[qux: "Qux"]])
p I18n.t("foo.bar")
p I18n.t(:"foo.bar")
p I18n.t(:bar, scope: :foo)
p I18n.t("bar", scope: "foo")
p I18n.t(:bar, scope: Array[:foo])
p I18n.t("str.k")
p I18n.t("foo")
p I18n.t("list")
p I18n.t("answer")
p I18n.t("nope")
p I18n.t("foo.nope.x")
p I18n.t("foo.bar.baz")
p I18n.t(nil)
p I18n.t("foo..bar")
p I18n.t(".foo.bar.")
p I18n.t("foo|bar", separator: "|")
p I18n.t(Array[:"foo.bar", :hi], name: "z")
p I18n.exists?("foo.bar")
p I18n.exists?("zz")
p I18n.exists?("foo.bar", :ja)
p I18n.exists?("hi", :ja)
begin
  I18n.t("")
rescue I18nArgumentError => e
  puts "argument error"
end
begin
  I18n.t!("zz")
rescue MissingTranslationData => e
  puts Exception.message(e)
end
p I18n.t!("foo.bar")

puts "-- interpolation"
p I18n.t(:hi, name: "Bob")
p I18n.t(:hi)
p I18n.t(:hi, name: nil)
p I18n.t(:hi, name: 3)
p I18n.t(:hi, name: "%{name}")
p I18n.t(:both, a: 1, b: :two)
begin
  I18n.t(:hi, other: 1)
rescue MissingInterpolationArgument => e
  puts Exception.message(e)
end
p I18n.t("foo.bar", count: 2)

puts "-- pluralization"
p I18n.t(:apples, count: 0)
p I18n.t(:apples, count: 1)
p I18n.t(:apples, count: 2)
p I18n.t(:apples, count: 1.0)
p I18n.t(:apples, count: 0.0)
p I18n.t(:apples)
p I18n.t(:apples, count: nil)
p I18n.t(:cats, count: 1)
begin
  I18n.t(:cats, count: 3)
rescue InvalidPluralizationData => e
  puts Exception.message(e)
end

puts "-- defaults"
p I18n.t("zz", default: "dflt")
p I18n.t("zz", default: :"foo.bar")
p I18n.t("zz", default: Array[:"a.b", :"foo.bar"])
p I18n.t("zz", default: Array[:"a.b", "last"])
p I18n.t("foo", default: "x")
p I18n.t(:apples, count: 3, default: "d")
p I18n.t("zz", default: "%{name}!", name: "N")
p I18n.t(:zz, default: :apples, count: 1)
p I18n.t(:zz, default: "a %{count}", count: 5)
p I18n.t(:"foo.bar", default: nil)
p I18n.t(:zz, default: 42)
p I18n.t(:zz, default: :bar, scope: :foo)

puts "-- locales"
p I18n.available_locales
p I18n.locale
p I18n.default_locale
p I18n.t("foo.bar", locale: :ja)
p I18n.t("hi", locale: :ja, name: "x")
p I18n.t("apples", locale: :ja, count: 3)
I18n.with_locale(:ja) do
  p I18n.locale
  p I18n.t("foo.bar")
end
p I18n.locale
I18n.set_locale(:ja)
p I18n.locale
p I18n.t("foo.bar")
I18n.set_locale(:en)
begin
  I18n.set_locale(:fr)
rescue InvalidLocale => e
  puts Exception.message(e)
end
begin
  I18n.t("foo.bar", locale: :fr)
rescue InvalidLocale => e
  puts Exception.message(e)
end
p I18n.enforce_available_locales
I18n.set_enforce_available_locales(false)
p I18n.t("foo.bar", locale: :fr)
I18n.set_enforce_available_locales(true)

puts "-- fallbacks"
p I18n.fallbacks(:ja)
I18n.set_fallbacks(Array[:en])
p I18n.fallbacks(:ja)
p I18n.fallbacks
p I18n.t("hi", locale: :ja, name: "x")
p I18n.t("zz", locale: :ja)
p I18n.t("foo.bar", locale: :ja)
p I18n.t("foo", locale: :ja)
p I18n.t("apples", locale: :ja, count: 1)
p I18n.exists?("hi", :ja)
I18n.set_locale(:ja)
p I18n.t("hi", name: "y")
I18n.set_locale(:en)

puts "-- localize"
p I18n.l(t0)
p I18n.l(t0, format: :short)
p I18n.l(t0, format: :long)
p I18n.l(t0, format: "%H:%M %p %P %-d %^a %^B")
p I18n.l(Date.new(2024, 7, 1))
p I18n.l(Date.new(2024, 7, 1), format: :long)
p I18n.l(Date.new(2024, 7, 1), format: :short)
p I18n.l(Date.new(2024, 7, 1), locale: :ja)
p I18n.l(t0, format: "%Y/%m/%d", locale: :ja)
begin
  I18n.l(t0, format: :nope)
rescue MissingTranslationData => e
  puts Exception.message(e)
end
begin
  I18n.l(t0, locale: :ja)
rescue MissingTranslationData => e
  puts Exception.message(e)
end
begin
  I18n.l(nil)
rescue I18nArgumentError => e
  puts Exception.message(e)
end

puts "-- yaml"
Dir.mktmpdir do |d|
  path = File.join(d, "de.yml")
  File.write(path, "de:\n  foo:\n    bar: Riegel\n  hi: Hallo %{name}\n  apples:\n    one: ein Apfel\n    other: \"%{count} Äpfel\"\n  n: 7\nfr:\n  foo:\n    bar: Barre\n")
  I18n.load_yaml(path)
  p I18n.available_locales
  p I18n.t("foo.bar", locale: :de)
  p I18n.t("hi", locale: :de, name: "Welt")
  p I18n.t("apples", locale: :de, count: 2)
  p I18n.t("n", locale: :de)
  p I18n.t("foo.bar", locale: :fr)
  p I18n.t("foo.baz", locale: :fr)
end

puts "-- transliterate"
p I18n.transliterate("Ærøskøbing")
p I18n.transliterate("日本")
p I18n.transliterate("Ærøskøbing 日本", replacement: "*")
p I18n.transliterate("Český Straße")
