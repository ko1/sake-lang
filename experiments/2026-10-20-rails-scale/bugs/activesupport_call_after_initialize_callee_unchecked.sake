# The checker treats everything after `K.up(e)` as unreachable when `up` is also called from K's initialize:
# `bin/sake -c --strict` says OK although line 15 is a type error, `bin/sake --types` lists the code after as dead,
# and a `rescue` around such code gets a false [unused-rescue] warning (found in MessageEncryptor: its
# initialize and decrypt both call new_cipher, so decrypt_and_verify's rescue InvalidMessageContent was "never raised").
# Running it prints "ABC" and then fails at line 15, as Ruby would (String can't be coerced into Integer).
class K
  attr_reader name
  attr_accessor size
  def initialize(k)
    @size = String.size(up(k))
  end
  def up(k) = String.upcase(@name)
end
p(K.up(K.new("abc")))
p(1 + "x")   # expected: a static error here
