# Port of activerecord-8.1.3/lib/arel/nodes/binary.rb (partial: no hash/eql?, Sake's == compares fields)
#
# Ruby's class Binary (attr_accessor :left, :right) is a module here: each binary node class declares
# `attr_accessor left, right` and includes Binary, so `Binary.left(o)` reads any binary node's left.
# Ruby makes Assignment, Join, Union, UnionAll, Intersect and Except with Class.new(Binary) in a loop;
# here each is written out.

module Arel
  module Nodes
    module Binary
      include NodeExpression
      def left(o) = raise(NotImplementedError)
      def right(o) = raise(NotImplementedError)
      def set_left(o, v) = raise(NotImplementedError)
      def set_right(o, v) = raise(NotImplementedError)
    end

    # Ruby's FetchAttribute (fetch_attribute { |attr| }) is the model layer's; not ported here.
    module FetchAttribute
    end

    class As
      attr_accessor left, right
      include Binary
      def to_cte(o)
        name = @left
        name => Arel::Table
        Cte.new(Arel::Table.name(name), @right)
      end
    end

    class Between
      attr_accessor left, right
      include Binary
      include FetchAttribute
    end

    class GreaterThan
      attr_accessor left, right
      include Binary
      include FetchAttribute
      def invert(o) = LessThanOrEqual.new(@left, @right)
    end

    class GreaterThanOrEqual
      attr_accessor left, right
      include Binary
      include FetchAttribute
      def invert(o) = LessThan.new(@left, @right)
    end

    class LessThan
      attr_accessor left, right
      include Binary
      include FetchAttribute
      def invert(o) = GreaterThanOrEqual.new(@left, @right)
    end

    class LessThanOrEqual
      attr_accessor left, right
      include Binary
      include FetchAttribute
      def invert(o) = GreaterThan.new(@left, @right)
    end

    class IsDistinctFrom
      attr_accessor left, right
      include Binary
      include FetchAttribute
      def invert(o) = IsNotDistinctFrom.new(@left, @right)
    end

    class IsNotDistinctFrom
      attr_accessor left, right
      include Binary
      include FetchAttribute
      def invert(o) = IsDistinctFrom.new(@left, @right)
    end

    class NotEqual
      attr_accessor left, right
      include Binary
      include FetchAttribute
      def invert(o) = Equality.new(@left, @right)
    end

    class NotIn
      attr_accessor left, right
      include Binary
      include FetchAttribute
      def invert(o) = In.new(@left, @right)
    end

    class Assignment
      attr_accessor left, right
      include Binary
    end

    # Ruby's Join is the superclass of the join nodes; here a module they include.
    module Join
      include Binary
    end

    class Union
      attr_accessor left, right
      include Binary
    end

    class UnionAll
      attr_accessor left, right
      include Binary
    end

    class Intersect
      attr_accessor left, right
      include Binary
    end

    class Except
      attr_accessor left, right
      include Binary
    end
  end
end
