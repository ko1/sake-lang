# (Sake only) The module a type includes to give Object.as_json (core_ext/object/json) its own as_json, as
# Ruby's classes each define as_json. ActiveSupport's own types (Duration, TimeWithZone, SafeBuffer,
# HashWithIndifferentAccess, OrderedOptions, StringInquirer) include it; so may a program's.

module ActiveSupport
  module AsJson
    def as_json(x, options = nil) = raise(NotImplementedError)
  end
end
