Recipe = Struct.new(:name, :per_batch, :mix_min, :bake_min, :ingredients)
Order = Struct.new(:id, :customer, :product, :qty, :due, :ready_at)
Oven = Struct.new(:name, :busy_until, :batches)
OutOfStock = Exception.new(:ingredient, :short)

def recipes
  Hash[
    "baguette" => Recipe.new("baguette", 12, 15, 25, Hash["flour" => 3000, "yeast" => 30, "salt" => 60]),
    "croissant" => Recipe.new("croissant", 18, 30, 18, Hash["flour" => 1800, "butter" => 1000, "yeast" => 25, "sugar" => 150]),
    "rye" => Recipe.new("rye", 6, 20, 50, Hash["rye" => 2500, "flour" => 500, "salt" => 50]),
    "muffin" => Recipe.new("muffin", 24, 10, 22, Hash["flour" => 1200, "sugar" => 600, "butter" => 400, "egg" => 8])
  ]
end

def consume(stock, recipe, batches)
  needs = Hash.transform_values(Recipe.ingredients(recipe)) { |amt| amt * batches }
  Hash.each(needs) do |ing, amt|
    have = Hash.fetch(stock, ing, 0)
    raise OutOfStock.new("short of #{ing}", ing, amt - have) if have < amt
  end
  Hash.each(needs) { |ing, amt| stock[ing] -= amt }
  needs
end

def clock(min) = format("%02d:%02d", 4 + min / 60, min % 60)

def plan(orders, stock, ovens, deliveries)
  mixer_free = 0
  log = String[]
  queue = Array.sort_by(orders) { |o| [Order.due(o), Order.id(o)] }
  Array.each(queue) do |o|
    recipe = recipes[Order.product(o)]
    batches = Integer.ceildiv(Order.qty(o), Recipe.per_batch(recipe))
    start = mixer_free
    begin
      consume(stock, recipe, batches)
    rescue OutOfStock => e
      ing = OutOfStock.ingredient(e)
      arrival = Array.find(deliveries) { |at, item, amount| item == ing && amount >= OutOfStock.short(e) }
      if arrival == nil
        Array.push(log, "#{clock(start)} order #{Order.id(o)} cancelled: no #{ing}")
        next
      end
      at, item, amount = arrival
      Array.delete(deliveries, arrival)
      stock[item] = Hash.fetch(stock, item, 0) + amount
      start = at if at > start
      Array.push(log, "#{clock(start)} took delivery of #{amount} #{item}")
      retry
    end
    Integer.times(batches) do
      mix_done = start + Recipe.mix_min(recipe)
      oven = Array.min_by(ovens) { |ov| Oven.busy_until(ov) }
      bake_start = Oven.busy_until(oven) > mix_done ? Oven.busy_until(oven) : mix_done
      Oven.set_busy_until(oven, bake_start + Recipe.bake_min(recipe))
      Oven.set_batches(oven, Oven.batches(oven) + 1)
      Order.set_ready_at(o, Oven.busy_until(oven))
      start = mix_done
    end
    mixer_free = start
    late = Order.ready_at(o) - Order.due(o)
    Array.push(log, format("%s order %d %-9s x%-3d %d batch(es) ready %s%s", clock(start), Order.id(o), Order.product(o),
      Order.qty(o), batches, clock(Order.ready_at(o)), late > 0 ? " LATE #{late}m" : ""))
  end
  log
end

orders = Array[
  Order.new(1, "cafe", "croissant", 40, 150, nil), Order.new(2, "hotel", "baguette", 30, 200, nil),
  Order.new(3, "deli", "rye", 10, 280, nil), Order.new(4, "school", "muffin", 60, 240, nil),
  Order.new(5, "cafe", "baguette", 12, 210, nil), Order.new(6, "market", "rye", 14, 360, nil),
  Order.new(7, "hotel", "croissant", 30, 300, nil), Order.new(8, "deli", "muffin", 20, 320, nil)
]
stock = Hash["flour" => 30000, "yeast" => 400, "salt" => 600, "butter" => 3000, "sugar" => 4000, "rye" => 6000, "egg" => 30]
deliveries = Array[[150, "butter", 5000], [200, "rye", 10000], [90, "egg", 24]]
ovens = Oven[Oven.new("deck", 0, 0), Oven.new("rack", 0, 0)]

log = plan(orders, stock, ovens, deliveries)
Array.each(log) { puts(it) }
puts("--- ovens")
Array.each(ovens) { |ov| puts("#{Oven.name(ov)}: #{Oven.batches(ov)} batches, free at #{clock(Oven.busy_until(ov))}") }
puts("--- leftover stock")
Array.each(Array.sort(Hash.keys(stock))) { |ing| puts(format("%-7s %6d", ing, stock[ing])) }
done = Array.select(orders) { Order.ready_at(it) != nil }
late = Array.select(done) { Order.ready_at(it) > Order.due(it) }
puts("orders done #{Array.size(done)}/#{Array.size(orders)}, late #{Array.size(late)}")
by_customer = Hash.new(0)
Array.each(done) { |o| by_customer[Order.customer(o)] += Order.qty(o) }
puts(Array.join(Array.map(Hash.sort_by(by_customer) { |c, n| c }) { |c, n| "#{c}=#{n}" }, " "))
