# Port of activesupport-8.1.3/lib/active_support/core_ext/time/calculations.rb (partial: no Time.=== for TimeWithZone, no at_with_coercion, rfc3339, compare_with_coercion; change with a zone object)
#
# Ruby's options Hash (`t.change(hour: 0)`) is a Hash here (`Time.change(t, Hash.of(hour: 0))`); its values are
# Integers, a Rational second, or an offset String, so each read is narrowed by `opt_int` / `opt_num` (Sake only).

require "date"
require "../date_and_time/calculations"
require "../date/calculations"
require "zones"

class Time
  include DateAndTime::Calculations

  def common_year_days_in_month = once { Any[nil, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31] }

  def days_in_month(month, year = nil)
    y = year || Time.year(Time.now)
    if month == 2 && Date.gregorian_leap?(y)
      29
    else
      d = common_year_days_in_month[month]
      d => Integer
      d
    end
  end

  def days_in_year(year = nil) = days_in_month(2, year) + 337

  # Ruby: Time.current is Time.zone.now when a zone is set (a TimeWithZone), else Time.now; here the UTC
  # instant either way (`Time.zone_now` gives the TimeWithZone).
  def current = Time.now

  def seconds_since_midnight(t) = Time.to_i(t) - Time.to_i(Time.change(t, Hash.of(hour: 0))) + (Time.usec(t) / 1.0e+6)
  def seconds_until_end_of_day(t) = Time.to_i(Time.end_of_day(t)) - Time.to_i(t)
  def sec_fraction(t) = Time.subsec(t)

  # (Sake only) an option read as an Integer / a number, or the default.
  def opt_int(options, key, default)
    v = options[key]
    case v
    in nil then default
    in Integer then v
    else raise ArgumentError, "#{key} must be an Integer: #{Kernel.inspect(v)}"
    end
  end

  def opt_num(options, key, default)
    v = options[key]
    case v
    in nil then default
    in Integer | Rational | Float then v
    else raise ArgumentError, "#{key} must be a number: #{Kernel.inspect(v)}"
    end
  end

  def change(t, options)
    new_year = opt_int(options, :year, Time.year(t))
    new_month = opt_int(options, :month, Time.month(t))
    new_day = opt_int(options, :day, Time.day(t))
    new_hour = opt_int(options, :hour, Time.hour(t))
    new_min = opt_int(options, :min, options[:hour] ? 0 : Time.min(t))
    new_sec = opt_num(options, :sec, (options[:hour] || options[:min]) ? 0 : Time.sec(t))
    new_offset = options[:offset]
    if (new_nsec = options[:nsec])
      raise ArgumentError, "Can't change both :nsec and :usec at the same time: #{Kernel.inspect(options)}" if options[:usec]
      new_usec = Rational(opt_int(options, :nsec, 0), 1000)
    else
      new_usec = opt_num(options, :usec, (options[:hour] || options[:min] || options[:sec]) ? 0 : Rational(Time.nsec(t), 1000))
    end
    raise ArgumentError, "argument out of range" if new_usec >= 1000000
    new_sec += Rational(new_usec) / 1000000
    if new_offset
      new_offset => String | Integer
      Time.new(new_year, new_month, new_day, new_hour, new_min, new_sec, new_offset)
    elsif Time.utc?(t)
      Time.utc(new_year, new_month, new_day, new_hour, new_min, new_sec)
    else
      Time.new(new_year, new_month, new_day, new_hour, new_min, new_sec, Time.utc_offset(t))
    end
  end

  def advance(t, options)
    opts = Hash.dup(options)
    unless opts[:weeks] == nil
      weeks, partial_weeks = Arithmetic.floor(opt_num(opts, :weeks, 0)), opt_num(opts, :weeks, 0) % 1
      opts[:weeks] = weeks
      opts[:days] = opt_num(opts, :days, 0) + 7 * partial_weeks
    end
    unless opts[:days] == nil
      days, partial_days = Arithmetic.floor(opt_num(opts, :days, 0)), opt_num(opts, :days, 0) % 1
      opts[:days] = days
      opts[:hours] = opt_num(opts, :hours, 0) + 24 * partial_days
    end
    d = Date.advance(Date.new(Time.year(t), Time.month(t), Time.day(t)), opts)
    time_advanced_by_date = Time.change(t, Hash.of(year: Date.year(d), month: Date.month(d), day: Date.day(d)))
    seconds_to_advance = opt_num(opts, :seconds, 0) + opt_num(opts, :minutes, 0) * 60 + opt_num(opts, :hours, 0) * 3600
    if seconds_to_advance == 0
      time_advanced_by_date
    else
      Time.since(time_advanced_by_date, seconds_to_advance)
    end
  end

  def ago(t, seconds) = Time.since(t, -seconds)
  def since(t, seconds) = t + seconds
  def in(t, seconds) = t + seconds

  def beginning_of_day(t) = Time.change(t, Hash.of(hour: 0))
  def midnight(t) = Time.change(t, Hash.of(hour: 0))
  def at_midnight(t) = Time.change(t, Hash.of(hour: 0))
  def at_beginning_of_day(t) = Time.change(t, Hash.of(hour: 0))
  def middle_of_day(t) = Time.change(t, Hash.of(hour: 12))
  def midday(t) = Time.change(t, Hash.of(hour: 12))
  def noon(t) = Time.change(t, Hash.of(hour: 12))
  def end_of_day(t) = Time.change(t, Hash.of(hour: 23, min: 59, sec: 59, usec: Rational(999999999, 1000)))
  def at_end_of_day(t) = Time.end_of_day(t)
  def beginning_of_hour(t) = Time.change(t, Hash.of(min: 0))
  def at_beginning_of_hour(t) = Time.change(t, Hash.of(min: 0))
  def end_of_hour(t) = Time.change(t, Hash.of(min: 59, sec: 59, usec: Rational(999999999, 1000)))
  def at_end_of_hour(t) = Time.end_of_hour(t)
  def beginning_of_minute(t) = Time.change(t, Hash.of(sec: 0))
  def at_beginning_of_minute(t) = Time.change(t, Hash.of(sec: 0))
  def end_of_minute(t) = Time.change(t, Hash.of(sec: 59, usec: Rational(999999999, 1000)))
  def at_end_of_minute(t) = Time.end_of_minute(t)

  def past?(t) = t < Time.current
  def future?(t) = t > Time.current
  def to_date(t) = Date.new(Time.year(t), Time.month(t), Time.day(t))
  def today?(t) = Time.to_date(t) == Date.today

  # DateAndTime::Calculations' hooks (Ruby: `acts_like?(:time)`)
  def first_hour(t, date_or_time) = Time.beginning_of_day(date_or_time)
  def last_hour(t, date_or_time) = Time.end_of_day(date_or_time)
  def midnight_if_time(t, date_or_time) = Time.midnight(date_or_time)

  def copy_time_to(t, other)
    Time.change(other, Hash.of(hour: Time.hour(t), min: Time.min(t), sec: Time.sec(t), nsec: Time.nsec(t)))
  end
end
