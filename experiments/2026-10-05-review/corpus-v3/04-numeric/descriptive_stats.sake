class Sample
  attr_reader name, values
end

def mean(xs) = Array.sum(xs) / Array.size(xs)

def variance(xs)
  m = mean(xs)
  Array.sum(Array.map(xs) { |x| (x - m) ** 2 }) / (Array.size(xs) - 1)
end

def stddev(xs) = Math.sqrt(variance(xs))

def quantile(sorted, q)
  pos = (Array.size(sorted) - 1) * q
  lo = Float.floor(pos)
  hi = Float.ceil(pos)
  return sorted[lo] if lo == hi
  frac = pos - lo
  sorted[lo] * (1.0 - frac) + sorted[hi] * frac
end

def median(xs) = quantile(Array.sort(xs), 0.5)

def skewness(xs)
  m = mean(xs)
  s = stddev(xs)
  n = Array.size(xs)
  Array.sum(Array.map(xs) { |x| ((x - m) / s) ** 3 }) / n
end

def mode_bucket(xs, width)
  counts = Hash.new(0)
  Array.each(xs) { |x| counts[Float.floor(x / width)] += 1 }
  best = Hash.max_by(counts) { |k, v| v }
  return nil unless best
  k, c = best
  [k * width, c]
end

def summarize(sample)
  xs = Sample.get_values(sample)
  sorted = Array.sort(xs)
  {
    n: Array.size(xs),
    mean: mean(xs),
    median: median(xs),
    sd: stddev(xs),
    min: Array.first(sorted),
    max: Array.last(sorted),
    q1: quantile(sorted, 0.25),
    q3: quantile(sorted, 0.75),
    skew: skewness(xs)
  }
end

def outliers(xs, q1, q3)
  iqr = q3 - q1
  lo = q1 - 1.5 * iqr
  hi = q3 + 1.5 * iqr
  Array.select(xs) { |x| x < lo || x > hi }
end

samples = Sample[
  Sample.new("heights", Float[172.5, 168.0, 181.2, 175.4, 160.9, 190.3, 177.7, 169.8, 174.1, 183.6, 165.2]),
  Sample.new("latency_ms", Float[12.1, 11.8, 13.0, 12.4, 55.2, 12.9, 11.5, 12.2, 13.4, 12.0, 49.8, 12.6]),
  Sample.new("returns", Float[0.012, -0.034, 0.008, 0.021, -0.005, 0.017, -0.012, 0.003, 0.029, -0.041])
]

Array.each(samples) do |s|
  r = summarize(s)
  r => {n:, mean:, median:, sd:, min:, max:, q1:, q3:, skew:}
  puts("== #{Sample.get_name(s)} (n=#{n})")
  puts(format("  mean=%.4f median=%.4f sd=%.4f", mean, median, sd))
  puts(format("  min=%.4f q1=%.4f q3=%.4f max=%.4f", min, q1, q3, max))
  puts(format("  skewness=%.4f", skew))
  out = outliers(Sample.get_values(s), q1, q3)
  if Array.empty?(out)
    puts("  no outliers")
  else
    puts("  outliers: #{Array.join(Array.map(out) { |x| format("%.3f", x) }, ", ")}")
  end
  mb = mode_bucket(Sample.get_values(s), sd)
  if mb
    start, count = mb
    puts(format("  densest bucket starts at %.3f with %d values", start, count))
  end
end

all = Array.flat_map(samples) { |s| Array.map(Sample.get_values(s)) { |x| x / Array.max(Sample.get_values(s)) } }
puts(format("normalized pooled mean: %.5f", mean(all)))
cv = Array.map(samples) { |s| [Sample.get_name(s), stddev(Sample.get_values(s)) / Float.abs(mean(Sample.get_values(s)))] }
Array.each(Array.sort_by(cv) { |name, c| c }) { |name, c| puts(format("cv %-12s %.4f", name, c)) }
