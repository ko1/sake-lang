# `(A|B).f(x)` lists the types on the operation; x's type picks which f runs.
Leaf = Struct.new(:weight)
Node = Struct.new(:weight, :left, :right)
def total(t) = (Leaf|Node).weight(t)
p(total(Leaf.new(3)) + total(Node.new(5, Leaf.new(1), Leaf.new(4))))

def size_of(x) = (String|Array|Hash).size(x)
p([size_of("abc"), size_of(Array[1, 2]), size_of(Hash["a" => 1])])
p((Integer|Float).round(2.6))

# `*rest` is packed for the branch that takes it; IO can be listed (a built-in and a user type).
require "stringio"
class Log
  attr_reader lines
  def initialize(l) = nil
  def print(l, *xs) = Array.push(@lines, Array.join(xs, ""))
end
def emit(o, s) = (IO|Log).print(o, s, "\n")
l = Log.new(String[])
emit(l, "a")
emit(IO.stdout, "b")
p(Log.lines(l))
