# A mixin function calling a function its includer defines, with keyword arguments, is rejected:
# "keyword arguments go only to functions with keyword parameters", although the includer's `build` has
# `**attributes`. Ruby calls self.build(title: "x") fine. (ActiveRecord::Persistence#create calls Core's
# build(**attributes); found by the activerecord port; workaround: a positional build_with(Hash).)
module Persistence
  def create(**attributes) = build(**attributes)
  def make(t) = build(title: t)
end
class Post
  attr_reader title
  include Persistence
  def build(**attributes) = Post.new(Kernel.to_s(attributes[:title]))
end
p(Post.make("x"), Post.create(title: "y"))
