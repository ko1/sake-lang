# A Regexp as a Hash key and a Set element (Ruby: equal by source and options), and Regexp[...], a typed Array.
h = Hash.new(0)
Array.each(Any[/a+/, /b/, /a+/, /a+/i]) { |r| h[r] += 1 }
p(h)
p(Hash.fetch(h, /a+/), h[/a+/m])
s = Set.of(/x/, /x/, /y/)
p(Set.size(s), Set.include?(s, /y/))
groups = Array.group_by(Any["cat", "dog", "cow"]) { |w| String.start_with?(w, "c") ? /\Ac/ : /\Ad/ }
p(Hash.keys(groups))
rs = Regexp[/\d+/, /[a-z]+/]
Array.push(rs, Regexp.new("x", "i"))
p(rs, Array.map(rs) { |r| Regexp.match?(r, "abc") })
p(Hash.of(rs => 1)[Regexp[/\d+/, /[a-z]+/, /x/i]])
