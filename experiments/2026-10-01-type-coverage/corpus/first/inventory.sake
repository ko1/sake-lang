Item = Data.define(:name, :price, :qty)

class Item
  def value(it) = get_price(it) * get_qty(it)
end

items = Item[
  Item.new("pen", 120, 30),
  Item.new("notebook", 350, 4),
  Item.new("eraser", 80, 2),
  Item.new("stapler", 1200, 7),
  Item.new("ruler", 200, 3),
  Item.new("marker", 150, 12)
]

total = Array.sum(Array.map(items) { |it| Item.value(it) })
puts(String.+("total stock value: ", Integer.to_s(total)))

low = Array.sort_by(Array.select(items) { |it| Item.get_qty(it) < 5 }) { |it| Item.get_price(it) }
puts("low stock:")
Array.each(low) { |it| puts(String.+("  ", Item.get_name(it))) }

puts("report:")
Array.each(items) { |it|
  line = String.ljust(Item.get_name(it), 10) +
         String.rjust(Integer.to_s(Item.get_price(it)), 6) +
         String.rjust(Integer.to_s(Item.get_qty(it)), 5) +
         String.rjust(Integer.to_s(Item.value(it)), 8)
  puts(line)
}
