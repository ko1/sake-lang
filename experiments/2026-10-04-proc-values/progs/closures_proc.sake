# Closures as state: counters and accumulators made by functions, a formatter kept in a field.
def counter(start)
  n = start
  proc { n = n + 1 }
end
def adder(&f) = proc { |x| Proc.call(f, x) + 1 }
class Logger
  attr_reader formatter, lines
  def info(l, msg) = Array.push(@lines, Proc.call(@formatter, "INFO", msg))
end
c1 = counter(0)
c2 = counter(10)
Proc.call(c1)
Proc.call(c1)
p Proc.call(c1)
p Proc.call(c2)
inc = adder { |x| x * 2 }
p Proc.call(inc, 5)
lg = Logger.new(proc { |sev, msg| "[#{sev}] #{msg}" }, String[])
Logger.info(lg, "started")
Logger.info(lg, "done")
p lg.Logger.get_lines
