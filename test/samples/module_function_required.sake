# A required function (`raise NotImplementedError`) of a module with module_function still dispatches
# to the classes that include the module.
module Shape
  module_function
  def area(s) = raise NotImplementedError
  def describe(s) = "area #{Shape.area(s)}"
end
class Sq
  include Shape
  attr_reader a
  def area(q) = @a * @a
end
class Circle
  include Shape
  attr_reader r
  def area(c) = 3 * @r * @r
end
p(Shape.area(Sq.new(3)))
p(Shape.area(Circle.new(2)))
puts(Shape.describe(Sq.new(4)))
