def pi = 3.141592653589793

Circle = Data.define(:radius)
Rect = Data.define(:w, :h)

class Circle
  def area(c) = pi * radius(c) * radius(c)
  def perimeter(c) = 2.0 * pi * radius(c)
end

class Rect
  def area(r) = w(r) * h(r)
  def perimeter(r) = 2.0 * (w(r) + h(r))
end

circles = Circle[Circle.new(1.0), Circle.new(2.5)]
rects = Rect[Rect.new(3.0, 4.0), Rect.new(1.5, 2.0)]

total = 0.0
Array.each(circles) { |c|
  a = Circle.area(c)
  total += a
  puts(String.+("Circle r=", String.+(Float.to_s(Circle.radius(c)), String.+(" area=", String.+(Float.to_s(Float.round(a, 2)), String.+(" perimeter=", Float.to_s(Float.round(Circle.perimeter(c), 2))))))))
}
Array.each(rects) { |r|
  a = Rect.area(r)
  total += a
  puts(String.+("Rect ", String.+(Float.to_s(Rect.w(r)), String.+("x", String.+(Float.to_s(Rect.h(r)), String.+(" area=", String.+(Float.to_s(Float.round(a, 2)), String.+(" perimeter=", Float.to_s(Float.round(Rect.perimeter(r), 2))))))))))
}
puts(String.+("Total area: ", Float.to_s(Float.round(total, 2))))
