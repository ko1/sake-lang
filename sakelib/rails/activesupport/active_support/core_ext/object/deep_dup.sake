# Port of activesupport-8.1.3/lib/active_support/core_ext/object/deep_dup.rb and object/duplicable.rb (Sake needs them together)

module Object
  module_function

  # Object#deep_dup: Arrays and Hashes copied through, the rest by dup (Ruby: `duplicable? ? dup : self`).
  def deep_dup(x)
    case x
    in Array then Array.deep_dup(x)
    in Hash then Hash.deep_dup(x)
    else dup(x)
    end
  end

  # Ruby: duplicable? is false only for a singleton or a Method; every Sake value can be dup'ed.
  def duplicable?(x) = true
end

class Array
  def deep_dup(xs) = Array.map(xs) { |x| Object.deep_dup(x) }
end

class Hash
  # Ruby: a copy whose values (and keys other than Strings and Symbols) are deep_dup'ed.
  def deep_dup(h)
    hash = Hash.dup(h)
    Hash.each(h) do |key, value|
      if key in String | Symbol
        hash[key] = Object.deep_dup(value)
      else
        Hash.delete(hash, key)
        hash[Object.deep_dup(key)] = Object.deep_dup(value)
      end
    end
    hash
  end
end
