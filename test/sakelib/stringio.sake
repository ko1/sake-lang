require "stringio"

def try
  yield
rescue IOError, ArgumentError, EOFError => e
  puts "error: #{Exception.message(e)}"
end

# read, read(n), eof?
io = StringIO.new("abc\ndef\n")
p StringIO.string(io)
p StringIO.pos(io)
p StringIO.eof?(io)
p StringIO.read(io, 2)
p StringIO.pos(io)
p StringIO.read(io)
p StringIO.read(io)
p StringIO.read(io, 1)
p StringIO.read(io, 0)
p StringIO.eof?(io)
p StringIO.size(io)
p StringIO.length(io)
try { StringIO.read(io, -1) }

# gets: separators, limit, chomp, lineno
io = StringIO.new("abc\ndef\nghi")
p StringIO.gets(io)
p StringIO.lineno(io)
p StringIO.gets(io, "e")
p StringIO.gets(io, chomp: true)
p StringIO.gets(io, 2)
p StringIO.gets(io, nil)
p StringIO.gets(io)
p StringIO.lineno(io)
StringIO.set_lineno(io, 10)
p StringIO.lineno(io)
p StringIO.rewind(io)
p StringIO.lineno(io)
p StringIO.gets(io, "\n", 2)
p StringIO.gets(io, "", chomp: true)
p StringIO.gets(io, 0)
io = StringIO.new("a\n\n\nb\nc")
p StringIO.gets(io, "")
p StringIO.pos(io)
p StringIO.gets(io, "")
p StringIO.gets(io, "")
io = StringIO.new("héllo wörld")
p StringIO.gets(io, 2)
p StringIO.getc(io)
p StringIO.getc(io)
p StringIO.read(io, 2)
p StringIO.read(io)

# readline, readlines, each_line
io = StringIO.new("a\nb\n\nc")
p StringIO.readline(io)
p StringIO.readlines(io)
p StringIO.readlines(io)
try { StringIO.readline(io) }
StringIO.rewind(io)
p StringIO.readlines(io, chomp: true)
StringIO.rewind(io)
p StringIO.readlines(io, "")
StringIO.rewind(io)
r = StringIO.each_line(io) { |l| p l }
p r == io
StringIO.rewind(io)
StringIO.each_line(io, chomp: true) { |l| print l, "|" }
puts
StringIO.rewind(io)
StringIO.each(io, "\n") { |l| print String.length(l) }
puts

# getc, ungetc, getbyte, ungetbyte, readchar, readbyte, each_char, each_byte
io = StringIO.new("abc")
p StringIO.getc(io)
p StringIO.ungetc(io, "Z")
p StringIO.string(io)
p StringIO.pos(io)
p StringIO.getc(io)
p StringIO.getbyte(io)
p StringIO.readchar(io)
p StringIO.getc(io)
p StringIO.getbyte(io)
try { StringIO.readchar(io) }
try { StringIO.readbyte(io) }
p StringIO.ungetc(io, "XYZ")
p StringIO.string(io)
p StringIO.pos(io)
StringIO.rewind(io)
p StringIO.ungetbyte(io, 65)
p StringIO.string(io)
p StringIO.ungetc(io, 66)
p StringIO.string(io)
StringIO.rewind(io)
StringIO.each_char(io) { |c| print c, "." }
puts
StringIO.rewind(io)
StringIO.each_byte(io) { |b| print b, "," }
puts
StringIO.rewind(io)
p StringIO.ungetc(io, "ab")
p StringIO.string(io)
p StringIO.pos(io)

# write, <<, print, puts, printf, putc
io = StringIO.new
p StringIO.write(io, "hello")
p StringIO.write(io, " ", "wörld", 1)
p StringIO.string(io)
p StringIO.pos(io)
StringIO.set_pos(io, 0)
p StringIO.write(io, "J")
p StringIO.string(io)
p StringIO.pos(io)
p StringIO.read(io)
StringIO.set_pos(io, 20)
p StringIO.write(io, "Q")
p StringIO.string(io)
p StringIO.size(io)
io = StringIO.new
p StringIO.puts(io, "a", "b\n", 1, nil, Array["x", Array["y", "z"]], Array[])
p StringIO.string(io)
StringIO.puts(io)
p StringIO.string(io)
io = StringIO.new
p StringIO.print(io, "a", 1, nil, :b, 2.5)
p StringIO.string(io)
StringIO.<<(StringIO.<<(io, "x"), 42)
p StringIO.string(io)
io2 = io << "y" << :z
p io2 == io
p StringIO.string(io)
p StringIO.printf(io, "%05.1f|%-3s|%x", 3.14159, "ab", 255)
p StringIO.string(io)
io = StringIO.new
p StringIO.putc(io, "xy")
p StringIO.putc(io, 65)
p StringIO.putc(io, 256 + 66)
p StringIO.string(io)

# pos=, seek, rewind, tell
io = StringIO.new("abcdef")
p StringIO.seek(io, 2)
p StringIO.tell(io)
p StringIO.read(io, 1)
p StringIO.seek(io, 1, 1)
p StringIO.pos(io)
p StringIO.seek(io, -1, 2)
p StringIO.read(io)
p StringIO.seek(io, 0, :SET)
p StringIO.read(io, 1)
p StringIO.seek(io, -1, :CUR)
p StringIO.read(io, 1)
p StringIO.seek(io, -2, :END)
p StringIO.read(io)
try { StringIO.seek(io, -10) }
try { StringIO.seek(io, 0, 5) }
try { StringIO.set_pos(io, -1) }
p StringIO.set_pos(io, 3)
p StringIO.read(io)
p StringIO.set_pos(io, 100)
p StringIO.read(io)
p StringIO.read(io, 1)
p StringIO.eof?(io)
p StringIO.rewind(io)
p StringIO.gets(io)

# truncate, string=, reopen, pread
io = StringIO.new("abcdef")
StringIO.read(io, 4)
p StringIO.truncate(io, 2)
p StringIO.string(io)
p StringIO.pos(io)
p StringIO.read(io)
p StringIO.truncate(io, 4)
p StringIO.string(io)
try { StringIO.truncate(io, -1) }
p StringIO.set_string(io, "new string")
p StringIO.pos(io)
p StringIO.read(io, 3)
p StringIO.pread(io, 3, 4)
p StringIO.pread(io, 0, 4)
p StringIO.pos(io)
try { StringIO.pread(io, 3, 40) }
r = StringIO.reopen(io, "xyz", "r")
p r == io
p StringIO.read(io)
try { StringIO.write(io, "q") }

# modes
io = StringIO.new("abc", "r")
try { StringIO.write(io, "x") }
try { StringIO.puts(io, "x") }
p StringIO.read(io)
io = StringIO.new("abc", "w")
p StringIO.string(io)
p StringIO.write(io, "w")
try { StringIO.read(io) }
try { StringIO.gets(io) }
try { StringIO.eof?(io) }
io = StringIO.new("abc", "w+")
p StringIO.string(io)
io = StringIO.new("abc", "a")
p StringIO.write(io, "d")
p StringIO.string(io)
p StringIO.pos(io)
try { StringIO.read(io) }
io = StringIO.new("abc", "a+")
p StringIO.read(io)
StringIO.rewind(io)
p StringIO.write(io, "d")
p StringIO.string(io)
p StringIO.read(io)
io = StringIO.new("abc", "rb")
p StringIO.read(io, 1)
io = StringIO.new("abc", "r+")
StringIO.read(io, 1)
p StringIO.write(io, "X")
p StringIO.string(io)
try { StringIO.new("abc", "q") }

# the String is shared and changed in place
s = "shared"
io = StringIO.new(s)
StringIO.write(io, "SH")
p s
StringIO.truncate(io, 3)
p s

# close, close_read, close_write, closed?
io = StringIO.new("abc")
p StringIO.closed?(io)
p StringIO.closed_read?(io)
p StringIO.closed_write?(io)
p StringIO.close_write(io)
p StringIO.closed?(io)
p StringIO.closed_write?(io)
try { StringIO.write(io, "x") }
p StringIO.read(io, 1)
p StringIO.close_read(io)
p StringIO.closed?(io)
try { StringIO.read(io) }
try { StringIO.seek(io, 0) }
p StringIO.string(io)
io = StringIO.new("abc", "r")
try { StringIO.close_write(io) }
p StringIO.closed_write?(io)
p StringIO.close(io)
p StringIO.closed?(io)
try { StringIO.read(io) }
try { StringIO.getc(io) }
try { StringIO.eof?(io) }
p StringIO.set_string(io, "again")
p StringIO.closed?(io)
try { StringIO.read(io) }
p StringIO.reopen(io, "open again") == io
p StringIO.closed?(io)
p StringIO.read(io)
p StringIO.write(io, "!")

# the IO-compatible no-ops
io = StringIO.new("abc")
p StringIO.flush(io) == io
p StringIO.fsync(io)
p StringIO.sync(io)
p StringIO.set_sync(io, false)
p StringIO.fileno(io)
p StringIO.isatty(io)
p StringIO.tty?(io)
p StringIO.pid(io)
p StringIO.binmode(io) == io
p StringIO.internal_encoding(io)
p StringIO.readpartial(io, 2)
p StringIO.read_nonblock(io, 5)
try { StringIO.readpartial(io, 1) }
