def square(x) = x * x

def fib(n)
  if n < 2
    n
  else
    fib(n - 1) + fib(n - 2)
  end
end

def min_max(a, b)
  return a, b if a < b
  [b, a]
end

puts(square(12))
puts(square(1.5))           # functions without types are polymorphic
puts(fib(20))
lo, hi = min_max(9, 4)      # a Tuple is destructured by multiple assignment
puts(lo)
puts(hi)
p(min_max(1, 2))
