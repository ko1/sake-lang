p -> q  ==>  (p -> q)
  p q | value
  F F | T
  F T | T
  T F | F
  T T | T
  satisfiable (3/4)
  dnf: !p&!q | !p&q | p&q
!(p & q) <-> (!p | !q)  ==>  (!(p & q) <-> (!p | !q))
  p q | value
  F F | T
  F T | T
  T F | T
  T T | T
  tautology
p & !p  ==>  (p & !p)
  contradiction
  dnf: false
(p -> q) & (q -> r) -> (p -> r)  ==>  (((p -> q) & (q -> r)) -> (p -> r))
  tautology
a | b & c  ==>  (a | (b & c))
  satisfiable (5/8)
  dnf: !a&b&c | a&!b&!c | a&!b&c | a&b&!c | a&b&c
p -> q -> p  ==>  (p -> (q -> p))
  tautology
p ->   ==>  error at 5: expected a variable
p & (q  ==>  error at 6: expected ')'
p ^ q  ==>  error at 2: unexpected input
p -> q  ==  !q -> !p
p -> q  !=  q -> p
!(a | b)  ==  !a & !b
a & (b | c)  ==  a & b | a & c
