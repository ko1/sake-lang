# LIKE matching (spec 2.3): `%` any run of characters, `_` one character, others match ignoring ASCII case.
module LikePattern
  module_function

  def matches?(text, pattern)
    t = String.chars(Value.lower(text))
    p = String.chars(Value.lower(pattern))
    ti = 0
    pi = 0
    star = -1  # where the last `%` is in the pattern; mark is where it started matching in the text
    mark = 0
    while ti < Array.size(t)
      pc = pi < Array.size(p) ? Array.fetch(p, pi) : nil
      if pc == "%"
        star = pi
        mark = ti
        pi += 1
      elsif pc != nil && (pc == "_" || pc == Array.fetch(t, ti))
        ti += 1
        pi += 1
      elsif star != -1
        mark += 1
        ti = mark
        pi = star + 1
      else
        return false
      end
    end
    while pi < Array.size(p) && Array.fetch(p, pi) == "%"
      pi += 1
    end
    pi == Array.size(p)
  end
end
