# Port of activemodel-8.1.3/lib/active_model/attribute_registration.rb (partial: no decorate_attributes, no subclasses' reset)
#
# Ruby keeps the class body's `attribute` calls as pending modifications and applies them, parent first, to a
# new AttributeSet the first time _default_attributes is asked. The generator writes that set as a `once` with
# the modifications in order (apply_type, apply_default); attribute_types and type_for_attribute read it.

require "attribute_set"
require "type"

module ActiveModel
  module AttributeRegistration
    # Required (generated): the class's AttributeSet of defaults.
    def _default_attributes = raise(NotImplementedError)

    # Ruby's attribute_types (a Hash with Type.default_value as its default).
    def attribute_types = AttributeSet.cast_types(_default_attributes)

    def type_for_attribute(attribute_name)
      Hash.fetch(attribute_types, Kernel.to_s(attribute_name), nil) || ActiveModel::Type.default_value
    end

    module_function

    # PendingType#apply_to: the attribute with its type.
    def apply_type(attribute_set, name, type)
      attribute = attribute_set[name]
      attribute_set[name] = ActiveModel::Attribute.with_type(attribute, type || ActiveModel::Attribute.type(attribute))
    end

    # PendingDefault#apply_to.
    def apply_default(attribute_set, name, default)
      attribute_set[name] = ActiveModel::Attribute.with_user_default(attribute_set[name], default)
    end
  end
end
