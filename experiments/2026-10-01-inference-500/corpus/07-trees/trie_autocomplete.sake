TrieNode = Struct.new(:children, :terminal, :freq, :pass)

class TrieNode
  def fresh = TrieNode.new(Hash[], false, 0, 0)
end

class Trie
  attr_reader root, words
  def create = Trie.new(TrieNode.fresh, 0)

  def insert(t, word, freq)
    existing = find_node(t, word)
    if existing && TrieNode.get_terminal(existing)
      TrieNode.set_freq(existing, TrieNode.get_freq(existing) + freq)
      return existing
    end
    node = @root
    TrieNode.set_pass(node, TrieNode.get_pass(node) + 1)
    String.each_char(word) do |c|
      kids = TrieNode.get_children(node)
      child = kids[c]
      if child == nil
        child = TrieNode.fresh
        kids[c] = child
      end
      TrieNode.set_pass(child, TrieNode.get_pass(child) + 1)
      node = child
    end
    @words += 1
    TrieNode.set_terminal(node, true)
    TrieNode.set_freq(node, freq)
    node
  end

  def find_node(t, prefix)
    node = @root
    String.each_char(prefix) do |c|
      node = TrieNode.get_children(node)[c]
      return nil if node == nil
    end
    node
  end

  def include?(t, word)
    node = find_node(t, word)
    node != nil && TrieNode.get_terminal(node)
  end

  def count_prefix(t, prefix)
    node = find_node(t, prefix)
    node ? TrieNode.get_pass(node) : 0
  end

  def collect(node, prefix, out)
    Array.push(out, [prefix, TrieNode.get_freq(node)]) if TrieNode.get_terminal(node)
    keys = Array.sort(Hash.keys(TrieNode.get_children(node)))
    Array.each(keys) { |c| collect(TrieNode.get_children(node)[c], prefix + c, out) }
    out
  end

  def complete(t, prefix, limit)
    node = find_node(t, prefix)
    return Array[] if node == nil
    found = collect(node, prefix, Array[])
    ranked = Array.sort_by(found) { |w, f| format("%08d %s", 99999999 - f, w) }
    Array.map(Array.take(ranked, limit)) { |w, _f| w }
  end

  def longest_common_prefix(t)
    node = @root
    prefix = ""
    while Hash.size(TrieNode.get_children(node)) == 1 && TrieNode.get_terminal(node) == false
      c, child = Array.first(Hash.to_a(TrieNode.get_children(node)))
      prefix += c
      node = child
    end
    prefix
  end

  def delete(t, word)
    return false unless include?(t, word)
    node = @root
    TrieNode.set_pass(node, TrieNode.get_pass(node) - 1)
    String.each_char(word) do |c|
      kids = TrieNode.get_children(node)
      child = kids[c]
      TrieNode.set_pass(child, TrieNode.get_pass(child) - 1)
      if TrieNode.get_pass(child) == 0
        Hash.delete(kids, c)
        @words -= 1
        return true
      end
      node = child
    end
    TrieNode.set_terminal(node, false)
    TrieNode.set_freq(node, 0)
    @words -= 1
    true
  end
end

corpus = "the quick brown fox jumps over the lazy dog then the fox thinks the dog " \
         "is there to theorize about quick quiet quilts and the quiz"
trie = Trie.create
Array.each(String.split(corpus, " ")) { |w| Trie.insert(trie, w, 1) }
Trie.insert(trie, "theory", 3)
puts("distinct words: #{Trie.get_words(trie)}")
Array.each(Array["th", "qui", "do", "x", ""]) do |pre|
  puts("#{Kernel.inspect(pre)}: #{Trie.count_prefix(trie, pre)} words, top #{Array.join(Trie.complete(trie, pre, 3), "/")}")
end
puts("contains 'the': #{Trie.include?(trie, "the")}, 'thé': #{Trie.include?(trie, "thé")}, 'theor': #{Trie.include?(trie, "theor")}")
Array.each(Array["the", "theorize", "quilts", "zebra"]) do |w|
  ok = Trie.delete(trie, w)
  puts("delete #{w}: #{ok} -> th* = #{Array.join(Trie.complete(trie, "th", 10), ",")}")
end
puts("words now: #{Trie.get_words(trie)}, q-prefix: #{Trie.count_prefix(trie, "q")}")

tags = Trie.create
Array.each(Array["interview", "internet", "interval", "internal", "interstate"]) { |w| Trie.insert(tags, w, 1) }
puts("common prefix: #{Trie.longest_common_prefix(tags)}")
Trie.insert(tags, "inter", 1)
puts("common prefix after 'inter': #{Trie.longest_common_prefix(tags)}")
Trie.insert(tags, "intake", 1)
puts("common prefix after 'intake': #{Trie.longest_common_prefix(tags)}")
