Rails.application.configure(:production) do |config|
  config.Rails::Application::Configuration.enable_reloading = false
  config.Rails::Application::Configuration.eager_load = true
  config.Rails::Application::Configuration.consider_all_requests_local = false
  config.Rails::Application::Configuration.action_controller[:perform_caching] = true
  config.Rails::Application::Configuration.assume_ssl = true
  config.Rails::Application::Configuration.force_ssl = true
  config.Rails::Application::Configuration.log_tags = Any[:request_id]
  config.Rails::Application::Configuration.log_level = String.to_sym(ENV.fetch("RAILS_LOG_LEVEL", "info"))
  config.Rails::Application::Configuration.silence_healthcheck_path = "/up"
  config.Rails::Application::Configuration.i18n[:fallbacks] = true
end
