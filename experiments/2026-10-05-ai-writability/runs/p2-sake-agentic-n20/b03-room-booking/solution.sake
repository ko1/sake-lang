class Booking
  attr_reader id, room, day, s, e, who
end

def days = Array["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

def hhmm(m) = format("%02d:%02d", m / 60, m % 60)

def parse_time(t)
  m = String.match(t, /\A(\d\d):(\d\d)\z/)
  return nil if m == nil
  c = MatchData.captures(m)
  h = String.to_i(c[0])
  mi = String.to_i(c[1])
  return nil if mi >= 60 || mi % 15 != 0
  v = h * 60 + mi
  return nil if v < 480 || v > 1200
  v
end

def overlaps(b, room, day, s, e)
  Booking.room(b) == room && Booking.day(b) == day && Booking.s(b) < e && s < Booking.e(b)
end

bookings = Array[]
next_id = 1
lines = String.split(IO.read(IO.stdin), "\n")
Array.each_with_index(lines) do |line, i|
  n = i + 1
  f = String.split(line, " ")
  next if Array.empty?(f)
  cmd = f[0]
  unless cmd == "BOOK" || cmd == "CANCEL" || cmd == "FREE"
    puts("line #{n}: error: unknown command")
    next
  end
  want = cmd == "BOOK" ? 5 : (cmd == "CANCEL" ? 2 : 4)
  if Array.size(f) != want
    puts("line #{n}: error: wrong field count")
    next
  end
  if cmd == "CANCEL"
    unless String.match?(f[1], /\A\d+\z/)
      puts("line #{n}: error: bad id")
      next
    end
    id = String.to_i(f[1])
    found = Array.find(bookings) { |b| Booking.id(b) == id }
    if found == nil
      puts("NO BOOKING ##{id}")
    else
      Array.delete(bookings, found)
      puts("CANCELLED ##{id}")
    end
    next
  end
  room = f[1]
  unless String.match?(room, /\A[A-Z0-9]{1,8}\z/)
    puts("line #{n}: error: bad room")
    next
  end
  day = f[2]
  unless Array.include?(days, day)
    puts("line #{n}: error: bad day")
    next
  end
  if cmd == "FREE"
    unless String.match?(f[3], /\A\d+\z/) && String.to_i(f[3]) > 0 && String.to_i(f[3]) % 15 == 0
      puts("line #{n}: error: bad duration")
      next
    end
    mins = String.to_i(f[3])
    t = 480
    ans = nil
    while ans == nil && t + mins <= 1200
      if Array.none?(bookings) { |b| overlaps(b, room, day, t, t + mins) }
        ans = t
      else
        t += 15
      end
    end
    if ans == nil
      puts("FULL #{room} #{day}")
    else
      puts("FREE #{room} #{day} #{hhmm(ans)}-#{hhmm(ans + mins)}")
    end
    next
  end
  parts = String.split(f[3], "-")
  s = nil
  e = nil
  if Array.size(parts) == 2
    s = parse_time(parts[0])
    e = parse_time(parts[1])
  end
  if s == nil || e == nil || s >= e
    puts("line #{n}: error: bad time")
    next
  end
  who = f[4]
  unless String.match?(who, /\A[a-z]{1,12}\z/)
    puts("line #{n}: error: bad name")
    next
  end
  hits = Array.select(bookings) { |b| overlaps(b, room, day, s, e) }
  if !Array.empty?(hits)
    c = Array.min_by(hits) { |b| Booking.s(b) }
    puts("CONFLICT #{room} #{day} with ##{Booking.id(c)} (#{Booking.who(c)} #{hhmm(Booking.s(c))}-#{hhmm(Booking.e(c))})")
  elsif Array.count(bookings) { |b| Booking.who(b) == who && Booking.day(b) == day } >= 3
    puts("LIMIT #{who} #{day}")
  else
    Array.push(bookings, Booking.new(next_id, room, day, s, e, who))
    puts("OK ##{next_id} #{room} #{day} #{hhmm(s)}-#{hhmm(e)} #{who}")
    next_id += 1
  end
end
puts("== schedule ==")
if Array.empty?(bookings)
  puts("(none)")
else
  sorted = Array.sort_by(bookings) { |b| [Array.index(days, Booking.day(b)), Booking.room(b), Booking.s(b)] }
  Array.each(sorted) do |b|
    puts(format("%s %-8s %s-%s #%d %s", Booking.day(b), Booking.room(b), hhmm(Booking.s(b)), hhmm(Booking.e(b)), Booking.id(b), Booking.who(b)))
  end
end
puts("== usage ==")
if Array.empty?(bookings)
  puts("(none)")
else
  tot = Hash.new(0)
  Array.each(bookings) { |b| tot[Booking.room(b)] += Booking.e(b) - Booking.s(b) }
  Array.each(Array.sort(Hash.keys(tot))) do |r|
    puts(format("%-8s %dh%02dm", r, tot[r] / 60, tot[r] % 60))
  end
end
