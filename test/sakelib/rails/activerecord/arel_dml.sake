require "rails/activerecord/active_record"

# INSERT, UPDATE and DELETE statements from Arel's managers, as SQL for SQLite
Arel::Table.set_engine(ActiveRecord::ConnectionAdapters::SQLite3Adapter.new(Hash.of(adapter: "sqlite3", database: ":memory:")))
users = Arel::Table.new(:users)
posts = Arel::Table.new(:posts)

puts("-- insert")
im = Arel::InsertManager.new
Arel::InsertManager.insert(im, Any[[users[:name], "ann"], [users[:age], 31], [users[:admin], false], [users[:note], nil]])
puts(Arel::InsertManager.to_sql(im))
im = Arel::InsertManager.new(users)
Array.push(Arel::InsertManager.columns(im), users[:name])
Array.push(Arel::InsertManager.columns(im), users[:age])
Arel::InsertManager.set_values(im, Arel::InsertManager.create_values_list(im, Array[Any["ann", 31], Any["bob", Arel.sql("DEFAULT")]]))
puts(Arel::InsertManager.to_sql(im))
im = Arel::InsertManager.new(users)
Array.push(Arel::InsertManager.columns(im), users[:name])
Arel::InsertManager.select(im, Arel::Table.project(posts, posts[:title]).Arel::SelectManager.where(Arel::Attribute.lt(posts[:id], 3)))
puts(Arel::InsertManager.to_sql(im))
im = Arel::InsertManager.new(users)
Arel::InsertManager.insert(im, "DEFAULT VALUES")
puts(Arel::InsertManager.to_sql(im))

puts("-- update")
um = Arel::UpdateManager.new(users)
Arel::UpdateManager.set(um, Any[[users[:name], "x"], [users[:age], users[:age] + 1]]).Arel::UpdateManager.where(Arel::Attribute.eq(users[:id], 1))
puts(Arel::UpdateManager.to_sql(um))
um = Arel::UpdateManager.new(users)
Arel::UpdateManager.set(um, Arel.sql("age = age + 1")).Arel::UpdateManager.where(Arel::Attribute.lt(users[:age], 10)).order(Arel::Attribute.asc(users[:id])).take(3)
puts(Arel::UpdateManager.to_sql(um))
um = Arel::UpdateManager.new(users)
Arel::UpdateManager.set(um, Any[[users[:flag], true]]).Arel::UpdateManager.where(Arel::Attribute.gt(users[:age], 1)).take(2)
Arel::UpdateManager.set_key(um, users[:id])
puts(Arel::UpdateManager.to_sql(um))
sm = Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel::Attribute.gt(users[:age], 20)).order(Arel::Attribute.desc(users[:id])).take(5)
um = Arel::SelectManager.compile_update(sm, Any[[users[:flag], false]], users[:id])
puts(Arel::UpdateManager.to_sql(um))
joined = Arel::Table.join(users, posts).Arel::SelectManager.on(Arel::Attribute.eq(posts[:user_id], users[:id])).where(Arel::Attribute.eq(posts[:title], "x"))
um = Arel::SelectManager.compile_update(joined, Any[[users[:flag], true]], users[:id])
puts(Arel::UpdateManager.to_sql(um))

puts("-- delete")
dm = Arel::DeleteManager.new(users)
Arel::DeleteManager.where(dm, Arel::Attribute.eq(users[:id], 3))
puts(Arel::DeleteManager.to_sql(dm))
dm = Arel::DeleteManager.new(users)
Arel::DeleteManager.where(dm, Arel::Attribute.lt(users[:age], 18)).Arel::DeleteManager.order(Arel::Attribute.desc(users[:age])).take(10)
Arel::DeleteManager.set_key(dm, users[:id])
puts(Arel::DeleteManager.to_sql(dm))
dm = Arel::Table.project(users, Arel.star).Arel::SelectManager.where(Arel::Attribute.matches(users[:name], "a%")).compile_delete
puts(Arel::DeleteManager.to_sql(dm))
dm = Arel::SelectManager.compile_delete(joined, users[:id])
puts(Arel::DeleteManager.to_sql(dm))
