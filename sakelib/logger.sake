# Logger: Ruby's logger. The device is an IO (IO.stdout, IO.stderr, a File.open), a file path (String,
# opened for appending at the first entry), or nil (no output).
# The formatter is a format string over the keys severity, datetime, progname, msg
# (`Kernel.format` with a Hash), since a block cannot be stored.

# Logger.new(dev, level, progname, formatter, datetime_format): the fields after dev are Ruby's keyword
# arguments (level:, progname:, ...) in their order, since `new` takes the fields positionally.
class Logger
  attr_reader logdev, level = 0
  attr_accessor progname = nil, formatter = nil, datetime_format = nil
  attr_reader closed = false
  attr_accessor fixed_time = nil
  attr_reader io = nil

  # As Ruby's initialize: the device must be an IO, a path, or nil, and the level is coerced (level=).
  def initialize(l)
    @logdev => IO | String | nil
    @level = Logger.coerce_level(@level)
  end
  # Ruby's Logger::DEBUG ... Logger::UNKNOWN (Sake has no value constants).
  def DEBUG = 0
  def INFO = 1
  def WARN = 2
  def ERROR = 3
  def FATAL = 4
  def UNKNOWN = 5

  # Ruby's Logger::Formatter::Format without the pid (Sake has no Process.pid).
  def default_format = "%.1<severity>s, [%<datetime>s] %5<severity>s -- %<progname>s: %<msg>s\n"
  def default_datetime_format = "%Y-%m-%dT%H:%M:%S.%6N"
  def prog_name = "logger.sake/v1.7.0"

  # Accepts an Integer, or a Symbol or String naming a level (:warn, "WARN"), as Ruby's level=.
  def set_level(l, v)
    @level = Logger.coerce_level(v)
  end

  def coerce_level(v)
    case v
    in Integer then v
    in Symbol then Logger.coerce_level(Symbol.to_s(v))
    in String
      case String.downcase(v)
      in "debug" then 0
      in "info" then 1
      in "warn" then 2
      in "error" then 3
      in "fatal" then 4
      in "unknown" then 5
      else raise ArgumentError, "invalid log level: #{v}"
      end
    end
  end

  def debug?(l) = @level <= 0
  def info?(l) = @level <= 1
  def warn?(l) = @level <= 2
  def error?(l) = @level <= 3
  def fatal?(l) = @level <= 4

  def debug!(l) = @level = 0
  def info!(l) = @level = 1
  def warn!(l) = @level = 2
  def error!(l) = @level = 3
  def fatal!(l) = @level = 4

  # Ruby's info(progname = nil) { msg }: without a block the argument is the message, logged with the
  # logger's progname; with one, the block (run only when the level passes) gives the message.
  def debug(l, progname = nil, &b) = add(l, 0, nil, progname, &b)
  def info(l, progname = nil, &b) = add(l, 1, nil, progname, &b)
  def warn(l, progname = nil, &b) = add(l, 2, nil, progname, &b)
  def error(l, progname = nil, &b) = add(l, 3, nil, progname, &b)
  def fatal(l, progname = nil, &b) = add(l, 4, nil, progname, &b)
  def unknown(l, progname = nil, &b) = add(l, 5, nil, progname, &b)

  # Ruby's add(severity, message = nil, progname = nil) { msg }: with message nil, the block's value,
  # or else progname, is the message.
  def add(l, severity, message = nil, progname = nil)
    sev = severity == nil ? 5 : severity
    return true if sev < @level
    prog = progname == nil ? @progname : progname
    msg = message
    if msg == nil
      if block_given?
        msg = yield
      else   # as Ruby: the progname is the message, and the logger's progname is shown
        msg = prog
        prog = @progname
      end
    end
    write(l, format_message(l, format_severity(sev), now(l), prog, msg))
    true
  end

  def log(l, severity, message = nil, progname = nil, &b) = add(l, severity, message, progname, &b)

  # Ruby's <<: writes msg as is.
  def <<(l, msg)
    write(l, msg)
    String.bytesize(msg)
  end

  # Ruby's with_level(level) { }: the level is changed only while the block runs.
  def with_level(l, v)
    saved = @level
    @level = Logger.coerce_level(v)
    begin
      yield
    ensure
      @level = saved
    end
  end

  # Closes the file the logger opened for a path; an IO given to new is left open.
  def close(l)
    f = @io
    IO.close(f) if f != nil
    @closed = true
    nil
  end

  def format_severity(sev)
    case sev
    in 0 then "DEBUG"
    in 1 then "INFO"
    in 2 then "WARN"
    in 3 then "ERROR"
    in 4 then "FATAL"
    else "ANY"
    end
  end

  def now(l)
    t = @fixed_time
    t == nil ? Time.now : t
  end

  def format_datetime(l, time)
    f = @datetime_format
    Time.strftime(time, f == nil ? Logger.default_datetime_format : f)
  end

  def format_message(l, severity, time, progname, msg)
    f = @formatter
    text = (msg in String) ? msg : Kernel.inspect(msg)
    dt = format_datetime(l, time)
    Kernel.format(f == nil ? Logger.default_format : f, Hash[severity: severity, datetime: dt, progname: progname, msg: text])
  end

  def write(l, s)
    if @closed
      Kernel.warn("log writing failed. closed stream")   # Ruby's message, on stderr
      return nil
    end
    dev = @logdev
    case dev
    in nil then nil
    in String
      f = file(l, dev)
      IO.write(f, s)
      IO.flush(f)   # Ruby's log file is sync = true
    else IO.write(dev, s)
    end
    nil
  end

  # The file of a path device, opened for appending at the first entry. As Ruby, a new file starts
  # with a header line.
  def file(l, path)
    f = @io
    return f if f != nil
    created = !File.exist?(path)
    f = File.open(path, "a")
    IO.write(f, "# Logfile created on #{Time.now} by #{Logger.prog_name}\n") if created
    @io = f
  end
end
