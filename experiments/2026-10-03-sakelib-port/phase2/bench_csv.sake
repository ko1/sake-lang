# csv: parse 2000 rows of 5 fields, two of them quoted (one with "" and a comma).
require "csv"
lines = Array[]
Range.each(0...2000) do |i|
  Array.push(lines, "#{i},name#{i},\"say \"\"hi\"\", #{i}\",3.5,\"tail\"\n")
end
text = Array.join(lines)
rows = CSV.parse(text)
p([Array.size(rows), rows[1999]])
