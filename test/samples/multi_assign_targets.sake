# Multiple assignment can also write Array elements and fields: swaps need no temporary.
a = Array[3, 1, 2]
a[0], a[1] = a[1], a[0]
p(a)
i = 0
j = 2
a[i], a[j] = a[j], a[i]
p(a)
Q = Struct.new(:done, :rest)
class Q
  def split(q, xs)
    @done, @rest = Array.partition(xs) { |x| x > 1 }
    q
  end
end
p(Q.split(Q.new(nil, nil), Array[1, 2, 3]))
x, y = 1, 2
x, y = y, x
p([x, y])
