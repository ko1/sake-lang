def grade(t)
  if t >= 900
    "A"
  elsif t >= 800
    "B"
  elsif t >= 700
    "C"
  elsif t >= 600
    "D"
  else
    "F"
  end
end

def half_up(x) = Rational.floor(x * 10 + Rational(1, 2))

def fmt1(t) = "#{t / 10}.#{t % 10}"

lines = IO.readlines(IO.stdin)
weights = Hash[]
students = Hash[]
missing = Hash.new(0)
errs = Array[]

Array.each_with_index(lines) do |raw, idx|
  n = idx + 1
  line = String.strip(raw)
  next if String.empty?(line) || String.start_with?(line, "#")
  f = String.split(line)
  if Array.size(f) == 3 && f[0] == "weight"
    cat = f[1]
    ws = f[2]
    if !String.match?(ws, /\A\d+\z/) || String.to_i(ws) < 1 || String.to_i(ws) > 100
      Array.push(errs, "line #{n}: bad weight #{ws}")
    elsif Hash.key?(weights, cat)
      Array.push(errs, "line #{n}: duplicate category #{cat}")
    else
      weights[cat] = String.to_i(ws)
    end
  elsif Array.size(f) != 3
    Array.push(errs, "line #{n}: bad format")
  else
    st = f[0]
    cat = f[1]
    sc = f[2]
    if !Hash.key?(weights, cat)
      Array.push(errs, "line #{n}: unknown category #{cat}")
    else
      m = String.match(sc, /\A(\d+|EX|-)\/(\d+)\z/)
      good = false
      if m
        mm = String.to_i(m[2])
        if mm > 0
          if m[1] == "EX" || m[1] == "-"
            good = true
          elsif String.to_i(m[1]) <= mm
            good = true
          end
        end
      end
      if !good
        Array.push(errs, "line #{n}: bad score #{sc}")
      else
        m => MatchData
        students[st] = Hash[] unless Hash.key?(students, st)
        cats = students[st]
        cats[cat] = Array[0, 0] unless Hash.key?(cats, cat)
        missing[st] += 0
        mm = String.to_i(m[2])
        if m[1] != "EX"
          acc = cats[cat]
          acc[1] += mm
          if m[1] == "-"
            missing[st] += 1
          else
            acc[0] += String.to_i(m[1])
          end
        end
      end
    end
  end
end

# rows: [name, t (rounded tenths) or nil, exact pct or nil, missing]
rows = Tuple[]
total = 0r
cnt = 0
Hash.each(students) do |name, cats|
  num = 0r
  den = 0
  Hash.each(cats) do |cat, acc|
    if acc[1] > 0
      w = weights[cat]
      num += Rational(w * acc[0], acc[1])
      den += w
    end
  end
  if den > 0
    pct = num * 100 / den
    total += pct
    cnt += 1
    Array.push(rows, [name, half_up(pct), true, missing[name]])
  else
    Array.push(rows, [name, 0, false, missing[name]])
  end
end

Array.each(errs) { |e| puts(e) }

names = Array.map(rows) { |r| String.size(r[0]) }
w = Array.max(Array.push(names, 7))
puts(String.ljust("Student", w) + "  Score  G  Missing")
sorted = Array.sort_by(rows) { |r| r[2] ? [0, -r[1], r[0]] : [1, 0, r[0]] }
Array.each(sorted) do |r|
  if r[2]
    sc = String.rjust(fmt1(r[1]), 5)
    g = grade(r[1])
  else
    sc = "  n/a"
    g = "-"
  end
  puts(String.ljust(r[0], w) + "  " + sc + "  " + g + "  " + String.rjust(Integer.to_s(r[3]), 7))
end
if cnt > 0
  puts("class average: #{fmt1(half_up(total / cnt))}")
else
  puts("class average: n/a")
end
