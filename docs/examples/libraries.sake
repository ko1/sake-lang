# require "json" reads json.sake next to this file, or else Sake's library sakelib/json.sake.
require "json"
require "base64"

data = JSON.parse("{\"name\": \"Sake\", \"tags\": [\"ruby\", \"types\"]}", symbolize_names: true)
p(data)
puts(JSON.generate(Hash.of(ok: true, n: Any[1, 2])))
puts(JSON.pretty_generate(Hash.of("a" => Any[1, 2])))
p(Base64.strict_encode64("Sake"))
p(ARGV)             # the program's arguments: bin/sake libraries.sake a b
warn("a warning goes to stderr")
