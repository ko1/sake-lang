def money(c) = format("%d.%02d", c / 100, c % 100)

def part(r, first, step)
  return 0 if r == 0
  return first if r <= 60
  first + step * ((r - 60 + 29) / 30)
end

def main
  lines = IO.readlines(IO.stdin)
  hd = String.split(String.strip(lines[0] || ""))
  first = String.to_i(hd[1] || "0")
  step = String.to_i(hd[2] || "0")
  cap = String.to_i(hd[3] || "0")
  grace = String.to_i(hd[4] || "0")
  inside = Hash.new
  exits = Hash.new(0)
  rev = Hash.new(0)
  lastmin = -1
  day = 0
  n = 1
  Array.each(Array.drop(lines, 1)) do |raw|
    n += 1
    line = String.chomp(raw)
    next if String.strip(line) == ""
    m = String.match(line, /\A(\d\d):(\d\d) +(IN|OUT) +([A-Z0-9]{1,8})\z/)
    ok = m != nil
    if ok
      hh = String.to_i(m[1] || "0")
      mm = String.to_i(m[2] || "0")
      ok = hh <= 23 && mm <= 59
    end
    if !ok || m == nil
      puts("line #{n}: invalid")
      next
    end
    cur = String.to_i(m[1] || "0") * 60 + String.to_i(m[2] || "0")
    day += 1 if cur < lastmin
    lastmin = cur
    abs = day * 1440 + cur
    kind = m[3]
    plate = m[4] || ""
    if kind == "IN"
      if Hash.key?(inside, plate)
        puts("line #{n}: #{plate} already inside")
      else
        inside[plate] = abs
      end
    else
      t0 = inside[plate]
      if t0 == nil
        puts("line #{n}: #{plate} not inside")
      else
        Hash.delete(inside, plate)
        stay = abs - t0
        fee = 0
        if stay > grace
          fee = (stay / 1440) * cap + Integer.clamp(part(stay % 1440, first, step), 0, cap)
        end
        exits[plate] += 1
        rev[plate] += fee
        puts("#{plate} #{stay / 60}:#{String.rjust(Integer.to_s(stay % 60), 2, "0")} #{money(fee)}")
      end
    end
  end
  puts("--- summary")
  plates = Array.sort_by(Hash.keys(exits)) { |k| [-rev[k], k] }
  te = 0
  tr = 0
  Array.each(plates) do |k|
    puts("#{k} #{exits[k]} #{money(rev[k])}")
    te += exits[k]
    tr += rev[k]
  end
  puts("total #{te} #{money(tr)}")
  ins = Array.sort(Hash.keys(inside))
  puts("inside: " + (Array.empty?(ins) ? "none" : Array.join(ins, ", ")))
end
main
