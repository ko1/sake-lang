# Port of actionpack-8.1.3/lib/action_dispatch/testing/test_response.rb (partial: parsed_body is not cached)
#
# Rails' TestResponse < Response adds parsed_body. `class B < A` would paste all of Response into a second type
# (and its Buffer would then hold either), so a test response is a Response and TestResponse the functions over it.

require "../http/response"
require "request_encoder"

module ActionDispatch
  module TestResponse
    module_function

    def from_response(status, headers, body) = Response.new(status, headers, body)

    # parsed_body: JSON.parse of a JSON body (a Hash or an Array), else the body String
    def parsed_body(res) = RequestEncoder.parse(response_parser(res), Response.body(res))
    def response_parser(res) = RequestEncoder.parser(Response.media_type(res))
  end
end
