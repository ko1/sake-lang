# BEGIN / COMMIT / END / ROLLBACK (spec 5.5). The snapshot itself lives in Database.
module Transactions
  module_function

  def run(db, st)
    case Transaction.kind(st)
    in :begin then Database.begin_transaction(db)
    in :commit then Database.commit(db)
    in :rollback then Database.rollback(db)
    end
  end
end
