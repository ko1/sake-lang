# Port of actionpack-8.1.3/lib/action_controller/metal/exceptions.rb (partial: no DidYouMean corrections on UrlGenerationError)
#
# Rails' exceptions all inherit from ActionControllerError. Sake has no inheritance (`class B < A` is a copy), so
# ActionControllerError is a module that each exception includes: `rescue ActionController::ActionControllerError`
# catches them all, as in Rails. (Written by the ActionDispatch part, which raises them first.)

module ActionController
  module ActionControllerError
  end

  class BadRequest < StandardError
    include ActionControllerError
  end
  class RenderError < StandardError
    include ActionControllerError
  end
  class RoutingError < StandardError
    attr_reader failures
    include ActionControllerError
  end
  class UrlGenerationError < StandardError
    attr_reader routes, route_name, method_name
    include ActionControllerError
  end
  class MethodNotAllowed < StandardError
    include ActionControllerError
  end
  class NotImplemented < StandardError
    include ActionControllerError
  end
  class MissingFile < StandardError
    include ActionControllerError
  end
  class SessionOverflowError < StandardError
    include ActionControllerError
  end
  class UnknownHttpMethod < StandardError
    include ActionControllerError
  end
  class UnknownFormat < StandardError
    include ActionControllerError
  end
  class RespondToMismatchError < StandardError
    include ActionControllerError
  end
  class MissingExactTemplate < StandardError
    attr_reader controller, action_name
    include ActionControllerError
  end
  class TooManyRequests < StandardError
    include ActionControllerError
  end
end
