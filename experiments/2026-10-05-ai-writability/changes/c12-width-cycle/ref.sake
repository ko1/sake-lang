# Full-justification text layout inside a frame.
def pieces(word, width)
  out = String[]
  while String.size(word) > width
    Array.push(out, "#{String.[](word, 0, width - 1)}-")
    word = String.[](word, width - 1, String.size(word))
  end
  Array.push(out, word)
end

def sizes(ws) = Array.sum(ws) { |w| String.size(w) }

def justify(ws, width)
  gaps = Array.size(ws) - 1
  extra = width - sizes(ws)
  out = ""
  Array.each_with_index(ws) do |w, j|
    out += w
    out += " " * (extra / gaps + (j < extra % gaps ? 1 : 0)) if j < gaps
  end
  out
end

def layout(words, width)
  lines = Array[]
  cur = String[]
  len = 0
  Array.each(words) do |w|
    if !Array.empty?(cur) && len + 1 + String.size(w) > width
      Array.push(lines, cur)
      cur = String[]
      len = 0
    end
    len += Array.empty?(cur) ? String.size(w) : 1 + String.size(w)
    Array.push(cur, w)
  end
  Array.push(lines, cur) unless Array.empty?(cur)
  out = String[]
  Array.each_with_index(lines) do |ws, i|
    if i == Array.size(lines) - 1 || Array.size(ws) == 1
      Array.push(out, Array.join(ws, " "))
    else
      Array.push(out, justify(ws, width))
    end
  end
  out
end

def main
  first = gets
  ws = first ? String.split(first) : String[]
  ok = !Array.empty?(ws) && Array.all?(ws) { |w| String.match?(w, /\A\d+\z/) && Range.cover?(2..80, String.to_i(w)) }
  unless ok
    puts("invalid width")
    return
  end
  widths = Array.map(ws) { |w| String.to_i(w) }
  frame = Array.max(widths)
  frame => Integer

  paras = Array[String[]]
  while (line = gets)
    ws = Array.reject(String.split(String.chomp(line), /[ \t]+/)) { |s| String.empty?(s) }
    last = Array.fetch(paras, -1)
    if Array.empty?(ws)
      Array.push(paras, String[]) unless Array.empty?(last)
    else
      Array.concat(last, ws)
    end
  end
  Array.pop(paras) if Array.empty?(Array.fetch(paras, -1))

  words = Array.sum(paras) { |ws| Array.size(ws) }
  border = "+#{"-" * frame}+"
  puts(border)
  count = 0
  Array.each_with_index(paras) do |ws, i|
    puts("|#{" " * frame}|") if i > 0
    width = Array.fetch(widths, i % Array.size(widths))
    Array.each(layout(Array.flat_map(ws) { |x| pieces(x, width) }, width)) do |l|
      puts("|#{String.ljust(l, frame)}|")
      count += 1
    end
  end
  puts(border)
  puts("paragraphs: #{Array.size(paras)}, lines: #{count}, words: #{words}")
end

main
