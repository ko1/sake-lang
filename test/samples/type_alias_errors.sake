# Errors of type aliases: a clash in the namespace, a right-hand side that is not a type, a cycle, and a
# class defined through an alias. A value constant written as a constant path keeps its error.
module Net
  class Conn
  end
  module Proto
  end
  Conn = Proto                # clash: Net::Conn is a class
  Link = Proto
  Link = Conn                 # clash: Net::Link is already an alias
  Socket = Net::Con           # not a type (with a spelling hint)
end

A = B                         # a cycle
B = A
Pi = Math::PI                 # a value constant, as before
Args = ARGV
Str = String
class Str::Buf                # a class defined through an alias
end
String = Net::Conn            # clash with a built-in type
Net::Link.open                # messages name the type; the hint names the alias
