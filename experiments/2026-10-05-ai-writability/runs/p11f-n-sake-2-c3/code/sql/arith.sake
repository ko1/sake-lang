# Arithmetic + - * / % on SQL values (1.8).
module Arith
  module_function

  # NULL if either operand is NULL; INTEGER arithmetic for two integers, REAL otherwise.
  def apply(kind, a, b)
    return nil if a == nil || b == nil
    x = Values.to_number(a)
    y = Values.to_number(b)
    case x
    in Integer
      case y
      in Integer then integers(kind, x, y)
      else reals(kind, Integer.to_f(x), Arithmetic.to_f(y))
      end
    else reals(kind, x, Arithmetic.to_f(y))
    end
  end

  # `/` truncates toward zero and `%` takes the sign of the left operand; by zero gives NULL.
  def integers(kind, x, y)
    case kind
    in :add then x + y
    in :sub then x - y
    in :mul then x * y
    in :div
      return nil if y == 0
      q = Integer.abs(x) / Integer.abs(y)
      (x < 0) != (y < 0) ? -q : q
    else
      return nil if y == 0
      r = Integer.abs(x) % Integer.abs(y)
      x < 0 ? -r : r
    end
  end

  # `%` truncates both operands to integers and gives the integer remainder as a REAL.
  def reals(kind, x, y)
    case kind
    in :add then x + y
    in :sub then x - y
    in :mul then x * y
    in :div
      y == 0.0 ? nil : x / y
    else
      m = integers(:mod, Float.truncate(x), Float.truncate(y))
      m == nil ? nil : Integer.to_f(m)
    end
  end
end
