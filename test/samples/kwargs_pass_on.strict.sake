# `g(**opts)`: the keywords a function collected with its own `**opts` go on to g's keywords by name,
# each keeping its own type (here sep: String and headers: Boolean, not one union of both).
def parse(s, sep: ",", headers: false)
  fields = String.split(s, sep)
  headers ? Array.map(fields) { String.upcase(_1) } : fields
end
def read(s, **opts) = parse(s, **opts)
p read("a,b")
p read("a;b", sep: ";")
p read("a;b", sep: ";", headers: true)

# A keyword written before `**opts` is a default that opts overrides; one written after overrides opts.
def semi(s, **opts) = parse(s, sep: ";", **opts)
def pipe(s, **opts) = parse(s, **opts, sep: "|")
p semi("a;b")
p semi("a,b", sep: ",")
p pipe("a|b", sep: ",")

# A g with its own `**` gets the keys it has no parameter for.
def tag(name, id: nil, **attrs) = "#{name} #{Kernel.inspect(id)} #{attrs}"
def div(**opts) = tag("div", class: "box", **opts)
p div
p div(id: 3, class: "wide", title: "t")

# Passed on twice: each key keeps its type through both calls.
def outer(s, **opts) = read(s, **opts)
p outer("x;y", sep: ";", headers: true)
