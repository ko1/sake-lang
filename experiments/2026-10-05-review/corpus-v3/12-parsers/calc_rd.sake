class ParseError < Exception
  attr_reader pos
end

class UnknownName < Exception
  attr_reader name
end

class Calc
  attr_reader src, env, pos = 0

  def skip_ws(c)
    @pos += 1 while @src[@pos] == " "
  end

  def peek(c)
    skip_ws(c)
    @src[@pos]
  end

  def expect(c, ch)
    got = peek(c)
    raise ParseError.new("expected '#{ch}' but got #{got ? "'#{got}'" : "end"}", @pos) unless got == ch
    @pos += 1
  end

  def at_end?(c) = peek(c) == nil

  def statement(c)
    skip_ws(c)
    if (m = String.match(@src[@pos..], /\A([a-z_][a-z0-9_]*)\s*=(?!=)/))
      name = m[1]
      @pos += String.size(MatchData.to_s(m))
      v = expr(c)
      @env[name] = v
      return v
    end
    expr(c)
  end

  def expr(c)
    v = term(c)
    while true
      case peek(c)
      in "+"
        @pos += 1
        v += term(c)
      in "-"
        @pos += 1
        v -= term(c)
      else
        break
      end
    end
    v
  end

  def term(c)
    v = power(c)
    while true
      case peek(c)
      in "*"
        @pos += 1
        v *= power(c)
      in "/"
        @pos += 1
        v /= power(c)
      in "%"
        @pos += 1
        v %= power(c)
      else
        break
      end
    end
    v
  end

  def power(c)
    base = unary(c)
    if peek(c) == "^"
      @pos += 1
      return base ** power(c)
    end
    base
  end

  def unary(c)
    if peek(c) == "-"
      @pos += 1
      return -unary(c)
    end
    primary(c)
  end

  def primary(c)
    ch = peek(c)
    raise ParseError.new("unexpected end of input", @pos) if ch == nil
    if ch == "("
      @pos += 1
      v = expr(c)
      expect(c, ")")
      return v
    end
    rest = @src[@pos..]
    if (m = String.match(rest, /\A\d+(\.\d+)?/))
      text = MatchData.to_s(m)
      @pos += String.size(text)
      return m[1] ? Float(text) : Integer(text)
    end
    m = String.match(rest, /\A[a-z_][a-z0-9_]*/)
    raise ParseError.new("unexpected '#{ch}'", @pos) unless m
    name = MatchData.to_s(m)
    @pos += String.size(name)
    if peek(c) == "("
      @pos += 1
      args = Array[expr(c)]
      while peek(c) == ","
        @pos += 1
        Array.push(args, expr(c))
      end
      expect(c, ")")
      return call(c, name, args)
    end
    v = @env[name]
    raise UnknownName.new("unknown variable", name) if v == nil
    v
  end

  def call(c, name, args)
    case name
    in "max" then Array.max(args)
    in "min" then Array.min(args)
    in "abs" then (Integer|Float).abs(args[0])
    in "sqrt" then Math.sqrt(args[0])
    else raise UnknownName.new("unknown function", name)
    end
  end
end

def evaluate(line, env)
  c = Calc.new(line, env)
  v = Calc.statement(c)
  raise ParseError.new("trailing input", Calc.pos(c)) unless Calc.at_end?(c)
  v
end

def show(v) = (v in Float) ? Float.to_s(Float.round(v, 6)) : Integer.to_s(v)

env = Hash["pi" => 3.141592653589793]
lines = Array[
  "1 + 2 * 3",
  "(1 + 2) * 3",
  "2 ^ 3 ^ 2",
  "-4 + 10 / 3",
  "17 % 5 * -2",
  "r = 2.5",
  "area = pi * r ^ 2",
  "area / 2",
  "max(3, 7 * 2, 9) - min(4, 1)",
  "sqrt(16) + abs(-3)",
  "x = (1 + 2",
  "4 / (2 - 2)",
  "y * 2",
  "foo(1)",
  "3 + * 4",
  "1 2",
  "count = count2 = 5"
]

Array.each_with_index(lines) do |line, i|
  v = evaluate(line, env)
  puts(format("%2d  %-30s => %s", i + 1, line, show(v)))
rescue ParseError => e
  puts(format("%2d  %-30s !! parse error at %d: %s", i + 1, line, ParseError.pos(e), Exception.message(e)))
rescue UnknownName => e
  puts(format("%2d  %-30s !! %s '%s'", i + 1, line, Exception.message(e), UnknownName.name(e)))
rescue ZeroDivisionError
  puts(format("%2d  %-30s !! division by zero", i + 1, line))
end

puts("variables:")
Array.each(Array.sort(Hash.keys(env))) { |k| puts("  #{k} = #{show(env[k])}") }
