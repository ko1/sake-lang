Num = Struct.new(:value)
Var = Struct.new(:name)
BinOp = Struct.new(:op, :left, :right)
ParseError = Exception.new(:pos)
UnboundError = Exception.new(:name)

class Parser < {reader: [tokens], accessor: [pos]}
  def tokenize(src)
    toks = String.scan(src, /\d+(?:\.\d+)?|[a-z]+|[-+*\/^()]/)
    Parser.new(toks, 0)
  end

  def peek(ps) = @tokens[@pos]

  def advance(ps)
    t = @tokens[@pos]
    @pos += 1
    t
  end

  def expect(ps, t)
    got = advance(ps)
    raise ParseError.new("expected #{t} but got #{got == nil ? "end" : got}", @pos) unless got == t
  end

  def parse(src)
    ps = tokenize(src)
    e = expr(ps)
    raise ParseError.new("trailing #{peek(ps)}", Parser.get_pos(ps)) if peek(ps) != nil
    e
  end

  def expr(ps)
    left = term(ps)
    while peek(ps) == "+" || peek(ps) == "-"
      op = advance(ps)
      left = BinOp.new(op, left, term(ps))
    end
    left
  end

  def term(ps)
    left = power(ps)
    while peek(ps) == "*" || peek(ps) == "/"
      op = advance(ps)
      left = BinOp.new(op, left, power(ps))
    end
    left
  end

  def power(ps)
    base = atom(ps)
    if peek(ps) == "^"
      advance(ps)
      return BinOp.new("^", base, power(ps))
    end
    base
  end

  def atom(ps)
    t = advance(ps)
    raise ParseError.new("unexpected end", @pos) if t == nil
    if t == "("
      e = expr(ps)
      expect(ps, ")")
      e
    elsif t == "-"
      BinOp.new("-", Num.new(0), atom(ps))
    elsif String.match?(t, /\A\d/)
      String.include?(t, ".") ? Num.new(String.to_f(t)) : Num.new(String.to_i(t))
    elsif String.match?(t, /\A[a-z]/)
      Var.new(t)
    else
      raise ParseError.new("unexpected #{t}", @pos)
    end
  end
end

def evaluate(e, env)
  case e
  in Num then Num.get_value(e)
  in Var
    v = env[Var.get_name(e)]
    raise UnboundError.new("unbound variable #{Var.get_name(e)}", Var.get_name(e)) if v == nil
    v
  in BinOp
    a = evaluate(BinOp.get_left(e), env)
    b = evaluate(BinOp.get_right(e), env)
    op = BinOp.get_op(e)
    if op == "+" then a + b
    elsif op == "-" then a - b
    elsif op == "*" then a * b
    elsif op == "/" then a / b
    else a ** b
    end
  end
end

def prec(op)
  return 1 if op == "+" || op == "-"
  return 2 if op == "*" || op == "/"
  3
end

def show(e)
  case e
  in Num then Kernel.to_s(Num.get_value(e))
  in Var then Var.get_name(e)
  in BinOp
    op = BinOp.get_op(e)
    l = BinOp.get_left(e)
    r = BinOp.get_right(e)
    ls = show(l)
    rs = show(r)
    ls = "(#{ls})" if (l in BinOp) && prec(BinOp.get_op(l)) < prec(op)
    rs = "(#{rs})" if (r in BinOp) && (prec(BinOp.get_op(r)) < prec(op) || (prec(BinOp.get_op(r)) == prec(op) && op != "^"))
    "#{ls} #{op} #{rs}"
  end
end

def num?(e, v) = (e in Num) && Num.get_value(e) == v

def simplify(e)
  return e unless e in BinOp
  op = BinOp.get_op(e)
  l = simplify(BinOp.get_left(e))
  r = simplify(BinOp.get_right(e))
  if (l in Num) && (r in Num) && (op != "/" || Num.get_value(r) != 0)
    return Num.new(evaluate(BinOp.new(op, l, r), Hash[]))
  end
  return r if op == "+" && num?(l, 0)
  return l if (op == "+" || op == "-") && num?(r, 0)
  return Num.new(0) if op == "*" && (num?(l, 0) || num?(r, 0))
  return r if op == "*" && num?(l, 1)
  return l if (op == "*" || op == "/" || op == "^") && num?(r, 1)
  return Num.new(1) if op == "^" && num?(r, 0)
  BinOp.new(op, l, r)
end

def derive(e, x)
  case e
  in Num then Num.new(0)
  in Var then Num.new(Var.get_name(e) == x ? 1 : 0)
  in BinOp
    op = BinOp.get_op(e)
    u = BinOp.get_left(e)
    v = BinOp.get_right(e)
    du = derive(u, x)
    dv = derive(v, x)
    if op == "+" || op == "-"
      BinOp.new(op, du, dv)
    elsif op == "*"
      BinOp.new("+", BinOp.new("*", du, v), BinOp.new("*", u, dv))
    elsif op == "/"
      BinOp.new("/", BinOp.new("-", BinOp.new("*", du, v), BinOp.new("*", u, dv)), BinOp.new("^", v, Num.new(2)))
    elsif v in Num
      BinOp.new("*", BinOp.new("*", v, BinOp.new("^", u, Num.new(Num.get_value(v) - 1))), du)
    else
      raise ArgumentError, "cannot differentiate non-constant power"
    end
  end
end

def node_count(e) = (e in BinOp) ? 1 + node_count(BinOp.get_left(e)) + node_count(BinOp.get_right(e)) : 1

env = Hash["x" => 3, "y" => 2.5, "n" => 4]
sources = Array["1 + 2 * 3", "(1 + 2) * 3", "2 ^ 3 ^ 2", "x * x - 4 * x + 4", "10 - 4 - 3", "8 / (4 / 2)",
                "y * (x + 1) / 2", "-x + n * 0 + 1 * y", "x ^ n / (x - 3 + 0)", "2 * (3 + ", "z + 1", "4 $ 2"]
Array.each(sources) do |src|
  begin
    tree = Parser.parse(src)
    simp = simplify(tree)
    puts("#{src}  =>  #{show(tree)}  [#{node_count(tree)} nodes]")
    puts("    simplified: #{show(simp)}  [#{node_count(simp)} nodes]") if node_count(simp) < node_count(tree)
    puts("    value: #{evaluate(tree, env)}")
  rescue ParseError => e
    puts("#{src}  =>  parse error at #{ParseError.get_pos(e)}: #{Exception.message(e)}")
  rescue UnboundError => e
    puts("    error: #{Exception.message(e)}")
  rescue ZeroDivisionError => e
    puts("    error: division by zero")
  end
end

puts("-- derivatives d/dx --")
Array.each(Array["x * x - 4 * x + 4", "3 * x ^ 3 + y * x", "x / (x + 1)", "2 ^ x"]) do |src|
  begin
    d = simplify(derive(Parser.parse(src), "x"))
    puts("#{src}  ->  #{show(d)}  = #{evaluate(d, env)} at x=3")
  rescue ArgumentError => e
    puts("#{src}  ->  #{Exception.message(e)}")
  end
end
