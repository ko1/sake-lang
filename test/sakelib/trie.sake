require "trie"

t = Trie.new
Array.each_with_index(Array["car", "cart", "carbon", "cat", "dog", "do", "door", "日本", "日本語"]) do |w, i|
  Trie.insert(t, w, i)
end
t["zebra"] = 100
p Trie.size(t)
p Trie.empty?(t)
p Array.map(Array["car", "ca", "cart", "carts", "do", "日本語", "zebra", ""]) { |w| t[w] }
p Array.map(Array["car", "ca", "dog", "dogs", ""]) { |w| Trie.include?(t, w) }
p Array.map(Array["ca", "x", "日", "door", ""]) { |w| Trie.starts_with?(t, w) }

# prefix search, in order
p Trie.prefix_search(t, "car")
p Trie.prefix_search(t, "do")
p Trie.prefix_search(t, "日")
p Trie.prefix_search(t, "x")
p Trie.keys(t)
p Trie.to_a(t)

# longest prefix
Array.each(Array["cartoon", "carbonate", "ca", "doorway", "日本語学校", "zebras", "x", ""]) do |s|
  puts "#{s.Kernel.inspect} -> #{Trie.longest_prefix(t, s).Kernel.inspect}"
end

# replace and delete
p Trie.insert(t, "car", 42)
p t["car"]
p Trie.size(t)
p Trie.node_count(t)
p Trie.delete(t, "carbon")
p Trie.delete(t, "carbon")
p Trie.delete(t, "ca")
p Trie.delete(t, "missing")
p Trie.node_count(t)
p Trie.prefix_search(t, "car")
p Trie.delete(t, "do")
p Trie.include?(t, "dog")
p Trie.include?(t, "do")
p Trie.delete(t, "dog")
p Trie.delete(t, "door")
p Trie.starts_with?(t, "d")
p Trie.size(t)
p Trie.node_count(t)
Trie.each(t) { |k, v| puts "#{k}=#{v}" }

# a set of words: the value defaults to true; the empty key
words = Trie.new
Array.each(String.split("the then there these this that", " ")) { |w| Trie.insert(words, w) }
p Trie.prefix_search(words, "the")
p words["this"]
p Trie.longest_prefix(words, "thereafter")
p Trie.longest_prefix(words, "")
Trie.insert(words, "")
p Trie.longest_prefix(words, "xyz")
p Trie.include?(words, "")
p Trie.size(words)

# errors
begin
  Trie.insert(words, Array.fetch(Array["ok", :sym], 1))
rescue NoMatchingPatternError
  puts "key must be a String"
end
