<% content_for :title, "Posts" %>
<h1>Posts (<%= @posts.size %>)</h1>
<%= render @posts %>
<ul>
  <%= render partial: "posts/summary", collection: @posts, as: :item, spacer_template: "posts/spacer" %>
</ul>
<% if @posts.empty? %>
  <p>No posts.</p>
<% else %>
  <p><%= pluralize @posts.size, "post" %> <%== "<b>raw</b>" %></p>
<% end %>
<%= link_to "New post", new_post_path %>
