class Plan
  attr_reader name, per_seat, min_seats
end

class Subscription
  attr_reader customer
  attr_accessor plan, seats, coupon_months, status, failures, card_ok

  def monthly(sub) = Plan.get_per_seat(@plan) * Array.max(Array[@seats, Plan.get_min_seats(@plan)])
end

class PaymentDeclined < StandardError
  attr_reader customer, attempt
end

def plans = once {
  Hash[
    "starter" => Plan.new("starter", 8r, 1),
    "team" => Plan.new("team", 15r, 3),
    "business" => Plan.new("business", 29r, 10)
  ]
}

def days_in_month = 30
def coupon_off = 20

def money(r) = format("%.2f", Rational.to_f(Rational.round(r * 100) / 100r))

# switching plan or seats on `day`: credit the unused part of the old price, charge the new one
def change(sub, day, plan_name, seats)
  left = Rational(days_in_month - day + 1, days_in_month)
  before = Subscription.monthly(sub)
  Subscription.set_plan(sub, Hash.fetch(plans, plan_name))
  Subscription.set_seats(sub, seats)
  after = Subscription.monthly(sub)
  (after - before) * left
end

def charge_card(sub, amount, attempt)
  unless Subscription.get_card_ok(sub)
    raise PaymentDeclined.new("card declined", Subscription.get_customer(sub), attempt)
  end
  amount
end

def invoice(sub, adjustments)
  lines = Array[["#{Plan.get_name(Subscription.get_plan(sub))} x#{Subscription.get_seats(sub)}", Subscription.monthly(sub)]]
  Array.concat(lines, adjustments)
  if Subscription.get_coupon_months(sub) > 0
    subtotal = Array.sum(lines) { |t, amt| amt }
    Array.push(lines, ["coupon -#{coupon_off}%", -subtotal * coupon_off / 100])
    Subscription.set_coupon_months(sub, Subscription.get_coupon_months(sub) - 1)
  end
  lines
end

subs = Array[
  Subscription.new("Northwind", Hash.fetch(plans, "team"), 5, 2, :active, 0, true),
  Subscription.new("Contoso", Hash.fetch(plans, "starter"), 2, 0, :active, 0, true),
  Subscription.new("Fabrikam", Hash.fetch(plans, "business"), 12, 1, :active, 0, true),
  Subscription.new("Tailspin", Hash.fetch(plans, "team"), 1, 0, :active, 0, true),
  Subscription.new("Globex", Hash.fetch(plans, "starter"), 3, 0, :active, 0, true)
]
by_name = Hash[]
Array.each(subs) { |s| by_name[Subscription.get_customer(s)] = s }

# events per month: [month, customer, kind, arg...]
events = Array[
  [1, "Contoso", :change, 16, "team", 4],
  [2, "Northwind", :change, 11, "team", 8],
  [2, "Tailspin", :card, false],
  [2, "Globex", :card, false],
  [3, "Fabrikam", :change, 21, "team", 6],
  [3, "Tailspin", :card, true],
  [4, "Contoso", :cancel]
]

revenue = Hash.new(0r)
Range.each(1..4) do |month|
  puts("== Month #{month} ==")
  pending = Hash[]
  Array.each(Array.select(events) { |e| e[0] == month }) do |e|
    sub = Hash.fetch(by_name, e[1])
    case e[2]
    in :change
      _m, _c, _k, day, plan, seats = e
      delta = change(sub, day, plan, seats)
      pending[e[1]] = Array[["proration day #{day} -> #{plan} x#{seats}", delta]]
    in :card
      Subscription.set_card_ok(sub, e[3])
    in :cancel
      Subscription.set_status(sub, :canceled)
    end
  end
  Array.each(subs) do |sub|
    name = Subscription.get_customer(sub)
    next if Subscription.get_status(sub) == :canceled
    lines = invoice(sub, pending[name] || Array[])
    total = Array.sum(lines) { |t, amt| amt }
    begin
      paid = charge_card(sub, total, Subscription.get_failures(sub) + 1)
      revenue[month] += paid
      Subscription.set_failures(sub, 0)
      Subscription.set_status(sub, :active)
      puts("  #{name}: " + Array.join(Array.map(lines) { |t, amt| "#{t} #{money(amt)}" }, "; ") + " = #{money(total)}")
    rescue PaymentDeclined => e
      Subscription.set_failures(sub, PaymentDeclined.get_attempt(e))
      Subscription.set_status(sub, Subscription.get_failures(sub) >= 2 ? :suspended : :past_due)
      puts("  #{name}: #{Exception.message(e)} (attempt #{PaymentDeclined.get_attempt(e)}), now #{Subscription.get_status(sub)}")
    end
  end
end

puts
Range.each(1..4) { |m| puts("Month #{m} collected #{money(revenue[m])}") }
active = Array.select(subs) { |s| Subscription.get_status(s) == :active }
mrr = Array.sum(active) { |s| Subscription.monthly(s) }
puts("MRR #{money(mrr)} from #{Array.size(active)} active; " +
  Array.join(Array.map(Array.reject(subs) { |s| Subscription.get_status(s) == :active }) { |s| "#{Subscription.get_customer(s)}=#{Subscription.get_status(s)}" }, ", "))
seats = Array.sum(active) { |s| Subscription.get_seats(s) }
puts("Average revenue per seat #{money(mrr / seats)}")
