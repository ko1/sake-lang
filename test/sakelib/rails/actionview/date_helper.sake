require "rails/actionview/action_view/base"

# A record (ActiveModel's interface: ModelNaming::Model)
class Event
  attr_reader id, starts_at
  include ActionView::ModelNaming::Model
  def to_key(r) = @id ? Any[@id] : nil
  def to_param(r) = @id ? Kernel.to_s(@id) : nil
  def param_key(r) = "event"
  def route_key(r) = "events"
  def singular_route_key(r) = "event"
  def persisted?(r) = @id != nil
  def read_attribute_for_validation(r, name) = name == "starts_at" ? @starts_at : nil
end

view = ActionView::Base.empty
V = ActionView::Base
from = Time.utc(2026, 10, 20, 12, 0, 0)

# distance_of_time_in_words
Array.each(Any[0, 3, 7, 15, 30, 50, 61, 89, 300, 2700, 5400, 7200, 86400, 172800, 2592000, 5184000, 31536000, 47304000, 63072000, 94608000, 315360000]) do |secs|
  puts "#{secs}: #{V.distance_of_time_in_words(view, from, from + secs)} | #{V.distance_of_time_in_words(view, from, from + secs, include_seconds: true)}"
end
puts V.distance_of_time_in_words(view, from + 3600, from)
puts V.distance_of_time_in_words(view, Date.new(2026, 1, 1), Date.new(2026, 3, 1))
puts V.distance_of_time_in_words(view, 0, 3600)
puts V.time_ago_in_words(view, Time.utc(1990, 1, 1))
puts V.relative_time_in_words(view, Time.utc(1990, 1, 1))
puts V.relative_time_in_words(view, Time.utc(2990, 1, 1))
begin
  V.distance_of_time_in_words(view, :x, from)
rescue ArgumentError => e
  puts Exception.message(e)
end
# time_tag
puts V.time_tag(view, Date.new(2026, 10, 20))
puts V.time_tag(view, from)
puts V.time_tag(view, from, "Right now", class: "t")
puts V.time_tag(view, Date.new(2026, 10, 20), format: :short)
puts V.time_tag(view, Date.new(2026, 10, 20)) { "in a block" }
# the selects
d = Date.new(2026, 10, 20)
t = Time.utc(2026, 10, 20, 14, 35, 9)
puts V.select_year(view, d, Hash.of(start_year: 2024, end_year: 2028))
puts V.select_year(view, d, Hash.of(start_year: 2028, end_year: 2026, prefix: "event", field_name: "y"))
puts V.select_month(view, d, Hash.of(use_month_numbers: true))
puts V.select_month(view, d, Hash.of(add_month_numbers: true, include_blank: true))
puts V.select_month(view, d, Hash.of(use_short_month: true, prompt: "Choose"))
puts V.select_month(view, d, Hash.of(month_format_string: "%{name} (%{number})", use_two_digit_numbers: false))
puts V.select_day(view, d, Hash.of(use_two_digit_numbers: true, prompt: true))
puts V.select_day(view, 7, Hash.of(use_hidden: true))
puts V.select_hour(view, t, Hash.of(ampm: true, start_hour: 9, end_hour: 17))
puts V.select_minute(view, t, Hash.of(minute_step: 15), Hash.of(class: "m"))
puts V.select_second(view, t)
puts V.select_date(view, d, Hash.of(order: Any[:month, :day, :year], prefix: "payday", date_separator: "/"))
puts V.select_date(view, d, Hash.of(discard_day: true, with_css_classes: true))
puts V.select_date(view, Hash.of(year: 2026, month: 2, day: 9), Hash.of(prompt: Hash.of(day: "Choose day", month: "Choose month", year: "Choose year")))
puts V.select_time(view, t, Hash.of(include_seconds: true))
puts V.select_time(view, t, Hash.of(ignore_date: true, time_separator: ":"))
puts V.select_datetime(view, t, Hash.of(start_year: 2025, end_year: 2027, prefix: "start"))
puts V.select_datetime(view, t, Hash.of(discard_year: true, disabled: true, namespace: "ns"))
begin
  V.select_year(view, d, Hash.of(start_year: 1, end_year: 5000))
rescue ArgumentError => e
  puts Exception.message(e)
end
# date_select / time_select / datetime_select for a record
event = Event.new(1, Time.utc(2026, 12, 24, 18, 30, 0))
puts V.date_select(view, "event", :starts_at, Hash.of(object: event, start_year: 2026, end_year: 2027))
puts V.time_select(view, "event", :starts_at, Hash.of(object: event, minute_step: 30))
puts V.datetime_select(view, "event", :starts_at, Hash.of(object: event, start_year: 2026, end_year: 2026, discard_minute: true), Hash.of(class: "dt"))
puts V.date_select(view, "event", :starts_at, Hash.of(object: event, order: Any[:day, :month], start_year: 2026, end_year: 2027, index: 3))
puts V.date_select(view, "event", :starts_at, Hash.of(selected: Date.new(2027, 1, 2), start_year: 2026, end_year: 2027, discard_type: true))
