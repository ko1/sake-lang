# Port of activerecord-8.1.3/lib/active_record/scoping.rb, scoping/default.rb and scoping/named.rb (partial:
# scope bodies are functions, not lambdas; no scoping { } blocks (Ruby's current_scope is per class and thread,
# and a relation of one model has its own type, so no place can hold "the current scope" of every model); no
# all_queries: default scopes; a default scope's where values are not applied by Post.build)
#
# Ruby's `scope :published, -> { where(published: true) }` defines a class method from the lambda; a lambda has
# no Sake form, so the scope is the function the lambda would be, written in the model with the relation first:
#   def published(rel = Post.all) = ActiveRecord::Relation.where(rel, published: true)
# which serves both Post.published and Post.published(Post.where(...)) (Ruby: Post.where(...).published, the
# relation delegating to the class). Ruby's `default_scope { where(published: true) }` is the same shape: the
# model defines `def default_scope(rel) = ActiveRecord::Relation.where(rel, published: true)`, which replaces the
# mixin's default below, and `all` applies it; `unscoped` does not.

module ActiveRecord
  module Scoping
    # Required of the model (generated): a new, empty relation of its class.
    def __relation = raise(NotImplementedError)

    # Ruby's default_scope block; a model that has one defines this function (its own definition wins)
    def default_scope(rel) = rel

    # Ruby: all (default_scoped)
    def all = default_scope(__relation)
    def default_scoped = all
    # Ruby: unscoped (without the default scopes)
    def unscoped = __relation
  end
end
