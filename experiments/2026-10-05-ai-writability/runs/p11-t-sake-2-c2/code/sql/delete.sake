# DELETE (2.2): removes the rows for which WHERE is true, or all rows.
module Delete
  module_function

  def run(db, stmt)
    table = Catalog.writable_table!(db, DeleteStmt.table(stmt))
    where = DeleteStmt.where(stmt)
    if where == nil
      Table.set_rows(table, Array[])
    else
      scope = Resolver.table_scope(db, DeleteStmt.table(stmt), Table.columns(table))
      cond = Resolver.resolve(where, scope)
      Table.set_rows(table, Array.reject(Table.rows(table)) { |row| Values.truth(Eval.value_of(cond, Eval.top(row))) == 1 })
    end
    String[]
  end
end
