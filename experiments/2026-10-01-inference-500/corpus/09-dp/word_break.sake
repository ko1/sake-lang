def dictionary(words) = Array.to_set(String.split(words, " "))

def max_word_length(dict) = Array.max(Array.map(Set.to_a(dict)) { |w| String.size(w) })

# can[i]: the prefix of length i splits into words
def breakable(text, dict)
  n = String.size(text)
  longest = max_word_length(dict)
  can = Array.fill(Range.to_a(0..n), false)
  can[0] = true
  Integer.upto(1, n) do |i|
    lo = i - longest
    lo = 0 if lo < 0
    Integer.upto(lo, i - 1) do |j|
      if can[j] && Set.include?(dict, text[j...i])
        can[i] = true
      end
    end
  end
  can[n]
end

def all_splits(text, dict, start, memo)
  cached = memo[start]
  return cached if cached
  result = Array[]
  if start == String.size(text)
    Array.push(result, "")
  else
    Integer.upto(start + 1, String.size(text)) do |stop|
      word = text[start...stop]
      next unless Set.include?(dict, word)
      Array.each(all_splits(text, dict, stop, memo)) do |rest|
        Array.push(result, rest == "" ? word : "#{word} #{rest}")
      end
    end
  end
  memo[start] = result
  result
end

# fewest words; ties broken by the earliest split
def fewest_words(text, dict)
  n = String.size(text)
  best = Array.fill(Range.to_a(0..n), nil)
  cut = Array.fill(Range.to_a(0..n), 0)
  best[0] = 0
  Integer.upto(1, n) do |i|
    Integer.upto(0, i - 1) do |j|
      prev = best[j]
      next if prev == nil
      next unless Set.include?(dict, text[j...i])
      cur = best[i]
      if cur == nil || prev + 1 < cur
        best[i] = prev + 1
        cut[i] = j
      end
    end
  end
  return nil if best[n] == nil
  words = Array[]
  i = n
  while i > 0
    j = cut[i]
    Array.unshift(words, text[j...i])
    i = j
  end
  words
end

dict = dictionary("a an and apple applepen pen pine pineapple cat cats dog dogs sand sea seashell shell shells sell sells he she by the shore or")
inputs = Array["applepenapple", "pineapplepenapple", "catsanddog", "catsandog", "seashellsbytheseashore", "shesellsseashells", "andor", ""]

Array.each(inputs) do |text|
  ok = breakable(text, dict)
  puts("#{Kernel.inspect(text)}: #{ok ? "breakable" : "not breakable"}")
  next unless ok
  splits = all_splits(text, dict, 0, Hash[])
  puts("  #{Array.size(splits)} way(s)")
  Array.each(Array.take(Array.sort(splits), 4)) { |s| puts("    #{s}") }
  puts("    ...") if Array.size(splits) > 4
  few = fewest_words(text, dict)
  puts("  fewest words: #{Array.join(few, " | ")}") if few
end

hashtags = Array["#lovesea", "#dogsandcats", "#pineapple", "#seashore"]
extra = Set.union(dict, Set["love", "s"])
Array.each(hashtags) do |tag|
  body = String.delete_prefix(tag, "#")
  words = fewest_words(body, extra)
  label = words ? Array.join(Array.map(words) { |w| String.capitalize(w) }, " ") : "(unsplittable)"
  puts("#{String.ljust(tag, 14)} -> #{label}")
end
