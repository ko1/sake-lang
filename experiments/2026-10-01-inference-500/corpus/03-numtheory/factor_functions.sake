# Prime factorization into a Hash of prime => exponent, and the multiplicative
# functions built from it: tau, sigma, Euler's phi, Moebius, radical.

def factorize(n)
  f = Hash[]
  d = 2
  while d * d <= n
    while n % d == 0
      f[d] = Hash.fetch(f, d, 0) + 1
      n /= d
    end
    d += d == 2 ? 1 : 2
  end
  f[n] = Hash.fetch(f, n, 0) + 1 if n > 1
  f
end

def show_factors(f)
  return "1" if Hash.empty?(f)
  parts = Hash.map(f) { |p, e| e == 1 ? Integer.to_s(p) : "#{p}^#{e}" }
  Array.join(parts, " * ")
end

def tau(f) = Hash.reduce(f, 1) { |acc, pe| acc * (pe[1] + 1) }

def sigma(f)
  prod = 1
  Hash.each(f) { |p, e| prod *= (p ** (e + 1) - 1) / (p - 1) }
  prod
end

def phi(n, f) = Hash.reduce(f, n) { |acc, pe| acc / pe[0] * (pe[0] - 1) }

def moebius(f)
  return 0 if Hash.any?(f) { |p, e| e > 1 }
  Integer.even?(Hash.size(f)) ? 1 : -1
end

def radical(f) = Array.reduce(Hash.keys(f), 1) { |acc, p| acc * p }

def from_factors(f) = Hash.reduce(f, 1) { |acc, pe| acc * pe[0] ** pe[1] }

samples = Array[1, 2, 12, 60, 97, 360, 1001, 1024, 30030, 65536 + 1, 999999, 123456789]
puts(format("%10s  %-22s %5s %10s %10s %3s %8s", "n", "factors", "tau", "sigma", "phi", "mu", "rad"))
Array.each(samples) do |n|
  f = factorize(n)
  raise "roundtrip failed for #{n}" if from_factors(f) != n
  puts(format("%10d  %-22s %5d %10d %10d %3d %8d", n, show_factors(f), tau(f), sigma(f), phi(n, f), moebius(f), radical(f)))
end

# most divisors below a bound (highly composite records)
records = Array[]
best = 0
Range.each(1..2000) do |n|
  t = tau(factorize(n))
  if t > best
    best = t
    Array.push(records, [n, t])
  end
end
puts("highly composite numbers <= 2000:")
puts("  " + Array.join(Array.map(records) { |n, t| "#{n}(#{t})" }, " "))

# sum of phi(d) over divisors d of n equals n
Array.each(Array[36, 100, 210]) do |n|
  divs = Range.select(1..n) { |d| n % d == 0 }
  total = Array.sum(Array.map(divs) { |d| phi(d, factorize(d)) })
  puts("sum of phi(d) for d | #{n} = #{total}")
end

# Mertens function M(n) = sum of mu(k)
m = 0
marks = Hash[]
Range.each(1..200) do |k|
  m += moebius(factorize(k))
  marks[k] = m if k % 40 == 0
end
puts("Mertens: " + Array.join(Hash.map(marks) { |k, v| "M(#{k})=#{v}" }, ", "))

# smooth numbers: largest prime factor <= 7
smooth = Range.select(1..120) { |n| f = factorize(n); Hash.empty?(f) || Array.max(Hash.keys(f)) <= 7 }
puts("7-smooth numbers <= 120 (#{Array.size(smooth)}): #{Array.join(smooth, " ")}")

# most frequent largest prime factor among 2..500
lpf = Hash.new(0)
Range.each(2..500) { |n| lpf[Array.max(Hash.keys(factorize(n)))] += 1 }
top = Array.take(Array.sort_by(Hash.to_a(lpf)) { |p, c| 0 - c * 1000 + p }, 5)
puts("most common largest prime factors: " + Array.join(Array.map(top) { |p, c| "#{p}:#{c}" }, " "))
