def human(s)
  return "#{s}B" if s < 1024
  k = 1024
  m = 1024 * 1024
  g = 1024 * 1024 * 1024
  if s >= g
    u = g
    unit = "G"
  elsif s >= m
    u = m
    unit = "M"
  else
    u = k
    unit = "K"
  end
  t = (s * 20 + u) / (2 * u)
  return "#{t / 10}.#{t % 10}#{unit}" if t < 100
  n = (2 * s + u) / (2 * u)
  if n == 1024 && u != g
    nxt = u == k ? "M" : "G"
    return "1.0#{nxt}"
  end
  "#{n}#{unit}"
end

def show(size, depth, name) = puts(format("%6s  %s%s", human(size), "  " * depth, name))

def print_dir(children, sizes, path, depth, maxd, thr)
  return if depth >= maxd
  ents = Array.sort_by(children[path]) { |e| [-sizes[e[2]], e[0]] }
  small = 0
  nsmall = 0
  Array.each(ents) do |e|
    sz = sizes[e[2]]
    if sz < thr
      small += sz
      nsmall += 1
    else
      show(sz, depth + 1, e[1] ? e[0] + "/" : e[0])
      print_dir(children, sizes, e[2], depth + 1, maxd, thr) if e[1]
    end
  end
  show(small, depth + 1, "(#{nsmall} smaller)") if nsmall > 0
end

lines = Array.map(String.lines(IO.read(IO.stdin))) { |l| String.chomp(l) }
hf = Array.empty?(lines) ? String[] : String.split(lines[0])
if Array.size(hf) != 4 || hf[0] != "depth" || hf[2] != "threshold" || !String.match?(hf[1], /\A\d+\z/) || !String.match?(hf[3], /\A\d+\z/)
  puts("bad header")
  exit
end
maxd = String.to_i(hf[1])
thr = String.to_i(hf[3])

files = Hash[]
dirs = Hash[]
sizes = Hash[]
children = Hash[]
sizes[""] = 0
children[""] = Array[]
out = String[]

Array.each_with_index(lines) do |raw, idx|
  next if idx == 0
  f = String.split(raw)
  next if Array.empty?(f)
  n = idx + 1
  ok = Array.size(f) == 2 && String.match?(f[0], /\A\d+\z/) && String.to_i(f[0]) <= 10 ** 13
  ok = ok && String.match?(f[1], /\A[^\/]+(\/[^\/]+)*\z/)
  comps = ok ? String.split(f[1], "/") : String[]
  ok = ok && !Array.any?(comps) { |c| c == "." || c == ".." }
  unless ok
    Array.push(out, "line #{n}: malformed")
    next
  end
  path = f[1]
  size = String.to_i(f[0])
  cnt = Array.size(comps)
  if Hash.key?(files, path)
    Array.push(out, "line #{n}: duplicate #{path}")
    next
  end
  conflict = Hash.key?(dirs, path)
  i = 1
  while i < cnt
    conflict = true if Hash.key?(files, Array.join(comps[0, i], "/"))
    i += 1
  end
  if conflict
    Array.push(out, "line #{n}: conflict #{path}")
    next
  end
  files[path] = size
  sizes[""] += size
  i = 0
  while i < cnt
    full = Array.join(comps[0, i + 1], "/")
    parent = i == 0 ? "" : Array.join(comps[0, i], "/")
    isdir = i < cnt - 1
    unless Hash.key?(sizes, full)
      sizes[full] = 0
      children[full] = Array[] if isdir
      dirs[full] = true if isdir
      Array.push(children[parent], [comps[i], isdir, full])
    end
    sizes[full] += size
    i += 1
  end
end

puts(*out) unless Array.empty?(out)
show(sizes[""], 0, ".")
print_dir(children, sizes, "", 0, maxd, thr)
