# The HTML of Rails' helpers, route helpers and model errors, written with the Sake framework; compare.rb prints
# the same with Rails 8.1.3. Run: bin/sake --strict compare.sake
require "action_view"
require "active_model"
require "action_dispatch"

# config/routes.rb
class ActionDispatch::Routing::Mapper
  def draw(map)
    root map, "posts#index"
    resources map, :posts do
      resources map, :comments, {only: Array[:create, :destroy]}
    end
  end
end
def routes
  once { ActionDispatch::Routing::RouteSet.draw(ActionDispatch::Routing::RouteSet.new) }
end

# app/models/post.rb (ActiveModel only: no database here)
class Post
  attr_accessor id, title, body, errors
  include ActiveModel::Model
  def initialize(p) = @errors = ActiveModel::Errors.new
  def model_name(p) = ActiveModel::Name.new("Post")
  def persisted?(p) = @id != nil
  def to_key(p) = @id ? Array[@id] : nil
  def read_attribute_for_validation(p, name) = read_field(p, name)
  def validate(post)
    validates post, :title, {presence: true, length: {minimum: 5}}
    validates post, :body, {presence: true}
  end
end

class Comment
  attr_accessor id, commenter, body, errors
  include ActiveModel::Model
  def initialize(c) = @errors = ActiveModel::Errors.new
  def model_name(c) = ActiveModel::Name.new("Comment")
  def persisted?(c) = @id != nil
  def to_key(c) = @id ? Array[@id] : nil
  def read_attribute_for_validation(c, name) = read_field(c, name)
  def validate(c) = nil
end

# the view context: helpers and route helpers (the blog's are generated by bin/rails from the routes)
class View
  include ActionView::Helpers
end
def path(name, *values)
  ActionDispatch::Routing::RouteSet.path_for(routes, name, values)
end
def polymorphic_path(record)
  case record
  in Post then path("post", ActiveModel::Model.to_param(record))
  in [Post, Comment]
    post, comment = record
    c = ActiveModel::Model.to_param(comment)
    c ? path("post_comment", ActiveModel::Model.to_param(post), c) : path("post_comments", ActiveModel::Model.to_param(post))
  end
end

# `bin/rails routes`
puts ActionDispatch::Routing::RouteSet.inspect_routes(routes)

# route helpers
puts path("root")
puts path("posts")
puts path("new_post")
puts path("post", 1)
puts path("edit_post", 1)
puts path("post_comments", 1)
puts path("post_comment", 1, 2)
post = Post.new(id: 3, title: "Hello <world>", body: "text")
puts path("post", ActiveModel::Model.to_param(post))
puts polymorphic_path(post)
puts polymorphic_path([post, Comment.new(id: 9)])

# tags and links
puts View.content_tag(:p, "Hello <world>", {class: "note"})
puts View.content_tag(:div, nil, {id: "posts"}) { "<b>inner</b>" }
puts View.content_tag(:div, nil, {id: "posts"}) { View.content_tag(:b, "inner") }
puts View.tag("br")
puts View.link_to("Show this post", "/posts/1")
puts View.link_to("Back <home>", "/posts", {class: "nav"})
puts View.link_to("Show this post", post)
puts View.button_to("Destroy this post", post, {method: :delete})
puts View.button_to("New", "/posts")
puts View.pluralize(1, "error")
puts View.pluralize(2, "error")
puts View.pluralize(0, "comment")
puts View.pluralize(2, "person")
puts ERB::Util.h("<script>alert('x') & \"y\"</script>")
puts View.dom_id(post)
puts View.dom_id(Post.new)
puts View.dom_id(post, :edit)
t0 = Time.new(2026, 10, 12, 12, 0, 0, "UTC")
Array.each(Array[0, 50, 5 * 60, 50 * 60, 3 * 3600, 30 * 3600, 3 * 86400, 40 * 86400, 100 * 86400, 800 * 86400]) do |sec|
  puts View.distance_of_time_in_words(t0, t0 + sec)
end

# a model with errors
bad = Post.new(title: "Hi", body: "")
puts ActiveModel::Model.valid?(bad)
puts ActiveModel::Errors.count(Post.errors(bad))
Array.each(ActiveModel::Errors.full_messages(Post.errors(bad))) { |m| puts m }
p ActiveModel::Errors.full_messages_for(Post.errors(bad), :title)
p ActiveModel::Errors.[](Post.errors(bad), :body)
empty = Post.new(title: "", body: nil)
puts ActiveModel::Model.valid?(empty)
ActiveModel::Errors.each(Post.errors(empty)) { |e| puts "#{ActiveModel::Error.attribute(e)}: #{ActiveModel::Error.full_message(e)}" }
ok = Post.new(title: "Hello world", body: "text")
puts ActiveModel::Model.valid?(ok)
puts ActiveModel::Errors.any?(Post.errors(ok))

# forms
puts(View.form_with({model: Post.new, url: "/posts"}) { |f|
  View.label(f, :title) + View.text_field(f, :title) + View.text_area(f, :body) + View.submit(f)
})
puts(View.form_with({model: post}) { |f|
  View.label(f, :title, {style: "display: block"}) + View.text_field(f, :title) + View.text_area(f, :body) + View.submit(f)
})
puts(View.form_with({model: [post, Comment.new]}) { |f|
  View.text_field(f, :commenter) + View.submit(f)
})
puts(View.form_with({url: "/search", method: :get}) { |f| View.text_field(f, :q) + View.submit(f, "Search") })
