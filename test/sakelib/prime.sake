require "prime"

# each with a bound
Prime.each(30) { |p| print(p, " ") }
puts
xs = Integer[]
Prime.each(2) { |p| Array.push(xs, p) }
p(xs)
Prime.each(1) { |p| Array.push(xs, p) }
p(xs)
p(Prime.each(10) { |q| q * 10 })
Prime.each_with_index(12) { |q, i| print(i, ":", q, " ") }
puts

# first / take / take_while / find
p(Prime.first(10))
p(Prime.first(0))
p(Array.last(Prime.first(1000)))
p(Prime.take(3))
p(Prime.take_while { |q| q < 40 })
p(Prime.find { |q| q > 1000 })
p(Prime.to_a(50))

# prime?
p(Range.select(-5..40) { |n| Prime.prime?(n) })
p(Prime.prime?(1))
p(Prime.prime?(2147483647))
p(Prime.prime?(2147483649))
p(Prime.prime?(1_000_000_007))
p(Prime.prime?(561))
p(Integer.prime?(97))
p(Integer.prime?(1_000_000_007 * 998_244_353))
p(Integer.prime?(2 ** 61 - 1))
p(Prime.include?(13))

# prime_division and back
Array.each(Integer[1, 2, 12, 360, 97, 1024, 1001, -12, -1, 600851475143, 2 ** 31 - 1, 3 ** 20 * 7]) do |n|
  pd = Prime.prime_division(n)
  puts("#{n}: #{pd.Kernel.inspect} -> #{Prime.int_from_prime_division(pd)}")
end
p(Integer.prime_division(84))
p(Integer.from_prime_division(Integer.prime_division(84)))
p(Prime.int_from_prime_division(Array[]))
begin
  Prime.prime_division(0)
rescue ZeroDivisionError => e
  puts("ZeroDivisionError: #{Exception.message(e)}")
end

# Integer.each_prime
s = 0
Integer.each_prime(100) { |q| s += q }
p(s)

# a small use: Euler's totient from the factorization
def phi(n) = Prime.prime_division(n).Array.inject(n) { |acc, (q, _)| acc / q * (q - 1) }
p(Range.map(1..20) { |n| phi(n) })

# No bound: every prime, until break
ys = Integer[]
Prime.each do |q|
  break if q > 60
  Array.push(ys, q)
end
p(ys)
Prime.each_with_index do |q, i|
  break if i >= 5
  print(i, ":", q, " ")
end
puts
# the shared list grows past what was sieved before
p(Prime.first(3000).Array.last)
p(Prime.to_a(30000).Array.size)
p(Prime.first(5))

# without a block: the primes as an Array (Ruby: an Enumerator, here turned into one with to_a)
p(Prime.each(30))
p(Integer.each_prime(20))
p(Prime.each(1))
