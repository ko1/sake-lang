# Conway's Game of Life on a bounded board, with cycle detection.

class Board
  attr_reader width, height, cells
  include Indexable

  def parse(rows)
    h = Array.size(rows)
    w = String.size(rows[0])
    cells = Array[]
    Array.each(rows) do |row|
      Array.push(cells, Array.map(String.chars(row)) { |c| c == "#" })
    end
    Board.new(w, h, cells)
  end

  def blank(w, h)
    Board.new(w, h, Range.map(0...h) { Range.map(0...w) { false } })
  end

  def [](b, pos)
    x, y = pos
    return false if x < 0 || y < 0 || x >= @width || y >= @height
    @cells[y][x]
  end

  def []=(b, pos, v)
    x, y = pos
    row = @cells[y]
    row[x] = v
  end

  def neighbors(b, x, y)
    count = 0
    Array.each(Array[-1, 0, 1]) do |dy|
      Array.each(Array[-1, 0, 1]) do |dx|
        next if dx == 0 && dy == 0
        count += 1 if b[[x + dx, y + dy]]
      end
    end
    count
  end

  def step(b)
    nb = blank(@width, @height)
    Integer.times(@height) do |y|
      Integer.times(@width) do |x|
        n = neighbors(b, x, y)
        alive = b[[x, y]]
        nb[[x, y]] = alive ? (n == 2 || n == 3) : n == 3
      end
    end
    nb
  end

  def population(b)
    Array.sum(Array.map(@cells) { |row| Array.count(row) { |c| c } })
  end

  def key(b)
    Array.join(Array.map(@cells) { |row| Array.join(Array.map(row) { |c| c ? "1" : "0" }, "") }, "/")
  end

  def to_s(b)
    Array.join(Array.map(@cells) { |row| Array.join(Array.map(row) { |c| c ? "#" : "." }, "") }, "\n")
  end
end

def run(name, rows, max_steps)
  board = Board.parse(rows)
  seen = Hash[]
  history = Integer[]
  puts("== #{name} (#{Board.width(board)}x#{Board.height(board)}) ==")
  puts(board)
  gen = 0
  while gen < max_steps
    k = Board.key(board)
    prev = seen[k]
    if prev
      puts("cycle: generation #{gen} repeats generation #{prev} (period #{gen - prev})")
      break
    end
    seen[k] = gen
    Array.push(history, Board.population(board))
    board = Board.step(board)
    gen += 1
  end
  puts("after #{gen} generations:")
  puts(board)
  puts("population: #{Array.join(history, " ")}")
  peak = Array.max(history)
  puts("peak #{peak} at generation #{Array.index(history, peak)}")
  puts
end

run("blinker", Array[".....", "..#..", "..#..", "..#..", "....."], 10)
run("glider", Array[".#......", "..#.....", "###.....", "........", "........", "........"], 30)
run("beehive", Array["......", "..##..", ".#..#.", "..##..", "......"], 5)
run("r-pentomino", Array["........", "........", "...##...", "..##....", "...#....", "........", "........"], 40)
