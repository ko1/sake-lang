# Port of actionpack-8.1.3/lib/action_dispatch/http/response.rb and the Response half of http/cache.rb (partial: no streaming (await_commit/await_sent, MonitorMixin's condition variable), no send_file/FileBody, no FilterRedirect; the Rack body is the Array of the body's parts)
#
# Rails' Response keeps its headers in a Rack::Headers (keys downcased on every read and write); here a Hash with
# downcased names, and Response's get_header/set_header/[]/[]= downcase the key. Writing through the Hash that
# `Response.headers(res)` returns does not downcase (Rack::Headers does).
#
# `include Rack::Response::Helpers` (the status predicates, location, ...) is written out: sakelib's Rack::Response
# is a class whose fields and `initialize` differ from this one, so pasting it (`< Rack::Response`) would bring
# Rack's body handling too.
#
# Writers are Sake's `set_` names: Rails' `response.status = :created` is `Response.set_status(res, :created)`,
# `content_type=` `set_content_type`, `charset=` `set_charset`, `body=` `set_body`, `etag=` `set_etag`.

require "rack"
require "time"
require "digest"
require "mime_types"

module ActionDispatch
  class Response
    attr_reader status, headers                          # Response.new(status, headers, body): the first three
    private attr_accessor _initial_body                  # fields are the arguments; the body becomes `stream`
    attr_reader stream
    attr_accessor request
    private attr_accessor _committed, _sending, _sent, _cache_control
    include Indexable

    # The body: Rails' Response::Buffer over an Array of Strings.
    class Buffer
      attr_reader response, buf
      private attr_accessor closed, str_body

      def initialize(b)
        @closed = false
        @str_body = nil
      end

      def to_ary(b)
        s = @str_body
        s ? String[s] : @buf
      end

      def body(b)
        @str_body ||= Array.join(@buf)
      end

      def write(b, string)
        raise IOError, "closed stream" if closed?(b)
        @str_body = nil
        Response.commit!(@response)
        Array.push(@buf, string)
      end
      def <<(b, string) = write(b, string)

      def each(b)
        s = @str_body
        if s
          yield(s)
        else
          Array.each(@buf) { |chunk| yield(chunk) }
        end
        b
      end

      def abort(b) = nil
      def close(b)
        Response.commit!(@response)
        @closed = true
      end
      def closed?(b) = @closed == true
    end

    ContentTypeHeader = Struct.new(:mime_type, :charset)

    def content_type_key = "content-type"
    def set_cookie_key = "set-cookie"
    def no_content_codes = Integer[100, 101, 102, 103, 204, 205, 304]

    # cattr_accessor :default_charset (default "utf-8") and :default_headers (nil)
    def _class_config = once { Hash.of(:default_charset => "utf-8", :default_headers => nil) }
    def default_charset = Kernel.to_s(_class_config[:default_charset])
    def set_default_charset(v) = _class_config[:default_charset] = v
    def default_headers
      h = _class_config[:default_headers]
      (h in Hash) ? h : nil
    end
    def set_default_headers(v) = _class_config[:default_headers] = v

    def rack_status_code(status)
      status = :unprocessable_content if status == :unprocessable_entity
      Rack::Utils.status_code(status)
    end

    def create(status = 200, headers = Hash.new, body = String[], default_headers: Response.default_headers)
      Response.new(status, merge_default_headers(headers, default_headers), body)
    end

    def merge_default_headers(original, default)
      default ? Hash.merge(default, original) : original
    end

    # Rails: Response.new(status = 200, headers = nil, body = [])
    def initialize(res)
      given = @headers
      st = @status
      body = @_initial_body
      @_initial_body = nil
      hdrs = Hash.new
      Hash.each(given) { |key, value| hdrs[String.downcase(Kernel.to_s(key))] = value } if given
      @headers = hdrs
      @status = Response.rack_status_code(st == nil ? 200 : st)
      @stream = Buffer.new(res, body == nil ? String[] : body)
      @_committed = false
      @_sending = false
      @_sent = false
      prepare_cache_control!(res)
    end

    def has_header?(res, key) = Hash.key?(@headers, String.downcase(key))
    def get_header(res, key) = @headers[String.downcase(key)]
    def set_header(res, key, v) = @headers[String.downcase(key)] = v
    def delete_header(res, key) = Hash.delete(@headers, String.downcase(key))
    def [](res, key) = get_header(res, key)
    def []=(res, key, v)
      set_header(res, key, v)
    end
    def header(res) = @headers

    def commit!(res)
      before_committed(res)
      @_committed = true
    end
    def sending!(res)
      before_sending(res)
      @_sending = true
    end
    def sent!(res) = @_sent = true
    def sending?(res) = @_sending == true
    def committed?(res) = @_committed == true
    def sent?(res) = @_sent == true

    def each(res)
      sending!(res)
      Buffer.each(@stream) { |s| yield(s) }
      sent!(res)
      res
    end

    # Sets the HTTP status code (an Integer, or a Symbol such as :created).
    def set_status(res, status) = @status = Response.rack_status_code(status)

    # Sets the HTTP content type: `set_content_type(res, :json)` or `set_content_type(res, "text/plain")`.
    def set_content_type(res, content_type)
      return nil if content_type == nil
      new_header_info = if content_type in Symbol
        mime_type = Mime.fetch(content_type)
        raise ArgumentError, "Unknown MIME type #{content_type}" unless mime_type
        ContentTypeHeader.new(Mime::Type.to_s(mime_type), nil)
      else
        parse_content_type(res, Kernel.to_s(content_type))
      end
      prev_header_info = parsed_content_type_header(res)
      charset = ContentTypeHeader.charset(new_header_info) || ContentTypeHeader.charset(prev_header_info)
      charset ||= Response.default_charset unless ContentTypeHeader.mime_type(prev_header_info)
      _set_content_type(res, ContentTypeHeader.mime_type(new_header_info), charset)
    end

    # Content type of response (nil when empty).
    def content_type(res)
      ct = get_header(res, content_type_key)
      ct == nil || ct == "" ? nil : Kernel.to_s(ct)
    end

    # Media type of response.
    def media_type(res) = ContentTypeHeader.mime_type(parsed_content_type_header(res))

    def set_sending_file(res, v)
      set_charset(res, false) if v == true
    end

    # Sets the HTTP character set; false removes it, nil sets the default.
    def set_charset(res, charset)
      content_type = ContentTypeHeader.mime_type(parsed_content_type_header(res))
      if charset == false
        _set_content_type(res, content_type, nil)
      else
        _set_content_type(res, content_type, charset ? Kernel.to_s(charset) : Response.default_charset)
      end
    end

    # The charset of the response (the default when the content type has none).
    def charset(res) = ContentTypeHeader.charset(parsed_content_type_header(res)) || Response.default_charset

    def response_code(res) = @status
    def code(res) = Integer.to_s(@status)
    def message(res) = Rack::Utils.http_status_codes[@status]
    def status_message(res) = message(res)

    # Returns the content of the response as a string.
    def body(res) = Array.join(Buffer.to_ary(@stream))

    def write(res, string) = Buffer.write(@stream, string)

    # Allows you to manually set or override the response body (a String or an Array of Strings).
    def set_body(res, body)
      @stream = Buffer.new(res, (body in String) ? String[body] : body)
    end

    def reset_body!(res) = @stream = Buffer.new(res, String[])

    def body_parts(res)
      parts = String[]
      Buffer.each(@stream) { |x| Array.push(parts, x) }
      parts
    end

    def close(res) = Buffer.close(@stream)
    def abort(res) = Buffer.abort(@stream)

    # Turns the Response into a Rack-compatible array of the status, headers, and body.
    def to_a(res)
      commit!(res)
      rack_response(res, @status, @headers)
    end
    def prepare!(res) = to_a(res)

    # Returns the response cookies, converted to a Hash of (name => value) pairs.
    def cookies(res)
      cookies = Hash.new
      header = get_header(res, set_cookie_key)
      if header
        list = (header in String) ? String.split(header, "\n") : header
        Array.each(list) do |cookie|
          pair = String.split(Kernel.to_s(cookie), ";")[0]
          if pair
            kv = Array.map(String.split(pair, "=")) { |v| Rack::Utils.unescape(v) }
            cookies[kv[0] || ""] = kv[1]
          end
        end
      end
      cookies
    end

    # --- Rack::Response::Helpers ---
    def set_cookie(res, key, value)
      @headers[set_cookie_key] = Rack::Utils._add_value(@headers[set_cookie_key], Rack::Utils.set_cookie_header(key, value))
    end
    def delete_cookie(res, key, value = Hash.new)
      @headers[set_cookie_key] = Rack::Utils.delete_set_cookie_header!(@headers[set_cookie_key], key, value)
      nil
    end
    def location(res) = get_header(res, "location")
    def set_location(res, l) = set_header(res, "location", l)
    def redirect_url(res) = location(res)
    def cache_control_header(res) = get_header(res, "cache-control")
    def set_cache_control_header(res, v) = set_header(res, "cache-control", v)
    def content_length(res)
      cl = get_header(res, "content-length")
      cl ? String.to_i(Kernel.to_s(cl)) : nil
    end
    def invalid?(res) = @status < 100 || @status >= 600
    def informational?(res) = @status >= 100 && @status < 200
    def successful?(res) = @status >= 200 && @status < 300
    def redirection?(res) = @status >= 300 && @status < 400
    def client_error?(res) = @status >= 400 && @status < 500
    def server_error?(res) = @status >= 500 && @status < 600
    def ok?(res) = @status == 200
    def created?(res) = @status == 201
    def accepted?(res) = @status == 202
    def no_content?(res) = @status == 204
    def moved_permanently?(res) = @status == 301
    def bad_request?(res) = @status == 400
    def unauthorized?(res) = @status == 401
    def forbidden?(res) = @status == 403
    def not_found?(res) = @status == 404
    def method_not_allowed?(res) = @status == 405
    def not_acceptable?(res) = @status == 406
    def request_timeout?(res) = @status == 408
    def precondition_failed?(res) = @status == 412
    def unprocessable?(res) = @status == 422
    def redirect?(res) = Array.include?(Integer[301, 302, 303, 307, 308], @status)

    def inspect(res) = "#<ActionDispatch::Response #{@status}>"

    # --- private ---
    def content_type_parser = /\A(?<mime_type>[^;\s]+\s*(?:;\s*(?:(?!charset)[^;\s])+)*)?(?:;\s*charset=(?<quote>"?)(?<charset>[^;\s]+)\k<quote>)?/

    def parse_content_type(res, content_type)
      m = content_type ? String.match(content_type, content_type_parser) : nil
      m ? ContentTypeHeader.new(m["mime_type"], m["charset"]) : ContentTypeHeader.new(nil, nil)
    end

    # Small internal convenience method to get the parsed version of the current content type header.
    def parsed_content_type_header(res)
      ct = get_header(res, content_type_key)
      parse_content_type(res, ct ? Kernel.to_s(ct) : nil)
    end

    def _set_content_type(res, content_type, charset)
      type = content_type || ""
      type = "#{type}; charset=#{String.downcase(charset)}" if charset
      set_header(res, content_type_key, type)
    end

    def before_committed(res)
      return nil if committed?(res)
      assign_default_content_type_and_charset!(res)
      merge_and_normalize_cache_control!(res, @_cache_control || Hash.new)
      handle_conditional_get!(res)
      handle_no_content!(res)
    end

    def before_sending(res)
      commit!(res) unless committed?(res)
    end

    def assign_default_content_type_and_charset!(res)
      return nil if media_type(res)
      ct = parsed_content_type_header(res)
      _set_content_type(res, ContentTypeHeader.mime_type(ct) || Mime::Type.to_s(Mime.fetch(:html) || Mime.ALL),
        ContentTypeHeader.charset(ct) || Response.default_charset)
    end

    def handle_no_content!(res)
      if Array.include?(no_content_codes, @status)
        Hash.delete(@headers, content_type_key)
        Hash.delete(@headers, "content-length")
      end
      nil
    end

    def rack_response(res, status, headers)
      Array.include?(no_content_codes, status) ? [status, headers, String[]] : [status, headers, body_parts(res)]
    end

    # --- Http::Cache::Response ---
    def cache_control(res) = @_cache_control ||= Hash.new

    def last_modified(res)
      last = get_header(res, "last-modified")
      last ? Time.httpdate(Kernel.to_s(last)) : nil
    end
    def last_modified?(res) = has_header?(res, "last-modified")
    def set_last_modified(res, utc_time) = set_header(res, "last-modified", Time.httpdate(utc_time))

    def date(res)
      d = get_header(res, "date")
      d ? Time.httpdate(Kernel.to_s(d)) : nil
    end
    def date?(res) = has_header?(res, "date")
    def set_date(res, utc_time) = set_header(res, "date", Time.httpdate(utc_time))

    # Sets a weak ETag validator on the response (a String, Integer or an Array of them).
    def set_etag(res, weak_validators) = set_weak_etag(res, weak_validators)
    def set_weak_etag(res, weak_validators) = set_header(res, "etag", "W/#{generate_strong_etag(res, weak_validators)}")
    def set_strong_etag(res, strong_validators) = set_header(res, "etag", generate_strong_etag(res, strong_validators))

    def etag(res) = get_header(res, "etag")
    def etag?(res) = etag(res) != nil
    def weak_etag?(res) = etag?(res) && String.start_with?(Kernel.to_s(etag(res)), "W/\"")
    def strong_etag?(res) = etag?(res) && !weak_etag?(res)

    def special_keys = once { Set.of("extras", "no-store", "no-cache", "max-age", "public", "private", "must-revalidate", "must-understand") }

    # ActiveSupport::Digest.hexdigest(ActiveSupport::Cache.expand_cache_key(validators)), with MD5 (the default
    # hash_digest_class outside an app)
    def generate_strong_etag(res, validators) = "\"#{Digest::MD5.hexdigest(expand_cache_key(validators))}\""
    def expand_cache_key(key)
      case key
      in Array then Array.join(Array.map(key) { |k| expand_cache_key(k) }, "/")
      else Kernel.to_s(key)
      end
    end

    def cache_control_segments(res)
      cc = cache_control_header(res)
      cc ? String.split(String.delete(Kernel.to_s(cc), " "), ",") : nil
    end

    def cache_control_headers(res)
      cache_control = Hash.new
      segs = cache_control_segments(res)
      if segs
        Array.each(segs) do |segment|
          directive, eq, argument = String.partition(segment, "=")
          if Set.include?(special_keys, directive)
            cache_control[String.to_sym(String.tr(directive, "-", "_"))] = eq == "" ? true : argument
          else
            extras = cache_control[:extras]
            if extras in Array
              Array.push(extras, segment)
            else
              cache_control[:extras] = String[segment]
            end
          end
        end
      end
      cache_control
    end

    def prepare_cache_control!(res) = @_cache_control = cache_control_headers(res)

    def default_cache_control = "max-age=0, private, must-revalidate"

    def handle_conditional_get!(res)
      # Normally default cache control setting is handled by ETag middleware. But, if an etag is already set, the
      # middleware defaults to `no-cache` unless a default `Cache-Control` value is previously set. So, set a
      # default one here.
      if (etag?(res) || last_modified?(res)) && !cache_control_header(res)
        set_cache_control_header(res, default_cache_control)
      end
      nil
    end

    def merge_and_normalize_cache_control!(res, cache_control)
      control = cache_control_headers(res)
      return nil if Hash.empty?(control) && Hash.empty?(cache_control)          # Let middleware handle default behavior

      if !Hash.empty?(cache_control)
        Hash.delete(control, :no_cache)
        Hash.delete(control, :no_store)
        extras = Hash.delete(control, :extras)
        if extras in Array
          mine = cache_control[:extras]
          cache_control[:extras] = (mine in Array) ? Array.uniq(mine + extras) : extras
        end
        Hash.merge!(control, cache_control)
      end

      options = String[]
      if control[:no_store]
        Array.push(options, "private") if control[:private]
        Array.push(options, "must-understand") if control[:must_understand]
        Array.push(options, "no-store")
      elsif control[:no_cache]
        Array.push(options, "public") if control[:public]
        Array.push(options, "no-cache")
        ex = control[:extras]
        Array.concat(options, ex) if ex in Array
      else
        extras = control[:extras]
        max_age = control[:max_age]
        stale_while_revalidate = control[:stale_while_revalidate]
        stale_if_error = control[:stale_if_error]

        Array.push(options, "max-age=#{String.to_i(Kernel.to_s(max_age))}") if max_age
        Array.push(options, control[:public] ? "public" : "private")
        Array.push(options, "must-revalidate") if control[:must_revalidate]
        Array.push(options, "stale-while-revalidate=#{String.to_i(Kernel.to_s(stale_while_revalidate))}") if stale_while_revalidate
        Array.push(options, "stale-if-error=#{String.to_i(Kernel.to_s(stale_if_error))}") if stale_if_error
        Array.push(options, "immutable") if control[:immutable]
        Array.concat(options, extras) if extras in Array
      end

      set_cache_control_header(res, Array.join(options, ", "))
    end
  end
end
