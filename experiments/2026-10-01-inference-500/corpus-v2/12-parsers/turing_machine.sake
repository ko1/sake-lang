Rule = Struct.new(:write, :move, :next_state)
Machine = Struct.new(:name, :start, :accept, :rules)
SpecError = Exception.new(:line)

def parse_machine(name, text)
  rules = Hash[]
  start = nil
  accept = Set[]
  Array.each_with_index(String.lines(text)) do |raw, i|
    line = String.strip(String.sub(raw, /#.*/, ""))
    next if String.empty?(line)
    if (m = String.match(line, /\Astart\s+(\w+)\z/))
      start = m[1]
    elsif (m = String.match(line, /\Aaccept\s+(.+)\z/))
      Array.each(String.split(m[1], " ")) { |s| Set.add(accept, s) }
    elsif (m = String.match(line, /\A(\w+)\s+(\S)\s*->\s*(\w+)\s+(\S)\s+([LRN])\z/))
      key = [m[1], m[2]]
      raise SpecError.new("duplicate rule for #{m[1]}/#{m[2]}", i + 1) if Hash.key?(rules, key)
      rules[key] = Rule.new(m[4], m[5], m[3])
    else
      raise SpecError.new("cannot parse '#{line}'", i + 1)
    end
  end
  raise SpecError.new("no start state", 0) if start == nil
  Machine.new(name, start, accept, rules)
end

def run(machine, input, limit)
  tape = Hash[]
  Array.each_with_index(String.chars(input)) { |c, i| tape[i] = c }
  head = 0
  state = Machine.get_start(machine)
  steps = 0
  rules = Machine.get_rules(machine)
  while steps < limit
    break if Set.include?(Machine.get_accept(machine), state)
    sym = Hash.fetch(tape, head, "_")
    rule = rules[[state, sym]]
    break if rule == nil
    tape[head] = Rule.get_write(rule)
    move = Rule.get_move(rule)
    head += 1 if move == "R"
    head -= 1 if move == "L"
    state = Rule.get_next_state(rule)
    steps += 1
  end
  cells = Array.select(Hash.keys(tape)) { |k| tape[k] != "_" }
  shown = if Array.empty?(cells)
            ""
          else
            Array.join(Range.map(Array.min(cells)..Array.max(cells)) { |k| Hash.fetch(tape, k, "_") })
          end
  status = if Set.include?(Machine.get_accept(machine), state)
             "accept"
           elsif steps >= limit
             "timeout"
           else
             "halt in #{state}"
           end
  {tape: shown, steps: steps, status: status}
end

def increment_spec
  <<~TM
    # binary increment: move to the right end, then add one with carry
    start right
    accept done
    right 0 -> right 0 R
    right 1 -> right 1 R
    right _ -> carry _ L
    carry 1 -> carry 0 L
    carry 0 -> done 1 N
    carry _ -> done 1 N
  TM
end

def palindrome_spec
  <<~TM
    start s
    accept yes
    s a -> ha _ R
    s b -> hb _ R
    s _ -> yes _ N
    ha a -> ha a R
    ha b -> ha b R
    ha _ -> ca _ L
    hb a -> hb a R
    hb b -> hb b R
    hb _ -> cb _ L
    ca a -> back _ L
    ca _ -> yes _ N
    cb b -> back _ L
    cb _ -> yes _ N
    back a -> back a L
    back b -> back b L
    back _ -> s _ R
  TM
end

def beaver_spec
  <<~TM
    start A
    accept H
    A _ -> B 1 R
    A 1 -> C 1 L
    B _ -> A 1 L
    B 1 -> B 1 R
    C _ -> B 1 L
    C 1 -> H 1 N
  TM
end

def broken_specs
  Array["start q\nq 1 -> q 1 R\nq 1 -> q 0 L\n", "start q\nq 1 => q 1 R\n", "q 1 -> q 1 R\n"]
end

jobs = Array[
  ["increment", increment_spec, Array["1011", "111", "0", ""]],
  ["palindrome", palindrome_spec, Array["abba", "aba", "abab", "", "bbbab"]],
  ["beaver3", beaver_spec, Array[""]]
]
Array.each(jobs) do |name, spec, inputs|
  machine = parse_machine(name, spec)
  puts("#{name}: #{Hash.size(Machine.get_rules(machine))} rules")
  Array.each(inputs) do |input|
    run(machine, input, 1000) => {tape:, steps:, status:}
    puts(format("  %-8s -> %-8s %4d steps  %s", Kernel.inspect(input), tape, steps, status))
  end
end
Array.each(broken_specs) do |spec|
  begin
    parse_machine("broken", spec)
  rescue SpecError => e
    puts("spec error (line #{SpecError.get_line(e)}): #{Exception.message(e)}")
  end
end
