# A field's reader has the field's name: Node.left(n), n.Node.left. Writes: Node.set_left(n, v),
# n.Node.left = v, and n.Node.count += 1 (||=, &&=) with n evaluated once.
class Node
  attr_reader val
  attr_accessor left = nil, count = 0, label = nil
  def depth(n)                                       # unqualified inside the class
    l = left(n)
    l ? 1 + depth(l) : 1
  end
end
a = Node.new(1, Node.new(2, Node.new(3)))
p(Node.val(a))
l = a.Node.left
p(l.Node.val) if l
p(Node.depth(a))
a.Node.count += 1
a.Node.count += 2
a.Node.label ||= "first"
a.Node.label ||= "second"
a.Node.left = nil
p([a.Node.count, a.Node.label, Node.depth(a)])

class Temp
  attr_reader celsius
  def celsius(t) = Arithmetic.round(@celsius, 1)   # a function named like a field replaces its reader
end
p(Temp.celsius(Temp.new(21.456)))
