# Status (2026-10-09): fixed the same day: a missing Symbol value is [mixed] only when a field of several types holds that very value.
# A case/in over a Symbol field that misses a branch is reported as [mixed] (not [type]) and the hint
# blames an unrelated field of another type that happens to hold a Symbol among other values.
# Seen in liquid.sake: `case LTok.kind(t)` without `in :tag` → "no `in` branch matches :tag [mixed]
# hint: LExpr.value holds Symbol (written at ...) besides String, Boolean, Integer, Float".
# Expected: [type], and no hint about LExpr.value (bin/sake --strict FILE).
class Tok
  attr_reader kind
end

class Lit
  attr_reader value
end

def name(t)
  case Tok.kind(t)
  in :text then "text"
  in :var then "var"
  end
end

lits = Array[Lit.new("s"), Lit.new(1), Lit.new(:empty)]
puts(Array.size(lits))
puts(name(Tok.new(:text)))
puts(name(Tok.new(:tag)))
