# Status (2026-10-04): fixed.
# Bug: after `return xs unless block_given?`, the checker still types the rest of the function for a
# call without a block, so the result is `nil | Array` and a yield there is "no block is given".
# The same function written as `if block_given? ... else xs end` checks (Ruby prints 2, 1, 2).
# Workaround in csv.sake (parse, open): if/else on block_given?.
def rows(xs)
  return xs unless block_given?
  Array.each(xs) { |x| yield(x) }
  nil
end
p(Array.size(rows(Array[1, 2])))
rows(Array[1, 2]) { |x| p(x) }
