# (Sake only) The protocol of ActionDispatch's middleware and endpoints.
#
# A Rails middleware is a Rack app: `call(env)`, and it reads its state from the env through `Request.new(env)`.
# Sake's Rack env holds only Strings (sakelib/rack.sake), so ActionDispatch passes the one ActionDispatch::Request
# down the stack instead: a middleware or endpoint is a type that includes ActionDispatch::App and defines
# `call(app, req)` returning Rack's triple `[status, headers, body]`. RackApp is the Rack app in front of the stack
# (it makes the Request from the env, as RouteSet#call and every middleware do in Rails), and Rack apps mounted in
# the routes or used as middleware are called with `Rack::App.call(app, ActionDispatch::Request.env(req))`.

require "rack"
require "http/request"

module ActionDispatch
  module App
    def call(app, req) = raise(NotImplementedError)
  end

  # Rack's view of an ActionDispatch stack: `Rack::App.call(ActionDispatch::RackApp.new(stack), env)`.
  class RackApp
    attr_reader app
    include Rack::App
    def call(ra, env) = App.call(@app, Request.new(env))
  end
end
