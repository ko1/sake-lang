# Errors: the one-line reports of the four phases (SPEC section 1), and the two
# exceptions a running Mini program can catch (section 9).

# A source range, 1-based, from its first to its last character (inclusive).
class Span
  attr_reader line, col, end_line, end_col
end

module Spans
  module_function

  # From the start of a to the end of b.
  def join(a, b) = Span.new(Span.line(a), Span.col(a), Span.end_line(b), Span.end_col(b))
end

# A lexical, syntax or static error. It stops the run before evaluation starts.
# kind is "lexical", "syntax" or "static".
CompileError = Exception.new(:kind, :span)

# A runtime error raised by an operation: kind is one of the kinds of SPEC
# section 9 ("type", "index", "key", "zero", "arity", "value", "name", "stack",
# "assert"). A `catch` receives it as an error map.
MiniFault = Exception.new(:kind, :span)

# A value thrown by `throw`, at the range of the `throw` statement.
MiniThrow = Exception.new(:value, :span)

# A broken invariant of this interpreter (never a property of the Mini program).
InternalError = Exception.new

module Fail
  module_function

  def lexical(sp, message) = raise(CompileError.new(message, "lexical", sp))

  def syntax(sp, message) = raise(CompileError.new(message, "syntax", sp))

  def static(sp, message) = raise(CompileError.new(message, "static", sp))

  def runtime(kind, sp, message) = raise(MiniFault.new(message, kind, sp))

  def internal(message) = raise(InternalError.new(message))

  # The report line: `<kind> error at <line>:<col>-<end line>:<end col>: <message>`.
  def report(kind, sp, message)
    "#{kind} error at #{Span.line(sp)}:#{Span.col(sp)}-#{Span.end_line(sp)}:#{Span.end_col(sp)}: #{message}"
  end

  # "1 argument", "2 arguments".
  def count_of(n, noun) = n == 1 ? "#{n} #{noun}" : "#{n} #{noun}s"

  # The arity message shared by the static check and the call (SPEC 6.6).
  # max is -1 when there is no maximum.
  def arity_message(name, min, max, got)
    if max < 0
      "#{name} expects at least #{count_of(min, "argument")}, got #{got}"
    elsif min == max
      "#{name} expects #{count_of(min, "argument")}, got #{got}"
    else
      "#{name} expects #{min} to #{max} arguments, got #{got}"
    end
  end
end
