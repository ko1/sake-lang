# Integer partitions: enumeration with a generator (yield), counting by dynamic
# programming, Euler's distinct/odd parts theorem, and the pentagonal recurrence.

def each_partition(n, max_part, prefix, &block)
  if n == 0
    yield(prefix)
    return
  end
  Integer.downto(Array.min(Array[n, max_part]), 1) do |part|
    each_partition(n - part, part, prefix + Array[part], &block)
  end
end

def count_table(limit, parts)
  ways = Array[1] + Array[0] * limit
  Array.each(parts) do |part|
    Range.each(part..limit) { |s| ways[s] += ways[s - part] }
  end
  ways
end

def distinct_count(limit)
  ways = Array[1] + Array[0] * limit
  Range.each(1..limit) do |part|
    Integer.downto(limit, part) { |s| ways[s] += ways[s - part] }
  end
  ways
end

def pentagonal_p(limit)
  p = Integer[1]
  Range.each(1..limit) do |n|
    total = 0
    k = 1
    while true
      g1 = k * (3 * k - 1) / 2
      break if g1 > n
      sign = Integer.odd?(k) ? 1 : -1
      total += sign * p[n - g1]
      g2 = k * (3 * k + 1) / 2
      total += sign * p[n - g2] if g2 <= n
      k += 1
    end
    Array.push(p, total)
  end
  p
end

puts("partitions of 7:")
all7 = Array[]
each_partition(7, 7, Array[]) { |parts| Array.push(all7, parts) }
Array.each_slice(all7, 5) do |row|
  puts("  " + Array.join(Array.map(row) { |ps| Array.join(ps, "+") }, "   "))
end
puts("  total #{Array.size(all7)}")

by_len = Array.group_by(all7) { |ps| Array.size(ps) }
puts("  by number of parts: " + Array.join(Array.map(Array.sort(Hash.keys(by_len))) { |k| "#{k}:#{Array.size(by_len[k])}" }, " "))

limit = 60
pn = count_table(limit, Range.to_a(1..limit))
pent = pentagonal_p(limit)
puts("p(n) for n = 0..20: #{Array.join(Array.take(pn, 21), " ")}")
puts("p(#{limit}) = #{pn[limit]}, pentagonal recurrence agrees: #{pn == pent}")

distinct = distinct_count(limit)
odd = count_table(limit, Range.select(1..limit) { |k| Integer.odd?(k) })
puts("distinct parts = odd parts up to #{limit}: #{distinct == odd}")
puts("q(n) for n = 0..20: #{Array.join(Array.take(distinct, 21), " ")}")

coins = Integer[1, 5, 10, 25, 50]
change = count_table(100, coins)
puts("ways to make change: 25c=#{change[25]} 50c=#{change[50]} 100c=#{change[100]}")

puts("Ramanujan congruences:")
Array.each(Array[[5, 4], [7, 5], [11, 6]]) do |m, r|
  idx = Array.select(Range.to_a(0..limit)) { |n| n % m == r }
  holds = Array.all?(idx) { |n| pn[n] % m == 0 }
  puts("  p(#{m}k+#{r}) = 0 mod #{m} for #{Array.size(idx)} values: #{holds}")
end

growth = Array.map(Integer[10, 20, 30, 40, 50, 60]) do |n|
  approx = Math.exp(3.14159265358979 * Math.sqrt(2.0 * n / 3)) / (4 * n * Math.sqrt(3))
  format("%d:%.3f", n, pn[n] / approx)
end
puts("p(n) / Hardy-Ramanujan estimate: #{Array.join(growth, " ")}")
