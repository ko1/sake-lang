# Port of activesupport-8.1.3/lib/active_support/core_ext/numeric/conversions.rb (partial: no options Hash)

require "../../number_helper"

module Numeric
  # Ruby: to_fs(format = nil, options = nil): :phone, :currency, :percentage, :delimited, :rounded, :human, :human_size.
  def to_fs(n, format = :default)
    case format
    in :phone then ActiveSupport::NumberHelper.number_to_phone(n)
    in :currency then ActiveSupport::NumberHelper.number_to_currency(n)
    in :percentage then ActiveSupport::NumberHelper.number_to_percentage(n)
    in :delimited then ActiveSupport::NumberHelper.number_to_delimited(n)
    in :rounded then ActiveSupport::NumberHelper.number_to_rounded(n)
    in :human then ActiveSupport::NumberHelper.number_to_human(n)
    in :human_size then ActiveSupport::NumberHelper.number_to_human_size(n)
    else Kernel.to_s(n)
    end
  end

  def to_formatted_s(n, format = :default) = to_fs(n, format)
end
