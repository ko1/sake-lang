def corpus
  "The quick brown fox jumps over the lazy dog. The dog sleeps! " +
  "Does the fox care? Not at all; the fox simply runs away into the forest, " +
  "where other foxes are waiting. Reading level formulas count syllables, words, and sentences. " +
  "They are crude, but they are surprisingly useful for comparing two drafts of the same text."
end

def stopwords = Set["the", "a", "an", "and", "of", "at", "are", "for", "but", "they", "into", "over", "not", "all"]

def sentences(text)
  parts = String.split(text, /(?<=[.!?])\s+/)
  Array.reject(Array.map(parts) { |s| String.strip(s) }) { |s| String.empty?(s) }
end

def words(text) = String.scan(String.downcase(text), /[a-z']+/)

def syllables(word)
  w = String.sub(word, /e\z/, "")
  groups = String.scan(w, /[aeiouy]+/)
  n = Array.size(groups)
  n < 1 ? 1 : n
end

def flesch(word_count, sentence_count, syllable_count)
  206.835 - 1.015 * (Integer.to_f(word_count) / sentence_count) - 84.6 * (Integer.to_f(syllable_count) / word_count)
end

def top_words(ws, n)
  counts = Hash.new(0)
  Array.each(ws) { |w| counts[w] += 1 unless Set.include?(stopwords, w) }
  Array.take(Hash.sort_by(counts) { |w, c| [-c, w] }, n)
end

def histogram(ws)
  by_len = Array.group_by(ws) { |w| String.size(w) }
  lens = Array.sort(Hash.keys(by_len))
  Array.each(lens) do |len|
    count = Array.size(by_len[len])
    puts(format("  %2d | %-12s %d", len, "#" * count, count))
  end
end

text = corpus
ss = sentences(text)
ws = words(text)
syl = Array.sum(ws) { |w| syllables(w) }
puts("sentences: #{Array.size(ss)}")
puts("words:     #{Array.size(ws)}")
puts("unique:    #{Array.size(Array.uniq(ws))}")
puts("syllables: #{syl}")
puts(format("avg word length: %.2f", Integer.to_f(Array.sum(ws) { |w| String.size(w) }) / Array.size(ws)))
score = flesch(Array.size(ws), Array.size(ss), syl)
level = if score >= 80 then "easy" elsif score >= 60 then "standard" elsif score >= 30 then "difficult" else "very difficult" end
puts(format("flesch reading ease: %.1f (%s)", score, level))

longest = Array.max_by(ss) { |s| Array.size(words(s)) }
puts("longest sentence (#{Array.size(words(longest))} words): #{longest}")
kinds = Array.tally(Array.map(ss) { |s| s[-1] })
puts("endings: " + Array.join(Hash.map(kinds) { |k, v| "#{k} x#{v}" }, ", "))

puts("top words:")
Array.each(top_words(ws, 6)) { |w, c| puts("  #{String.ljust(w, 10)} #{c}") }
puts("word lengths:")
histogram(ws)
