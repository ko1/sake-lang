<!DOCTYPE html>
<html>
<head>
  <title><%= content_for?(view, :title) ? yield(:title) : "Blog" %></title>
  <%= csrf_meta_tags view %>
</head>
<body>
<p class="user"><%= greeting view, "Hello" %> <%= current_user view %> on <%= controller_name view %>#<%= action_name view %></p>
<% if notice(view) %><p class="notice"><%= notice view %></p><% end %>
<%= yield %>
</body>
</html>
