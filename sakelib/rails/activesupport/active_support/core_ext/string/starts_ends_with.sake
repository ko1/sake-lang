# Port of activesupport-8.1.3/lib/active_support/core_ext/string/starts_ends_with.rb, string/exclude.rb and string/strip.rb (three one-method files)

class String
  def starts_with?(s, prefix) = String.start_with?(s, prefix)
  def ends_with?(s, suffix) = String.end_with?(s, suffix)
  def exclude?(s, string) = !String.include?(s, string)

  def strip_heredoc(s)
    indents = String.scan(s, /^[ \t]*(?=\S)/).Array.map { |m| Kernel.to_s(m) }
    String.gsub(s, Regexp.new("^#{Array.min(indents) || ""}"), "")
  end
end
