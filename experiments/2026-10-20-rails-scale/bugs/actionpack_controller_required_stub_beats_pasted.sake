# (Seen 2026-10-20 ~20:40 UTC, right after lib/sake/resolver.rb changed, presumably for
# actionpack_controller_include_lost_in_second_paste.sake.) A required function of M (body `raise NotImplementedError`)
# is no longer satisfied by the function B pasted from A (B < A, B includes M): "B | C includes M but does not
# define name, which M requires". Before the change it was. In Ruby M#name would win (B, M, A) and raise, but in
# Sake a required function is a declaration, not a body, so A's `name` should fulfil it. Found by part 8:
# AbstractController::Callbacks requires action_name, which every controller pastes from AbstractController::Base;
# all controller tests failed with NotImplementedError. Workaround: no required stub; a mixin function that calls
# the bare name (an implicit requirement) is dispatched instead (Callbacks.callbacks_action_name).
module M
  def name(x) = raise(NotImplementedError)
  def show(x) = "M sees #{name(x)}"
end
class A
  attr_reader v
  def name(x) = "A's name"
end
class B < A
  include M
end
class C < B
end
p(B.show(B.new(1)), C.show(C.new(1)), M.name(C.new(1)))
