# Port of activemodel-8.1.3/lib/active_model/access.rb
#
# Ruby's public_send(method) is the record's generated __send (the class's attribute and declared names).

require "rails/activesupport/active_support/hash_with_indifferent_access"
require "send"

module ActiveModel
  module Access
    include ActiveModel::Send

    def slice(r, *methods)
      h = Hash.new
      Array.each(Array.flatten(methods)) { |m| h[Kernel.to_s(m)] = __send(r, Kernel.to_s(m).String.to_sym) }
      ActiveSupport::HashWithIndifferentAccess.make(h)
    end

    def values_at(r, *methods) = Array.map(Array.flatten(methods)) { |m| __send(r, Kernel.to_s(m).String.to_sym) }
  end
end
