# Port of activesupport-8.1.3/lib/active_support/security_utils.rb

module ActiveSupport
  module SecurityUtils
    module_function

    def fixed_length_secure_compare(a, b)
      raise ArgumentError, "string length mismatch." unless String.bytesize(a) == String.bytesize(b)
      l = String.bytes(a)
      res = 0
      String.bytes(b).Array.each_with_index { |byte, i| res |= byte ^ Array.fetch(l, i) }
      res == 0
    end

    def secure_compare(a, b) = String.bytesize(a) == String.bytesize(b) && fixed_length_secure_compare(a, b)
  end
end
