NegativeCycle = Exception.new(:node)

class Graph
  attr_reader names, index, edges
  def build(edge_list)
    names = Array[]
    index = Hash[]
    Array.each(edge_list) do |from, to, w|
      Array.each(Array[from, to]) do |name|
        unless Hash.key?(index, name)
          index[name] = Array.size(names)
          Array.push(names, name)
        end
      end
    end
    Graph.new(names, index, edge_list)
  end
  def size(g) = Array.size(@names)
end

def all_pairs(g)
  n = Graph.size(g)
  index = Graph.get_index(g)
  dist = Range.map(0...n) { |i| Range.map(0...n) { |j| i == j ? 0 : nil } }
  nxt = Range.map(0...n) { |i| Range.map(0...n) { |j| i == j ? j : nil } }
  Array.each(Graph.get_edges(g)) do |from, to, w|
    i = index[from]
    j = index[to]
    old = dist[i][j]
    if old == nil || w < old
      dist[i][j] = w
      nxt[i][j] = j
    end
  end
  Integer.times(n) do |k|
    Integer.times(n) do |i|
      ik = dist[i][k]
      next if ik == nil
      Integer.times(n) do |j|
        kj = dist[k][j]
        next if kj == nil
        cur = dist[i][j]
        if cur == nil || ik + kj < cur
          dist[i][j] = ik + kj
          nxt[i][j] = nxt[i][k]
        end
      end
    end
  end
  Integer.times(n) do |i|
    raise NegativeCycle.new("negative cycle", Graph.get_names(g)[i]) if dist[i][i] < 0
  end
  [dist, nxt]
end

def route(g, nxt, from, to)
  index = Graph.get_index(g)
  names = Graph.get_names(g)
  i = index[from]
  j = index[to]
  return nil if nxt[i][j] == nil
  path = Array[from]
  while i != j
    i = nxt[i][j]
    Array.push(path, names[i])
  end
  path
end

def print_matrix(g, dist)
  names = Graph.get_names(g)
  puts("        " + Array.join(Array.map(names) { |nm| String.rjust(nm, 7) }, ""))
  Array.each_with_index(dist) do |row, i|
    cells = Array.map(row) { |d| String.rjust(d == nil ? "-" : Integer.to_s(d), 7) }
    puts("  " + String.ljust(names[i], 6) + Array.join(cells, ""))
  end
end

roads = Array[
  ["Oslo", "Bergen", 7], ["Oslo", "Lund", 9], ["Oslo", "Kiel", 14],
  ["Bergen", "Lund", 10], ["Bergen", "Turku", 15], ["Lund", "Turku", 11],
  ["Lund", "Kiel", 2], ["Kiel", "Riga", 9], ["Turku", "Riga", 6],
  ["Riga", "Oslo", 20], ["Turku", "Bergen", 15], ["Kiel", "Oslo", 14]
]
g = Graph.build(roads)
dist, nxt = all_pairs(g)
puts("shortest travel times:")
print_matrix(g, dist)

queries = Array[["Oslo", "Riga"], ["Bergen", "Kiel"], ["Riga", "Bergen"], ["Turku", "Lund"]]
Array.each(queries) do |from, to|
  path = route(g, nxt, from, to)
  i = Graph.get_index(g)[from]
  j = Graph.get_index(g)[to]
  if path
    puts("#{from} -> #{to}: #{dist[i][j]} via #{Array.join(path, " > ")}")
  else
    puts("#{from} -> #{to}: unreachable")
  end
end

names = Graph.get_names(g)
ecc = Array.map(Range.to_a(0...Graph.size(g))) do |i|
  reach = Array.compact(dist[i])
  [names[i], Array.max(reach)]
end
center = Array.min_by(ecc) { |name, worst| worst }
puts("best hub: #{center[0]} (farthest city #{center[1]} away)")

oneway = Graph.build(Array[["A", "B", 3], ["B", "C", 4], ["D", "C", 1]])
d2, n2 = all_pairs(oneway)
print_matrix(oneway, d2)
p(route(oneway, n2, "C", "A"))

begin
  all_pairs(Graph.build(Array[["x", "y", 2], ["y", "z", -5], ["z", "x", 1]]))
rescue NegativeCycle => e
  puts("#{Exception.message(e)} through #{NegativeCycle.get_node(e)}")
end
