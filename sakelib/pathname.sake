# pathname: Ruby's Pathname.
#
# The path algorithms are those of Ruby's pathname.rb (chop_basename, plus, cleanpath,
# relative_path_from), on "/" separators only, over the built-in File.basename, dirname, join, ...
# The operations that stat, list, create, or remove go through the built-in File and Dir.

class Pathname
  attr_reader path
  include Arithmetic                       # for + and /

  # Ruby: Pathname.new(s) takes a String (or a Pathname, see Kernel's Pathname()); NUL is an error.
  def initialize(pn)
    @path => String
    raise ArgumentError, "path name contains null byte" if String.include?(@path, "\0")
  end

  def to_s(pn) = @path
  def to_path(pn) = @path
  def inspect(pn) = "#<Pathname:#{@path}>"

  # A String or a Pathname, as the String of its path.
  def path_of(x)
    case x
    in Pathname then Pathname.path(x)
    in String then x
    end
  end

  # Ruby compares paths with "/" sorted before every other character.
  def <=>(a, b) = String.<=>(String.tr(Pathname.path(a), "/", "\0"), String.tr(Pathname.path(b), "/", "\0"))

  # --- pathname.rb's internals, on Strings ---

  # [the path before the last name, the last name], or nil when nothing is left but slashes.
  def chop_basename(path)
    base = File.basename(path)
    return nil if String.match?(base, /\A\/?\z/)
    i = String.rindex(path, base) || 0
    [String.[](path, 0, i) || "", base]
  end

  def split_names(path)
    names = String[]
    while (r = chop_basename(path))
      path, base = r
      Array.unshift(names, base)
    end
    [path, names]
  end

  def prepend_prefix(prefix, relpath)
    if relpath == ""
      File.dirname(prefix)
    elsif String.include?(prefix, "/")
      prefix = File.dirname(prefix)
      prefix = File.join(prefix, "") if File.basename(prefix + "a") != "a"
      prefix + relpath
    else
      prefix + relpath
    end
  end

  def has_trailing_separator?(path)
    r = chop_basename(path)
    return false unless r
    pre, base = r
    String.size(pre) + String.size(base) < String.size(path)
  end

  def add_trailing_separator(path) = File.basename(path + "a") == "a" ? path : File.join(path, "")

  def del_trailing_separator(path)
    r = chop_basename(path)
    if r
      pre, base = r
      pre + base
    elsif (m = String.match(path, /\/+\z/))
      slashes = String.match(File.dirname(path), /\/*\z/)
      MatchData.pre_match(m) + (slashes ? MatchData.to_s(slashes) : "")
    else
      path
    end
  end

  def plus(path1, path2)
    prefix2 = path2
    index_list2 = Integer[]
    basename_list2 = String[]
    while (r2 = chop_basename(prefix2))
      prefix2, basename2 = r2
      Array.unshift(index_list2, String.size(prefix2))
      Array.unshift(basename_list2, basename2)
    end
    return path2 if prefix2 != ""
    prefix1 = path1
    while true
      while Array.first(basename_list2) == "."
        Array.shift(index_list2)
        Array.shift(basename_list2)
      end
      r1 = chop_basename(prefix1)
      break unless r1
      prefix1, basename1 = r1
      next if basename1 == "."
      if basename1 == ".." || Array.empty?(basename_list2) || Array.first(basename_list2) != ".."
        prefix1 = prefix1 + basename1
        break
      end
      Array.shift(index_list2)
      Array.shift(basename_list2)
    end
    has_name = chop_basename(prefix1) != nil
    if !has_name && String.include?(File.basename(prefix1), "/")
      while Array.first(basename_list2) == ".."
        Array.shift(index_list2)
        Array.shift(basename_list2)
      end
    end
    if Array.empty?(basename_list2)
      has_name ? prefix1 : File.dirname(prefix1)
    else
      start = Array.fetch(index_list2, 0)
      suffix2 = String.[](path2, start, String.size(path2) - start) || ""
      has_name ? File.join(prefix1, suffix2) : prefix1 + suffix2
    end
  end

  def cleanpath_aggressive(path)
    names = String[]
    pre = path
    while (r = chop_basename(pre))
      pre, base = r
      if base == ".."
        Array.unshift(names, base)
      elsif base != "."
        if Array.first(names) == ".."
          Array.shift(names)
        else
          Array.unshift(names, base)
        end
      end
    end
    if String.include?(File.basename(pre), "/")
      Array.shift(names) while Array.first(names) == ".."
    end
    prepend_prefix(pre, File.join(names))
  end

  def cleanpath_conservative(path)
    names = String[]
    pre = path
    while (r = chop_basename(pre))
      pre, base = r
      Array.unshift(names, base) if base != "."
    end
    if String.include?(File.basename(pre), "/")
      Array.shift(names) while Array.first(names) == ".."
    end
    return File.dirname(pre) if Array.empty?(names)
    Array.push(names, ".") if Array.last(names) != ".." && File.basename(path) == "."
    result = prepend_prefix(pre, File.join(names))
    last = Array.last(names) || ""
    if last != "." && last != ".." && has_trailing_separator?(path)
      add_trailing_separator(result)
    else
      result
    end
  end

  # --- the API ---

  def +(pn, other) = Pathname.new(plus(@path, path_of(other)))
  def /(pn, other) = pn + other

  def join(pn, *args)
    return pn if Array.empty?(args)
    last = Array.pop(args)
    last => Pathname | String
    result = Pathname.new(path_of(last))
    return result if absolute?(result)
    Array.each(Array.reverse(args)) do |arg|
      result = Pathname.new(path_of(arg)) + result
      return result if absolute?(result)
    end
    pn + result
  end

  def parent(pn) = pn + ".."
  def absolute?(pn) = String.start_with?(@path, "/")
  def relative?(pn) = !absolute?(pn)
  def root?(pn) = chop_basename(@path) == nil && String.include?(@path, "/")

  def cleanpath(pn, consider_symlink = false)
    Pathname.new(consider_symlink ? cleanpath_conservative(@path) : cleanpath_aggressive(@path))
  end

  def basename(pn, suffix = "") = Pathname.new(File.basename(@path, suffix))
  def dirname(pn) = Pathname.new(File.dirname(@path))
  def extname(pn) = File.extname(@path)
  def split(pn) = [dirname(pn), basename(pn)]

  def sub_ext(pn, repl)
    ext = File.extname(@path)
    Pathname.new(String.[](@path, 0, String.size(@path) - String.size(ext)) + repl)
  end

  def sub(pn, pattern, repl) = Pathname.new(String.sub(@path, pattern, repl))

  # Without a block, an Array (Ruby: an Enumerator).
  def each_filename(pn)
    _, names = split_names(@path)
    return names unless block_given?
    Array.each(names) { |name| yield name }
    nil
  end

  def ascend(pn)
    list = Pathname[pn]
    path = @path
    while (r = chop_basename(path))
      path, _ = r
      break if path == ""
      Array.push(list, Pathname.new(del_trailing_separator(path)))
    end
    return list unless block_given?
    Array.each(list) { |v| yield v }
    nil
  end

  def descend(pn)
    list = Array.reverse(ascend(pn))
    return list unless block_given?
    Array.each(list) { |v| yield v }
    nil
  end

  def relative_path_from(pn, base_directory)
    dest_directory = Pathname.path(cleanpath(pn))
    base_dir = Pathname.path(cleanpath(Pathname.new(path_of(base_directory))))
    dest_prefix = dest_directory
    dest_names = String[]
    while (r = chop_basename(dest_prefix))
      dest_prefix, base = r
      Array.unshift(dest_names, base) if base != "."
    end
    base_prefix = base_dir
    base_names = String[]
    while (r = chop_basename(base_prefix))
      base_prefix, base = r
      Array.unshift(base_names, base) if base != "."
    end
    if dest_prefix != base_prefix
      raise ArgumentError, "different prefix: #{Kernel.inspect(dest_prefix)} and #{Kernel.inspect(base_dir)}"
    end
    while !Array.empty?(dest_names) && !Array.empty?(base_names) && Array.first(dest_names) == Array.first(base_names)
      Array.shift(dest_names)
      Array.shift(base_names)
    end
    raise ArgumentError, "base_directory has ..: #{Kernel.inspect(base_dir)}" if Array.include?(base_names, "..")
    names = Array.map(base_names) { ".." } + dest_names
    Pathname.new(Array.empty?(names) ? "." : File.join(names))
  end

  # --- through File and Dir ---

  def exist?(pn) = File.exist?(@path)
  def file?(pn) = File.file?(@path)
  def directory?(pn) = File.directory?(@path)
  def symlink?(pn) = File.symlink?(@path)
  def zero?(pn) = File.zero?(@path)
  def empty?(pn) = File.directory?(@path) ? Dir.empty?(@path) : File.empty?(@path)
  def size(pn) = File.size(@path)
  def mtime(pn) = File.mtime(@path)
  def ftype(pn) = File.ftype(@path)
  def read(pn) = File.read(@path)
  def readlines(pn) = File.readlines(@path)
  def write(pn, s) = File.write(@path, s)
  def rename(pn, to) = File.rename(@path, path_of(to))
  def mkdir(pn) = Dir.mkdir(@path)
  def rmdir(pn) = Dir.rmdir(@path)

  # Ruby's Pathname#delete: rmdir for a directory, unlink for anything else.
  def delete(pn) = File.directory?(@path) && !File.symlink?(@path) ? Dir.rmdir(@path) : File.delete(@path)
  def unlink(pn) = delete(pn)

  def expand_path(pn, dir = nil)
    return Pathname.new(File.expand_path(@path)) if dir == nil
    Pathname.new(File.expand_path(@path, path_of(dir)))
  end

  def realpath(pn, dir = nil)
    return Pathname.new(File.realpath(@path)) if dir == nil
    Pathname.new(File.realpath(@path, path_of(dir)))
  end

  def pwd = Pathname.new(Dir.pwd)
  def getwd = Pathname.new(Dir.pwd)

  # The entries but "." and "..", as Pathnames joined to pn (with_directory) or bare names, in the
  # directory's own order (as Ruby; sort for a stable order).
  def children(pn, with_directory = true)
    Array.map(Dir.children(@path)) { |e| Pathname.new(with_directory ? File.join(@path, e) : e) }
  end

  def each_child(pn, with_directory = true)
    list = children(pn, with_directory)
    return list unless block_given?
    Array.each(list) { |c| yield c }
    list
  end

  def entries(pn) = Array.map(Dir.entries(@path)) { |e| Pathname.new(e) }

  # Ruby's Pathname.glob(pattern, base: dir) given a pattern, and Pathname#glob(pattern) given a
  # Pathname: the matches under it, joined to it. One name for both, as Time.xmlschema in time.sake.
  def glob(x, pattern = "", base: nil)
    case x
    in Pathname
      Array.map(Dir.glob(pattern, base: Pathname.path(x))) { |s| x + s }
    in String | Array
      found = base == nil ? Dir.glob(x) : Dir.glob(x, base: path_of(base))
      Array.map(found) { |s| Pathname.new(s) }
    end
  end

  # Ruby's mkpath (FileUtils.mkdir_p): each missing directory from the top; an existing file raises.
  def mkpath(pn, mode: nil)
    Array.each(descend(pn)) do |d|
      s = Pathname.path(d)
      Dir.mkdir(s) unless File.directory?(s)
    end
    pn
  end

  # Ruby's rmtree (FileUtils.rm_rf): a directory with everything in it; a missing path is no error.
  def rmtree(pn, noop: nil, verbose: nil, secure: nil)
    remove_tree(@path) if File.exist?(@path) || File.symlink?(@path)
    pn
  end

  # Removes a file, or a directory after its contents; a symlink is removed, not followed.
  def remove_tree(path)
    if File.directory?(path) && !File.symlink?(path)
      Array.each(Dir.children(path)) { |c| remove_tree(File.join(path, c)) }
      Dir.rmdir(path)
    else
      File.delete(path)
    end
    nil
  end
end

# Ruby's Kernel#Pathname(x): a Pathname given back as is, a String wrapped.
def Pathname(x)
  case x
  in Pathname then x
  in String then Pathname.new(x)
  end
end
