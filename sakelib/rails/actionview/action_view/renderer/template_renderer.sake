# Port of actionview-8.1.3/lib/action_view/renderer/template_renderer.rb (partial: no file:, inline:, renderable:; locals: are not taken (a compiled template's locals are typed keywords, see generate/templates.sake))
#
# Rails' layout option is a name, a Template or a Proc (the controller's _default_layout, ActionView::Layouts);
# here the Proc is the Symbol :default (or :require, Rails' `layout: true`) and the caller's block is its body:
# `{ |lookup_context, formats, keys, require_layout| ... }`, called with the template's format first, as Rails does.

require "abstract_renderer"
require "../context"

module ActionView
  module TemplateRenderer
    module_function

    def render(view, lookup_context, template: nil, layout: nil, prefixes: nil, plain: nil, html: nil, body: nil, formats: nil)
      rendered = render_to_object(view, lookup_context, template: template, layout: layout, prefixes: prefixes, plain: plain, html: html, body: body, formats: formats)
      AbstractRenderer::RenderedTemplate.body(rendered)
    end

    # Ruby: render(context, options), returning the RenderedTemplate
    def render_to_object(view, lookup_context, template: nil, layout: nil, prefixes: nil, plain: nil, html: nil, body: nil, formats: nil)
      details = LookupContext::Details.dup(LookupContext.details(lookup_context))
      LookupContext::Details.set_formats(details, formats) if formats
      t = determine_template(lookup_context, details, template, prefixes, plain, html, body)
      prepend_formats(lookup_context, Template.format(t))
      # Ruby: render_with_layout: find_layout(path, locals.keys, [formats.first])
      layout_formats = Array.first(LookupContext.formats(lookup_context), 1)
      found = nil
      if layout
        value = case layout
                in :default | :require
                  raise ArgumentError, "a layout Proc (#{Kernel.inspect(layout)}) needs the caller's block" unless block_given?
                  yield(lookup_context, layout_formats, Symbol[], layout == :require)
                else layout
                end
        found = resolve_layout(lookup_context, details, value, layout_formats)
      end
      content = Template.render(t, view) { |buf| Context._compiled(view, Template.method_name(t), buf) }
      if found
        OutputFlow.set(Context.view_flow(view), :layout, content)
        content = Template.render(found, view) { |buf| Context._compiled(view, Template.method_name(found), buf) }
      end
      AbstractRenderer::RenderedTemplate.new(content, t)
    end

    def determine_template(lookup_context, details, template, prefixes, plain, html, body)
      return Template.text(body) if body
      return Template.text(plain) if plain
      return Template.html(html, Array.first(LookupContext.formats(lookup_context)) || :html) if html
      if template
        return LookupContext.find_template(lookup_context, template, prefixes || String[], false, Symbol[], details)
      end
      raise ArgumentError, "You invoked render but did not give any of :body, :file, :html, :inline, :partial, :plain, :renderable, or :template option."
    end

    # Ruby: prepend_formats(template.format)
    def prepend_formats(lookup_context, format)
      return nil if format == nil || LookupContext.html_fallback_for_js(lookup_context)
      LookupContext.set_formats(lookup_context, Array.uniq(Symbol[format] + LookupContext.formats(lookup_context)))
      nil
    end

    # Ruby: resolve_layout(layout, keys, formats): a String layout in the given formats; missing there but present
    # in another format is no layout; a Template is the layout
    def resolve_layout(lookup_context, details, layout, formats)
      case layout
      in String
        raise ArgumentError, "Rendering layouts from an absolute path is not supported." if String.start_with?(layout, "/")
        d = LookupContext::Details.dup(details)
        LookupContext::Details.set_formats(d, formats)
        begin
          LookupContext.find_template(lookup_context, layout, String[], false, Symbol[], d)
        rescue MissingTemplate => e
          all = LookupContext::Details.dup(details)
          LookupContext::Details.set_formats(all, LookupContext.default_formats(lookup_context))
          raise e unless LookupContext.template_exists?(lookup_context, layout, String[], false, Symbol[], all)
          nil
        end
      in Template then layout
      else nil
      end
    end
  end
end
