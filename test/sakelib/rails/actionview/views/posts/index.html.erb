<% content_for view, :title, "Posts" %>
<h1>Posts (<%= Array.size(@posts) %>)</h1>
<%= render @posts %>
<ul>
  <%= render partial: "posts/summary", collection: @posts, as: :item, spacer_template: "posts/spacer" %>
</ul>
<% if Array.empty?(@posts) %>
  <p>No posts.</p>
<% else %>
  <p><%= pluralize view, Array.size(@posts), "post" %> <%== "<b>raw</b>" %></p>
<% end %>
<%= link_to view, "New post", new_post_path(view) %>
