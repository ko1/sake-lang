# IO values: IO.stdin / IO.stdout / IO.stderr, and File.open; operations IO.puts, IO.gets, ...
def log(io, msg) = IO.puts(io, "[log] #{msg}")

out = IO.stdout
IO.puts(out, "hello", 1, Array[2, 3])
IO.print(out, "a", "b\n")
log(out, "to stdout")
log(IO.stderr, "to stderr")
p(out)

path = "io_values.tmp"
File.open(path, "w") { |f| IO.puts(f, "line1", "line2") }
f = File.open(path)
p(IO.gets(f))
p(IO.readlines(f))
p(IO.eof?(f))
IO.close(f)
p(IO.closed?(f))
begin
  IO.gets(f)
rescue IOError => e
  puts("IOError: #{Exception.message(e)}")
end
p(File.open(path) { |g| Array.size(IO.readlines(g)) })
File.delete(path)
