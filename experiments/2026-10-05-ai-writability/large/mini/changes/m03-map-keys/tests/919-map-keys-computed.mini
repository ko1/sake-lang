# keys produced by expressions: comparisons, not, and missing values
let counts = {}
for n in [1, 4, 6, 7, 9, 10] do
  let even = n % 2 == 0
  if not (even in counts) then counts[even] = 0 end
  counts[even] += 1
end
print(counts)
fn nothing() end
let m = {nothing(): "from nil", 1 < 2: "from comparison", not 1: "from not"}
print(m, m[nil], m[true], m[false])
