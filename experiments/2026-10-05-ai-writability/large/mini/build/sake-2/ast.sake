# The syntax tree. Every node records line and col: where errors about it are reported
# (the operator of a binary expression, the `(` of a call, the keyword of a statement, ...).
# A block is an Array of statement nodes.

# ---- Expressions ----

class IntLit
  attr_reader value, line, col
end

class StrLit
  attr_reader value, line, col
end

# A string with interpolations: parts are expressions (StrLit for the literal text).
class Template
  attr_reader parts, line, col
end

# true, false or nil.
class ConstLit
  attr_reader value, line, col
end

# A use of a name. The static checks set depth: the number of scopes between the use and the
# declaration (SPEC 5.1), or -1 for a built-in.
class Name
  attr_reader name, line, col
  attr_accessor depth
end

class ArrayLit
  attr_reader items, line, col
end

class MapLit
  attr_reader entries, line, col
end

# One `key: value` of a map literal; line/col is where the key starts.
class MapEntry
  attr_reader key, value, line, col
end

# `fn (params) ... end` as an expression.
class FnExpr
  attr_reader fn, line, col
end

# Unary `-`.
class Negate
  attr_reader operand, line, col
end

class Not
  attr_reader operand, line, col
end

# `+ - * / % ** == != < <= > >= in`.
class Binary
  attr_reader op, left, right, line, col
end

# `and`, `or`.
class Logic
  attr_reader op, left, right, line, col
end

class Call
  attr_reader callee, args, line, col
end

class Subscript
  attr_reader target, index, line, col
end

# `a[lo:hi]`; lo and hi are nil when left out.
class Slice
  attr_reader target, lo, hi, line, col
end

# `m.name`.
class Field
  attr_reader target, name, line, col
end

# ---- Functions ----

# A parameter; default is nil when it has none.
class Param
  attr_reader name, default, line, col
end

# What `fn name(...) ... end` and `fn (...) ... end` define; name is nil for an anonymous function.
class FnDef
  attr_reader name, params, body, line, col
end

# A declared name with its position (let, const, fn, for and catch variables).
class Ident
  attr_reader name, line, col
end

# ---- Statements ----

# `let x [= init]`; init is nil when left out.
class Let
  attr_reader ident, init, line, col
end

# `let [a, b] = init`; line/col is the `[`.
class LetArray
  attr_reader idents, init, line, col
end

class Const
  attr_reader ident, init, line, col
end

class FnDecl
  attr_reader ident, fn, line, col
end

# `if`: one IfArm per `if`/`elif`; else_body is nil without `else`.
class If
  attr_reader arms, else_body, line, col
end

class IfArm
  attr_reader cond, body
end

class Match
  attr_reader subject, arms, else_body, line, col
end

class WhenArm
  attr_reader values, body
end

class While
  attr_reader cond, body, line, col
end

# `for first [, second] in iterable do body end`; second is nil with one variable.
class For
  attr_reader first, second, iterable, body, line, col
end

class Break
  attr_reader line, col
end

class Continue
  attr_reader line, col
end

# value is nil for a bare `return`.
class Return
  attr_reader value, line, col
end

class Throw
  attr_reader value, line, col
end

# message is nil without `, message`.
class Assert
  attr_reader cond, message, line, col
end

# catch_ident/handler are nil without `catch`; finally_body is nil without `finally`.
class Try
  attr_reader body, catch_ident, handler, finally_body, line, col
end

# `target op value` where op is "=", "+=", ...; line/col is the operator.
class Assign
  attr_reader target, op, value, line, col
end

# `t1, t2 = v1, v2`; line/col is the `=`.
class MultiAssign
  attr_reader targets, values, line, col
end

class ExprStmt
  attr_reader expr, line, col
end

def jump_keyword(stmt)
  case stmt
  in Break then "break"
  in Continue then "continue"
  in Return then "return"
  in Throw then "throw"
  else ""
  end
end
