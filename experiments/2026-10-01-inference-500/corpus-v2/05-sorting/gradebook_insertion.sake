Student = Struct.new(:name, :score, :submitted)

class Student
  def to_s(s) = format("%-8s %3d  (day %d)", @name, @score, @submitted)
end

# Stable insertion sort: higher score first; equal scores keep submission order.
def insertion_sort(students)
  a = Array.dup(students)
  shifts = 0
  i = 1
  while i < Array.size(a)
    cur = a[i]
    j = i - 1
    while j >= 0 && Student.score(a[j]) < Student.score(cur)
      a[j + 1] = a[j]
      j -= 1
      shifts += 1
    end
    a[j + 1] = cur
    i += 1
  end
  [a, shifts]
end

# Position where a new student goes in an already sorted roster (after equal scores).
def insert_position(sorted, score)
  lo = 0
  hi = Array.size(sorted)
  while lo < hi
    mid = (lo + hi) / 2
    if Student.score(sorted[mid]) >= score
      lo = mid + 1
    else
      hi = mid
    end
  end
  lo
end

def ranks(sorted)
  result = Array[]
  prev = nil
  rank = 0
  Array.each_with_index(sorted) do |s, i|
    sc = Student.score(s)
    rank = i + 1 if prev == nil || sc != prev
    prev = sc
    Array.push(result, [rank, s])
  end
  result
end

def letter(score)
  if score >= 90
    "A"
  elsif score >= 80
    "B"
  elsif score >= 70
    "C"
  elsif score >= 60
    "D"
  else
    "F"
  end
end

roster = Array[
  Student.new("alice", 88, 1), Student.new("bob", 72, 1), Student.new("carol", 95, 2),
  Student.new("dave", 88, 2), Student.new("erin", 59, 3), Student.new("frank", 72, 3),
  Student.new("grace", 100, 4), Student.new("heidi", 81, 4), Student.new("ivan", 88, 5)
]

sorted, shifts = insertion_sort(roster)
puts("Sorted roster (#{shifts} shifts):")
Array.each(ranks(sorted)) { |r, s| puts("  #{String.rjust(Integer.to_s(r), 2)}. #{s}") }

late = Array[Student.new("judy", 88, 6), Student.new("ken", 40, 6), Student.new("leo", 97, 7)]
Array.each(late) do |s|
  pos = insert_position(sorted, Student.score(s))
  Array.insert(sorted, pos, s)
  puts("late #{Student.name(s)} inserted at #{pos}")
end

puts("Final ranking:")
Array.each(ranks(sorted)) do |r, s|
  puts(format("  %2d. %s  %s", r, s, letter(Student.score(s))))
end

dist = Hash.new(0)
Array.each(sorted) { |s| dist[letter(Student.score(s))] += 1 }
puts("Distribution: " + Array.join(Array.map(Array["A", "B", "C", "D", "F"]) { |g| "#{g}=#{dist[g]}" }, " "))
top = Array.find(sorted) { |s| Student.submitted(s) >= 5 }
puts("Best late-week: #{top ? Student.name(top) : "none"}")
