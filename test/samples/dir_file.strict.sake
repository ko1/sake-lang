# Dir and File: a tree made and removed in a temporary directory; paths shown relative to it.
def rel(path, dir) = String.delete_prefix(path, dir)

def try(dir)
  yield
rescue IOError => e
  puts "IOError: #{String.gsub(Exception.message(e), dir, "")}"
end

kept = Dir.mktmpdir do |dir|
  p File.directory?(dir)
  p Dir.exist?(dir)
  p Dir.empty?(dir)
  p Dir.children(dir)
  p Array.sort(Dir.entries(dir))

  src = File.join(dir, "src")
  p Dir.mkdir(src)
  p Dir.mkdir(File.join(src, "lib"), 0o755)
  File.write(File.join(src, "main.rb"), "puts 1\n")
  File.write(File.join(src, "lib", "util.rb"), "")
  File.write(File.join(dir, "notes.txt"), "hello")

  p Array.sort(Dir.children(src))
  Dir.each_child(src) { |c| puts "child #{c}" if c == "lib" }
  p Dir.glob("**/*.rb", base: dir)
  p Dir.glob(Array["*.txt", "src/*"], base: dir)
  p Array.map(Dir.glob(File.join(dir, "*"))) { |x| rel(x, dir) }

  f = File.join(dir, "notes.txt")
  p File.file?(f)
  p File.directory?(f)
  p File.exist?(f)
  p File.size(f)
  p File.zero?(File.join(src, "lib", "util.rb"))
  p File.empty?(f)
  p File.ftype(src)
  p File.symlink?(f)
  p File.readable?(f)
  t = Time.at(1700000000)
  p File.utime(t, t, f)
  p Time.to_i(File.mtime(f))
  p Time.to_i(File.atime(f))
  p File.rename(f, File.join(dir, "renamed.txt"))
  p File.exist?(f)
  p File.symlink("renamed.txt", File.join(dir, "link"))
  p File.symlink?(File.join(dir, "link"))
  p File.readlink(File.join(dir, "link"))
  p rel(File.realpath(File.join(dir, "link")), File.realpath(dir))
  p File.identical?(File.join(dir, "link"), File.join(dir, "renamed.txt"))
  p File.unlink(File.join(dir, "link"))

  try(dir) { Dir.mkdir(src) }
  try(dir) { Dir.rmdir(src) }
  try(dir) { Dir.children(File.join(dir, "missing")) }
  try(dir) { File.size(File.join(dir, "missing")) }
  try(dir) { File.rename(File.join(dir, "missing"), f) }
  p File.unlink(File.join(src, "lib", "util.rb"))
  p Dir.rmdir(File.join(src, "lib"))
  p Array.sort(Dir.glob("**/*", base: dir))
  dir
end
p Dir.exist?(kept)

# A tmpdir without a block stays until removed.
d = Dir.mktmpdir("sake-")
p String.start_with?(File.basename(d), "sake-")
p Dir.rmdir(d)
p Dir.exist?(d)

# Path strings
p File.basename("/a/b.rb")
p File.basename("/a/b.rb", ".rb")
p File.basename("a/b.tar.gz", ".*")
p File.dirname("/a/b/c")
p File.dirname("/a/b/c", 2)
p File.extname("x.tar.gz")
p File.split("/a/b")
p File.join("a", "b", "/c/")
p File.join("a", Array["b", Array["c"]])
p File.absolute_path?("/x")
p File.expand_path("b", "/a")
p File.expand_path("../c", "/a/b")
p File.absolute_path("x", "/r")
p File.absolute_path?(Dir.pwd)
p File.absolute_path?(Dir.home)
