require "addressable"

def show(u)
  puts(Addressable::URI.to_s(u))
end

# parse and the components
u = Addressable::URI.parse("http://user:pw@Example.COM:8080/a/b/c.html;x=1?q=1&r=two#frag")
p(Addressable::URI.scheme(u), Addressable::URI.user(u), Addressable::URI.password(u), Addressable::URI.userinfo(u), Addressable::URI.host(u), Addressable::URI.port(u))
p(Addressable::URI.path(u), Addressable::URI.query(u), Addressable::URI.fragment(u), Addressable::URI.authority(u), Addressable::URI.site(u), Addressable::URI.origin(u))
p(Addressable::URI.basename(u), Addressable::URI.extname(u), Addressable::URI.request_uri(u), Addressable::URI.inferred_port(u), Addressable::URI.default_port(u))
p(Addressable::URI.absolute?(u), Addressable::URI.relative?(u), Addressable::URI.ip_based?(u), Addressable::URI.hostname(u))
p(Addressable::URI.to_hash(u))
p(Kernel.inspect(u))
r = Addressable::URI.parse("../x/y?z")
p(Addressable::URI.scheme(r), Addressable::URI.host(r), Addressable::URI.path(r), Addressable::URI.query(r), Addressable::URI.relative?(r), Addressable::URI.request_uri(r))
p(Addressable::URI.parse("mailto:bob@example.com").Addressable::URI.path)
p(Addressable::URI.parse("http://[::1]:3000/").Addressable::URI.hostname)
p(Addressable::URI.parse("").Addressable::URI.empty?)

# normalize: case, default port, dot segments, percent-encoding, IDN
show(Addressable::URI.parse("HTTP://www.Example.com:80/./a/../b/%7euser/%3f?b=2&a=1#F").Addressable::URI.normalize)
show(Addressable::URI.parse("http://example.com").Addressable::URI.normalize)
show(Addressable::URI.parse("http://example.com/a b/ü?q=a b").Addressable::URI.normalize)
show(Addressable::URI.parse("http://www.詹姆斯.com/").Addressable::URI.normalize)
show(Addressable::URI.parse("http://www.xn--8ws00zhy3a.com/").Addressable::URI.display_uri)
show(Addressable::URI.parse("http://müller.de/").Addressable::URI.normalize)
p(Addressable::URI.parse("http://example.com/?b=2&&a=1&b=2").Addressable::URI.normalized_query(:compacted, :sorted))
p(Addressable::URI.parse("feed://http://example.com/").Addressable::URI.normalize.Addressable::URI.to_s)
p(Addressable::URI.parse("http://example.com/").Addressable::URI.normalized_site)
p(Addressable::URI.parse("HTTP://a.com:443/").Addressable::URI.normalized_port, Addressable::URI.parse("https://a.com:443/").Addressable::URI.normalized_port)

# join, merge, route
base = Addressable::URI.parse("http://a/b/c/d;p?q")
Array.each(Array["g", "./g", "g/", "/g", "//g", "?y", "g?y", "#s", "g#s", "..", "../g", "../..", "../../g", "../../../g", ""]) do |ref|
  puts("#{ref} -> #{Addressable::URI.join(base, ref)}")
end
show(Addressable::URI.join("http://example.com/a/", "b/", "c"))
show(base + "x/y")
show(Addressable::URI.merge(u, Hash[:path => "/new", :query => nil, :port => 81]))
show(Addressable::URI.parse("http://example.com/a/b/c").Addressable::URI.route_from("http://example.com/a/d"))
show(Addressable::URI.parse("http://example.com/a/").Addressable::URI.route_to("http://example.com/a/b/c?x"))
show(Addressable::URI.parse("http://example.com/x").Addressable::URI.route_from("http://other.com/x"))
show(Addressable::URI.omit(u, :userinfo, :port, :fragment))
show(Addressable::URI.omit(u, :scheme, :authority))
p(Addressable::URI.parse("http://example.com/") == Addressable::URI.parse("HTTP://EXAMPLE.COM:80"))
p(Addressable::URI.parse("http://example.com/").Addressable::URI.eql?(Addressable::URI.parse("HTTP://EXAMPLE.COM:80")))
p(Addressable::URI.===(Addressable::URI.parse("http://example.com/"), "http://Example.com/"))

# setters
v = Addressable::URI.parse("http://example.com/path")
Addressable::URI.set_scheme(v, "https")
Addressable::URI.set_host(v, "www.example.org")
Addressable::URI.set_port(v, "8443")
Addressable::URI.set_user(v, "me")
Addressable::URI.set_password(v, "secret")
Addressable::URI.set_path(v, "other/file.txt")
Addressable::URI.set_query(v, "a=1")
Addressable::URI.set_fragment(v, "top")
show(v)
Addressable::URI.set_userinfo(v, "u2:p2")
Addressable::URI.set_authority(v, "host.example:99")
show(v)
Addressable::URI.set_site(v, "ftp://files.example")
show(v)
Addressable::URI.set_origin(v, "http://origin.example:8000")
show(v)
Addressable::URI.set_hostname(v, "::1")
p(Addressable::URI.host(v), Addressable::URI.hostname(v))
Addressable::URI.set_request_uri(v, "/req?x=y")
show(v)
w = Addressable::URI.new(scheme: "http", host: "example.com", path: "/a")
show(w)
Addressable::URI.set_query_values(w, Hash["b" => "two words", "a" => Array["1", "2"], "c" => nil])
show(w)
p(Addressable::URI.query_values(w))
Addressable::URI.set_query_values(w, Array[["z", "1"], ["y", "2"]])
show(w)
p(Addressable::URI.parse("http://x/?a=1+2&b=%41&c&d=").Addressable::URI.query_values)
p(Addressable::URI.parse("http://x/?a=1&b=2").Addressable::URI.query_values_array)
x = Addressable::URI.parse("http://example.com/a/../b")
Addressable::URI.normalize!(x)
show(x)
Addressable::URI.join!(x, "c/d")
show(x)
Addressable::URI.merge!(x, Hash[:fragment => "f"])
show(x)
show(Addressable::URI.dup(x))

# tld and domain (the Public Suffix List)
y = Addressable::URI.parse("http://www.example.co.uk/")
p(Addressable::URI.tld(y), Addressable::URI.domain(y))
Addressable::URI.set_tld(y, "com")
show(y)

# encoding
p(Addressable::URI.encode_component("a b&c/d?é"))
p(Addressable::URI.encode_component("a b&c/d", Addressable::URI::CharacterClasses.UNRESERVED))
p(Addressable::URI.encode_component("a b&c", Addressable::URI::CharacterClassesRegexps.UNRESERVED))
p(Addressable::URI.encode_component("simple+text", "a-z", "+"))
p(Addressable::URI.unencode("%41%42%2Fc%C3%A9"))
p(Addressable::URI.unencode("%41%2F%2B", "/"))
p(Addressable::URI.unescape("a%20b"))
p(Addressable::URI.normalize_component("%7euser a", Addressable::URI::CharacterClasses.UNRESERVED))
p(Addressable::URI.normalize_component("a+b%2Bc", "a-z+", "+"))
p(Addressable::URI.encode("http://example.com/a b?q=é#f g"))
p(Addressable::URI.escape("http://ex.com/ü"))
p(Addressable::URI.normalized_encode("http://example.com/%7Ea b?q=é"))
p(Addressable::URI.form_encode(Hash["name" => "Bob Smith", "tags" => Array["a&b", "c"], "n" => "1\n2"]))
p(Addressable::URI.form_encode(Array[["b", "2"], ["a", "1"]], true))
p(Addressable::URI.form_unencode("name=Bob+Smith&x=%26&flag&y=1%0D%0A2"))

# heuristic_parse
Array.each(Array["example.com", "http:/example.com", "www.example.com/path?q", "192.168.0.1:8080/x",
 "file:///tmp/x", "feed://example.com/rss", "user@example.com"]) do |s|
  puts("#{s} -> #{Addressable::URI.heuristic_parse(s)}")
end
show(Addressable::URI.heuristic_parse("example.com", Hash[:scheme => "https"]))
show(Addressable::URI.convert_path("/tmp/some file"))

# IDNA
p(Addressable::IDNA.to_ascii("www.Bücher.de"))
p(Addressable::IDNA.to_ascii("日本語.jp"))
p(Addressable::IDNA.to_unicode("xn--bcher-kva.de"))
p(Addressable::IDNA.to_unicode("xn--wgv71a119e.jp"))
p(Addressable::IDNA.to_unicode("xn--!!.com"))

# errors
Array.each(Array["http://exa mple.com/", "http:", "1http://x", "http://host:port/", "//a//b", "http://[x y]/"]) do |s|
  begin
    show(Addressable::URI.parse(s))
  rescue Addressable::URI::InvalidURIError => e
    puts("InvalidURIError: #{Exception.message(e)}")
  end
end
begin
  Addressable::URI.new(path: "a:b")
rescue Addressable::URI::InvalidURIError => e
  puts("InvalidURIError: #{Exception.message(e)}")
end
begin
  Addressable::URI.parse("mailto:x").Addressable::URI.set_request_uri("/y")
rescue Addressable::URI::InvalidURIError => e
  puts("InvalidURIError: #{Exception.message(e)}")
end
begin
  Addressable::URI.omit(u, :bogus)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
begin
  Addressable::URI.merge(u, Hash[:authority => "a.com", :host => "b.com"])
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
begin
  Addressable::URI.merge(u, Hash[:path => 1])
rescue TypeError => e
  puts("TypeError: #{Exception.message(e)}")
end
begin
  Addressable::URI.parse("/relative").Addressable::URI.route_from("http://example.com/")
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end

# Template: RFC 6570 expansion, levels 1 to 4 (the RFC's examples)
vars = Hash[
  "var" => "value", "hello" => "Hello World!", "path" => "/foo/bar", "empty" => "",
  "x" => "1024", "y" => "768", "list" => Array["red", "green", "blue"],
  "keys" => Hash["semi" => ";", "dot" => ".", "comma" => ","], "undef" => nil
]
Array.each(Array["{var}", "{hello}", "{+var}", "{+hello}", "{+path}/here", "here?ref={+path}", "X{#var}", "X{#hello}",
 "map?{x,y}", "{x,hello,y}", "{+x,hello,y}", "{+path,x}/here", "{#x,hello,y}", "{#path,x}/here",
 "X{.var}", "X{.x,y}", "{/var}", "{/var,x}/here", "{;x,y}", "{;x,y,empty}", "{?x,y}", "{?x,y,empty}",
 "?fixed=yes{&x}", "{&x,y,empty}", "{var:3}", "{var:30}", "{list}", "{list*}", "{keys}", "{keys*}",
 "{+path:6}/here", "{+list}", "{+list*}", "{+keys}", "{+keys*}", "{#path:6}/here", "{#list}", "{#list*}",
 "{#keys*}", "X{.var:3}", "X{.list}", "X{.list*}", "X{.keys}", "X{.keys*}", "{/var:1,var}", "{/list}",
 "{/list*}", "{/list*,path:4}", "{/keys}", "{/keys*}", "{;hello:5}", "{;list}", "{;list*}", "{;keys}",
 "{;keys*}", "{?var:3}", "{?list}", "{?list*}", "{?keys}", "{?keys*}", "{&var:3}", "{&list}", "{&list*}",
 "{&keys}", "{&keys*}", "{undef}", "{?undef,x}", "{var}{undef}{x}"]) do |pattern|
  puts("#{pattern} => #{Addressable::Template.new(pattern).Addressable::Template.expand(vars)}")
end
t = Addressable::Template.new("http://example.com/{resource}/{id}{?q,page}")
show(Addressable::Template.expand(t, Hash["resource" => "users", "id" => 42, "q" => "a b"]))
show(Addressable::Template.expand(t, Hash[:resource => "posts", :id => "7"]))
p(Addressable::Template.pattern(t), Addressable::Template.variables(t), Addressable::Template.keys(t), Addressable::Template.variable_defaults(t))
p(Kernel.inspect(t))
p(t == Addressable::Template.new("http://example.com/{resource}/{id}{?q,page}"))
p(Addressable::Template.partial_expand(t, Hash["resource" => "users"]).Addressable::Template.pattern)
p(Addressable::Template.new("{?a,b,c}").Addressable::Template.partial_expand(Hash["b" => "2"]).Addressable::Template.pattern)
p(Addressable::Template.new("http://x/{name}").Addressable::Template.expand(Hash["name" => "Ünïcödé"]).Addressable::URI.to_s)
p(Addressable::Template.new("{var}").Addressable::Template.expand(Hash["var" => "é"], false).Addressable::URI.to_s)

# Template: extract and match
p(Addressable::Template.extract(t, "http://example.com/users/42?q=hello%20world&page=2"))
p(Addressable::Template.extract(t, "http://example.com/users/42"))
p(Addressable::Template.extract(t, "http://other.com/users/42"))
p(Addressable::Template.new("/search{?tags*}").Addressable::Template.extract("/search?tags=a&tags=b"))
p(Addressable::Template.new("{/segments*}").Addressable::Template.extract("/a/b/c"))
p(Addressable::Template.new("/files{/path*}{.ext}").Addressable::Template.extract("/files/a/b.txt"))
p(Addressable::Template.new("/q{?keys*}").Addressable::Template.extract("/q?a=1&b=2"))
p(Addressable::Template.new("{;x,y}").Addressable::Template.extract(";x=1;y=2"))
p(Addressable::Template.new("{+path}/here").Addressable::Template.extract("/foo/bar/here"))
p(Addressable::Template.new("http://example.com/").Addressable::Template.extract("http://example.com/"))
md = Addressable::Template.match(t, "http://example.com/users/42?q=x")
md => Addressable::Template::MatchData
p(Addressable::Template::MatchData.variables(md), Addressable::Template::MatchData.values(md), Addressable::Template::MatchData.captures(md), Addressable::Template::MatchData.to_a(md), Addressable::Template::MatchData.to_s(md), Addressable::Template::MatchData.string(md))
p(md["id"], md[0], md[2], md[1, 2], Addressable::Template::MatchData.values_at(md, 1, 2), Addressable::Template::MatchData.pre_match(md), Addressable::Template::MatchData.post_match(md))
p(Addressable::Template::MatchData.mapping(md), Addressable::Template::MatchData.uri(md).Addressable::URI.to_s, Addressable::Template::MatchData.template(md).Addressable::Template.pattern)
p(Kernel.inspect(md))
p(Addressable::Template.match(t, "ftp://nope/"))
p(Addressable::Template.new("{x}/{y}").Addressable::Template.to_regexp.Regexp.source == Addressable::Template.new("{x}/{y}").Addressable::Template.source)
p(Addressable::Template.new("{x}/{y}").Addressable::Template.named_captures)
