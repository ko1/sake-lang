module Sql
  class Parser
    @tokens: Array[Token]
    @pos: Integer

    def initialize: (Array[Token] tokens) -> void
    def parse_statement: () -> Ast::Statement?

    private

    def syntax_error: () -> bot
    def peek: () -> Token
    def peek_ahead: (Integer n) -> Token
    def advance: () -> Token
    def accept_keyword: (String word) -> bool
    def expect_keyword: (String word) -> void
    def accept_op: (String symbol) -> bool
    def expect_op: (String symbol) -> void
    def name: () -> String
    def name_list: () -> Array[String]
    def if_not_exists_clause: () -> bool
    def if_exists_clause: () -> bool
    def create: () -> Ast::Statement
    def create_index: (bool unique) -> Ast::CreateIndex
    def create_view: () -> Ast::CreateView
    def create_table: () -> Ast::CreateTable
    def column_def: () -> Ast::ColumnDef
    def default_literal: () -> value
    def table_constraint: () -> Ast::TableConstraint
    def column_type: (String word) -> column_type?
    def drop: () -> Ast::Statement
    def alter_table: () -> Ast::Statement
    def transaction: () -> Ast::Transaction
    def insert: (Array[Ast::CteDef] ctes, bool recursive) -> Ast::Insert
    def insert_query: (String table, Array[String]? columns, Array[Ast::CteDef] ctes, bool recursive) -> Ast::Insert
    def with_statement: () -> Ast::Statement
    def with_clause: () -> [Array[Ast::CteDef], bool]
    def cte_definition: () -> Ast::CteDef
    def value_row: () -> Array[Ast::Expr]
    def update: () -> Ast::Update
    def assignment: () -> Ast::Assignment
    def delete: () -> Ast::Delete
    def query_ahead?: () -> bool
    def query: () -> Ast::Query
    def query_body: () -> Ast::QueryBody
    def compound_op: () -> String?
    def simple_select: () -> Ast::Select
    def window_definitions: () -> Array[Ast::NamedWindow]
    def window_spec: () -> Ast::WindowSpec
    def frame_units: () -> (:rows | :range)?
    def frame_clause: () -> Ast::Frame?
    def frame_bound: (bool is_start) -> Ast::FrameBound
    def frame_offset: () -> number
    def over_clause: () -> Ast::WindowSpec?
    def from_clause: () -> Ast::FromClause
    def join_with_constraint: (Symbol kind, bool required) -> Ast::Join
    def from_item: () -> Ast::FromItem
    def optional_alias: () -> String?
    def expression_list_after_by: () -> Array[Ast::Expr]
    def select_item: () -> Ast::SelectItem
    def order_terms: () -> Array[Ast::OrderTerm]
    def order_term: () -> Ast::OrderTerm
    def expression: () -> Ast::Expr
    def conjunction: () -> Ast::Expr
    def negation: () -> Ast::Expr
    def equality: () -> Ast::Expr
    def membership_test: (Ast::Expr left) -> Ast::Expr?
    def comparison: () -> Ast::Expr
    def additive: () -> Ast::Expr
    def multiplicative: () -> Ast::Expr
    def concatenation: () -> Ast::Expr
    def unary: () -> Ast::Expr
    def primary: () -> Ast::Expr
    def identifier_primary: (String word) -> Ast::Expr
    def parenthesized: () -> Ast::Expr
    def keyword_primary: (Token token) -> Ast::Expr
    def exists_expression: () -> Ast::ExistsSubquery
    def case_expression: () -> Ast::CaseExpr
    def cast_expression: () -> Ast::Cast
    def function_call: (String function) -> Ast::FunctionCall
  end
end
