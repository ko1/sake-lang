def ts_ok(ts)
  return false unless String.match?(ts, /\A\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\z/)
  mo = String.to_i(String.slice(ts, 5, 2))
  d = String.to_i(String.slice(ts, 8, 2))
  h = String.to_i(String.slice(ts, 11, 2))
  mi = String.to_i(String.slice(ts, 14, 2))
  s = String.to_i(String.slice(ts, 17, 2))
  mo >= 1 && mo <= 12 && d >= 1 && d <= 31 && h <= 23 && mi <= 59 && s <= 59
end

def reason(f)
  return "wrong field count" if Array.size(f) != 6
  ts = f[0]
  return "bad timestamp" unless ts_ok(ts)
  return "bad method" unless Array.include?(Array["GET", "POST", "PUT", "DELETE"], f[1])
  return "bad path" unless String.start_with?(f[2], "/")
  return "bad status" unless String.match?(f[3], /\A\d{3}\z/) && String.to_i(f[3]) >= 100 && String.to_i(f[3]) <= 599
  return "bad bytes" unless f[4] == "-" || String.match?(f[4], /\A\d+\z/)
  return "bad duration" unless String.match?(f[5], /\A\d+\z/)
  nil
end

stats = Hash[]
hours = Hash[]
bad = Array[]
n = 0
while (line = gets)
  n += 1
  line = String.chomp(line)
  next if String.empty?(String.strip(line))
  f = String.split(line, " ")
  r = reason(f)
  if r
    Array.push(bad, "  line #{n}: #{r}")
    next
  end
  path = f[2]
  q = String.index(path, "?")
  path = String.slice(path, 0, q) if q
  ep = "#{f[1]} #{path}"
  st = String.to_i(f[3])
  dur = String.to_i(f[5])
  s = stats[ep]
  if s == nil
    s = Array[0, 0, 0, 0, 0, 0]
    stats[ep] = s
  end
  s[0] += 1
  s[1] += 1 if st >= 400 && st <= 499
  s[2] += 1 if st >= 500 && st <= 599
  s[3] += String.to_i(f[4]) if f[4] != "-"
  s[4] += dur
  s[5] = dur if dur > s[5]
  hk = String.slice(f[0], 0, 13)
  hours[hk] = Hash.fetch(hours, hk, 0) + 1
end

if Hash.size(stats) == 0
  puts("no valid requests")
else
  keys = Array.sort_by(Hash.keys(stats)) { |k| [-stats[k][0], k] }
  w = 8
  Array.each(keys) { |k| w = String.size(k) if String.size(k) > w }
  puts(String.ljust("endpoint", w) + format(" %5s %4s %4s %8s %7s %6s", "count", "4xx", "5xx", "bytes", "avg_ms", "max_ms"))
  Array.each(keys) do |k|
    s = stats[k]
    t = (s[4] * 20 + s[0]) / (2 * s[0])
    avg = "#{t / 10}.#{t % 10}"
    puts(String.ljust(k, w) + format(" %5d %4d %4d %8d %7s %6d", s[0], s[1], s[2], s[3], avg, s[5]))
  end
  best = nil
  bestn = 0
  Array.each(Array.sort(Hash.keys(hours))) do |hk|
    if hours[hk] > bestn
      bestn = hours[hk]
      best = hk
    end
  end
  puts("busiest hour: #{String.slice(best, 0, 10)} #{String.slice(best, 11, 2)}:00 (#{bestn} requests)")
end
puts("invalid lines: #{Array.size(bad)}")
Array.each(bad) { |l| puts(l) }
