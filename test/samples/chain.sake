# `x.T.f(args)` is `T.f(x, args)`; `_` is the previous statement's value.
Point = Struct.new(:x, :y)
module Shape
  def area(s) = 0
end
Box = Struct.new(:w, :h)
class Box
  include Shape
  def area(b) = @w * @h
end

line = "a, b ,c"
p(line.String.split(",").Array.map { |s| String.strip(s) }.Array.join("|"))
p(String.split(line, ",")
  .Array.map { |s| String.upcase(String.strip(s)) }
  .Array.sort
  .Array.reverse)
p(Point.new(3, 4).Point.get_x)
p(Box.new(2, 5).Shape.area)
p(1.Arithmetic.+(2))

String.split(line, ",")
Array.map(_) { |s| String.strip(s) }
Array.join(_, "+")
puts(_)

def total(xs)
  Array.sum(xs)
  _ * 2
end
p(total(Array[1, 2, 3]))
Array.each(Array[1, 2]) do |i|
  Integer.to_s(i)
  puts("#{_}!")
end
p((Integer.succ(41); _ + 1))
x = 10
(p("v=#{_}"))
