# Optional parameters, then keyword parameters, as in Ruby.
def greet(name, greeting = "Hello", punct: "!", times: 1)
  String.*("#{greeting}, #{name}#{punct} ", times)
end

def area(w:, h: w) = w * h    # w: is required; h's default reads w

puts(greet("Ruby"))
puts(greet("Ruby", "Hi"))
puts(greet("Ruby", times: 2))
puts(greet("Sake", "Yo", punct: "?"))
p(area(w: 3))
p(area(h: 2, w: 5))
times = 3
punct = "."
puts(greet("you", times:, punct:))     # `k:` alone passes the variable k
