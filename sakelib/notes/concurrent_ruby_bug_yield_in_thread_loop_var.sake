# A block passed to a function that runs it on a thread (yield inside Thread.new) reads the loop
# variable of the block around the call as it is when the thread runs, not as it was when the block
# was written: Ruby's block parameters are fresh per call, so Ruby prints 0, 1, 2 (in some order).
def later
  Thread.new do
    sleep 0.02
    yield
  end
end
out = Queue.new
ts = Array.map(Range.to_a(0..2)) { |i| later { Queue.push(out, i) } }
Array.each(ts) { |t| Thread.join(t) }
got = Array[]
Array.push(got, Queue.pop(out)) until Queue.empty?(out)
p Array.sort(got)          # expected [0, 1, 2]; got [2, 2, 2]
# A function's own parameter is per call, so this prints [0, 1, 2]:
def post_i(out, i) = later { Queue.push(out, i) }
ts = Array.map(Range.to_a(0..2)) { |i| post_i(out, i) }
Array.each(ts) { |t| Thread.join(t) }
got = Array[]
Array.push(got, Queue.pop(out)) until Queue.empty?(out)
p Array.sort(got)
