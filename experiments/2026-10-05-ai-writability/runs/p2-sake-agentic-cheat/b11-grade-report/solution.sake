def tenths(x) = Rational.floor(x * 10 + Rational(1, 2))

def fmt(t) = "#{t / 10}.#{t % 10}"

def grade(t)
  return "A" if t >= 900
  return "B" if t >= 800
  return "C" if t >= 700
  return "D" if t >= 600
  "F"
end

wt = Hash.new(0)
cats = String[]
pts = Hash.new(0)
mx = Hash.new(0)
miss = Hash.new(0)
known = Hash.new(0)
students = String[]
errs = String[]

lines = IO.readlines(IO.stdin)
Array.each_with_index(lines) do |raw, i|
  n = i + 1
  line = String.strip(raw)
  next if String.empty?(line)
  next if String.start_with?(line, "#")
  f = String.split(line)
  if f[0] == "weight" && Array.size(f) == 3
    cat = f[1]
    w = f[2]
    if !String.match?(w, /\A\d+\z/) || String.to_i(w) < 1 || String.to_i(w) > 100
      Array.push(errs, "line #{n}: bad weight #{w}")
    elsif wt.Hash.key?(cat)
      Array.push(errs, "line #{n}: duplicate category #{cat}")
    else
      wt[cat] = String.to_i(w)
      Array.push(cats, cat)
    end
    next
  end
  if Array.size(f) != 3
    Array.push(errs, "line #{n}: bad format")
    next
  end
  st = f[0]
  cat = f[1]
  sc = f[2]
  unless Hash.key?(wt, cat)
    Array.push(errs, "line #{n}: unknown category #{cat}")
    next
  end
  p_ = 0
  m_ = 0
  ok = false
  gone = false
  excused = false
  if String.match?(sc, /\A(\d+|-|EX)\/\d+\z/)
    pp_ = String.split(sc, "/")
    m_ = String.to_i(pp_[1])
    if pp_[0] == "EX"
      excused = true
    elsif pp_[0] == "-"
      gone = true
    else
      p_ = String.to_i(pp_[0])
    end
    ok = m_ > 0 && p_ <= m_
  end
  unless ok
    Array.push(errs, "line #{n}: bad score #{sc}")
    next
  end
  if known[st] == 0
    known[st] = 1
    Array.push(students, st)
  end
  next if excused
  key = "#{st}|#{cat}"
  pts[key] += p_
  mx[key] += m_
  miss[st] += 1 if gone
end

rows = Array[]
total = Rational(0, 1)
cnt = 0
Array.each(students) do |st|
  num = Rational(0, 1)
  den = 0
  Array.each(cats) do |c|
    key = "#{st}|#{c}"
    if mx[key] > 0
      num = num + Rational(pts[key] * wt[c], mx[key])
      den += wt[c]
    end
  end
  if den > 0
    pct = num * 100 / den
    total = total + pct
    cnt += 1
    Array.push(rows, [0, -tenths(pct), st, miss[st]])
  else
    Array.push(rows, [1, 0, st, miss[st]])
  end
end

Array.each(errs) { |e| puts(e) }
w = Array.max(Array.map(students) { String.size(it) } + Array[7])
puts(String.ljust("Student", w) + "  Score  G  Missing")
Array.each(Array.sort_by(rows) { |r| [r[0], r[1], r[2]] }) do |r|
  if r[0] == 0
    t = -r[1]
    sc = String.rjust(fmt(t), 5)
    g = grade(t)
  else
    sc = "  n/a"
    g = "-"
  end
  puts(String.ljust(r[2], w) + "  " + sc + "  " + g + "  " + String.rjust(Integer.to_s(r[3]), 7))
end
if cnt > 0
  puts("class average: " + fmt(tenths(total / cnt)))
else
  puts("class average: n/a")
end
