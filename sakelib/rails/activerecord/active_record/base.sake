# Port of activerecord-8.1.3/lib/active_record/base.rb (partial: the modules listed below; no Encryption,
# SecurePassword (activemodel's), TokenFor, SignedId, Suppressor, Normalization, Marshalling, Explain, Delegation)
#
# Ruby: class Base; extend ...; include Core, Persistence, ..., Transactions, ...; end, and a model is
# `class Post < ApplicationRecord`. Sake's `<` pastes, and a module that includes modules cannot give them fields,
# so the generated model includes Base's modules itself, in Ruby's order (generate/model.sake's base_modules),
# then its abstract parents (ApplicationRecord is a module). The class methods (Ruby's `extend`) are the mixin
# functions without an instance (`Post.where(...)`); ActiveRecord::Base.establish_connection and connection are
# module functions here. Generic code reaches a record's function through the module that defines it
# (`ActiveRecord::Transactions.save(record)` dispatches to the record's model). The super chain between the
# modules is in persistence.sake.

module ActiveRecord
  module Base
    module_function :establish_connection, :connection, :lease_connection, :remove_connection, :connected?

    def establish_connection(**config) = ConnectionHandling.establish_connection(**config)
    def connection = ConnectionHandling.connection
    def lease_connection = ConnectionHandling.connection
    def remove_connection = ConnectionHandling.remove_connection
    def connected? = ConnectionHandling.connected?

    # Ruby's include list, which every model includes itself (generate/model.sake's base_modules): a module that
    # includes these could not use their fields (only a class has fields), so Base is the list, not a mixin.
  end
end
