def valid_money?(s)
  String.match?(s, /^[0-9]+\.[0-9]{2}$/)
end

def valid_coin?(s)
  s == "0.05" || s == "0.10" || s == "0.25" || s == "0.50" || s == "1.00" || s == "2.00"
end

def valid_name?(s)
  String.size(s) >= 1 && String.size(s) <= 12 && String.match?(s, /^[a-z]+$/)
end

def valid_slot?(s)
  String.match?(s, /^[A-Z][0-9]$/)
end

def valid_count?(s)
  String.match?(s, /^[0-9]+$/) && String.to_i(s) >= 0 && String.to_i(s) <= 999
end

def count_valid?(s)
  String.match?(s, /^[0-9]+$/) && String.to_i(s) >= 0 && String.to_i(s) <= 99
end

def make_change(tubes, amount)
  coins_needed = Array[]
  remaining = amount

  coins = Array[2.00, 1.00, 0.50, 0.25, 0.10, 0.05]
  Array.each(coins) do |coin_val|
    coin_str = format("%.2f", coin_val)
    coin_count = Hash.fetch(tubes, coin_str, 0)

    times = Integer(Float(remaining) / coin_val)
    times = Integer.min(times, coin_count)

    Integer.times(times) do
      Array.push(coins_needed, coin_val)
      remaining -= coin_val
    end
  end

  if Float.abs(remaining) < 0.001
    coins_needed
  else
    nil
  end
end

def format_coins(coins)
  if Array.size(coins) > 0
    formatted = Array.map(coins) { |c| format("%.2f", c) }
    "[" + Array.join(formatted, " ") + "]"
  else
    ""
  end
end

slots = Hash[]
tubes = Hash[]
tubes["0.05"] = 0
tubes["0.10"] = 0
tubes["0.25"] = 0
tubes["0.50"] = 0
tubes["1.00"] = 0
tubes["2.00"] = 0

credit = 0.0
credit_history = Array[]
sales = Hash[]
line_no = 0

loop do
  line = gets
  break if line == nil
  line_no += 1

  if String.empty?(String.strip(line))
    next
  end

  parts = String.split(String.strip(line), /\s+/)
  if Array.size(parts) < 1
    puts("line #{line_no}: error: unknown command")
    next
  end

  cmd = Array.at(parts, 0)

  case cmd
  in "SLOT"
    if Array.size(parts) != 5
      puts("line #{line_no}: error: wrong field count")
    else
      code = Array.at(parts, 1)
      name = Array.at(parts, 2)
      price_str = Array.at(parts, 3)
      count_str = Array.at(parts, 4)

      if !valid_slot?(code)
        puts("line #{line_no}: error: bad slot")
      elsif !valid_name?(name)
        puts("line #{line_no}: error: bad name")
      elsif !valid_money?(price_str)
        puts("line #{line_no}: error: bad money")
      elsif !count_valid?(count_str)
        puts("line #{line_no}: error: bad count")
      else
        slots[code] = {name: name, price: Float(price_str), count: String.to_i(count_str)}
      end
    end
  in "TUBE"
    if Array.size(parts) != 3
      puts("line #{line_no}: error: wrong field count")
    else
      coin_str = Array.at(parts, 1)
      count_str = Array.at(parts, 2)

      if !valid_coin?(coin_str)
        puts("line #{line_no}: error: bad coin")
      elsif !valid_count?(count_str)
        puts("line #{line_no}: error: bad count")
      else
        tubes[coin_str] += String.to_i(count_str)
      end
    end
  in "COIN"
    if Array.size(parts) != 2
      puts("line #{line_no}: error: wrong field count")
    else
      coin_str = Array.at(parts, 1)

      if !valid_coin?(coin_str)
        puts("rejected #{coin_str}")
      else
        coin_val = Float(coin_str)
        if credit + coin_val > 5.0
          puts("rejected #{coin_str} (credit limit)")
        else
          credit += coin_val
          Array.push(credit_history, coin_val)
          tubes[coin_str] += 1
          puts("credit #{format('%.2f', credit)}")
        end
      end
    end
  in "SELECT"
    if Array.size(parts) != 2
      puts("line #{line_no}: error: wrong field count")
    else
      slot_code = Array.at(parts, 1)

      if !Hash.key?(slots, slot_code)
        puts("no slot #{slot_code}")
      else
        s = slots[slot_code]
        if s[:count] == 0
          puts("sold out #{slot_code}")
        elsif credit < s[:price]
          diff = s[:price] - credit
          puts("insert #{format('%.2f', diff)} more")
        else
          change_amount = credit - s[:price]
          change_coins = make_change(tubes, change_amount)

          if change_coins == nil
            puts("exact change needed")
          else
            s[:count] -= 1

            if !Hash.key?(sales, s[:name])
              sales[s[:name]] = {count: 0, revenue: 0.0}
            end
            sales[s[:name]][:count] += 1
            sales[s[:name]][:revenue] += s[:price]

            Array.each(credit_history) do |coin|
              tubes[format("%.2f", coin)] -= 1
            end

            Array.each(change_coins) do |coin|
              tubes[format("%.2f", coin)] -= 1
            end

            credit_history = Array[]
            credit = 0.0

            if change_amount > 0.001
              coins_str = format_coins(change_coins)
              puts("vend #{s[:name]}, change #{format('%.2f', change_amount)} #{coins_str}")
            else
              puts("vend #{s[:name]}")
            end
          end
        end
      end
    end
  in "CANCEL"
    if Array.size(parts) != 1
      puts("line #{line_no}: error: wrong field count")
    else
      if credit == 0.0
        puts("nothing to return")
      else
        coins_str = format_coins(credit_history)
        puts("returned #{format('%.2f', credit)} #{coins_str}")

        Array.each(credit_history) do |coin|
          tubes[format("%.2f", coin)] -= 1
        end
      end
      credit_history = Array[]
      credit = 0.0
    end
  else
    puts("line #{line_no}: error: unknown command")
  end
end

if credit > 0.001
  puts("credit #{format('%.2f', credit)} kept")
end

puts("sales:")
if Array.size(Hash.keys(sales)) == 0
  puts("  none")
else
  sorted_names = Array.sort_by(Hash.keys(sales)) { |n| [-sales[n][:revenue], n] }
  Array.each(sorted_names) do |name|
    revenue = sales[name][:revenue]
    count = sales[name][:count]
    puts(format("  %-12s %3d %8s", name, count, format("%.2f", revenue)))
  end
end

puts("tubes: 0.05x#{tubes["0.05"]} 0.10x#{tubes["0.10"]} 0.25x#{tubes["0.25"]} 0.50x#{tubes["0.50"]} 1.00x#{tubes["1.00"]} 2.00x#{tubes["2.00"]}")
