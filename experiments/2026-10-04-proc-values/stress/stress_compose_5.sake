def compose(f, g) = proc { |x| Proc.call(f, Proc.call(g, x)) }
f0 = proc { |x| x + 0 }
f1 = proc { |x| x + 1 }
f2 = proc { |x| x + 2 }
f3 = proc { |x| x + 3 }
f4 = proc { |x| x + 4 }
c = f0
c = compose(c, f1)
c = compose(c, f2)
c = compose(c, f3)
c = compose(c, f4)
p Proc.call(c, 0)
p Proc.call(c, 0.5)
