def points(d)
  return 0 if d == "MISS"
  return 50 if d == "BULL"
  return 25 if d == "25"
  m = String.match(d, /\A([SDT])([1-9]|1[0-9]|20)\z/)
  return -1 if m == nil
  c = MatchData.captures(m)
  k = String.to_i(c[1])
  return k if c[0] == "S"
  return 2 * k if c[0] == "D"
  3 * k
end

def double?(d) = d == "BULL" || String.start_with?(d, "D")

all = IO.readlines(IO.stdin)
hdr = Array.empty?(all) ? Array[] : String.split(all[0])
ok = !Array.empty?(hdr) && String.match?(hdr[0], /\A\d+\z/)
if ok
  s0 = String.to_i(hdr[0])
  ok = s0 >= 2 && s0 <= 1001
  names0 = Array.drop(hdr, 1)
  ok = false if Array.size(names0) < 1 || Array.size(names0) > 4
  ok = false unless Array.all?(names0) { String.match?(it, /\A[a-z]{1,10}\z/) }
  ok = false if Array.size(Array.uniq(names0)) != Array.size(names0)
end
unless ok
  puts("invalid header")
  exit
end
start = String.to_i(hdr[0])
names = Array.drop(hdr, 1)
left = Hash[]
turns = Hash.new(0)
thrown = Hash.new(0)
Array.each(names) { left[it] = start }
winner = ""

Array.each_with_index(all) do |raw, i|
  next if i == 0
  n = i + 1
  w = String.split(raw)
  next if Array.empty?(w)
  if winner != ""
    puts("line #{n}: game over")
    next
  end
  name = w[0]
  darts = Array.drop(w, 1)
  unless Hash.key?(left, name)
    puts("line #{n}: unknown player #{name}")
    next
  end
  if Array.size(darts) < 1 || Array.size(darts) > 3
    puts("line #{n}: expected 1 to 3 darts")
    next
  end
  bad = Array.find(darts) { points(it) < 0 }
  if bad != nil
    puts("line #{n}: bad dart #{bad}")
    next
  end
  before = left[name] || 0
  cur = before
  state = 0
  last = ""
  Array.each(darts) do |d|
    thrown[name] += 1
    cur -= points(d)
    if cur < 0 || cur == 1 || (cur == 0 && !double?(d))
      state = 1
      cur = before
      break
    elsif cur == 0
      state = 2
      last = d
      break
    end
  end
  turns[name] += 1
  left[name] = cur
  if state == 1
    puts("#{name} busts, #{cur} left")
  elsif state == 2
    puts("#{name} checks out with #{last}")
    winner = name
  else
    puts("#{name} scores #{before - cur}, #{cur} left")
  end
end

puts("STANDINGS")
order = Array.sort_by(Range.to_a(0...Array.size(names))) { |i| [left[names[i]], i] }
Array.each_with_index(order) do |idx, r|
  nm = names[idx]
  l = left[nm] || 0
  th = thrown[nm]
  avg = th == 0 ? "-" : format("%.2f", Integer.fdiv((start - l) * 3, th))
  puts(format("%d. %-10s %4d %3d %6s", r + 1, nm, l, turns[nm], avg))
end
puts(winner == "" ? "no winner" : "winner: #{winner}")
