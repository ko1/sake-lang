# Port of activerecord-8.1.3/lib/arel.rb and arel/nodes.rb, arel/visitors.rb (the require lists)
#
# Ruby: Arel.sql(sql_string, *positional_binds, retryable: false, **named_binds). Sake has no keyword
# arguments at call sites, so named binds are one Hash argument (`Arel.sql("id = :id", Hash.of(id: 1))`);
# retryable literals are SqlLiteral.new(s, true).

require "arel/errors"
require "arel/factory_methods"
require "arel/expressions"
require "arel/predications"
require "arel/window_predications"
require "arel/math"
require "arel/alias_predication"
require "arel/order_predications"
require "arel/table"
require "arel/attributes/attribute"
require "arel/visitors/to_sql"
require "arel/visitors/sqlite"
require "arel/collectors/plain_string"
require "arel/collectors/sql_string"
require "arel/collectors/bind"
require "arel/collectors/composite"
require "arel/collectors/substitute_binds"
require "arel/tree_manager"
require "arel/crud"
require "arel/insert_manager"
require "arel/select_manager"
require "arel/update_manager"
require "arel/delete_manager"
require "arel/nodes/node"
require "arel/nodes/node_expression"
require "arel/nodes/select_statement"
require "arel/nodes/select_core"
require "arel/nodes/insert_statement"
require "arel/nodes/update_statement"
require "arel/nodes/bind_param"
require "arel/nodes/fragments"
require "arel/nodes/terminal"
require "arel/nodes/unary"
require "arel/nodes/grouping"
require "arel/nodes/homogeneous_in"
require "arel/nodes/ordering"
require "arel/nodes/unqualified_column"
require "arel/nodes/with"
require "arel/nodes/binary"
require "arel/nodes/equality"
require "arel/nodes/filter"
require "arel/nodes/in"
require "arel/nodes/join_source"
require "arel/nodes/delete_statement"
require "arel/nodes/table_alias"
require "arel/nodes/infix_operation"
require "arel/nodes/unary_operation"
require "arel/nodes/over"
require "arel/nodes/matches"
require "arel/nodes/cte"
require "arel/nodes/nary"
require "arel/nodes/function"
require "arel/nodes/extract"
require "arel/nodes/values_list"
require "arel/nodes/window"
require "arel/nodes/case"
require "arel/nodes/joins"
require "arel/nodes/comment"
require "arel/nodes/sql_literal"
require "arel/nodes/bound_sql_literal"
require "arel/nodes/casted"

module Arel
  module_function

  def VERSION = "10.0.0"

  def sql(sql_string, *binds)
    return sql_string if sql_string in Nodes::SqlLiteral
    if Array.empty?(binds)
      Nodes::SqlLiteral.new(sql_string)
    else
      first = Array.first(binds)
      if Array.size(binds) == 1 && (first in Hash)
        Nodes::BoundSqlLiteral.new(sql_string, nil, first)
      else
        Nodes::BoundSqlLiteral.new(sql_string, binds, nil)
      end
    end
  end

  def star = Nodes::SqlLiteral.new("*", true)

  def arel_node?(value) = (value in Nodes::Node | Arel::Attributes::Attribute | Nodes::SqlLiteral)


  # Sake only: Ruby's value.respond_to?(:unboundable?) && value.unboundable? (BindParam and QueryAttribute answer)
  def unboundable?(value)
    case value
    in Nodes::BindParam
      bv = Nodes::BindParam.value(value)
      (bv in ActiveRecord::Relation::QueryAttribute) ? ActiveRecord::Relation::QueryAttribute.unboundable?(bv) : nil
    in ActiveRecord::Relation::QueryAttribute then ActiveRecord::Relation::QueryAttribute.unboundable?(value)
    else nil
    end
  end

  # Sake only: Ruby's value.respond_to?(:infinite?) && value.infinite?
  def infinity?(value)
    case value
    in Float then Float.infinite?(value)
    in Nodes::Quoted then Nodes::Quoted.infinite?(value) ? 1 : nil
    else nil
    end
  end

  # Sake only: Ruby's object.class.name, for messages
  def class_name(o)
    case o
    in nil then "NilClass"
    in true then "TrueClass"
    in false then "FalseClass"
    in String then "String"
    in Symbol then "Symbol"
    in Integer then "Integer"
    in Float then "Float"
    in Hash then "Hash"
    in Array then "Array"
    in Time then "Time"
    else "Object"
    end
  end
end
