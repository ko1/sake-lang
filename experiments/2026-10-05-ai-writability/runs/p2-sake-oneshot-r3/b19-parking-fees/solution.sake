def money(c) = format("%d.%02d", c / 100, c % 100)

def part(r, first, step)
  return 0 if r == 0
  return first if r <= 60
  first + step * ((r - 60 + 29) / 30)
end

def fee(stay, first, step, cap, grace)
  return 0 if stay <= grace
  d = stay / 1440
  r = stay % 1440
  pr = part(r, first, step)
  d * cap + (pr < cap ? pr : cap)
end

lines = Array.map(String.split(IO.read(IO.stdin), "\n")) { |l| String.chomp(l) }
ht = Array.size(lines) > 0 ? String.split(lines[0]) : Array[]
first = 0
step = 0
cap = 0
grace = 0
if Array.size(ht) >= 5
  first = String.to_i(ht[1])
  step = String.to_i(ht[2])
  cap = String.to_i(ht[3])
  grace = String.to_i(ht[4])
end

inside = Hash[]
exits = Hash.new(0)
rev = Hash.new(0)
day = 0
prevm = -1
i = 1
while i < Array.size(lines)
  line = lines[i]
  no = i + 1
  i += 1
  next if String.match?(line, /\A *\z/)
  m = String.match(line, /\A *([0-9]{2}):([0-9]{2}) +(IN|OUT) +([A-Z0-9]{1,8}) *\z/)
  valid = false
  hh = 0
  mm = 0
  kind = ""
  plate = ""
  if m
    caps = MatchData.captures(m)
    hh = String.to_i(caps[0])
    mm = String.to_i(caps[1])
    kind = caps[2]
    plate = caps[3]
    valid = hh <= 23 && mm <= 59
  end
  if !valid
    puts("line #{no}: invalid")
    next
  end
  mins = hh * 60 + mm
  day += 1 if mins < prevm
  prevm = mins
  now = day * 1440 + mins
  if kind == "IN"
    if Hash.key?(inside, plate)
      puts("line #{no}: #{plate} already inside")
    else
      inside[plate] = now
    end
  else
    if Hash.key?(inside, plate)
      stay = now - inside[plate]
      Hash.delete(inside, plate)
      f = fee(stay, first, step, cap, grace)
      hm = format("%d:%02d", stay / 60, stay % 60)
      puts("#{plate} #{hm} #{money(f)}")
      exits[plate] += 1
      rev[plate] += f
    else
      puts("line #{no}: #{plate} not inside")
    end
  end
end

puts("--- summary")
plates = Array.sort_by(Hash.keys(exits)) { |pl| [-rev[pl], pl] }
tex = 0
trev = 0
Array.each(plates) do |pl|
  puts("#{pl} #{exits[pl]} #{money(rev[pl])}")
  tex += exits[pl]
  trev += rev[pl]
end
puts("total #{tex} #{money(trev)}")
left = Array.sort(Hash.keys(inside))
if Array.size(left) == 0
  puts("inside: none")
else
  joined = Array.join(left, ", ")
  puts("inside: #{joined}")
end
