# A helper that always raises does not count as an exit for narrowing; an inline raise does.
def die(m) = raise(ArgumentError, m)
def f(x)
  raise ArgumentError, "no" unless x in String
  String.upcase(x)
end
def g(x)
  die("no") unless x in String
  String.upcase(x)
end
p(f("a"))
p(g(Array["a", 1][0]))
