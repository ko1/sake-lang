require "rails/railties/rails/application/credentials"
require "fileutils"

# Credentials: Rails.application.credentials from config/credentials.yml.enc and config/master.key (a file
# `rails new` wrote), credentials:show and fetch, a new encrypted file written and read back, the errors of a
# missing or wrong key, RAILS_MASTER_KEY, and secret_key_base's lookup.
# (Ruby's application is fixtures/config/application.rb, root fixtures/; here the root and env are values)
EC = ActiveSupport::EncryptedConfiguration
root = File.expand_path("fixtures")
env = ENV.get("RAILS_ENV") || ENV.get("RACK_ENV") || "development"
def rel(root, path) = String.delete_prefix(path, root + "/")

puts("-- the application's credentials")
p(env)
content_path, key_path = Rails::Credentials.credentials_defaults(root, env)
p([rel(root, content_path), rel(root, key_path)])
credentials = Rails::Credentials.encrypted(root, content_path, key_path: key_path)
p(EC.option(credentials, :secret_key_base))
p(Hash.keys(EC.config(credentials)))
p(EC.dig(credentials, :aws, :access_key_id))
p(String.size(Kernel.to_s(EC.option(credentials, :secret_key_base!))))
puts("-- credentials:show")
puts(Rails::Credentials.show(credentials, key_path, content_path))
puts("-- an encrypted file of our own")
dir = Dir.mktmpdir
key = ActiveSupport::EncryptedFile.generate_key
p(String.size(key))
File.write(File.join(dir, "test.key"), key)
mine = Rails::Credentials.encrypted(root, File.join(dir, "test.yml.enc"), key_path: File.join(dir, "test.key"))
p(EC.read(mine))
EC.write(mine, "aws:\n  access_key_id: AKIA123\n  secret_access_key: \"s3cr3t\"\nlist:\n  - 1\n  - two\nname: Säke\n")
p(String.count(File.read(File.join(dir, "test.yml.enc")), "-") >= 4)
p(EC.read(mine))
p(EC.config(mine))
p(EC.dig(mine, :aws, :access_key_id))
aws = EC.[](mine, :aws)
aws => ActiveSupport::OrderedOptions
p(aws[:secret_access_key])
p(EC.option(mine, :name))
p(EC.option(mine, :list))
p(Rails::Credentials.fetch(mine, "aws.access_key_id", "TMP/test.key", "TMP/test.yml.enc"))
puts("-- change")
EC.change(mine) { |tmp| File.write(tmp, File.read(tmp) + "added: true\n") }
p(EC.config(Rails::Credentials.encrypted(root, File.join(dir, "test.yml.enc"), key_path: File.join(dir, "test.key")))[:added])
puts("-- errors")
wrong = EC.make(config_path: File.join(dir, "test.yml.enc"), key_path: "fixtures/config/master.key",
                env_key: "NO_SUCH_KEY", raise_if_missing_key: false)
begin
  EC.read(wrong)
rescue ActiveSupport::MessageEncryptor::InvalidMessage => e
  puts("InvalidMessage: #{Exception.message(e)}")
end
missing = EC.make(config_path: File.join(dir, "test.yml.enc"), key_path: File.join(dir, "none.key"),
                  env_key: "NO_SUCH_KEY", raise_if_missing_key: true)
begin
  EC.read(missing)
rescue ActiveSupport::EncryptedFile::MissingKeyError => e
  puts("MissingKeyError: #{String.sub(Exception.message(e), dir, "TMP")}")
end
nokey = Rails::Credentials.encrypted(root, File.join(dir, "test.yml.enc"), key_path: File.join(dir, "none.key"))
p([EC.key?(nokey) != nil, EC.read(nokey), EC.config(nokey)])
nofile = Rails::Credentials.encrypted(root, File.join(dir, "none.yml.enc"), key_path: File.join(dir, "test.key"))
p([EC.key?(nofile) != nil, EC.read(nofile), EC.config(nofile)])
short = ActiveSupport::EncryptedFile.new(content_path: File.join(dir, "short.enc"), key_path: File.join(dir, "short.key"),
                                         env_key: "NO_SUCH_KEY", raise_if_missing_key: true)
File.write(File.join(dir, "short.key"), "abc")
begin
  ActiveSupport::EncryptedFile.write(short, "x")
rescue ActiveSupport::EncryptedFile::InvalidKeyLengthError => e
  puts("InvalidKeyLengthError: #{Exception.message(e)}")
end
puts("-- RAILS_MASTER_KEY")
ENV.set("TEST_MASTER_KEY", key)
from_env = Rails::Credentials.encrypted(root, File.join(dir, "test.yml.enc"), key_path: File.join(dir, "none.key"), env_key: "TEST_MASTER_KEY")
p(EC.dig(from_env, :aws, :access_key_id))
ENV.set("TEST_MASTER_KEY", "")
p(EC.key?(from_env) != nil)
puts("-- secret_key_base")
p(Rails::Credentials.secret_key_base(root, env, credentials) == EC.option(credentials, :secret_key_base))
ENV.set("SECRET_KEY_BASE", "from the environment")
p(Rails::Credentials.secret_key_base(root, env, credentials))
ENV.delete("SECRET_KEY_BASE")
ENV.set("SECRET_KEY_BASE_DUMMY", "1")
s = Rails::Credentials.secret_key_base(dir, env, credentials)
p([String.size(s), File.read(File.join(dir, "tmp/local_secret.txt")) == s])
ENV.delete("SECRET_KEY_BASE_DUMMY")
begin
  Rails::Credentials.checked_secret_key_base(root, "production", nil)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
begin
  Rails::Credentials.checked_secret_key_base(root, "production", 42)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
FileUtils.rm_rf(dir)
