require "openssl"

keys = Any["key", "", "k" * 64, "k" * 65, "k" * 200, "日本語の鍵"]
data = Any["The quick brown fox jumps over the lazy dog", "", "a" * 1000, "héllo ✓"]
algs = Any["MD5", "SHA1", "SHA256", "SHA384", "SHA512", "sha256"]
Array.each(algs) do |alg|
  Array.each(keys) do |key|
    Array.each(data) { |d| puts "#{alg} #{String.bytesize(key)} #{String.bytesize(d)} #{OpenSSL::HMAC.hexdigest(alg, key, d)}" }
  end
end
# RFC 4231 test case 2
puts OpenSSL::HMAC.hexdigest("SHA256", "Jefe", "what do ya want for nothing?")
p String.bytesize(OpenSSL::HMAC.digest("SHA512", "key", "data"))
puts OpenSSL::HMAC.base64digest("SHA1", "key", "data")
begin
  OpenSSL::HMAC.hexdigest("XYZ", "key", "data")
rescue OpenSSL::Digest::DigestError => e
  puts String.split(Exception.message(e), ":")[0]
end
