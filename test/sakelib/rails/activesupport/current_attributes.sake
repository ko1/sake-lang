# ActiveSupport::CurrentAttributes: attributes with defaults, set { }, reset with its callbacks.

require "rails/activesupport/active_support/current_attributes"
generate "rails/activesupport/active_support/generate/active_support", "current_attributes_decl.rb"

class Current
  attr_accessor user, account, request_id
  include ActiveSupport::CurrentAttributes
  def log_reset(c) = puts("  before reset: #{Kernel.inspect(@user)}")
  def clear_cache(c) = puts("  after reset: #{Kernel.inspect(@user)}")
end

CA = ActiveSupport::CurrentAttributes
p(CA.attributes(Current.instance))
Current.instance.Current.user = "ko1"
Current.instance.Current.account = "ruby"
p([Current.user(Current.instance), Current.account(Current.instance), Current.request_id(Current.instance)])
p(Hash.sort_by(CA.attributes(Current.instance)) { |k, _| k })   # sorted: Sake's order is the fields', Ruby's the assignments'
CA.set(Current.instance, Hash.of(user: "matz", request_id: "r-1")) do
  p([Current.user(Current.instance), Current.request_id(Current.instance)])
end
p([Current.user(Current.instance), Current.request_id(Current.instance)])
CA.reset(Current.instance)
p([Current.user(Current.instance), Current.account(Current.instance), Current.request_id(Current.instance)])
p(Kernel.equal?(Current.instance, Current.instance))
