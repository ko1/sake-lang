# Ruby's include order: a module that comes in again through another include does not move up, and a required
# function of a module is fulfilled by what `<` pasted.
module AS
  def run(r) = "AS"
end
module V
  include AS
end
module AM
  include AS
  def run(r) = "AM"
end
class P1
  attr_accessor x
  include V
  include AM
end
class P2
  attr_accessor x
  include AM
  include V
end
p(P1.run(P1.new(1)), P2.run(P2.new(1)))
module M
  def name(x) = raise(NotImplementedError)
  def show(x) = "M sees #{name(x)}"
end
class A
  attr_reader v
  def name(x) = "A's name"
end
class B < A
  include M
end
class C < B
end
p(B.show(B.new(1)), C.show(C.new(1)))
