# tsort: a 3000-node DAG (each node points at the next 3), via the Hash-graph functions.
require "tsort"
h = Hash[]
Range.each(0...3000) { |i| h[i] = Array.select(Array[i + 1, i + 2, i + 3]) { |j| j < 3000 } }
order = TSort.tsort_hash(h)
p([Array.size(order), Array.first(order), Array.last(order)])
