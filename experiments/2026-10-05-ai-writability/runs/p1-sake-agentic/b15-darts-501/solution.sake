# token => [points, double?]
def dart_table
  t = Hash[]
  Integer.upto(1, 20) do |i|
    t["S#{i}"] = [i, false]
    t["D#{i}"] = [i * 2, true]
    t["T#{i}"] = [i * 3, false]
  end
  t["25"] = [25, false]
  t["BULL"] = [50, true]
  t["MISS"] = [0, false]
  t
end

lines = Array.map(IO.readlines(IO.stdin)) { |l| String.chomp(l) }
hf = Array.empty?(lines) ? Array[] : String.split(lines[0])
ok = Array.size(hf) >= 2 && Array.size(hf) <= 5
start = 0
if ok
  h0 = hf[0]
  h0 => String
  ok = String.match?(h0, /\A\d+\z/)
  if ok
    start = String.to_i(h0)
    ok = start >= 2 && start <= 1001
  end
end
names = Array[]
if ok
  names = hf[1..]
  Array.each(names) { |nm| ok = false unless String.match?(nm, /\A[a-z]{1,10}\z/) }
  ok = false if Array.size(Array.uniq(names)) != Array.size(names)
end
unless ok
  puts("invalid header")
  exit
end

table = dart_table
st = Hash[]
Array.each(names) { |nm| st[nm] = Array[start, 0, 0] }
winner = nil

Array.each_with_index(lines) do |raw, idx|
  next if idx == 0
  n = idx + 1
  f = String.split(raw)
  next if Array.empty?(f)
  if winner != nil
    puts("line #{n}: game over")
    next
  end
  nm = f[0]
  nm => String
  unless Hash.key?(st, nm)
    puts("line #{n}: unknown player #{nm}")
    next
  end
  darts = f[1..]
  if Array.size(darts) < 1 || Array.size(darts) > 3
    puts("line #{n}: expected 1 to 3 darts")
    next
  end
  bad = Array.find(darts) { |d| !Hash.key?(table, d) }
  if bad != nil
    puts("line #{n}: bad dart #{bad}")
    next
  end
  s = st[nm]
  s => Array
  begin_left = s[0]
  left = begin_left
  total = 0
  thrown = 0
  result = :score
  last = ""
  Array.each(darts) do |d|
    info = table[d]
    pts, dbl = info
    thrown += 1
    left -= pts
    total += pts
    last = d
    if left < 0 || left == 1 || (left == 0 && !dbl)
      result = :bust
      left = begin_left
      break
    elsif left == 0
      result = :out
      break
    end
  end
  s[0] = left
  s[1] += 1
  s[2] += thrown
  case result
  in :bust then puts("#{nm} busts, #{left} left")
  in :out
    winner = nm
    puts("#{nm} checks out with #{last}")
  else puts("#{nm} scores #{total}, #{left} left")
  end
end

puts("STANDINGS")
idxs = Array.new(Array.size(names)) { |i| i }
ranked = Array.sort_by(idxs) { |i| [st[names[i]][0], i] }
Array.each_with_index(ranked) do |i, r|
  nm = names[i]
  s = st[nm]
  left = s[0]
  thrown = s[2]
  avg = thrown == 0 ? "-" : format("%.2f", (start - left) * 3.0 / thrown)
  puts(format("%d. %-10s %4d %3d %6s", r + 1, nm, left, s[1], avg))
end
puts(winner == nil ? "no winner" : "winner: #{winner}")
