# Benchmark: Ruby's benchmark. Times come from Time.now; the CPU times (utime, stime, cutime, cstime)
# are always 0.0, since Sake has no Process.times.

module Benchmark
  # Ruby's Benchmark::Tms.
  class Tms
    attr_reader utime, stime, cutime, cstime, real, label
    include Arithmetic

    # As Ruby's label.to_s: any label (nil, a Symbol) becomes a String.
    def initialize(t)
      @utime = 0.0 if @utime == nil
      @stime = 0.0 if @stime == nil
      @cutime = 0.0 if @cutime == nil
      @cstime = 0.0 if @cstime == nil
      @real = 0.0 if @real == nil
      @label = "" if @label == nil
      @label = "#{@label}"
    end

    def total(t) = @utime + @stime + @cutime + @cstime

    def +(a, b) = memberwise(a, :+, b)
    def -(a, b) = memberwise(a, :-, b)
    def *(a, b) = memberwise(a, :*, b)
    def /(a, b) = memberwise(a, :/, b)

    def apply(op, x, y)
      case op
      in :+ then x + y
      in :- then x - y
      in :* then x * y
      in :/ then x / y
      end
    end

    # Ruby's memberwise: the result has no label.
    def memberwise(t, op, x)
      case x
      in Tms
        Tms.new(apply(op, @utime, x.Tms.utime), apply(op, @stime, x.Tms.stime),
                         apply(op, @cutime, x.Tms.cutime), apply(op, @cstime, x.Tms.cstime),
                         apply(op, @real, x.Tms.real))
      in Integer | Float
        Tms.new(apply(op, @utime, x), apply(op, @stime, x), apply(op, @cutime, x), apply(op, @cstime, x),
                         apply(op, @real, x))
      end
    end

    # Ruby's Tms#format: %u %y %U %Y %t %r (the real time in parentheses) %n (the label), each with
    # optional flags such as %10.6u, replaced one directive after another as Ruby's gsub! calls do.
    # With a format given, the result goes through `str % args` (%% becomes %, a stray % raises).
    def format(t, fmt = nil, *args)
      str = fmt == nil ? Benchmark.FORMAT : fmt
      str = String.gsub(str, /%[-+.\d]*n/) { |m| Kernel.format(String.chop(m) + "s", @label) }
      str = String.gsub(str, /%[-+.\d]*u/) { |m| Kernel.format(String.chop(m) + "f", @utime) }
      str = String.gsub(str, /%[-+.\d]*y/) { |m| Kernel.format(String.chop(m) + "f", @stime) }
      str = String.gsub(str, /%[-+.\d]*U/) { |m| Kernel.format(String.chop(m) + "f", @cutime) }
      str = String.gsub(str, /%[-+.\d]*Y/) { |m| Kernel.format(String.chop(m) + "f", @cstime) }
      str = String.gsub(str, /%[-+.\d]*t/) { |m| Kernel.format(String.chop(m) + "f", Tms.total(t)) }
      str = String.gsub(str, /%[-+.\d]*r/) { |m| "(" + Kernel.format(String.chop(m) + "f", @real) + ")" }
      fmt == nil ? str : Kernel.format(str, *args)
    end

    def to_s(t) = Tms.format(t)
    def to_a(t) = Array[@label, @utime, @stime, @cutime, @cstime, @real]
    def to_h(t) = Hash[label: @label, utime: @utime, stime: @stime, cutime: @cutime, cstime: @cstime, real: @real]

    # Ruby's add { }: a new Tms, this one plus the block's measure.
    def add(t, &b) = t + Benchmark.measure(&b)

    def add!(t, &b)
      m = Benchmark.measure(&b)
      @utime += m.Tms.utime
      @stime += m.Tms.stime
      @cutime += m.Tms.cutime
      @cstime += m.Tms.cstime
      @real += m.Tms.real
      t
    end
  end

  # Ruby's Benchmark::Report and Benchmark::Job in one: `report` measures and records, as Ruby's
  # report; in bmbm, the block given to bmbm runs once per mode (:collect, :rehearsal, :real).
  class Report
    attr_reader width, format, list
    private attr_reader mode
    def initialize(b)
      @width = 0 if @width == nil
      @list = Tms[]
      @mode = :report if @mode == nil
    end

    # Ruby ignores the format arguments too.
    def report(r, label = "", *format, &b)
      w = String.length(label)
      @width = w if @width < w
      return Tms.new if @mode == :collect
      print(String.ljust(label, @width)) unless @mode == :report
      t = Benchmark.measure(label, &b)
      Array.push(@list, t)
      print(t) unless @mode == :report
      t
    end

    def item(r, label = "", *format, &b) = report(r, label, &b)
  end

  module_function

  def CAPTION = "      user     system      total        real\n"
  def FORMAT = "%10.6u %10.6y %10.6t %10.6r\n"

  # Seconds the block takes (Ruby uses the monotonic clock; Sake has Time.now only).
  def realtime
    t0 = Time.now
    yield
    Time.now - t0
  end

  def ms
    t0 = Time.now
    yield
    (Time.now - t0) * 1000.0
  end

  def measure(label = "")
    t0 = Time.now
    yield
    Tms.new(0.0, 0.0, 0.0, 0.0, Time.now - t0, label)
  end

  # Prints after the block returns, as Ruby does: caption, then each report's line. When the block
  # returns an Array, its Tms values are printed too, labeled from `labels` (Ruby's ">total:" lines).
  def benchmark(caption = "", label_width = 0, format = Benchmark.FORMAT, *labels, &b) =
    benchmark_labels(caption, label_width, format, labels, &b)

  # benchmark with the labels as an Array: `bm` cannot pass its *labels on with a splat
  # (notes/benchmark_bug_splat_to_rest.sake).
  def benchmark_labels(caption, label_width, format, labels)
    r = Report.new(label_width + 1, format)
    results = yield(r)
    print(" " * r.Report.width + caption) unless String.empty?(caption)
    list = r.Report.list
    Array.each(list) do |t|
      print(String.ljust(t.Tms.label, r.Report.width))
      print(Tms.format(t, format))
    end
    # Ruby's `Array === results`; `[a, b]` is a Tuple in Sake.
    results = Tuple.to_a(results) if results in Tuple
    if results in Array
      Array.each(results) do |t|
        if t in Tms
          print(String.ljust(Array.shift(labels) || t.Tms.label, label_width + 1), Tms.format(t, format))
        end
      end
    end
    list
  end

  def bm(label_width = 0, *labels, &b) = benchmark_labels(Benchmark.CAPTION, label_width, Benchmark.FORMAT, labels, &b)

  # Ruby's bmbm stores the blocks and runs each twice; Sake cannot store blocks, so the block given
  # to bmbm runs three times: to collect the labels, for the rehearsal, and for the real run.
  def bmbm(width = 0)
    r = Report.new(width, Benchmark.FORMAT, mode: :collect)
    yield(r)
    w = Report.width(r) + 1
    cap = Benchmark.CAPTION
    puts(String.ljust("Rehearsal ", w + String.length(cap), "-"))
    reh = Report.new(w, Benchmark.FORMAT, mode: :rehearsal)
    yield(reh)
    sum = Array.inject(Report.list(reh), Tms.new) { |acc, t| acc + t }
    ets = Tms.format(sum, "total: %tsec")
    print(String.rjust(" #{ets}\n\n", w + String.length(cap) + 2, "-"))
    print(" " * w + cap)
    real = Report.new(w, Benchmark.FORMAT, mode: :real)
    yield(real)
    Report.list(real)
  end
end
