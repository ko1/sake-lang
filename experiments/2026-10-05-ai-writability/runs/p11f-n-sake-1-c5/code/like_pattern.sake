# LIKE matching (spec 2.3, 7.3): `%` any run of characters, `_` one character, others match ignoring
# ASCII case. `esc` is the ESCAPE character, or "" for none (see PatternMatch.like_tokens).
module LikePattern
  module_function

  def matches?(text, pattern, esc)
    toks = PatternMatch.like_tokens(String.chars(Value.lower(pattern)), Value.lower(esc))
    return false if toks == nil
    PatternMatch.run(String.chars(Value.lower(text)), toks)
  end
end
