# Not a bug, a limit: there is no identity comparison (equal?/object_id), and `==` on Struct
# values compares contents. Removing "this handler" from a list removes every equal one.
class Rec < {reader: [events]}
end
subs = Rec[Rec.new(Array[]), Rec.new(Array[])]
me = Array.first(subs)
Array.delete_if(subs) { |h| h == me }
p(Array.size(subs))   # 0, not 1
