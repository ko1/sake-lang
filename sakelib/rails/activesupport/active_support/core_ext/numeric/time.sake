# Port of activesupport-8.1.3/lib/active_support/core_ext/numeric/time.rb
#
# Ruby's methods are in class Numeric; here a module Numeric that Integer and Float include, so `2.hours` is
# `Integer.hours(2)` and `1.5.days` is `Float.days(1.5)` (`Numeric.hours(x)` takes either).

require "../../duration"

module Numeric
  def seconds(n) = ActiveSupport::Duration.seconds(n)
  def second(n) = ActiveSupport::Duration.seconds(n)
  def minutes(n) = ActiveSupport::Duration.minutes(n)
  def minute(n) = ActiveSupport::Duration.minutes(n)
  def hours(n) = ActiveSupport::Duration.hours(n)
  def hour(n) = ActiveSupport::Duration.hours(n)
  def days(n) = ActiveSupport::Duration.days(n)
  def day(n) = ActiveSupport::Duration.days(n)
  def weeks(n) = ActiveSupport::Duration.weeks(n)
  def week(n) = ActiveSupport::Duration.weeks(n)
  def fortnights(n) = ActiveSupport::Duration.weeks(n * 2)
  def fortnight(n) = ActiveSupport::Duration.weeks(n * 2)
  def in_milliseconds(n) = n * 1000
end

class Integer
  include Numeric
end

class Float
  include Numeric
end
