# OptionParser: Ruby's optparse with options declared as data.
# Blocks are not values, so `on` stores no block: parse(op, argv, into: h) fills the Hash h
# (Ruby's `parse(argv, into: h)`) and returns the remaining arguments. argv defaults to ARGV.

class OptionParserError < Exception
  attr_reader kind, args
  # Ruby's ParseError#reason: "invalid option" for InvalidOption, ...
  def reason(e)
    case OptionParserError.kind(e)
    in "InvalidOption" then "invalid option"
    in "MissingArgument" then "missing argument"
    in "InvalidArgument" then "invalid argument"
    in "NeedlessArgument" then "needless argument"
    in "AmbiguousOption" then "ambiguous option"
    in "AmbiguousArgument" then "ambiguous argument"
    else "parse error"
    end
  end

  def make(kind, args)
    e = OptionParserError.new("", kind, args)
    OptionParserError.set_message(e, "#{OptionParserError.reason(e)}: #{Array.join(args, " ")}")
    e
  end
end

# One declared option. kind: :none, :required, :optional. conv: :String, :Integer, :Float, :choice.
class OptionParserSwitch
  attr_reader short, long, arg, kind, negatable, conv, choices, desc, tail
  def key(sw) = String.to_sym(@long != "" ? @long : @short)
end

# Fields start as Ruby's OptionParser.new(banner = nil, width = 32, indent = " " * 4).
class OptionParser
  attr_accessor banner = nil, summary_width = 32, summary_indent = "    ", program_name = "sake", version = nil
  attr_reader list = nil

  def initialize(op)
    @list = Array[]
  end

  # Ruby's on("-v", "--[no-]verbose", Integer, "desc"): each argument is sorted by its content,
  # "-x" short, "--xx" long, a Symbol type (:Integer, :Float, :String) or an Array of allowed
  # Strings, and anything else the description.
  def on(op, a, b = "", c = "", d = "") = declare(op, Array[a, b, c, d], false)
  def on_tail(op, a, b = "", c = "", d = "") = declare(op, Array[a, b, c, d], true)

  def declare(op, args, tail)
    short = ""
    long = ""
    conv = :String
    choices = String[]
    desc = ""
    Array.each(args) do |x|
      case x
      in String
        if String.start_with?(x, "--")
          long = x
        elsif String.start_with?(x, "-")
          short = x
        elsif x != ""
          desc = desc == "" ? x : desc
        end
      in Symbol
        unless x == :String || x == :Integer || x == :Float
          raise ArgumentError, "unsupported argument type: #{x}"
        end
        conv = x
      in Array
        conv = :choice
        Array.each(x) { |c| Array.push(choices, c) }
      end
    end
    add_switch(op, short, long, conv, choices, desc, tail)
  end

  def separator(op, text)
    Array.push(@list, text)
    op
  end

  def add_switch(op, short, long, conv, choices, desc, tail)
    s = ""
    l = ""
    arg = ""
    neg = false
    if short != ""
      m = Regexp.match(/\A-([^-\s])(.*)\z/, short)
      raise ArgumentError, "bad short option: #{short}" unless m
      s = m[1]
      sarg = m[2]
      arg = sarg if sarg
    end
    if long != ""
      m = Regexp.match(/\A--(\[no-\])?([^\s=\[]+)(.*)\z/, long)
      raise ArgumentError, "bad long option: #{long}" unless m
      neg = m[1] != nil
      l = m[2]
      larg = m[3]
      arg = larg if larg && larg != ""
    end
    raise ArgumentError, "no option name" if s == "" && l == ""
    s = "" if s == nil
    l = "" if l == nil
    kind = :none
    if arg != ""
      kind = String.include?(arg, "[") ? :optional : :required
    end
    sw = OptionParserSwitch.new(s, l, arg, kind, neg, conv, choices, desc, tail)
    Array.push(@list, sw)
    op
  end

  def help(op)
    b = @banner
    head = b == nil ? "Usage: #{@program_name} [options]" : b
    out = String.sub(head, /\n?\z/, "\n")
    Array.each(@list) do |it|
      case it
      in String
        out += String.end_with?(it, "\n") ? it : it + "\n"
      in OptionParserSwitch
        out += summarize(op, it) unless OptionParserSwitch.tail(it)
      end
    end
    Array.each(@list) do |it|
      if it in OptionParserSwitch
        out += summarize(op, it) if OptionParserSwitch.tail(it)
      end
    end
    out
  end

  def to_s(op) = help(op)

  # One switch's lines in the help, as Ruby's Switch#summarize.
  def summarize(op, sw)
    width = @summary_width
    indent = @summary_indent
    s = OptionParserSwitch.short(sw)
    l = OptionParserSwitch.long(sw)
    left = s != "" ? "-" + s : ""
    if l != ""
      ldisp = "--" + (OptionParserSwitch.negatable(sw) ? "[no-]" : "") + l
      left = left == "" ? "    " + ldisp : left + ", " + ldisp
    end
    left += OptionParserSwitch.arg(sw)
    desc = OptionParserSwitch.desc(sw)
    if String.size(left) > width
      out = indent + left + "\n"
      out += indent + String.ljust("", width) + " " + desc + "\n" if desc != ""
      out
    elsif desc == ""
      indent + left + "\n"
    else
      indent + String.ljust(left, width) + " " + desc + "\n"
    end
  end

  def parse(op, argv = ARGV, into: Hash[]) = run(op, argv, into, false)
  def order(op, argv = ARGV, into: Hash[]) = run(op, argv, into, true)
  def permute(op, argv = ARGV, into: Hash[]) = run(op, argv, into, false)

  def parse!(op, argv = ARGV, into: Hash[]) = replace_args(argv, run(op, argv, into, false))
  def order!(op, argv = ARGV, into: Hash[]) = replace_args(argv, run(op, argv, into, true))
  def permute!(op, argv = ARGV, into: Hash[]) = replace_args(argv, run(op, argv, into, false))

  # Ruby's OptionParser#warn and #abort: the message after the program name, on stderr.
  def warn(op, msg)
    IO.puts(IO.stderr, "#{@program_name}: #{msg}")
  end

  def abort(op, msg)
    IO.puts(IO.stderr, "#{@program_name}: #{msg}")
    exit(1)
  end

  # Ruby's ver: the program name and version, or nil without a version.
  def ver(op)
    v = @version
    v == nil ? nil : "#{@program_name} #{v}"
  end

  def replace_args(argv, rest)
    Array.clear(argv)
    Array.concat(argv, rest)
    argv
  end

  # Ruby's getopts("ab:", "long", "name:"): a Hash from each option name (a String) to true/false
  # for a flag and a String or nil for an option with ":"; argv keeps the remaining arguments.
  def getopts(op, argv, short_spec, long_specs = String[])
    g = OptionParser.new
    result = Hash[]
    chars = String.chars(short_spec)
    i = 0
    while i < Array.size(chars)
      c = Array.fetch(chars, i)
      takes = Array.fetch(chars, i + 1) == ":" rescue false
      if takes
        OptionParser.on(g, "-#{c} VALUE")
        result[c] = nil
        i += 2
      else
        OptionParser.on(g, "-#{c}")
        result[c] = false
        i += 1
      end
    end
    Array.each(long_specs) do |spec|
      if String.end_with?(spec, ":")
        name = String.delete_suffix(spec, ":")
        OptionParser.on(g, "--#{name} VALUE")
        result[name] = nil
      else
        OptionParser.on(g, "--#{spec}")
        result[spec] = false
      end
    end
    got = Hash[]
    OptionParser.order!(g, argv, into: got)   # Ruby stops at the first non-option
    Hash.each(got) { |k, v| result[Symbol.to_s(k)] = v }
    result
  end

  def run(op, argv, into, in_order)
    rest = String[]
    sws = Array.filter_map(@list) { |it| (it in OptionParserSwitch) ? it : nil }
    n = Array.size(argv)
    i = 0
    while i < n
      a = Array.fetch(argv, i)
      i += 1
      if a == "--"
        Array.concat(rest, Array.drop(argv, i))
        return rest
      elsif String.start_with?(a, "--")
        i = parse_long(op, sws, argv, i, a, into)
      elsif String.start_with?(a, "-") && String.size(a) > 1
        i = parse_short(sws, argv, i, a, into)
      elsif in_order
        Array.push(rest, a)
        Array.concat(rest, Array.drop(argv, i))
        return rest
      else
        Array.push(rest, a)
      end
    end
    rest
  end

  def fail(kind, args)
    raise OptionParserError.make(kind, args)
  end

  def parse_long(op, sws, argv, i, a, into)
    name, eq, val = String.partition(String.delete_prefix(a, "--"), "=")
    has_eq = eq != ""
    sw, neg = find_long(op, sws, name, a)
    kind = OptionParserSwitch.kind(sw)
    if kind == :none
      fail("NeedlessArgument", String[a]) if has_eq
      into[OptionParserSwitch.key(sw)] = !neg
      return i
    end
    v = nil
    args = String[a]
    if has_eq
      v = val
    elsif kind == :required
      fail("MissingArgument", String[a]) if i >= Array.size(argv)
      v = Array.fetch(argv, i)
      i += 1
      args = String[a, v]
    elsif i < Array.size(argv) && !String.start_with?(Array.fetch(argv, i), "-")
      v = Array.fetch(argv, i)
      i += 1
      args = String[a, v]
    end
    into[OptionParserSwitch.key(sw)] = convert(sw, v, args)
    i
  end

  def parse_short(sws, argv, i, a, into)
    len = String.size(a)
    j = 1
    while j < len
      c = String.[](a, j)
      sw = Array.find(sws) { |x| OptionParserSwitch.short(x) == c }
      fail("InvalidOption", String["-#{c}"]) unless sw
      j += 1
      kind = OptionParserSwitch.kind(sw)
      if kind == :none
        into[OptionParserSwitch.key(sw)] = true
        next
      end
      v = nil
      args = String[a]
      if j < len
        v = String.[](a, j, len - j)
        j = len
      elsif kind == :required
        fail("MissingArgument", String["-#{c}"]) if i >= Array.size(argv)
        v = Array.fetch(argv, i)
        i += 1
        args = String["-#{c}", v]
      elsif i < Array.size(argv) && !String.start_with?(Array.fetch(argv, i), "-")
        v = Array.fetch(argv, i)
        i += 1
        args = String["-#{c}", v]
      end
      into[OptionParserSwitch.key(sw)] = convert(sw, v, args)
    end
    i
  end

  # [switch, negated?] for a long name: an exact name, or else a prefix of exactly one name.
  def find_long(op, sws, name, a)
    cands = Array[]
    Array.each(sws) do |sw|
      l = OptionParserSwitch.long(sw)
      next if l == ""
      Array.push(cands, [l, sw, false])
      Array.push(cands, ["no-" + l, sw, true]) if OptionParserSwitch.negatable(sw)
    end
    exact = Array.find(cands) { |(nm, _, _)| nm == name }
    if exact
      _, sw, neg = exact
      return [sw, neg]
    end
    hits = Array.select(cands) { |(nm, _, _)| String.start_with?(nm, name) }
    officious(op, name) if Array.empty?(hits)
    fail("InvalidOption", String[a]) if Array.empty?(hits)
    fail("AmbiguousOption", String[a]) if Array.size(hits) > 1
    _, sw, neg = Array.fetch(hits, 0)
    [sw, neg]
  end

  # Ruby's built-in --help and --version, used when no declared long option matches.
  def officious(op, name)
    return nil if name == ""
    if String.start_with?("help", name)
      IO.print(IO.stdout, help(op))
      exit(0)
    end
    if String.start_with?("version", name)
      v = ver(op)
      abort(op, "version unknown") if v == nil
      IO.puts(IO.stdout, v)
      exit(0)
    end
    nil
  end

  def convert(sw, v, args)
    return nil if v == nil
    case OptionParserSwitch.conv(sw)
    in :String then v
    in :Integer
      re = /\A[-+]?(?:0(?:[0-7]+(?:_[0-7]+)*|b[01]+(?:_[01]+)*|x[\da-f]+(?:_[\da-f]+)*)?|\d+(?:_\d+)*)\z/i
      fail("InvalidArgument", args) unless Regexp.match?(re, v)
      begin
        Integer(v)
      rescue ArgumentError
        fail("InvalidArgument", args)
      end
    in :Float
      re = /\A[-+]?(?:\d+(?:_\d+)*(?:\.(?:\d+(?:_\d+)*)?)?|\.\d+(?:_\d+)*)(?:e[-+]?\d+(?:_\d+)*)?\z/i
      fail("InvalidArgument", args) unless Regexp.match?(re, v)
      String.to_f(v)
    in :choice
      choices = OptionParserSwitch.choices(sw)
      return v if Array.include?(choices, v)
      hits = Array.select(choices) { |c| String.start_with?(c, v) }
      fail("InvalidArgument", args) if Array.empty?(hits)
      fail("AmbiguousArgument", args) if Array.size(hits) > 1
      Array.fetch(hits, 0)
    end
  end
end
