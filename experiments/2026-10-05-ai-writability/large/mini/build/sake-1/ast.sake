# The syntax tree (SPEC section 3). Every node keeps the position its errors
# are reported at: the token named in each comment.
#
# A block is an Array of statement nodes.

# ---- expressions ----

# An int, a string without interpolation, true, false or nil. (the token)
class Lit
  attr_reader value, line, col
end

# A string with interpolations: parts are Strings and expression nodes.
# (the opening quote)
class Interp
  attr_reader parts, line, col
end

# A use of a name. `depth` is the scope depth of the declaration it refers to
# (SPEC 5.1), filled in by the static checks. (the name)
class Name
  attr_reader name, line, col
  attr_accessor depth
end

# (the `[`)
class ArrayLit
  attr_reader elems, line, col
end

# `keys[i]: values[i]`; `key_pos[i]` is `[line, col]` of key i, where a bad
# key is reported. (the `{`)
class MapLit
  attr_reader keys, values, key_pos, line, col
end

# `fn name(params) body end` or `fn (params) body end` (name nil).
# `required` is the number of parameters without a default.
# (the name, or the `fn` of an anonymous function)
class FnExpr
  attr_reader name, params, body, required, line, col
end

# `default` is nil when the parameter has none. (the name)
class Param
  attr_reader name, default, line, col
end

# `-x` or `not x`. (the operator)
class Unary
  attr_reader op, operand, line, col
end

# Arithmetic, comparison, `in`, `and`, `or`. (the operator)
class Binary
  attr_reader op, left, right, line, col
end

# (the `(`)
class Call
  attr_reader callee, args, line, col
end

# `target[index]`. (the `[`)
class Subscript
  attr_reader target, index, line, col
end

# `target.name`, which means `target["name"]`. (the `.`)
class Field
  attr_reader target, name, line, col
end

# `target[low:high]`; a missing bound is nil. (the `[`)
class Slice
  attr_reader target, low, high, line, col
end

# ---- statements ----

# A declared name. (the name)
class Ident
  attr_reader name, line, col
end

# `let x [= value]`; value is nil without `=`. (the name)
class LetStmt
  attr_reader name, value, line, col
end

# `let [a, b] = value`; names are Idents. (the `[`)
class LetArray
  attr_reader names, value, line, col
end

# (the name)
class ConstStmt
  attr_reader name, value, line, col
end

class FnDecl
  attr_reader fn
end

# `if conds[0] then blocks[0] elif ... else else_block end`; else_block may be
# nil. (the `if`)
class IfStmt
  attr_reader conds, blocks, else_block, line, col
end

# (the `match`)
class MatchStmt
  attr_reader subject, arms, else_block, line, col
end

class WhenArm
  attr_reader values, body
end

# (the `while`)
class WhileStmt
  attr_reader cond, body, line, col
end

# `for names[0][, names[1]] in iter do body end`. (the `for`)
class ForStmt
  attr_reader names, iter, body, line, col
end

# `kind` is :break or :continue. (the keyword)
class LoopJump
  attr_reader kind, line, col
end

# value is nil for a bare `return`. (the `return`)
class ReturnStmt
  attr_reader value, line, col
end

# (the `throw`)
class ThrowStmt
  attr_reader value, line, col
end

# message is nil without `, message`. (the `assert`)
class AssertStmt
  attr_reader cond, message, line, col
end

# catch_name (an Ident), handler and finally_block are nil when absent.
# (the `try`)
class TryStmt
  attr_reader body, catch_name, handler, finally_block, line, col
end

# `targets = values` (several of each for a multiple assignment) or
# `target op= value` (one each); op is "=", "+=", ... (the operator)
class AssignStmt
  attr_reader targets, op, values, line, col
end

class ExprStmt
  attr_reader expr
end

# The function declarations of a block, which are hoisted (SPEC 5.1, 6.4).
def block_functions(stmts)
  fns = FnExpr[]
  Array.each(stmts) do |s|
    Array.push(fns, FnDecl.fn(s)) if s in FnDecl
  end
  fns
end
