require "minitest"

# The built-in operations added on 2026-10-09 (the rest of Ruby's core API), checked against what Ruby gives.
# `[a, b]` is a Tuple: a result that is an Array is compared with `Array[...]`.
suite = Minitest.suite("core")

Minitest.test(suite, "Integer: numerator, denominator, size, integer?, rationalize") do |t|
  Minitest.assert_equal(t, 7, Integer.numerator(7))
  Minitest.assert_equal(t, 1, Integer.denominator(7))
  Minitest.assert_equal(t, 8, Integer.size(7))
  Minitest.assert(t, Integer.integer?(7))
  Minitest.assert_equal(t, 2r, Integer.rationalize(2))
  Minitest.assert_equal(t, 7, Integer.to_int(7))
end

Minitest.test(suite, "Float: arg, numerator, denominator, to_int") do |t|
  Minitest.assert_equal(t, 0, Float.arg(1.5))
  Minitest.assert_in_delta(t, Math.PI, Float.angle(-1.5))
  Minitest.assert_equal(t, 3, Float.numerator(1.5))
  Minitest.assert_equal(t, 2, Float.denominator(1.5))
  Minitest.assert_equal(t, 1, Float.to_int(1.9))
  Minitest.assert_equal(t, -1, Float.to_int(-1.9))
end

Minitest.test(suite, "Rational: fdiv, quo, magnitude, rationalize, to_r") do |t|
  Minitest.assert_equal(t, 0.25, Rational.fdiv(1r / 2, 2))
  Minitest.assert_equal(t, 1r / 4, Rational.quo(1r / 2, 2))
  Minitest.assert_equal(t, 1r / 2, Rational.magnitude(-1r / 2))
  Minitest.assert_equal(t, 3r / 2, Rational.rationalize(3r / 2))
  Minitest.assert_equal(t, 3r / 2, Rational.to_r(3r / 2))
  Minitest.assert_match(t, /divided by 0/, Minitest.assert_raises(t) { Rational.quo(1r / 2, 0) })
end

Minitest.test(suite, "Complex: abs2, rect, conj, real?, to_i, quo") do |t|
  c = Kernel.Complex(3, 4)
  Minitest.assert_equal(t, 25, Complex.abs2(c))
  Minitest.assert_equal(t, [3, 4], Complex.rect(c))
  Minitest.assert_equal(t, Kernel.Complex(3, -4), Complex.conj(c))
  Minitest.refute(t, Complex.real?(c))
  Minitest.assert_equal(t, 4, Complex.imag(c))
  Minitest.assert_equal(t, 5.0, Complex.magnitude(c))
  Minitest.assert_equal(t, 3, Complex.to_i(Kernel.Complex(3, 0)))
  Minitest.assert_equal(t, Kernel.Complex(3r / 2, 2), Complex.quo(c, 2))
  Minitest.assert_in_delta(t, 0.927, Complex.arg(c), 0.001)
  Minitest.assert_match(t, /imaginary|can't convert/i, Minitest.assert_raises(t) { Complex.to_i(c) })
end

Minitest.test(suite, "String in place: upcase!, chomp!, squeeze!, tr!, slice!, sub!, gsub!") do |t|
  s = "hello"
  Minitest.assert_equal(t, "HELLO", String.upcase!(s))
  Minitest.assert_nil(t, String.upcase!(s))
  Minitest.assert_equal(t, "HELLO", s)
  line = "a line\n"
  String.chomp!(line)
  Minitest.assert_equal(t, "a line", line)
  Minitest.assert_nil(t, String.chomp!(line))
  Minitest.assert_equal(t, "bokeper", String.squeeze!("bookkeeper"))
  w = "hello"
  Minitest.assert_equal(t, "hippo", String.tr!(w, "el", "ip"))
  Minitest.assert_nil(t, String.tr!(w, "x", "y"))
  w2 = "hello world"
  Minitest.assert_equal(t, "world", String.slice!(w2, 6, 5))
  Minitest.assert_equal(t, "hello ", w2)
  Minitest.assert_equal(t, "h", String.slice!(w2, 0))
  Minitest.assert_nil(t, String.slice!(w2, 100))
  w3 = "a-b-c"
  Minitest.assert_equal(t, "a+b-c", String.sub!(w3, "-", "+"))
  Minitest.assert_equal(t, "a+b+c", String.gsub!(w3, /-/, "+"))
  Minitest.assert_nil(t, String.gsub!(w3, /-/, "+"))
  w4 = "x1y2"
  Minitest.assert_equal(t, "x<1>y<2>", String.gsub!(w4, /\d/) { |m| "<#{m}>" })
  Minitest.assert_equal(t, "Hello", String.capitalize!("hello"))
  Minitest.assert_nil(t, String.capitalize!("Hello"))
  Minitest.assert_equal(t, "olleh", String.reverse!("hello"))
  Minitest.assert_equal(t, "ac", String.delete!("abc", "b"))
  Minitest.assert_equal(t, "fix", String.delete_prefix!("prefix", "pre"))
  Minitest.assert_nil(t, String.delete_suffix!("prefix", "zzz"))
  Minitest.assert_equal(t, "ab", String.succ!("aa"))
end

Minitest.test(suite, "String: insert, prepend, replace, concat, clear, dump, undump, sum, setbyte") do |t|
  s = "world"
  Minitest.assert_equal(t, "hello world", String.prepend(s, "hello "))
  Minitest.assert_equal(t, "hello, world", String.insert(s, 5, ","))
  Minitest.assert_equal(t, "hello, world!", String.concat(s, "!"))
  Minitest.assert_equal(t, "hello, world!?", String.concat(s, 63))
  Minitest.assert_equal(t, "new", String.replace(s, "new"))
  Minitest.assert_equal(t, "", String.clear(s))
  Minitest.assert_equal(t, "\"a\\nb\"", String.dump("a\nb"))
  Minitest.assert_equal(t, "a\nb", String.undump("\"a\\nb\""))
  Minitest.assert_equal(t, 294, String.sum("abc"))
  b = "abc"
  Minitest.assert_equal(t, 65, String.setbyte(b, 0, 65))
  Minitest.assert_equal(t, "Abc", b)
  Minitest.assert_equal(t, Array["h", "é", "l"], String.grapheme_clusters("hél"))
  seen = Array[]
  String.each_codepoint("ab") { |c| Array.push(seen, c) }
  Minitest.assert_equal(t, Array[97, 98], seen)
  Minitest.assert_equal(t, "ab", String.scrub("a\xffb", ""))
  Minitest.assert_equal(t, "café", String.unicode_normalize("café", :nfc))
  Minitest.assert(t, String.unicode_normalized?("café", :nfc))
  Minitest.assert_equal(t, "abc", String.encode("abc", "UTF-8"))
  Minitest.assert_equal(t, 2, String.byterindex("ab-cd", "-", 4))
  Minitest.assert_equal(t, "XYc", String.bytesplice("abc", 0, 2, "XY"))
end

Minitest.test(suite, "Symbol: name, next, slice, casecmp, match") do |t|
  Minitest.assert_equal(t, "ab", Symbol.name(:ab))
  Minitest.assert_equal(t, :ac, Symbol.next(:ab))
  Minitest.assert_equal(t, "a", Symbol.slice(:ab, 0))
  Minitest.assert_equal(t, "ab", Symbol.slice(:abc, 0, 2))
  Minitest.assert_equal(t, 0, Symbol.casecmp(:ab, :AB))
  Minitest.assert(t, Symbol.match?(:abc, /b/))
  m = Symbol.match(:abc, /b(c)/)
  Minitest.assert_equal(t, "c", m ? m[1] : "")
  Minitest.assert_equal(t, "US-ASCII", Symbol.encoding(:a))
  Minitest.assert_equal(t, :ab, Symbol.intern(:ab))
end

Minitest.test(suite, "Array in place: map!, sort!, reverse!, rotate!, uniq!, compact!, select!, reject!, flatten!") do |t|
  a = Array[3, 1, 2]
  Minitest.assert_equal(t, Array[1, 2, 3], Array.sort!(a))
  Minitest.assert_equal(t, Array[1, 2, 3], a)
  Minitest.assert_equal(t, Array[3, 2, 1], Array.reverse!(a))
  Minitest.assert_equal(t, Array[2, 1, 3], Array.rotate!(a))
  Minitest.assert_equal(t, Array[4, 2, 6], Array.map!(a) { |x| x * 2 })
  Minitest.assert_equal(t, Array[4, 2, 6], a)
  Minitest.assert_nil(t, Array.uniq!(a))
  Minitest.assert_equal(t, Array[4, 2], Array.select!(a) { |x| x < 5 })
  Minitest.assert_nil(t, Array.reject!(a) { |x| x > 10 })
  Minitest.assert_equal(t, Array[1, 2, 3], Array.sort_by!(Array[2, 3, 1]) { |x| x })
  b = Array[1, nil, 2]
  Minitest.assert_equal(t, Array[1, 2], Array.compact!(b))
  Minitest.assert_nil(t, Array.compact!(b))
  c = Array[Array[1, 2], Array[3]]
  Minitest.assert_equal(t, Array[1, 2, 3], Array.flatten!(c))
  Minitest.assert_nil(t, Array.flatten!(c))
  d = Array[1, 2]
  Minitest.assert_equal(t, Array[9, 9], Array.replace(d, Array[9, 9]))
  Minitest.assert_equal(t, Array[0, 9, 9], Array.prepend(d, 0))
  Minitest.assert_equal(t, Array[2, 3], Array.filter!(Array[1, 2, 3]) { |x| x > 1 })
  Minitest.assert_match(t, /divided by 0/, Minitest.assert_raises(t) { Array.map!(Array[1]) { |x| x / 0 } })
end

Minitest.test(suite, "Array: slice, slice!, assoc, rassoc, dig, fetch_values, bsearch_index, cycle, rfind, repeated_*") do |t|
  a = Array[10, 20, 30, 40]
  Minitest.assert_equal(t, 20, Array.slice(a, 1))
  Minitest.assert_equal(t, Array[20, 30], Array.slice(a, 1, 2))
  Minitest.assert_equal(t, Array[30, 40], Array.slice(a, 2..3))
  Minitest.assert_nil(t, Array.slice(a, 9))
  Minitest.assert_equal(t, Array[20, 30], Array.slice!(a, 1, 2))
  Minitest.assert_equal(t, Array[10, 40], a)
  Minitest.assert_equal(t, 10, Array.slice!(a, 0))
  Minitest.assert_equal(t, Array[40], a)
  pairs = Array[[:a, 1], [:b, 2]]
  Minitest.assert_equal(t, [:b, 2], Array.assoc(pairs, :b))
  Minitest.assert_equal(t, [:a, 1], Array.rassoc(pairs, 1))
  Minitest.assert_nil(t, Array.assoc(pairs, :z))
  Minitest.assert_equal(t, 2, Array.dig(Array[1, 2], 1))
  Minitest.assert_equal(t, Array[30, 10], Array.fetch_values(Array[10, 20, 30], 2, 0))
  Minitest.assert_match(t, /index 5 outside/, Minitest.assert_raises(t) { Array.fetch_values(Array[10], 5) })
  Minitest.assert_equal(t, 2, Array.bsearch_index(Array[1, 3, 5, 7]) { |x| x >= 5 })
  seen = Array[]
  Array.cycle(Array[1, 2], 2) { |x| Array.push(seen, x) }
  Minitest.assert_equal(t, Array[1, 2, 1, 2], seen)
  Minitest.assert_equal(t, 3, Array.rfind(Array[1, 2, 3, 4]) { |x| x < 4 })
  Minitest.assert_equal(t, Array[Array[1, 1], Array[1, 2], Array[2, 2]], Array.repeated_combination(Array[1, 2], 2))
  Minitest.assert_equal(t, 4, Array.size(Array.repeated_permutation(Array[1, 2], 2)))
  Minitest.assert_equal(t, Array[1, 2], Array.to_a(Array[1, 2]))
end

Minitest.test(suite, "Hash: assoc, rassoc, flatten, merge!, update, replace, compact!, select!, transform_values!, transform_keys!, set_default") do |t|
  h = Hash[a: 1, b: 2]
  Minitest.assert_equal(t, [:a, 1], Hash.assoc(h, :a))
  Minitest.assert_equal(t, [:b, 2], Hash.rassoc(h, 2))
  Minitest.assert_nil(t, Hash.rassoc(h, 9))
  Minitest.assert_equal(t, Array[:a, 1, :b, 2], Hash.flatten(h))
  Minitest.assert_equal(t, Hash[a: 1, b: 2, c: 3], Hash.merge!(h, Hash[c: 3]))
  Minitest.assert_equal(t, 3, h[:c])
  Hash.update(h, Hash[a: 10])
  Minitest.assert_equal(t, 10, h[:a])
  Minitest.assert_equal(t, Hash[z: 0], Hash.replace(h, Hash[z: 0]))
  g = Hash[a: 1, b: nil]
  Minitest.assert_equal(t, Hash[a: 1], Hash.compact!(g))
  Minitest.assert_nil(t, Hash.compact!(g))
  g2 = Hash[a: 1, b: 2, c: 3]
  Minitest.assert_equal(t, Hash[b: 2, c: 3], Hash.select!(g2) { |kv| kv[1] > 1 })
  Minitest.assert_nil(t, Hash.reject!(g2) { |kv| kv[1] > 10 })
  Minitest.assert_equal(t, Hash[b: 20, c: 30], Hash.transform_values!(g2) { |v| v * 10 })
  Minitest.assert_equal(t, Hash["b" => 20, "c" => 30], Hash.transform_keys!(g2) { |k| Kernel.to_s(k) })
  d = Hash[x: 1]
  Hash.set_default(d, 0)
  Minitest.assert_equal(t, 0, d[:missing])
  Minitest.assert_equal(t, 0, Hash.default(d))
  Minitest.assert_equal(t, Hash[x: 1], Hash.to_h(d))
end

Minitest.test(suite, "Set: Enumerable (map, each_with_index, group_by, minmax, tally, zip, classify, replace, map!)") do |t|
  s = Set[3, 1, 2]
  Minitest.assert_equal(t, Array[2, 4, 6], Array.sort(Set.collect(s) { |x| x * 2 }))
  pairs = Array[]
  Set.each_with_index(Set[10, 20]) { |x, i| Array.push(pairs, [x, i]) }
  Minitest.assert_equal(t, Array[[10, 0], [20, 1]], pairs)
  Minitest.assert_equal(t, Hash[true => Array[2], false => Array[3, 1]], Set.group_by(s) { |x| x == 2 })
  Minitest.assert_equal(t, [1, 3], Set.minmax(s))
  Minitest.assert_equal(t, [3, 1], Set.minmax_by(s) { |x| -x })
  Minitest.assert_equal(t, Hash[1 => 1, 2 => 1, 3 => 1], Set.tally(s))
  Minitest.assert_equal(t, Array[[3, :a], [1, :b], [2, nil]], Set.zip(s, Array[:a, :b]))
  Minitest.assert_equal(t, Hash[true => Set[2], false => Set[3, 1]], Set.classify(s) { |x| x == 2 })
  Minitest.assert_equal(t, Array[3, 1], Set.take(s, 2))
  Minitest.assert_equal(t, Array[2], Set.drop(s, 2))
  Minitest.assert_equal(t, 1, Set.detect(s) { |x| x < 2 })
  Minitest.assert_equal(t, 0, Set.find_index(s) { |x| x == 3 })
  Minitest.assert_equal(t, 6, Set.inject(s, 0) { |acc, x| acc + x })
  Minitest.assert_equal(t, Array[Array[3], Array[1, 2]], Set.slice_when(s) { |a, b| b < a })
  Minitest.assert_equal(t, Set[9], Set.replace(s, Set[9]))
  Minitest.assert_equal(t, Set[18], Set.map!(s) { |x| x * 2 })
  Minitest.assert_equal(t, Array[1, 2], Set.uniq(Set[1, 2]))
  Minitest.assert_equal(t, Array[2, 1], Set.entries(Set[2, 1]))
  Minitest.assert(t, Set.one?(Set[1, 2]) { |x| x > 1 })
  Minitest.assert_equal(t, Set[2], Set.select!(Set[1, 2]) { |x| x > 1 })
end

Minitest.test(suite, "Range: Enumerable (collect, minmax, sort, uniq, bsearch, slice_when, entries, cycle)") do |t|
  r = 1..5
  Minitest.assert_equal(t, Array[2, 4, 6, 8, 10], Range.collect(r) { |x| x * 2 })
  Minitest.assert_equal(t, [1, 5], Range.minmax(r))
  Minitest.assert_equal(t, [5, 1], Range.minmax_by(r) { |x| -x })
  Minitest.assert_equal(t, Array[1, 2, 3, 4, 5], Range.sort(r))
  Minitest.assert_equal(t, Array[1, 2, 3, 4, 5], Range.entries(r))
  Minitest.assert_equal(t, 3, Range.bsearch(r) { |x| x >= 3 })
  Minitest.assert_equal(t, Array[Array[1, 2], Array[3, 4], Array[5]], Range.slice_when(r) { |a, b| b % 2 == 1 })
  Minitest.assert_equal(t, Array[Array[1], Array[2, 3], Array[4, 5]], Range.slice_before(r) { |x| x % 2 == 0 })
  Minitest.assert_equal(t, Array[1, 2, 3], Range.find_all(r) { |x| x < 4 })
  Minitest.assert_equal(t, Array[3, 4, 5], Range.drop_while(r) { |x| x < 3 })
  Minitest.assert_equal(t, Array[1, 2, 4], Array.uniq(Range.collect_concat(1..2) { |x| Array[x, x * 2] }))
  seen = Array[]
  Range.cycle(1..2, 2) { |x| Array.push(seen, x) }
  Minitest.assert_equal(t, Array[1, 2, 1, 2], seen)
  Minitest.assert_equal(t, Array["a", "b"], Range.uniq("a".."b"))
end

Minitest.test(suite, "Regexp and MatchData: names, named_captures, options, union, offset, values_at, string") do |t|
  re = /(?<y>\d+)-(?<m>\d+)/i
  Minitest.assert_equal(t, Array["y", "m"], Regexp.names(re))
  Minitest.assert_equal(t, Hash["y" => Array[1], "m" => Array[2]], Regexp.named_captures(re))
  Minitest.assert(t, Regexp.casefold?(re))
  Minitest.assert_equal(t, 1, Regexp.options(re))
  Minitest.assert_nil(t, Regexp.timeout(re))
  Minitest.assert_equal(t, "UTF-8", Regexp.encoding(/é/))
  Minitest.assert(t, Regexp.match?(Regexp.union("a", /b+/), "xbb"))
  m = String.match("on 2024-07", re)
  Minitest.assert(t, m != nil)
  if m
    Minitest.assert_equal(t, 3, MatchData.length(m)) # the whole match and the two groups
    Minitest.assert_equal(t, [3, 10], MatchData.offset(m, 0))
    Minitest.assert_equal(t, [3, 7], MatchData.byteoffset(m, 1))
    Minitest.assert_equal(t, "2024", MatchData.match(m, 1))
    Minitest.assert_equal(t, 2, MatchData.match_length(m, 2))
    Minitest.assert_equal(t, Array["07", "2024"], MatchData.values_at(m, 2, 1))
    Minitest.assert_equal(t, "on 2024-07", MatchData.string(m))
    Minitest.assert_equal(t, re, MatchData.regexp(m))
    Minitest.assert_equal(t, 3, MatchData.bytebegin(m, 0))
    Minitest.assert_equal(t, 10, MatchData.byteend(m, 0))
  end
end

Minitest.test(suite, "Time: tv_sec, subsec, to_a, asctime, dst?, getgm, to_r") do |t|
  tm = Time.at(1_700_000_000, in: "UTC")
  Minitest.assert_equal(t, 1_700_000_000, Time.tv_sec(tm))
  Minitest.assert_equal(t, 0, Time.tv_usec(tm))
  Minitest.assert_equal(t, 0, Time.subsec(tm))
  Minitest.assert_equal(t, [20, 13, 22, 14, 11, 2023, 2, 318, false, "UTC"], Time.to_a(tm))
  Minitest.assert_equal(t, "Tue Nov 14 22:13:20 2023", Time.asctime(tm))
  Minitest.assert_equal(t, Time.asctime(tm), Time.ctime(tm))
  Minitest.refute(t, Time.dst?(tm))
  Minitest.assert_equal(t, tm, Time.getgm(tm))
  Minitest.assert_equal(t, 1_700_000_000r, Time.to_r(tm))
  Minitest.assert_equal(t, 500_000_000, Time.tv_nsec(Time.at(1.5, in: "UTC")))
end

Minitest.test(suite, "Math: acos, sinh, gamma, frexp, ldexp, lgamma, erf") do |t|
  Minitest.assert_in_delta(t, Math.PI / 2, Math.acos(0))
  Minitest.assert_in_delta(t, 0.0, Math.asin(0))
  Minitest.assert_in_delta(t, 1.1752, Math.sinh(1), 0.0001)
  Minitest.assert_in_delta(t, 24.0, Math.gamma(5))
  Minitest.assert_equal(t, [0.5, 4], Math.frexp(8.0))
  Minitest.assert_equal(t, 8.0, Math.ldexp(0.5, 4))
  Minitest.assert_equal(t, 1, Math.lgamma(3.0)[1])
  Minitest.assert_in_delta(t, 0.8427, Math.erf(1), 0.0001)
  Minitest.assert_in_delta(t, 0.5493, Math.atanh(0.5), 0.0001)
  Minitest.assert_match(t, /Numerical argument is out of domain/, Minitest.assert_raises(t) { Math.acos(2) })
end

Minitest.test(suite, "Process and Kernel: pid, clock_gettime, srand") do |t|
  Minitest.assert(t, Process.pid > 0)
  t1 = Process.clock_gettime(Process.CLOCK_MONOTONIC)
  t2 = Process.clock_gettime(Process.CLOCK_MONOTONIC)
  Minitest.assert(t, t2 >= t1)
  Kernel.srand(42)
  a = Kernel.rand(1000)
  Kernel.srand(42)
  Minitest.assert_equal(t, a, Kernel.rand(1000))
end

Minitest.run(suite)
