# Divisor sums: perfect / abundant / deficient classification, amicable pairs,
# and aliquot sequences with cycle detection.

module Divisors
  module_function

  def proper(n)
    return Integer[] if n < 2
    ds = Integer[1]
    d = 2
    while d * d <= n
      if n % d == 0
        Array.push(ds, d)
        Array.push(ds, n / d) if d * d != n
      end
      d += 1
    end
    Array.sort(ds)
  end

  def sum_proper(n) = Array.sum(proper(n))
end

def classify(n)
  s = Divisors.sum_proper(n)
  if s == n
    :perfect
  elsif s > n
    :abundant
  else
    :deficient
  end
end

def sieve_sums(limit)
  sums = Array[]
  Integer.times(limit + 1) { Array.push(sums, 0) }
  Range.each(1..(limit / 2)) do |d|
    m = d * 2
    while m <= limit
      sums[m] += d
      m += d
    end
  end
  sums
end

# returns {kind:, seq:} where kind is :terminates, :cycle or :open
def aliquot(n, max_len)
  seq = Integer[n]
  pos = Hash[n => 0]
  while Array.size(seq) < max_len
    nxt = Divisors.sum_proper(Array.last(seq))
    return {kind: :terminates, seq: seq, cycle: 0} if nxt == 0
    start = pos[nxt]
    if start
      return {kind: :cycle, seq: seq, cycle: Array.size(seq) - start}
    end
    pos[nxt] = Array.size(seq)
    Array.push(seq, nxt)
  end
  {kind: :open, seq: seq, cycle: 0}
end

puts("proper divisors:")
Array.each(Array[28, 220, 284, 945, 97]) do |n|
  ds = Divisors.proper(n)
  puts("  #{n}: #{Array.join(ds, " ")} (sum #{Array.sum(ds)}, #{classify(n)})")
end

counts = Hash[perfect: 0, abundant: 0, deficient: 0]
Range.each(1..500) { |n| counts[classify(n)] += 1 }
Hash.each(counts) { |k, v| puts("#{k}: #{v}") }

limit = 3000
sums = sieve_sums(limit)
perfect = Array.select(Range.to_a(2..limit)) { |n| sums[n] == n }
puts("perfect numbers <= #{limit}: #{Array.join(perfect, ", ")}")

odd_abundant = Range.find(1..limit) { |n| Integer.odd?(n) && sums[n] > n }
puts("first odd abundant number: #{odd_abundant}")

amicable = Array[]
Range.each(2..limit) do |a|
  b = sums[a]
  if b > a && b <= limit && sums[b] == a
    Array.push(amicable, [a, b])
  end
end
puts("amicable pairs <= #{limit}:")
Array.each(amicable) { |a, b| puts("  #{a} <-> #{b}") }

puts("aliquot sequences:")
Array.each(Array[12, 95, 220, 562, 25, 6]) do |n|
  r = aliquot(n, 20)
  r => {kind:, seq:, cycle:}
  shown = Array.join(Array.take(seq, 8), " -> ")
  shown = "#{shown} ..." if Array.size(seq) > 8
  case kind
  in :terminates then puts("  #{n}: terminates after #{Array.size(seq)} terms: #{shown}")
  in :cycle then puts("  #{n}: enters a cycle of length #{cycle}: #{shown}")
  in :open then puts("  #{n}: still open after #{Array.size(seq)} terms")
  end
end
