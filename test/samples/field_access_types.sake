# The checker knows which fields a Symbol may name: a literal that names no field, and outside the class, a
# Symbol that may name a field without a public writer.
class Post
  attr_accessor id, title
  attr_reader slug
end
post = Post.new(1, "Hello", "hello")
p Post.read_field(post, :titel)
Array.each(Post.field_names) { |f| Post.write_field(post, f, "x") }
Array.each(Post.field_names) do |f|
  case f
  in :id | :title then Post.write_field(post, f, "x")    # narrowed: fine
  in :slug then nil
  end
end
