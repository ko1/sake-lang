# Port of actionpack-8.1.3/lib/abstract_controller/rendering.rb (partial: DoubleRenderError is in error.sake; no ActionView::ViewPaths here, see ActionController::Base)
#
# Rails' render(*args) goes up the modules' `super` chain. Sake has no super: a module's body that another module
# overrides keeps a second name, and the overrider calls it: `abstract_render`, `abstract_render_to_body`,
# `abstract_normalize_options`... ActionController::Rendering's `render` calls `abstract_render`, as its super.
# Render options are a Hash with Symbol keys (Ruby's options Hash): `render c, json: post, status: :created`.

require "error"
require "rails/actionpack/action_dispatch/http/mime_types"

module AbstractController
  module Rendering
    # Normalizes arguments and options, and then delegates to render_to_body and sticks the result in
    # self.response_body.
    def abstract_render(c, action, options)
      options = _normalize_render(c, action, options)
      rendered_body = render_to_body(c, options)
      if options[:html]
        _set_html_content_type(c)
      else
        _set_rendered_content_type(c, rendered_format(c))
      end
      _set_vary_header(c)
      set_response_body(c, rendered_body)
    end
    def render(c, action = nil, **options) = abstract_render(c, action, options)

    def abstract_render_to_string(c, action, options) = render_to_body(c, _normalize_render(c, action, options))
    def render_to_string(c, action = nil, **options) = abstract_render_to_string(c, action, options)

    # Performs the actual rendering (nil here: the modules above render).
    def abstract_render_to_body(c, options) = nil
    def render_to_body(c, options) = abstract_render_to_body(c, options)

    def rendered_format(c) = Mime.[](:text)

    def default_protected_instance_variables = Symbol[:@_action_name, :@_response_body, :@_formats, :@_prefixes]

    # Ruby: instance_variables - _protected_ivars, as a Hash of name => value. The controller's fields are
    # generated as `view_assigns(c)`; this keeps the ones a view may see (Sake's fields of the framework start with _).
    def view_assigns(c) = raise(NotImplementedError)

    # Ruby's _normalize_args(action = nil, options = {}): a Hash action is the options.
    def _normalize_args(c, action, options) = options

    def abstract_normalize_options(c, options) = options
    def _normalize_options(c, options) = abstract_normalize_options(c, options)
    def abstract_process_options(c, options) = options
    def _process_options(c, options) = abstract_process_options(c, options)
    def _process_format(c, format) = nil
    def _process_variant(c, options) = nil
    def _set_html_content_type(c) = nil
    def _set_vary_header(c) = nil
    def _set_rendered_content_type(c, format) = nil

    def _normalize_render(c, action, options)
      options = _normalize_args(c, action, options)
      _process_variant(c, options)
      _normalize_options(c, options)
      options
    end

    def _protected_ivars(c) = default_protected_instance_variables

    module_function :default_protected_instance_variables
  end
end
