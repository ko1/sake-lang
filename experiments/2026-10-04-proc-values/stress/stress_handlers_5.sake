hs = Array[]
acc = Array[]
Array.push(hs, proc { |x| Array.push(acc, "0:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "1:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "2:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "3:#{x}") })
Array.push(hs, proc { |x| Array.push(acc, "4:#{x}") })
Array.each(hs) { |h| Proc.call(h, 1) }
Array.each(hs) { |h| Proc.call(h, "s") }
Array.each(hs) { |h| Proc.call(h, :k) }
p Array.size(acc)
