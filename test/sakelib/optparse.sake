require "optparse"

def build
  op = OptionParser.new
  OptionParser.set_banner(op, "Usage: tool [options]")
  OptionParser.separator(op, "")
  OptionParser.separator(op, "Specific options:")
  OptionParser.on(op, "-v", "--[no-]verbose", "Run verbosely")
  OptionParser.on(op, "-n", "--name NAME", "Name to use")
  OptionParser.on(op, "-c", "--count N", :Integer, "How many")
  OptionParser.on(op, "-r", "--ratio R", :Float, "Ratio")
  OptionParser.on(op, "-l", "--level [LEVEL]", "Optional level")
  OptionParser.on(op, "-t", "--type TYPE", Array["text", "binary", "bits"], "Select type")
  OptionParser.on(op, "-q", "Quiet")
  OptionParser.on(op, "--dry-run", "Dry run")
  OptionParser.on(op, "--debug", "Debug")
  OptionParser.on(op, "--a-very-long-option-name-here VALUE", "Long one")
  OptionParser.on(op, "-x VALUE", "Short with an argument")
  OptionParser.on(op, "-u", "--unicode-é", "Ünïcode ✓")
  OptionParser.on(op, "--nodesc")
  OptionParser.on_tail(op, "-h", "--help", "Show this message")
  OptionParser.separator(op, "Common options:")
  op
end

op = build
puts(OptionParser.help(op))
puts("--")
puts(op)
p(OptionParser.summary_width(op))
p(OptionParser.summary_indent(op))

cases = Array[
  String["-v", "-n", "foo", "a", "b"], String["--no-verbose", "--name=bar", "-c", "3", "x"],
  String["-vq", "-nfoo", "--", "-v"], String["-l"], String["-l", "3", "rest"], String["--level=4"],
  String["--verb", "--dry-"], String["-t", "bin"], String["-xval", "-x", "val2"],
  String["-z"], String["--zzz"], String["--name"], String["-c", "abc"], String["--dry-run=1"], String["--d"],
  String["-c"], String["-c", "0x10"], String["-r", "1e3"], String["-t", "foo"], String["-t", "bi"], String["-"],
  String["x", "-v", "y"], String["--count=-5"], String["-vn"], String["-v", "-n", "-c"], String["--n"],
  String["--na", "x"], String["--no-v"], String["--no-verbose=1"], String["-vz"], String["--no-name", "x"],
  String["--no-dry-run"], String["--de"], String["--level", "-v"], String["-l3"], String["-c", "-5"],
  String["--count="], String["--name="], String["a", "--", "-b"], String["--no-"], String["-c", "1_000"],
  String["-c", "08"], String["-c", "1.5"], String["-cabc"], String["--count", "abc"], String["-r", ".5"],
  String["-r", "x"], String["-u", "--unicode-é", "ü"], String["-h"], String[], String["--help", "--nodesc"]
]

def show(h) = "{" + Array.join(Hash.map(h) { |k, v| "#{k}: #{Kernel.inspect(v)}" }, ", ") + "}"

Array.each(cases) do |argv|
  h = Hash[]
  begin
    rest = OptionParser.parse(op, argv, into: h)
    puts("#{show(h)} #{Kernel.inspect(rest)}")
  rescue OptionParserError => e
    puts("#{OptionParserError.kind(e)}: #{Exception.message(e)} #{Kernel.inspect(OptionParserError.args(e))} #{OptionParserError.reason(e)}")
  end
  h2 = Hash[]
  copy = Array.dup(argv)
  begin
    r = OptionParser.order!(op, copy, into: h2)
    puts("#{show(h2)} #{Kernel.inspect(r)} #{Kernel.inspect(copy)}")
  rescue OptionParserError => e
    puts("order: #{Exception.message(e)} #{show(h2)}")
  end
end

args = String["-v", "file1", "--name", "n", "file2"]
h = Hash[]
r = OptionParser.parse!(op, args, into: h)
p(r)
p(args)
puts(show(h))

args = String["-a", "-b", "1", "--foo", "--bar=x", "rest"]
p(OptionParser.getopts(OptionParser.new, args, "ab:c", "foo", "bar:", "baz"))
p(args)

plain = OptionParser.new
OptionParser.set_program_name(plain, "plain")
OptionParser.on(plain, "-a")
print(OptionParser.help(plain))

# defaults: parse(argv) without a Hash, ARGV when argv is left out, getopts without long options
p(OptionParser.parse(op, String["-v", "a", "-n", "x", "b"]))
p(OptionParser.parse(plain))
p(OptionParser.parse!(plain))
args = String["-a", "x", "-b"]
p(OptionParser.getopts(OptionParser.new, args, "ab"))
p(args)
OptionParser.warn(plain, "a warning on stderr")
OptionParser.set_version(plain, "1.2")
p(OptionParser.ver(plain))
p(OptionParser.ver(op))

# into: as a keyword, as in Ruby
h3 = Hash[]
p(OptionParser.permute(op, String["a", "-v", "b"], into: h3))
p(OptionParser.order(op, String["-n", "z", "a", "-v"], into: h3))
puts(show(h3))
args = String["x", "--count", "2"]
p(OptionParser.permute!(op, args, into: h3))
puts(show(h3))

# new(banner, width, indent) positionally, on_head, and on with more than four arguments
small = OptionParser.new("Usage: small [opts]", 10, "  ")
OptionParser.on(small, "-a", "--all", "All")
OptionParser.separator(small, "More:")
OptionParser.on_head(small, "-f", "--first", "First, before the separator")
OptionParser.on(small, "-k", "--kind K", Array["x", "y"], :String, "Kind")
OptionParser.on(small, "-m", "--multi", "Line one", "line two")
print(OptionParser.help(small))
h4 = Hash[]
p(OptionParser.parse(small, String["-f", "-k", "y", "z"], into: h4))
puts(show(h4))

# --help that was not declared: prints the help and exits 0 (abbreviated, as Ruby)
begin
  OptionParser.parse(plain, String["-a", "--he"])
ensure
  puts("ensure ran")
end
puts("not reached")
