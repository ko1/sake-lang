class BitNode
  attr_accessor zero = nil, one = nil, route = nil
end

class Route
  attr_reader prefix, len, iface, metric

  def to_s(r) = "#{ip_to_s(@prefix)}/#{@len} via #{@iface} (metric #{@metric})"
end

class BadAddress < StandardError
  attr_reader text
end

def parse_ip(text)
  parts = String.split(text, ".")
  raise BadAddress.new("bad address #{text}", text) if Array.size(parts) != 4
  Array.reduce(parts, 0) do |acc, p|
    raise BadAddress.new("bad octet #{p} in #{text}", text) unless String.match?(p, /\A\d{1,3}\z/) && String.to_i(p) <= 255
    (acc << 8) | String.to_i(p)
  end
end

def ip_to_s(n) = Array.join(Array.map(Array[24, 16, 8, 0]) { |s| (n >> s) & 255 }, ".")

def bit(addr, i) = (addr >> (31 - i)) & 1

def mask(len) = len == 0 ? 0 : ((1 << len) - 1) << (32 - len)

class RouteTable
  attr_reader root = nil, size = 0

  def initialize(t) = @root = BitNode.new

  def add(t, cidr, iface, metric)
    addr, len = String.split(cidr, "/")
    len = String.to_i(len)
    raise BadAddress.new("bad prefix length in #{cidr}", cidr) if len > 32
    prefix = parse_ip(addr) & mask(len)
    node = @root
    Integer.times(len) do |i|
      node = if bit(prefix, i) == 0
               BitNode.get_zero(node) || BitNode.set_zero(node, BitNode.new)
             else
               BitNode.get_one(node) || BitNode.set_one(node, BitNode.new)
             end
    end
    old = BitNode.get_route(node)
    return unless old == nil || Route.get_metric(old) > metric
    @size += 1 if old == nil
    BitNode.set_route(node, Route.new(prefix, len, iface, metric))
  end

  def lookup(t, text)
    addr = parse_ip(text)
    node = @root
    best = BitNode.get_route(node)
    depth = 0
    while node != nil && depth < 32
      node = bit(addr, depth) == 0 ? BitNode.get_zero(node) : BitNode.get_one(node)
      depth += 1
      if node
        r = BitNode.get_route(node)
        best = r if r
      end
    end
    best
  end

  def remove(t, cidr)
    addr, len = String.split(cidr, "/")
    len = String.to_i(len)
    prefix = parse_ip(addr) & mask(len)
    node = @root
    Integer.times(len) do |i|
      node = bit(prefix, i) == 0 ? BitNode.get_zero(node) : BitNode.get_one(node)
      return false if node == nil
    end
    return false if BitNode.get_route(node) == nil
    BitNode.set_route(node, nil)
    @size -= 1
    true
  end

  def each_route(t, &block) = walk(@root, &block)

  def walk(node, &block)
    return if node == nil
    r = BitNode.get_route(node)
    yield(r) if r
    walk(BitNode.get_zero(node), &block)
    walk(BitNode.get_one(node), &block)
  end

  def node_count(t) = count(@root)
  def count(node) = node == nil ? 0 : 1 + count(BitNode.get_zero(node)) + count(BitNode.get_one(node))
end

table = RouteTable.new
routes = <<~T
  0.0.0.0/0 wan0 100
  10.0.0.0/8 vpn0 10
  10.20.0.0/16 lan1 5
  10.20.30.0/24 lab0 1
  10.20.30.128/25 lab1 1
  192.168.1.0/24 lan0 1
  192.168.1.77/32 printer 1
  172.16.0.0/12 dmz0 20
  10.20.0.0/16 backup 50
  172.16.5.9/33 typo 1
  300.1.1.0/24 typo 1
T
String.each_line(routes) do |line|
  cidr, iface, metric = String.split(line, " ")
  begin
    RouteTable.add(table, cidr, iface, String.to_i(metric))
  rescue BadAddress => e
    puts("skip: #{Exception.message(e)}")
  end
end
puts("#{RouteTable.get_size(table)} routes, #{RouteTable.node_count(table)} trie nodes")
RouteTable.each_route(table) { |r| puts("  #{r}") }

puts("-- lookups --")
Array.each(Array["10.20.30.200", "10.20.30.5", "10.20.99.1", "10.1.2.3", "192.168.1.77", "192.168.1.78", "172.31.255.255", "8.8.8.8", "10.20.30"]) do |ip|
  r = RouteTable.lookup(table, ip)
  puts(format("  %-15s -> %-8s (%s/%d)", ip, Route.get_iface(r), ip_to_s(Route.get_prefix(r)), Route.get_len(r)))
rescue BadAddress => e
  puts("  #{ip}: #{Exception.message(e)}")
end

puts("-- withdraw 10.20.30.0/24 and 0.0.0.0/0 --")
Array.each(Array["10.20.30.0/24", "0.0.0.0/0", "10.99.0.0/16"]) { |c| puts("  remove #{c}: #{RouteTable.remove(table, c)}") }
Array.each(Array["10.20.30.5", "8.8.8.8"]) do |ip|
  r = RouteTable.lookup(table, ip)
  puts("  #{ip} -> #{r == nil ? "unreachable" : Route.get_iface(r)}")
end
puts("#{RouteTable.get_size(table)} routes left")
