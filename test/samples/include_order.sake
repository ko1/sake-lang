# A later include wins over an earlier one (Ruby's ancestor order); the includer's own definition wins over both.
module A
  def foo(x) = String.+("A.foo calls ", bar(x))
  def bar(x) = "A.bar"
end
module B
  def bar(x) = "B.bar"
  def baz(x) = "B.baz"
end
module X
  include A
  include B
end
module Y
  include A
  include B
  def bar(x) = "Y.bar"
end
puts(X.bar(0))
puts(X.foo(0))
puts(Y.foo(0))
puts(A.foo(0))
