# sake: --strict=0
# `M[...]` for a module M: an Array of values whose types include M, checked on every write as `T[...]`,
# so that the mixin function `M.f(x)` runs on each element.
module Shape
  def area(s) = raise NotImplementedError
end
class Sq
  include Shape
  attr_reader n
  def area(s) = @n * @n
end
class Rect
  include Shape
  attr_reader w, h
  def area(s) = @w * @h
end
class Circle
  attr_reader r
end
shapes = Shape[Sq.new(2), Rect.new(2, 3)]
Array.push(shapes, Sq.new(1))
p(Array.map(shapes) { |s| Shape.area(s) })
p(Array.size(Shape[]))
begin
  Array.push(shapes, Circle.new(1))
rescue TypeError => e
  puts Exception.message(e)
end
