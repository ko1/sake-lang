Patch = Struct.new(:name, :grass, :rabbits, :foxes, :capacity, :neighbors)
Census = Struct.new(:season, :grass, :rabbits, :foxes)

def growth_rate(season)
  rates = Hash["spring" => 0.35, "summer" => 0.25, "autumn" => 0.1, "winter" => 0.0]
  rates[season] || 0.0
end

class Patch
  def to_s(p) = format("%-7s grass %6.1f rabbits %6.1f foxes %5.2f", @name, @grass, @rabbits, @foxes)

  def grow(p, season)
    r = growth_rate(season)
    @grass += r * @grass * (1.0 - @grass / @capacity)
    @grass = Float.clamp(@grass, 0.0, @capacity)
  end

  def feed(p)
    eaten = Float.clamp(@rabbits * 0.3, 0.0, @grass * 0.5)
    @grass -= eaten
    fed_ratio = @rabbits > 0.0 ? eaten / (@rabbits * 0.3) : 0.0
    births = @rabbits * 0.4 * fed_ratio
    starve = @rabbits * 0.15 * (1.0 - fed_ratio)
    hunted = Float.clamp(@foxes * 5.0, 0.0, @rabbits * 0.6)
    @rabbits = @rabbits + births - starve - hunted
    fox_births = hunted * 0.06
    fox_deaths = @foxes * 0.18
    @foxes = @foxes + fox_births - fox_deaths
    @rabbits = 0.0 if @rabbits < 0.5
    @foxes = 0.0 if @foxes < 0.1
    hunted
  end
end

def migrate(patches)
  by_name = Hash[]
  Array.each(patches) { |p| by_name[Patch.name(p)] = p }
  moves = Array[]
  Array.each(patches) do |p|
    crowding = Patch.rabbits(p) / (Patch.grass(p) + 1.0)
    next if crowding < 0.5
    targets = Array.filter_map(Patch.neighbors(p)) { |n| by_name[n] }
    next if Array.empty?(targets)
    emigrants = Patch.rabbits(p) * 0.2
    share = emigrants / Array.size(targets)
    Array.each(targets) { |t| Array.push(moves, [p, t, share]) }
  end
  Array.each(moves) do |from, to, amount|
    Patch.set_rabbits(from, Patch.rabbits(from) - amount)
    Patch.set_rabbits(to, Patch.rabbits(to) + amount)
  end
  Array.size(moves)
end

patches = Patch[
  Patch.new("meadow", 400.0, 60.0, 4.0, 500.0, Array["forest", "river"]),
  Patch.new("forest", 200.0, 20.0, 6.0, 250.0, Array["meadow"]),
  Patch.new("river", 300.0, 5.0, 0.0, 350.0, Array["meadow", "marsh"]),
  Patch.new("hills", 150.0, 30.0, 2.0, 150.0, Array[])
]

seasons = Array["spring", "summer", "autumn", "winter"]
history = Census[]
total_hunted = 0.0
total_moves = 0
Integer.times(12) do |q|
  season = seasons[q % 4]
  Array.each(patches) { |p| Patch.grow(p, season) }
  Array.each(patches) { |p| total_hunted += Patch.feed(p) }
  total_moves += migrate(patches)
  Array.push(history, Census.new("Y#{q / 4 + 1} #{season}",
    Array.sum(Array.map(patches) { Patch.grass(it) }),
    Array.sum(Array.map(patches) { Patch.rabbits(it) }),
    Array.sum(Array.map(patches) { Patch.foxes(it) })))
end

Array.each(history) do |c|
  puts(format("%-12s grass %7.1f rabbits %6.1f foxes %5.2f", Census.season(c), Census.grass(c), Census.rabbits(c), Census.foxes(c)))
end
puts("--- final patches")
Array.each(patches) { puts(it) }
peak = Array.max_by(history) { Census.rabbits(it) }
puts("rabbit peak: #{Census.season(peak)}") if peak
extinct = Array.select(patches) { Patch.foxes(it) == 0.0 }
puts("patches without foxes: #{Array.join(Array.map(extinct) { Patch.name(it) }, ", ")}")
puts(format("total hunted %.1f, migration flows %d", total_hunted, total_moves))
