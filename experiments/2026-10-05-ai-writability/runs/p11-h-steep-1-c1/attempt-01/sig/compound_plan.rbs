module Sql
  class CompoundPlan < Plan
    attr_reader parts: Array[SelectPlan]
    attr_reader ops: Array[String]
    attr_reader order_by: Array[Ast::OrderTerm]
    attr_reader limit: Ast::Expr?
    attr_reader offset: Ast::Expr?

    def self.build: (Ast::Compound compound, Namespace namespace, Scope? parent) -> CompoundPlan
    def self.plan_order: (Array[Ast::OrderTerm] terms, Array[Array[String?]] names_by_part, Array[collation] collations) -> Array[Ast::OrderTerm]
    def self.order_position: (Ast::Expr expr, Integer index, Integer count, Array[Array[String?]] names_by_part) -> Integer
    def self.plan_bounds: (Ast::Expr? limit, Ast::Expr? offset, Namespace namespace) -> [Ast::Expr?, Ast::Expr?]
    @collations: Array[collation]

    def initialize: (Array[SelectPlan] parts, Array[String] ops, Array[collation] collations, Array[Ast::OrderTerm] order_by, Ast::Expr? limit, Ast::Expr? offset) -> void
  end
end
