Room = Struct.new(:name, :temp, :mass, :loss, :heater_kw, :heating, :on_minutes)

class Room
  def to_s(r) = format("%-8s %5.2fC %s", @name, @temp, @heating ? "ON " : "off")
end

def outdoor(hour)
  profile = Float[-2.0, -2.5, -3.0, -3.5, -3.0, -2.0, 0.0, 2.0, 4.0, 6.0, 7.5, 8.5,
                  9.0, 9.0, 8.0, 6.5, 5.0, 3.5, 2.0, 1.0, 0.0, -0.5, -1.0, -1.5]
  Array.fetch(profile, hour % 24)
end

def setpoint(room_name, hour)
  schedule = Array[
    {rooms: Array["living", "kitchen"], hours: 7...9, target: 21.0},
    {rooms: Array["living", "kitchen"], hours: 17...23, target: 21.5},
    {rooms: Array["bedroom"], hours: 21...24, target: 19.0},
    {rooms: Array["bedroom"], hours: 0...7, target: 18.0},
    {rooms: Array["office"], hours: 9...17, target: 20.5}
  ]
  hit = Array.find(schedule) do |entry|
    entry => {rooms:, hours:}
    Array.include?(rooms, room_name) && Range.cover?(hours, hour)
  end
  return 16.0 if hit == nil
  hit => {target:}
  target
end

def step(rooms, walls, hour, minutes)
  out = outdoor(hour)
  flows = Hash.new(0.0)
  Array.each(walls) do |a, b, k|
    ra = rooms[a]
    rb = rooms[b]
    q = k * (Room.temp(ra) - Room.temp(rb))
    flows[a] -= q
    flows[b] += q
  end
  Hash.each(rooms) do |name, r|
    target = setpoint(name, hour)
    t = Room.temp(r)
    if Room.heating(r) && t >= target + 0.5
      Room.set_heating(r, false)
    elsif Room.heating(r) == false && t <= target - 0.5
      Room.set_heating(r, true)
    end
    gain = Room.heating(r) ? Room.heater_kw(r) : 0.0
    Room.set_on_minutes(r, Room.on_minutes(r) + minutes) if Room.heating(r)
    loss = Room.loss(r) * (t - out)
    dt = (gain - loss + flows[name]) * minutes / 60.0 / Room.mass(r)
    Room.set_temp(r, t + dt)
  end
end

rooms = Hash[]
Array.each(Array[
  ["living", 19.0, 1.6, 0.09, 4.0], ["kitchen", 18.5, 1.0, 0.07, 3.0],
  ["bedroom", 17.0, 1.2, 0.06, 2.5], ["office", 16.5, 0.8, 0.08, 2.5]
]) do |name, temp, mass, loss, kw|
  rooms[name] = Room.new(name, temp, mass, loss, kw, false, 0)
end
walls = Array[["living", "kitchen", 0.12], ["living", "bedroom", 0.05], ["kitchen", "office", 0.04], ["bedroom", "office", 0.06]]

minutes = 10
comfort_misses = Hash.new(0)
lows = Hash[]
Integer.times(24) do |hour|
  Integer.times(60 / minutes) { step(rooms, walls, hour, minutes) }
  Hash.each(rooms) do |name, r|
    t = Room.temp(r)
    comfort_misses[name] += 1 if t < setpoint(name, hour) - 1.0
    low = lows[name]
    lows[name] = t if low == nil || t < low
  end
  if hour % 3 == 2
    puts(format("%02d:00 out %5.1fC | %s", hour + 1, outdoor(hour), Array.join(Array.map(Hash.values(rooms)) { |r| "#{r}" }, " | ")))
  end
end

puts("--- daily summary")
total_kwh = 0.0
Hash.each(rooms) do |name, r|
  kwh = Room.heater_kw(r) * Room.on_minutes(r) / 60.0
  total_kwh += kwh
  puts(format("%-8s heater on %4d min, %5.2f kWh, low %5.2fC, hours below target %d",
    name, Room.on_minutes(r), kwh, lows[name], comfort_misses[name]))
end
puts(format("total %.2f kWh, cost %.2f", total_kwh, total_kwh * 0.31))
coldest = Hash.min_by(lows) { |n, t| t }
if coldest
  n, t = coldest
  puts(format("coldest moment: %s at %.2fC", n, t))
end
