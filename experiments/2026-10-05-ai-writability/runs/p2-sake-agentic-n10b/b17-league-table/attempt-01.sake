def team?(s) = String.match?(s, /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/)

def sgn(n) = n > 0 ? "+#{n}" : Integer.to_s(n)

lines = Array.map(String.lines(IO.read(IO.stdin))) { |l| String.chomp(l) }
out = String[]
teams = String[]
pld = Hash.new(0)
won = Hash.new(0)
drw = Hash.new(0)
lst = Hash.new(0)
gf = Hash.new(0)
ga = Hash.new(0)
matches = Tuple[]

Array.each_with_index(lines) do |raw, idx|
  f = String.split(raw)
  next if Array.empty?(f)
  n = idx + 1
  ok = Array.size(f) == 3 && team?(f[0]) && team?(f[2]) && f[0] != f[2]
  ok = ok && (f[1] == "P-P" || String.match?(f[1], /\A\d{1,2}-\d{1,2}\z/))
  unless ok
    Array.push(out, "invalid line #{n}: #{raw}")
    next
  end
  h = f[0]
  a = f[2]
  Array.push(teams, h) unless Array.include?(teams, h)
  Array.push(teams, a) unless Array.include?(teams, a)
  next if f[1] == "P-P"
  sc = String.split(f[1], "-")
  hg = String.to_i(sc[0])
  ag = String.to_i(sc[1])
  Array.push(matches, [h, a, hg, ag])
  pld[h] += 1
  pld[a] += 1
  gf[h] += hg
  ga[h] += ag
  gf[a] += ag
  ga[a] += hg
  if hg > ag
    won[h] += 1
    lst[a] += 1
  elsif hg < ag
    won[a] += 1
    lst[h] += 1
  else
    drw[h] += 1
    drw[a] += 1
  end
end

puts(*out) unless Array.empty?(out)
if Array.empty?(teams)
  puts("no teams")
  exit
end

pts = Hash[]
Array.each(teams) { |t| pts[t] = won[t] * 3 + drw[t] }
base = Hash[]
Array.each(teams) { |t| base[t] = [-pts[t], -(gf[t] - ga[t]), -gf[t]] }

h2h = Hash.new(0)
Array.each(matches) do |h, a, hg, ag|
  next if base[h] != base[a]
  if hg > ag
    h2h[h] += 3
  elsif hg < ag
    h2h[a] += 3
  else
    h2h[h] += 1
    h2h[a] += 1
  end
end

keys = Hash[]
Array.each(teams) { |t| keys[t] = [base[t][0], base[t][1], base[t][2], -h2h[t]] }
sorted = Array.sort_by(teams) { |t| [keys[t][0], keys[t][1], keys[t][2], keys[t][3], t] }

puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
Array.each(sorted) do |t|
  above = Array.count(teams) { |u| keys[u] < keys[t] }
  gd = gf[t] - ga[t]
  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", above + 1, t, pld[t], won[t], drw[t], lst[t], gf[t], ga[t], sgn(gd), pts[t]))
end
