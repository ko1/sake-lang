def break_words(words, w)
  out = Array[]
  Array.each(words) do |word|
    rest = word
    while String.size(rest) > w
      Array.push(out, rest[0, w - 1] + "-")
      rest = rest[w - 1, String.size(rest)]
    end
    Array.push(out, rest)
  end
  out
end

def justify(ws, w)
  return String.ljust(Array.join(ws, " "), w) if Array.size(ws) == 1
  gaps = Array.size(ws) - 1
  letters = Array.sum(Array.map(ws) { String.size(it) })
  spaces = w - letters
  base = spaces / gaps
  extra = spaces % gaps
  s = ""
  Array.each_with_index(ws) do |wd, i|
    s += wd
    if i < gaps
      s += " " * (base + (i < extra ? 1 : 0))
    end
  end
  s
end

def layout(words, w)
  pieces = break_words(words, w)
  lines = Array[]
  cur = Array[]
  curlen = 0
  Array.each(pieces) do |wd|
    len = String.size(wd)
    if Array.empty?(cur)
      cur = Array[wd]
      curlen = len
    elsif curlen + 1 + len <= w
      Array.push(cur, wd)
      curlen += 1 + len
    else
      Array.push(lines, cur)
      cur = Array[wd]
      curlen = len
    end
  end
  Array.push(lines, cur)
  out = Array[]
  last = Array.size(lines) - 1
  Array.each_with_index(lines) do |ws, i|
    if i == last
      Array.push(out, String.ljust(Array.join(ws, " "), w))
    else
      Array.push(out, justify(ws, w))
    end
  end
  out
end

def main
  all = String.lines(IO.read(IO.stdin))
  if Array.empty?(all)
    puts("invalid width")
    return
  end
  m = String.match(String.chomp(all[0]), /\A *(\d+) *\z/)
  if m == nil || String.to_i(m[1]) < 2 || String.to_i(m[1]) > 80
    puts("invalid width")
    return
  end
  w = String.to_i(m[1])
  paras = Array[]
  cur = Array[]
  total = 0
  Array.each(Array.drop(all, 1)) do |raw|
    words = Array.reject(String.split(String.chomp(raw), /[ \t]+/)) { String.empty?(it) }
    if Array.empty?(words)
      unless Array.empty?(cur)
        Array.push(paras, cur)
        cur = Array[]
      end
    else
      total += Array.size(words)
      Array.concat(cur, words)
    end
  end
  Array.push(paras, cur) unless Array.empty?(cur)
  border = "+" + "-" * w + "+"
  puts(border)
  nlines = 0
  Array.each_with_index(paras) do |para, i|
    puts("|" + " " * w + "|") if i > 0
    ls = layout(para, w)
    nlines += Array.size(ls)
    Array.each(ls) { |l| puts("|" + l + "|") }
  end
  puts(border)
  puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{total}")
end

main
