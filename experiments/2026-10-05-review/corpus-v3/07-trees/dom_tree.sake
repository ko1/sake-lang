class Element
  attr_reader tag, attrs, children, parent
end

class Text
  attr_reader content
end

class MarkupError < StandardError
  attr_reader offset
end

def void_tags = once { Array["br", "img", "hr", "input"] }

def void_tag?(tag) = Array.include?(void_tags, tag)

def parse_attrs(src)
  attrs = Hash[]
  Array.each(String.scan(src, /([a-z-]+)="([^"]*)"/)) { |name, value| attrs[name] = value }
  attrs
end

def parse(html)
  root = Element.new("#document", Hash[], Array[], nil)
  current = root
  pos = 0
  while pos < String.size(html)
    m = Regexp.match(/<(\/?)([a-z0-9]+)([^>]*)>/, html[pos..])
    if m == nil
      text = String.strip(html[pos..])
      Array.push(Element.children(current), Text.new(text)) unless String.empty?(text)
      break
    end
    before = String.strip(MatchData.pre_match(m))
    Array.push(Element.children(current), Text.new(before)) unless String.empty?(before)
    tag = m[2]
    if m[1] == "/"
      if Element.tag(current) != tag
        raise MarkupError.new("</#{tag}> does not close <#{Element.tag(current)}>", pos + MatchData.begin(m, 0))
      end
      current = Element.parent(current)
    else
      el = Element.new(tag, parse_attrs(m[3]), Array[], current)
      Array.push(Element.children(current), el)
      current = el unless void_tag?(tag) || String.end_with?(m[3], "/")
    end
    pos += MatchData.end(m, 0)
  end
  raise MarkupError.new("unclosed <#{Element.tag(current)}>", String.size(html)) if current != root
  root
end

def classes(el)
  c = Element.attrs(el)["class"]
  c == nil ? Array[] : String.split(c, " ")
end

def matches?(el, simple)
  m = String.match(simple, /\A([a-z0-9]*)(?:\.([a-z-]+))?(?:#([a-z-]+))?\z/)
  raise ArgumentError, "bad selector #{simple}" if m == nil
  tag, klass, id = MatchData.captures(m)
  return false if tag != "" && Element.tag(el) != tag
  return false if klass && !Array.include?(classes(el), klass)
  return false if id && Element.attrs(el)["id"] != id
  true
end

def each_element(node, &block)
  Array.each(Element.children(node)) do |c|
    next unless c in Element
    yield(c)
    each_element(c, &block)
  end
end

def has_ancestor?(el, simple)
  p = Element.parent(el)
  while p
    return true if matches?(p, simple)
    p = Element.parent(p)
  end
  false
end

# descendant selectors only: "ul.menu li a"
def select(root, selector)
  *parts, last = String.split(selector, " ")
  found = Array[]
  each_element(root) do |el|
    next unless matches?(el, last)
    anchor = el
    ok = Array.all?(Array.reverse(parts)) do |part|
      p = Element.parent(anchor)
      p = Element.parent(p) while p && !matches?(p, part)
      anchor = p
      p != nil
    end
    Array.push(found, el) if ok
  end
  found
end

def text_of(node)
  case node
  in Text then Text.content(node)
  in Element then Array.join(Array.map(Element.children(node)) { |c| text_of(c) }, " ")
  end
end

def dump(node, depth)
  pad = "  " * depth
  case node
  in Text then puts("#{pad}\"#{Text.content(node)}\"")
  in Element
    attrs = Array.map(Array.sort(Hash.keys(Element.attrs(node)))) { |k| " #{k}=#{Element.attrs(node)[k]}" }
    puts("#{pad}<#{Element.tag(node)}#{Array.join(attrs)}>")
    Array.each(Element.children(node)) { |c| dump(c, depth + 1) }
  end
end

page = <<~HTML
  <html><body>
    <div id="nav"><ul class="menu main">
      <li><a href="/">Home</a></li>
      <li class="active"><a href="/docs">Docs</a></li>
      <li><a href="/blog">Blog</a></li>
    </ul></div>
    <div class="content">
      <h1>Trees</h1>
      <p class="lead">A <b>tree</b> is a graph<br/>without cycles.</p>
      <p>See <a href="/docs/graphs">graphs</a> and <a href="https://example.org">more</a>.</p>
      <img src="tree.png" alt="tree">
    </div>
  </body></html>
HTML

doc = parse(page)
dump(Array.first(Element.children(doc)), 0)
count = 0
depth_max = 0
each_element(doc) do |el|
  count += 1
  d = 0
  p = Element.parent(el)
  while p
    d += 1
    p = Element.parent(p)
  end
  depth_max = d if d > depth_max
end
puts("elements: #{count}, max depth: #{depth_max}")
tags = Hash.new(0)
each_element(doc) { |el| tags[Element.tag(el)] += 1 }
puts("tags: #{Array.join(Array.map(Array.sort_by(Hash.to_a(tags)) { |t, n| [-n, t] }) { |t, n| "#{t}=#{n}" }, " ")}")

Array.each(Array["a", "ul.menu li a", "div.content a", "li.active", "p.lead b", "#nav a", "div p", "span"]) do |sel|
  hits = select(doc, sel)
  desc = Array.map(hits) do |el|
    href = Element.attrs(el)["href"]
    href ? "#{text_of(el)}->#{href}" : text_of(el)
  end
  puts(format("%-14s %d: %s", sel, Array.size(hits), Array.join(desc, " | ")))
end
links = select(doc, "a")
external = Array.count(links) { |a| String.start_with?(Element.attrs(a)["href"], "http") }
puts("links: #{Array.size(links)}, external: #{external}, inside nav: #{Array.count(links) { |a| has_ancestor?(a, "#nav") }}")

Array.each(Array["<div><p>x</div>", "<ul><li>a</li>", "<p>ok</p>"]) do |bad|
  d = parse(bad)
  puts("#{bad} -> ok (#{text_of(d)})")
rescue MarkupError => e
  puts("#{bad} -> error at #{MarkupError.offset(e)}: #{Exception.message(e)}")
end
