def tokens(line) = String.split(String.strip(line), /\s+/)

def part(r, first, step)
  return 0 if r == 0
  extra = r - 60
  extra = 0 if extra < 0
  first + step * ((extra + 29) / 30)
end

def fee(stay, first, step, cap, grace)
  return 0 if stay <= grace
  d = stay / 1440
  r = stay % 1440
  pr = part(r, first, step)
  pr = cap if pr > cap
  d * cap + pr
end

def money(c) = format("%d.%02d", c / 100, c % 100)

def run_all
  lines = Array.map(IO.readlines(IO.stdin)) { |l| String.chomp(l) }
  ht = tokens(lines[0])
  first = String.to_i(ht[1])
  step = String.to_i(ht[2])
  cap = String.to_i(ht[3])
  grace = String.to_i(ht[4])
  inside = Hash[]
  exits = Hash.new(0)
  rev = Hash.new(0)
  day = 0
  prev = -1
  Array.each_with_index(lines) do |line, idx|
    next if idx == 0
    next if String.match?(line, /\A *\z/)
    lineno = idx + 1
    m = String.match(line, /\A([0-9]{2}):([0-9]{2}) +(IN|OUT) +([A-Z0-9]{1,8})\z/)
    if m == nil
      puts("line #{lineno}: invalid")
      next
    end
    hh = String.to_i(m[1])
    mm = String.to_i(m[2])
    if hh > 23 || mm > 59
      puts("line #{lineno}: invalid")
      next
    end
    kind = m[3]
    plate = m[4]
    tm = hh * 60 + mm
    day += 1 if tm < prev
    prev = tm
    abs = day * 1440 + tm
    if kind == "IN"
      if Hash.key?(inside, plate)
        puts("line #{lineno}: #{plate} already inside")
      else
        inside[plate] = abs
      end
    else
      if Hash.key?(inside, plate)
        stay = abs - Hash.fetch(inside, plate)
        Hash.delete(inside, plate)
        f = fee(stay, first, step, cap, grace)
        exits[plate] += 1
        rev[plate] += f
        puts(format("%s %d:%02d %s", plate, stay / 60, stay % 60, money(f)))
      else
        puts("line #{lineno}: #{plate} not inside")
      end
    end
  end
  puts("--- summary")
  plates = Array.sort_by(Hash.keys(exits)) { |pl| [-Hash.fetch(rev, pl), pl] }
  te = 0
  tr = 0
  Array.each(plates) do |pl|
    e = Hash.fetch(exits, pl)
    r = Hash.fetch(rev, pl)
    te += e
    tr += r
    puts("#{pl} #{e} #{money(r)}")
  end
  puts("total #{te} #{money(tr)}")
  left = Array.sort(Hash.keys(inside))
  if Array.empty?(left)
    puts("inside: none")
  else
    puts("inside: #{Array.join(left, ", ")}")
  end
end

run_all
