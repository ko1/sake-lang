Maze = Struct.new(:rows, :width, :height)

class Maze
  def parse(text)
    rows = Array.map(String.lines(text)) { |l| String.chars(String.chomp(l)) }
    Maze.new(rows, Array.size(Array.first(rows)), Array.size(rows))
  end

  def find(m, ch)
    Array.each_with_index(@rows) do |row, y|
      x = Array.index(row, ch)
      return [x, y] if x
    end
    nil
  end

  def open?(m, x, y)
    return false if x < 0 || y < 0 || x >= @width || y >= @height
    @rows[y][x] != "#"
  end

  def neighbors(m, pos)
    x, y = pos
    result = Array[]
    Array.each(Array[[1, 0], [0, 1], [0, -1], [-1, 0]]) do |dx, dy|
      nx = x + dx
      ny = y + dy
      Array.push(result, [nx, ny]) if open?(m, nx, ny)
    end
    result
  end
end

def same_pos?(a, b)
  ax, ay = a
  bx, by = b
  ax == bx && ay == by
end

def bfs(maze, start, goal)
  prev = Hash[start => nil]
  queue = Array[start]
  until Array.empty?(queue)
    cur = Array.shift(queue)
    break if same_pos?(cur, goal)
    Array.each(Maze.neighbors(maze, cur)) do |nb|
      next if Hash.key?(prev, nb)
      prev[nb] = cur
      Array.push(queue, nb)
    end
  end
  return nil unless Hash.key?(prev, goal)
  path = Array[]
  node = goal
  while node
    Array.unshift(path, node)
    node = prev[node]
  end
  path
end

def render(maze, path)
  rows = Array.map(Maze.get_rows(maze)) { |r| Array.dup(r) }
  Array.each(path) do |x, y|
    rows[y][x] = "." if rows[y][x] == " "
  end
  Array.each(rows) { |r| puts(Array.join(r, "")) }
end

def solve(name, text)
  maze = Maze.parse(text)
  start = Maze.find(maze, "S")
  goal = Maze.find(maze, "G")
  puts("== #{name} (#{Maze.get_width(maze)}x#{Maze.get_height(maze)})")
  if start == nil || goal == nil
    puts("missing start or goal")
    return
  end
  path = bfs(maze, start, goal)
  if path
    puts("steps: #{Array.size(path) - 1}")
    render(maze, path)
  else
    puts("no path")
  end
end

maze1 = "##########\n" \
        "#S   #   #\n" \
        "# ## # # #\n" \
        "#  #   # #\n" \
        "## ##### #\n" \
        "#      #G#\n" \
        "# #### # #\n" \
        "#      # #\n" \
        "######   #\n" \
        "##########\n"
maze2 = "#######\n" \
        "#S#   #\n" \
        "# # # #\n" \
        "### #G#\n" \
        "#######\n"
maze3 = "#####\n#S  #\n#####\n"

solve("first", maze1)
solve("walled", maze2)
solve("no goal", maze3)
