# Port of nothing (Sake only): ActiveModel records as ActionView's records
#
# Rails' ActionView calls a record's ActiveModel methods directly (`record.to_model.model_name.param_key`,
# `record.errors[attr]`, `record.class.human_attribute_name(attr)`). Here ActionView reads records through
# ModelNaming::Model; an ActiveModel (or ActiveRecord) class includes this module *before* ActiveModel's modules,
# so ActiveModel's to_key, to_param, persisted?, param_key, route_key, to_partial_path, read_attribute_for_validation
# and human_attribute_name_of (nearer) answer Model's requirements, and the two functions below give the rest.
# ActiveRecord's generator includes it when a program pushes it to ActiveRecord::Generate.protocol_includes.

require "../model_naming"
require "../../../activemodel/active_model"

module ActionView
  module ModelNaming
    module Record
      include ActionView::ModelNaming::Model

      # Ruby: record.errors[attribute]
      def errors_for(r, attribute) = ::ActiveModel::Errors.messages_for(errors(r), attribute)
      # Ruby: record.model_name.human
      def model_name_human(r) = ::ActiveModel::Name.human(model_name_of(r))
    end
  end
end
