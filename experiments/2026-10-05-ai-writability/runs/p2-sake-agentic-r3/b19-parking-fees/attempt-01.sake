def money(c) = format("%d.%02d", c / 100, c % 100)

def fee(stay, first, step, cap, grace)
  return 0 if stay <= grace
  d = stay / 1440
  r = stay % 1440
  part = 0
  if r > 0
    extra = r > 60 ? (r - 60 + 29) / 30 : 0
    part = first + step * extra
  end
  d * cap + (part < cap ? part : cap)
end

lines = IO.readlines(IO.stdin)
head = String.split(lines[0])
first = String.to_i(head[1])
step = String.to_i(head[2])
cap = String.to_i(head[3])
grace = String.to_i(head[4])

inside = Hash.new
exits = Hash.new(0)
revenue = Hash.new(0)
day = 0
prev = -1
total_exits = 0
total_rev = 0
k = 1
while k < Array.size(lines)
  text = String.chomp(lines[k])
  no = k + 1
  k += 1
  next if String.match?(text, /\A *\z/)
  m = String.match(text, /\A *([0-9][0-9]):([0-9][0-9]) +(IN|OUT) +([A-Z0-9]{1,8}) *\z/)
  hh = m == nil ? 99 : String.to_i(MatchData.captures(m)[0])
  mm = m == nil ? 99 : String.to_i(MatchData.captures(m)[1])
  if m == nil || hh > 23 || mm > 59
    puts("line #{no}: invalid")
    next
  end
  cap_ = MatchData.captures(m)
  kind = cap_[2]
  plate = cap_[3]
  mins = hh * 60 + mm
  day += 1 if prev >= 0 && mins < prev
  prev = mins
  abs = day * 1440 + mins
  if kind == "IN"
    if inside[plate] != nil
      puts("line #{no}: #{plate} already inside")
    else
      inside[plate] = abs
    end
  else
    t0 = inside[plate]
    if t0 == nil
      puts("line #{no}: #{plate} not inside")
    else
      Hash.delete(inside, plate)
      stay = abs - t0
      f = fee(stay, first, step, cap, grace)
      puts("#{plate} #{stay / 60}:#{format("%02d", stay % 60)} #{money(f)}")
      exits[plate] += 1
      revenue[plate] += f
      total_exits += 1
      total_rev += f
    end
  end
end

puts("--- summary")
plates = Array.sort_by(Hash.keys(exits)) { |pl| [-revenue[pl], pl] }
Array.each(plates) { |pl| puts("#{pl} #{exits[pl]} #{money(revenue[pl])}") }
puts("total #{total_exits} #{money(total_rev)}")
left = Array.sort(Hash.keys(inside))
puts("inside: #{Array.size(left) == 0 ? "none" : Array.join(left, ", ")}")
