# Pythagorean triples: Euclid's formula for primitive triples, all triples up to
# a perimeter bound, perimeters with many triples, and the Berggren tree.

class Triple
  attr_reader a, b, c
  include Comparable

  def build(a, b, c) = a < b ? Triple.new(a, b, c) : Triple.new(b, a, c)
  def perimeter(t) = @a + @b + @c
  def area(t) = @a * @b / 2
  def primitive?(t) = Integer.gcd(Integer.gcd(@a, @b), @c) == 1
  def scale(t, k) = Triple.new(@a * k, @b * k, @c * k)
  def valid?(t) = @a * @a + @b * @b == @c * @c

  def <=>(x, y)
    by_c = @c <=> Triple.c(y)
    by_c != 0 ? by_c : @a <=> Triple.a(y)
  end

  def to_s(t) = "(#{@a}, #{@b}, #{@c})"
end

def primitives_up_to(max_c)
  out = Triple[]
  m = 2
  while m * m + 1 <= max_c
    n = 1
    while n < m
      if Integer.odd?(m - n) && Integer.gcd(m, n) == 1
        c = m * m + n * n
        Array.push(out, Triple.build(m * m - n * n, 2 * m * n, c)) if c <= max_c
      end
      n += 1
    end
    m += 1
  end
  Array.sort(out)
end

def all_by_perimeter(max_p)
  by_p = Hash[]
  Array.each(primitives_up_to(max_p / 2)) do |t|
    p0 = Triple.perimeter(t)
    k = 1
    while p0 * k <= max_p
      list = by_p[p0 * k]
      if list == nil
        list = Triple[]
        by_p[p0 * k] = list
      end
      Array.push(list, Triple.scale(t, k))
      k += 1
    end
  end
  by_p
end

# Berggren matrices applied to (a, b, c)
def children(t)
  a = Triple.a(t)
  b = Triple.b(t)
  c = Triple.c(t)
  Triple[
    Triple.build(a - 2 * b + 2 * c, 2 * a - b + 2 * c, 2 * a - 2 * b + 3 * c),
    Triple.build(a + 2 * b + 2 * c, 2 * a + b + 2 * c, 2 * a + 2 * b + 3 * c),
    Triple.build(-a + 2 * b + 2 * c, -2 * a + b + 2 * c, -2 * a + 2 * b + 3 * c)
  ]
end

prims = primitives_up_to(100)
puts("primitive triples with c <= 100: #{Array.size(prims)}")
Array.each_slice(prims, 4) { |row| puts("  " + Array.join(Array.map(row) { |t| Triple.to_s(t) }, " ")) }
raise "invalid triple" unless Array.all?(prims) { |t| Triple.valid?(t) && Triple.primitive?(t) }

by_p = all_by_perimeter(1000)
best_p = Array.max_by(Hash.keys(by_p)) { |p| [Array.size(by_p[p]), -p] }
puts("perimeter <= 1000 with most triples: #{best_p}")
Array.each(Array.sort(by_p[best_p])) { |t| puts("  #{t} area #{Triple.area(t)}") }

single = Array.count(Hash.keys(by_p)) { |p| Array.size(by_p[p]) == 1 }
puts("perimeters with exactly one triple: #{single}")

areas = Array.map(prims) { |t| Triple.area(t) }
puts("smallest areas: #{Array.join(Array.take(Array.sort(areas), 6), " ")}")
largest = Array.max(prims)
puts("largest primitive (by c, then a): #{largest}")
puts("first with c > 50: #{Array.find(prims) { |t| Triple.c(t) > 50 }}")

puts("Berggren tree, 3 levels:")
level = Triple[Triple.new(3, 4, 5)]
depth = 0
while depth < 3
  puts("  depth #{depth}: " + Array.join(Array.map(Array.sort(level)) { |t| Triple.to_s(t) }, " "))
  nxt = Triple[]
  Array.each(level) { |t| Array.concat(nxt, children(t)) }
  level = nxt
  depth += 1
end
in_tree = Array.select(level) { |t| Triple.c(t) <= 100 }
puts("  depth 3 triples with c <= 100: #{Array.size(in_tree)}")
