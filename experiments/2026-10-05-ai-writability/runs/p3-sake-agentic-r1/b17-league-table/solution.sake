def name_ok?(s) = String.match?(s, /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/)

lines = Array.map(IO.readlines(IO.stdin())) { String.chomp(it) }
idx = Hash[]
names = String[]
pts = Integer[]
gf = Integer[]
ga = Integer[]
w = Integer[]
d = Integer[]
l = Integer[]
pl = Integer[]
matches = Tuple[]

def team_index(idx, names, pts, gf, ga, w, d, l, pl, name)
  return idx[name] if idx[name] != nil
  k = Array.size(names)
  idx[name] = k
  Array.push(names, name)
  Array.push(pts, 0)
  Array.push(gf, 0)
  Array.push(ga, 0)
  Array.push(w, 0)
  Array.push(d, 0)
  Array.push(l, 0)
  Array.push(pl, 0)
  k
end

Array.each_with_index(lines) do |line, i|
  next if String.strip(line) == ""
  toks = String.split(line)
  good = Array.size(toks) == 3 && name_ok?(toks[0]) && name_ok?(toks[2]) && toks[0] != toks[2]
  played = false
  if good
    if toks[1] == "P-P"
      played = false
    elsif String.match?(toks[1], /\A\d{1,2}-\d{1,2}\z/)
      played = true
    else
      good = false
    end
  end
  if !good
    puts("invalid line #{i + 1}: #{line}")
    next
  end
  h = team_index(idx, names, pts, gf, ga, w, d, l, pl, toks[0])
  a = team_index(idx, names, pts, gf, ga, w, d, l, pl, toks[2])
  if played
    sc = String.split(toks[1], "-")
    hg = String.to_i(sc[0])
    ag = String.to_i(sc[1])
    Array.push(matches, [h, a, hg, ag])
    pl[h] += 1
    pl[a] += 1
    gf[h] += hg
    ga[h] += ag
    gf[a] += ag
    ga[a] += hg
    if hg > ag
      w[h] += 1
      l[a] += 1
      pts[h] += 3
    elsif hg < ag
      w[a] += 1
      l[h] += 1
      pts[a] += 3
    else
      d[h] += 1
      d[a] += 1
      pts[h] += 1
      pts[a] += 1
    end
  end
end

n = Array.size(names)
if n == 0
  puts("no teams")
  exit(0)
end

k3 = Array.map(Array.new(n) { |i| i }) { |i| [pts[i], gf[i] - ga[i], gf[i]] }
h2h = Array.new(n, 0)
Array.each(matches) do |m|
  h, a, hg, ag = m
  if k3[h] == k3[a]
    if hg > ag
      h2h[h] += 3
    elsif hg < ag
      h2h[a] += 3
    else
      h2h[h] += 1
      h2h[a] += 1
    end
  end
end

k4 = Array.map(Array.new(n) { |i| i }) { |i| [-pts[i], -(gf[i] - ga[i]), -gf[i], -h2h[i]] }
order = Array.sort_by(Array.new(n) { |i| i }) { |i| [-pts[i], -(gf[i] - ga[i]), -gf[i], -h2h[i], names[i]] }

puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
Array.each(order) do |i|
  pos = 1 + Array.count(k4) { |kk| kk < k4[i] }
  gd = gf[i] - ga[i]
  gds = gd > 0 ? "+#{gd}" : "#{gd}"
  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", pos, names[i], pl[i], w[i], d[i], l[i], gf[i], ga[i], gds, pts[i]))
end
