require "erb"

# A table template rendered over 80 rows: loop, if/else, comparison, escaping, method calls.
tmpl = "<table>\n<%- rows.each do |r| -%>\n  <tr>\n" \
       "<%- if r[:n] >= 150 && r[:name] != \"x\" -%>\n    <td><%= h(r[:name]) %></td><td><%= u(r[:name]) %></td>\n" \
       "<%- else -%>\n    <td><%= r[:name].upcase %></td><td><%= r[:tags].join(\", \") %></td>\n<%- end -%>\n  </tr>\n<%- end -%>\n</table>\n"
rows = Array[]
Integer.times(80) { |i| Array.push(rows, Hash[n: i, name: "<row #{i}> & 'q'", tags: Array["a", "b#{i}"]]) }
t0 = Time.now
erb = ERB.new(tmpl, "-")
out = ERB.result_with_hash(erb, Hash[rows: rows])
el = Time.to_f(Time.now) - Time.to_f(t0)
p String.size(out)
warn "work #{Float.round(el * 1000)}ms"
