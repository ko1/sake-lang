# The syntax tree (SPEC section 3).
#
# Every node is a Struct type; the evaluator and the static checks dispatch on
# them with case/in. span is the source range of the whole node (parentheses
# around an expression belong to the enclosing one); errors are reported at it.
#
# The static checks (checker.sake) fill in the fields declared with
# attr_accessor: the scope slot of each declaration and the place each name
# refers to.

# ---- Expressions ----

class IntLit
  attr_reader value, span
end

class StrLit
  attr_reader value, span
end

# A string with interpolations: parts are Strings and expression nodes.
class InterpStr
  attr_reader parts, span
end

class BoolLit
  attr_reader value, span
end

class NilLit
  attr_reader span
end

# A use of a name. After the static checks, hops is the number of scopes to
# walk out from the current one and slot the variable's index there; hops is
# -1 for a built-in, whose slot is then its index in Builtins.names.
class NameRef
  attr_reader name, span
  attr_accessor hops, slot
end

class ArrayLit
  attr_reader elements, span
end

# One `key: value` of a map literal; span is the key's.
class MapEntry
  attr_reader key, value, span
end

class MapLit
  attr_reader entries, span
end

# A parameter; default is nil when it has none.
class Param
  attr_reader name, default, span
end

# A function: `fn (params) body end`, or the function of a declaration.
# name is "" for an anonymous function. min_args counts the parameters
# without a default.
class FnLit
  attr_reader name, params, min_args, body, span
end

# A binary operator: op is "+", "-", "*", "/", "%", "**", "==", "!=", "<",
# "<=", ">", ">=" or "in".
class BinOp
  attr_reader op, left, right, span
end

# `and` / `or`: op is "and" or "or".
class LogicOp
  attr_reader op, left, right, span
end

class NotOp
  attr_reader operand, span
end

class NegOp
  attr_reader operand, span
end

class CallExpr
  attr_reader callee, args, span
end

class IndexExpr
  attr_reader target, index, span
end

# `a[lo:hi]`: lo and hi are nil when left out.
class SliceExpr
  attr_reader target, lo, hi, span
end

# `m.name`, which means m["name"].
class FieldExpr
  attr_reader target, name, span
end

# ---- Statements ----

# A statement list and the scope it runs in. nslots is the number of variable
# slots of that scope (set by the static checks); fns are the function
# declarations of the list, whose closures are created when it starts running.
class Block
  attr_reader stmts, fns
  attr_accessor nslots
end

# A name being declared (let, const, fn, for, catch, let [...]).
class Binder
  attr_reader name, span
  attr_accessor slot
end

class ExprStmt
  attr_reader expr
end

# `let x [= value]`: value is nil when left out.
class LetStmt
  attr_reader binder, value
end

# `let [a, b] = value`; span is `[` to `]` of the names.
class LetArrayStmt
  attr_reader binders, value, span
end

class ConstStmt
  attr_reader binder, value
end

class FnStmt
  attr_reader binder, fn
end

# `if c1 then b1 elif c2 then b2 ... else e end`: else_block is nil when left out.
class IfStmt
  attr_reader conds, blocks, else_block
end

class WhenArm
  attr_reader values, block
end

class MatchStmt
  attr_reader subject, arms, else_block, span
end

class WhileStmt
  attr_reader cond, body
end

# `for a [, b] in iter do body end`: binders has one or two names.
class ForStmt
  attr_reader binders, iter, body, span
end

class BreakStmt
  attr_reader span
end

class ContinueStmt
  attr_reader span
end

# value is nil for a bare `return`.
class ReturnStmt
  attr_reader value, span
end

class ThrowStmt
  attr_reader value, span
end

# message is nil when left out.
class AssertStmt
  attr_reader cond, message, span
end

# catch_binder and catch_block are both nil, or both set; so is finally_block.
class TryStmt
  attr_reader body, catch_binder, catch_block, finally_block
end

# `t1, t2 = v1, v2` or `t op= v`: op is "=", "+=", "-=", "*=", "/=" or "%=".
class AssignStmt
  attr_reader targets, op, values, span
end

# The span of an expression node.
module Nodes
  module_function

  def span(node)
    case node
    in IntLit then IntLit.span(node)
    in StrLit then StrLit.span(node)
    in InterpStr then InterpStr.span(node)
    in BoolLit then BoolLit.span(node)
    in NilLit then NilLit.span(node)
    in NameRef then NameRef.span(node)
    in ArrayLit then ArrayLit.span(node)
    in MapLit then MapLit.span(node)
    in FnLit then FnLit.span(node)
    in BinOp then BinOp.span(node)
    in LogicOp then LogicOp.span(node)
    in NotOp then NotOp.span(node)
    in NegOp then NegOp.span(node)
    in CallExpr then CallExpr.span(node)
    in IndexExpr then IndexExpr.span(node)
    in SliceExpr then SliceExpr.span(node)
    in FieldExpr then FieldExpr.span(node)
    end
  end
end
