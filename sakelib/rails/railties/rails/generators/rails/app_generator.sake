# Port of railties-8.1.3/lib/rails/generators/rails/app/app_generator.rb, app_base.rb and app_name.rb with the templates the Sake app has (partial: as `rails new --skip-bundle --skip-git --skip-javascript --skip-asset-pipeline` with jobs, mailers, cable, storage, text, tests, docker, kamal, CI and dev gems skipped; no Gemfile, Rakefile, config.ru, bin/setup/dev (Sake has no bundler, rake or rack-up file: bin/rails.sake is the entry point), no PWA views, no `allow_browser` (not ported))
#
# The files are those of experiments/2026-10-20-rails-scale/blog/ before its own code: config/*.sake run as
# top-level statements in Rails' order (application, environments/, initializers/, initialize!), config/generate.sake
# is the boot generator `generate "generate"` runs, config/routes.sake reopens the Mapper. The credentials are
# Rails': a new master key and config/credentials.yml.enc holding a new secret_key_base.

require "../base"
require "rails/activesupport/active_support/encrypted_configuration"
require "securerandom"

require "fileutils"

module Rails
  module Generators
    module AppGenerator
      module_function

      # Ruby: AppName#app_name (the directory's name, dashes as underscores) and app_const_base
      def app_name(path) = String.gsub(String.tr(File.basename(File.expand_path(path)), "-", "_"), /[^a-zA-Z0-9_]/, "_")
      def app_const_base(path) = ActiveSupport::Inflector.camelize(String.squeeze(String.gsub(app_name(path), /\W/, "_"), "_"))

      def templates_dir = File.join(__dir__, "app/templates")

      def application_source(k)
        <<~SAKE
          require "boot"
          require "routes"
          # The app's generated source (models, url helpers, controllers, views, the app's own files): config/generate.sake
          generate "generate"

          module #{k}
            class Application < Rails::Application
            end
          end

          # Rails: the class body of #{k}::Application
          Rails.application.configure do |config|
            # Initialize configuration defaults for originally generated Rails version.
            config.Rails::Application::Configuration.load_defaults(8.1)
          end
        SAKE
      end

      def boot_source
        "# Rails: config/boot.rb (Bundler and bootsnap); here the frameworks (Rails: config/application.rb's requires)\nrequire \"rails/railties/rails/all\"\n"
      end

      def environment_source
        "# Load the Rails application.\nrequire \"application\"\nrequire \"environments/*\"\nrequire \"initializers/*\"\n\n# Initialize the Rails application.\nRails.application.initialize!\n"
      end

      def development_source
        <<~SAKE
          Rails.application.configure(:development) do |config|
            # Settings specified here will take precedence over those in config/application.sake.

            # Make code changes take effect immediately without server restart.
            config.Rails::Application::Configuration.enable_reloading = true

            # Do not eager load code on boot.
            config.Rails::Application::Configuration.eager_load = false

            # Show full error reports.
            config.Rails::Application::Configuration.consider_all_requests_local = true

            # Enable server timing.
            config.Rails::Application::Configuration.server_timing = true

            config.Rails::Application::Configuration.action_controller[:perform_caching] = false

            # Highlight code that triggered redirect in logs.
            config.Rails::Application::Configuration.action_dispatch[:verbose_redirect_logs] = true

            # Annotate rendered view with file names.
            config.Rails::Application::Configuration.action_view[:annotate_rendered_view_with_filenames] = true

            # Raise error when a before_action's only/except options reference missing actions.
            config.Rails::Application::Configuration.action_controller[:raise_on_missing_callback_actions] = true
          end
        SAKE
      end

      def test_source
        <<~SAKE
          Rails.application.configure(:test) do |config|
            config.Rails::Application::Configuration.enable_reloading = false
            config.Rails::Application::Configuration.eager_load = ENV.get("CI") != nil
            config.Rails::Application::Configuration.consider_all_requests_local = true
            config.Rails::Application::Configuration.action_dispatch[:show_exceptions] = :rescuable
            config.Rails::Application::Configuration.action_controller[:allow_forgery_protection] = false
            config.Rails::Application::Configuration.action_controller[:raise_on_missing_callback_actions] = true
          end
        SAKE
      end

      def production_source
        <<~SAKE
          Rails.application.configure(:production) do |config|
            config.Rails::Application::Configuration.enable_reloading = false
            config.Rails::Application::Configuration.eager_load = true
            config.Rails::Application::Configuration.consider_all_requests_local = false
            config.Rails::Application::Configuration.action_controller[:perform_caching] = true
            config.Rails::Application::Configuration.assume_ssl = true
            config.Rails::Application::Configuration.force_ssl = true
            config.Rails::Application::Configuration.log_tags = Any[:request_id]
            config.Rails::Application::Configuration.log_level = String.to_sym(ENV.fetch("RAILS_LOG_LEVEL", "info"))
            config.Rails::Application::Configuration.silence_healthcheck_path = "/up"
            config.Rails::Application::Configuration.i18n[:fallbacks] = true
          end
        SAKE
      end

      def filter_parameter_logging_source
        <<~SAKE
          # Configure parameters to be partially matched (e.g. passw matches password) and filtered from the log file.
          # Use this to limit dissemination of sensitive information.
          # See the ActiveSupport::ParameterFilter documentation for supported notations and behaviors.
          Array.concat(Rails.application.config.Rails::Application::Configuration.filter_parameters, Any[
            :passw, :email, :secret, :token, :_key, :crypt, :salt, :certificate, :otp, :ssn, :cvv, :cvc
          ])
        SAKE
      end

      def database_source
        db = "# SQLite. Versions 3.8.0 and up are supported.\n# (Rails writes a `default: &default` anchor merged into each environment; sakelib's YAML has no anchors)\n"
        Array.each(String["development", "test", "production"]) do |e|
          db += "#{e == "development" ? "" : "\n"}#{e}:\n  adapter: sqlite3\n  timeout: 5000\n  database: storage/#{e}.sqlite3\n"
        end
        db
      end

      def routes_source
        <<~SAKE
          require "rails/actionpack/action_dispatch/routing"

          # Rails: Rails.application.routes.draw do ... end; the block is a function of the reopened Mapper, so its calls are bare
          class ActionDispatch::Routing::Mapper
            def application_routes(map)
              # Define your application routes per the DSL in https://guides.rubyonrails.org/routing.html

              # Reveal health status on /up that returns 200 if the app boots with no exceptions, otherwise 500.
              # Can be used by load balancers and uptime monitors to verify that the app is live.
              get map, "up", to: "rails/health#show", as: :rails_health_check

              # Defines the root path route ("/")
              # root map, "posts#index"
            end
          end
        SAKE
      end

      def generate_source
        <<~SAKE
          # The program `generate "generate"` (config/application.sake) runs before the app is checked: it draws the routes
          # and prints the source Rails defines while it boots (Rails::Generate.application).
          require "routes"
          require "rails/railties/rails/generate/application"

          set = ActionDispatch::Routing::RouteSet.make
          ActionDispatch::Routing::RouteSet.draw(set) { |map| ActionDispatch::Routing::Mapper.application_routes(map) }
          print(Rails::Generate.application(File.expand_path("..", __dir__), set))
        SAKE
      end

      def layout_source(title)
        <<~ERB
          <!DOCTYPE html>
          <html>
            <head>
              <title><%= content_for(view, :title) || "#{title}" %></title>
              <meta name="viewport" content="width=device-width,initial-scale=1">
              <meta name="apple-mobile-web-app-capable" content="yes">
              <meta name="application-name" content="#{title}">
              <meta name="mobile-web-app-capable" content="yes">
              <%= csrf_meta_tags view %>
              <%= csp_meta_tag view %>

              <%= yield :head %>

              <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
              <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

              <link rel="icon" href="/icon.png" type="image/png">
              <link rel="icon" href="/icon.svg" type="image/svg+xml">
              <link rel="apple-touch-icon" href="/icon.png">

              <%# Includes all stylesheet files in app/assets/stylesheets %>
              <%= stylesheet_link_tag view, "application" %>
            </head>

            <body>
              <%= yield %>
            </body>
          </html>
        ERB
      end

      def seeds_source
        <<~SAKE
          # This file should ensure the existence of records required to run the application in every environment (production,
          # development, test). The code here should be idempotent so that it can be executed at any point in every environment.
          # The data can then be loaded with the bin/rails db:seed command (or created alongside the database with db:setup).
          # (Rails: db/seeds.rb is run with `load`; here it is the body of `seed`, which bin/rails db:seed calls.)
          #
          # Example:
          #
          #   Array.each(String["Action", "Comedy", "Drama", "Horror"]) do |genre_name|
          #     MovieGenre.find_or_create_by!(name: genre_name)
          #   end
          def seed = nil
        SAKE
      end

      def css_source
        "/*\n * This is a manifest file that'll be compiled into application.css.\n *\n * With Propshaft, assets are served efficiently without preprocessing steps. You can still include\n * application-wide styles in this file, but keep in mind that CSS precedence will follow the standard\n * cascading order, meaning styles declared later in the document or manifest will override earlier ones,\n * depending on specificity.\n *\n * Consider organizing styles into separate files for maintainability.\n */\n"
      end

      def readme_source
        "# README\n\nThis README would normally document whatever steps are necessary to get the\napplication up and running.\n\nThings you may want to cover:\n\n* Ruby version\n\n* System dependencies\n\n* Configuration\n\n* Database creation\n\n* Database initialization\n\n* How to run the test suite\n\n* Services (job queues, cache servers, search engines, etc.)\n\n* Deployment instructions\n\n* ...\n"
      end

      # Ruby: the generator's steps (create_root_files, create_app_files, create_bin_files, create_config_files,
      # create_db_files, create_lib_files, create_log_files, create_public_files, create_tmp_files, create_storage_files)
      def run(g, path)
        k = app_const_base(path)
        title = ActiveSupport::Inflector.titleize(app_name(path))

        Base.create_file(g, "README.md", readme_source)
        Base.empty_directory(g, "app")
        Base.create_file(g, "app/assets/stylesheets/application.css", css_source)
        Base.create_file(g, "app/controllers/application_controller.rb", "class ApplicationController < ActionController::Base\nend\n")
        Base.create_file(g, "app/controllers/application_controller.sake", "class ApplicationController < ActionController::Base\n  include #{k}UrlHelpers\nend\n")
        Base.create_file(g, "app/helpers/application_helper.sake", "module ApplicationHelper\nend\n")
        Base.create_file(g, "app/models/application_record.rb", "class ApplicationRecord < ActiveRecord::Base\n  primary_abstract_class\nend\n")
        Base.create_file(g, "app/views/layouts/application.html.erb", layout_source(title))
        Base.create_file(g, "app/controllers/concerns/.keep", "")
        Base.create_file(g, "app/models/concerns/.keep", "")
        Base.empty_directory(g, "bin")
        Base.create_file(g, "bin/rails.sake", "# Rails: bin/rails (APP_PATH, config/boot, rails/commands): `bin/sake bin/rails.sake COMMAND`\nrequire \"../config/environment\"\n\nRails::Commands.invoke(Rails.application, ARGV)\n")
        Base.empty_directory(g, "config")
        Base.create_file(g, "config/routes.sake", routes_source)
        Base.create_file(g, "config/application.sake", application_source(k))
        Base.create_file(g, "config/environment.sake", environment_source)
        Base.empty_directory(g, "config/environments")
        Base.create_file(g, "config/environments/development.sake", development_source)
        Base.create_file(g, "config/environments/production.sake", production_source)
        Base.create_file(g, "config/environments/test.sake", test_source)
        Base.empty_directory(g, "config/initializers")
        Base.create_file(g, "config/initializers/filter_parameter_logging.sake", filter_parameter_logging_source)
        Base.empty_directory(g, "config/locales")
        Base.create_file(g, "config/locales/en.yml", File.read(File.join(AppGenerator.templates_dir, "config/locales/en.yml")))
        create_credentials(g)
        Base.create_file(g, "config/boot.sake", boot_source)
        Base.create_file(g, "config/database.yml", database_source)
        Base.create_file(g, "config/generate.sake", generate_source)
        Base.empty_directory(g, "db")
        Base.create_file(g, "db/seeds.sake", seeds_source)
        Base.empty_directory(g, "log")
        Base.create_file(g, "log/.keep", "")
        Base.empty_directory(g, "public")
        public_dir = File.join(AppGenerator.templates_dir, "public")
        Array.each(Array.sort(Array.map(Dir.children(public_dir)) { |f| Kernel.to_s(f) })) do |f|
          Base.say_status(g, :create, "public/#{f}")
          FileUtils.mkdir_p(Base.path(g, "public"))
          FileUtils.cp(File.join(public_dir, f), Base.path(g, "public/#{f}"))
        end
        Base.empty_directory(g, "tmp")
        Base.create_file(g, "tmp/.keep", "")
        Base.create_file(g, "tmp/pids/.keep", "")
        Base.empty_directory(g, "storage")
        Base.create_file(g, "storage/.keep", "")
        Base.create_file(g, "tmp/storage/.keep", "")
        nil
      end

      # Ruby: the master_key and credentials generators (credentials.yml.tt with a new secret_key_base; quiet in `new`)
      def create_credentials(g)
        key = ActiveSupport::EncryptedFile.generate_key
        Base.create_file(g, "config/master.key", key)
        content = "# smtp:\n#   user_name: my-smtp-user\n#   password: my-smtp-password\n#\n# aws:\n#   access_key_id: 123\n#   secret_access_key: 345\n\n" \
                  "# Used as the base secret for all MessageVerifiers in Rails, including the one protecting cookies.\nsecret_key_base: #{SecureRandom.hex(64)}\n"
        c = ActiveSupport::EncryptedConfiguration.make(config_path: Base.path(g, "config/credentials.yml.enc"), key_path: Base.path(g, "config/master.key"),
                                                       env_key: "RAILS_MASTER_KEY", raise_if_missing_key: true)
        ActiveSupport::EncryptedConfiguration.write(c, content)
        nil
      end
    end
  end
end
