# Prints the view class generate/view_class.sake writes for rendering.sake (no .rb: Rails compiles at run time)
require "rails/actionview/action_view/generate/templates"

print(ActionView::Generate.view_class("BlogView", String["views"], records: String["Post", "Comment"],
                                      includes: String["BlogUrlHelpers"], assigns: String["post", "posts", "comments"]))
