Slot = Struct.new(:name, :price, :count)

def money(c) = "#{c / 100}.#{String.rjust(Integer.to_s(c % 100), 2, "0")}"

def money?(s) = String.match?(s, /\A\d+\.\d\d\z/)
def cents(s) = String.to_i(String.delete(s, "."))
def coins = Array[200, 100, 50, 25, 10, 5]
def count_ok?(s, mx) = String.match?(s, /\A\d+\z/) && String.to_i(s) <= mx

def show(list) = "[" + Array.join(Array.map(list) { |c| money(c) }, " ") + "]"

slots = Hash[]
tubes = Hash.new(0)
inserted = Integer[]
credit = 0
sold = Hash.new(0)
rev = Hash.new(0)
text = IO.read(IO.stdin)
Array.each_with_index(String.split(text, "\n")) do |line, i|
  n = i + 1
  f = String.split(String.strip(line), " ")
  next if Array.size(f) == 0
  cmd = f[0]
  want = 0
  case cmd
  in "SLOT" then want = 5
  in "TUBE" then want = 3
  in "COIN" | "SELECT" then want = 2
  in "CANCEL" then want = 1
  else
    puts("line #{n}: error: unknown command")
    next
  end
  if Array.size(f) != want
    puts("line #{n}: error: wrong field count")
    next
  end
  if cmd == "SLOT"
    if !String.match?(f[1], /\A[A-Z]\d\z/)
      puts("line #{n}: error: bad slot")
    elsif !String.match?(f[2], /\A[a-z]{1,12}\z/)
      puts("line #{n}: error: bad name")
    elsif !money?(f[3])
      puts("line #{n}: error: bad money")
    elsif !count_ok?(f[4], 99)
      puts("line #{n}: error: bad count")
    else
      slots[f[1]] = Slot.new(f[2], cents(f[3]), String.to_i(f[4]))
    end
  elsif cmd == "TUBE"
    if !money?(f[1])
      puts("line #{n}: error: bad money")
    elsif !Array.include?(coins, cents(f[1]))
      puts("line #{n}: error: bad coin")
    elsif !count_ok?(f[2], 999)
      puts("line #{n}: error: bad count")
    else
      tubes[cents(f[1])] += String.to_i(f[2])
    end
  elsif cmd == "COIN"
    if !money?(f[1])
      puts("line #{n}: error: bad money")
    else
      v = cents(f[1])
      if !Array.include?(coins, v)
        puts("rejected #{money(v)}")
      elsif credit + v > 500
        puts("rejected #{money(v)} (credit limit)")
      else
        credit += v
        tubes[v] += 1
        Array.push(inserted, v)
        puts("credit #{money(credit)}")
      end
    end
  elsif cmd == "SELECT"
    s = slots[f[1]]
    if s == nil
      puts("no slot #{f[1]}")
    elsif Slot.count(s) == 0
      puts("sold out #{f[1]}")
    elsif credit < Slot.price(s)
      puts("insert #{money(Slot.price(s) - credit)} more")
    else
      change = credit - Slot.price(s)
      need = change
      paid = Integer[]
      Array.each(coins) do |c|
        k = need / c
        k = tubes[c] if k > tubes[c]
        Integer.times(k) { Array.push(paid, c) }
        need -= k * c
      end
      if need != 0
        puts("exact change needed")
      else
        Array.each(paid) { |c| tubes[c] -= 1 }
        Slot.set_count(s, Slot.count(s) - 1)
        sold[Slot.name(s)] += 1
        rev[Slot.name(s)] += Slot.price(s)
        credit = 0
        Array.clear(inserted)
        if change == 0
          puts("vend #{Slot.name(s)}, change #{money(change)}")
        else
          puts("vend #{Slot.name(s)}, change #{money(change)} #{show(paid)}")
        end
      end
    end
  else
    if credit == 0
      puts("nothing to return")
    else
      Array.each(inserted) { |c| tubes[c] -= 1 }
      puts("returned #{money(credit)} #{show(inserted)}")
      credit = 0
      Array.clear(inserted)
    end
  end
end

puts("credit #{money(credit)} kept") if credit != 0
puts("sales:")
names = Array.sort_by(Hash.keys(sold)) { |k| [-rev[k], k] }
puts("  none") if Array.size(names) == 0
Array.each(names) { |k| puts(format("  %-12s %3d %8s", k, sold[k], money(rev[k]))) }
puts("tubes: " + Array.join(Array.map(Array.reverse(coins)) { |c| "#{money(c)}x#{tubes[c]}" }, " "))
