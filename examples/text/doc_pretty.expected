========================================================================================================================
{
  name: "sake",
  version: [0, 4, 1],
  authors: ["ko1", "a very long contributor name that will not fit", "third"],
  deps: {prism: ">= 1.0", racc: nil},
  flags: [true, false, nil],
  matrix: [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
}
============================================================
{
  name: "sake",
  version: [0, 4, 1],
  authors:
    [
      "ko1",
      "a very long contributor name that will not fit",
      "third"
    ],
  deps: {prism: ">= 1.0", racc: nil},
  flags: [true, false, nil],
  matrix: [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
}
==============================
{
  name: "sake",
  version: [0, 4, 1],
  authors:
    [
      "ko1",
      "a very long contributor name that will not fit",
      "third"
    ],
  deps:
    {
      prism: ">= 1.0",
      racc: nil
    },
  flags: [true, false, nil],
  matrix:
    [
      [1, 2, 3],
      [4, 5, 6],
      [7, 8, 9]
    ]
}
========================================
-- width 100
assert_equal(String.upcase(String.strip(name)), "SAKE", format("%s at %d", where, line_number))
-- width 40
assert_equal(
  String.upcase(String.strip(name)),
  "SAKE",
  format("%s at %d", where, line_number)
)
-- width 24
assert_equal(
  String.upcase(
    String.strip(name)
  ),
  "SAKE",
  format(
    "%s at %d",
    where,
    line_number
  )
)
