require "benchmark"

# benchmark: Tms#format with the default and a custom format, 500 times each.
a = BenchmarkTms.new(1.5, 0.25, 0.0, 0.125, 2.0, "fixed")
n = 0
Integer.times(500) do |i|
  n += String.size(BenchmarkTms.format(a, Benchmark.FORMAT))
  n += String.size(BenchmarkTms.format(a, "[%-8n] %5.2u %.1t %3r %% total: %tsec\n"))
end
p(n)
