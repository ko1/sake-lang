# Port of actionview-8.1.3/lib/action_view/helpers/tags/{datetime_field,date_field,datetime_local_field,time_field,month_field,week_field}.rb
#
# Ruby's `value&.strftime(...)` over Date, Time or DateTime: `DatetimeField.strftime_of(value, format)`.

require "time"
require "date"
require "text_field"

module ActionView
  module Helpers
    module Tags
      class DatetimeField < TextField
        attr_accessor include_seconds
        def field_type(t) = "datetime"

        def render(t)
          options = Hash.stringify_keys(@options)
          options["value"] = datetime_value(t, Hash.key?(options, "value") ? options["value"] : value(t))
          options["min"] = format_datetime(t, DatetimeField.parse_datetime(options["min"]))
          options["max"] = format_datetime(t, DatetimeField.parse_datetime(options["max"]))
          @options = options
          super_render(t)
        end

        # private
        def datetime_value(t, value) = (value in String) ? value : format_datetime(t, value)
        def format_datetime(t, value) = raise(NotImplementedError)

        # Ruby: DateTime.parse(value) rescue nil
        def parse_datetime(value)
          return value unless value in String
          Time.parse(value) rescue nil
        end

        def strftime_of(value, format)
          case value
          in Time then Time.strftime(value, format)
          in Date then Date.strftime(value, format)
          else nil
          end
        end
      end

      class DateField < DatetimeField
        def field_type(t) = "date"
        def format_datetime(t, value) = DatetimeField.strftime_of(value, "%Y-%m-%d")
      end

      class DatetimeLocalField < DatetimeField
        def field_type(t) = "datetime-local"

        def after_initialize(t)
          @include_seconds = Hash.key?(@options, :include_seconds) ? Hash.delete(@options, :include_seconds) : true
          super_after_initialize(t)
        end

        def format_datetime(t, value) = DatetimeField.strftime_of(value, @include_seconds ? "%Y-%m-%dT%T" : "%Y-%m-%dT%H:%M")
      end

      class MonthField < DatetimeField
        def field_type(t) = "month"
        def format_datetime(t, value) = DatetimeField.strftime_of(value, "%Y-%m")
      end

      class TimeField < DatetimeField
        def field_type(t) = "time"

        def after_initialize(t)
          @include_seconds = Hash.key?(@options, :include_seconds) ? Hash.delete(@options, :include_seconds) : true
          super_after_initialize(t)
        end

        def format_datetime(t, value) = DatetimeField.strftime_of(value, @include_seconds ? "%T.%L" : "%H:%M")
      end

      class WeekField < DatetimeField
        def field_type(t) = "week"
        def format_datetime(t, value) = DatetimeField.strftime_of(value, "%Y-W%V")
      end
    end
  end
end
