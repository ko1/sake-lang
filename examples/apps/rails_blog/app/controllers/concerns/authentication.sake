module Authentication
  # private
  def authenticated?(c) = resume_session(c)

  def require_authentication(c)
    resume_session(c) || request_authentication(c)
  end

  def resume_session(c)
    Current.session(Current.instance) || Current.set_session(Current.instance, find_session_by_cookie(c))
  end

  def find_session_by_cookie(c)
    id = ActionDispatch::Cookies::AbstractCookieJar.[](ActionDispatch::Cookies::CookieJar.signed(cookies(c)), :session_id)
    id ? Session.find_by(id: id) : nil
  end

  def request_authentication(c)
    ActionDispatch::Request::Session.[]=(session(c), :return_to_after_authenticating, ActionDispatch::Request.url(request(c)))
    redirect_to c, new_session_path(c)
  end

  def after_authentication_url(c)
    ActionDispatch::Request::Session.delete(session(c), :return_to_after_authenticating) || root_url(c)
  end

  def start_new_session_for(c, user)
    session = Session::ActiveRecord_Associations_CollectionProxy.create!(User.sessions(user), user_agent: ActionDispatch::Request.user_agent(request(c)), ip_address: ActionDispatch::Request.remote_ip(request(c)))
    Current.set_session(Current.instance, session)
    # Ruby: cookies.signed.permanent[:session_id] = ...; this port chains permanent, then signed
    ActionDispatch::Cookies::AbstractCookieJar.[]=(ActionDispatch::Cookies::PermanentCookieJar.signed(ActionDispatch::Cookies::CookieJar.permanent(cookies(c))), :session_id, Hash.of(value: Session.id(session), httponly: true, same_site: :lax))
    session
  end

  def terminate_session(c)
    s = Current.session(Current.instance)
    Session.destroy(s) if s
    ActionDispatch::Cookies::CookieJar.delete(cookies(c), :session_id)
  end
end
