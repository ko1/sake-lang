# The narrowing of a field read ends at a field write, a user function call, a block, or an
# assignment to the variable; a block body does not see it.
Node = Struct.new(:word)
class Node
  def clear(n) = @word = nil
  def after_call(n)
    if @word
      Node.clear(n)
      String.upcase(@word)
    end
  end
  def after_write(n)
    if @word
      @word = nil
      String.upcase(@word)
    end
  end
  def in_block(n)
    if @word
      Array.map(Array[1]) { |_| String.upcase(@word) }
    end
  end
end
def word_or_nil(b) = b ? "abc" : nil
def after_assign(n, m)
  if Node.word(n)
    n = m
    String.upcase(Node.word(n))
  end
end
p Node.after_call(Node.new("abc"))
p Node.after_write(Node.new("abc"))
p Node.in_block(Node.new(word_or_nil(true)))
p after_assign(Node.new("a"), Node.new(nil))
