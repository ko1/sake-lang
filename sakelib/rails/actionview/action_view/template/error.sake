# Port of actionview-8.1.3/lib/action_view/template/error.rb (partial: Template::Error is in template.sake (a class's fields are declared by its first `class`); no WrongEncodingError, no DidYouMean corrections, no source extracts)

module ActionView
  class ActionViewError < StandardError
  end

  class StrictLocalsError < StandardError
  end

  class MissingTemplate < StandardError
    attr_reader path, paths, prefixes, partial

    # Ruby: MissingTemplate.new(paths, path, prefixes, partial, details, *)
    def make(paths, path, prefixes, partial, details)
      path = String.sub(path, /([^\/]+)$/) { |m| "_#{m}" } if partial && String.present?(path)
      template_type = if partial
                        "partial"
                      elsif String.match?(path, /layouts/i)
                        "layout"
                      else
                        "template"
                      end
      searched_paths = Array.map(prefixes) { |prefix| Array.join(String[prefix, path], "/") }
      out = "Missing #{template_type} #{Array.join(searched_paths, ", ")} with #{LookupContext::Details.inspect(details)}.\n\nSearched in:\n"
      out += Array.join(Array.map(paths) { |p| "  * #{Kernel.inspect(p)}\n" })
      MissingTemplate.new(out, path, paths, prefixes, partial)
    end
  end
end
