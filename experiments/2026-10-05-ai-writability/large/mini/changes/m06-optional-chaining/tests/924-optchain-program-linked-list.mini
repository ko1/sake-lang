fn cons(v, rest) return {"value": v, "next": rest} end
let list = cons(1, cons(2, cons(3, nil)))
print(list?.value, list?.next?.value, list?.next?.next?.value, list?.next?.next?.next?.value)
print(list.next.next.next?.next?.value)
fn total(node)
  let sum = 0
  while node != nil do
    sum += node.value
    node = node?.next
  end
  return sum
end
print(total(list), total(nil))
let empty = nil
for x in [list, empty] do
  print(x?.value or "none", x?.next?.value or "none")
end
