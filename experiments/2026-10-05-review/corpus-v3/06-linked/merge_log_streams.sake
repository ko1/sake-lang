LogLine = Struct.new(:time, :host, :level, :text, :next)

class LogLine
  include Comparable
  def <=>(a, b)
    c = @time <=> LogLine.get_time(b)
    c == 0 ? @host <=> LogLine.get_host(b) : c
  end
  def to_s(l) = format("%s %-5s %-5s %s", clock(@time), @host, @level, @text)
end

def clock(secs) = format("%02d:%02d:%02d", secs / 3600, secs / 60 % 60, secs % 60)

def parse_stream(host, text)
  head = nil
  tail = nil
  Array.each(String.lines(text)) do |raw|
    line = String.strip(raw)
    next if String.empty?(line)
    m = String.match(line, /\A(\d+):(\d+):(\d+) (\w+) (.*)\z/)
    next unless m
    secs = String.to_i(m[1]) * 3600 + String.to_i(m[2]) * 60 + String.to_i(m[3])
    node = LogLine.new(secs, host, m[4], m[5], nil)
    if tail
      LogLine.set_next(tail, node)
    else
      head = node
    end
    tail = node
  end
  head
end

def length(list)
  n = 0
  while list
    n += 1
    list = LogLine.get_next(list)
  end
  n
end

def merge(a, b)
  head = nil
  tail = nil
  while a && b
    if a <= b
      node = a
      a = LogLine.get_next(a)
    else
      node = b
      b = LogLine.get_next(b)
    end
    if tail
      LogLine.set_next(tail, node)
    else
      head = node
    end
    tail = node
  end
  rest = a ? a : b
  return rest if tail == nil
  LogLine.set_next(tail, rest)
  head
end

def split_half(list)
  slow = list
  fast = LogLine.get_next(list)
  while fast && LogLine.get_next(fast)
    slow = LogLine.get_next(slow)
    fast = LogLine.get_next(LogLine.get_next(fast))
  end
  second = LogLine.get_next(slow)
  LogLine.set_next(slow, nil)
  second
end

def merge_sort(list)
  return list if list == nil || LogLine.get_next(list) == nil
  second = split_half(list)
  merge(merge_sort(list), merge_sort(second))
end

def merge_all(lists)
  while Array.size(lists) > 1
    paired = Array[]
    Array.each_slice(lists, 2) do |pair|
      Array.push(paired, Array.size(pair) == 2 ? merge(pair[0], pair[1]) : pair[0])
    end
    lists = paired
  end
  lists[0]
end

def each_line(list)
  while list
    yield(list)
    list = LogLine.get_next(list)
  end
end

web = parse_stream("web1", "09:00:01 INFO start\n09:00:05 INFO GET /\n09:01:10 WARN slow request\n09:03:00 ERROR 500 on /cart\n")
db = parse_stream("db", "08:59:59 INFO ready\n09:00:05 INFO query ok\n\n09:02:30 ERROR deadlock\n")
web2 = parse_stream("web2", "09:00:03 INFO start\n09:00:04 INFO GET /login\nbroken line\n09:02:59 WARN retry\n")
batch = parse_stream("batch", "09:05:00 INFO nightly\n09:00:00 INFO queued\n09:04:00 WARN late\n09:01:00 INFO picked\n")

puts("batch has #{length(batch)} lines, out of order; sorting")
batch = merge_sort(batch)
each_line(batch) { |l| puts("  #{l}") }

merged = merge_all(Array[web, db, web2, batch])
puts("merged #{length(merged)} lines:")
counts = Hash.new(0)
first_error = nil
each_line(merged) do |l|
  puts(l)
  counts[LogLine.get_level(l)] += 1
  first_error ||= l if LogLine.get_level(l) == "ERROR"
end
puts(Array.join(Array.map(Array.sort(Hash.keys(counts))) { |k| "#{k}=#{counts[k]}" }, " "))
puts("first error: #{first_error}") if first_error

shuffled = parse_stream("x", "10:00:09 INFO i\n10:00:03 INFO c\n10:00:07 INFO g\n10:00:01 INFO a\n10:00:05 INFO e\n10:00:02 INFO b\n10:00:08 INFO h\n10:00:04 INFO d\n10:00:06 INFO f\n")
sorted = merge_sort(shuffled)
letters = Array[]
each_line(sorted) { |l| Array.push(letters, LogLine.get_text(l)) }
puts(Array.join(letters, ""))
p(merge_sort(nil))
