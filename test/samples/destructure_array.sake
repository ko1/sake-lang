# Multiple assignment and block parameters take an Array apart too, when the lengths match.
key, value = String.split("name=sake", "=")
p([key, value])
Array.each_cons(Array[1, 2, 3, 4], 2) { |a, b| p(b - a) }
Array.each(Array[Array["x", 1], Array["y", 2]]) { |k, v| p([k, v]) }
a, b = String.split("only", "=")
