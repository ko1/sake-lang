class Hash
  def reverse_merge(h, other_hash) = Hash.merge(other_hash, h)
  def with_defaults(h, other_hash) = Hash.merge(other_hash, h)
  def reverse_merge!(h, other_hash) = Hash.replace(h, Hash.merge(other_hash, h))
  def with_defaults!(h, other_hash) = Hash.replace(h, Hash.merge(other_hash, h))
  def reverse_update(h, other_hash) = Hash.replace(h, Hash.merge(other_hash, h))
end
