# Compare judges' rankings of the same contestants by counting inversions
# (Kendall tau distance) with a merge sort.

def merge_count(left, right)
  merged = Array[]
  i = 0
  j = 0
  inv = 0
  while i < Array.size(left) && j < Array.size(right)
    if left[i] <= right[j]
      Array.push(merged, left[i])
      i += 1
    else
      Array.push(merged, right[j])
      inv += Array.size(left) - i
      j += 1
    end
  end
  Array.concat(merged, Array.drop(left, i))
  Array.concat(merged, Array.drop(right, j))
  [merged, inv]
end

def sort_count(a)
  return [Array.dup(a), 0] if Array.size(a) <= 1
  mid = Array.size(a) / 2
  left, li = sort_count(Array.take(a, mid))
  right, ri = sort_count(Array.drop(a, mid))
  merged, mi = merge_count(left, right)
  [merged, li + ri + mi]
end

def brute_inversions(a)
  n = 0
  Array.each_with_index(a) do |x, i|
    Integer.upto(i + 1, Array.size(a) - 1) { |j| n += 1 if x > a[j] }
  end
  n
end

# Turn judge B's order into positions in judge A's order.
def relative_order(a, b)
  pos = Hash[]
  Array.each_with_index(a) { |name, i| pos[name] = i }
  Array.map(b) { |name| Hash.fetch(pos, name) }
end

def kendall_tau(a, b)
  n = Array.size(a)
  _, inv = sort_count(relative_order(a, b))
  pairs = n * (n - 1) / 2
  [inv, 1.0 - 2.0 * inv / pairs]
end

judges = Hash[
  "ito" => Array["kai", "mio", "ren", "sora", "yui", "aoi", "haru", "nana"],
  "kato" => Array["mio", "kai", "ren", "yui", "sora", "aoi", "nana", "haru"],
  "mori" => Array["nana", "haru", "aoi", "yui", "sora", "ren", "mio", "kai"],
  "sato" => Array["kai", "ren", "mio", "sora", "aoi", "yui", "haru", "nana"]
]

names = Hash.keys(judges)
Array.each_with_index(names) do |a, i|
  Array.each(Array.drop(names, i + 1)) do |b|
    inv, tau = kendall_tau(judges[a], judges[b])
    puts(format("%-5s vs %-5s inversions=%2d tau=%+.3f", a, b, inv, tau))
  end
end

nums = Array[8, 4, 2, 1, 7, 3, 9, 5, 6, 0, 11, 10]
sorted, inv = sort_count(nums)
puts("sorted: #{Array.join(sorted, " ")}")
puts("inversions: #{inv} (brute force #{brute_inversions(nums)})")

begin
  relative_order(judges["ito"], Array["kai", "zed"])
rescue KeyError => e
  puts("unknown contestant in list: #{Array.join(Array["kai", "zed"], ",")}")
end

consensus = Hash.new(0)
Hash.each(judges) do |_, order|
  Array.each_with_index(order) { |name, i| consensus[name] += i }
end
board = Hash.sort_by(consensus) { |name, total| [total, name] }
Array.each_with_index(board) do |pair, i|
  name, total = pair
  puts(format("%d. %-5s %2d", i + 1, name, total))
end
