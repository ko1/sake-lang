# Port of actionpack-8.1.3/lib/action_dispatch/http/parameters.rb (partial: one parameter parser (JSON), not a Hash of lambdas)
#
# Rails' DEFAULT_PARSERS is `{ json: ->(raw_post) { ... } }` and an app may set Request.parameter_parsers to its own
# lambdas. A lambda is not a value in Sake, so the parsers are a function with a `case` over the MIME symbol
# (`Parameters.parse_with(symbol, raw_post)`); one that no `in` takes is "no parser", as a missing key in Rails.
#
# A mixin that ActionDispatch::Request includes; params have String keys (Rails' HashWithIndifferentAccess).

require "json"
require "param_builder"

module ActionDispatch
  module Http
    module Parameters
      class ParseError < StandardError
      end

      # Returns both GET and POST parameters in a single hash, with the path parameters.
      def parameters(req)
        params = @_parameters
        return params if params
        params = Hash.merge(Hash.merge(Hash.new, request_parameters(req)), query_parameters(req))
        Hash.each(path_parameters(req)) { |k, v| params[Kernel.to_s(k)] = v }
        @_parameters = params
        params
      end
      def params(req) = parameters(req)

      # Rails: parse_formatted_parameters(parsers) { fallback }; here the fallback is the caller's (nil: none applies).
      def parse_formatted_parameters(req)
        return nil if content_length(req) == 0
        ct = content_mime_type(req)
        return nil unless ct
        sym = Mime::Type.symbol(ct)
        return nil unless sym && Parameters.parser?(sym)
        begin
          Parameters.parse_with(sym, raw_post(req) || "")
        rescue JSON::ParserError
          raise ParseError, "Error occurred while parsing request parameters"
        end
      end

      module_function

      def parameters_key = "action_dispatch.request.path_parameters"

      # DEFAULT_PARSERS
      def parser?(symbol) = symbol == :json
      def parse_with(symbol, raw_post)
        case symbol
        in :json
          data = JSON.parse(raw_post)
          (data in Hash) ? data : Hash.of("_json" => data)
        else Hash.new
        end
      end
    end
  end
end
