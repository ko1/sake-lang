# Port of activemodel-8.1.3/lib/active_model/type/date_time.rb (partial: no ::Date._parse fallback for other formats)

module ActiveModel
  module Type
    class DateTime
      attr_reader precision, scale, limit
      include Value
      include Helpers::Timezone
      include Helpers::AcceptsMultiparameterTime
      include Helpers::TimeValue

      def initialize(t) = nil
      def multiparameter_defaults(t) = Hash.of(4 => 0, 5 => 0)

      def type(t) = :datetime
      def mutable?(t) = true

      def cast_value(t, value)
        return apply_seconds_precision(t, value) unless value in ::String
        return nil if ::String.empty?(value)
        fast_string_to_time(t, value)
      end
    end
  end
end
