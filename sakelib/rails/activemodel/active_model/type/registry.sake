# Port of activemodel-8.1.3/lib/active_model/type/registry.rb and type.rb (one file: the registry and
# ActiveModel::Type's register/lookup/default_value)
#
# Ruby's registry is a Hash of Symbol => block (`klass.new(*args)`), filled by `register(:integer, Type::Integer)`
# at load time. Sake has no stored blocks or class values, so the registrations are the `case` in lookup;
# `lookup(:integer, {limit: 8})` passes Ruby's keyword options as a Record of precision/scale/limit.

module ActiveModel
  module Type
    module_function

    def lookup(symbol, options = {precision: nil, scale: nil, limit: nil})
      options => {precision:, scale:, limit:}
      case symbol
      in :big_integer then BigInteger.new(precision: precision, scale: scale, limit: limit)
      in :binary then Binary.new(precision: precision, scale: scale, limit: limit)
      in :boolean then Boolean.new(precision: precision, scale: scale, limit: limit)
      in :date then Date.new(precision: precision, scale: scale, limit: limit)
      in :datetime then DateTime.new(precision: precision, scale: scale, limit: limit)
      in :decimal then Decimal.new(precision: precision, scale: scale, limit: limit)
      in :float then Float.new(precision: precision, scale: scale, limit: limit)
      in :immutable_string then ImmutableString.new(precision: precision, scale: scale, limit: limit)
      in :integer then Integer.new(precision: precision, scale: scale, limit: limit)
      in :string then String.new(precision: precision, scale: scale, limit: limit)
      in :time then Time.new(precision: precision, scale: scale, limit: limit)
      else raise ArgumentError, "Unknown type #{Kernel.inspect(symbol)}"
      end
    end

    def default_value = once { DefaultValue.new }

    # Sake only: Ruby's a == b for attribute values. A union holding Date makes `a == b` run Date's <=> on a
    # non-Date, which date.sake rejects (experiments/2026-10-20-rails-scale/bugs/arel_p_of_date_or_bigdecimal.sake).
    def same_value?(a, b)
      if a in ::Date
        (b in ::Date) && a == b
      elsif b in ::Date
        false
      else
        a == b
      end
    end
  end
end
