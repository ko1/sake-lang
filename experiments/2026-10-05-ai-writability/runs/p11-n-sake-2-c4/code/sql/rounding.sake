# round(x, n) (2.4): the 17-digit decimal form of x, rounded half away from zero in decimal.
module Rounding
  module_function

  # x is a Float, digits >= 0. Returns a Float.
  def round(x, digits)
    s = format("%.16e", x)
    negative = String.start_with?(s, "-")
    s = Text.slice(s, 1, String.length(s) - 1) if negative
    e = String.index(s, "e") || String.length(s)
    mantissa = String.delete(Text.slice(s, 0, e), ".")
    exponent = String.to_i(Text.slice(s, e + 1, String.length(s) - e - 1))
    keep = exponent + 1 + digits
    return x if keep >= 17
    return 0.0 if keep < 0
    n = keep == 0 ? 0 : String.to_i(Text.slice(mantissa, 0, keep))
    n += 1 if String.to_i(Text.slice(mantissa, keep, 1)) >= 5
    String.to_f("#{negative ? "-" : ""}#{n}e-#{digits}")
  end
end
