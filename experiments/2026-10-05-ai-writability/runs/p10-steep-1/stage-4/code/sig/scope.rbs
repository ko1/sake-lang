module Sql
  class Location
    attr_reader index: Integer
    attr_reader type: column_type?
    attr_reader name: String?

    def initialize: (Integer index, column_type? type, String? name) -> void
    def shifted: (Integer width) -> Location
  end

  class Source
    attr_reader name: String?
    attr_reader names: Array[String?]
    attr_reader types: Array[column_type?]
    attr_reader offset: Integer

    @merged: Array[bool]

    def initialize: (String? name, Array[String?] names, Array[column_type?] types, Integer offset, Array[bool] merged) -> void
    def width: () -> Integer
    def merged?: (Integer position) -> bool
    def position_of: (String column_name) -> Integer?
    def location: (Integer position) -> Location
  end

  class Scope
    attr_reader catalog: Catalog
    attr_reader sources: Array[Source]
    attr_reader parent: Scope?

    def initialize: (Catalog catalog, Array[Source] sources, Scope? parent) -> void
    def width: () -> Integer
    def outer_width: () -> Integer
    def full_width: () -> Integer
    def with_source: (Source source) -> Scope
    def find_first: (String name) -> Location?
    def find_own: (String name) -> Location?
    def find_outer: (String name) -> Location?
    def find_column: (String name) -> Location?
    def find_source: (String name) -> Source?
    def find_qualified: (String qualifier, String name) -> Location?
    def star_columns: (String? qualifier) -> Array[Location]?
  end
end
