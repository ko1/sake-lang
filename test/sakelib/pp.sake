require "pp"

def show(v, width)
  puts("--- width #{width}")
  PP.pp(v, IO.stdout, width)
end

# nested Hash and Array at several widths (Ruby 3.4's `k: v` / `"k" => v` style)
v = Hash[a: 1, "k" => Array[1, 2, 3], nested: Hash[x: Array[1, 2], y: "str"], s: :sym, n: nil, f: 1.5, t: true]
show(v, 79)
show(v, 40)
show(v, 20)
show(v, 1)
show(Array[1, Array[2, Array[3, Array[4, 5]]]], 10)
show(Array[Hash[name: "alice", roles: Array[:admin, :dev]], Hash[name: "bob", roles: Array[]]], 30)
show(Array.new(30) { |i| i }, 40)

# scalars and the containers that fall back to inspect
show(42, 10)
show(-1.5, 10)
show(nil, 10)
show(true, 10)
show(:sym, 10)
show(1..5, 10)
show(Rational(1, 3), 10)
show(Complex(1, 2), 10)
show("plain", 3)
show("日本語", 2)

# empty containers; Tuples print as Arrays; a Record as a Hash of Symbol keys (one line)
show(Array[], 1)
show(Hash[], 1)
show(Set[], 1)
show("", 1)
show([1, "two", :three], 79)
show({x: 1, y: "s"}, 79)
show(Array[[1, 2], [3, 4]], 8)

# Sets break like Arrays
show(Set[1, 2, 3], 79)
show(Set[1, 2, 3], 8)
show(Set["aaaa", "bbbb", Set[1, 2]], 15)

# Strings: several lines are written one per line, joined by +
show("line1\nline2\nline3", 79)
show("line1\nline2\nline3", 10)
show(Array["a\nb", "c"], 79)
show(Array["a\nb", "c"], 5)
show("ends with newline\n", 5)
show("long string " * 5, 20)

# odd Symbol keys are quoted when they must be, operator keys as Ruby writes them
show(Hash[:"foo bar" => 1, :"a=" => 2, :+ => 3, :a? => 4, :a! => 5, :"@x" => 6, :"$g" => 7, :A => 8], 30)
show(Hash[nil => 1, 1.5 => 2, [1, 2] => 3, "s" => 4, true => 5], 25)

# Values of a program's classes are one piece (Kernel.inspect); long Hash values break after the key
S = Struct.new(:x, :y)
show(S.new(1, [1, 2, 3]), 79)
show(Hash[key: Array["a" * 10, "b" * 10], other: S.new(1, 2)], 30)

# output to a String (appended, returned), to IO.stdout (returned)
buf = "pre:"
r = PP.pp(Hash[a: Array[1, 2]], buf, 8)
p(r)
p(r == buf)
p(PP.pp(1, IO.stdout, 79) == IO.stdout)
# default width is 79
PP.pp(Array.new(20) { |i| "item#{i}" }, IO.stdout)
PP.pp(Array.new(20) { |i| "item#{i}" })

# singleline_pp: everything on one line, no newline; pretty_inspect: the String with its newline
p(PP.singleline_pp(Hash[a: Array[1, 2], b: Hash[c: 3]], ""))
PP.singleline_pp(Array[1, 2])
puts("")
p(PP.pretty_inspect(Hash[a: 1]))
p(PP.pretty_inspect(Array.new(12) { |i| i }, 20))
p(PP.pp_to_s(Array[1, 2], 5))   # Ruby: pretty_inspect; pp_to_s is this port's name

# a type's own pretty printing: Ruby's `def pretty_print(q)`, called directly
class Point
  attr_reader x, y

  def pretty_print(pt, q)
    PrettyPrint.group(q, 1, "#<Point", ">") do
      PrettyPrint.breakable(q)
      PrettyPrint.text(q, "x=")
      PrettyPrint.pp(q, @x)
      PrettyPrint.comma_breakable(q)
      PrettyPrint.text(q, "y=")
      PrettyPrint.pp(q, @y)
    end
  end
end
pt = Point.new(Array[1, 2, 3], Hash[k: "v"])
puts(PrettyPrint.format("", 79) { |q| Point.pretty_print(pt, q) })
puts(PrettyPrint.format("", 12) { |q| Point.pretty_print(pt, q) })

# seplist with another separator; comma_breakable; pp_hash on its own
puts(PrettyPrint.format("", 10) { |q| PrettyPrint.seplist(q, Array[1, 2, 3], ";") { |e| PrettyPrint.pp(q, e * 100) } })
puts(PrettyPrint.format("", 15) { |q| PrettyPrint.pp_hash(q, Hash[1 => Array[1, 2], 2 => Array[]]) })

# an error inside the block is raised through format; what was written before it stays
out = ""
begin
  PrettyPrint.format(out, 79) do |q|
    PrettyPrint.text(q, "before")
    raise ArgumentError, "stop"
  end
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
p(out)
