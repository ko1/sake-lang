class Turnstile
  attr_reader state, coins, passes, alarms
  def initialize(t)
    @state = :locked
    @coins = 0
    @passes = 0
    @alarms = 0
  end

  def handle(t, event)
    case @state
    in :locked
      if event == :coin
        @coins += 1
        @state = :unlocked
        "unlock"
      else
        @alarms += 1
        "alarm"
      end
    in :unlocked
      if event == :coin
        @coins += 1
        "thank you"
      else
        @passes += 1
        @state = :locked
        "lock"
      end
    end
  end
end

events = Array[:push, :coin, :push, :coin, :coin, :push, :push, :push, :coin, :push]
t = Turnstile.new
actions = Hash.new(0)
Array.each_with_index(events) do |ev, i|
  before = Turnstile.state(t)
  action = Turnstile.handle(t, ev)
  actions[action] += 1
  puts(format("%2d %-8s %-6s -> %-8s %s", i + 1, before, ev, Turnstile.state(t), action))
end
puts("coins=#{Turnstile.coins(t)} passes=#{Turnstile.passes(t)} alarms=#{Turnstile.alarms(t)}")
sorted = Hash.sort_by(actions) { |a, n| [-n, a] }
Array.each(sorted) { |a, n| puts("  #{a}: #{n}") }
