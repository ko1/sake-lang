require "jwt"

# Deterministic: exp/nbf/iat are fixed instants far in the past (1516239022, 2018) or future
# (4102444800, 2100), never Time.now.

def show_error(e)
  case e
  in JWT::DecodeError then "DecodeError: #{Exception.message(e)}"
  in JWT::EncodeError then "EncodeError: #{Exception.message(e)}"
  in JWT::VerificationError then "VerificationError: #{Exception.message(e)}"
  in JWT::ExpiredSignature then "ExpiredSignature: #{Exception.message(e)}"
  in JWT::ImmatureSignature then "ImmatureSignature: #{Exception.message(e)}"
  in JWT::InvalidIatError then "InvalidIatError: #{Exception.message(e)}"
  in JWT::IncorrectAlgorithm then "IncorrectAlgorithm: #{Exception.message(e)}"
  in JWT::InvalidIssuerError then "InvalidIssuerError: #{Exception.message(e)}"
  in JWT::InvalidAudError then "InvalidAudError: #{Exception.message(e)}"
  in JWT::InvalidSubError then "InvalidSubError: #{Exception.message(e)}"
  in JWT::InvalidJtiError then "InvalidJtiError: #{Exception.message(e)}"
  in JWT::InvalidPayload then "InvalidPayload: #{Exception.message(e)}"
  in JWT::Base64DecodeError then "Base64DecodeError: #{Exception.message(e)}"
  else "other: #{Exception.message(e)}"
  end
end

# 1. encode: the token of jwt.io's example, byte for byte
puts "-- encode"
payload = Hash["sub" => "1234567890", "name" => "John Doe", "iat" => 1516239022]
token = JWT.encode(payload, "your-256-bit-secret", "HS256")
puts token
puts JWT.encode(Hash["a" => 1], "s")
puts JWT.encode(Hash["a" => 1], "s", "HS384")
puts JWT.encode(Hash["a" => 1], "s", "HS512")
puts JWT.encode(Hash["a" => 1], nil, "none")
puts JWT.encode(Hash["a" => 1], "s", "HS256", Hash["kid" => "k1", "typ" => "JWT"])
puts JWT.encode(Hash["a" => 1], "s", "HS256", Hash[kid: "k1"])
puts JWT.encode(Hash[a: 1, b: Array[1, 2], c: nil, d: 1.5, e: "é", f: true], "s", "HS256")
puts JWT.encode(Hash["exp" => 1516239022.5], "s", "HS256")
puts JWT.encode(Hash["a" => 1], "x" * 100, "HS256")      # key longer than the HMAC block: hashed
puts JWT.encode(Hash["a" => 1], "x" * 64, "HS256")       # exactly one block
puts JWT.encode(Hash["a" => 1], "k" * 200, "HS512")
puts JWT.encode(Hash["msg" => "日本語"], "鍵", "HS256")   # UTF-8 payload and key
puts JWT.encode(Hash[], "s")
Array.each(Array[Hash["iat" => "x"], Hash["exp" => "x"], Hash["nbf" => Array[1]]]) do |bad|
  begin
    JWT.encode(bad, "s", "HS256")
  rescue => e
    puts show_error(e)
  end
end
Array.each(Array["FOO", "hs256"]) do |alg|
  begin
    JWT.encode(Hash["a" => 1], "s", alg)
  rescue => e
    puts show_error(e)
  end
end
begin
  JWT.encode(Hash["a" => 1], "", "HS256")
rescue => e
  puts show_error(e)
end

# 2. decode
puts "-- decode"
p JWT.decode(token, "your-256-bit-secret", true, algorithm: "HS256")
p JWT.decode(token, "your-256-bit-secret")
p JWT.decode(token, nil, false)
p JWT.decode(token, "wrong", false)
p JWT.decode(JWT.encode(Hash["a" => 1], "s", "HS512"), "s", true, algorithm: "HS512")
p JWT.decode(JWT.encode(Hash["a" => 1], "s", "HS384"), "s", true, algorithms: Array["HS256", "HS384"])
p JWT.decode(JWT.encode(Hash["a" => 1], "s", "HS256", Hash["kid" => "k1"]), "s")
p JWT.decode(JWT.encode(Hash[a: 1, b: Array[1, 2], c: nil, d: 1.5, e: "é"], "s", "HS256"), "s")
p JWT.decode(JWT.encode(Hash["exp" => 1516239022.5], "s"), "s", false)
p JWT.decode(JWT.encode(Hash["msg" => "日本語"], "鍵", "HS256"), "鍵")
# errors
Array.each(Array[
  [token, "wrong", true],
  [token, nil, true],
  [token, "", true],
  [token + "x", "your-256-bit-secret", true],
  ["abc", "s", true],
  ["a.b.c", "s", true],
  ["", "s", true],
  ["eyJhbGciOiJIUzI1NiJ9.e30.x", "s", true],
  ["eyJhbGciOiJIUzI1NiJ9.!!!.x", "s", true],
  ["eyJhbGciOiJIUzI1NiJ9.eyJhIjoxfQ", "s", true],
  ["eyJhbGciOiJIUzI1NiJ9.eyJhIjoxfQ", "s", false],
  ["eyJhbGciOiJIUzI1NiJ9.eyJhIjoxfQ.YWJj", "s", true],
  ["eyJhbGciOiJGT08ifQ.eyJhIjoxfQ.YWJj", "s", true],
  ["eyJhbGciOiJIUzI1NiJ9.eyJleHAiOiJ4In0.sig", "s", false]
]) do |tok, key, verify|
  begin
    p JWT.decode(tok, key, verify)
  rescue => e
    puts show_error(e)
  end
end
# none is rejected unless asked for
none = JWT.encode(Hash["a" => 1], nil, "none")
begin
  JWT.decode(none, nil)
rescue => e
  puts show_error(e)
end
begin
  JWT.decode(none, nil, true, algorithm: "none")
rescue => e
  puts show_error(e)
end
p JWT.decode(none, nil, false)
begin
  JWT.decode(token, "your-256-bit-secret", true, algorithm: "HS512")
rescue => e
  puts show_error(e)
end
begin
  JWT.decode(token, "your-256-bit-secret", true, algorithm: "FOO")
rescue => e
  puts show_error(e)
end

# 3. claims
puts "-- claims"
past = 1516239022
future = 4102444800
expired = JWT.encode(Hash["exp" => past], "s")
begin
  JWT.decode(expired, "s")
rescue => e
  puts show_error(e)
end
p JWT.decode(expired, "s", true, verify_expiration: false)
p JWT.decode(expired, "s", true, leeway: 10 ** 10)
p JWT.decode(expired, "s", true, exp_leeway: 10 ** 10)
p JWT.decode(JWT.encode(Hash["exp" => future], "s"), "s")
begin
  JWT.decode(JWT.encode(Hash["exp" => future], "s"), "s", true, leeway: -(10 ** 10))
rescue => e
  puts show_error(e)
end
immature = JWT.encode(Hash["nbf" => future], "s")
begin
  JWT.decode(immature, "s")
rescue => e
  puts show_error(e)
end
p JWT.decode(immature, "s", true, verify_not_before: false)
p JWT.decode(immature, "s", true, nbf_leeway: 10 ** 10)
p JWT.decode(JWT.encode(Hash["nbf" => past], "s"), "s")
p JWT.decode(JWT.encode(Hash["iat" => future], "s"), "s")      # iat is not checked by default
begin
  JWT.decode(JWT.encode(Hash["iat" => future], "s"), "s", true, verify_iat: true)
rescue => e
  puts show_error(e)
end
p JWT.decode(JWT.encode(Hash["iat" => past], "s"), "s", true, verify_iat: true)
begin
  JWT.decode("eyJhbGciOiJIUzI1NiJ9.eyJleHAiOiJ4In0.sig", "s", false)
rescue => e
  puts show_error(e)
end
# a payload with a non-numeric exp, signed by hand: InvalidPayload at decode
header = "eyJhbGciOiJIUzI1NiJ9"
body = JWT.base64url_encode("{\"exp\":\"x\"}")
sig = JWT.base64url_encode(JWT.hmac_sha256("s", header + "." + body))
begin
  JWT.decode(header + "." + body + "." + sig, "s")
rescue => e
  puts show_error(e)
end
# iss / aud / sub / jti
iss = JWT.encode(Hash["iss" => "me"], "s")
p JWT.decode(iss, "s", true, iss: "me", verify_iss: true)
p JWT.decode(iss, "s", true, iss: Array["you", "me"], verify_iss: true)
p JWT.decode(iss, "s", true, iss: "you")                          # not verified unless asked
begin
  JWT.decode(iss, "s", true, iss: "you", verify_iss: true)
rescue => e
  puts show_error(e)
end
begin
  JWT.decode(JWT.encode(Hash["a" => 1], "s"), "s", true, iss: "you", verify_iss: true)
rescue => e
  puts show_error(e)
end
aud = JWT.encode(Hash["aud" => "a"], "s")
p JWT.decode(aud, "s", true, aud: "a", verify_aud: true)
begin
  JWT.decode(aud, "s", true, aud: "b", verify_aud: true)
rescue => e
  puts show_error(e)
end
p JWT.decode(JWT.encode(Hash["aud" => Array["a", "b"]], "s"), "s", true, aud: "b", verify_aud: true)
p JWT.decode(aud, "s", true, aud: Array["a", "c"], verify_aud: true)
begin
  JWT.decode(JWT.encode(Hash["x" => 1], "s"), "s", true, aud: "b", verify_aud: true)
rescue => e
  puts show_error(e)
end
sub = JWT.encode(Hash["sub" => "a"], "s")
p JWT.decode(sub, "s", true, sub: "a", verify_sub: true)
begin
  JWT.decode(sub, "s", true, sub: "b", verify_sub: true)
rescue => e
  puts show_error(e)
end
p JWT.decode(JWT.encode(Hash["jti" => "id1"], "s"), "s", true, verify_jti: true)
Array.each(Array[Hash["jti" => ""], Hash["x" => 1]]) do |pl|
  begin
    JWT.decode(JWT.encode(pl, "s"), "s", true, verify_jti: true)
  rescue => e
    puts show_error(e)
  end
end
# claims are not checked without verify
p JWT.decode(expired, "s", false)
p JWT.decode(immature, nil, false)

# 4. the pieces: HMAC (RFC 4231 test case 2) and Base64url
puts "-- hmac"
puts Digest.hexencode(JWT.hmac_sha256("Jefe", "what do ya want for nothing?"))
puts Digest.hexencode(JWT.hmac_sha384("Jefe", "what do ya want for nothing?"))
puts Digest.hexencode(JWT.hmac_sha512("Jefe", "what do ya want for nothing?"))
puts Digest.hexencode(JWT.hmac_sha256("k" * 100, "msg"))
puts JWT.base64url_encode("\xFB\xFF\xBF")
p JWT.base64url_decode("-_-_")
p JWT.base64url_decode("YQ")
p JWT.base64url_decode("")
begin
  JWT.base64url_decode("Y")
rescue => e
  puts show_error(e)
end
begin
  JWT.base64url_decode("!!!!")
rescue => e
  puts show_error(e)
end
