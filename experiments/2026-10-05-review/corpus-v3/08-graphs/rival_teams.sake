def other(side) = side == :left ? :right : :left

def build(pairs)
  adj = Hash[]
  Array.each(pairs) do |a, b|
    adj[a] ||= Array[]
    adj[b] ||= Array[]
    Array.push(adj[a], b)
    Array.push(adj[b], a)
  end
  adj
end

def ancestors(parent, x)
  path = Array[x]
  while (up = parent[x])
    Array.push(path, up)
    x = up
  end
  path
end

# Walk back from both endpoints of a conflicting edge to their common ancestor.
def odd_cycle(parent, a, b)
  path_a = ancestors(parent, a)
  path_b = ancestors(parent, b)
  common = Array.find(path_a) { |x| Array.include?(path_b, x) }
  left = Array.take_while(path_a) { |x| x != common }
  right = Array.take_while(path_b) { |x| x != common }
  left + Array[common] + Array.reverse(right)
end

def split_teams(adj)
  side = Hash[]
  parent = Hash[]
  Array.each(Array.sort(Hash.keys(adj))) do |root|
    next if Hash.key?(side, root)
    side[root] = :left
    queue = Array[root]
    until Array.empty?(queue)
      cur = Array.shift(queue)
      Array.each(adj[cur]) do |nb|
        if Hash.key?(side, nb)
          if side[nb] == side[cur]
            return {ok: false, cycle: odd_cycle(parent, cur, nb), side: side}
          end
        else
          side[nb] = other(side[cur])
          parent[nb] = cur
          Array.push(queue, nb)
        end
      end
    end
  end
  {ok: true, cycle: Array[], side: side}
end

def show(title, pairs)
  puts("== #{title}: #{Array.size(pairs)} rivalries")
  adj = build(pairs)
  result = split_teams(adj)
  result => {ok:, side:, cycle:}
  if ok
    left, right = Array.partition(Array.sort(Hash.keys(side))) { |k| side[k] == :left }
    puts("  team A: #{Array.join(left, " ")}")
    puts("  team B: #{Array.join(right, " ")}")
    puts("  imbalance: #{Integer.abs(Array.size(left) - Array.size(right))}")
  else
    puts("  impossible, odd cycle of #{Array.size(cycle)}: #{Array.join(cycle, " -> ")}")
  end
end

show("office", Array[
  ["ann", "bo"], ["bo", "cy"], ["cy", "dee"], ["dee", "ann"],
  ["eve", "fay"], ["fay", "gus"], ["ann", "hal"]
])
show("triangle", Array[["x", "y"], ["y", "z"], ["z", "x"]])
show("league", Array[
  ["lions", "tigers"], ["tigers", "bears"], ["bears", "wolves"], ["wolves", "hawks"],
  ["hawks", "eagles"], ["eagles", "lions"], ["owls", "lions"], ["bears", "owls"]
])
show("pentagon", Array[["p1", "p2"], ["p2", "p3"], ["p3", "p4"], ["p4", "p5"], ["p5", "p1"]])
