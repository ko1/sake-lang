# Generated source is joined like a required file, and required files are read first, so a generator that
# reopens a class (`class Post ... end`) makes its own `class Post` the first one, and the program's
# `class Post` with fields is then rejected ("the fields of Post are declared in its first `class Post`").
#   bin/sake --strict activesupport_b_generated_before_own_classes.sake
# Ruby: a class body may be reopened anywhere. Workaround: generated code uses only `def Post.f(...)`, which
# does not declare the class (sakelib/rails/activesupport/active_support/generate/*.sake), and the app writes
# `include ActiveSupport::Callbacks` in its own class. Not necessarily a bug, but worth a sentence in the spec
# next to `generate` ("reopen a class only with `def C.f`").
generate "activesupport_b_generated_before_own_classes_gen"

class Post
  attr_reader title
end

p(Post.shout(Post.new("hi")))
