# BLOB values (7.1). A BLOB is held as the uppercase hex of its bytes, two digits per byte: two BLOBs
# are equal exactly when their hex is, and comparing the hex byte by byte is comparing the bytes
# (digits and A-F are in numeric order in ASCII; a prefix sorts first).
Blob = Struct.new(:hex)

module BlobFn
  module_function

  # The BLOB of the bytes of a text.
  def of_text(s) = Blob.new(hex_of_bytes(String.bytes(s)))

  def hex_of_bytes(bytes) = Array.join(Array.map(bytes) { |b| format("%02X", b) }, "")

  # The uppercase hex of the bytes of a text (hex(), 7.10).
  def hex_of_text(s) = hex_of_bytes(String.bytes(s))

  # `X` hex-digits `'` as written (the quotes and X removed): the BLOB, or nil if the digits are
  # odd in number or not all hexadecimal (7.1).
  def parse(digits)
    return nil if String.size(digits) % 2 != 0
    ok = Array.all?(String.bytes(digits)) { |c| NumText.digit?(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) }
    ok ? Blob.new(String.upcase(digits)) : nil
  end

  def size(b) = String.size(Blob.hex(b)) / 2

  # The bytes of a BLOB, as Integers.
  def bytes(b)
    h = Blob.hex(b)
    out = Integer[]
    i = 0
    while i < String.size(h)
      Array.push(out, String.hex(Text.byteslice(h, i, 2)))
      i += 2
    end
    out
  end

  # The text form (7.1): the bytes read as characters.
  def text(b) = String.force_encoding(Array.pack(bytes(b), "C*"), "UTF-8")

  # The bytes [p, p + q) of a BLOB; p and q are counted in bytes.
  def slice(b, p, q) = Blob.new(Text.byteslice(Blob.hex(b), 2 * p, 2 * q))

  # 1-based byte position of the first occurrence of `part` in `b`, or 0.
  def instr(b, part)
    h = Blob.hex(b)
    pos = 0
    loop do
      i = String.index(h, Blob.hex(part), pos)
      return 0 if i == nil
      return i / 2 + 1 if i % 2 == 0
      pos = i + 1
    end
  end
end
