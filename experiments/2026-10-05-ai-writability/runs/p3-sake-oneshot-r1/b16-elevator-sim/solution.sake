def digits?(s) = String.match?(s, /\A\d+\z/)

def tokens(line) = String.split(String.strip(line), /\s+/)

def all_digits?(toks) = Array.all?(toks) { |x| digits?(x) }

def valid_header?(h)
  return false unless Array.size(h) == 3
  return false unless all_digits?(h)
  n = String.to_i(h[0])
  d = String.to_i(h[1])
  c = String.to_i(h[2])
  n >= 2 && n <= 50 && d >= 0 && d <= 5 && c >= 1 && c <= 20
end

def simulate(d, c, pt, pf, pg)
  np = Array.size(pt)
  state = Array.new(np, 0)
  pick = Array.new(np, 0)
  drop = Array.new(np, 0)
  t = 0
  f = 1
  dir = 0
  dropped = 0
  last_drop = 0
  while dropped < np
    i = 0
    while i < np
      state[i] = 1 if state[i] == 0 && pt[i] <= t
      i += 1
    end

    acted = false
    i = 0
    while i < np
      if state[i] == 2 && pg[i] == f
        state[i] = 3
        drop[i] = t
        dropped += 1
        last_drop = t
        acted = true
        puts("t=#{t} floor #{f} drop P#{i + 1}")
      end
      i += 1
    end

    above = false
    below = false
    best = 0
    bestd = 0
    i = 0
    while i < np
      tg = 0
      if state[i] == 1
        tg = pf[i]
      elsif state[i] == 2
        tg = pg[i]
      end
      if tg > 0
        above = true if tg > f
        below = true if tg < f
        dist = Integer.abs(tg - f)
        if best == 0 || dist < bestd || (dist == bestd && tg < best)
          best = tg
          bestd = dist
        end
      end
      i += 1
    end

    if dir == 1
      dir = above ? 1 : (below ? -1 : 0)
    elsif dir == -1
      dir = below ? -1 : (above ? 1 : 0)
    end
    if dir == 0 && best > 0
      if best > f
        dir = 1
      elsif best < f
        dir = -1
      else
        i = 0
        while i < np
          if state[i] == 1 && pf[i] == f
            dir = pg[i] > f ? 1 : -1
            break
          end
          i += 1
        end
      end
    end

    riders = 0
    i = 0
    while i < np
      riders += 1 if state[i] == 2
      i += 1
    end
    i = 0
    while i < np
      if state[i] == 1 && pf[i] == f && riders < c
        pdir = pg[i] > f ? 1 : -1
        if pdir == dir
          state[i] = 2
          pick[i] = t
          riders += 1
          acted = true
          puts("t=#{t} floor #{f} pick P#{i + 1}")
        end
      end
      i += 1
    end

    if acted
      t += d
    else
      f += dir
      t += 1
    end
  end

  sw = 0
  sr = 0
  i = 0
  while i < np
    w = pick[i] - pt[i]
    r = drop[i] - pick[i]
    sw += w
    sr += r
    puts("P#{i + 1} wait #{w} ride #{r}")
    i += 1
  end
  puts(format("average wait %.2f ride %.2f", Integer.to_f(sw) / np, Integer.to_f(sr) / np))
  puts("done at t=#{last_drop}")
end

def main
  lines = IO.readlines(IO.stdin)
  first = Array.empty?(lines) ? "" : lines[0]
  h = tokens(first)
  unless valid_header?(h)
    puts("invalid header")
    return
  end
  n = String.to_i(h[0])
  d = String.to_i(h[1])
  c = String.to_i(h[2])
  pt = Array[]
  pf = Array[]
  pg = Array[]
  last = 0
  k = 1
  while k < Array.size(lines)
    ln = k + 1
    toks = tokens(lines[k])
    k += 1
    next if Array.empty?(toks)
    ok = Array.size(toks) == 3 && all_digits?(toks)
    if ok
      tt = String.to_i(toks[0])
      ff = String.to_i(toks[1])
      gg = String.to_i(toks[2])
      ok = ff >= 1 && ff <= n && gg >= 1 && gg <= n && ff != gg && tt <= 1000 && tt >= last
      if ok
        Array.push(pt, tt)
        Array.push(pf, ff)
        Array.push(pg, gg)
        last = tt
      end
    end
    puts("line #{ln}: invalid request") unless ok
  end
  if Array.empty?(pt)
    puts("no passengers")
    return
  end
  simulate(d, c, pt, pf, pg)
end

main()
