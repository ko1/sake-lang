# Converting values to text (SPEC section 8.1).

# The text `print`, `join` and interpolation use.
def str_of(v) = (v in String) ? v : repr(v, 0)

# A value as written in Mini source. `level` is the nesting level of `v`;
# a value at level 101 is written as `...`.
def repr(v, level)
  return "..." if level > max_compare_level
  case v
  in Integer then Integer.to_s(v)
  in String then quote(v)
  in true then "true"
  in false then "false"
  in nil then "nil"
  in Array then "[" + Array.join(Array.map(v) { |x| repr(x, level + 1) }, ", ") + "]"
  in Hash
    entries = Hash.map(v) { |k, x| repr(k, level + 1) + ": " + repr(x, level + 1) }
    "{" + Array.join(entries, ", ") + "}"
  in Closure
    name = FnExpr.name(Closure.fn(v))
    name ? "<fn #{name}>" : "<fn>"
  in Builtin then "<builtin #{Builtin.name(v)}>"
  end
end

def quote(s)
  chars = Array.map(String.chars(s)) do |c|
    case c
    in "\\" then "\\\\"
    in "\"" then "\\\""
    in "{" then "\\{"
    in "\n" then "\\n"
    in "\t" then "\\t"
    else c
    end
  end
  "\"" + Array.join(chars) + "\""
end
