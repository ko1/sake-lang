require "rails/actionpack/action_dispatch/middleware/stack"
require "rails/actionpack/action_controller/base"

# A controller behind the cookie, session and flash middleware: redirect_to with notice:/alert:/flash:, the flash
# on the next request, flash.now, the alert/notice readers, cookies[:x] = (with options) and delete, the session,
# reset_session.
class NotesController < ActionController::Base
  def create(c) = redirect_to c, "/notes", notice: "Note saved"
  def fail(c) = redirect_to c, "/notes", alert: "Not saved", flash: Hash.of("extra" => "more")
  def index(c)
    f = flash(c)
    render c, plain: "notice=#{Kernel.inspect(notice(c))} alert=#{Kernel.inspect(alert(c))} extra=#{Kernel.inspect(ActionDispatch::Flash::FlashHash.[](f, :extra))} visits=#{session(c)[:visits]}"
  end
  def now(c)
    ActionDispatch::Flash::FlashNow.[]=(ActionDispatch::Flash::FlashHash.now(flash(c)), :info, "just now")
    render c, plain: "info=#{Kernel.inspect(ActionDispatch::Flash::FlashHash.[](flash(c), :info))}"
  end
  def remember(c)
    jar = cookies(c)
    jar[:theme] = "dark"
    jar[:lang] = Hash.of(value: "ja", path: "/notes", httponly: true)
    render c, plain: "remembered"
  end
  def recall(c) = render c, plain: "theme=#{Kernel.inspect(cookies(c)[:theme])} lang=#{Kernel.inspect(cookies(c)[:lang])}"
  def forget(c)
    ActionDispatch::Cookies::CookieJar.delete(cookies(c), :theme)
    render c, plain: "forgotten"
  end
  def logout(c)
    reset_session(c)
    render c, plain: "visits=#{Kernel.inspect(session(c)[:visits])}"
  end

  # private
  def count_visit(c)
    v = session(c)[:visits]
    session(c)[:visits] = ((v in Integer) ? v : 0) + 1
  end
end
generate "rails/actionpack/action_controller/generate/controllers", "controller_flash_cookies_decl.rb", "controller_flash_cookies.sake"

class ActionDispatch::Routing::Mapper
  def notes_routes(map)
    resources map, :notes, only: Any[:index, :create]
    Array.each(String["fail", "now", "remember", "recall", "forget", "logout"]) { |a| get map, "notes/#{a}", to: "notes##{a}" }
  end
end
set = ActionDispatch::Routing::RouteSet.make
ActionDispatch::Routing::RouteSet.draw(set) { |map| ActionDispatch::Routing::Mapper.notes_routes(map) }
set.ActionDispatch::Routing::RouteSet.controllers = ActionController::ControllerSet.new

# Rails.application.env_config, which Rails::Engine#call merges into the env before the stack
def configure(req)
  c = ActionDispatch::Request.env_config(req)
  c["action_dispatch.key_generator"] = ActiveSupport::CachingKeyGenerator.new(ActiveSupport::KeyGenerator.new("b" * 64, iterations: 2))
  c["action_dispatch.signed_cookie_salt"] = "signed cookie"
  c["action_dispatch.cookies_serializer"] = :json
  c["action_dispatch.use_cookies_with_metadata"] = true
end
class Config
  attr_reader app
  include ActionDispatch::App
  def call(c, req)
    configure(req)
    ActionDispatch::App.call(@app, req)
  end
end

stack = ActionDispatch::MiddlewareStack.new
ActionDispatch::MiddlewareStack.use(stack, "ActionDispatch::Cookies")
ActionDispatch::MiddlewareStack.use(stack, "ActionDispatch::Session::CookieStore", Hash.of(key: "_notes_session"))
ActionDispatch::MiddlewareStack.use(stack, "ActionDispatch::Flash")
app = ActionDispatch::RackApp.new(Config.new(ActionDispatch::MiddlewareStack.build(stack, set)))

# The browser's cookies: name => value, updated from each response's set-cookie lines.
def send_request(app, jar, method, path)
  env = Rack::MockRequest.env_for("http://www.example.com#{path}", method: method)
  env["HTTP_COOKIE"] = Array.join(Hash.map(jar) { |k, v| "#{k}=#{v}" }, "; ") if !Hash.empty?(jar)
  status, headers, body = Rack::App.call(app, env)
  out = ""
  Array.each(body) { |s| out += s }
  puts("#{method} #{path} -> #{status} #{Kernel.inspect(headers["location"])} #{Kernel.inspect(out)}")
  h = headers["set-cookie"]
  lines = case h
          in Array then h
          in String then String.split(h, "\n")
          else String[]
          end
  Array.each(lines) do |l|
    name, rest = String.split(Kernel.to_s(l), "=", 2)
    value = String.split(Kernel.to_s(rest), ";", 2)[0] || ""
    name = Kernel.to_s(name)
    puts("  set-cookie: #{l}") if name != "_notes_session"
    if String.include?(Kernel.to_s(l), "max-age=0")
      Hash.delete(jar, name)
    else
      jar[name] = value
    end
  end
end

jar = Hash.new
send_request(app, jar, "GET", "/notes")
send_request(app, jar, "POST", "/notes")
send_request(app, jar, "GET", "/notes")
send_request(app, jar, "GET", "/notes")
send_request(app, jar, "GET", "/notes/fail")
send_request(app, jar, "GET", "/notes")
send_request(app, jar, "GET", "/notes/now")
send_request(app, jar, "GET", "/notes")
send_request(app, jar, "GET", "/notes/remember")
send_request(app, jar, "GET", "/notes/recall")
send_request(app, jar, "GET", "/notes/forget")
send_request(app, jar, "GET", "/notes/recall")
send_request(app, jar, "GET", "/notes/logout")
send_request(app, jar, "GET", "/notes")
