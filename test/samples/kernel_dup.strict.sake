# dup(x): a shallow copy of any value, as Ruby's obj.dup; a type that defines dup gets its own.
class Point
  attr_accessor x, y
end
class Stack
  attr_reader items
  def initialize(s)
    @items = Array[] if @items == nil
  end
  def dup(s) = Stack.new(Array.dup(@items))   # its own dup: copies the Array too
end
a = Point.new(1, 2)
b = dup(a)
b.Point.x = 10
p([a, b])
s = Stack.new
Array.push(s.Stack.items, 1)
t = dup(s)
Array.push(t.Stack.items, 2)
p([Array.size(s.Stack.items), Array.size(t.Stack.items)])
xs = Integer[1, 2]
ys = Kernel.dup(xs)
Array.push(ys, 3)
p([xs, ys])
