# `break` in a block ends the call the block was given to; the call's value is the break's value.
r = Array.each(Array[1, 5, 12, 3]) { |x| break x if x > 10 }
p(r)
p(Array.each(Array[1, 2]) { |x| break if x > 10 })
def first_over(xs, n)
  Array.each(xs) do |x|
    return x if x > n
  end
  nil
end
p(first_over(Array[1, 7], 5))
def each_pair(a, b)
  yield(a)
  yield(b)
  :done
end
p(each_pair(1, 2) { |v| break v * 10 if v == 1 })
p(each_pair(1, 2) { |v| v })
total = 0
Range.each(1..100) do |i|
  break if i > 4
  total += i
end
p(total)
i = 0
while i < 3
  Array.each(Array[1, 2]) { |x| break if x == 2 }
  i += 1
end
p(i)
