<%= ActionView::Helpers::TagHelper::TagBuilder.div(tag(view), flash(view)[:alert], style: "color:red") if flash(view)[:alert] %>
<%= ActionView::Helpers::TagHelper::TagBuilder.div(tag(view), flash(view)[:notice], style: "color:green") if flash(view)[:notice] %>

<%= form_with view, url: session_path(view) do |form| %>
  <%= FormBuilder.email_field form, :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params(view)[:email_address] %><br>
  <%= FormBuilder.password_field form, :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72 %><br>
  <%= FormBuilder.submit form, "Sign in" %>
<% end %>
<br>

