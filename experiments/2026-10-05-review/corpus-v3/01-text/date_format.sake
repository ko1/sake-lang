class DateError < StandardError
  attr_reader input
end

def month_names = String["January", "February", "March", "April", "May", "June", "July",
                         "August", "September", "October", "November", "December"]
def day_names = String["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]

def leap?(y) = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0

def days_in_month(y, m)
  return 29 if m == 2 && leap?(y)
  Integer[31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1]
end

class Date
  attr_reader year, month, day

  def valid?(d) = @month >= 1 && @month <= 12 && @day >= 1 && @day <= days_in_month(@year, @month)

  def weekday(d)
    y = @year
    m = @month
    if m < 3
      m += 12
      y -= 1
    end
    k = y % 100
    j = y / 100
    h = (@day + 13 * (m + 1) / 5 + k + k / 4 + j / 4 + 5 * j) % 7
    (h + 6) % 7
  end

  def day_of_year(d)
    @day + Range.sum(1...@month) { |m| days_in_month(@year, m) }
  end

  def ordinal(n)
    return "th" if n % 100 >= 11 && n % 100 <= 13
    case n % 10
    in 1 then "st"
    in 2 then "nd"
    in 3 then "rd"
    else "th"
    end
  end

  def strftime(d, pattern)
    out = ""
    chars = String.chars(pattern)
    i = 0
    while i < Array.size(chars)
      c = chars[i]
      if c != "%" || i + 1 >= Array.size(chars)
        out += c
        i += 1
        next
      end
      spec = chars[i + 1]
      out += case spec
             in "Y" then Integer.to_s(@year)
             in "y" then format("%02d", @year % 100)
             in "m" then format("%02d", @month)
             in "d" then format("%02d", @day)
             in "e" then String.rjust(Integer.to_s(@day), 2)
             in "B" then month_names[@month - 1]
             in "b" then month_names[@month - 1][0...3]
             in "A" then day_names[weekday(d)]
             in "a" then day_names[weekday(d)][0...3]
             in "j" then format("%03d", day_of_year(d))
             in "o" then "#{@day}#{ordinal(@day)}"
             in "%" then "%"
             else "%" + spec
             end
      i += 2
    end
    out
  end
end

def parse_date(s)
  d = if (m = String.match(s, /\A(\d{4})-(\d{1,2})-(\d{1,2})\z/))
    Date.new(String.to_i(m[1]), String.to_i(m[2]), String.to_i(m[3]))
  elsif (m = String.match(s, /\A(\d{1,2})\/(\d{1,2})\/(\d{4})\z/))
    Date.new(String.to_i(m[3]), String.to_i(m[1]), String.to_i(m[2]))
  elsif (m = String.match(s, /\A(\d{1,2}) ([A-Za-z]{3})[a-z]* (\d{4})\z/))
    idx = Array.index(Array.map(month_names) { |n| String.downcase(n[0...3]) }, String.downcase(m[2]))
    raise DateError.new("unknown month '#{m[2]}'", s) if idx == nil
    Date.new(String.to_i(m[3]), idx + 1, String.to_i(m[1]))
  else
    raise DateError.new("unrecognized date format", s)
  end
  raise DateError.new("no such day", s) unless Date.valid?(d)
  d
end

inputs = Array["2026-10-01", "1969-7-20", "02/29/2024", "02/29/2023", "31 Dec 1999", "4 July 1776",
               "13 Smarch 2020", "2000-13-01", "yesterday", "1 jan 2001"]
patterns = Array["%Y-%m-%d", "%a %e %b %Y", "%A, %B %o, %Y", "day %j of %Y (%y)", "100%% %q"]

dates = Date[]
Array.each(inputs) do |s|
  begin
    d = parse_date(s)
    Array.push(dates, d)
    puts("#{String.ljust(s, 16)} -> #{Date.strftime(d, patterns[0])}  #{Date.strftime(d, patterns[1])}")
  rescue DateError => e
    puts("#{String.ljust(s, 16)} !! #{Exception.message(e)} (#{Kernel.inspect(DateError.get_input(e))})")
  end
end
puts
Array.each(Array.drop(patterns, 2)) do |pat|
  puts("pattern #{Kernel.inspect(pat)}:")
  Array.each(Array.take(dates, 3)) { |d| puts("  " + Date.strftime(d, pat)) }
end
by_day = Array.group_by(dates) { |d| day_names[Date.weekday(d)] }
puts
puts("by weekday: " + Array.join(Array.map(Array.sort_by(Hash.keys(by_day)) { |n| Array.index(day_names, n) }) { |n| "#{n}=#{Array.size(by_day[n])}" }, ", "))
