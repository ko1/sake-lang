# BLOB values (spec 7). `hex` holds the bytes as uppercase hexadecimal, two digits per byte, so
# `==` on Blobs is byte equality and comparing the hex strings orders them bytewise (shorter prefix first).
class Blob
  attr_reader hex
end

module Blobs
  module_function

  # Is `digits` an even-length run of hexadecimal digits (the inside of X'..')?
  def valid_hex?(digits) = String.match?(digits, /\A(?:[0-9A-Fa-f]{2})*\z/)

  def from_hex(digits) = Blob.new(Value.upper(digits))

  # The Blob of the bytes of a TEXT.
  def from_text(s) = Blob.new(Array.join(Array.map(String.bytes(s)) { format("%02X", it) }, ""))

  def size(b) = String.size(Blob.hex(b)) / 2

  # The text form (7.1): the bytes read as characters.
  def text(b) = Array.join(Array.map(String.scan(Blob.hex(b), /../)) { Integer.chr(String.hex(it)) }, "")

  # The printed form (1.3): X'0AFF'.
  def display(b) = "X'#{Blob.hex(b)}'"

  # `count` bytes of `b` from byte `first` (0-based).
  def slice(b, first, count) = Blob.new(count == 0 ? "" : String.slice(Blob.hex(b), 2 * first, 2 * count))

  # The 1-based byte position of the first occurrence of `target` in `b`, or 0.
  def index(b, target)
    hex = Blob.hex(b)
    want = Blob.hex(target)
    n = size(b)
    m = size(target)
    i = 0
    while i + m <= n
      return i + 1 if String.slice(hex, 2 * i, 2 * m) == want
      i += 1
    end
    0
  end
end
