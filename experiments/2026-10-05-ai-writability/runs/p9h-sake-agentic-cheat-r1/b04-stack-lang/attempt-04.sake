Definition = Struct.new(:tokens)
Result = Struct.new(:stack, :success, :error, :depth)

def is_number(token)
  String.match?(token, /^-?[0-9]+$/)
end

def check_syntax(tokens)
  depth = 0
  if_depth = 0

  Array.each(tokens) do |token|
    if token == ":"
      if if_depth > 0 || depth > 0
        return false
      end
      depth += 1

    elsif token == ";"
      if depth <= 0
        return false
      end
      depth -= 1

    elsif token == "if"
      if_depth += 1

    elsif token == "then"
      if if_depth <= 0
        return false
      end
      if_depth -= 1

    elsif token == "else"
      if if_depth <= 0
        return false
      end
    end
  end

  depth <= 0 && if_depth <= 0
end

def subarray(arr, start, len)
  result = Array[]
  i = 0
  while i < len && start + i < Array.size(arr)
    Array.push(result, Array.at(arr, start + i))
    i += 1
  end
  result
end

def run_tokens(line_num, tokens, stack, definitions, call_depth)
  i = 0
  while i < Array.size(tokens)
    token = Array.at(tokens, i)

    if is_number(token)
      num = String.to_i(token)
      Array.push(stack, num)
      i += 1

    elsif token == "+"
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in +", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a + b)
      i += 1

    elsif token == "-"
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in -", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a - b)
      i += 1

    elsif token == "*"
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in *", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a * b)
      i += 1

    elsif token == "/"
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in /", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      if b == 0
        return Result.new(stack, false, "division by zero", call_depth)
      end
      Array.push(stack, Integer.div(a, b))
      i += 1

    elsif token == "mod"
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in mod", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      if b == 0
        return Result.new(stack, false, "division by zero", call_depth)
      end
      Array.push(stack, Integer.modulo(a, b))
      i += 1

    elsif token == "="
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in =", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, (a == b ? 1 : 0))
      i += 1

    elsif token == "<"
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in <", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, (a < b ? 1 : 0))
      i += 1

    elsif token == ">"
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in >", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, (a > b ? 1 : 0))
      i += 1

    elsif token == "dup"
      if Array.size(stack) < 1
        return Result.new(stack, false, "stack underflow in dup", call_depth)
      end
      a = Array.last(stack)
      if a
        Array.push(stack, a)
      end
      i += 1

    elsif token == "drop"
      if Array.size(stack) < 1
        return Result.new(stack, false, "stack underflow in drop", call_depth)
      end
      Array.pop(stack)
      i += 1

    elsif token == "swap"
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in swap", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, b)
      Array.push(stack, a)
      i += 1

    elsif token == "over"
      if Array.size(stack) < 2
        return Result.new(stack, false, "stack underflow in over", call_depth)
      end
      b = Array.pop(stack)
      a = Array.pop(stack)
      Array.push(stack, a)
      Array.push(stack, b)
      Array.push(stack, a)
      i += 1

    elsif token == "."
      if Array.size(stack) < 1
        return Result.new(stack, false, "stack underflow in .", call_depth)
      end
      val = Array.pop(stack)
      puts(val)
      i += 1

    elsif token == "if"
      if Array.size(stack) < 1
        return Result.new(stack, false, "stack underflow in if", call_depth)
      end
      cond = Array.pop(stack)

      depth = 1
      then_idx = nil
      else_idx = nil
      j = i + 1

      while j < Array.size(tokens) && depth > 0
        t = Array.at(tokens, j)
        if t == "if"
          depth += 1
        elsif t == "then"
          depth -= 1
          if depth == 0
            then_idx = j
          end
        elsif t == "else" && depth == 1
          else_idx = j
        end
        j += 1
      end

      if then_idx == nil
        return Result.new(stack, false, "syntax error", call_depth)
      end

      if cond != 0
        if else_idx == nil
          branch_len = then_idx - i - 1
        else
          branch_len = else_idx - i - 1
        end
        branch_tokens = subarray(tokens, i + 1, branch_len)
      else
        if else_idx != nil
          branch_len = then_idx - else_idx - 1
          branch_tokens = subarray(tokens, else_idx + 1, branch_len)
        else
          branch_tokens = Array[]
        end
      end

      result = run_tokens(line_num, branch_tokens, stack, definitions, call_depth)
      stack = Result.stack(result)
      success = Result.success(result)
      call_depth = Result.depth(result)

      if !success
        return result
      end

      i = then_idx + 1

    elsif token == ":"
      j = i + 1
      depth = 1
      semi_idx = nil

      while j < Array.size(tokens) && depth > 0
        if Array.at(tokens, j) == ";"
          depth -= 1
          if depth == 0
            semi_idx = j
          end
        elsif Array.at(tokens, j) == ":"
          depth += 1
        end
        j += 1
      end

      if semi_idx == nil
        return Result.new(stack, false, "syntax error", call_depth)
      end

      name = Array.at(tokens, i + 1)
      def_len = semi_idx - i - 2
      def_tokens = subarray(tokens, i + 2, def_len)
      definitions[name] = Definition.new(def_tokens)

      i = semi_idx + 1

    elsif token == "then" || token == "else" || token == ";"
      i += 1

    else
      if definitions[token] == nil
        return Result.new(stack, false, "unknown word #{token}", call_depth)
      end

      if call_depth >= 100
        return Result.new(stack, false, "too deep", call_depth)
      end

      new_call_depth = call_depth + 1
      def_tokens = Definition.tokens(definitions[token])
      result = run_tokens(line_num, def_tokens, stack, definitions, new_call_depth)

      stack = Result.stack(result)
      success = Result.success(result)
      call_depth = Result.depth(result)

      if !success
        return result
      end

      i += 1
    end
  end

  Result.new(stack, true, nil, call_depth)
end

# Global state
stack = Integer[]
definitions = Hash[]

lines = IO.readlines(IO.stdin)

Array.each_with_index(lines) do |line, idx|
  line_num = idx + 1

  chomp_line = String.chomp(line)
  if String.empty?(chomp_line)
    next
  end

  tokens = String.split(chomp_line, /\s+/)

  if Array.empty?(tokens)
    next
  end

  if !check_syntax(tokens)
    puts("line #{line_num}: syntax error")
    next
  end

  original_stack = Array.dup(stack)

  result = run_tokens(line_num, tokens, stack, definitions, 0)
  stack = Result.stack(result)
  success = Result.success(result)
  error = Result.error(result)

  if !success
    stack = original_stack
    puts("line #{line_num}: error: #{error}")
  end
end

if Array.empty?(stack)
  puts("stack: (empty)")
else
  stack_str = Array.join(stack, " ")
  puts("stack: #{stack_str}")
end
