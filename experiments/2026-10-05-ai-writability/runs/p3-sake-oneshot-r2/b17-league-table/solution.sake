def read_lines
  out = String[]
  l = gets
  while l != nil
    Array.push(out, String.chomp(l))
    l = gets
  end
  out
end

class Team
  attr_reader nm, w, d, l, gf, ga, h2h
  def record(t, f, a)
    @gf += f
    @ga += a
    if f > a
      @w += 1
    elsif f == a
      @d += 1
    else
      @l += 1
    end
    t
  end
  def add_h2h(t, n)
    @h2h += n
    t
  end
  def played(t) = @w + @d + @l
  def pts(t) = @w * 3 + @d
  def gd(t) = @gf - @ga
  def sig(t) = [@w * 3 + @d, @gf - @ga, @gf]
end

def get_team(teams, name)
  t = teams[name]
  if t == nil
    t = Team.new(name, 0, 0, 0, 0, 0, 0)
    teams[name] = t
  end
  t
end

def parse_match(line)
  toks = String.split(line)
  return nil if Array.size(toks) != 3
  h = toks[0]
  sc = toks[1]
  a = toks[2]
  return nil unless String.match?(h, /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/)
  return nil unless String.match?(a, /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/)
  return nil if h == a
  return [h, a, -1, -1] if sc == "P-P"
  m = String.match(sc, /\A([0-9]{1,2})-([0-9]{1,2})\z/)
  return nil if m == nil
  cs = MatchData.captures(m)
  [h, a, String.to_i(cs[0]), String.to_i(cs[1])]
end

def gd_str(g)
  g > 0 ? "+#{g}" : "#{g}"
end

def solve(lines)
  teams = Hash[]
  matches = Tuple[]
  i = 0
  while i < Array.size(lines)
    line = lines[i]
    if String.strip(line) != ""
      r = parse_match(line)
      if r == nil
        puts("invalid line #{i + 1}: #{line}")
      else
        h, a, hg, ag = r
        ht = get_team(teams, h)
        aw = get_team(teams, a)
        if hg >= 0
          Team.record(ht, hg, ag)
          Team.record(aw, ag, hg)
          Array.push(matches, [h, a, hg, ag])
        end
      end
    end
    i += 1
  end

  list = Hash.values(teams)
  if Array.size(list) == 0
    puts("no teams")
    return
  end

  Array.each(matches) do |h, a, hg, ag|
    ht = teams[h]
    aw = teams[a]
    if Team.sig(ht) == Team.sig(aw)
      if hg > ag
        Team.add_h2h(ht, 3)
      elsif hg < ag
        Team.add_h2h(aw, 3)
      else
        Team.add_h2h(ht, 1)
        Team.add_h2h(aw, 1)
      end
    end
  end

  sorted = Array.sort_by(list) { |t| [-Team.pts(t), -Team.gd(t), -Team.gf(t), -Team.h2h(t), Team.nm(t)] }
  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
  pos = 1
  prevkey = [0, 0, 0, 0]
  i = 0
  while i < Array.size(sorted)
    t = sorted[i]
    key = [-Team.pts(t), -Team.gd(t), -Team.gf(t), -Team.h2h(t)]
    pos = i + 1 unless i > 0 && key == prevkey
    prevkey = key
    puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s",
      Integer.to_s(pos), Team.nm(t), Integer.to_s(Team.played(t)), Integer.to_s(Team.w(t)),
      Integer.to_s(Team.d(t)), Integer.to_s(Team.l(t)), Integer.to_s(Team.gf(t)),
      Integer.to_s(Team.ga(t)), gd_str(Team.gd(t)), Integer.to_s(Team.pts(t))))
    i += 1
  end
end

solve(read_lines)
