Booking = Struct.new(:id, :room, :day, :start_min, :end_min, :who)

DAYS = Array["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
DAY_ORDER = Hash["Mon" => 0, "Tue" => 1, "Wed" => 2, "Thu" => 3, "Fri" => 4, "Sat" => 5, "Sun" => 6]

def time_to_minutes(time_str)
  parts = String.split(time_str, ":")
  if Array.size(parts) != 2
    return nil
  end
  hours_s = Array.at(parts, 0)
  mins_s = Array.at(parts, 1)

  hours = String.to_i(hours_s) rescue return nil
  mins = String.to_i(mins_s) rescue return nil

  if hours < 8 || hours > 20 || mins < 0 || mins >= 60 || mins % 15 != 0
    return nil
  end

  # Allow 20:00 but not 20:15 or beyond
  if hours == 20 && mins > 0
    return nil
  end

  hours * 60 + mins
end

def minutes_to_time(mins)
  hours = mins / 60
  mins_part = mins % 60
  format("%02d:%02d", hours, mins_part)
end

def parse_time_range(range_str)
  parts = String.split(range_str, "-")
  if Array.size(parts) != 2
    return nil
  end

  start_str = Array.at(parts, 0)
  end_str = Array.at(parts, 1)

  start = time_to_minutes(start_str)
  if start == nil
    return nil
  end

  end_min = time_to_minutes(end_str)
  if end_min == nil
    return nil
  end

  if start >= end_min
    return nil
  end

  [start, end_min]
end

def valid_room?(room)
  if String.size(room) < 1 || String.size(room) > 8
    return false
  end

  Array.each(String.chars(room)) do |ch|
    case ch
    in "A".."Z" | "0".."9"
      # valid
    else
      return false
    end
  end

  true
end

def valid_day?(day)
  Array.include?(DAYS, day)
end

def valid_name?(name)
  if String.size(name) < 1 || String.size(name) > 12
    return false
  end

  Array.each(String.chars(name)) do |ch|
    if ch >= "a" && ch <= "z"
      # valid
    else
      return false
    end
  end

  true
end

def valid_id?(id_str)
  String.match?(id_str, /^\d+$/)
end

def times_overlap?(start1, end1, start2, end2)
  start1 < end2 && start2 < end1
end

def split_fields(line)
  stripped = String.strip(line)
  parts = Array[]
  current = ""
  in_space = true

  Array.each(String.chars(stripped)) do |ch|
    if ch == " " || ch == "\t"
      if !in_space && current != ""
        Array.push(parts, current)
        current = ""
      end
      in_space = true
    else
      in_space = false
      current = current + ch
    end
  end

  if current != ""
    Array.push(parts, current)
  end

  parts
end

bookings = Hash[]
next_id = 1

lines = IO.readlines(IO.stdin)
Array.each_with_index(lines) do |line, idx|
  line_num = idx + 1

  if String.strip(line) == ""
    next
  end

  fields = split_fields(String.chomp(line))

  if Array.size(fields) == 0
    next
  end

  cmd = Array.at(fields, 0)

  if cmd == "BOOK"
    if Array.size(fields) != 5
      puts("line #{line_num}: error: wrong field count")
      next
    end

    room = Array.at(fields, 1)
    day = Array.at(fields, 2)
    time_range = Array.at(fields, 3)
    who = Array.at(fields, 4)

    if !valid_room?(room)
      puts("line #{line_num}: error: bad room")
      next
    end

    if !valid_day?(day)
      puts("line #{line_num}: error: bad day")
      next
    end

    parsed_time = parse_time_range(time_range)
    if parsed_time == nil
      puts("line #{line_num}: error: bad time")
      next
    end

    start_min, end_min = parsed_time

    if !valid_name?(who)
      puts("line #{line_num}: error: bad name")
      next
    end

    conflict = nil
    Array.each(Hash.values(bookings)) do |booking|
      if Booking.room(booking) == room && Booking.day(booking) == day
        if times_overlap?(Booking.start_min(booking), Booking.end_min(booking), start_min, end_min)
          if conflict == nil || Booking.start_min(booking) < Booking.start_min(conflict)
            conflict = booking
          end
        end
      end
    end

    if conflict
      conflict_start = minutes_to_time(Booking.start_min(conflict))
      conflict_end = minutes_to_time(Booking.end_min(conflict))
      puts("CONFLICT #{room} #{day} with ##{Booking.id(conflict)} (#{Booking.who(conflict)} #{conflict_start}-#{conflict_end})")
      next
    end

    same_day_count = Array.reduce(Hash.values(bookings), 0) do |count, booking|
      if Booking.day(booking) == day && Booking.who(booking) == who
        count + 1
      else
        count
      end
    end

    if same_day_count >= 3
      puts("LIMIT #{who} #{day}")
      next
    end

    booking = Booking.new(next_id, room, day, start_min, end_min, who)
    bookings[next_id] = booking

    start_time = minutes_to_time(start_min)
    end_time = minutes_to_time(end_min)
    puts("OK ##{next_id} #{room} #{day} #{start_time}-#{end_time} #{who}")

    next_id += 1

  elsif cmd == "CANCEL"
    if Array.size(fields) != 2
      puts("line #{line_num}: error: wrong field count")
      next
    end

    id_str = Array.at(fields, 1)

    if !valid_id?(id_str)
      puts("line #{line_num}: error: bad id")
      next
    end

    id = String.to_i(id_str)

    if Hash.has_key?(bookings, id)
      Hash.delete(bookings, id)
      puts("CANCELLED ##{id}")
    else
      puts("NO BOOKING ##{id}")
    end

  elsif cmd == "FREE"
    if Array.size(fields) != 4
      puts("line #{line_num}: error: wrong field count")
      next
    end

    room = Array.at(fields, 1)
    day = Array.at(fields, 2)
    minutes_str = Array.at(fields, 3)

    if !valid_room?(room)
      puts("line #{line_num}: error: bad room")
      next
    end

    if !valid_day?(day)
      puts("line #{line_num}: error: bad day")
      next
    end

    minutes = String.to_i(minutes_str) rescue nil
    if minutes == nil || minutes <= 0 || minutes % 15 != 0
      puts("line #{line_num}: error: bad duration")
      next
    end

    day_bookings = Array[]
    Array.each(Hash.values(bookings)) do |booking|
      if Booking.room(booking) == room && Booking.day(booking) == day
        Array.push(day_bookings, [Booking.start_min(booking), Booking.end_min(booking)])
      end
    end

    sorted_bookings = Array.sort(day_bookings)

    current = 8 * 60
    found = nil

    Array.each(sorted_bookings) do |booking_range|
      start, end_min = booking_range
      if current + minutes <= start
        found = current
        break
      end
      if end_min > current
        current = end_min
      end
    end

    if found == nil && current + minutes <= 20 * 60
      found = current
    end

    if found
      start_time = minutes_to_time(found)
      end_time = minutes_to_time(found + minutes)
      puts("FREE #{room} #{day} #{start_time}-#{end_time}")
    else
      puts("FULL #{room} #{day}")
    end

  else
    puts("line #{line_num}: error: unknown command")
  end
end

puts("== schedule ==")

sorted_bookings = Array.sort_by(Hash.values(bookings)) do |booking|
  day_order = Hash.fetch(DAY_ORDER, Booking.day(booking), 7)
  [day_order, Booking.room(booking), Booking.start_min(booking)]
end

if Array.size(sorted_bookings) == 0
  puts("(none)")
else
  Array.each(sorted_bookings) do |booking|
    start_time = minutes_to_time(Booking.start_min(booking))
    end_time = minutes_to_time(Booking.end_min(booking))
    puts(format("%s %-8s %s-%s #%d %s", Booking.day(booking), Booking.room(booking), start_time, end_time, Booking.id(booking), Booking.who(booking)))
  end
end

puts("== usage ==")

rooms_used = Set[]
Array.each(Hash.values(bookings)) do |booking|
  Set.add(rooms_used, Booking.room(booking))
end

sorted_rooms = Array.sort(Set.to_a(rooms_used))

if Array.size(sorted_rooms) == 0
  puts("(none)")
else
  Array.each(sorted_rooms) do |room|
    total_minutes = 0
    Array.each(Hash.values(bookings)) do |booking|
      if Booking.room(booking) == room
        total_minutes += Booking.end_min(booking) - Booking.start_min(booking)
      end
    end

    hours = total_minutes / 60
    mins = total_minutes % 60
    puts(format("%-8s %dh%02dm", room, hours, mins))
  end
end
