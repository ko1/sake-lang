def money(c) = format("%d.%02d", c / 100, c % 100)

def fee(stay, first, step, cap, grace)
  return 0 if stay <= grace
  d = stay / 1440
  r = stay % 1440
  part = 0
  if r > 0
    extra = r > 60 ? (r - 60 + 29) / 30 : 0
    part = first + step * extra
  end
  d * cap + (part < cap ? part : cap)
end

def main
  lines = IO.readlines(IO.stdin)
  h = String.split(String.strip(lines[0]), /\s+/)
  first = String.to_i(h[1])
  step = String.to_i(h[2])
  cap = String.to_i(h[3])
  grace = String.to_i(h[4])
  inside = Hash[]
  exits = Hash[]
  revenue = Hash[]
  day = 0
  prev = -1
  n = 1
  Array.each(Array.drop(lines, 1)) do |raw|
    n += 1
    line = String.chomp(raw)
    next if String.strip(line) == ""
    md = String.match(line, /\A(\d\d):(\d\d) +(IN|OUT) +([A-Z0-9]{1,8})\z/)
    hh = md == nil ? 99 : String.to_i(md[1])
    mm = md == nil ? 99 : String.to_i(md[2])
    if md == nil || hh > 23 || mm > 59
      puts("line #{n}: invalid")
      next
    end
    tod = hh * 60 + mm
    day += 1 if tod < prev
    prev = tod
    abs = day * 1440 + tod
    kind = md[3]
    plate = md[4]
    if kind == "IN"
      if inside[plate] != nil
        puts("line #{n}: #{plate} already inside")
      else
        inside[plate] = abs
      end
    else
      t0 = inside[plate]
      if t0 == nil
        puts("line #{n}: #{plate} not inside")
      else
        stay = abs - t0
        f = fee(stay, first, step, cap, grace)
        Hash.delete(inside, plate)
        exits[plate] = (exits[plate] == nil ? 0 : exits[plate]) + 1
        revenue[plate] = (revenue[plate] == nil ? 0 : revenue[plate]) + f
        puts("#{plate} #{stay / 60}:#{format("%02d", stay % 60)} #{money(f)}")
      end
    end
  end
  puts("--- summary")
  plates = Array.sort_by(Hash.keys(exits)) { |pl| [-revenue[pl], pl] }
  te = 0
  tr = 0
  Array.each(plates) do |pl|
    puts("#{pl} #{exits[pl]} #{money(revenue[pl])}")
    te += exits[pl]
    tr += revenue[pl]
  end
  puts("total #{te} #{money(tr)}")
  left = Array.sort(Hash.keys(inside))
  puts("inside: #{Array.empty?(left) ? "none" : Array.join(left, ", ")}")
end

main
