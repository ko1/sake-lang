class Request
  attr_reader ip, hour, method, path, status, bytes, ms
end

def log_text
  <<~LOG
    10.0.0.1 - - [12/Mar/2026:09:01:12 +0000] "GET /index.html HTTP/1.1" 200 5120 12ms
    10.0.0.2 - - [12/Mar/2026:09:03:40 +0000] "GET /api/items?page=2 HTTP/1.1" 200 2048 85ms
    10.0.0.3 - - [12/Mar/2026:09:15:02 +0000] "POST /api/login HTTP/1.1" 401 310 40ms
    10.0.0.1 - - [12/Mar/2026:09:47:55 +0000] "GET /api/items HTTP/1.1" 200 4096 92ms
    garbage line without structure
    10.0.0.4 - - [12/Mar/2026:10:02:18 +0000] "GET /static/app.js HTTP/1.1" 304 0 3ms
    10.0.0.2 - - [12/Mar/2026:10:05:31 +0000] "POST /api/orders HTTP/1.1" 201 512 230ms
    10.0.0.5 - - [12/Mar/2026:10:30:09 +0000] "GET /api/items HTTP/1.1" 500 120 1500ms
    10.0.0.3 - - [12/Mar/2026:10:31:44 +0000] "POST /api/login HTTP/1.1" 200 640 55ms
    10.0.0.6 - - [12/Mar/2026:11:12:00 +0000] "GET /missing HTTP/1.1" 404 210 4ms
    10.0.0.1 - - [12/Mar/2026:11:20:16 +0000] "GET /api/items?page=3 HTTP/1.1" 200 1980 77ms
    10.0.0.2 - - [12/Mar/2026:11:22:47 +0000] "DELETE /api/orders/17 HTTP/1.1" 204 0 61ms
    10.0.0.5 - - [12/Mar/2026:11:59:59 +0000] "GET /api/items HTTP/1.1" 503 95 2010ms
    10.0.0.7 - - [12/Mar/2026:12:00:01 +0000] "GET /index.html HTTP/1.1" 200 5120 9ms
    10.0.0.1 - - [12/Mar/2026:12:44:30 +0000] "GET /api/orders/17 HTTP/1.1" 404 180 21ms
  LOG
end

def line_pattern = /\A(\S+) \S+ \S+ \[[^:]+:(\d\d):\d\d:\d\d [^\]]+\] "(\w+) (\S+) [^"]+" (\d{3}) (\d+) (\d+)ms\z/

def parse(text)
  good = Request[]
  bad = 0
  Array.each(String.lines(text)) do |line|
    m = String.match(String.chomp(line), line_pattern)
    if m == nil
      bad += 1
      next
    end
    path = String.sub(m[4], /\?.*\z/, "")
    Array.push(good, Request.new(m[1], String.to_i(m[2]), m[3], path, String.to_i(m[5]), String.to_i(m[6]), String.to_i(m[7])))
  end
  [good, bad]
end

def normalize(path) = String.gsub(path, /\/\d+/, "/:id")

def status_class(code) = "#{code / 100}xx"

def percentile(sorted, pct)
  return nil if Array.empty?(sorted)
  idx = Float.ceil(pct / 100.0 * Array.size(sorted)) - 1
  Array.fetch(sorted, Integer.clamp(idx, 0, Array.size(sorted) - 1))
end

def human_bytes(n)
  if n >= 1024 * 1024 then format("%.1fM", n / 1048576.0)
  elsif n >= 1024 then format("%.1fK", n / 1024.0)
  else "#{n}B"
  end
end

reqs, bad = parse(log_text)
puts("Parsed #{Array.size(reqs)} requests (#{bad} unparseable)")
puts("Total transferred: #{human_bytes(Array.sum(reqs) { Request.get_bytes(it) })}")
puts

puts("By status class:")
classes = Array.tally(Array.map(reqs) { status_class(Request.get_status(it)) })
Array.each(Array.sort(Hash.keys(classes))) do |c|
  n = classes[c]
  puts(format("  %s %3d %5.1f%%", c, n, n * 100.0 / Array.size(reqs)))
end
puts

puts("Requests per hour:")
per_hour = Array.group_by(reqs) { Request.get_hour(it) }
peak = Array.max(Array.map(Hash.values(per_hour)) { Array.size(it) })
Array.each(Range.to_a(9..12)) do |h|
  list = per_hour[h] || Array[]
  bar = "#" * (Array.size(list) * 20 / peak)
  errs = Array.count(list) { Request.get_status(it) >= 500 }
  puts(format("  %02d:00 %-20s %d%s", h, bar, Array.size(list), errs > 0 ? " (#{errs} server errors)" : ""))
end
puts

puts("Endpoints:")
puts(format("  %-6s %-18s %5s %6s %6s %6s", "method", "path", "hits", "err%", "p50", "p95"))
endpoints = Array.group_by(reqs) { |r| [Request.get_method(r), normalize(Request.get_path(r))] }
rows = Hash.map(endpoints) do |(meth, path), list|
  lat = Array.sort(Array.map(list) { Request.get_ms(it) })
  errs = Array.count(list) { Request.get_status(it) >= 400 }
  [meth, path, Array.size(list), errs * 100.0 / Array.size(list), percentile(lat, 50), percentile(lat, 95)]
end
Array.each(Array.sort_by(rows) { |m, p, hits, e, p50, p95| [-hits, p, m] }) do |m, p, hits, e, p50, p95|
  puts(format("  %-6s %-18s %5d %5.1f%% %4dms %4dms", m, p, hits, e, p50, p95))
end
puts

slow = Array.select(reqs) { Request.get_ms(it) >= 1000 }
puts("Slow requests (>= 1s): #{Array.size(slow)}")
Array.each(slow) { |r| puts("  #{Request.get_ip(r)} #{Request.get_method(r)} #{Request.get_path(r)} #{Request.get_status(r)} #{Request.get_ms(r)}ms") }
by_ip = Array.tally(Array.map(reqs) { Request.get_ip(it) })
busiest = Hash.max_by(by_ip) { |ip, n| n }
if busiest
  ip, n = busiest
  puts("Busiest client: #{ip} (#{n} requests)")
end
