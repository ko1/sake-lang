def tenths(r) = Rational.floor(r * 10 + Rational(1, 2))

def fmt1(t) = "#{t / 10}.#{t % 10}"

def grade(t)
  if t >= 900
    "A"
  elsif t >= 800
    "B"
  elsif t >= 700
    "C"
  elsif t >= 600
    "D"
  else
    "F"
  end
end

cats = Array[]
weights = Hash[]
pts = Hash.new(0)
mx = Hash.new(0)
missing = Hash.new(0)
names = Array[]
known = Set[]
errors = Array[]
n = 0
while (raw = gets)
  n += 1
  line = String.strip(raw)
  next if String.empty?(line) || String.start_with?(line, "#")
  f = String.split(line, /\s+/)
  err = nil
  if f[0] == "weight" && Array.size(f) == 3
    c = f[1]
    w = f[2]
    if !String.match?(w, /\A\d+\z/) || String.to_i(w) < 1 || String.to_i(w) > 100
      err = "bad weight #{w}"
    elsif Hash.key?(weights, c)
      err = "duplicate category #{c}"
    else
      weights[c] = String.to_i(w)
      Array.push(cats, c)
    end
  elsif Array.size(f) != 3
    err = "bad format"
  else
    s = f[0]
    c = f[1]
    sc = f[2]
    if !Hash.key?(weights, c)
      err = "unknown category #{c}"
    else
      m = String.match(sc, /\A(\d+|EX|-)\/(\d+)\z/)
      if m
        cap = MatchData.captures(m)
        head = cap[0]
        m0 = String.to_i(cap[1])
        if m0 <= 0
          err = "bad score #{sc}"
        elsif head == "EX" || head == "-"
          nil
        elsif String.to_i(head) > m0
          err = "bad score #{sc}"
        end
        if !err
          if !Set.include?(known, s)
            Set.add(known, s)
            Array.push(names, s)
          end
          if head == "-"
            mx[[s, c]] += m0
            missing[s] += 1
          elsif head != "EX"
            pts[[s, c]] += String.to_i(head)
            mx[[s, c]] += m0
          end
        end
      else
        err = "bad score #{sc}"
      end
    end
  end
  Array.push(errors, "line #{n}: #{err}") if err
end

rows = Array[]
total_pct = 0r
cnt = 0
Array.each(names) do |s|
  num = 0r
  den = 0
  Array.each(cats) do |c|
    if mx[[s, c]] > 0
      w = weights[c]
      num += Rational(w * pts[[s, c]], mx[[s, c]])
      den += w
    end
  end
  if den > 0
    pct = 100 * num / den
    total_pct += pct
    cnt += 1
    Array.push(rows, [s, tenths(pct)])
  else
    Array.push(rows, [s, nil])
  end
end

Array.each(errors) { |e| puts(e) }
width = 7
Array.each(names) { |s| width = String.size(s) if String.size(s) > width }
puts("#{String.ljust("Student", width)}  Score  G  Missing")
with = Array.select(rows) { |r| r[1] != nil }
without = Array.reject(rows) { |r| r[1] != nil }
with = Array.sort_by(with) { |r| [-r[1], r[0]] }
without = Array.sort_by(without) { |r| r[0] }
Array.each(with) do |r|
  puts("#{String.ljust(r[0], width)}  #{String.rjust(fmt1(r[1]), 5)}  #{grade(r[1])}  #{String.rjust(Integer.to_s(missing[r[0]]), 7)}")
end
Array.each(without) do |r|
  puts("#{String.ljust(r[0], width)}  #{String.rjust("n/a", 5)}  -  #{String.rjust(Integer.to_s(missing[r[0]]), 7)}")
end
if cnt > 0
  puts("class average: #{fmt1(tenths(total_pct / cnt))}")
else
  puts("class average: n/a")
end
