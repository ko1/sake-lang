# Port of actionpack-8.1.3/lib/action_controller/metal/head.rb

require "rails/actionpack/abstract_controller/error"

module ActionController
  module Head
    # Returns a response that has no content (merely headers): head(c, :created, location: post_url).
    def head(c, status, **options)
      raise ::AbstractController::DoubleRenderError.build if response_body(c)
      status = :ok if status == nil
      location = Hash.delete(options, :location)
      content_type = Hash.delete(options, :content_type)
      Hash.each(options) do |key, value|
        name = String.split(Kernel.to_s(key), /[-_]/).Array.map { |v| String.upcase(String.slice(v, 0, 1) || "") + (String.slice(v, 1..) || "") }.Array.join("-")
        ActionDispatch::Response.set_header(response(c), name, Kernel.to_s(value))
      end
      set_status(c, status)
      set_location(c, url_for(c, location)) if location
      if Head.include_content?(response_code(c))
        unless media_type(c)
          f = Array.first(formats(c))
          set_content_type(c, content_type ? Kernel.to_s(content_type) : (f ? Mime::Type.to_s(Mime.fetch(f) || Mime.[](:html)) : "text/html"))
        end
        ActionDispatch::Response.set_charset(response(c), false)
      end
      set_response_body(c, "")
      true
    end

    def include_content?(status)
      return false if status >= 100 && status <= 199
      return false if status == 204 || status == 205 || status == 304
      true
    end
    module_function :include_content?
  end
end
