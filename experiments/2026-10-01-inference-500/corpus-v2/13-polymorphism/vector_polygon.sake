class Vec
  attr_reader x, y
  include Arithmetic
  include Comparable

  def +(a, b) = Vec.new(@x + Vec.get_x(b), @y + Vec.get_y(b))
  def -(a, b) = Vec.new(@x - Vec.get_x(b), @y - Vec.get_y(b))
  def *(a, k) = Vec.new(@x * k, @y * k)
  def /(a, k) = Vec.new(@x / k, @y / k)
  def <=>(a, b) = [@x, @y] <=> [Vec.get_x(b), Vec.get_y(b)]

  def dot(a, b) = @x * Vec.get_x(b) + @y * Vec.get_y(b)
  def cross(a, b) = @x * Vec.get_y(b) - @y * Vec.get_x(b)
  def length(a) = Math.sqrt(dot(a, a))
  def to_s(a) = "(#{@x}, #{@y})"
end

def fmt_vec(v) = format("(%.2f, %.2f)", Vec.get_x(v), Vec.get_y(v))

def shoelace(pts)
  sum = 0
  n = Array.size(pts)
  Integer.times(n) do |i|
    sum += Vec.cross(pts[i], pts[(i + 1) % n])
  end
  sum / 2.0
end

def centroid(pts)
  total = Array.reduce(pts, Vec.new(0, 0)) { |acc, p| acc + p }
  total / (Array.size(pts) * 1.0)
end

def turn(o, a, b) = Vec.cross(a - o, b - o)

def convex_hull(points)
  pts = Array.uniq(Array.sort(points))
  return pts if Array.size(pts) < 3
  lower = Array[]
  Array.each(pts) do |p|
    while Array.size(lower) >= 2 && turn(lower[-2], lower[-1], p) <= 0
      Array.pop(lower)
    end
    Array.push(lower, p)
  end
  upper = Array[]
  Array.reverse_each(pts) do |p|
    while Array.size(upper) >= 2 && turn(upper[-2], upper[-1], p) <= 0
      Array.pop(upper)
    end
    Array.push(upper, p)
  end
  Array.pop(lower)
  Array.pop(upper)
  Array.concat(lower, upper)
end

def inside?(poly, q)
  n = Array.size(poly)
  inside = false
  j = n - 1
  Integer.times(n) do |i|
    pi = poly[i]
    pj = poly[j]
    yi = Vec.get_y(pi)
    yj = Vec.get_y(pj)
    if (yi > Vec.get_y(q)) != (yj > Vec.get_y(q))
      xcross = (Vec.get_x(pj) - Vec.get_x(pi)) * (Vec.get_y(q) - yi) / ((yj - yi) * 1.0) + Vec.get_x(pi)
      inside = !inside if Vec.get_x(q) < xcross
    end
    j = i
  end
  inside
end

cloud = Array[
  Vec.new(0, 0), Vec.new(4, 0), Vec.new(4, 3), Vec.new(2, 1), Vec.new(1, 2),
  Vec.new(0, 3), Vec.new(2, 5), Vec.new(3, 2), Vec.new(2, 1), Vec.new(5, 1), Vec.new(1, 4)
]

puts("points: #{Array.size(cloud)}")
puts("sorted: #{Array.join(Array.sort(cloud), " ")}")
puts("min: #{Array.min(cloud)} max: #{Array.max(cloud)}")

hull = convex_hull(cloud)
puts("hull: #{Array.join(hull, " -> ")}")
puts(format("hull area: %.1f", shoelace(hull)))
puts("hull centroid: #{fmt_vec(centroid(hull))}")

perimeter = 0.0
Array.each_with_index(hull) do |p, i|
  q = hull[(i + 1) % Array.size(hull)]
  perimeter += Vec.length(q - p)
end
puts(format("hull perimeter: %.3f", perimeter))

interior = Array.reject(cloud) { |p| Array.include?(hull, p) }
puts("interior: #{Array.join(Array.uniq(interior), " ")}")

probes = Array[Vec.new(2, 2), Vec.new(5, 4), Vec.new(1, 1), Vec.new(6, 0), Vec.new(3, 3)]
Array.each(probes) do |q|
  where = inside?(hull, q) ? "inside" : "outside"
  puts("#{q} is #{where}")
end

far = Array.max_by(cloud) { |p| Vec.length(p - centroid(cloud)) }
puts("farthest from centroid: #{far}")

a = Vec.new(3, 4)
b = Vec.new(-1, 2)
puts("a+b=#{a + b} a-b=#{a - b} a*3=#{a * 3} |a|=#{Vec.length(a)}")
puts("a.b=#{Vec.dot(a, b)} axb=#{Vec.cross(a, b)}")
puts("a<b? #{a < b} a==Vec(3,4)? #{a == Vec.new(3, 4)}")
cos = Vec.dot(a, b) / (Vec.length(a) * Vec.length(b))
puts(format("angle: %.2f deg", Math.atan2(Vec.cross(a, b), Vec.dot(a, b)) * 180 / 3.141592653589793))
puts(format("cos: %.4f", cos))
