# A module function runs with the module's names, also where a type includes the module (as Ruby: M is self).
module M
  def twice(m) = M.limit * 2
  module_function
  def conf = once { Hash.of(:limit => 10) }
  def limit = conf[:limit]
end
class C
  attr_reader conf
  include M
end
p(M.limit)
p(C.twice(C.new(nil)))
