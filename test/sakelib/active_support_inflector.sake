require "active_support_inflector"

# ActiveSupport::Inflector as in Ruby; its output must equal active_support_inflector.rb.
Array.each(String["person", "people", "sheep", "octopus", "octopi", "CamelOctopus", "words", "quiz", "ox", "oxen", "mouse", "matrix", "vertex", "index", "axis", "test", "bus", "buffalo", "tomato", "datum", "medium", "analysis", "wife", "half", "knife", "hive", "query", "box", "church", "wish", "miss", "virus", "status", "alias", "news", "series", "movie", "shoe", "crisis", "thesis", "child", "children", "man", "men", "woman", "sex", "move", "zombie", "equipment", "Information", "fish", "money", "CamelSheep", "database", "databases", "ley", "rice", "jeans", "police", "cactus"]) { |w| puts "#{w}: #{ActiveSupport::Inflector.pluralize(w)} / #{ActiveSupport::Inflector.singularize(w)}" }
Array.each(Array[ActiveSupport::Inflector.pluralize(""), ActiveSupport::Inflector.singularize("ss"), ActiveSupport::Inflector.pluralize("s"), ActiveSupport::Inflector.singularize("s")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.camelize("active_model/errors"), ActiveSupport::Inflector.camelize("active_model", false), ActiveSupport::Inflector.camelize("Active_MODEL"), ActiveSupport::Inflector.camelize("ab1_c"), ActiveSupport::Inflector.camelize("a/b"), ActiveSupport::Inflector.camelize("")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.underscore("ActiveModel::Errors"), ActiveSupport::Inflector.underscore("SSLError"), ActiveSupport::Inflector.underscore("HTML5Parser"), ActiveSupport::Inflector.underscore("already_under"), ActiveSupport::Inflector.underscore("Foo-Bar"), ActiveSupport::Inflector.underscore("ABC"), ActiveSupport::Inflector.underscore("aB"), ActiveSupport::Inflector.underscore("Html5")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.humanize("employee_salary"), ActiveSupport::Inflector.humanize("author_id"), ActiveSupport::Inflector.humanize("author_id", capitalize: false), ActiveSupport::Inflector.humanize("_id"), ActiveSupport::Inflector.humanize("author_id", keep_id_suffix: true), ActiveSupport::Inflector.humanize("  _leading"), ActiveSupport::Inflector.humanize("ABC_def"), ActiveSupport::Inflector.humanize("x__y")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.titleize("man from the boondocks"), ActiveSupport::Inflector.titleize("x-men: the last stand"), ActiveSupport::Inflector.titleize("TheManWithoutAPast"), ActiveSupport::Inflector.titleize("raiders_of_the_lost_ark"), ActiveSupport::Inflector.titleize("string_ending_with_id", keep_id_suffix: true), ActiveSupport::Inflector.titleize("o'neil isn't here (ok)"), ActiveSupport::Inflector.titleize("string_ending_with_id")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.tableize("RawScaledScorer"), ActiveSupport::Inflector.tableize("ham_and_egg"), ActiveSupport::Inflector.tableize("fancyCategory"), ActiveSupport::Inflector.classify("ham_and_eggs"), ActiveSupport::Inflector.classify("posts"), ActiveSupport::Inflector.classify("calculus"), ActiveSupport::Inflector.classify("schema.posts")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.demodulize("ActiveSupport::Inflector::Inflections"), ActiveSupport::Inflector.demodulize("::Inflections"), ActiveSupport::Inflector.demodulize(""), ActiveSupport::Inflector.deconstantize("Net::HTTP"), ActiveSupport::Inflector.deconstantize("::Net::HTTP"), ActiveSupport::Inflector.deconstantize("String"), ActiveSupport::Inflector.deconstantize("::String"), ActiveSupport::Inflector.deconstantize("")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.foreign_key("Message"), ActiveSupport::Inflector.foreign_key("Message", false), ActiveSupport::Inflector.foreign_key("Admin::Post")]) { |x| p x }
p Array.map(Array[1,2,3,4,11,12,13,21,22,23,101,111,1002,1003,-11,-1021,0,1.5,113,100]) { |n| ActiveSupport::Inflector.ordinalize(n) }
Array.each(Array[ActiveSupport::Inflector.parameterize("Donald E. Knuth"), ActiveSupport::Inflector.parameterize("^très|Jolie-- "), ActiveSupport::Inflector.parameterize("Donald E. Knuth", separator: "_"), ActiveSupport::Inflector.parameterize("^très|Jolie__ ", separator: "_"), ActiveSupport::Inflector.parameterize("Donald E. Knuth", preserve_case: true), ActiveSupport::Inflector.parameterize("^très|Jolie__ "), ActiveSupport::Inflector.parameterize("^très_Jolie-- ", separator: "."), ActiveSupport::Inflector.parameterize("a  b", separator: "--"), ActiveSupport::Inflector.parameterize("a b", separator: ""), ActiveSupport::Inflector.parameterize("--x--")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.transliterate("Ærøskøbing"), ActiveSupport::Inflector.transliterate("Jürgen"), ActiveSupport::Inflector.transliterate("日本"), ActiveSupport::Inflector.transliterate("日本", "*"), ActiveSupport::Inflector.transliterate("abc"), ActiveSupport::Inflector.transliterate("ẞ")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.upcase_first("what a Lovely Day"), ActiveSupport::Inflector.downcase_first("If"), ActiveSupport::Inflector.upcase_first("")]) { |x| p x }
Array.each(Array[ActiveSupport::Inflector.dasherize("puni_puni")]) { |x| p x }
puts "== acronym"
ActiveSupport::Inflector.acronym("HTML")
ActiveSupport::Inflector.acronym("RESTful")
