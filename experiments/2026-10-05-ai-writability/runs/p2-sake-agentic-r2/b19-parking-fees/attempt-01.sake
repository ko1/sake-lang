def money(c) = "#{c / 100}.#{format("%02d", c % 100)}"

def part(r, first, step)
  return 0 if r == 0
  return first if r <= 60
  first + step * ((r - 60 + 29) / 30)
end

lines = IO.readlines(IO.stdin)
rate = String.split(lines[0])
first = String.to_i(rate[1])
step = String.to_i(rate[2])
cap = String.to_i(rate[3])
grace = String.to_i(rate[4])

inside = Hash[]
exits = Hash.new(0)
rev = Hash.new(0)
prev = nil
day = 0
tot_n = 0
tot_r = 0

i = 1
while i < Array.size(lines)
  text = String.chomp(lines[i])
  num = i + 1
  i += 1
  next if String.match?(text, /\A *\z/)
  m = String.match(text, /\A(\d\d):(\d\d) +(IN|OUT) +([A-Z0-9]{1,8})\z/)
  hh = 0
  mm = 0
  if m != nil
    c = MatchData.captures(m)
    hh = String.to_i(c[0])
    mm = String.to_i(c[1])
  end
  if m == nil || hh > 23 || mm > 59
    puts("line #{num}: invalid")
    next
  end
  c = MatchData.captures(m)
  tod = hh * 60 + mm
  day += 1 if prev != nil && tod < prev
  prev = tod
  now = day * 1440 + tod
  kind = c[2]
  plate = c[3]
  if kind == "IN"
    if Hash.key?(inside, plate)
      puts("line #{num}: #{plate} already inside")
    else
      inside[plate] = now
    end
  else
    if !Hash.key?(inside, plate)
      puts("line #{num}: #{plate} not inside")
    else
      stay = now - inside[plate]
      Hash.delete(inside, plate)
      fee = 0
      if stay > grace
        d = stay / 1440
        r = stay % 1440
        fee = d * cap + Integer.clamp(part(r, first, step), 0, cap)
      end
      puts("#{plate} #{stay / 60}:#{format("%02d", stay % 60)} #{money(fee)}")
      exits[plate] += 1
      rev[plate] += fee
      tot_n += 1
      tot_r += fee
    end
  end
end

puts("--- summary")
plates = Array.sort_by(Hash.keys(exits)) { |p| [-rev[p], p] }
Array.each(plates) { |p| puts("#{p} #{exits[p]} #{money(rev[p])}") }
puts("total #{tot_n} #{money(tot_r)}")
left = Array.sort(Hash.keys(inside))
puts("inside: #{Array.empty?(left) ? "none" : Array.join(left, ", ")}")
