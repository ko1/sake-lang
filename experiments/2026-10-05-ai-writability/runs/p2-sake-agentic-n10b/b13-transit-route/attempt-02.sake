def states_of(adj, s)
  out = Array[[s, ""]]
  Array.each(adj[s]) { |e| Array.push(out, [s, e[1]]) }
  out
end

def penalty(l, nl, pen) = l != "" && nl != l ? pen : 0

def compute_rem(adj, stations, target, pen)
  rem = Hash[]
  Array.each(states_of(adj, target)) { |st| rem[st] = [0, 0] }
  changed = true
  while changed
    changed = false
    Array.each(stations) do |s|
      Array.each(states_of(adj, s)) do |st|
        l = st[1]
        Array.each(adj[s]) do |e|
          r = rem[[e[0], e[1]]]
          if r
            pn = penalty(l, e[1], pen)
            k = pn > 0 ? 1 : 0
            cand = [e[2] + pn + r[0], k + r[1]]
            cur = rem[st]
            if cur == nil || cand < cur
              rem[st] = cand
              changed = true
            end
          end
        end
      end
    end
  end
  rem
end

# returns [stations, lines] of the best trip
def best_trip(adj, stations, from, to, pen)
  rem = compute_rem(adj, stations, to, pen)
  opt = rem[[from, ""]]
  return nil if opt == nil
  frontier = Hash[]
  frontier[[from, ""]] = [0, 0, String[]]
  seq = String[from]
  cur = from
  while cur != to
    cands = Array[]
    Hash.each(frontier) do |st, v|
      Array.each(adj[st[0]]) do |e|
        pn = penalty(st[1], e[1], pen)
        nk = v[1] + (pn > 0 ? 1 : 0)
        nt = v[0] + e[2] + pn
        r = rem[[e[0], e[1]]]
        if r && nt + r[0] == opt[0] && nk + r[1] == opt[1]
          Array.push(cands, [e[0], e[1], nt, nk, Array.+(v[2], String[e[1]])])
        end
      end
    end
    nxt = Array.min(Array.map(cands) { |c| c[0] })
    nf = Hash[]
    Array.each(cands) do |c|
      next if c[0] != nxt
      key = [c[0], c[1]]
      old = nf[key]
      if old == nil || c[4] < old[2]
        nf[key] = [c[2], c[3], c[4]]
      end
    end
    frontier = nf
    Array.push(seq, nxt)
    cur = nxt
  end
  best = nil
  Hash.each(frontier) do |st, v|
    best = v[2] if best == nil || v[2] < best
  end
  [seq, best, opt]
end

def add_edge(adj, stations, a, b, line, m)
  unless Hash.key?(adj, a)
    adj[a] = Tuple[]
    Array.push(stations, a)
  end
  Array.push(adj[a], [b, line, m])
end

lines = Array.map(String.lines(IO.read(IO.stdin))) { |l| String.chomp(l) }
pen = String.to_i(String.strip(lines[0]))
adj = Hash[]
stations = String[]
out = String[]
inq = false
Array.each_with_index(lines) do |raw, idx|
  next if idx == 0
  n = idx + 1
  line = String.strip(raw)
  next if String.empty?(line)
  f = String.split(line)
  if !inq
    if line == "QUERIES"
      inq = true
      next
    end
    if Array.size(f) != 4 || !String.match?(f[3], /\A[1-9]\d{0,2}\z/) || f[1] == f[2]
      Array.push(out, "invalid segment at line #{n}")
    else
      m = String.to_i(f[3])
      add_edge(adj, stations, f[1], f[2], f[0], m)
      add_edge(adj, stations, f[2], f[1], f[0], m)
    end
  elsif Array.size(f) != 2
    Array.push(out, "invalid query at line #{n}")
  else
    from = f[0]
    to = f[1]
    head = "#{from} -> #{to}: "
    if !Hash.key?(adj, from)
      Array.push(out, head + "unknown station #{from}")
    elsif !Hash.key?(adj, to)
      Array.push(out, head + "unknown station #{to}")
    elsif from == to
      Array.push(out, head + "0 min, 0 transfers")
    else
      trip = best_trip(adj, stations, from, to, pen)
      if trip == nil
        Array.push(out, head + "no route")
      else
        seq = trip[0]
        ls = trip[1]
        opt = trip[2]
        Array.push(out, head + "#{opt[0]} min, #{opt[1]} #{opt[1] == 1 ? "transfer" : "transfers"}")
        legs = String[]
        i = 0
        while i < Array.size(ls)
          j = i
          j += 1 while j + 1 < Array.size(ls) && ls[j + 1] == ls[i]
          Array.push(legs, "#{ls[i]}: " + Array.join(seq[i, j - i + 2], " > "))
          i = j + 1
        end
        Array.push(out, "  " + Array.join(legs, "; "))
      end
    end
  end
end
puts(*out) unless Array.empty?(out)
