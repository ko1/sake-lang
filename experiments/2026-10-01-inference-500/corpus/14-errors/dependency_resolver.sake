# Resolve install order for packages with a DFS topological sort; detect cycles, missing and version conflicts.
CycleError = Exception.new(:path)
MissingPackage = Exception.new(:name, :wanted_by)
VersionConflict = Exception.new(:name, :need, :have)

Package = Struct.new(:name, :version, :deps)

def registry
  pkgs = Hash.new
  Array.each(Any[
    Package.new("app", 3, Any[["web", 2], ["db", 1], ["log", 1]]),
    Package.new("web", 2, Any[["http", 1], ["log", 1]]),
    Package.new("http", 1, Any[["socket", 1]]),
    Package.new("socket", 1, Any[]),
    Package.new("db", 1, Any[["pool", 1], ["log", 1]]),
    Package.new("pool", 1, Any[]),
    Package.new("log", 1, Any[]),
    Package.new("cli", 1, Any[["args", 1], ["log", 2]]),
    Package.new("args", 1, Any[]),
    Package.new("a", 1, Any[["b", 1]]),
    Package.new("b", 1, Any[["c", 1]]),
    Package.new("c", 1, Any[["a", 1]]),
    Package.new("plugin", 1, Any[["web", 1], ["theme", 1]])
  ]) { |pkg| pkgs[Package.name(pkg)] = pkg }
  pkgs
end

def visit(reg, name, min_version, wanted_by, state, order, stack)
  pkg = reg[name]
  raise MissingPackage.new("#{name} not found (wanted by #{wanted_by})", name, wanted_by) if pkg == nil
  if Package.version(pkg) < min_version
    raise VersionConflict.new("#{wanted_by} needs #{name} >= #{min_version}", name, min_version, Package.version(pkg))
  end
  case state[name]
  in :done then return
  in :visiting
    start = Array.index(stack, name)
    raise CycleError.new("dependency cycle", Array.push(Array.drop(stack, start), name))
  in nil then nil
  end
  state[name] = :visiting
  Array.push(stack, name)
  Array.each(Package.deps(pkg)) do |dep, ver|
    visit(reg, dep, ver, name, state, order, stack)
  end
  Array.pop(stack)
  state[name] = :done
  Array.push(order, name)
end

def install_order(reg, root)
  order = Any[]
  visit(reg, root, 1, "user", Hash.new, order, Any[])
  order
end

reg = registry
failures = 0
Array.each(Any["app", "socket", "cli", "a", "plugin", "nosuch"]) do |root|
  begin
    order = install_order(reg, root)
    puts("#{root}: #{Array.join(order, " -> ")}")
  rescue CycleError => e
    failures += 1
    puts("#{root}: #{Exception.message(e)} #{Array.join(CycleError.path(e), " > ")}")
  rescue MissingPackage => e
    failures += 1
    puts("#{root}: missing #{MissingPackage.name(e)}, required by #{MissingPackage.wanted_by(e)}")
  rescue VersionConflict => e
    failures += 1
    puts("#{root}: #{Exception.message(e)}, but #{VersionConflict.have(e)} is available")
  end
end
puts("#{failures} of 6 roots could not be resolved")
