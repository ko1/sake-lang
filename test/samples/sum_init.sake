# `sum(xs, init)`: as Ruby, the start value, and the result for an empty collection.
xs = Array[1.5, 2.5]
p(Array.sum(xs, 0.0))
p(Array.sum(Array[], 0.0))
p(Array.sum(xs, 0.0) { it * 2 })
p(Range.sum(1..3, 0.5))
p(Hash.sum(Hash["a" => 1.5], 0.0) { |kv| kv[1] })
p(Set.sum(Set[1.5], 0.0))
p(Float.round(Array.sum(xs, 0.0)))
