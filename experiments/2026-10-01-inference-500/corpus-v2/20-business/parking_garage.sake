Spot = Struct.new(:id, :level, :size, :plate)
Ticket = Struct.new(:number, :plate, :spot_id, :entered, :charged_kwh)
GarageFull = Exception.new(:plate)
TicketError = Exception.new()

# smaller sizes fit fewer vehicles: a motorcycle fits anywhere, a van only in a large spot
def size_rank(size)
  case size
  in :moto then 0
  in :compact then 1
  in :regular then 2
  in :large then 3
  end
end

def minutes(hhmm)
  h, m = Array.map(String.split(hhmm, ":")) { |x| String.to_i(x) }
  h * 60 + m
end

def fee(mins, kwh, lost)
  return 2500 if lost
  billable = mins <= 30 ? 0 : Integer.ceildiv(mins, 60)
  parking = Array.min(Array[billable * 300, 2000])
  parking + Float.round(kwh * 35.0)
end

class Garage
  attr_reader spots, tickets
  attr_accessor seq
  def build(layout)
    spots = Array[]
    Array.each_with_index(layout) do |row, level|
      Array.each_with_index(String.chars(row)) do |c, i|
        size = Hash.fetch(Hash["m" => :moto, "c" => :compact, "r" => :regular, "L" => :large], c)
        Array.push(spots, Spot.new("#{level}#{String.rjust(Integer.to_s(i + 1), 2, "0")}", level, size, nil))
      end
    end
    Garage.new(spots, Hash[], 100)
  end

  def enter(g, plate, kind, at)
    raise TicketError.new("#{plate} is already inside") if Array.any?(@spots) { |s| Spot.plate(s) == plate }
    fits = Array.select(@spots) { |s| Spot.plate(s) == nil && size_rank(Spot.size(s)) >= size_rank(kind) }
    raise GarageFull.new("no #{kind} spot", plate) if Array.empty?(fits)
    spot = Array.min_by(fits) { |s| [size_rank(Spot.size(s)), Spot.level(s), Array.index(@spots, s)] }
    Spot.set_plate(spot, plate)
    @seq += 1
    t = Ticket.new(@seq, plate, Spot.id(spot), minutes(at), 0.0)
    @tickets[@seq] = t
    t
  end

  def charge(g, number, kwh)
    t = @tickets[number]
    raise TicketError.new("unknown ticket #{number}") unless t
    Ticket.set_charged_kwh(t, Ticket.charged_kwh(t) + kwh)
  end

  def leave(g, number, plate, at)
    t = number ? @tickets[number] : Array.find(Hash.values(@tickets)) { |x| Ticket.plate(x) == plate }
    raise TicketError.new("no car #{plate} inside") unless t
    spot = Array.find(@spots) { |s| Spot.id(s) == Ticket.spot_id(t) }
    Spot.set_plate(spot, nil)
    Hash.delete(@tickets, Ticket.number(t))
    mins = minutes(at) - Ticket.entered(t)
    [mins, fee(mins, Ticket.charged_kwh(t), number == nil)]
  end

  def occupancy(g)
    by_level = Array.group_by(@spots) { |s| Spot.level(s) }
    Hash.map(by_level) { |level, ss| [level, Array.count(ss) { |s| Spot.plate(s) != nil }, Array.size(ss)] }
  end
end

garage = Garage.build(Array["mcrrL", "ccrr"])
tickets = Hash[]
revenue = 0
events = Array[
  ["07:55", :in, "VAN-1", :large], ["08:02", :in, "CAR-1", :regular], ["08:05", :in, "MOTO-1", :moto],
  ["08:10", :in, "CAR-2", :compact], ["08:11", :in, "CAR-3", :regular], ["08:20", :in, "VAN-2", :large],
  ["08:30", :in, "CAR-4", :regular], ["08:31", :in, "CAR-5", :compact], ["08:40", :in, "CAR-6", :compact],
  ["09:00", :charge, "CAR-1", 18.5], ["09:15", :out, "MOTO-1", :ticket], ["09:20", :in, "CAR-6", :compact],
  ["11:47", :out, "CAR-1", :ticket], ["12:00", :out, "CAR-3", :lost], ["13:30", :out, "CAR-9", :lost],
  ["18:40", :out, "VAN-1", :ticket], ["19:05", :out, "CAR-2", :ticket]
]
Array.each(events) do |at, kind, plate, arg|
  begin
    case kind
    in :in
      t = Garage.enter(garage, plate, arg, at)
      tickets[plate] = Ticket.number(t)
      puts("#{at} #{plate} -> spot #{Ticket.spot_id(t)} (ticket #{Ticket.number(t)})")
    in :charge
      Garage.charge(garage, Hash.fetch(tickets, plate), arg)
      puts("#{at} #{plate} charged #{arg} kWh")
    in :out
      number = arg == :lost ? nil : tickets[plate]
      mins, cents = Garage.leave(garage, number, plate, at)
      revenue += cents
      puts(format("%s %s leaves after %dh%02dm, pays $%.2f%s", at, plate, mins / 60, mins % 60, cents / 100.0, number ? "" : " (lost ticket)"))
    end
  rescue GarageFull => e
    puts("#{at} #{GarageFull.plate(e)} turned away: #{Exception.message(e)}")
  rescue TicketError => e
    puts("#{at} error: #{Exception.message(e)}")
  end
end

puts
Array.each(Garage.occupancy(garage)) do |level, used, total|
  puts("Level #{level}: #{used}/#{total} #{"#" * used}#{"." * (total - used)}")
end
puts(format("Revenue: $%.2f", revenue / 100.0))
