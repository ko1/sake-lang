module Sql
  class Engine
    NO_LINES: Array[String]

    @catalog: Catalog
    @saved: Catalog?

    def initialize: () -> void
    def run_script: (String source, IO out) -> void
    def execute: (Ast::Statement statement) -> Array[String]

    private

    def modify: () { () -> void } -> Array[String]
    def execute_ddl: (Ast::Statement statement) -> void
    def transaction: (Symbol kind) -> void
  end
end
