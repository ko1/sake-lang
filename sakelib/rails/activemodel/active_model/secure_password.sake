# Port of activemodel-8.1.3/lib/active_model/secure_password.rb (partial: no reset tokens (generates_token_for is ActiveRecord's))
#
# Ruby's has_secure_password(:password) includes a Module subclass that define_methods password=,
# authenticate_password, password_salt and the confirmation/challenge accessors, and adds three validate
# blocks. Here the class-body line is the generator's (generate/secure_password.sake): it declares the
# accessors as fields and writes those methods for the attribute's name, calling the functions below; the
# validate blocks are generated methods in the :validate chain. BCrypt is sakelib/bcrypt.sake.

require "bcrypt"
require "validations"

module ActiveModel
  module SecurePassword
    include ActiveModel::Validations

    module_function

    def MAX_PASSWORD_LENGTH_ALLOWED = 72

    class Setting
      attr_accessor min_cost
    end
    def setting = once { Setting.new(false) }
    # Ruby's ActiveModel::SecurePassword.min_cost (= true in tests: BCrypt's lowest cost).
    def min_cost = Setting.min_cost(setting)
    def set_min_cost(v) = Setting.set_min_cost(setting, v)

    # The digest Ruby's password= stores (BCrypt::Password.create's String).
    def digest(unencrypted_password)
      cost = min_cost ? BCrypt::Engine.MIN_COST : BCrypt::Engine.cost
      BCrypt::Password.to_s(BCrypt::Password.create(unencrypted_password, cost: cost))
    end

    # Ruby's authenticate_#{attribute}: the record when the password matches the digest, else false.
    def authenticate_digest(record, attribute_digest, unencrypted_password)
      d = Kernel.to_s(attribute_digest)
      String.present?(d) && BCrypt::Password.is_password?(BCrypt::Password.new(d), unencrypted_password) ? record : false
    end

    def digest_salt(attribute_digest)
      d = Kernel.to_s(attribute_digest)
      String.present?(d) ? BCrypt::Password.salt(BCrypt::Password.new(d)) : nil
    end

    # The three validate blocks.
    def validate_digest(errors, attribute, attribute_digest)
      ActiveModel::Errors.add(errors, attribute, :blank) unless Object.present?(attribute_digest)
    end

    def validate_challenge(errors, attribute, challenge, digest_was)
      return nil if challenge == nil
      d = Kernel.to_s(digest_was)
      unless String.present?(d) && BCrypt::Password.is_password?(BCrypt::Password.new(d), Kernel.to_s(challenge))
        ActiveModel::Errors.add(errors, String.to_sym("#{attribute}_challenge"))
      end
    end

    def validate_length(errors, attribute, password_value)
      if (password_value in String) && String.present?(password_value) && String.bytesize(password_value) > SecurePassword.MAX_PASSWORD_LENGTH_ALLOWED
        ActiveModel::Errors.add(errors, attribute, :password_too_long)
      end
    end
  end
end
