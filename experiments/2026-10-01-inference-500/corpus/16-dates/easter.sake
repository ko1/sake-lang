# Easter dates (Gregorian and Orthodox) and the movable feasts derived from them.

Feast = Struct.new(:name, :offset)

def leap?(y) = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0

def month_lengths(y) = Array[31, leap?(y) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

def month_abbr = Array["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

def day_of_year(y, m, d) = Array.sum(Array.take(month_lengths(y), m - 1)) + d

def from_day_of_year(y, n)
  lengths = month_lengths(y)
  m = 0
  while n > lengths[m]
    n -= lengths[m]
    m += 1
  end
  [m + 1, n]
end

# Anonymous Gregorian algorithm (Meeus/Jones/Butcher).
def gregorian_easter(y)
  a = y % 19
  b = y / 100
  c = y % 100
  d = b / 4
  e = b % 4
  f = (b + 8) / 25
  g = (b - f + 1) / 3
  h = (19 * a + b - d - g + 15) % 30
  i = c / 4
  k = c % 4
  l = (32 + 2 * e + 2 * i - h - k) % 7
  m = (a + 11 * h + 22 * l) / 451
  month = (h + l - 7 * m + 114) / 31
  day = (h + l - 7 * m + 114) % 31 + 1
  [month, day]
end

# Meeus's Julian algorithm, shifted to the Gregorian calendar (valid 1900-2099).
def orthodox_easter(y)
  a = y % 4
  b = y % 7
  c = y % 19
  d = (19 * c + 15) % 30
  e = (2 * a + 4 * b - d + 34) % 7
  month = (d + e + 114) / 31
  day = (d + e + 114) % 31 + 1
  n = day_of_year(y, month, day) + 13
  from_day_of_year(y, n)
end

def show(m, d) = format("%s %2d", month_abbr[m - 1], d)

feasts = Feast[
  Feast.new("Ash Wednesday", -46),
  Feast.new("Palm Sunday", -7),
  Feast.new("Good Friday", -2),
  Feast.new("Easter Monday", 1),
  Feast.new("Ascension", 39),
  Feast.new("Pentecost", 49),
  Feast.new("Corpus Christi", 60)
]

puts("Year  Western  Orthodox  Gap")
Range.each(2024..2032) do |y|
  wm, wd = gregorian_easter(y)
  om, od = orthodox_easter(y)
  gap = (day_of_year(y, om, od) - day_of_year(y, wm, wd)) / 7
  puts(format("%d  %s   %s    %dw", y, show(wm, wd), show(om, od), gap))
end

y = 2027
em, ed = gregorian_easter(y)
easter_doy = day_of_year(y, em, ed)
puts
puts("Movable feasts in #{y}:")
Array.each(feasts) do |f|
  m, d = from_day_of_year(y, easter_doy + Feast.offset(f))
  puts(format("  %-15s %s (%+d)", Feast.name(f), show(m, d), Feast.offset(f)))
end

# Statistics over two centuries.
dates = Hash.new(0)
same_day = Array[]
earliest = nil
latest = nil
Range.each(1900..2099) do |yy|
  m, d = gregorian_easter(yy)
  key = m * 100 + d
  dates[key] += 1
  earliest = [yy, key] if earliest == nil || key < earliest[1]
  latest = [yy, key] if latest == nil || key > latest[1]
  om, od = orthodox_easter(yy)
  Array.push(same_day, yy) if om == m && od == d
end
puts
puts("Distinct Easter dates 1900-2099: #{Hash.size(dates)}")
if earliest && latest
  ey, ek = earliest
  ly, lk = latest
  puts("Earliest: #{show(ek / 100, ek % 100)} (#{ey}), latest: #{show(lk / 100, lk % 100)} (#{ly})")
end
top = Array.take(Array.sort_by(Hash.to_a(dates)) { |k, n| (0 - n) * 10000 + k }, 3)
Array.each(top) { |k, n| puts("  #{show(k / 100, k % 100)}: #{n} times") }
puts("Both churches together in #{Array.size(same_day)} years, first few: #{Array.join(Array.take(same_day, 5), ", ")}")
march = Hash.count(dates) { |k, n| k < 400 }
puts("Dates in March: #{march}, in April: #{Hash.size(dates) - march}")
