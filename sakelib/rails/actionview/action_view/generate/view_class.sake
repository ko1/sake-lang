# (Sake only) `generate "rails/actionview/action_view/generate/view_class", "BlogView", "views=app/views", "records=Post,Comment",
# "include=BlogUrlHelpers", "assigns=post,posts"`: prints ActionView::Generate.view_class (see templates.sake)

require "templates"

def arg_list(key)
  a = Array.find(ARGV) { |x| String.start_with?(x, "#{key}=") }
  a ? Array.reject(String.split(String.delete_prefix(a, "#{key}="), ",")) { |x| String.empty?(x) } : String[]
end

name = Array.first(ARGV) || raise(ArgumentError, "the view class's name is the first argument")
views = arg_list("views")
print(ActionView::Generate.view_class(name, Array.empty?(views) ? String["app/views"] : views,
                                      records: arg_list("records"), includes: arg_list("include"), assigns: arg_list("assigns")))
