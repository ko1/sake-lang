# Port of actionpack-8.1.3/lib/action_dispatch/testing/assertion_response.rb
#
# AssertionResponse.new(code_or_name): a Symbol (:success, :not_found) or an Integer code.

require "../http/response"

module ActionDispatch
  class AssertionResponse
    attr_reader code, name

    def generic_response_codes = once { Hash.of(success: "2XX", missing: "404", redirect: "3XX", error: "5XX") }

    def make(code_or_name)
      if code_or_name in Symbol
        name = code_or_name
        code = code_from_name(name)
      else
        code = code_or_name
        name = name_from_code(code)
      end
      raise ArgumentError, "Invalid response name: #{name}" if code == nil
      raise ArgumentError, "Invalid response code: #{code}" if name == nil
      AssertionResponse.new(code, name)
    end

    def code_and_name(a) = "#{@code}: #{@name}"

    def code_from_name(name) = generic_response_codes[name] || Response.rack_status_code(name)

    def name_from_code(code)
      (code in String) ? Hash.key(generic_response_codes, code) : Rack::Utils.http_status_codes[code]
    end
  end
end
