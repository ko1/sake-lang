class Islands
  attr_reader width, height, count = 0
  attr_reader parent = nil, size = nil

  def initialize(m)
    @parent = Hash[]
    @size = Hash[]
  end

  def key(m, x, y) = y * @width + x

  def land?(m, x, y)
    x >= 0 && y >= 0 && x < @width && y < @height && Hash.key?(@parent, key(m, x, y))
  end

  def root(m, k)
    while @parent[k] != k
      @parent[k] = @parent[@parent[k]]
      k = @parent[k]
    end
    k
  end

  def join(m, a, b)
    ra = root(m, a)
    rb = root(m, b)
    return if ra == rb
    ra, rb = rb, ra if @size[ra] < @size[rb]
    @parent[rb] = ra
    @size[ra] += @size[rb]
    Hash.delete(@size, rb)
    @count -= 1
  end

  def raise_land(m, x, y)
    k = key(m, x, y)
    return false if Hash.key?(@parent, k)
    @parent[k] = k
    @size[k] = 1
    @count += 1
    Array.each(Array[[1, 0], [-1, 0], [0, 1], [0, -1]]) do |dx, dy|
      nx = x + dx
      ny = y + dy
      join(m, k, key(m, nx, ny)) if land?(m, nx, ny)
    end
    true
  end

  def largest(m) = Array.max(Hash.values(@size)) || 0

  def draw(m)
    labels = Hash[]
    Integer.times(@height) do |y|
      row = ""
      Integer.times(@width) do |x|
        if land?(m, x, y)
          r = root(m, key(m, x, y))
          labels[r] ||= Integer.chr(97 + Hash.size(labels))
          row += labels[r]
        else
          row += "~"
        end
      end
      puts("  #{row}")
    end
  end
end

def flood_count(m)
  seen = Set[]
  count = 0
  Integer.times(Islands.height(m)) do |y|
    Integer.times(Islands.width(m)) do |x|
      next unless Islands.land?(m, x, y)
      next if Set.include?(seen, [x, y])
      count += 1
      stack = Array[[x, y]]
      Set.add(seen, [x, y])
      until Array.empty?(stack)
        cx, cy = Array.pop(stack)
        Array.each(Array[[cx + 1, cy], [cx - 1, cy], [cx, cy + 1], [cx, cy - 1]]) do |px, py|
          next unless Islands.land?(m, px, py)
          Array.push(stack, [px, py]) if Set.add?(seen, [px, py])
        end
      end
    end
  end
  count
end

volcano = Array[
  [1, 1], [2, 1], [5, 1], [6, 1], [1, 2], [6, 2], [3, 4], [8, 4], [8, 3], [8, 5],
  [2, 2], [4, 4], [4, 3], [5, 2], [4, 2], [3, 2], [0, 6], [9, 0], [2, 1], [7, 4]
]
m = Islands.new(10, 7)
history = Array[]
Array.each_with_index(volcano) do |(x, y), step|
  fresh = Islands.raise_land(m, x, y)
  Array.push(history, Islands.count(m))
  note = fresh ? "" : " (already land)"
  puts(format("%2d: (%d,%d) islands=%d largest=%d%s", step + 1, x, y, Islands.count(m), Islands.largest(m), note))
end
Islands.draw(m)
puts("peak islands: #{Array.max(history)} after step #{Array.index(history, Array.max(history)) + 1}")
drops = 0
Array.each_cons(history, 2) { |a, b| drops += 1 if b < a }
puts("steps that merged islands: #{drops}")
puts("flood fill agrees: #{flood_count(m) == Islands.count(m)}")
