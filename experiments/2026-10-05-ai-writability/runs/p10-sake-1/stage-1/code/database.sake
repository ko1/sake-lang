# The in-memory database: tables, their columns and their rows.

class Column
  attr_reader name, key, type   # name as created; key lower-cased for lookups; type :integer/:real/:text
end

# rows: Array of rows, each an Array of values in column order.
class Table
  attr_reader name, columns, rows

  # Appends rows that have all been validated (so a failing statement leaves the table alone).
  def append_rows(t, new_rows) = Array.concat(@rows, new_rows)
end

# tables: Hash from the lower-cased table name to its Table.
class Database
  attr_reader tables

  # The table called `name` (case-insensitive) or SqlError.
  def table(db, name)
    t = @tables[Value.lower(name)]
    raise SqlError.new("no such table: #{name}") if t == nil
    t
  end

  def table?(db, name) = Hash.key?(@tables, Value.lower(name))

  def add_table(db, table)
    @tables[Value.lower(Table.name(table))] = table
  end

  def remove_table(db, name)
    Hash.delete(@tables, Value.lower(name))
  end
end
