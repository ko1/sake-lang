# The unusual use: the ready-made Heap, LRU and Deque, each used with two element types in
# one program (as one would in Ruby). It runs, but the checker sees one element type per
# container type, the union of both uses. See NOTES.md for the reports.
# Run: bin/sake --strict=0 out/client_shared.sake

ints = Heap.create
Array.each(Array[4, 1, 3]) { |x| Heap.push(ints, x) }
words = Heap.create
Array.each(Array["b", "c", "a"]) { |x| Heap.push(words, x) }

top = Heap.pop(ints)
puts("smallest int + 1 = #{top + 1}") if top
w = Heap.pop(words)
puts("first word: #{String.upcase(w)}") if w

squares = LRU.create(4)
names = LRU.create(4)
LRU.put(squares, 3, 9)
LRU.put(names, :ann, "Ann")
sq = LRU.get(squares, 3)
puts("9 + 1 = #{sq + 1}") if sq
nm = LRU.get(names, :ann)
puts("hello #{String.upcase(nm)}") if nm

fs = Deque.create
ss = Deque.create
Deque.push_back(fs, 1.5)
Deque.push_back(ss, "x")
f = Deque.pop_front(fs)
puts("half = #{f / 2}") if f
s = Deque.pop_front(ss)
puts("s = #{String.upcase(s)}") if s
