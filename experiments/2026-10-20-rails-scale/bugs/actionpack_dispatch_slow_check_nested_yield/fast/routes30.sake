# 31 routes (the `rails routes` of this file is in ../README.md)
require "actionpack/action_dispatch/routing"
class ActionDispatch::Routing::Mapper
  def blog_routes(map)
    root map, "posts#index"
    resources map, :posts do
      resources map, :comments, only: Any[:create, :destroy]
      member(map) { get map, :preview }
      collection(map) { get map, :search }
    end
    resource map, :session
    namespace map, :admin do
      resources map, :users
    end
    get map, "about", to: "pages#about", as: :about
    get map, "files/*path", to: "files#show"
    scope map, "(:locale)", locale: /en|ja/ do
      get map, "hello", to: "pages#hello"
    end
  end
end
rs = ActionDispatch::Routing::RouteSet.make
ActionDispatch::Routing::RouteSet.draw(rs) { |map| ActionDispatch::Routing::Mapper.blog_routes(map) }
p(ActionDispatch::Journey::Routes.size(ActionDispatch::Routing::RouteSet.routes(rs)))
