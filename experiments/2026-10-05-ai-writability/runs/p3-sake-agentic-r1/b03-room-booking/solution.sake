Booking = Struct.new(:id, :room, :day, :s, :e, :who)

def days = Array["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

# returns minutes or nil
def parse_time(t)
  return nil unless String.match?(t, /\A\d\d:\d\d\z/)
  h = String.to_i(t[0, 2])
  m = String.to_i(t[3, 2])
  return nil if m >= 60 || m % 15 != 0
  v = h * 60 + m
  return nil if v < 480 || v > 1200
  v
end

def hm(v) = "#{String.rjust(Integer.to_s(v / 60), 2, "0")}:#{String.rjust(Integer.to_s(v % 60), 2, "0")}"

def err(n, msg) = puts("line #{n}: error: #{msg}")

bookings = Array[]
next_id = 1
n = 0
Array.each(String.lines(IO.read(IO.stdin))) do |raw|
  n += 1
  f = String.split(String.chomp(raw), " ")
  next if Array.size(f) == 0
  cmd = f[0]
  if cmd == "BOOK"
    if Array.size(f) != 5
      err(n, "wrong field count")
      next
    end
    room = f[1]
    day = f[2]
    unless String.match?(room, /\A[A-Z0-9]{1,8}\z/)
      err(n, "bad room")
      next
    end
    unless Array.include?(days, day)
      err(n, "bad day")
      next
    end
    tr = String.split(f[3], "-")
    st = nil
    en = nil
    if Array.size(tr) == 2 && !String.end_with?(f[3], "-")
      st = parse_time(tr[0])
      en = parse_time(tr[1])
    end
    if st == nil || en == nil || st >= en
      err(n, "bad time")
      next
    end
    who = f[4]
    unless String.match?(who, /\A[a-z]{1,12}\z/)
      err(n, "bad name")
      next
    end
    clash = Array.select(bookings) { |b| Booking.room(b) == room && Booking.day(b) == day && Booking.s(b) < en && st < Booking.e(b) }
    if Array.size(clash) > 0
      c = Array.min_by(clash) { |b| Booking.s(b) }
      puts("CONFLICT #{room} #{day} with ##{Booking.id(c)} (#{Booking.who(c)} #{hm(Booking.s(c))}-#{hm(Booking.e(c))})")
      next
    end
    cnt = Array.count(bookings) { |b| Booking.who(b) == who && Booking.day(b) == day }
    if cnt >= 3
      puts("LIMIT #{who} #{day}")
      next
    end
    Array.push(bookings, Booking.new(next_id, room, day, st, en, who))
    puts("OK ##{next_id} #{room} #{day} #{hm(st)}-#{hm(en)} #{who}")
    next_id += 1
  elsif cmd == "CANCEL"
    if Array.size(f) != 2
      err(n, "wrong field count")
      next
    end
    unless String.match?(f[1], /\A\d+\z/)
      err(n, "bad id")
      next
    end
    id = String.to_i(f[1])
    idx = Array.find_index(bookings) { |b| Booking.id(b) == id }
    if idx == nil
      puts("NO BOOKING ##{id}")
    else
      Array.delete_at(bookings, idx)
      puts("CANCELLED ##{id}")
    end
  elsif cmd == "FREE"
    if Array.size(f) != 4
      err(n, "wrong field count")
      next
    end
    room = f[1]
    day = f[2]
    unless String.match?(room, /\A[A-Z0-9]{1,8}\z/)
      err(n, "bad room")
      next
    end
    unless Array.include?(days, day)
      err(n, "bad day")
      next
    end
    unless String.match?(f[3], /\A\d+\z/) && String.to_i(f[3]) > 0 && String.to_i(f[3]) % 15 == 0
      err(n, "bad duration")
      next
    end
    mins = String.to_i(f[3])
    here = Array.select(bookings) { |b| Booking.room(b) == room && Booking.day(b) == day }
    found = nil
    s = 480
    while found == nil && s + mins <= 1200
      if Array.none?(here) { |b| Booking.s(b) < s + mins && s < Booking.e(b) }
        found = s
      end
      s += 15
    end
    if found == nil
      puts("FULL #{room} #{day}")
    else
      puts("FREE #{room} #{day} #{hm(found)}-#{hm(found + mins)}")
    end
  else
    err(n, "unknown command")
  end
end

puts("== schedule ==")
sorted = Array.sort_by(bookings) { |b| [Array.index(days, Booking.day(b)), Booking.room(b), Booking.s(b)] }
puts("(none)") if Array.size(sorted) == 0
Array.each(sorted) do |b|
  puts(format("%s %-8s %s-%s #%d %s", Booking.day(b), Booking.room(b), hm(Booking.s(b)), hm(Booking.e(b)), Booking.id(b), Booking.who(b)))
end
puts("== usage ==")
tot = Hash.new(0)
Array.each(bookings) { |b| tot[Booking.room(b)] += Booking.e(b) - Booking.s(b) }
puts("(none)") if Hash.size(tot) == 0
Array.each(Array.sort(Hash.keys(tot))) do |r|
  puts(format("%-8s %dh%02dm", r, tot[r] / 60, tot[r] % 60))
end
