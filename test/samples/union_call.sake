# `(A|B).f(x)` lists the types on the operation; x's type picks which f runs.
Leaf = Struct.new(:weight)
Node = Struct.new(:weight, :left, :right)
def total(t) = (Leaf|Node).get_weight(t)
p(total(Leaf.new(3)) + total(Node.new(5, Leaf.new(1), Leaf.new(4))))

def size_of(x) = (String|Array|Hash).size(x)
p([size_of("abc"), size_of(Array[1, 2]), size_of(Hash["a" => 1])])
p((Integer|Float).round(2.6))
