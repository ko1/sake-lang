require "rails/actionview/action_view/base"

# Rails 8.1 defaults (load_defaults): no utf8 input; ActionView::Base.empty has no forgery protection
view = ActionView::Base.empty
B = ActionView::Base

# form_tag
puts B.form_tag(view, "/posts")
puts B.form_tag(view, "/posts", method: :get, class: "search")
puts B.form_tag(view, "/posts/1", method: :delete)
puts B.form_tag(view, "/upload", multipart: true, enforce_utf8: true)
puts B.form_tag(view, "/posts", id: "f") { B.text_field_tag(view, "q") }
# fields
puts B.text_field_tag(view, "name")
puts B.text_field_tag(view, "query", "Enter your search query here")
puts B.text_field_tag(view, "search", nil, placeholder: "Enter search term...", size: 20, disabled: true)
puts B.text_field_tag(view, "post[title]", "<b>")
puts B.hidden_field_tag(view, "token", "VUBJKB23UIVI1UU1VOBVI@")
puts B.hidden_field_tag(view, "token", "x", autocomplete: "on")
puts B.password_field_tag(view, "pass")
puts B.password_field_tag(view, "secret", "Your secret here", class: "form_input")
puts B.file_field_tag(view, "attachment")
puts B.label_tag(view, "name")
puts B.label_tag(view, "name", "Your name")
puts B.label_tag(view, "name", nil, class: "small_label")
puts B.label_tag(view, "post[title]", "Title", for: "custom")
puts B.label_tag(view, "name", class: "x") { "block label" }
puts B.textarea_tag(view, "post")
puts B.textarea_tag(view, "bio", "<p>me</p>")
puts B.textarea_tag(view, "body", nil, rows: 10, cols: 25)
puts B.textarea_tag(view, "body", "x", size: "25x10", escape: false)
puts B.text_area_tag(view, "comment", "Hi", class: "c")
puts B.checkbox_tag(view, "accept")
puts B.checkbox_tag(view, "rock", "rock music")
puts B.checkbox_tag(view, "receive_email", "yes", true)
puts B.check_box_tag(view, "tos", "yes", false, class: "accept_tos")
puts B.radio_button_tag(view, "favorite_color", "maroon")
puts B.radio_button_tag(view, "receive_updates", "no", true)
puts B.radio_button_tag(view, "color", "dark blue", false, disabled: true)
puts B.submit_tag(view)
puts B.submit_tag(view, "Edit this article")
puts B.submit_tag(view, "Save edits", disabled: true)
puts B.submit_tag(view, "Complete sale", data: Hash.of(disable_with: "Submitting..."))
puts B.submit_tag(view, "Save", data: Hash.of(disable_with: false))
puts B.submit_tag(view, nil, class: "form_submit")
puts B.button_tag(view)
puts B.button_tag(view, "Reset", type: "reset")
puts B.button_tag(view, "Button", type: "button", disabled: true)
puts B.button_tag(view, type: "button") { "<strong>Ask me!</strong>" }
puts B.image_submit_tag(view, "/images/login.png", class: "x")
puts B.field_set_tag(view)
puts B.field_set_tag(view, "Your details") { "<p>inside</p>" }
puts B.field_set_tag(view, nil, class: "format") { "x" }
puts B.select_tag(view, "people", String.html_safe("<option>David</option>"))
puts B.select_tag(view, "count", String.html_safe("<option>1</option>"), include_blank: true)
puts B.select_tag(view, "count", String.html_safe("<option>1</option>"), include_blank: "Pick")
puts B.select_tag(view, "count", String.html_safe("<option>1</option>"), prompt: "Select something")
puts B.select_tag(view, "colors", String.html_safe("<option>Red</option>"), multiple: true, class: "c")
puts B.color_field_tag(view, "color", "#DEF726")
puts B.search_field_tag(view, "search", "q")
puts B.telephone_field_tag(view, "tel")
puts B.phone_field_tag(view, "phone", "0123")
puts B.date_field_tag(view, "d", "2026-10-20")
puts B.time_field_tag(view, "t")
puts B.datetime_field_tag(view, "dt")
puts B.datetime_local_field_tag(view, "dtl")
puts B.month_field_tag(view, "m")
puts B.week_field_tag(view, "w")
puts B.url_field_tag(view, "u", "http://example.com")
puts B.email_field_tag(view, "e", "a@b.c")
puts B.number_field_tag(view, "quantity", nil, in: 1...10)
puts B.number_field_tag(view, "quantity", "5", min: 1, max: 9, step: 2)
puts B.range_field_tag(view, "volume", nil, within: 0..11)
puts B.utf8_enforcer_tag(view)
# field_id / field_name
puts B.field_id(view, :post, :title)
puts B.field_id(view, "post[author]", :name, :error, index: 1)
puts B.field_id(view, :post, :published?, namespace: "admin")
puts B.field_name(view, :post, :title)
puts B.field_name(view, :post, :tag_ids, multiple: true)
puts B.field_name(view, :post, :title, :subtitle, index: 3)
puts B.field_name(view, "", :q)
