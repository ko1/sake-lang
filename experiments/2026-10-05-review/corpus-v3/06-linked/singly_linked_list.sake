Node = Struct.new(:value, :next)

class LinkedList
  attr_reader head = nil, tail = nil, size = 0

  def push_front(list, v)
    node = Node.new(v, @head)
    @head = node
    @tail = node if @tail == nil
    @size += 1
    list
  end

  def push_back(list, v)
    node = Node.new(v, nil)
    t = @tail
    if t
      Node.set_next(t, node)
    else
      @head = node
    end
    @tail = node
    @size += 1
    list
  end

  def pop_front(list)
    h = @head
    return nil unless h
    @head = Node.get_next(h)
    @tail = nil if @head == nil
    @size -= 1
    Node.get_value(h)
  end

  def each(list)
    node = @head
    while node
      yield(Node.get_value(node))
      node = Node.get_next(node)
    end
    list
  end

  def to_a(list)
    out = Array[]
    each(list) { |v| Array.push(out, v) }
    out
  end

  def find(list, target)
    index = 0
    node = @head
    while node
      return index if Node.get_value(node) == target
      index += 1
      node = Node.get_next(node)
    end
    nil
  end

  def remove(list, target)
    prev = nil
    node = @head
    while node
      if Node.get_value(node) == target
        nxt = Node.get_next(node)
        if prev
          Node.set_next(prev, nxt)
        else
          @head = nxt
        end
        @tail = prev if node == @tail
        @size -= 1
        return true
      end
      prev = node
      node = Node.get_next(node)
    end
    false
  end

  def reverse!(list)
    prev = nil
    node = @head
    @tail = node
    while node
      nxt = Node.get_next(node)
      Node.set_next(node, prev)
      prev = node
      node = nxt
    end
    @head = prev
    list
  end

  def insert_sorted(list, v)
    h = @head
    if h == nil || v <= Node.get_value(h)
      return push_front(list, v)
    end
    node = h
    while Node.get_next(node) && Node.get_value(Node.get_next(node)) < v
      node = Node.get_next(node)
    end
    fresh = Node.new(v, Node.get_next(node))
    Node.set_next(node, fresh)
    @tail = fresh if Node.get_next(fresh) == nil
    @size += 1
    list
  end

  def to_s(list) = "(" + Array.join(to_a(list), " -> ") + ")"
end

list = LinkedList.new
Array.each(Array[3, 1, 4, 1, 5]) { |x| LinkedList.push_back(list, x) }
LinkedList.push_front(list, 9)
puts("list: #{list} size=#{LinkedList.get_size(list)}")
puts("find 4: #{Kernel.inspect(LinkedList.find(list, 4))}")
puts("find 7: #{Kernel.inspect(LinkedList.find(list, 7))}")
puts("remove 1: #{LinkedList.remove(list, 1)} -> #{list}")
puts("remove 5 (tail): #{LinkedList.remove(list, 5)} -> #{list}")
puts("remove 42: #{LinkedList.remove(list, 42)}")
LinkedList.push_back(list, 6)
puts("after push_back 6: #{list} tail=#{Node.get_value(LinkedList.get_tail(list))}")
LinkedList.reverse!(list)
puts("reversed: #{list} tail=#{Node.get_value(LinkedList.get_tail(list))}")
popped = Array[]
while LinkedList.get_size(list) > 2
  Array.push(popped, LinkedList.pop_front(list))
end
puts("popped #{Kernel.inspect(popped)}, left #{list}")

sorted = LinkedList.new
Array.each(Array[50, 20, 80, 20, 10, 90, 60]) { |x| LinkedList.insert_sorted(sorted, x) }
puts("sorted: #{sorted}")
total = 0
LinkedList.each(sorted) { |v| total += v }
puts("sum=#{total} size=#{LinkedList.get_size(sorted)}")

words = LinkedList.new
Array.each(String.split("the quick brown fox", " ")) { |w| LinkedList.push_front(words, String.upcase(w)) }
puts("words: #{words}")
while LinkedList.get_size(words) > 0
  print(LinkedList.pop_front(words), ";")
end
puts
p(LinkedList.pop_front(words))
