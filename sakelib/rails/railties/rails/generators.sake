# Port of railties-8.1.3/lib/rails/generators.rb and commands/generate/generate_command.rb (partial: the generators this port has; no lookup of gems' generators by namespace, no destroy)
#
# Ruby finds a generator class by name (Rails::Generators.find_by_namespace) and starts it with Thor; here a
# `case` over the names.

require "generators/base"
require "generators/migration"
require "generators/rails/model_generator"
require "rails/activerecord/rails/generators/active_record/migration_generator"

module Rails
  module Generators
    module_function

    def GENERATORS = String["controller", "helper", "migration", "model", "resource", "resource_route", "scaffold", "scaffold_controller"]

    def invoke(g, name, args, migration: true)
      first = Array.first(args) || raise(Error, "No value provided for required arguments 'name'")
      rest = Array.drop(args, 1)
      case name
      in "model" then ModelGenerator.run(g, first, rest, migration: migration)
      in "migration" then ActiveRecord::Generators::MigrationGenerator.run(g, first, rest)
      in "controller" then ControllerGenerator.run(g, first, rest)
      in "helper" then HelperGenerator.run(g, first)
      in "resource" then ResourceGenerator.run(g, first, rest, migration: migration)
      in "resource_route" then ResourceRouteGenerator.run(g, first)
      in "scaffold" then ScaffoldGenerator.run(g, first, rest, migration: migration)
      in "scaffold_controller" then ScaffoldControllerGenerator.run(g, Name.make(first, rest))
      else raise Error, "Could not find generator '#{name}'. Maybe you meant #{Array.join(Array.map(Generators.GENERATORS) { |x| "'#{x}'" }, ", ")}"
      end
      nil
    end
  end
end
