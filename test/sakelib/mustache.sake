require "mustache"

def show(label, s)
  puts("#{label}: #{Kernel.inspect(s)}")
end

def try(t, view = Hash.new)
  show(Kernel.inspect(t), Mustache.render(t, view))
rescue Mustache::Parser::SyntaxError => e
  puts("Mustache::Parser::SyntaxError: #{Exception.message(e)}")
end

puts("== variables")
show("hello", Mustache.render("Hello {{planet}}!", Hash.of("planet" => "World")))
show("symbol keys", Mustache.render("{{a}} and {{ b }}", Hash.of(a: 1, b: 2.5)))
show("escape", Mustache.render("{{x}} {{{x}}} {{& x}}", Hash.of("x" => "<a href=\"q\">&'</a>")))
show("missing", Mustache.render("[{{nope}}][{{{nope}}}]"))
show("nil false", Mustache.render("[{{n}}][{{f}}]", Hash.of("n" => nil, "f" => false)))
show("dotted", Mustache.render("{{person.name.first}} / {{person.age}} / {{person.none.x}}",
                               Hash.of("person" => Hash.of("name" => Hash.of("first" => "Ann"), "age" => 30))))
show("no view", Mustache.render("plain text"))
show("array value", Mustache.render("{{list}}", Hash.of("list" => Any[1, 2])))

puts("== sections")
view = Hash.of(
  "name" => "Chris", "value" => 10000, "in_ca" => true, "taxed" => 6000.0,
  "repo" => Any[Hash.of("name" => "resque"), Hash.of("name" => "hub"), Hash.of("name" => "rip")],
  "empty" => Any[], "person?" => Hash.of("name" => "Jon"), "nums" => Any[1, 2, 3],
)
tmpl = <<~T
  Hello {{name}}
  You have just won {{value}} dollars!
  {{#in_ca}}
  Well, {{taxed}} dollars, after taxes.
  {{/in_ca}}
  {{#repo}}
    <b>{{name}}</b>
  {{/repo}}
  {{^empty}}
  No repos :(
  {{/empty}}
  {{#person?}}Hi {{name}}!{{/person?}}
  {{#nums}}{{.}},{{/nums}}
  {{! a comment
      over lines }}
  done
T
print(Mustache.render(tmpl, view))
show("falsy section", Mustache.render("[{{#f}}x{{/f}}][{{#n}}x{{/n}}][{{#e}}x{{/e}}]", Hash.of("f" => false, "e" => Any[])))
show("truthy scalar", Mustache.render("{{#s}}<{{.}}>{{/s}}", Hash.of("s" => "str")))
show("inverted", Mustache.render("{{^f}}no{{/f}}{{^t}}yes{{/t}}{{^missing}}!{{/missing}}", Hash.of("f" => false, "t" => true)))
show("outer scope", Mustache.render("{{#a}}{{b}}{{c}}{{/a}}", Hash.of("a" => Hash.of("b" => 1), "c" => 2)))
show("nested", Mustache.render("{{#rows}}{{#cells}}{{.}}{{/cells}};{{/rows}}",
                               Hash.of("rows" => Any[Hash.of("cells" => Any[1, 2]), Hash.of("cells" => Any[3])])))
show("dotted section", Mustache.render("{{#a.b}}{{c}}{{/a.b}}", Hash.of("a" => Hash.of("b" => Hash.of("c" => "deep")))))

puts("== standalone")
show("lines", Mustache.render("| a\n  {{#s}}\n  x\n  {{/s}}\n| b\n", Hash.of("s" => true)))
show("indented inline", Mustache.render(" {{#s}}x{{/s}}\n", Hash.of("s" => true)))
show("comment line", Mustache.render("a\n  {{! c }}  \nb"))
show("crlf", Mustache.render("a\r\n{{#s}}\r\nx\r\n{{/s}}\r\n", Hash.of("s" => true)))
show("at end", Mustache.render("a\n{{#s}}\n{{/s}}", Hash.of("s" => true)))

puts("== partials")
partials = Hash.of("user" => "<{{name}}>", "list" => "{{#items}}\n- {{> user}}\n{{/items}}", "rec" => "{{#kids}}({{n}}{{> rec}}){{/kids}}")
show("partial", Mustache.render("Users: {{> user}}", Hash.of("name" => "ann"), partials:))
show("in section", Mustache.render("{{> list}}", Hash.of("items" => Any[Hash.of("name" => "a"), Hash.of("name" => "b")]), partials:))
show("indented", Mustache.render("x\n  {{> list}}\ny", Hash.of("items" => Any[Hash.of("name" => "a")]), partials:))
show("recursive", Mustache.render("{{> rec}}", Hash.of("kids" => Any[Hash.of("n" => 1, "kids" => Any[Hash.of("n" => 2, "kids" => false)]), Hash.of("n" => 3, "kids" => false)]), partials:))
show("missing partial", Mustache.render("[{{> nope}}]", Hash.new, partials:))
show("symbol partials", Mustache.render("{{>p}}", Hash.of("v" => 1), partials: Hash.of(p: "v={{v}}")))

puts("== errors")
try("{{#a}}x")
try("x{{/a}}")
try("{{#a}}{{/b}}")
try("{{#a}}{{#b}}{{/a}}{{/b}}")
try("{{name")
try("{{{name}}", Hash.of("name" => 1))
