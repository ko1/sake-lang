# json: Ruby's JSON library (json 2.20) in Sake.
#
# JSON values are plain Sake values, as in Ruby: object -> Hash (String keys, or Symbol keys with
# symbolize_names), array -> Array, string -> String, number -> Integer or Float, true/false, null -> nil.
#
# Keyword options become one Record argument of a `_with` operation:
#   Ruby  JSON.parse(s, symbolize_names: true)
#   Sake  JSON.parse_with(s, {symbolize_names: true})
# Ruby's JSON::ParserError / JSON::GeneratorError are JSONParserError / JSONGeneratorError (no nested
# names). JSON::NestingError is raised as JSONParserError / JSONGeneratorError with Ruby's message.
#
# Error messages follow json 2.20's, including "at line L column C".

class JSONParserError < Exception
end

class JSONGeneratorError < Exception
end

# ---- parser ----

class JSONParserState
  attr_reader src, len, symbolize, allow_nan, trailing, max_nesting
  attr_accessor pos, depth
  def peek(ps) = @pos < @len ? @src[@pos] : nil

  def ws?(c) = c == " " || c == "\n" || c == "\t" || c == "\r"

  # Ruby's error text: a quoted fragment of the source at `at` (up to 32 bytes, up to whitespace),
  # then the line and the byte column.
  def fail_at(ps, msg, at)
    frag = "EOF"
    if at < @len
      c0 = @src[at]
      if ws?(c0)
        frag = @src[at, @len - at] || ""
      else
        chars = String[]
        bytes = 0
        i = at
        while i < @len
          c = @src[i]
          break if c == nil || ws?(c) || c == "\0"
          b = String.bytesize(c)
          break if bytes + b > 32
          Array.push(chars, c)
          bytes += b
          i += 1
        end
        last = Array.last(chars)
        Array.pop(chars) if last && String.bytesize(last) > 1
        frag = "'#{Array.join(chars, "")}'"
      end
    end
    # not String.sub: a backslash in frag would be read as a back reference
    k = String.index(msg, "%s")
    text = k ? "#{msg[0, k]}#{frag}#{msg[k + 2, String.size(msg)]}" : msg
    # Ruby counts bytes back from the cursor; a cursor on "\n" is column 0 of the next line
    prefix = @src[0, at] || ""
    line = String.count(prefix, "\n") + 1
    nl = String.rindex(prefix, "\n")
    column = String.bytesize(nl ? prefix[nl + 1, String.size(prefix)] || "" : prefix) + 1
    if @src[at] == "\n"
      line += 1
      column = 0
    end
    raise JSONParserError, "#{text} at line #{line} column #{column}"
  end

  def fail(ps, msg) = fail_at(ps, msg, @pos)

  # Whitespace and comments (json 2.20 still accepts /* */ and // comments by default).
  def skip_ws(ps)
    while @pos < @len
      c = @src[@pos]
      if ws?(c)
        @pos += 1
      elsif c == "/"
        skip_comment(ps)
      else
        break
      end
    end
    ps
  end

  def skip_comment(ps)
    start = @pos
    n = @src[@pos + 1]
    if n == "/"
      # String.index has no start offset: search the rest
      nl = String.index(@src[@pos, @len - @pos] || "", "\n")
      @pos = nl ? @pos + nl + 1 : @len
    elsif n == "*"
      close = String.index(@src[@pos + 2, @len - @pos - 2] || "", "*/")
      fail_at(ps, "unterminated comment, expected closing '*/'", start) unless close
      @pos += close + 4
    else
      fail_at(ps, "unexpected token %s", start)
    end
    ps
  end

  def nest(ps)
    @depth += 1
    raise JSONParserError, "nesting of #{@depth} is too deep" if @max_nesting > 0 && @depth > @max_nesting
    ps
  end

  def value(ps)
    skip_ws(ps)
    c = peek(ps)
    raise JSONParserError, "unexpected end of input" unless c
    case c
    in "{" then object(ps)
    in "[" then array(ps)
    in "\"" then string(ps)
    in "t" then keyword(ps, "true", true)
    in "f" then keyword(ps, "false", false)
    in "n" then keyword(ps, "null", nil)
    in "N"
      fail(ps, "unexpected token %s") unless @allow_nan
      keyword(ps, "NaN", 0.0 / 0.0)
    in "I"
      fail(ps, "unexpected token %s") unless @allow_nan
      keyword(ps, "Infinity", 1.0 / 0.0)
    in "-"
      if @allow_nan && @src[@pos + 1] == "I"
        keyword(ps, "-Infinity", -1.0 / 0.0)
      else
        number(ps)
      end
    else
      if String.match?(c, /\A[0-9]\z/)
        number(ps)
      elsif c == "\0"
        fail(ps, "unexpected NULL byte: %s")
      else
        fail(ps, "unexpected character: %s")
      end
    end
  end

  def keyword(ps, word, v)
    n = String.size(word)
    fail(ps, "unexpected token %s") unless @src[@pos, n] == word
    @pos += n
    v
  end

  def end_of_input(ps)
    fail(ps, "unexpected end of input")
  end

  def array(ps)
    a = Array[]
    @pos += 1
    skip_ws(ps)
    if peek(ps) == "]"
      @pos += 1
      return a
    end
    nest(ps)
    while true
      skip_ws(ps)
      end_of_input(ps) if @pos >= @len
      Array.push(a, value(ps))
      skip_ws(ps)
      c = peek(ps)
      if c == ","
        @pos += 1
        if @trailing
          skip_ws(ps)
          if peek(ps) == "]"
            @pos += 1
            break
          end
        end
      elsif c == "]"
        @pos += 1
        break
      else
        fail(ps, "expected ',' or ']' after array value")
      end
    end
    @depth -= 1
    a
  end

  def key(ps, s) = @symbolize ? String.to_sym(s) : s

  def object(ps)
    h = Hash[]
    @pos += 1
    skip_ws(ps)
    if peek(ps) == "}"
      @pos += 1
      return h
    end
    nest(ps)
    first = true
    while true
      skip_ws(ps)
      unless peek(ps) == "\""
        fail(ps, first ? "expected object key, got %s" : "expected object key, got: %s")
      end
      k = string(ps)
      skip_ws(ps)
      unless peek(ps) == ":"
        fail(ps, first ? "expected ':' after object key" : "expected ':' after object key, got: %s")
      end
      @pos += 1
      skip_ws(ps)
      end_of_input(ps) if @pos >= @len
      h[key(ps, k)] = value(ps)
      first = false
      skip_ws(ps)
      c = peek(ps)
      if c == ","
        @pos += 1
        skip_ws(ps)
        if @trailing && peek(ps) == "}"
          @pos += 1
          break
        end
      elsif c == "}"
        @pos += 1
        break
      else
        fail(ps, "expected ',' or '}' after object value, got: %s")
      end
    end
    @depth -= 1
    h
  end

  # Four hex digits at i, or nil.
  def hex4(ps, i)
    h = @src[i, 4]
    return nil unless h && String.match?(h, /\A[0-9a-fA-F]{4}\z/)
    String.hex(h)
  end

  # UTF-8 of a code point; a lone surrogate gives its 3 bytes, as Ruby's parser does.
  def utf8(cp)
    if cp >= 0xD800 && cp <= 0xDFFF
      bytes = Integer[0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
      return String.force_encoding(Array.pack(bytes, "C*"), "UTF-8")
    end
    format("%c", cp)
  end

  # First scan to the closing quote (control characters, end of input), then unescape, as Ruby does.
  def string(ps)
    @pos += 1
    start = @pos
    while (c = @src[@pos]) && c != "\""
      if c == "\\"
        @pos += 2
      elsif String.ord(c) < 0x20
        fail(ps, "invalid ASCII control character in string: %s")
      else
        @pos += 1
      end
    end
    fail(ps, "unexpected end of input, expected closing \"") if @pos >= @len
    finish = @pos
    @pos += 1
    unescape(ps, start, finish)
  end

  def unescape(ps, start, finish)
    body = @src[start, finish - start] || ""
    return body unless String.include?(body, "\\")
    out = String[]
    seg = start
    i = start
    while i < finish
      if @src[i] != "\\"
        i += 1
        next
      end
      Array.push(out, @src[seg, i - seg] || "") if i > seg
      e = @src[i + 1] || ""
      case e
      in "\"" then Array.push(out, "\"")
      in "/" then Array.push(out, "/")
      in "\\" then Array.push(out, "\\")
      in "n" then Array.push(out, "\n")
      in "r" then Array.push(out, "\r")
      in "t" then Array.push(out, "\t")
      in "b" then Array.push(out, "\b")
      in "f" then Array.push(out, "\f")
      in "u"
        cp = hex4(ps, i + 2)
        fail_at(ps, "incomplete unicode character escape sequence at %s", i) unless cp
        if (cp & 0xFC00) == 0xD800
          lo = @src[i + 6, 2] == "\\u" && i + 12 <= finish ? hex4(ps, i + 8) : nil
          fail_at(ps, "incomplete surrogate pair at %s", seg) unless lo
          fail_at(ps, "invalid surrogate pair at %s", seg) unless (lo & 0xFC00) == 0xDC00
          cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
          i += 6
        end
        Array.push(out, utf8(cp))
        i += 4
      else
        fail_at(ps, "Invalid unescaped newline character (\\n) in string: %s", i) if e == "\n"
        fail_at(ps, "invalid ASCII control character in string: %s", i) if e != "" && String.ord(e) < 0x20
        fail_at(ps, "invalid escape character in string: %s", i)
      end
      i += 2
      seg = i
    end
    Array.push(out, @src[seg, finish - seg] || "") if finish > seg
    Array.join(out, "")
  end

  def digits(ps)
    n = 0
    while @pos < @len && String.include?("0123456789", @src[@pos] || "x")
      @pos += 1
      n += 1
    end
    n
  end

  # Ruby's json_parse_number: "01", "-", "1.", "1e" are invalid numbers.
  def number(ps)
    start = @pos
    neg = @src[@pos] == "-"
    @pos += 1 if neg
    first = @src[@pos]
    n = digits(ps)
    fail_at(ps, "invalid number: %s", start) if (first == "0" && n > 1) || n == 0
    float = false
    if peek(ps) == "."
      float = true
      @pos += 1
      fail_at(ps, "invalid number: %s", start) if digits(ps) == 0
    end
    if peek(ps) == "e" || peek(ps) == "E"
      float = true
      @pos += 1
      @pos += 1 if peek(ps) == "+" || peek(ps) == "-"
      fail_at(ps, "invalid number: %s", start) if digits(ps) == 0
    end
    text = @src[start, @pos - start] || ""
    float ? Float(text) : Integer(text)
  end
end

# ---- generator ----

class JSONGeneratorState
  attr_reader indent, space, space_before, object_nl, array_nl, allow_nan, max_nesting
  def escape(gs, str)
    s = str
    if String.encoding(s) == "ASCII-8BIT"
      # json 2.20 takes a binary String that is valid UTF-8 (with a deprecation warning)
      u = String.force_encoding(String[s].Array.join(""), "UTF-8")
      unless String.valid_encoding?(u)
        bad = Array.find(String.bytes(s)) { |b| b >= 0x80 } || 0
        raise JSONGeneratorError, format("\"\\x%02X\" from ASCII-8BIT to UTF-8", bad)
      end
      s = u
    end
    raise JSONGeneratorError, "source sequence is illegal/malformed utf-8" unless String.valid_encoding?(s)
    return "\"#{s}\"" unless String.match?(s, /["\\\x00-\x1f]/)
    out = String[]
    String.each_char(s) do |c|
      case c
      in "\"" then Array.push(out, "\\\"")
      in "\\" then Array.push(out, "\\\\")
      in "\n" then Array.push(out, "\\n")
      in "\r" then Array.push(out, "\\r")
      in "\t" then Array.push(out, "\\t")
      in "\b" then Array.push(out, "\\b")
      in "\f" then Array.push(out, "\\f")
      else
        o = String.ord(c)
        Array.push(out, o < 0x20 ? format("\\u%04x", o) : c)
      end
    end
    "\"#{Array.join(out, "")}\""
  end

  def key(gs, k)
    case k
    in String then escape(gs, k)
    in Symbol then escape(gs, Symbol.to_s(k))
    else escape(gs, Kernel.to_s(k))
    end
  end

  def float(gs, f)
    unless Float.finite?(f)
      raise JSONGeneratorError, "#{Float.to_s(f)} not allowed in JSON" unless @allow_nan
      return Float.to_s(f)
    end
    JSON.float_s(f)
  end

  def nest(gs, depth)
    if @max_nesting > 0 && depth > @max_nesting
      raise JSONParserError, "nesting of #{depth - 1} is too deep. Did you try to serialize objects with circular references?"
    end
    gs
  end

  def emit(gs, v, depth)
    case v
    in nil then "null"
    in true then "true"
    in false then "false"
    in Integer then Integer.to_s(v)
    in Float then float(gs, v)
    in String then escape(gs, v)
    in Symbol then escape(gs, Symbol.to_s(v))
    in Array then list(gs, v, depth)
    in Tuple then list(gs, Tuple.to_a(v), depth)
    in Hash
      nest(gs, depth + 1)
      return "{}" if Hash.empty?(v)
      inner = @indent * (depth + 1)
      parts = Hash.map(v) do |k, x|
        "#{@object_nl}#{inner}#{key(gs, k)}#{@space_before}:#{@space}#{emit(gs, x, depth + 1)}"
      end
      "{#{Array.join(parts, ",")}#{@object_nl}#{@indent * depth}}"
    in Record
      raise JSONGeneratorError, "a Record cannot be generated; build a Hash with Hash[...]"
    else
      escape(gs, Kernel.to_s(v))
    end
  end

  def list(gs, a, depth)
    nest(gs, depth + 1)
    return "[]" if Array.empty?(a)
    inner = @indent * (depth + 1)
    parts = Array.map(a) { |x| "#{@array_nl}#{inner}#{emit(gs, x, depth + 1)}" }
    "[#{Array.join(parts, ",")}#{@array_nl}#{@indent * depth}]"
  end
end

module JSON
  module_function

  # ---- options ----

  def opt_bool(o, name, d)
    case name
    in :symbolize_names then (o in {symbolize_names: x}) ? x == true : d
    in :allow_nan then (o in {allow_nan: x}) ? x == true : d
    in :allow_trailing_comma then (o in {allow_trailing_comma: x}) ? x == true : d
    end
  end

  # max_nesting: an Integer, or false/nil/0 for no limit
  def opt_nesting(o, d)
    case o
    in {max_nesting:}
      (max_nesting in Integer) ? max_nesting : 0
    else d
    end
  end

  def opt_str(o, name, d)
    case name
    in :indent then (o in {indent: x}) ? x : d
    in :space then (o in {space: x}) ? x : d
    in :space_before then (o in {space_before: x}) ? x : d
    in :object_nl then (o in {object_nl: x}) ? x : d
    in :array_nl then (o in {array_nl: x}) ? x : d
    end
  end

  # ---- parsing ----

  def parse(s) = parse_with(s, {symbolize_names: false})

  # Options: symbolize_names, allow_nan, allow_trailing_comma, max_nesting (default 100).
  def parse_with(s, o)
    ps = JSONParserState.new(s, String.size(s), opt_bool(o, :symbolize_names, false),
                             opt_bool(o, :allow_nan, false), opt_bool(o, :allow_trailing_comma, false),
                             opt_nesting(o, 100), 0, 0)
    JSONParserState.skip_ws(ps)
    JSONParserState.end_of_input(ps) if JSONParserState.get_pos(ps) >= String.size(s)
    v = JSONParserState.value(ps)
    JSONParserState.skip_ws(ps)
    JSONParserState.fail(ps, "unexpected token at end of stream %s") if JSONParserState.get_pos(ps) < String.size(s)
    v
  end

  def load_file(path) = parse(File.read(path))

  # Ruby's JSON.load (without create_additions): nil or blank input gives nil; NaN is allowed.
  def load(s)
    return nil if s == nil || String.strip(s) == ""
    parse_with(s, {allow_nan: true, max_nesting: false})
  end

  # ---- generating ----

  def generate(v) = generate_with(v, {indent: ""})
  def fast_generate(v) = generate(v)

  # Options: indent, space, space_before, object_nl, array_nl, allow_nan, max_nesting (default 100).
  def generate_with(v, o)
    gs = JSONGeneratorState.new(opt_str(o, :indent, ""), opt_str(o, :space, ""), opt_str(o, :space_before, ""),
                                opt_str(o, :object_nl, ""), opt_str(o, :array_nl, ""),
                                opt_bool(o, :allow_nan, false), opt_nesting(o, 100))
    JSONGeneratorState.emit(gs, v, 0)
  end

  def pretty_generate(v) = generate_with(v, {indent: "  ", space: " ", object_nl: "\n", array_nl: "\n"})

  def pretty_generate_with(v, o)
    gs = JSONGeneratorState.new(opt_str(o, :indent, "  "), opt_str(o, :space, " "), opt_str(o, :space_before, ""),
                                opt_str(o, :object_nl, "\n"), opt_str(o, :array_nl, "\n"),
                                opt_bool(o, :allow_nan, false), opt_nesting(o, 100))
    JSONGeneratorState.emit(gs, v, 0)
  end

  # Ruby's JSON.dump: no nesting limit, NaN allowed.
  def dump(v) = generate_with(v, {allow_nan: true, max_nesting: false})

  # json 2.20's float form (its fpconv): shortest digits, plain notation for exponents in
  # [-6, 15) (and below 10 when there is a fraction), scientific otherwise ("1e+20").
  def float_s(f)
    return (1.0 / f < 0 ? "-0.0" : "0.0") if f == 0.0
    neg = f < 0
    t = Float.to_s(Float.abs(f))
    if String.include?(t, "e")
      mant, _, ex = String.partition(t, "e")
      e10 = Integer(ex)
      digits = String.delete(mant, ".")
    else
      ip, _, fp = String.partition(t, ".")
      if ip == "0"
        lead = String.size(fp) - String.size(String.lstrip(String.tr(fp, "0", " ")))
        e10 = -(lead + 1)
        digits = String.delete_prefix(fp, "0" * lead)
      else
        e10 = String.size(ip) - 1
        digits = ip + fp
      end
    end
    digits = String.sub(digits, /0+\z/, "")
    digits = "0" if digits == ""
    nd = String.size(digits)
    k = e10 - nd + 1
    ex = Integer.abs(k + nd - 1)
    body =
      if k >= 0 && ex < 15
        digits + "0" * k + ".0"
      elsif k < 0 && (k > -7 || ex < 10)
        offset = nd + k
        if offset <= 0
          "0." + "0" * (-offset) + digits
        else
          "#{digits[0, offset]}.#{digits[offset, nd - offset]}"
        end
      else
        frac = nd > 1 ? ".#{digits[1, nd - 1]}" : ""
        "#{digits[0]}#{frac}e#{k + nd - 1 < 0 ? "-" : "+"}#{ex}"
      end
    neg ? "-" + body : body
  end
end

# Ruby's obj.to_json for the common types.
class Hash
  def to_json(h) = JSON.generate(h)
end

class Array
  def to_json(a) = JSON.generate(a)
end

class String
  def to_json(s) = JSON.generate(s)
end

class Integer
  def to_json(n) = JSON.generate(n)
end

class Float
  def to_json(f) = JSON.generate(f)
end
