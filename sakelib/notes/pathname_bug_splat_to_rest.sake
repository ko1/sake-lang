# A splat into a user function that takes *rest is rejected, with a hint that it takes "a fixed
# number of arguments" (spec §6 says *rest collects the remaining positional arguments).
def join(*parts) = Array.join(parts, "/")
xs = Array["a", "b"]
p join("x", "y")      # fine
p join(*xs)           # error: splat arguments go only to built-ins ...
