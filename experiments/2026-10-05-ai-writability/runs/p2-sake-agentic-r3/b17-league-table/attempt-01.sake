def team_id(ids, names, name)
  id = ids[name]
  if id == nil
    id = Array.size(names)
    ids[name] = id
    Array.push(names, name)
  end
  id
end

lines = IO.readlines(IO.stdin)
ids = Hash.new
names = String[]
# played matches: [home, away, home goals, away goals]
games = Tuple[]
no = 0
Array.each(lines) do |raw|
  no += 1
  text = String.chomp(raw)
  toks = String.split(text)
  next if Array.size(toks) == 0 && String.strip(text) == ""
  ok = Array.size(toks) == 3
  if ok
    ok = String.match?(toks[0], /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/) && String.match?(toks[2], /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/) && toks[0] != toks[2]
  end
  m = nil
  if ok
    if toks[1] != "P-P"
      m = String.match(toks[1], /\A([0-9]{1,2})-([0-9]{1,2})\z/)
      ok = false if m == nil
    end
  end
  if ok
    h = team_id(ids, names, toks[0])
    a = team_id(ids, names, toks[2])
    if m != nil
      cap = MatchData.captures(m)
      Array.push(games, [h, a, String.to_i(cap[0]), String.to_i(cap[1])])
    end
  else
    puts("invalid line #{no}: #{text}")
  end
end

n = Array.size(names)
if n == 0
  puts("no teams")
  exit(0)
end

pl = Array.new(n, 0)
w = Array.new(n, 0)
d = Array.new(n, 0)
l = Array.new(n, 0)
gf = Array.new(n, 0)
ga = Array.new(n, 0)
Array.each(games) do |g|
  h, a, hg, ag = g
  pl[h] += 1
  pl[a] += 1
  gf[h] += hg
  ga[h] += ag
  gf[a] += ag
  ga[a] += hg
  if hg > ag
    w[h] += 1
    l[a] += 1
  elsif hg < ag
    w[a] += 1
    l[h] += 1
  else
    d[h] += 1
    d[a] += 1
  end
end

pts = Array.new(n) { |i| w[i] * 3 + d[i] }
gd = Array.new(n) { |i| gf[i] - ga[i] }
h2h = Array.new(n, 0)
Array.each(games) do |g|
  h, a, hg, ag = g
  same = pts[h] == pts[a] && gd[h] == gd[a] && gf[h] == gf[a]
  if same
    if hg > ag
      h2h[h] += 3
    elsif hg < ag
      h2h[a] += 3
    else
      h2h[h] += 1
      h2h[a] += 1
    end
  end
end

key = Array.new(n) { |i| [pts[i], gd[i], gf[i], h2h[i]] }
order = Array.sort_by(Range.to_a(0...n)) { |i| [-pts[i], -gd[i], -gf[i], -h2h[i], names[i]] }
fmt = "%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s"
puts(format(fmt, "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
Array.each(order) do |i|
  pos = 1 + Array.count(key) { |k| k > key[i] }
  gds = gd[i] > 0 ? "+#{gd[i]}" : "#{gd[i]}"
  puts(format(fmt, pos, names[i], pl[i], w[i], d[i], l[i], gf[i], ga[i], gds, pts[i]))
end
