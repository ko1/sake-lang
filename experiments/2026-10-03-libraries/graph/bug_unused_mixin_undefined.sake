# A library module whose mixin function needs `each_step` from its includers.
# A program that never includes Walk (it just does not use that part of the library)
# is rejected: "undefined function `each_step`".
module Walk
  def steps(w)
    out = Array[]
    each_step(w) { |x| Array.push(out, x) }
    out
  end
end
p(1)
