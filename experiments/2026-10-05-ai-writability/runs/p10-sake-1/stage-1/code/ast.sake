# Syntax tree produced by the parser and consumed by the resolver and the executor.
# Every node is its own type, so code dispatches with `case node in Binary ...`.

# ---- Expressions ----

# A constant: nil (NULL), Integer, Float or String.
class Lit
  attr_reader value
end

# A column reference. `name` is as written; `index` (position in the table's row) and `aff`
# (the column's type, :integer / :real / :text, used for comparisons) are filled in by the
# resolver and are -1 / nil in the parser's output.
class Col
  attr_reader name, index, aff
end

# op is :neg, :pos or :not.
class Unary
  attr_reader op, operand
end

# op is one of + - * / % || = != < <= > >= IS "IS NOT" AND OR ("==" and "<>" are normalised).
class Binary
  attr_reader op, left, right
end

# `name` as written (for messages); `fn` is the lower-case name used to look the function up.
class Call
  attr_reader name, fn, args
end

# ---- Statements ----

# type is :integer, :real or :text.
class ColumnDef
  attr_reader name, type
end

class CreateTable
  attr_reader name, columns, if_not_exists
end

class DropTable
  attr_reader name, if_exists
end

# columns: Array of names, or nil when the statement gave no column list.
# rows: Array of rows, each an Array of expressions.
class Insert
  attr_reader table, columns, rows
end

# expr is nil for `*`; alias_name is nil when there is no alias.
class ResultColumn
  attr_reader expr, alias_name
end

# nulls is :default, :first or :last.
class OrderTerm
  attr_reader expr, desc, nulls
end

# from, where, limit and offset are nil when absent.
class Select
  attr_reader items, from, where, order, limit, offset
end
