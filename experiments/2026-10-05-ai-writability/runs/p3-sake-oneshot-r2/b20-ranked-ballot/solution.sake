def read_lines
  out = String[]
  l = gets
  while l != nil
    Array.push(out, String.chomp(l))
    l = gets
  end
  out
end

def pct(v, active)
  return "0.0%" if active == 0
  t = (v * 2000 + active) / (2 * active)
  "#{t / 10}.#{t % 10}%"
end

def pick_elim(cont, hist)
  cur = hist[Array.size(hist) - 1]
  mv = Array.min(Array.map(cont) { |c| cur[c] })
  s = Array.select(cont) { |c| cur[c] == mv }
  r = Array.size(hist) - 2
  while r >= 0 && Array.size(s) > 1
    h = hist[r]
    m = Array.min(Array.map(s) { |c| h[c] })
    s = Array.select(s) { |c| h[c] == m }
    r -= 1
  end
  Array.max(s)
end

def solve(lines)
  if Array.size(lines) == 0
    puts("no candidates")
    return
  end
  cands = String[]
  Array.each(String.split(lines[0])) do |c|
    Array.push(cands, c) unless Array.include?(cands, c)
  end
  if Array.size(cands) == 0
    puts("no candidates")
    return
  end

  ballots = Array[]
  rej = String[]
  i = 1
  while i < Array.size(lines)
    line = lines[i]
    if String.strip(line) != ""
      parts = String.split(line + ">x", ">")
      parts = Array.take(parts, Array.size(parts) - 1)
      ballot = String[]
      reason = ""
      j = 0
      while j < Array.size(parts) && reason == ""
        nm = String.strip(parts[j])
        if nm == ""
          reason = "empty rank"
        elsif !Array.include?(cands, nm)
          reason = "unknown candidate #{nm}"
        elsif Array.include?(ballot, nm)
          reason = "duplicate #{nm}"
        else
          Array.push(ballot, nm)
        end
        j += 1
      end
      if reason == ""
        Array.push(ballots, ballot)
      else
        Array.push(rej, "rejected line #{i + 1}: #{reason}")
      end
    end
    i += 1
  end
  Array.each(rej) { |s| puts(s) }
  puts("ballots: #{Array.size(ballots)} valid, #{Array.size(rej)} rejected")

  cont = Array.map(cands) { |c| c }
  hist = Array[]
  round = 0
  running = true
  while running
    round += 1
    counts = Hash[]
    Array.each(cont) { |c| counts[c] = 0 }
    exhausted = 0
    Array.each(ballots) do |b|
      w = Array.find(b) { |c| Array.include?(cont, c) }
      if w == nil
        exhausted += 1
      else
        counts[w] += 1
      end
    end
    active = Array.size(ballots) - exhausted
    Array.push(hist, counts)
    puts("round #{round}")
    order = Array.sort_by(cont) { |c| [-counts[c], c] }
    Array.each(order) { |c| puts("  #{c} #{counts[c]} #{pct(counts[c], active)}") }
    puts("  exhausted #{exhausted}")
    if active == 0
      puts("no winner")
      running = false
    else
      winner = Array.find(cont) { |c| counts[c] * 2 > active }
      if winner != nil
        puts("winner #{winner}")
        running = false
      else
        elim = pick_elim(cont, hist)
        puts("  eliminated #{elim}")
        cont = Array.reject(cont) { |c| c == elim }
      end
    end
  end
end

solve(read_lines)
