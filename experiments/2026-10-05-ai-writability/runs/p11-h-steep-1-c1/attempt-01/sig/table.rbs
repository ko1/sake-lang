module Sql
  class UniqueKey
    attr_reader positions: Array[Integer]
    attr_reader collations: Array[collation]

    def initialize: (Array[Integer] positions, Array[collation] collations) -> void
  end

  class Table
    attr_reader name: String
    attr_reader columns: Array[Column]
    attr_reader rows: Array[Array[value]]

    @rowid: Integer?
    @uniques: Array[UniqueKey]
    @index_uniques: Hash[String, UniqueKey]

    def initialize: (String name, Array[Column] columns, Integer? rowid, Array[UniqueKey] uniques) -> void
    def self.from_statement: (Ast::CreateTable statement) -> Table
    def self.positions: (Array[Ast::ColumnDef] definitions, Array[String] names) -> Array[Integer]
    def copy: () -> Table
    def restore: (Array[Array[value]] rows, Hash[String, UniqueKey] index_uniques) -> void
    def positions_of: (Array[String] names) -> Array[Integer]
    def rename_to: (String new_name) -> void
    def add_column: (Ast::ColumnDef definition) -> void
    def rename_column: (String old_name, String new_name) -> void
    def add_unique_index: (String index_name, Array[Integer] positions, Array[collation?] written) -> void
    def drop_unique_index: (String index_name) -> void
    def column_index: (String name) -> Integer?
    def default_row: () -> Array[value]
    def insert_rows: (Array[Array[value]] raw_rows) -> void
    def update_rows: (Array[[Integer, Array[value]]] changes) -> void
    def delete_rows: (Array[bool] doomed) -> void

    private

    def checked_row: (Array[value] raw, Array[Array[value]] others, Integer? skip) -> Array[value]
    def key_value: (value given, Array[Array[value]] others, bool inserting) -> Integer
    def next_key: (Array[Array[value]] others) -> Integer
    def duplicate?: (UniqueKey key, Array[value] row, Array[Array[value]] others, Integer? skip) -> bool
    def unique_message: (Array[Integer] positions) -> String
  end
end
