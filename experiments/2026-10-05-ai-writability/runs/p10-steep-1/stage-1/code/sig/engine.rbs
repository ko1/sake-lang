module Sql
  module Evaluator
    def self.evaluate: (Ast::Expr expr, Array[value] row) -> value
    def self.affinity: (Ast::Expr expr) -> column_type?
    def self.unary: (Ast::Unary expr, Array[value] row) -> value
    def self.negation: (bool? truth) -> bool?
    def self.binary: (Ast::Binary expr, Array[value] row) -> value
    def self.conjunction: (Ast::Binary expr, Array[value] row) -> Integer?
    def self.disjunction: (Ast::Binary expr, Array[value] row) -> Integer?
    def self.same: (Ast::Is expr, Array[value] row) -> Integer
  end

  class Resolver
    @columns: Array[Column]
    @aliases: Hash[String, Ast::Expr]

    def initialize: (Array[Column] columns, Hash[String, Ast::Expr] aliases) -> void
    def resolve: (Ast::Expr expr) -> Ast::Expr

    private

    def resolve_name: (String name) -> Ast::Expr
    def resolve_call: (Ast::FunctionCall call) -> Ast::FunctionCall
  end

  class SelectPlan
    attr_reader results: Array[Ast::Expr]
    attr_reader where: Ast::Expr?
    attr_reader order_by: Array[Ast::OrderTerm]
    attr_reader limit: Ast::Expr?
    attr_reader offset: Ast::Expr?

    def self.build: (Ast::Select select, Table? table) -> SelectPlan
    def self.plan_term: (Ast::OrderTerm term, Integer index, Array[Ast::Expr] results, Hash[String, Ast::Expr] aliases, Resolver scope) -> Ast::OrderTerm
    def self.literal_position: (Ast::Expr expr) -> Integer?
    def self.ordinal: (Integer n) -> String
    def initialize: (Array[Ast::Expr] results, Ast::Expr? where, Array[Ast::OrderTerm] order_by, Ast::Expr? limit, Ast::Expr? offset) -> void
  end

  class Engine
    class Entry
      attr_reader values: Array[value]
      attr_reader keys: Array[value]
      attr_reader index: Integer

      def initialize: (Array[value] values, Array[value] keys, Integer index) -> void
    end

    NO_LINES: Array[String]

    @catalog: Catalog

    def initialize: () -> void
    def run_script: (String source, IO out) -> void
    def execute: (Ast::Statement statement) -> Array[String]

    private

    def create_table: (Ast::CreateTable statement) -> Array[String]
    def drop_table: (Ast::DropTable statement) -> Array[String]
    def insert: (Ast::Insert statement) -> Array[String]
    def insert_targets: (Ast::Insert statement, Table table) -> Array[Integer]
    def run_select: (Ast::Select statement) -> Array[String]
    def bound: (Ast::Expr? expr) -> Integer?
    def compare_entries: (Entry left, Entry right, Array[Ast::OrderTerm] terms) -> Integer
    def compare_keys: (value a, value b, Ast::OrderTerm term) -> Integer
  end
end
