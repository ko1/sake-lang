# Port of actionpack-8.1.3/lib/action_dispatch/journey/scanner.rb
#
# STATIC_TOKENS (an Array indexed by byte) is a `case` over the byte here.

require "strscan"

module ActionDispatch
  module Journey
    class Scanner
      private attr_accessor scanner, length

      def initialize(sc)
        @scanner = nil
        @length = nil
      end

      def static_token(sc, byte)
        case byte
        in 46 then :DOT        # .
        in 47 then :SLASH      # /
        in 40 then :LPAREN     # (
        in 41 then :RPAREN     # )
        in 124 then :OR        # |
        in 58 then :SYMBOL     # :
        in 42 then :STAR       # *
        else nil
        end
      end

      def scan_setup(sc, str)
        @scanner = StringScanner.new(str)
      end

      def next_token(sc)
        s = @scanner
        s => StringScanner
        return nil if StringScanner.eos?(s)
        token = nil
        until (token = scan(sc)) || StringScanner.eos?(s)
        end
        token
      end

      def last_string(sc)
        s = @scanner
        s => StringScanner
        len = @length || 0
        String.byteslice(StringScanner.string(s), StringScanner.pos(s) - len, len) || ""
      end

      def last_literal(sc) = String.tr(last_string(sc), "\\", "")

      def scan(sc)
        s = @scanner
        s => StringScanner
        next_byte = StringScanner.peek_byte(s)
        token = next_byte ? static_token(sc, next_byte) : nil
        if token && (token != :SYMBOL || next_byte_is_not_a_token?(sc))
          StringScanner.set_pos(s, StringScanner.pos(s) + 1)
          @length = (StringScanner.skip(s, /\w+/) || 0) + 1 if token == :SYMBOL || token == :STAR
          return token
        end
        if (@length = StringScanner.skip(s, /(?:[\w%\-~!$&'*+,;=@]|\\[:()])+/))
          return :LITERAL
        end
        if (@length = StringScanner.skip(s, /./))
          return :LITERAL
        end
        nil
      end

      def next_byte_is_not_a_token?(sc)
        s = @scanner
        s => StringScanner
        b = String.getbyte(StringScanner.string(s), StringScanner.pos(s) + 1)
        b == nil || static_token(sc, b) == nil
      end
    end
  end
end
