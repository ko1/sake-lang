# Ruby's ActiveRecord::Base includes ~40 modules whose methods use instance variables, and a model inherits
# Base. In Sake a module that includes such a module is rejected: "`include Core` in Base: Core.new_record?
# uses `@new_record`, but Base is not a class with field `new_record`", although every class including Base
# declares the field. The activerecord port includes Base's modules into each model directly (generated) instead.
module Core
  def new_record?(r) = @new_record
end
module Base
  include Core
end
class Post
  attr_accessor new_record
  include Base
end
p(Post.new_record?(Post.new(true)))
