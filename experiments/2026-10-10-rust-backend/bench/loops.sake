# The "loops" micro benchmark: 10,000 x 100,000 iterations of integer modulo and array update.
u = String.to_i(Array.fetch(ARGV, 0))
r = rand(10000)
a = Array.new(10000, 0)
i = 0
while i < 10000
  j = 0
  while j < 100000
    a[i] = Array.fetch(a, i) + j % u
    j += 1
  end
  a[i] = Array.fetch(a, i) + r
  i += 1
end
puts(Array.fetch(a, r))
