# Resolve install order for packages with a DFS topological sort; detect cycles, missing and version conflicts.
class CycleError < StandardError
  attr_reader path
end

class MissingPackage < StandardError
  attr_reader name, wanted_by
end

class VersionConflict < StandardError
  attr_reader name, need, have
end

class Package
  attr_reader name, version, deps
end

def registry
  Array.map(Array[
    Package.new("app", 3, Array[["web", 2], ["db", 1], ["log", 1]]),
    Package.new("web", 2, Array[["http", 1], ["log", 1]]),
    Package.new("http", 1, Array[["socket", 1]]),
    Package.new("socket", 1, Array[]),
    Package.new("db", 1, Array[["pool", 1], ["log", 1]]),
    Package.new("pool", 1, Array[]),
    Package.new("log", 1, Array[]),
    Package.new("cli", 1, Array[["args", 1], ["log", 2]]),
    Package.new("args", 1, Array[]),
    Package.new("a", 1, Array[["b", 1]]),
    Package.new("b", 1, Array[["c", 1]]),
    Package.new("c", 1, Array[["a", 1]]),
    Package.new("plugin", 1, Array[["web", 1], ["theme", 1]])
  ]) { |pkg| [Package.name(pkg), pkg] }
  Array.to_h(_)
end

def visit(reg, name, min_version, wanted_by, state, order, stack)
  pkg = reg[name]
  raise MissingPackage.new("#{name} not found (wanted by #{wanted_by})", name, wanted_by) if pkg == nil
  if Package.version(pkg) < min_version
    raise VersionConflict.new("#{wanted_by} needs #{name} >= #{min_version}", name, min_version, Package.version(pkg))
  end
  case state[name]
  in :done then return
  in :visiting
    start = Array.index(stack, name)
    raise CycleError.new("dependency cycle", Array.push(Array.drop(stack, start), name))
  in nil then nil
  end
  state[name] = :visiting
  Array.push(stack, name)
  Array.each(Package.deps(pkg)) do |dep, ver|
    visit(reg, dep, ver, name, state, order, stack)
  end
  Array.pop(stack)
  state[name] = :done
  Array.push(order, name)
end

def install_order(reg, root)
  order = Array[]
  visit(reg, root, 1, "user", Hash[], order, Array[])
  order
end

reg = registry
failures = 0
Array.each(Array["app", "socket", "cli", "a", "plugin", "nosuch"]) do |root|
  order = install_order(reg, root)
  puts("#{root}: #{Array.join(order, " -> ")}")
rescue CycleError => e
  failures += 1
  puts("#{root}: #{Exception.message(e)} #{Array.join(CycleError.path(e), " > ")}")
rescue MissingPackage => e
  failures += 1
  puts("#{root}: missing #{MissingPackage.name(e)}, required by #{MissingPackage.wanted_by(e)}")
rescue VersionConflict => e
  failures += 1
  puts("#{root}: #{Exception.message(e)}, but #{VersionConflict.have(e)} is available")
end
puts("#{failures} of 6 roots could not be resolved")
