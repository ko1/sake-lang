# String interpolation, and a type's own to_s / inspect (used by puts, p, join, format).
x = 3
puts("x = #{x}, x*x = #{x * x}, nil=[#{nil}] #{[1, "a"]}")
class Order < {reader: [id, items]}
  def to_s(o) = "Order ##{@id} (#{Array.size(@items)} items)"
  def inspect(o) = "#<Order #{@id}>"
end
o = Order.new(12, Array["a", "b"])
puts(o)
puts("got #{o}")
p(o)
p(Array[o])
puts(Array.join(Array[o, o], ", "))
puts(format("%s!", o))
p(:"sym_#{x}")
p(String.match?("abc", /b#{"c"}/))
