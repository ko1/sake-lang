# `class B < A` is "shorthand for writing A's definitions in B", but an Array made inside A's
# functions is one allocation site for A and B, so the element types of A's and B's instances meet
# there: bin/sake -c reports `y < x` as (String, Integer) [type] though it runs fine, and --types shows
# A.items and B.items as the same Array@L8[Integer | String].
class Box
  attr_reader items = nil
  def initialize(b)
    @items = Array[]
  end
  def add(b, x)
    Array.push(@items, x)
    Array.each(@items) { |y| p(y < x) }
  end
end
class Words < Box
end
Box.add(Box.new, 2)
Words.add(Words.new, "a")
