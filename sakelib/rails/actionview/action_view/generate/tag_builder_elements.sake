# (Sake only) The element functions of ActionView::Helpers::TagHelper::TagBuilder, as tag_helper.rb defines them with
# define_element / define_void_element / define_self_closing_element through ActiveSupport::CodeGenerator.
# Run by helpers/tag_builder_elements.sake (`generate`); run alone, it prints the source.

def void_elements = String["area", "base", "br", "col", "embed", "hr", "img", "input", "keygen", "link", "meta", "source", "track", "wbr"]

def self_closing_elements
  String["animate", "animateMotion", "animateTransform", "circle", "ellipse", "line", "path", "polygon", "polyline", "rect", "set", "stop", "use", "view"]
end

def elements
  String["a", "abbr", "address", "article", "aside", "audio", "b", "bdi", "bdo", "blockquote", "body", "button", "canvas",
         "caption", "cite", "code", "colgroup", "data", "datalist", "dd", "del", "details", "dfn", "dialog", "div", "dl", "dt",
         "em", "fieldset", "figcaption", "figure", "footer", "form", "h1", "h2", "h3", "h4", "h5", "h6", "head", "header",
         "hgroup", "html", "i", "iframe", "ins", "kbd", "label", "legend", "li", "main", "map", "mark", "menu", "meter", "nav",
         "noscript", "object", "ol", "optgroup", "option", "output", "p", "picture", "portal", "pre", "progress", "q", "rp",
         "rt", "ruby", "s", "samp", "script", "search", "section", "select", "slot", "small", "span", "strong", "style", "sub",
         "summary", "sup", "table", "tbody", "td", "template", "textarea", "tfoot", "th", "thead", "time", "title", "tr", "u",
         "ul", "var", "video"]
end

# Ruby: method_name: :animate_motion for animateMotion
def method_name(name) = ActiveSupport::Inflector.underscore(name)

require "../../../activesupport/active_support/inflector"

out = String["module ActionView", "  module Helpers", "    module TagHelper", "      class TagBuilder"]
Array.each(void_elements) do |name|
  Array.push(out, "        def #{method_name(name)}(b, escape: true, **options) = self_closing_tag_string(b, #{Kernel.inspect(name)}, options, escape, \">\")")
end
Array.each(self_closing_elements) do |name|
  Array.push(out, "        def #{method_name(name)}(b, content = nil, escape: true, **options)",
             "          return tag_string(b, #{Kernel.inspect(name)}, content, options, escape) { yield } if block_given?",
             "          content ? tag_string(b, #{Kernel.inspect(name)}, content, options, escape) : self_closing_tag_string(b, #{Kernel.inspect(name)}, options, escape)",
             "        end")
end
Array.each(elements) do |name|
  Array.push(out, "        def #{name}(b, content = nil, escape: true, **options)",
             "          return tag_string(b, #{Kernel.inspect(name)}, content, options, escape) { yield } if block_given?",
             "          tag_string(b, #{Kernel.inspect(name)}, content, options, escape)",
             "        end")
end
Array.push(out, "      end", "    end", "  end", "end")
puts Array.join(out, "\n")
