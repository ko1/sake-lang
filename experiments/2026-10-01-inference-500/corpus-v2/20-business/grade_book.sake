Assignment = Struct.new(:name, :category, :max_points)
Student = Struct.new(:name, :scores)

def weights = Hash[homework: 0.3, exam: 0.5, project: 0.2]

def letter(pct)
  if pct >= 90 then "A"
  elsif pct >= 80 then "B"
  elsif pct >= 70 then "C"
  elsif pct >= 60 then "D"
  else "F"
  end
end

def parse_roster(text)
  lines = String.lines(text)
  header = String.split(String.strip(Array.shift(lines)), ",")
  Array.shift(header)
  assignments = Array.map(header) do |h|
    name, cat, max = String.split(h, ":")
    Assignment.new(name, String.to_sym(cat), String.to_i(max))
  end
  students = Array.map(lines) do |line|
    cells = String.split(String.strip(line), ",")
    name = Array.shift(cells)
    scores = Hash[]
    Array.each_with_index(assignments) do |a, i|
      cell = cells[i]
      scores[Assignment.name(a)] = (cell == nil || cell == "-") ? nil : String.to_f(cell)
    end
    Student.new(name, scores)
  end
  [assignments, students]
end

# percentage in one category; missing work counts as zero, lowest homework is dropped
def category_pct(student, assignments, category)
  items = Array.select(assignments) { |a| Assignment.category(a) == category }
  return nil if Array.empty?(items)
  pcts = Array.map(items) do |a|
    s = Student.scores(student)[Assignment.name(a)]
    (s || 0.0) / Assignment.max_points(a) * 100
  end
  if category == :homework && Array.size(pcts) > 2
    lowest = Array.min(pcts)
    Array.delete_at(pcts, Array.index(pcts, lowest))
  end
  Array.sum(pcts) / Array.size(pcts)
end

def final_pct(student, assignments)
  total = 0.0
  used = 0.0
  Hash.each(weights) do |cat, w|
    pct = category_pct(student, assignments, cat)
    next unless pct
    total += pct * w
    used += w
  end
  total / used
end

def median(xs)
  s = Array.sort(xs)
  n = Array.size(s)
  Integer.odd?(n) ? s[n / 2] : (s[n / 2 - 1] + s[n / 2]) / 2.0
end

def stddev(xs)
  mean = Array.sum(xs) / Array.size(xs)
  Math.sqrt(Array.sum(Array.map(xs) { |x| (x - mean) ** 2 }) / Array.size(xs))
end

roster = <<~CSV
  name,hw1:homework:10,hw2:homework:10,hw3:homework:10,mid:exam:50,proj:project:40,final:exam:100
  Avery,9,10,8,41,35,88
  Blake,7,-,9,30,28,71
  Casey,10,10,10,48,39,95
  Devon,5,6,4,22,30,55
  Emery,8,9,-,38,-,79
  Finley,6,8,7,35,33
CSV

assignments, students = parse_roster(roster)

puts(format("%-8s %6s %6s %6s %7s  %s", "student", "hw", "exam", "proj", "final", "grade"))
finals = Hash[]
Array.each(students) do |st|
  hw = category_pct(st, assignments, :homework)
  ex = category_pct(st, assignments, :exam)
  pr = category_pct(st, assignments, :project)
  f = final_pct(st, assignments)
  finals[Student.name(st)] = f
  puts(format("%-8s %6.1f %6.1f %6.1f %7.2f  %s", Student.name(st), hw, ex, pr, f, letter(f)))
end

puts
puts("Missing work:")
Array.each(students) do |st|
  missing = Array.select(assignments) { |a| Student.scores(st)[Assignment.name(a)] == nil }
  next if Array.empty?(missing)
  puts("  #{Student.name(st)}: #{Array.join(Array.map(missing) { |a| Assignment.name(a) }, ", ")}")
end

puts
values = Hash.values(finals)
puts(format("mean %.2f  median %.2f  stddev %.2f", Array.sum(values) / Array.size(values), median(values), stddev(values)))

best_name, best = Hash.max_by(finals) { |n, f| f }
puts(format("top: %s (%.2f)", best_name, best))

distribution = Array.tally(Array.map(values) { |f| letter(f) })
puts("grades: " + Array.join(Array.map(Array.sort(Hash.keys(distribution))) { |g| "#{g}=#{distribution[g]}" }, " "))

# curve: lift everyone so that the top score becomes 100, but never more than 8 points
bump = Float.clamp(100.0 - best, 0.0, 8.0)
puts(format("curve +%.2f", bump))
changed = Hash.select(finals) { |n, f| letter(f) != letter(f + bump) }
Hash.each(changed) { |n, f| puts("  #{n}: #{letter(f)} -> #{letter(f + bump)}") }

per_assignment = Array.map(assignments) do |a|
  got = Array.filter_map(students) { |st| Student.scores(st)[Assignment.name(a)] }
  [Assignment.name(a), Array.sum(got) / Array.size(got) / Assignment.max_points(a) * 100]
end
hardest, pct = Array.min_by(per_assignment) { |n, p| p }
puts(format("hardest assignment: %s (avg %.1f%%)", hardest, pct))
