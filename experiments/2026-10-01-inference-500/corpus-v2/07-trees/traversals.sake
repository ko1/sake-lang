BT = Struct.new(:label, :left, :right)

def balanced(labels)
  return nil if Array.empty?(labels)
  mid = Array.size(labels) / 2
  BT.new(labels[mid], balanced(Array.take(labels, mid)), balanced(Array.drop(labels, mid + 1)))
end

def recursive(node, order, out)
  return out if node == nil
  Array.push(out, BT.get_label(node)) if order == :pre
  recursive(BT.get_left(node), order, out)
  Array.push(out, BT.get_label(node)) if order == :in
  recursive(BT.get_right(node), order, out)
  Array.push(out, BT.get_label(node)) if order == :post
  out
end

def iter_preorder(root)
  out = Array[]
  stack = Array[root]
  until Array.empty?(stack)
    n = Array.pop(stack)
    next if n == nil
    Array.push(out, BT.get_label(n))
    Array.push(stack, BT.get_right(n), BT.get_left(n))
  end
  out
end

def iter_inorder(root)
  out = Array[]
  stack = Array[]
  cur = root
  while cur || !Array.empty?(stack)
    while cur
      Array.push(stack, cur)
      cur = BT.get_left(cur)
    end
    n = Array.pop(stack)
    Array.push(out, BT.get_label(n))
    cur = BT.get_right(n)
  end
  out
end

def iter_postorder(root)
  out = Array[]
  stack = Array[root]
  until Array.empty?(stack)
    n = Array.pop(stack)
    next if n == nil
    Array.unshift(out, BT.get_label(n))
    Array.push(stack, BT.get_left(n), BT.get_right(n))
  end
  out
end

def levels(root)
  result = Array[]
  level = Array.compact(Array[root])
  until Array.empty?(level)
    Array.push(result, Array.map(level) { |n| BT.get_label(n) })
    level = Array.compact(Array.flat_map(level) { |n| Array[BT.get_left(n), BT.get_right(n)] })
  end
  result
end

def vertical(root)
  cols = Hash[]
  queue = Array[[root, 0]]
  until Array.empty?(queue)
    n, col = Array.shift(queue)
    next if n == nil
    cols[col] = Array[] unless Hash.key?(cols, col)
    Array.push(cols[col], BT.get_label(n))
    Array.push(queue, [BT.get_left(n), col - 1], [BT.get_right(n), col + 1])
  end
  Array.map(Array.sort(Hash.keys(cols))) { |c| [c, cols[c]] }
end

def path_to(node, label, path)
  return false if node == nil
  Array.push(path, BT.get_label(node))
  return true if BT.get_label(node) == label
  return true if path_to(BT.get_left(node), label, path) || path_to(BT.get_right(node), label, path)
  Array.pop(path)
  false
end

def parents(node, map)
  return map if node == nil
  Array.each(Array[BT.get_left(node), BT.get_right(node)]) do |c|
    next if c == nil
    map[BT.get_label(c)] = node
    parents(c, map)
  end
  map
end

def find(node, label)
  return nil if node == nil
  return node if BT.get_label(node) == label
  find(BT.get_left(node), label) || find(BT.get_right(node), label)
end

def at_distance(root, label, k)
  up = parents(root, Hash[])
  start = find(root, label)
  return Array[] if start == nil
  seen = Set[label]
  frontier = Array[start]
  Integer.times(k) do
    frontier = Array.flat_map(frontier) { |n| Array[BT.get_left(n), BT.get_right(n), up[BT.get_label(n)]] }
      .Array.compact
      .Array.select { |m| Set.add?(seen, BT.get_label(m)) }
  end
  Array.sort(Array.map(frontier) { |n| BT.get_label(n) })
end

root = balanced(String.chars("ABCDEFGHIJKL"))
Array.each(Array[:pre, :in, :post]) do |order|
  rec = Array.join(recursive(root, order, Array[]))
  it = case order
       in :pre then iter_preorder(root)
       in :in then iter_inorder(root)
       else iter_postorder(root)
       end
  its = Array.join(it)
  puts(format("%-5s %s %s", Symbol.to_s(order), rec, rec == its ? "(iterative agrees)" : "(iterative: #{its})"))
end
lv = levels(root)
puts("levels: #{Array.join(Array.map(lv) { |l| Array.join(l) }, " | ")}")
zig = Array[]
Array.each_with_index(lv) { |l, i| Array.push(zig, Integer.odd?(i) ? Array.reverse(l) : l) }
puts("zigzag: #{Array.join(Array.map(zig) { |l| Array.join(l) }, " | ")}")
puts("left view: #{Array.join(Array.map(lv) { |l| Array.first(l) })}, right view: #{Array.join(Array.map(lv) { |l| Array.last(l) })}")
puts("widest level: #{Array.max(Array.map(lv) { |l| Array.size(l) })}")
Array.each(vertical(root)) { |col, labels| puts(format("  column %2d: %s", col, Array.join(labels, " "))) }
Array.each(Array["J", "A", "Z"]) do |target|
  path = Array[]
  found = path_to(root, target, path)
  puts("path to #{target}: #{found ? Array.join(path, " > ") : "not found"}")
end
Array.each(Array[["C", 2], ["G", 1], ["L", 3], ["Q", 1]]) do |label, k|
  near = at_distance(root, label, k)
  puts("distance #{k} from #{label}: #{Array.empty?(near) ? "(none)" : Array.join(near, " ")}")
end
