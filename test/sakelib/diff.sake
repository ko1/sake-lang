require "diff"

def show_hunks(label, hunks)
  puts("#{label}:")
  Array.each(hunks) { |h| puts("  #{Kernel.inspect(h)}") }
end

seq1 = Array["a", "b", "c", "e", "h", "j", "l", "m", "n", "p"]
seq2 = Array["b", "c", "d", "e", "f", "j", "k", "l", "m", "r", "s", "t"]

puts("== lcs")
p(Diff::LCS.lcs(seq1, seq2))
p(Diff::LCS.lcs("abcxyz", "xbczya"))
p(Diff::LCS.lcs(Array[1, 2, 3], Array[4, 5]))
p(Diff::LCS.lcs(Array[], Array[1]))

puts("== diff")
d = Diff::LCS.diff(seq1, seq2)
show_hunks("seq", d)
show_hunks("strings", Diff::LCS.diff("abcd", "acbd"))
show_hunks("same", Diff::LCS.diff("same", "same"))
show_hunks("to empty", Diff::LCS.diff(Array[1, 2], Array[]))
Array.each(Array.first(d) || Array[]) do |c|
  p([Diff::LCS::Change.action(c), Diff::LCS::Change.position(c), Diff::LCS::Change.element(c), Diff::LCS::Change.adding?(c), Diff::LCS::Change.deleting?(c)])
end

puts("== sdiff")
s = Diff::LCS.sdiff(seq1, seq2)
Array.each(s) { |c| p(c) }
p(Array.map(Diff::LCS.sdiff("abc", "axc")) { |c| Diff::LCS::ContextChange.to_a(c) })
p(Array.count(s) { |c| Diff::LCS::ContextChange.changed?(c) })
p(Array.map(Diff::LCS.sdiff(Array[], Array["x"])) { |c| Diff::LCS::ContextChange.to_a(c) })

puts("== traverse")
Diff::LCS.traverse_sequences("abc", "bcd") { |kind, i, j| puts("#{kind} #{i} #{j}") }
Diff::LCS.traverse_balanced("abc", "xbz") { |kind, i, j| puts("#{kind} #{i} #{j}") }

puts("== patch")
p(Diff::LCS.patch(seq1, d) == seq2)
p(Diff::LCS.unpatch(seq2, d) == seq1)
p(Diff::LCS.patch(seq1, s) == seq2)
p(Diff::LCS.unpatch(seq2, s) == seq1)
p(Diff::LCS.patch("kitten", Diff::LCS.diff("kitten", "sitting")))
p(Diff::LCS.patch("kitten", Diff::LCS.sdiff("kitten", "sitting")))
p(Diff::LCS.unpatch("sitting", Diff::LCS.diff("kitten", "sitting")))
p(Diff::LCS.patch("abc", Array[]))

puts("== lines")
old = String.lines("one\ntwo\nthree\nfour\nfive\n")
nw = String.lines("zero\none\nthree\nfour\n4.5\nfive\n")
Diff::LCS.sdiff(old, nw).Array.each do |c|
  case Diff::LCS::ContextChange.action(c)
  in "=" then print("  ", Diff::LCS::ContextChange.old_element(c))
  in "-" then print("- ", Diff::LCS::ContextChange.old_element(c))
  in "+" then print("+ ", Diff::LCS::ContextChange.new_element(c))
  in "!"
    print("- ", Diff::LCS::ContextChange.old_element(c))
    print("+ ", Diff::LCS::ContextChange.new_element(c))
  end
end
words = Diff::LCS.lcs(String.split("the quick brown fox jumps", " "), String.split("the slow brown dog jumps high", " "))
p(words)

puts("== errors")
begin
  actions = Array[:bad, "-"]
  Diff::LCS::Change.new(actions[0], 0, "x")
rescue NoMatchingPatternError => e
  puts("NoMatchingPatternError")
end
