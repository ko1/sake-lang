require "concurrent_ruby"

# Deterministic: every thread is joined or waited for before its result is printed; results of
# concurrent work are sorted or counted.

# 1. Future
puts "-- Future"
f = Concurrent::Future.execute { 1 + 1 }
p Concurrent::Future.value(f)
p Concurrent::Future.state(f)
p Concurrent::Future.fulfilled?(f)
p Concurrent::Future.rejected?(f)
p Concurrent::Future.reason(f)
p Concurrent::Future.value(f, 0.1)
g = Concurrent::Future.execute { raise "boom" }
Concurrent::Future.wait(g)
p Concurrent::Future.value(g)
p Concurrent::Future.state(g)
r = Concurrent::Future.reason(g)
puts(r == nil ? "no reason" : Exception.message(r))
p Concurrent::Future.rejected?(g)
begin
  Concurrent::Future.value!(g)
rescue RuntimeError => e
  puts "value! raised: #{Exception.message(e)}"
end
h = Concurrent::Future.execute do
  sleep 0.3
  :late
end
p Concurrent::Future.value(h, 0.01)   # not yet
p Concurrent::Future.complete?(h)
Concurrent::Future.wait(h)
p Concurrent::Future.value(h)
p Concurrent::Future.complete?(h)

# 2. Promise: then / rescue / zip / fulfill / reject
puts "-- Promise"
pr = Concurrent::Promise.execute { 10 }
# A promise's value has no type of its own (one field for every promise), so the block states it.
c = Concurrent::Promise.then(pr) do |v|
  v => Integer
  v * 2
end
d = Concurrent::Promise.then(c) do |v|
  v => Integer
  v + 1
end
p Concurrent::Promise.value(d)
p Concurrent::Promise.value(c)
p Concurrent::Promise.value(pr)
p Concurrent::Promise.state(d)
bad = Concurrent::Promise.then(Concurrent::Promise.execute { raise "bad" }) do |v|
  v => Integer
  v * 2
end
Concurrent::Promise.wait(bad)
p Concurrent::Promise.state(bad)
r2 = Concurrent::Promise.reason(bad)
puts(r2 == nil ? "no reason" : Exception.message(r2))
p Concurrent::Promise.value(bad)
res = Concurrent::Promise.rescue(Concurrent::Promise.execute { raise "bad" }) { |reason| "rescued #{Exception.message(reason)}" }
p Concurrent::Promise.value(res)
p Concurrent::Promise.state(res)
p Concurrent::Promise.value(Concurrent::Promise.rescue(Concurrent::Promise.execute { 5 }) { |reason| 0 })
z = Concurrent::Promise.zip(Concurrent::Promise.execute { 1 }, Concurrent::Promise.execute { 2 }, Concurrent::Promise.execute { 3 })
p Concurrent::Promise.value(z)
p Concurrent::Promise.value(Concurrent::Promise.fulfilled(3))
rj = Concurrent::Promise.reason(Concurrent::Promise.rejected(RuntimeError.new("x")))
puts(rj == nil ? "no reason" : Exception.message(rj))
t = Concurrent::Promise.then(Concurrent::Promise.execute { 1 }) { |v| raise "in then" }
Concurrent::Promise.wait(t)
rt = Concurrent::Promise.reason(t)
puts(rt == nil ? "no reason" : Exception.message(rt))

# 3. Atom, AtomicFixnum, AtomicBoolean, AtomicReference
puts "-- Atom"
a = Concurrent::Atom.new(0)
p Concurrent::Atom.value(a)
p Concurrent::Atom.swap(a) { |v| v + 1 }
p Concurrent::Atom.compare_and_set(a, 1, 5)
p Concurrent::Atom.compare_and_set(a, 1, 7)
p Concurrent::Atom.value(a)
p Concurrent::Atom.reset(a, 9)
p Concurrent::Atom.value(a)

n = Concurrent::AtomicFixnum.new(5)
p Concurrent::AtomicFixnum.increment(n)
p Concurrent::AtomicFixnum.increment(n, 3)
p Concurrent::AtomicFixnum.decrement(n)
p Concurrent::AtomicFixnum.value(n)
p Concurrent::AtomicFixnum.compare_and_set(n, 8, 1)
p Concurrent::AtomicFixnum.value(n)
p Concurrent::AtomicFixnum.update(n) { |v| v * 10 }
p Concurrent::AtomicFixnum.set_value(n, 3)
p Concurrent::AtomicFixnum.value(n)
# 4 threads x 1000 increments
counter = Concurrent::AtomicFixnum.new
ts = Array.map(Range.to_a(1..4)) do |i|
  Thread.new { Integer.times(1000) { Concurrent::AtomicFixnum.increment(counter) } }
end
Array.each(ts) { |th| Thread.join(th) }
p Concurrent::AtomicFixnum.value(counter)

b = Concurrent::AtomicBoolean.new
p Concurrent::AtomicBoolean.value(b)
p Concurrent::AtomicBoolean.make_true(b)
p Concurrent::AtomicBoolean.make_true(b)
p Concurrent::AtomicBoolean.true?(b)
p Concurrent::AtomicBoolean.false?(b)
p Concurrent::AtomicBoolean.make_false(b)
p Concurrent::AtomicBoolean.set_value(b, true)
p Concurrent::AtomicBoolean.value(b)

ar = Concurrent::AtomicReference.new(:a)   # Symbols: the gem's compare_and_set compares by identity
p Concurrent::AtomicReference.get(ar)
p Concurrent::AtomicReference.set(ar, :b)
p Concurrent::AtomicReference.get_and_set(ar, :c)
p Concurrent::AtomicReference.get(ar)
p Concurrent::AtomicReference.compare_and_set(ar, :c, :d)
p Concurrent::AtomicReference.value(ar)
p Concurrent::AtomicReference.update(ar) { |v| String.to_sym(Symbol.to_s(v) + "!") }

# 4. Map
puts "-- Map"
m = Concurrent::Map.new
p Concurrent::Map.put_if_absent(m, :a, 1)
p Concurrent::Map.put_if_absent(m, :a, 2)
p m[:a]
p Concurrent::Map.compute_if_absent(m, :b) { 7 }
p Concurrent::Map.compute_if_absent(m, :b) { 8 }
p Concurrent::Map.fetch(m, :b)
p Concurrent::Map.fetch(m, :c, 0)
p Concurrent::Map.fetch(m, :c) { |k| "no #{k}" }
begin
  Concurrent::Map.fetch(m, :zz)
rescue KeyError => e
  puts "KeyError: #{Exception.message(e)}"
end
p Concurrent::Map.key?(m, :a)
p Concurrent::Map.keys(m)
p Concurrent::Map.values(m)
p Concurrent::Map.size(m)
p Concurrent::Map.delete(m, :a)
p Concurrent::Map.delete(m, :a)
p Concurrent::Map.fetch_or_store(m, :d) { 4 }
p Concurrent::Map.fetch_or_store(m, :d, 5)
p Concurrent::Map.get_and_set(m, :d, 6)
p Concurrent::Map.compute(m, :d) { |v| (v == nil ? 0 : v) + 1 }
p Concurrent::Map.compute_if_present(m, :zz) { |v| v + 1 }
p Concurrent::Map.compute_if_present(m, :d) { |v| v + 1 }
p Concurrent::Map.replace_if_exists(m, :d, 0)
p Concurrent::Map.replace_if_exists(m, :nope, 0)
p Concurrent::Map.replace_pair(m, :d, 0, 1)
p Concurrent::Map.replace_pair(m, :d, 0, 2)
p Concurrent::Map.delete_pair(m, :d, 9)
p Concurrent::Map.delete_pair(m, :d, 1)
p Concurrent::Map.empty?(m)
p Concurrent::Map.merge_pair(m, :x, 1) { |old| old + 1 }
p Concurrent::Map.merge_pair(m, :x, 1) { |old| old + 1 }
m[:q] = 3
p m[:q]
p Concurrent::Map.key(m, 3)
p Concurrent::Map.value?(m, 3)
pairs = Array[]
Concurrent::Map.each_pair(m) { |k, v| Array.push(pairs, "#{k}=#{v}") }
p Array.sort(pairs)
# compute_if_absent from 4 threads computes once
calls = Concurrent::AtomicFixnum.new
shared = Concurrent::Map.new
ts = Array.map(Range.to_a(1..4)) do |i|
  Thread.new do
    Integer.times(100) do |j|
      Concurrent::Map.compute_if_absent(shared, j) do
        Concurrent::AtomicFixnum.increment(calls)
        j * j
      end
    end
  end
end
Array.each(ts) { |th| Thread.join(th) }
p Concurrent::AtomicFixnum.value(calls)
p Concurrent::Map.size(shared)
p shared[7]

# 5. CountDownLatch
puts "-- CountDownLatch"
l = Concurrent::CountDownLatch.new(3)
p Concurrent::CountDownLatch.count(l)
p Concurrent::CountDownLatch.wait(l, 0.01)
done = Array[]
lock = Mutex.new
ts = Array.map(Range.to_a(1..3)) do |i|
  Thread.new do
    Mutex.synchronize(lock) { Array.push(done, i) }
    Concurrent::CountDownLatch.count_down(l)
  end
end
p Concurrent::CountDownLatch.wait(l)
p Array.sort(done)
p Concurrent::CountDownLatch.count(l)
p Concurrent::CountDownLatch.wait(l, 0.01)
Array.each(ts) { |th| Thread.join(th) }
Concurrent::CountDownLatch.count_down(l)
p Concurrent::CountDownLatch.count(l)

# 6. Semaphore
puts "-- Semaphore"
s = Concurrent::Semaphore.new(2)
p Concurrent::Semaphore.available_permits(s)
p Concurrent::Semaphore.acquire(s)
p Concurrent::Semaphore.try_acquire(s)
p Concurrent::Semaphore.try_acquire(s)
p Concurrent::Semaphore.try_acquire(s, 1, 0.01)
p Concurrent::Semaphore.release(s)
p Concurrent::Semaphore.available_permits(s)
p Concurrent::Semaphore.drain_permits(s)
p Concurrent::Semaphore.available_permits(s)
p Concurrent::Semaphore.release(s, 3)
p Concurrent::Semaphore.available_permits(s)
p Concurrent::Semaphore.acquire(s, 2)
p Concurrent::Semaphore.available_permits(s)
# at most 2 of 6 workers inside at once
sem = Concurrent::Semaphore.new(2)
inside = Concurrent::AtomicFixnum.new
peak = Concurrent::AtomicFixnum.new
ts = Array.map(Range.to_a(1..6)) do |i|
  Thread.new do
    Concurrent::Semaphore.acquire(sem)
    now = Concurrent::AtomicFixnum.increment(inside)
    Concurrent::AtomicFixnum.update(peak) { |v| now > v ? now : v }
    sleep 0.01
    Concurrent::AtomicFixnum.decrement(inside)
    Concurrent::Semaphore.release(sem)
  end
end
Array.each(ts) { |th| Thread.join(th) }
p Concurrent::AtomicFixnum.value(peak) <= 2
p Concurrent::AtomicFixnum.value(peak) >= 1
p Concurrent::Semaphore.available_permits(sem)
# a waiter with a timeout gets the permit when it is released in time
sem2 = Concurrent::Semaphore.new(0)
waiter = Thread.new { Concurrent::Semaphore.try_acquire(sem2, 1, 2) }
sleep 0.02
Concurrent::Semaphore.release(sem2)
p Thread.value(waiter)
p Concurrent::Semaphore.available_permits(sem2)

# 7. Event
puts "-- Event"
ev = Concurrent::Event.new
p Concurrent::Event.set?(ev)
p Concurrent::Event.wait(ev, 0.01)
w = Thread.new { Concurrent::Event.wait(ev) }
p Concurrent::Event.set(ev)
p Thread.value(w)
p Concurrent::Event.set?(ev)
p Concurrent::Event.wait(ev)
p Concurrent::Event.wait(ev, 0.01)
p Concurrent::Event.try?(ev)
p Concurrent::Event.reset(ev)
p Concurrent::Event.set?(ev)
p Concurrent::Event.try?(ev)

# 8. FixedThreadPool
puts "-- FixedThreadPool"
pool = Concurrent::FixedThreadPool.new(2)
p Concurrent::FixedThreadPool.max_length(pool)
p Concurrent::FixedThreadPool.running?(pool)
results = Queue.new
busy = Concurrent::AtomicFixnum.new
peak = Concurrent::AtomicFixnum.new
# The posted block runs later and reads `i` as it is then; a function parameter is per call
# (notes/concurrent_ruby_bug_yield_in_thread_loop_var.sake).
def post_square(pool, results, busy, peak, i)
  Concurrent::FixedThreadPool.post(pool) do
    now = Concurrent::AtomicFixnum.increment(busy)
    Concurrent::AtomicFixnum.update(peak) { |v| now > v ? now : v }
    sleep 0.01
    Concurrent::AtomicFixnum.decrement(busy)
    Queue.push(results, i * i)
  end
end
Integer.times(6) { |i| p post_square(pool, results, busy, peak, i) }
Concurrent::FixedThreadPool.post(pool) { raise "a task failing does not stop the pool" }
Concurrent::FixedThreadPool.shutdown(pool)
p Concurrent::FixedThreadPool.running?(pool)
p Concurrent::FixedThreadPool.wait_for_termination(pool, 5)
p Concurrent::FixedThreadPool.shutdown?(pool)
p Concurrent::FixedThreadPool.completed_task_count(pool)
p Concurrent::FixedThreadPool.scheduled_task_count(pool)
p Concurrent::FixedThreadPool.length(pool)
got = Array[]
Array.push(got, Queue.pop(results)) until Queue.empty?(results)
p Array.sort(Array.compact(got)) # Queue.pop may be nil, and nil cannot be sorted
p Concurrent::AtomicFixnum.value(peak) <= 2
begin
  Concurrent::FixedThreadPool.post(pool) { 1 }
rescue Concurrent::RejectedExecutionError => e
  puts "rejected: #{Exception.message(e)}"
end
p Concurrent::FixedThreadPool.wait_for_termination(pool)

# 9. ScheduledTask
puts "-- ScheduledTask"
st = Concurrent::ScheduledTask.execute(0.5) { :never }
p Concurrent::ScheduledTask.pending?(st)
p Concurrent::ScheduledTask.cancel(st)
# (the gem's cancelled? is false after cancel, its state being :rejected; Sake's says true; not compared)
p Concurrent::ScheduledTask.value(st)
p Concurrent::ScheduledTask.cancel(st)
st2 = Concurrent::ScheduledTask.execute(0.01) { :done }
p Concurrent::ScheduledTask.value(st2)
p Concurrent::ScheduledTask.fulfilled?(st2)
p Concurrent::ScheduledTask.cancel(st2)

# 10. Concurrent::IVar
puts "-- IVar"
iv = Concurrent::IVar.new
p Concurrent::IVar.pending?(iv)
waiter = Thread.new { Concurrent::IVar.value(iv) }
Concurrent::IVar.set(iv, 3)
p Thread.value(waiter)
p Concurrent::IVar.value(iv)
p Concurrent::IVar.complete?(iv)
p Concurrent::IVar.fulfilled?(iv)
begin
  Concurrent::IVar.set(iv, 4)
rescue Concurrent::MultipleAssignmentError => e
  puts "second set: #{Exception.message(e)}"
end
p Concurrent::IVar.try_set(iv, 5)
p Concurrent::IVar.value(iv)
iv2 = Concurrent::IVar.new
Concurrent::IVar.fail(iv2, RuntimeError.new("f"))
p Concurrent::IVar.rejected?(iv2)
rf = Concurrent::IVar.reason(iv2)
puts(rf == nil ? "no reason" : Exception.message(rf))
p Concurrent::IVar.value(iv2)
