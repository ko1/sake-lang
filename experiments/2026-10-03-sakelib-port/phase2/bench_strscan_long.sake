# strscan, the copy-sensitive case: 3000 steps at the head of a 1 MB String, each a failing
# check(/b/) (no "b" anywhere) and a scan(/a/).
require "strscan"
ss = StringScanner.new(String.*("a", 1000000))
n = 0
Range.each(0...3000) do |i|
  n += 1 if StringScanner.check(ss, /b/)
  StringScanner.scan(ss, /a/)
end
p([n, StringScanner.pos(ss)])
