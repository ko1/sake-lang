# 2D transform pipeline with Floats, in homogeneous coordinates (3x3).
def rotate(deg)
  t = deg * Math.atan(1) * 4 / 180.0
  c = Math.cos(t)
  s = Math.sin(t)
  Mat.of(Array[Array[c, -s, 0.0], Array[s, c, 0.0], Array[0.0, 0.0, 1.0]])
end
def translate(dx, dy) = Mat.of(Array[Array[1.0, 0.0, dx * 1.0], Array[0.0, 1.0, dy * 1.0], Array[0.0, 0.0, 1.0]])
def scale(sx, sy) = Mat.of(Array[Array[sx * 1.0, 0.0, 0.0], Array[0.0, sy * 1.0, 0.0], Array[0.0, 0.0, 1.0]])
def pt(x, y) = Vec.of(Array[x * 1.0, y * 1.0, 1.0])

square = Vec[pt(0, 0), pt(1, 0), pt(1, 1), pt(0, 1)]
# Applied right to left: scale by 2, rotate 90 degrees, then move by (5, 0).
pipeline = translate(5, 0) * rotate(90) * scale(2, 2)
puts("pipeline =")
puts(pipeline)
Array.each(square) { |v| puts("#{v} -> #{pipeline * v}") }

back = Mat.inverse(pipeline)
if back
  Array.each(square) do |v|
    w = back * (pipeline * v)
    d = w - v
    puts("round trip #{v}: error #{format("%.2e", Math.sqrt(d * d))}")
  end
end
puts("det(pipeline) = #{la_fmt(Mat.det(pipeline))}  (area scale 4)")

# Rotating 360 degrees in 1-degree steps drifts away from the identity in Floats.
step = rotate(1)
full = step ** 360
drift = full - Mat.identity(3)
worst = 0.0
Integer.times(3) { |i| Integer.times(3) { |j| e = la_abs(Mat.at(drift, i, j)); worst = e if e > worst } }
puts("rotate(1)**360 - I: largest entry #{format("%.2e", worst)}")
