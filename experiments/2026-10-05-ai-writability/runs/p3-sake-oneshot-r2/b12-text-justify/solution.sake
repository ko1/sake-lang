def pieces(word, w)
  out = Array[]
  rest = word
  while String.size(rest) > w
    Array.push(out, rest[0, w - 1] + "-")
    rest = rest[w - 1, String.size(rest) - (w - 1)]
  end
  Array.push(out, rest)
  out
end

def layout(words, w)
  lines = Array[]
  cur = Array[]
  len = 0
  Array.each(words) do |wd|
    sz = String.size(wd)
    if Array.empty?(cur)
      cur = Array[wd]
      len = sz
    elsif len + 1 + sz <= w
      Array.push(cur, wd)
      len += 1 + sz
    else
      Array.push(lines, cur)
      cur = Array[wd]
      len = sz
    end
  end
  Array.push(lines, cur) unless Array.empty?(cur)
  lines
end

def justify(ws, w)
  n = Array.size(ws)
  letters = Array.sum(Array.map(ws) { String.size(it) })
  total = w - letters
  gaps = n - 1
  base = total / gaps
  extra = total % gaps
  out = ""
  Array.each_with_index(ws) do |wd, i|
    out += wd
    if i < gaps
      out += " " * (base + (i < extra ? 1 : 0))
    end
  end
  out
end

def render_para(words, w)
  ws = Array[]
  Array.each(words) { |wd| Array.concat(ws, pieces(wd, w)) }
  lines = layout(ws, w)
  out = Array[]
  last = Array.size(lines) - 1
  Array.each_with_index(lines) do |ln, i|
    s = (i == last || Array.size(ln) == 1) ? Array.join(ln, " ") : justify(ln, w)
    Array.push(out, "|" + String.ljust(s, w) + "|")
  end
  out
end

def run(lines, w)
  paras = Array[]
  cur = nil
  kwords = 0
  Array.each(Array.drop(lines, 1)) do |ln|
    ws = String.split(ln, " ")
    if Array.empty?(ws)
      cur = nil
    else
      kwords += Array.size(ws)
      if cur == nil
        cur = Array[]
        Array.push(paras, cur)
      end
      Array.concat(cur, ws)
    end
  end
  puts("+" + "-" * w + "+")
  total_lines = 0
  Array.each_with_index(paras) do |words, i|
    puts("|" + " " * w + "|") if i > 0
    rl = render_para(words, w)
    total_lines += Array.size(rl)
    Array.each(rl) { |s| puts(s) }
  end
  puts("+" + "-" * w + "+")
  puts("paragraphs: #{Array.size(paras)}, lines: #{total_lines}, words: #{kwords}")
end

lines = String.lines(IO.read(IO.stdin))
ok = false
width = 0
if !Array.empty?(lines)
  first = String.strip(lines[0])
  if String.match?(first, /\A\d+\z/)
    width = String.to_i(first)
    ok = width >= 2 && width <= 80
  end
end
if ok
  run(lines, width)
else
  puts("invalid width")
end
