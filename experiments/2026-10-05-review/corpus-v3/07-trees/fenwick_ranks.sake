class Fenwick
  attr_reader size, tree = nil

  def initialize(f) = @tree = Array.new(@size + 1, 0)

  def lowbit(i) = i & -i

  def add(f, i, delta)
    i += 1
    while i <= @size
      @tree[i] += delta
      i += lowbit(i)
    end
  end

  # sum of positions 0..i
  def prefix(f, i)
    i += 1
    s = 0
    while i > 0
      s += @tree[i]
      i -= lowbit(i)
    end
    s
  end

  def range(f, lo, hi) = lo > hi ? 0 : prefix(f, hi) - (lo == 0 ? 0 : prefix(f, lo - 1))

  # smallest index whose prefix sum reaches k (k >= 1)
  def find_kth(f, k)
    pos = 0
    step = 1
    step *= 2 while step * 2 <= @size
    while step > 0
      if pos + step <= @size && @tree[pos + step] < k
        pos += step
        k -= @tree[pos]
      end
      step /= 2
    end
    pos < @size ? pos : nil
  end
end

def count_inversions(values)
  sorted = Array.uniq(Array.sort(values))
  rank = Hash[]
  Array.each_with_index(sorted) { |v, i| rank[v] = i }
  bit = Fenwick.new(Array.size(sorted))
  inversions = 0
  Array.each_with_index(values) do |v, seen|
    r = rank[v]
    inversions += seen - Fenwick.prefix(bit, r)
    Fenwick.add(bit, r, 1)
  end
  inversions
end

def brute_inversions(values)
  n = 0
  Array.each_with_index(values) do |a, i|
    Range.each((i + 1)...Array.size(values)) { |j| n += 1 if a > values[j] }
  end
  n
end

puts("-- inversions --")
samples = Array[Array[3, 1, 2], Array[1, 2, 3, 4], Array[5, 4, 3, 2, 1], Array[8, 4, 2, 1, 4, 8, 3, 3], Array[]]
Array.each(samples) do |s|
  fast = count_inversions(s)
  slow = brute_inversions(s)
  puts("#{Kernel.inspect(s)}: #{fast} #{fast == slow ? "(checked)" : "(MISMATCH #{slow})"}")
end

puts("-- live leaderboard --")
max_score = 100
board = Fenwick.new(max_score + 1)
players = Hash[]
events = Array[["ann", 40], ["bob", 72], ["cy", 55], ["dee", 72], ["ann", 90], ["eve", 12], ["bob", 30], ["fay", 100]]
Array.each(events) do |name, score|
  old = players[name]
  Fenwick.add(board, old, -1) if old != nil
  Fenwick.add(board, score, 1)
  players[name] = score
  better = Fenwick.range(board, score + 1, max_score)
  total = Hash.size(players)
  pct = 100.0 * Fenwick.prefix(board, score) / total
  verb = old == nil ? "joins" : "moves #{old}->"
  puts(format("%-4s %-9s %3d  rank %d of %d  (percentile %.1f)", name, verb, score, better + 1, total, pct))
end

total = Hash.size(players)
median_pos = Fenwick.find_kth(board, (total + 1) / 2)
puts("median score: #{median_pos}")
Array.each(Array[1, total, total + 1]) do |k|
  s = Fenwick.find_kth(board, k)
  puts("#{k}-th lowest: #{s == nil ? "none" : s}")
end
buckets = Array.map(Array[[0, 49], [50, 79], [80, 100]]) { |lo, hi| "#{lo}-#{hi}: #{Fenwick.range(board, lo, hi)}" }
puts("buckets: #{Array.join(buckets, ", ")}")
