# A run-time error in generated code is reported at its origin too (here the template's line 2), and so is each
# frame of Exception.backtrace.
generate "lib/gen/records", "lib/gen/records.txt"
generate "lib/gen/template", "lib/gen/hello.txt"

begin
  render_hello(User.new("baby", 0))
rescue ZeroDivisionError => e
  p(Exception.backtrace(e))
end
puts render_hello(User.new("ko1", 0))
