EmpData = Struct.new(:id, :name, :rate)
ShiftData = Struct.new(:emp_id, :date, :start_min, :end_min, :break_min)

def parse_rate(s)
  return nil if String.empty?(s)
  if String.match(s, /^[0-9]+\.[0-9]{2}$/) == nil
    return nil
  end
  begin
    Float(s)
  rescue
    return nil
  end
end

def valid_emp_id?(s)
  s = s
  String.size(s) == 4 && String.match(s, /^E[0-9]{3}$/) != nil
end

def valid_name?(s)
  String.size(s) >= 1 && String.size(s) <= 10 && String.match(s, /^[A-Za-z]+$/) != nil
end

def is_leap_year?(year)
  (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
end

def days_in_month(year, month)
  case month
  in 1 | 3 | 5 | 7 | 8 | 10 | 12 then 31
  in 4 | 6 | 9 | 11 then 30
  in 2 then is_leap_year?(year) ? 29 : 28
  else 0
  end
end

def parse_date(s)
  return nil if String.empty?(s)
  return nil if String.match(s, /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) == nil
  parts = String.split(s, "-")
  if Array.size(parts) != 3
    return nil
  end
  begin
    year = String.to_i(Array.at(parts, 0))
    month = String.to_i(Array.at(parts, 1))
    day = String.to_i(Array.at(parts, 2))

    return nil if year < 1970 || year > 2099
    return nil if month < 1 || month > 12
    return nil if day < 1 || day > days_in_month(year, month)

    [year, month, day]
  rescue
    return nil
  end
end

def parse_time(s)
  return nil if String.empty?(s)
  return nil if String.match(s, /^[0-9]{2}:[0-9]{2}$/) == nil
  parts = String.split(s, ":")
  if Array.size(parts) != 2
    return nil
  end
  begin
    hour = String.to_i(Array.at(parts, 0))
    minute = String.to_i(Array.at(parts, 1))

    return nil if hour < 0 || hour > 23
    return nil if minute < 0 || minute > 59

    hour * 60 + minute
  rescue
    return nil
  end
end

def minutes_to_hm(minutes)
  hours = minutes / 60
  mins = minutes % 60
  "#{hours}:#{String.rjust(Integer.to_s(mins), 2, "0")}"
end

employees = Hash.new(nil)
shifts = Array[]
line_num = 0

Integer.times(5000) do |_|
  line_str = gets
  break if line_str == nil
  line_num = line_num + 1

  line_str = String.strip(line_str)
  next if String.empty?(line_str)

  parts = String.split(line_str, /\s+/)
  next if Array.size(parts) == 0

  command = Array.first(parts)

  case command
  in "EMP" then
    if Array.size(parts) != 4
      puts("line #{line_num}: error: wrong field count")
    else
      id = Array.at(parts, 1)
      name = Array.at(parts, 2)
      rate_str = Array.at(parts, 3)

      if !valid_emp_id?(id)
        puts("line #{line_num}: error: bad id")
      elsif !valid_name?(name)
        puts("line #{line_num}: error: bad name")
      else
        rate = parse_rate(rate_str)
        if rate == nil || rate <= 0.0
          puts("line #{line_num}: error: bad rate")
        elsif employees[id] != nil
          puts("line #{line_num}: error: duplicate employee ID")
        else
          employees[id] = EmpData.new(id, name, rate)
        end
      end
    end
  in "SHIFT" then
    if Array.size(parts) < 5 || Array.size(parts) > 6
      puts("line #{line_num}: error: wrong field count")
    else
      emp_id = Array.at(parts, 1)
      date_str = Array.at(parts, 2)
      start_str = Array.at(parts, 3)
      end_str = Array.at(parts, 4)
      break_str = if Array.size(parts) == 6 then Array.at(parts, 5) else "0" end

      if !valid_emp_id?(emp_id)
        puts("line #{line_num}: error: bad id")
      elsif employees[emp_id] == nil
        puts("line #{line_num}: error: unknown employee ID")
      else
        date_parts = parse_date(date_str)
        if date_parts == nil
          puts("line #{line_num}: error: bad date")
        else
          start_min = parse_time(start_str)
          if start_min == nil
            puts("line #{line_num}: error: bad time")
          else
            end_min = parse_time(end_str)
            if end_min == nil
              puts("line #{line_num}: error: bad time")
            else
              begin
                break_min = String.to_i(break_str)
                if break_min < 0
                  puts("line #{line_num}: error: bad break")
                else
                  if end_min <= start_min
                    end_min = end_min + 1440
                  end
                  shift_length = end_min - start_min
                  if break_min >= shift_length
                    puts("line #{line_num}: error: bad break")
                  else
                    puts("shift created")
                    Array.push(shifts, ShiftData.new(emp_id, date_parts, start_min, end_min, break_min))
                  end
                end
              rescue
                puts("line #{line_num}: error: bad break")
              end
            end
          end
        end
      end
    end
  else
    puts("line #{line_num}: error: unknown command")
  end
end

employees_list = Array.sort(Hash.keys(employees))
puts(format("%-4s %-10s %8s %8s %10s", "id", "name", "regular", "overtime", "pay"))

total_regular_min = 0
total_overtime_min = 0
total_pay = 0.0

Array.each(employees_list) do |emp_id|
  emp = employees[emp_id]
  regular_min = 0
  overtime_min = 0

  emp_shifts = Array.select(shifts) { |s| ShiftData.emp_id(s) == emp_id }

  Array.each(emp_shifts) do |shift|
    worked_min = ShiftData.end_min(shift) - ShiftData.start_min(shift) - ShiftData.break_min(shift)
    if worked_min > 0
      if worked_min <= 480
        regular_min = regular_min + worked_min
      else
        regular_min = regular_min + 480
        overtime_min = overtime_min + (worked_min - 480)
      end
    end
  end

  pay = (Float(regular_min) * EmpData.rate(emp) + Float(overtime_min) * EmpData.rate(emp) * 1.5) / 60.0
  total_regular_min = total_regular_min + regular_min
  total_overtime_min = total_overtime_min + overtime_min
  total_pay = total_pay + pay

  puts(format("%-4s %-10s %8s %8s %10s",
    EmpData.id(emp),
    EmpData.name(emp),
    minutes_to_hm(regular_min),
    minutes_to_hm(overtime_min),
    format("%.2f", pay)))
end

puts(format("%-4s %-10s %8s %8s %10s",
  "",
  "total",
  minutes_to_hm(total_regular_min),
  minutes_to_hm(total_overtime_min),
  format("%.2f", total_pay)))
