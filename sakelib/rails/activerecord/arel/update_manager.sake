# Port of activerecord-8.1.3/lib/arel/update_manager.rb

module Arel
  class UpdateManager
    private attr_reader table
    attr_reader ast
    include Arel::TreeManager
    include Arel::TreeManager::StatementMethods

    def initialize(m) = @ast = Nodes::UpdateStatement.new(@table)

    def table(m, table)
      Nodes::UpdateStatement.set_relation(@ast, table)
      m
    end

    # Ruby: a String (a SqlLiteral is one) or BoundSqlLiteral, or [[column, value], ...]
    def set(m, values)
      case values
      in String | Nodes::SqlLiteral | Nodes::BoundSqlLiteral
        Nodes::UpdateStatement.set_values(@ast, Any[values])
      in Array
        Nodes::UpdateStatement.set_values(@ast, Array.map(values) { |column, value| Nodes::Assignment.new(Nodes::UnqualifiedColumn.new(column), value) })
      end
      m
    end

    def group(m, columns)
      Array.each(columns) do |column|
        c = case column
            in String then Nodes::SqlLiteral.new(column)
            in Symbol then Nodes::SqlLiteral.new(Symbol.to_s(column))
            else column
            end
        Array.push(Nodes::UpdateStatement.groups(@ast), Nodes::Group.new(c))
      end
      m
    end

    def having(m, expr)
      Array.push(Nodes::UpdateStatement.havings(@ast), expr)
      m
    end

    def comment(m, value)
      Nodes::UpdateStatement.set_comment(@ast, value)
      m
    end
  end
end
