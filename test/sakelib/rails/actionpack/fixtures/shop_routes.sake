# The routes of routing_generate.sake and of its generator routing_helpers_source.sake (Rails' config/routes.rb)
require "rails/actionpack/action_dispatch/routing"

class ActionDispatch::Routing::Mapper
  def shop_routes(map)
    root map, "products#index"
    resources map, :products do
      resources map, :reviews, only: Any[:index, :show]
      get map, :search, on: :collection
    end
    resource map, :cart, only: Any[:show, :update]
    namespace map, :admin do
      resources map, :orders, param: :number
    end
    get map, "pages/:slug", to: "pages#show", as: :page, slug: /[a-z-]+/
    get map, "files/*path", to: "files#show", as: :file
    get map, "(:locale)/about", to: "pages#about", as: :about
    direct map, :homepage
    direct map, :product_search, Hash.of(sort: "name")
  end
end

# The routes with their `direct` blocks (Rails: direct :homepage do "https://rubyonrails.org" end)
class ShopRoutes
  include ActionDispatch::Routing::Draw
  def draw(r, map) = ActionDispatch::Routing::Mapper.shop_routes(map)
  def direct_for(r, t, name, args, options)
    case name
    in :homepage then "https://rubyonrails.org"
    in :product_search then Hash.merge(Hash.of(controller: "products", action: "search", q: args[0]), options)
    else raise ArgumentError, "No direct helper named #{name}"
    end
  end
end

def shop_route_set
  set = ActionDispatch::Routing::RouteSet.make
  ActionDispatch::Routing::RouteSet.draw_with(set, ShopRoutes.new)
  set
end
