# Port of actionpack-8.1.3/lib/action_controller/metal/flash.rb (partial: add_flash_types for other types than :alert and :notice is not generated yet)
#
# Ruby's add_flash_types(:alert, :notice) defines `alert` and `notice` readers with define_method and makes
# redirect_to take `alert:`/`notice:`; here the two are written out.

require "rails/actionpack/action_dispatch/middleware/flash"

module ActionController
  module Flash
    # class_attribute :_flash_types, default: [:alert, :notice] (after add_flash_types(:alert, :notice))
    def _flash_types(c) = Symbol[:alert, :notice]

    def flash(c) = ActionDispatch::Request.flash(request(c))
    def alert(c) = ActionDispatch::Flash::FlashHash.[](flash(c), :alert)
    def notice(c) = ActionDispatch::Flash::FlashHash.[](flash(c), :notice)

    # Ruby's private redirect_to: the flash keys go to the flash, the rest to Redirecting's redirect_to (super).
    def flash_redirect_to(c, options, response_options_and_flash)
      Array.each(_flash_types(c)) do |flash_type|
        type = Hash.delete(response_options_and_flash, flash_type)
        ActionDispatch::Flash::FlashHash.[]=(flash(c), flash_type, type) if type
      end
      other_flashes = Hash.delete(response_options_and_flash, :flash)
      ActionDispatch::Flash::FlashHash.update(flash(c), other_flashes) if (other_flashes in Hash)
      redirecting_redirect_to(c, options, response_options_and_flash)
    end
    def redirect_to(c, options = Hash.new, **response_options_and_flash) = flash_redirect_to(c, options, response_options_and_flash)
  end
end
