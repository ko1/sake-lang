# CGI: escaping for URLs and HTML (Ruby's cgi/escape).
# CGI.escape(s), CGI.unescape(s), CGI.escapeURIComponent(s), CGI.unescapeURIComponent(s),
# CGI.escapeHTML(s), CGI.unescapeHTML(s); snake_case aliases as in Ruby (CGI.escape_html, ...).

module CGI
  module_function

  # Each run of bytes matched by `unsafe` becomes %XX%XX..., as Ruby's pure-Ruby fallback does.
  def _percent_encode(s, unsafe)
    e = String.gsub(String.b(s), unsafe) { |m| Array.join(Array.map(String.bytes(m)) { |b| format("%%%02X", b) }) }
    String.force_encoding(e, "UTF-8")
  end

  # %XX becomes its byte (a lone % stays); with plus, + becomes a space first.
  def _percent_decode(s, plus, encoding)
    str = String.b(plus ? String.tr(s, "+", " ") : s)
    d = String.gsub(str, /(?:%\h\h)+/) { |m| Array.pack(Array[String.delete(m, "%")], "H*") }
    String.force_encoding(d, encoding)
  end

  def escape(s) = String.tr(_percent_encode(s, /[^ a-zA-Z0-9_.\-~]+/), " ", "+")
  def unescape(s, encoding = "UTF-8") = _percent_decode(s, true, encoding)
  def escapeURIComponent(s) = _percent_encode(s, /[^a-zA-Z0-9_.\-~]+/)
  def unescapeURIComponent(s, encoding = "UTF-8") = _percent_decode(s, false, encoding)
  def escape_uri_component(s) = escapeURIComponent(s)
  def unescape_uri_component(s, encoding = "UTF-8") = unescapeURIComponent(s, encoding)

  def html_table = once { Hash["'" => "&#39;", "&" => "&amp;", "\"" => "&quot;", "<" => "&lt;", ">" => "&gt;"] }

  def escapeHTML(s) = String.gsub(s, /['&"<>]/, html_table)
  def escape_html(s) = escapeHTML(s)

  # A numeric reference decodes only below U+10FFFF, as Ruby's C implementation does.
  def _char_ref(code, ref)
    return ref if code >= 0x10FFFF
    Array.pack(Integer[code], "U*")
  end

  def unescapeHTML(s)
    String.gsub(s, /&(?:amp|quot|gt|lt|apos|#[0-9]+|#[xX]\h+);/) do |m|
      case m
      in "&amp;" then "&"
      in "&quot;" then "\""
      in "&gt;" then ">"
      in "&lt;" then "<"
      in "&apos;" then "'"
      else
        n = String.size(m)
        x = m[2] == "x" || m[2] == "X"
        _char_ref(x ? String.hex(m[3, n] || "") : String.to_i(m[2, n] || ""), m)
      end
    end
  end
  def unescape_html(s) = unescapeHTML(s)
end
