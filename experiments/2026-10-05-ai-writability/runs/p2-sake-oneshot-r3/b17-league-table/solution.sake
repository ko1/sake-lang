def valid_name?(s) = String.match?(s, /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/)

def touch(st, order, name)
  unless Hash.key?(st, name)
    st[name] = Array.new(6, 0)
    Array.push(order, name)
  end
  nil
end

def play(st, hn, an, hg, ag)
  sh = st[hn]
  sa = st[an]
  sh[0] += 1
  sa[0] += 1
  sh[4] += hg
  sh[5] += ag
  sa[4] += ag
  sa[5] += hg
  if hg > ag
    sh[1] += 1
    sa[3] += 1
  elsif hg < ag
    sa[1] += 1
    sh[3] += 1
  else
    sh[2] += 1
    sa[2] += 1
  end
  nil
end

def sort_key(rk, nm)
  r = rk[nm]
  [r[0], r[1], r[2], r[3], nm]
end

def gd_str(gd) = gd > 0 ? "+#{gd}" : "#{gd}"

lines = Array.map(String.split(IO.read(IO.stdin), "\n")) { |l| String.chomp(l) }
st = Hash[]
order = Array[]
games = Array[]
i = 0
while i < Array.size(lines)
  line = lines[i]
  no = i + 1
  i += 1
  toks = String.split(line)
  next if Array.size(toks) == 0
  ok = false
  if Array.size(toks) == 3
    hn = toks[0]
    sc = toks[1]
    an = toks[2]
    if valid_name?(hn) && valid_name?(an) && hn != an
      if sc == "P-P"
        ok = true
        touch(st, order, hn)
        touch(st, order, an)
      else
        m = String.match(sc, /\A([0-9]{1,2})-([0-9]{1,2})\z/)
        if m
          caps = MatchData.captures(m)
          hg = String.to_i(caps[0])
          ag = String.to_i(caps[1])
          ok = true
          touch(st, order, hn)
          touch(st, order, an)
          play(st, hn, an, hg, ag)
          Array.push(games, [hn, an, hg, ag])
        end
      end
    end
  end
  puts("invalid line #{no}: #{line}") unless ok
end

if Array.size(order) == 0
  puts("no teams")
else
  keys = Hash[]
  Array.each(order) do |nm|
    s = st[nm]
    keys[nm] = [s[1] * 3 + s[2], s[4] - s[5], s[4]]
  end
  h2h = Hash.new(0)
  Array.each(games) do |hn, an, hg, ag|
    if keys[hn] == keys[an]
      if hg > ag
        h2h[hn] += 3
      elsif hg < ag
        h2h[an] += 3
      else
        h2h[hn] += 1
        h2h[an] += 1
      end
    end
  end
  rk = Hash[]
  Array.each(order) do |nm|
    k = keys[nm]
    rk[nm] = [-k[0], -k[1], -k[2], -h2h[nm]]
  end
  sorted = Array.sort_by(order) { |nm| sort_key(rk, nm) }
  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
  Array.each(sorted) do |nm|
    s = st[nm]
    cnt = Array.count(order) { |o| rk[o] < rk[nm] }
    pos = 1 + cnt
    gd = s[4] - s[5]
    pts = s[1] * 3 + s[2]
    puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", Integer.to_s(pos), nm, s[0], s[1], s[2], s[3], s[4], s[5], gd_str(gd), pts))
  end
end
