s = "key=value; name=Sake; lang=ruby"
p(String.index(s, "="))            # a position
p(String.index(s, "=", 4))         # searching from position 4
m = Regexp.match(/(\w+)=(\w+)/, s, 11)   # matching from a position
p([m[1], m[2]]) if m
p(String.gsub(s, /(\w+)=/) { |kv| String.upcase(kv) })  # a block gives each replacement
p(String.gsub("cat hat", /[ch]at/, Hash["cat" => "dog", "hat" => "cap"]))
p(String.split(s, "; "))
p(format("%-6s|%5.2f|%03d", "ab", 3.14159, 7))
p(String.bytes("é"))                  # UTF-8 bytes
p(String.unpack("\x01\x00\x02\x00", "v*"))  # binary data, as Ruby's unpack
p(Array.pack(Array[72, 105], "C*"))
