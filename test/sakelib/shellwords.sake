require "shellwords"

lines = Array[
  "",
  "   ",
  "ls -la /tmp",
  "  leading and   trailing  ",
  "a 'b c' \"d e\" f\\ g",
  "echo \"say \\\"hi\\\"\" 'it'\\''s'",
  "\"\\$HOME \\` \\\\ \\a\"",
  "foo\\\nbar",
  "a\"b\"c'd'e",
  "''",
  "\"\" x ''",
  "x\\",
  "日本 'ご飯' \"です\"",
  "tab\tsep\nline"
]
Array.each(lines) { |l| p Shellwords.split(l) }
p Shellwords.shellsplit("one two")
p Shellwords.shellwords("one 'two three'")
p String.shellsplit("x y z")

# unbalanced quotes and NUL
Array.each(Array["a 'b", "\"open", "ok \"x y", "a\u0000b", "abc def 'g"]) do |l|
  begin
    p Shellwords.split(l)
  rescue ArgumentError => e
    puts "ArgumentError: #{Exception.message(e)}"
  end
end

# escape
Array.each(Array["", "simple", "with space", "it's", "a\"b", "$HOME", "a\nb", "日本", "a-b_c.d,e:f+g/h@i", "*?[]{}()<>|&;!#~=%^"]) do |s|
  p Shellwords.escape(s)
end
p Shellwords.shellescape(42)
p String.shellescape("x y")
begin
  Shellwords.escape("a\u0000b")
rescue ArgumentError => e
  puts "ArgumentError: #{Exception.message(e)}"
end

# join, and join then split gives the words back
words = Array["ls", "my file.txt", "", "it's", "a\nb", "$x"]
cmd = Shellwords.join(words)
p cmd
p Shellwords.split(cmd) == words
p Shellwords.shelljoin(Array["a", 1, :b])
p Array.shelljoin(Array["x y", "z"])
