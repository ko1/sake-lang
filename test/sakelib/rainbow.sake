require "rainbow"

# the test's output is not a terminal, so colouring starts disabled
p(Rainbow.enabled)
p(Rainbow("plain").Rainbow.red)
Rainbow.set_enabled(true)
p(Rainbow.enabled)

# colours and effects, chained
p(Rainbow("text").Rainbow.red)
p(Rainbow("text").Rainbow.red.Rainbow.bright)
p(Rainbow("text").Rainbow.bright.Rainbow.red)
p(Rainbow("text").Rainbow.green.Rainbow.underline.Rainbow.italic)
p(Rainbow("text").Rainbow.blue.Rainbow.background(:yellow))
p(Rainbow("text").Rainbow.bg(:white).Rainbow.fg(:black))
p([Rainbow("a").Rainbow.black, Rainbow("a").Rainbow.yellow, Rainbow("a").Rainbow.magenta, Rainbow("a").Rainbow.cyan, Rainbow("a").Rainbow.white])
p([Rainbow("e").Rainbow.faint, Rainbow("e").Rainbow.dark, Rainbow("e").Rainbow.bold, Rainbow("e").Rainbow.blink])
p([Rainbow("e").Rainbow.inverse, Rainbow("e").Rainbow.hide, Rainbow("e").Rainbow.cross_out, Rainbow("e").Rainbow.strike, Rainbow("e").Rainbow.reset])

# colour forms: index, name, RGB, hex, X11 name
p(Rainbow("i").Rainbow.color(5))
p(Rainbow("n").Rainbow.color(:default))
p(Rainbow("rgb").Rainbow.color(255, 128, 0))
p(Rainbow("rgb").Rainbow.background(0, 0, 255))
p(Rainbow("hex").Rainbow.color("#ff8800"))
p(Rainbow("hex").Rainbow.color("00FF00"))
p(Rainbow("x11").Rainbow.color(:aqua))
p(Rainbow("x11").Rainbow.background(:lightgoldenrod))
p(Rainbow("x11").Rainbow.foreground(:greenyellow))

# non-strings are converted; colouring the empty string still wraps it
p(Rainbow(42).Rainbow.red)
p(Rainbow("").Rainbow.red)

# uncolor removes every SGR sequence
s = Rainbow("hello").Rainbow.red.Rainbow.bright.Rainbow.underline
puts(Kernel.inspect(s))
p(Rainbow.uncolor(s))
p(Rainbow.uncolor("no codes"))
p(String.length(s))

# errors
begin
  Rainbow("x").Rainbow.color(:no_such_colour)
rescue ArgumentError => e
  puts(String.[](Exception.message(e), 0, 60))
end
begin
  Rainbow("x").Rainbow.color(1, 2)
rescue ArgumentError => e
  puts(Exception.message(e))
end
begin
  Rainbow("x").Rainbow.color("#xyz")
rescue ArgumentError => e
  puts(Exception.message(e))
end
begin
  Rainbow("x").Rainbow.color(256, 0, 0)
rescue ArgumentError => e
  puts(Exception.message(e))
end

# disabled again: everything is the plain text
Rainbow.set_enabled(false)
p(Rainbow("off").Rainbow.red.Rainbow.bright)
p(Rainbow("off").Rainbow.color(1, 2, 3))
