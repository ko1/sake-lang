require "terminal_table"

rows = Any[Any["Alice", 30, "Tokyo"], Any["Bob", 4, "Osaka"], Any["Christopher", 125, "Kyoto"]]
t = Terminal::Table.new(headings: Any["Name", "Age", "City"], rows: rows)
puts t
p Terminal::Table.number_of_columns(t)

# a title, a separator, right-aligned numbers
t2 = Terminal::Table.new(title: "Population", headings: Any["Name", "Age", "City"], rows: rows)
Terminal::Table.add_separator(t2)
Terminal::Table.add_row(t2, Any["Total", 159, ""])
Terminal::Table.align_column(t2, 1, :right)
puts t2
p Array.size(rows)

# unicode borders, centered, short rows and other values
t3 = Terminal::Table.new(rows: Any[Any[1, 2.5, nil], Any[:sym, true], Any["日本"]], border: :unicode,
                       alignment: :center)
Terminal::Table.<<(t3, Any[Any[1, 2], [3, "x"]])
puts t3

# a title wider than the columns
puts Terminal::Table.new(title: "A rather long title", rows: Any[Any["a", "b"]])

# markdown
md = Terminal::Table.new(headings: Any["Lib", "Lines", "Status"], border: :markdown)
Terminal::Table.add_row(md, Any["semver", 163, "ok"])
Terminal::Table.add_row(md, Any["text", 120, "ok"])
Terminal::Table.add_separator(md)
Terminal::Table.align_column(md, 1, :right)
Terminal::Table.align_column(md, 2, :center)
puts md

# no headings; empty
puts Terminal::Table.new(rows: Any[Any["x"]])
p Terminal::Table.to_s(Terminal::Table.new)
puts Terminal::Table.new(headings: Any["only", "headings"])

# errors
begin
  Terminal::Table.new(border: :fancy)
rescue ArgumentError => e
  puts Exception.message(e)
end
begin
  Terminal::Table.align_column(t, 0, :justify)
rescue ArgumentError => e
  puts Exception.message(e)
end
begin
  Terminal::Table.new(title: "T", border: :markdown)
rescue ArgumentError => e
  puts Exception.message(e)
end
