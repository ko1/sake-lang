# p(x) where x is Date | BigDecimal is rejected inside date.sake: "case/in: no `in` branch matches BigDecimal"
# at Date.jd, reached from Date#<=>, as if printing compared the Date with the BigDecimal. Ruby prints the value.
# Only with --strict (level 2); level 1 runs it. In the Rails port the same error came from `v == nil` and
# `value == nil` on values whose union holds Date and BigDecimal (ActiveModel::Type's cast of a column default,
# reached when a Column read from the database is used); writing `(v in nil)` instead made it go away
# (sakelib/rails/activemodel/active_model/type/value.sake super_cast, helpers.sake Numeric.cast).
require "date"
require "bigdecimal"
x = Array.size(ARGV) > 5 ? Date.new(2020, 1, 1) : BigDecimal.parse("1")
p(x)
