print({true: 1, nil: 2} == {nil: 2, true: 1})
print({true: 1} == {1: 1}, {false: 1} == {0: 1}, {nil: 1} == {false: 1}, {nil: 1} == {"nil": 1})
print({nil: [1, {false: 2}]} == {nil: [1, {false: 2}]}, {nil: [1, {false: 2}]} != {nil: [1, {false: 3}]})
match {true: nil}
  when {true: false} then print("wrong")
  when {true: nil} then print("matched")
end
print([{nil: 1}] == [{nil: 1}], contains([{true: 2}], {true: 2}))
