# Prime numbers with Ranges and Sets: a sieve, twin primes, gaps, Goldbach pairs, and residues.

def sieve(limit)
  composite = Set[]
  Range.each(2..Integer.sqrt(limit)) do |i|
    next if Set.include?(composite, i)
    Range.step((i * i)..limit, i) { |j| Set.add(composite, j) }
  end
  Range.reject(2..limit) { |n| Set.include?(composite, n) }
end

def goldbach(n, prime_set, primes)
  pairs = Array[]
  Array.each(primes) do |p|
    break if p > n / 2
    Array.push(pairs, [p, n - p]) if Set.include?(prime_set, n - p)
  end
  pairs
end

limit = 400
primes = sieve(limit)
prime_set = Array.to_set(primes)
puts("primes up to #{limit}: #{Array.size(primes)}")
puts("first ten: #{Array.join(Array.take(primes, 10), " ")}")
puts("largest: #{Array.last(primes)}")

twins = Array.select(primes) { |p| Set.include?(prime_set, p + 2) }
puts("twin pairs: #{Array.size(twins)}")
puts("  #{Array.join(Array.map(Array.take(twins, 6)) { |p| "(#{p},#{p + 2})" }, " ")}")

gaps = Hash.new(0)
widest = nil
Array.each_cons(primes, 2) do |a, b|
  g = b - a
  gaps[g] += 1
  widest = [a, b] if widest == nil || g > widest[1] - widest[0]
end
puts("gap histogram:")
Array.each(Array.sort(Hash.keys(gaps))) { |g| puts(format("  %2d %s", g, "*" * ((gaps[g] + 1) / 2))) }
puts("widest gap: #{widest[0]}..#{widest[1]}")

puts("goldbach:")
Range.step(40..60, 4) do |n|
  pairs = goldbach(n, prime_set, primes)
  puts("  #{n} = #{Array.join(Array.map(pairs) { |a, b| "#{a}+#{b}" }, " = ")}")
end

puts("residues mod 6 (p > 3):")
res = Array.tally(Array.map(Array.select(primes) { |p| p > 3 }) { |p| p % 6 })
Array.each(Array.sort(Hash.keys(res))) { |r| puts("  #{r}: #{res[r]}") }

decades = Array.group_by(primes) { |p| p / 100 }
puts("per hundred:")
Hash.each(decades) do |d, ps|
  span = (d * 100)...(d * 100 + 100)
  puts(format("  %3d-%3d: %2d  min=%d max=%d", Range.begin(span), Range.end(span) - 1, Array.size(ps), Array.min(ps), Array.max(ps)))
end

odds = Array.to_set(Range.select(3..99) { |n| Integer.odd?(n) })
odd_primes = Array.to_set(Set.select(prime_set) { |p| p < 100 && p > 2 })
puts("odd composites below 100: #{Set.size(odds - odd_primes)}")
puts("odd primes subset of odds? #{Set.subset?(odd_primes, odds)}")
squares = Array.to_set(Range.map(1..20) { |k| k * k })
near_square = Array.select(primes) { |p| Set.include?(squares, p - 1) }
puts("primes one above a square: #{Array.join(near_square, " ")}")
first_big = Array.find(primes) { |p| p > 350 }
none = Array.find(primes) { |p| p > limit }
puts("first above 350: #{first_big}, above limit: #{none == nil ? "none" : none}")
puts("digit sums: #{Array.join(Array.map(Array.take(Array.select(primes) { |p| Set.include?(prime_set, Array.sum(Integer.digits(p))) && p > 100 }, 8)) { |p| Integer.to_s(p) }, " ")}")
