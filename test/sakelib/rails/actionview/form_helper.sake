require "rails/actionview/action_view/base"
require "rails/actionpack/action_dispatch/routing"

# A model: ActiveModel gives model_name, to_key, to_param, persisted?, errors and the attribute readers
# (Sake: a type that includes ActionView::ModelNaming::Model)
class Post
  attr_accessor id, title, body, published, category, kind, tag_ids, color, starts_on, validated
  include ActionView::ModelNaming::Model
  def to_key(r) = @id ? Any[@id] : nil
  def to_param(r) = @id ? Kernel.to_s(@id) : nil
  def persisted?(r) = @id != nil
  def param_key(r) = "post"
  def route_key(r) = "posts"
  def singular_route_key(r) = "post"
  def read_attribute_for_validation(r, name)
    case name
    in "id" then @id
    in "title" then @title
    in "body" then @body
    in "published" then @published
    in "category" then @category
    in "kind" then @kind
    in "tag_ids" then @tag_ids
    in "color" then @color
    in "starts_on" then @starts_on
    else nil
    end
  end
  # validates :title, presence: true (the errors are there after valid?)
  def valid?(r)
    @validated = true
    Object.present?(@title)
  end
  def errors_for(r, attribute) = @validated == true && attribute == "title" && Object.blank?(@title) ? String["can't be blank"] : String[]
end
class Tag
  attr_accessor id, name
  include ActionView::ModelNaming::Model
  def to_key(r) = Any[@id]
  def to_param(r) = Kernel.to_s(@id)
  def persisted?(r) = true
  def param_key(r) = "tag"
  def route_key(r) = "tags"
  def singular_route_key(r) = "tag"
  def read_attribute_for_validation(r, name)
    case name
    in "id" then @id
    in "name" then @name
    else nil
    end
  end
end

class ActionDispatch::Routing::Mapper
  def form_routes(map)
    resources map, :posts
  end
end
routes = ActionDispatch::Routing::RouteSet.make
ActionDispatch::Routing::RouteSet.draw(routes) { |map| ActionDispatch::Routing::Mapper.form_routes(map) }

view = ActionView::Base.new(routes: routes)
B = ActionView::Base
F = ActionView::Helpers::FormBuilder
post = Post.new(1, "Hello <world>", "Body text", true, "rails", "b", Any[1, 3], "#AABBCC", Time.new(2026, 10, 20, 0, 0, 0, "UTC"), false)
new_post = Post.new(nil, "", nil, false, nil, nil, Any[], nil, nil, false)
tags = Any[Tag.new(1, "ruby"), Tag.new(2, "sake"), Tag.new(3, "rails")]

# form_with
puts B.form_with(view, model: new_post) { |f| F.text_field(f, :title) }
puts B.form_with(view, model: post) { |f| F.text_field(f, :title) }
puts B.form_with(view, model: post, url: "/custom", method: :put, class: "edit", data: Hash.of(turbo: false)) { |f| F.submit(f) }
puts B.form_with(view, scope: :search, url: "/search", method: :get) { |f| F.search_field(f, :q) }
puts B.form_with(view, url: "/x", local: false) { |f| "" }
puts B.form_with(view, model: post, format: :json) { |f| "" }
puts B.form_with(view, model: post, html: Hash.of(id: "the-form", multipart: true)) { |f| "" }
puts B.form_with(view, model: post) { |f| F.file_field(f, :body) }
puts B.form_with(view, model: post, skip_enforcing_utf8: false) { |f| "" }
# form_for
puts B.form_for(view, post) { |f| F.text_field(f, :title) }
puts B.form_for(view, new_post) { |f| F.text_field(f, :title) }
puts B.form_for(view, post, url: "/p", as: :article, namespace: "admin") { |f| F.text_field(f, :title) }
puts B.form_for(view, :search, url: "/s") { |f| F.text_field(f, :q) }
# FormBuilder fields
B.form_with(view, model: post) do |f|
  puts F.label(f, :title)
  puts F.label(f, :title, "The title", class: "big")
  puts F.label(f, :title, class: "x")
  puts F.label(f, :title) { |b| "custom #{ActionView::Helpers::Tags::Label::LabelBuilder.translation(b)}" }
  puts F.text_field(f, :title, class: "wide", maxlength: 30)
  puts F.text_field(f, :title, placeholder: true)
  puts F.text_field(f, :title, placeholder: "Your title")
  puts F.text_field(f, :title, value: "override", id: "my-id")
  puts F.password_field(f, :title)
  puts F.hidden_field(f, :id)
  puts F.textarea(f, :body, size: "20x5")
  puts F.text_area(f, :body, rows: 3)
  puts F.checkbox(f, :published)
  puts F.checkbox(f, :published, Hash.of(class: "c"), "yes", "no")
  puts F.check_box(f, :published, Hash.of(include_hidden: false))
  puts F.checkbox(f, :tag_ids, Hash.of(multiple: true), "3", nil)
  puts F.radio_button(f, :kind, "a")
  puts F.radio_button(f, :kind, "b", class: "r")
  puts F.color_field(f, :color)
  puts F.search_field(f, :title)
  puts F.telephone_field(f, :title)
  puts F.phone_field(f, :title)
  puts F.date_field(f, :starts_on)
  puts F.date_field(f, :starts_on, min: "2026-01-01")
  puts F.month_field(f, :starts_on)
  puts F.week_field(f, :starts_on)
  puts F.url_field(f, :title)
  puts F.email_field(f, :title)
  puts F.number_field(f, :id, in: 1..10, step: 1)
  puts F.range_field(f, :id, within: 0..5)
  puts F.submit(f)
  puts F.submit(f, "Go", class: "btn")
  puts F.button(f)
  puts F.button(f, "Click", type: "button")
  puts F.button(f, :draft)
  puts F.button(f) { |label| "<b>#{label}</b>" }
  puts F.select(f, :category, Any["ruby", "rails", "sake"])
  puts F.select(f, :category, Any[Any["Ruby", "ruby"], Any["Rails", "rails"]], include_blank: true)
  puts F.select(f, :category, Any["ruby", "rails"], Hash.of(prompt: "Pick one"), class: "sel")
  puts F.select(f, :tag_ids, Any[Any["ruby", 1], Any["sake", 2], Any["rails", 3]], Hash.new, multiple: true)
  puts F.collection_select(f, :category, tags, :name, :name)
  puts F.collection_select(f, :category, tags, :id, :name, Hash.of(include_blank: "None"), class: "c")
  puts F.collection_checkboxes(f, :tag_ids, tags, :id, :name)
  puts F.collection_radio_buttons(f, :category, tags, :name, :name)
  puts F.field_id(f, :title)
  puts F.field_name(f, :title)
  puts F.field_name(f, :tag_ids, multiple: true)
  puts F.fields_for(f, :author) { |a| F.text_field(a, :name) }
  puts F.fields(f, :meta) { |m| F.text_field(m, :key) }
end
# errors (field_error_proc)
Post.valid?(new_post)
puts B.form_with(view, model: new_post) { |f| ActiveSupport::SafeBuffer.+(F.label(f, :title), F.text_field(f, :title)) }
# fields_for / fields at the top
puts B.fields_for(view, :person, post) { |f| F.text_field(f, :title) }
puts B.fields(view, :comment) { |f| F.text_field(f, :body) }
puts B.fields(view, model: post) { |f| F.text_field(f, :title) }
# the view's helpers with an object
puts B.text_field(view, :post, :title, object: post)
puts B.text_field(view, "post[]", :title, object: post)
puts B.label(view, :post, :title, "Name", for: "x")
puts B.hidden_field(view, :post, :id, object: post)
puts B.radio_button(view, :post, :kind, "b", object: post)
puts B.datetime_field(view, :post, :starts_on, object: post)
puts B.time_field(view, :post, :starts_on, object: post)
puts B.textarea(view, :post, :body, object: post, placeholder: true)
