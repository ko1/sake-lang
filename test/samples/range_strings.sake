# Ranges of Strings iterate with String#succ, as in Ruby; Range == compares ends
p Range.to_a("A".."E")
p Range.map("a".."c") { |s| String.upcase(s) }
p Range.select("aa".."ad") { |s| String.end_with?(s, "b") || String.end_with?(s, "d") }
p((1..3) == (1..3))
p((1..3) == (1...3))
r = /a+/
p(r == r)
p(/a+/ == /a+/)
p(/a+/ == /a+/i)
