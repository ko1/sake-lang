# Instances made at one place (here: by one function) share a type, so values of different kinds meet in
# its field: a report there is `mixed`, a warning at level 1 and an error from level 2 (--strict).
# (Two `Heap.new` written at different places would be two types, each with its own field types.)
class Heap
  attr_reader items
  def initialize(h) = @items = Array[]
  def push(h, x) = Array.push(@items, x)
  def top(h) = Array.max(@items)
end
class Job
  attr_reader prio
  include Comparable
  def <=>(a, b) = a.Job.prio <=> b.Job.prio
end
def heap = Heap.new
ints = heap
jobs = heap
Heap.push(ints, 3)
Heap.push(ints, 1)
Heap.push(jobs, Job.new(2))
p(Heap.top(ints) + 1)
p(Heap.top(jobs).Job.prio)
