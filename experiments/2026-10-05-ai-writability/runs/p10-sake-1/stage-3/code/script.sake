# Runs a whole script: split into statements, run each against one database, report errors.
module Script
  module_function

  def run(src)
    db = Database.new(Hash[])
    Array.each(split_statements(Lexer.tokenize(src))) { run_statement(db, it) }
  end

  # The token lists between `;`s (the `;`s themselves are dropped).
  def split_statements(tokens)
    statements = Array[]
    current = Array[]
    Array.each(tokens) do |t|
      if Token.kind(t) == :punct && Token.text(t) == ";"
        Array.push(statements, current)
        current = Array[]
      else
        Array.push(current, t)
      end
    end
    Array.push(statements, current)
    statements
  end

  def run_statement(db, tokens)
    return if Array.empty?(tokens)
    begin
      lines = Executor.execute(db, Parser.parse(tokens))
      Array.each(lines) { puts(it) }
    rescue SqlError => e
      puts("Error: #{Exception.message(e)}")
    end
  end
end
