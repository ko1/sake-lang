# find: Ruby's Find module (Find.find, Find.prune) and Pathname#find.
#
# Sake cannot list a directory, so Find.find yields each given path, and a directory raises IOError
# when the walk would descend into it; a directory the block prunes is fine. Find.prune is an
# exception (FindPrune) that Find.find rescues, where Ruby throws :prune.
require "pathname"

class FindPrune < Exception
end

module Find
  module_function

  # Ruby checks every path before yielding any; ignore_error is accepted (Ruby ignores errors
  # while listing, which Sake never does).
  def find(*paths, ignore_error: true)
    list = Array.map(paths) do |x|
      s = Pathname.path_of(x)
      raise IOError, "No such file or directory - #{s}" unless File.exist?(s)
      s
    end
    found = String[]
    Array.each(list) do |path|
      pruned = false
      if block_given?
        begin
          yield path
        rescue FindPrune
          pruned = true
        end
      else
        Array.push(found, path)
      end
      if !pruned && File.directory?(path)
        raise IOError, "listing a directory is not available in Sake - #{path}"
      end
    end
    block_given? ? nil : found
  end

  def prune = raise FindPrune
end

class Pathname
  # Ruby's Pathname#find: Pathnames, "./" dropped when the path is ".".
  def find(pn, ignore_error: true)
    found = Pathname[]
    Find.find(@path, ignore_error:) do |f|
      x = Pathname.new(@path == "." ? String.delete_prefix(f, "./") : f)
      if block_given?
        yield x
      else
        Array.push(found, x)
      end
    end
    block_given? ? nil : found
  end
end
