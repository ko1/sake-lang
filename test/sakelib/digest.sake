require "digest"

# One-shot digests of a String (Ruby's class methods).
inputs = Array["", "abc", "The quick brown fox jumps over the lazy dog", "日本語のテキスト", "héllo ✓ 😀",
               String.*("a", 55), String.*("a", 56), String.*("a", 64), String.*("a", 65),
               String.*("b", 111), String.*("b", 112), String.*("b", 128), String.*("xyz", 100),
               Array.pack(Integer[0, 255, 128, 1, 127], "C*")]
Array.each(inputs) do |s|
  puts("#{String.bytesize(s)} bytes")
  puts(MD5.hexdigest(s))
  puts(SHA1.hexdigest(s))
  puts(SHA256.hexdigest(s))
  puts(SHA384.hexdigest(s))
  puts(SHA512.hexdigest(s))
  puts(MD5.base64digest(s))
  puts(SHA256.base64digest(s))
end
p(MD5.digest("abc"))
p(String.bytesize(SHA1.digest("abc")))
p(String.encoding(SHA256.digest("abc")))
puts(Digest.hexencode(MD5.digest("abc")))

# Incremental: the same digest whatever the pieces.
md = SHA256.new
md << "The quick brown "
md << "fox jumps over "
SHA256.update(md, "the lazy dog")
puts(SHA256.hexdigest(md))
puts(SHA256.hexdigest(md))            # digest leaves md as it is
puts(SHA256.base64digest(md))
p(String.bytesize(SHA256.digest(md)))
puts(SHA256.to_s(md))
puts("#{md}")
p(md)
whole = SHA256.update(SHA256.new, "The quick brown fox jumps over the lazy dog")
p(md == whole)
p(md == SHA256.new)

m5 = MD5.new
Integer.times(10) { |i| m5 << String.*("#{i}", 13) }
puts(MD5.hexdigest(m5))
puts(MD5.hexdigest!(m5))              # returns it and resets
puts(MD5.hexdigest(m5))
p(m5 == MD5.new)
m5 << "abc"
p(MD5.digest!(m5))
m5 << "abc"
puts(MD5.base64digest!(m5))
puts(MD5.hexdigest(m5))
puts(MD5.hexdigest(MD5.reset(MD5.update(MD5.new, "zzz"))))

s1 = SHA1.new
Array.each(Array["日本", "語の", "テキスト"]) { |piece| s1 << piece }
puts(SHA1.hexdigest(s1))
s5 = SHA512.new
Integer.times(3) { s5 << String.*("q", 100) }
puts(SHA512.hexdigest(s5))
s3 = SHA384.new
s3 << ""
puts(SHA384.hexdigest(s3))

# Sizes.
p(Array[MD5.digest_length(MD5.new), SHA1.digest_length(SHA1.new), SHA256.digest_length(SHA256.new),
        SHA384.digest_length(SHA384.new), SHA512.digest_length(SHA512.new)])
p(Array[MD5.block_length(MD5.new), SHA1.block_length(SHA1.new), SHA256.block_length(SHA256.new),
        SHA384.block_length(SHA384.new), SHA512.block_length(SHA512.new)])
p(Array[MD5.size(MD5.new), SHA256.length(SHA256.new)])

# Files.
puts(SHA256.hexdigest(SHA256.file("digest.rb")))
begin
  MD5.file("no-such-file")
rescue IOError
  puts("no file")
end

# The instance form with a String: a one-shot digest that leaves md reset.
m1 = SHA1.new
m1 << "zzz"
puts(SHA1.hexdigest(m1, "abc"))
puts(SHA1.hexdigest(m1))
p(MD5.digest(MD5.new, "abc") == MD5.digest("abc"))
puts(SHA512.base64digest(SHA512.new, "x"))
puts(SHA384.hexdigest(SHA384.update(SHA384.new, "q"), "日本語"))

# 2026-10-05: dup gives an independent copy; the instance form of file updates md.
d1 = SHA256.new
d1 << "abc"
d2 = dup(d1)
d2 << "def"
puts(SHA256.hexdigest(d1))
puts(SHA256.hexdigest(d2))
p(d1 == SHA256.update(SHA256.new, "abc"))
m6 = MD5.new
m6 << "x"
p(MD5.file(m6, "digest.rb") == m6)
puts(MD5.hexdigest(m6))
s4 = dup(SHA384.new)
puts(SHA384.hexdigest(s4))
