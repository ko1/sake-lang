# A later include wins over an earlier one (Ruby's ancestor order); the includer's own definition wins over both.
module A
  def foo(x) = "A.foo calls #{bar(x)}"
  def bar(x) = "A.bar"
end
module B
  def bar(x) = "B.bar"
end
class X < {reader: [v]}
  include A
  include B
end
class Y < {reader: [v]}
  include A
  include B
  def bar(y) = "Y.bar"
end
puts(X.bar(X.new(0)))
puts(X.foo(X.new(0)))
puts(Y.foo(Y.new(0)))
puts(A.foo(Y.new(0)))                  # dispatches to Y.foo
