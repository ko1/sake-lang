# break and return cannot leave a block that Thread.new or at_exit runs later.
def work
  t = Thread.new { break 1 }
  u = Thread.new { return 2 }
  v = Thread.new { Array.each(Any[1, 2]) { |x| return x } }
  w = Thread.new { Array.each(Any[1, 2]) { |x| break } }
  Kernel.at_exit { return }
  Any[t, u, v, w]
end
work
