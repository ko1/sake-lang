Node = Data.define(:value, :next)

def build(n)
  head = nil
  Integer.downto(n, 1) { |i| head = Node.new(i, head) }
  head
end

class Node
  def sum(node)
    total = 0
    while node
      total += value(node)
      node = next(node)
    end
    total
  end

  def length(node)
    count = 0
    while node
      count += 1
      node = next(node)
    end
    count
  end

  def to_s(node)
    parts = String[]
    while node
      Array.push(parts, Integer.to_s(value(node)))
      node = next(node)
    end
    Array.join(parts, " -> ")
  end
end

list = build(5)
puts(String.+("sum: ", Integer.to_s(Node.sum(list))))
puts(String.+("length: ", Integer.to_s(Node.length(list))))
puts(Node.to_s(list))
