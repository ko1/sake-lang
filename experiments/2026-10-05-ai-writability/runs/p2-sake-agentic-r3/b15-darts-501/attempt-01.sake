# returns [points, is_double] or nil for an invalid dart
def dart(tok)
  return [25, false] if tok == "25"
  return [50, true] if tok == "BULL"
  return [0, false] if tok == "MISS"
  m = String.match(tok, /\A([SDT])([1-9]|1\d|20)\z/)
  return nil unless m
  c = MatchData.captures(m)
  n = String.to_i(c[1])
  if c[0] == "S"
    [n, false]
  elsif c[0] == "D"
    [2 * n, true]
  else
    [3 * n, false]
  end
end

lines = IO.readlines(IO.stdin())
head = Array.empty?(lines) ? Array[] : String.split(lines[0])
ok = Array.size(head) >= 2 && Array.size(head) <= 5
if ok
  ok = String.match?(head[0], /\A\d+\z/) && String.to_i(head[0]) >= 2 && String.to_i(head[0]) <= 1001
end
if ok
  names0 = Array.drop(head, 1)
  ok = Array.all?(names0) { |s| String.match?(s, /\A[a-z]{1,10}\z/) } && Array.size(Array.uniq(names0)) == Array.size(names0)
end
unless ok
  puts("invalid header")
  exit
end

start = String.to_i(head[0])
names = Array.drop(head, 1)
left = Hash[]
turns = Hash.new(0)
thrown = Hash.new(0)
Array.each(names) { |s| left[s] = start }
winner = nil

Array.each_with_index(lines) do |raw, idx|
  next if idx == 0
  n = idx + 1
  f = String.split(raw)
  next if Array.empty?(f)
  name = f[0]
  ds = Array.drop(f, 1)
  if winner != nil
    puts("line #{n}: game over")
  elsif !Hash.key?(left, name)
    puts("line #{n}: unknown player #{name}")
  elsif Array.size(ds) < 1 || Array.size(ds) > 3
    puts("line #{n}: expected 1 to 3 darts")
  else
    bad = Array.find(ds) { |t| dart(t) == nil }
    if bad != nil
      puts("line #{n}: bad dart #{bad}")
    else
      cur = left[name]
      total = 0
      status = :ok
      last = ""
      Array.each(ds) do |t|
        pts, dbl = dart(t)
        thrown[name] += 1
        cur -= pts
        total += pts
        last = t
        if cur < 0 || cur == 1 || (cur == 0 && !dbl)
          status = :bust
          break
        elsif cur == 0
          status = :out
          break
        end
      end
      turns[name] += 1
      if status == :bust
        puts("#{name} busts, #{left[name]} left")
      elsif status == :out
        left[name] = 0
        winner = name
        puts("#{name} checks out with #{last}")
      else
        left[name] = cur
        puts("#{name} scores #{total}, #{cur} left")
      end
    end
  end
end

puts("STANDINGS")
rows = Array[]
Array.each_with_index(names) { |s, i| Array.push(rows, [left[s], i, s]) }
Array.each_with_index(Array.sort(rows)) do |row, i|
  s = row[2]
  avg = thrown[s] == 0 ? "-" : format("%.2f", (start - left[s]) * 3.0 / thrown[s])
  puts(format("%d. %-10s %4d %3d %6s", i + 1, s, left[s], turns[s], avg))
end
puts(winner == nil ? "no winner" : "winner: #{winner}")
