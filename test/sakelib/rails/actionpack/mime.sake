require "rails/actionpack/action_dispatch/http/mime_types"

def show(label, v) = puts("#{label}: #{Kernel.inspect(v)}")
def names(list) = Array.map(list) { |m| Mime::Type.to_s(m) }
def s(m) = m ? Mime::Type.to_s(m) : nil
def sym(m) = m ? Mime::Type.to_sym(m) : nil

puts("-- lookup")
show("Mime[:json]", s(Mime.[](:json)))
show("Mime[\"csv\"]", s(Mime.[]("csv")))
show("Mime[:nope]", Mime.[](:nope))
show("lookup text/html", [Mime::Type.to_s(Mime::Type.lookup("text/html")), Mime::Type.to_sym(Mime::Type.lookup("text/html"))])
show("lookup xhtml synonym", Mime::Type.to_sym(Mime::Type.lookup("application/xhtml+xml")))
show("lookup with params", Mime::Type.to_sym(Mime::Type.lookup("text/html; charset=utf-8")))
show("lookup unknown", [Mime::Type.to_s(Mime::Type.lookup("application/x-foo")), Mime::Type.to_sym(Mime::Type.lookup("application/x-foo"))])
show("lookup_by_extension jpg", s(Mime::Type.lookup_by_extension("jpg")))
show("lookup_by_extension yml", s(Mime::Type.lookup_by_extension(:yml)))
show("ref", [Mime::Type.ref(Mime.[](:json) || Mime.ALL), Mime::Type.ref(Mime::Type.lookup("application/x-foo"))])
show("symbols include json", Array.include?(Mime.symbols, :json))
show("symbols size", Array.size(Mime.symbols))
show("valid_symbols?", [Mime.valid_symbols?(Symbol[:json, :html]), Mime.valid_symbols?(Symbol[:json, :nope])])

puts("-- predicates and equality")
html = Mime.[](:html) || Mime.ALL
json = Mime.[](:json) || Mime.ALL
show("html?", [Mime::Type.html?(html), Mime::Type.html?(json), Mime::Type.html?(Mime.ALL), Mime::Type.html?(Mime::Type.lookup("application/xhtml+xml"))])
show("all?", [Mime::Type.all?(Mime.ALL), Mime::Type.all?(html), Mime::Type.to_s(Mime.ALL)])
show("== String", Mime::Type.==(json, "application/json"))
show("== synonym", Mime::Type.==(json, "text/x-json"))
show("== Symbol", Mime::Type.==(json, :json))
show("== other", Mime::Type.==(json, html))
show("=== list", Mime::Type.===(html, Mime::Type[Mime::Type.lookup("application/xhtml+xml")]))
show("match?", [Mime::Type.match?(html, "html"), Mime::Type.match?(json, "xml")])

puts("-- parse")
show("one", names(Mime::Type.parse("application/json")))
show("one with q", names(Mime::Type.parse("application/json;q=0.5")))
show("empty", names(Mime::Type.parse(" ")))
show("browser", names(Mime::Type.parse("text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8")))
show("q order", names(Mime::Type.parse("text/plain;q=0.2, application/json, text/html;q=0.9")))
show("same q keeps order", names(Mime::Type.parse("text/csv, text/plain")))
show("quoted q", names(Mime::Type.parse("text/plain;q=\"0.5\", application/json")))
show("text/xml becomes xml", names(Mime::Type.parse("text/xml, text/html;q=0.5")))
show("text/xml and application/xml", names(Mime::Type.parse("text/html;q=0.1, text/xml, application/xml;q=0.5")))
show("+xml after xml", names(Mime::Type.parse("application/xml, application/rss+xml, text/html;q=0.4")))
show("trailing star", Array.sort(names(Mime::Type.parse("text/*"))))
show("unknown", names(Mime::Type.parse("application/vnd.api+json, text/html")))

puts("-- register and errors")
Mime::Type.register("application/vnd.api+json", :jsonapi, String[], String["jsonapi"])
show("registered", [s(Mime.[](:jsonapi)), Mime::Type.to_sym(Mime::Type.lookup("application/vnd.api+json")), sym(Mime::Type.lookup_by_extension("jsonapi"))])
show("parse registered", names(Mime::Type.parse("application/vnd.api+json, text/html")))
Mime::Type.register_alias("text/html", :mobile)
show("alias", [s(Mime.[](:mobile)), Mime::Type.to_sym(Mime::Type.lookup("text/html"))])
Mime::Type.unregister(:jsonapi)
show("unregistered", [Mime.[](:jsonapi), Mime::Type.to_sym(Mime::Type.lookup("application/vnd.api+json"))])
begin
  Mime::Type.lookup("not a mime")
rescue Mime::Type::InvalidMimeType => e
  show("InvalidMimeType", Exception.message(e))
end
