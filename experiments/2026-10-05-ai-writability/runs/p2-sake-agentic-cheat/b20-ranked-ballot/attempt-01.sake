def pct(c, active)
  return "0.0%" if active == 0
  t = (2 * c * 1000 + active) / (2 * active)
  "#{t / 10}.#{t % 10}%"
end

def main
  lines = IO.readlines(IO.stdin)
  names = String[]
  if !Array.empty?(lines)
    Array.each(String.split(String.strip(lines[0]))) do |nm|
      Array.push(names, nm) unless Array.include?(names, nm)
    end
  end
  if Array.empty?(names)
    puts("no candidates")
    return
  end
  nc = Array.size(names)
  ballots = Array[]
  rejected = 0
  Array.each(Array.drop(lines, 1).Array.each_with_index) do |raw, i|
    line = String.chomp(raw)
    next if String.strip(line) == ""
    ranks = Integer[]
    reason = ""
    Array.each(String.split(line, ">", -1)) do |part|
      next if reason != ""
      nm = String.strip(part)
      if nm == ""
        reason = "empty rank"
      else
        ix = Array.index(names, nm)
        if ix == nil
          reason = "unknown candidate #{nm}"
        elsif Array.include?(ranks, ix)
          reason = "duplicate #{nm}"
        else
          Array.push(ranks, ix)
        end
      end
    end
    if reason == ""
      Array.push(ballots, ranks)
    else
      rejected += 1
      puts("rejected line #{i + 2}: #{reason}")
    end
  end
  nb = Array.size(ballots)
  puts("ballots: #{nb} valid, #{rejected} rejected")
  alive = Array.new(nc, true)
  hist = Array[]
  round = 0
  loop do
    round += 1
    votes = Array.new(nc, 0)
    active = 0
    Array.each(ballots) do |b|
      pick = Array.find(b) { |c| alive[c] }
      if pick != nil
        votes[pick] += 1
        active += 1
      end
    end
    Array.push(hist, votes)
    puts("round #{round}")
    cont = Array.select(Range.to_a(0...nc)) { |c| alive[c] }
    sorted = Array.sort_by(cont) { |c| [-votes[c], names[c]] }
    Array.each(sorted) { |c| puts("  #{names[c]} #{votes[c]} #{pct(votes[c], active)}") }
    puts("  exhausted #{nb - active}")
    if active == 0
      puts("no winner")
      break
    end
    win = Array.find(cont) { |c| votes[c] * 2 > active }
    if win != nil
      puts("winner #{names[win]}")
      break
    end
    mn = Array.min(Array.map(cont) { |c| votes[c] })
    cand = Array.select(cont) { |c| votes[c] == mn }
    r = round - 2
    while Array.size(cand) > 1 && r >= 0
      h = hist[r]
      lo = Array.min(Array.map(cand) { |c| h[c] })
      cand = Array.select(cand) { |c| h[c] == lo }
      r -= 1
    end
    out = Array.max_by(cand) { |c| names[c] }
    out => Integer
    alive[out] = false
    puts("  eliminated #{names[out]}")
  end
end
main
