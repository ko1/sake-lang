# Port of actionview-8.1.3/lib/action_view/helpers/csp_helper.rb, with the helper methods of actionpack-8.1.3/lib/action_controller/metal/content_security_policy.rb (content_security_policy?, content_security_policy_nonce: the request's)
#
# Rails' view gets content_security_policy? and content_security_policy_nonce from the controller
# (helper_method); here they are the view's, read from its request as the controller does, and a view class
# may override them.

require "tag_helper"
require "../../../actionpack/action_dispatch/http/content_security_policy"

module ActionView
  module Helpers
    module CspHelper
      def request(v) = raise(NotImplementedError)

      def content_security_policy?(v)
        req = request(v)
        req != nil && ActionDispatch::Request.content_security_policy(req) != nil
      end

      def content_security_policy_nonce(v)
        req = request(v)
        req ? ActionDispatch::Request.content_security_policy_nonce(req) : nil
      end

      def csp_meta_tag(v, **opts)
        return nil unless content_security_policy?(v)
        options = Hash.dup(opts)
        options[:name] = "csp-nonce"
        options[:content] = content_security_policy_nonce(v)
        tag(v, "meta", options)
      end
    end
  end
end
