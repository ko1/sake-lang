query 1: q=red+shoes&page=2&in_stock=yes&tags=sale,+summer,
  q = "red shoes"
  page = 2
  per_page = 20
  in_stock = true
  sort = :relevance
  tags = ["sale", "summer"]
query 2: page=x&per_page=50&sort=cheapest
  per_page = 50
  in_stock = false
  ! q is required
  ! page must be an integer (got "x")
  ! sort must be one of relevance/price/newest (got "cheapest")
query 3: q=lamp&min_price=30&max_price=12.50&in_stock=maybe
  q = "lamp"
  page = 1
  per_page = 20
  min_price = (30/1)
  max_price = (25/2)
  sort = :relevance
  ! in_stock must be a boolean (got "maybe")
  ! min_price is above max_price
query 4: q=desk&min_price=9.999&color=oak&sort=price
  q = "desk"
  page = 1
  per_page = 20
  in_stock = false
  sort = :price
  ! min_price must be a decimal (got "9.999")
  ! unknown parameter color
