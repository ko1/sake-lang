module Sql
  module Evaluator
    def self.evaluate: (Ast::Expr expr, Array[value] row) -> value
    def self.affinity: (Ast::Expr expr) -> column_type?
    def self.unary: (Ast::Unary expr, Array[value] row) -> value
    def self.negation: (bool? truth) -> bool?
    def self.binary: (Ast::Binary expr, Array[value] row) -> value
    def self.conjunction: (Ast::Binary expr, Array[value] row) -> Integer?
    def self.disjunction: (Ast::Binary expr, Array[value] row) -> Integer?
    def self.same: (Ast::Is expr, Array[value] row) -> Integer
    def self.case_expr: (Ast::CaseExpr expr, Array[value] row) -> value
    def self.between: (Ast::Between expr, Array[value] row) -> Integer?
    def self.in_list: (Ast::InList expr, Array[value] row) -> Integer?
    def self.scalar_subquery: (Ast::ScalarPlan expr, Array[value] row) -> value
    def self.in_subquery: (Ast::InPlan expr, Array[value] row) -> Integer?
    def self.membership: (value value, column_type? aff, Array[value] candidates, column_type? candidate_aff, bool negated) -> Integer?
    def self.like: (Ast::Like expr, Array[value] row) -> Integer?
    def self.negate_result: (Integer? result) -> Integer?
  end
end
