# Rational, Complex, and Time, with Ruby's semantics.
p(1 + 2r)
p(2r + 1.5)
p(2r ** -1)
p(1i * 1i)
p(Rational(1, 3) * 3)
p(Complex.abs(Complex(3, 4)))
p(Rational.numerator(3/4r))
p(Array.sum(Array[1r/2, 1r/3]))
p(Math.sqrt(4r))
p(1r < 2)
t = Time.utc(Time.at(86400))
p(Time.year(t))
p(Time.strftime(t, "%Y-%m-%d"))
p(Time.at(10) - Time.at(4))
p(Time.at(5) < Time.at(6))
p(Time.to_i(Time.at(100) + 20))
