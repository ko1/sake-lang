# Port of activemodel-8.1.3/lib/active_model/attributes.rb
#
# The class body's `attribute :name, :string, default: "x"` is the generator's (generate/attribute_methods.sake):
# the readers and writers (Ruby's define_method_attribute / define_method_attribute=) are generated, typed by
# the attribute's type (`Person.age(p)` is an Integer or nil), and _default_attributes is a `once`.
# The instance's AttributeSet is the field `__attributes` (Ruby's @attributes), set by the generated initialize.
# Ruby has a class attribute_names and an instance attribute_names (the same names); the instance's is
# attribute_names_of(r).

require "attribute_registration"
require "attribute_methods"

module ActiveModel
  module Attributes
    include ActiveModel::AttributeRegistration
    include ActiveModel::AttributeMethods

    def attribute_names = Hash.keys(attribute_types)

    # Ruby's initialize: @attributes = self.class._default_attributes.deep_dup
    def init_attributes(r) = set___attributes(r, ActiveModel::AttributeSet.deep_dup(_default_attributes))

    def attributes(r) = ActiveModel::AttributeSet.to_hash(attribute_set(r))
    def attribute_names_of(r) = ActiveModel::AttributeSet.keys(attribute_set(r))

    def attribute_set(r)
      s = __attributes(r)
      raise ActiveModel::MissingAttributeError, "the attributes of #{__class_name} are not initialized" if s == nil
      s
    end

    def _write_attribute(r, attr_name, value) = ActiveModel::AttributeSet.write_from_user(attribute_set(r), attr_name, value)
    def attribute(r, attr_name) = ActiveModel::AttributeSet.fetch_value(attribute_set(r), attr_name)
    def attribute_before_type_cast(r, attr_name) = ActiveModel::Attribute.value_before_type_cast(attribute_set(r)[attr_name])
    def attribute_came_from_user?(r, attr_name) = ActiveModel::Attribute.came_from_user?(attribute_set(r)[attr_name])

    # NumericalityValidator's prepare_value_for_validation: the value as the user gave it.
    def attribute_raw_value_for_validation(r, attr_name)
      a = attribute_set(r)[Symbol.to_s(attr_name)]
      ActiveModel::Attribute.came_from_user?(a) ? ActiveModel::Attribute.value_before_type_cast(a) : nil
    end
  end
end
