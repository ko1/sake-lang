# Port of activerecord-8.1.3/lib/arel/tree_manager.rb (partial: no to_dot)
#
# Ruby's class TreeManager is a module here (the managers include it); StatementMethods is Ruby's own mixin.

module Arel
  module TreeManager
    include Arel::FactoryMethods

    module StatementMethods
      def take(m, limit)
        (Nodes::UpdateStatement|Nodes::DeleteStatement).set_limit(@ast, Nodes::Limit.new(Nodes.build_quoted(limit))) if limit
        m
      end

      def offset(m, offset)
        (Nodes::UpdateStatement|Nodes::DeleteStatement).set_offset(@ast, Nodes::Offset.new(Nodes.build_quoted(offset))) if offset
        m
      end

      def order(m, *expr)
        (Nodes::UpdateStatement|Nodes::DeleteStatement).set_orders(@ast, expr)
        m
      end

      def set_key(m, key)
        k = (key in Array) ? Array.map(key) { |x| Nodes.build_quoted(x) } : Nodes.build_quoted(key)
        (Nodes::UpdateStatement|Nodes::DeleteStatement).set_key(@ast, k)
      end

      def key(m) = (Nodes::UpdateStatement|Nodes::DeleteStatement).key(@ast)

      def set_wheres(m, exprs)
        (Nodes::UpdateStatement|Nodes::DeleteStatement).set_wheres(@ast, exprs)
      end

      def where(m, expr)
        Array.push((Nodes::UpdateStatement|Nodes::DeleteStatement).wheres(@ast), expr)
        m
      end
    end

    def ast(m) = raise(NotImplementedError)

    def to_sql(m, engine = Arel::Table.engine) = Nodes::Node.to_sql(ast(m), engine)
  end
end
