# A required function (body only `raise NotImplementedError`) that the includer defines with
# `yield` cannot be called with a block from the module: the stub has no yield.
module Walk
  def each_step(w) = raise(NotImplementedError)
  def steps(w)
    out = Array[]
    each_step(w) { |x| Array.push(out, x) }
    out
  end
end
class Line
  attr_reader n
  include Walk
  def each_step(l) = Integer.times(@n) { |i| yield(i) }
end
p(Line.steps(Line.new(3)))
