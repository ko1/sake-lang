# A default is only an initial value: the field's type is what is written to it, and the operation
# that uses the field checks it.
class Config
  attr_reader host, port
  def initialize(c)
    @port = 80 if @port == nil
  end
  def next_port(c) = @port + 1
end
p(Config.next_port(Config.new("h")))
p(Config.next_port(Config.new("h", "eighty")))
