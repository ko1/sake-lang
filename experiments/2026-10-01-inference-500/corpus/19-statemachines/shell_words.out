echo hello   world
  => "echo" "hello" "world"
ls -l $HOME/src | grep 'foo bar' > out.txt
  => "ls" "-l" "/home/ann/src" | "grep" "foo bar" > "out.txt"
  stages: 2, ops: 2
printf "%s says \"hi\" in $HOME" $USER && echo done
  => "printf" "%s says \"hi\" in /home/ann" "ann" && "echo" "done"
a\ b c\\d 'it''s' x$EMPTY""y
  => "a b" "c\\d" "its" "xy"
cat <in >>log; echo $UNSET.
  => "cat" < "in" >> "log" ; "echo" "."
echo 'unterminated
  error at 18: unterminated single quote
echo "also
  error at 10: unterminated double quote
trailing \
  error at 10: trailing backslash
