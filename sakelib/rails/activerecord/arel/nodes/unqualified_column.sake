# Port of activerecord-8.1.3/lib/arel/nodes/unqualified_column.rb

module Arel
  module Nodes
    class UnqualifiedColumn
      attr_accessor expr
      include Unary
      def attribute(o) = @expr
      def set_attribute(o, v) = @expr = v
      def relation(o) = Arel::Attributes::Attribute.relation(@expr)
      def name(o) = Arel::Attributes::Attribute.name(@expr)
    end
  end
end
