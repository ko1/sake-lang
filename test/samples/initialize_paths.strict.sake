# Inside initialize the new instance's fields are followed like locals: a field written on some paths
# keeps what new gave on the others, a function given the instance may write any field, and
# `@x in T` / `if @x` narrow them.
class C
  attr_reader s
  def initialize(c)
    @s = 1 if @s == nil
  end
end
p(C.new("x"))
p(C.new(nil))

class Session
  attr_reader rcpts = nil
  def initialize(s) = reset(s)
  def reset(s) = @rcpts = Array["a"]
end
p(Array.size(Session.get_rcpts(Session.new) || Array[]))

class Url
  attr_reader port
  def initialize(u)
    @port = String.to_i(@port) if @port in String
  end
end
p(Integer.to_s(Url.get_port(Url.new("8080")) + 1))
p(Url.get_port(Url.new(80)) + 1)
