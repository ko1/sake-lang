BadColor = Exception.new(:text)

def clamp255(x) = x < 0 ? 0 : (x > 255 ? 255 : x)

class Color
  attr_reader r, g, b
  include Arithmetic

  def rgb(r, g, b) = Color.new(clamp255(Float.round(r * 1.0)), clamp255(Float.round(g * 1.0)), clamp255(Float.round(b * 1.0)))

  def hex(s)
    m = String.match(String.downcase(s), /\A#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})\z/)
    raise BadColor.new("bad color #{s}", s) unless m
    Color.new(String.hex(m[1]), String.hex(m[2]), String.hex(m[3]))
  end

  def +(a, b) = rgb(@r + Color.r(b), @g + Color.g(b), @b + Color.b(b))
  def -(a, b) = rgb(@r - Color.r(b), @g - Color.g(b), @b - Color.b(b))
  def *(a, k)
    case k
    in Color then rgb(@r * Color.r(k) / 255.0, @g * Color.g(k) / 255.0, @b * Color.b(k) / 255.0)
    in Integer | Float then rgb(@r * k, @g * k, @b * k)
    end
  end

  def mix(a, b, t) = rgb(@r + (Color.r(b) - @r) * t, @g + (Color.g(b) - @g) * t, @b + (Color.b(b) - @b) * t)

  def channel(c)
    s = c / 255.0
    s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4
  end

  def luminance(a) = 0.2126 * channel(@r) + 0.7152 * channel(@g) + 0.0722 * channel(@b)

  def contrast(a, b)
    l1 = luminance(a)
    l2 = luminance(b)
    hi = l1 > l2 ? l1 : l2
    lo = l1 > l2 ? l2 : l1
    (hi + 0.05) / (lo + 0.05)
  end

  def hsl(a)
    r = @r / 255.0
    g = @g / 255.0
    b = @b / 255.0
    mx = Array.max(Array[r, g, b])
    mn = Array.min(Array[r, g, b])
    l = (mx + mn) / 2
    return [0.0, 0.0, l] if mx == mn
    d = mx - mn
    s = l > 0.5 ? d / (2 - mx - mn) : d / (mx + mn)
    h = if mx == r
      (g - b) / d + (g < b ? 6 : 0)
    elsif mx == g
      (b - r) / d + 2
    else
      (r - g) / d + 4
    end
    [h * 60, s, l]
  end

  def hue(a)
    h, s, l = hsl(a)
    h
  end

  def to_s(a) = format("#%02x%02x%02x", @r, @g, @b)
end

def gradient(stops, steps)
  out = Array[]
  Integer.times(steps) do |i|
    t = i / (steps - 1.0) * (Array.size(stops) - 1)
    seg = Array.min(Array[Float.floor(t), Array.size(stops) - 2])
    Array.push(out, Color.mix(stops[seg], stops[seg + 1], t - seg))
  end
  out
end

palette_src = Array["#1e90ff", "#ff6347", "#2e8b57", "#ffd700", "#8a2be2", "zzz", "#ffffff", "#000000", "#808080", "#f0f"]
palette = Array[]
Array.each(palette_src) do |s|
  begin
    Array.push(palette, Color.hex(s))
  rescue BadColor => e
    puts("skip: #{Exception.message(e)}")
  end
end

puts("== palette ==")
Array.each(palette) do |c|
  h, s, l = Color.hsl(c)
  puts(format("%s  h=%5.1f s=%.2f l=%.2f  lum=%.3f", c, h, s, l, Color.luminance(c)))
end

puts("== by hue (chromatic only) ==")
chromatic = Array.select(palette) { |c| Color.r(c) != Color.g(c) || Color.g(c) != Color.b(c) }
puts(Array.join(Array.sort_by(chromatic) { |c| Color.hue(c) }, " "))
puts("darkest: #{Array.min_by(palette) { |c| Color.luminance(c) }}, lightest: #{Array.max_by(palette) { |c| Color.luminance(c) }}")

puts("== arithmetic ==")
blue = Color.hex("#1e90ff")
red = Color.hex("#ff6347")
puts("blue + red = #{blue + red}")
puts("red - blue = #{red - blue}")
puts("blue * 0.5 = #{blue * 0.5}")
puts("blue * 2 = #{blue * 2}")
puts("red * blue (multiply) = #{red * blue}")
puts("mix 25% = #{Color.mix(blue, red, 0.25)}")

puts("== gradient ==")
stops = Array[Color.hex("#000080"), Color.hex("#00ffff"), Color.hex("#ffff00")]
puts(Array.join(gradient(stops, 9), " "))

puts("== text contrast ==")
white = Color.hex("#ffffff")
black = Color.hex("#000000")
Array.each(chromatic) do |bg|
  cw = Color.contrast(bg, white)
  cb = Color.contrast(bg, black)
  best = cw >= cb ? "white" : "black"
  ratio = cw >= cb ? cw : cb
  grade = ratio >= 7 ? "AAA" : (ratio >= 4.5 ? "AA" : "fail")
  puts(format("%s  vs white %5.2f  vs black %5.2f  -> %s text (%s)", bg, cw, cb, best, grade))
end
