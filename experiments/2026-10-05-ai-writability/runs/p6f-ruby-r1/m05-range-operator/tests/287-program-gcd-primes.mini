fn gcd(a, b)
  while b != 0 do
    a, b = b, a % b
  end
  return a
end
fn is_prime(n)
  if n < 2 then return false end
  let d = 2
  while d * d <= n do
    if n % d == 0 then return false end
    d += 1
  end
  return true
end
print(gcd(48, 18), gcd(17, 5), gcd(0, 9))
print(filter(range(30), is_prime))
