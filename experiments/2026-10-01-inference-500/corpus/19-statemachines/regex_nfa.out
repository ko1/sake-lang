ab*c  postfix=ab*.c. states=5
  "ac"     match
  "abbbc"  match
  "abd"    no
  "a"      no
(a|b)*abb  postfix=ab|*a.b.b. states=8
  "abb"    match
  "babb"   match
  "aabab"  no
  "bbbabb" match
colou?r  postfix=co.l.o.u?.r. states=8
  "color"  match
  "colour" match
  "colouur" no
(ab)+(c|d)?  postfix=ab.+cd|?. states=8
  "ab"     match
  "ababd"  match
  "abc"    match
  "abcd"   no
  ""       no
x(y|z)*  postfix=xyz|*. states=6
  "x"      match
  "xyzzy"  match
  "xa"     no
a(b|c  error: unbalanced (
*a  error: nothing to repeat
