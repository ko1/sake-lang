require "rack"
require "rackup"
require "net_http"

# --- a Rack app and a middleware: types, since an app cannot be a lambda ---
class Hello
  include Rack::App
  def call(app, env)
    req = Rack::Request.new(env)
    res = Rack::Response.new
    Rack::Response.set_content_type(res, "text/plain")
    case Rack::Request.path_info(req)
    in "/"
      Rack::Response.write(res, "hello #{Rack::Request.params(req)["name"] || "world"}")
    in "/form"
      p = Rack::Request.params(req)
      Rack::Response.write(res, "#{Rack::Request.request_method(req)} #{Kernel.inspect(Hash.sort_by(p) { |k, v| k })} #{Kernel.inspect(Rack::Request.media_type(req))}")
    in "/raw"
      Rack::Response.write(res, "#{Rack::Request.request_method(req)} #{Kernel.inspect(Rack::Request.media_type(req))} #{Kernel.inspect(Rack::Request.body(req))}")
    in "/cookie"
      Rack::Response.set_cookie(res, "seen", Hash[value: "yes", path: "/", http_only: true])
      Rack::Response.set_cookie(res, "n", "#{Hash.size(Rack::Request.cookies(req))}")
      Rack::Response.write(res, Kernel.inspect(Rack::Request.cookies(req)))
    in "/go"
      Rack::Response.redirect(res, "/", 303)
    in "/nothing"
      res.Rack::Response.status = 204
    in "/info"
      Rack::Response.write(res, "#{Rack::Request.url(req)} host=#{Rack::Request.host(req)} port=#{Rack::Request.port(req)} path=#{Rack::Request.path(req)} script=#{Rack::Request.script_name(req)} qs=#{Rack::Request.query_string(req)} get=#{Rack::Request.get?(req)} ua=#{Rack::Request.user_agent(req)} xhr=#{Rack::Request.xhr?(req)}")
    else
      res.Rack::Response.status = 404
      Rack::Response.write(res, "no #{Rack::Request.path_info(req)}")
    end
    Rack::Response.finish(res)
  end
end

class Counter                 # middleware: counts calls, adds a header
  attr_reader app
  attr_accessor count
  include Rack::App
  def initialize(mw) = @count = 0
  def call(mw, env)
    @count += 1
    status, headers, body = Rack::App.call(@app, env)
    headers["x-count"] = Integer.to_s(@count)
    [status, headers, body]
  end
end

puts("-- Rack::Utils")
p(Rack::Utils.parse_query("a=1&a=2&b=x+y%21&c&d="))
p(Rack::Utils.parse_query("a=1;a=2", ";"))
p(Rack::Utils.parse_nested_query("a[b]=1&a[c][d]=2&x[]=1&x[]=2&y[][k]=1&y[][k]=2&z&w=&v=1&v=2&q[=1"))
p(Rack::Utils.parse_nested_query(""))
begin
  Rack::Utils.parse_nested_query("a[]=1&a[b]=2")
rescue Rack::QueryParser::ParameterTypeError => e
  puts("ParameterTypeError: #{Exception.message(e)}")
end
begin
  Rack::Utils.parse_nested_query("a" + "[b]" * 40 + "=1")
rescue Rack::QueryParser::ParamsTooDeepError => e
  puts("ParamsTooDeepError: #{Exception.message(e)}")
end
p(Rack::Utils.build_query(Hash["a" => "1", "b" => Array["x", "y z"], "c" => nil, "d" => 2]))
p(Rack::Utils.build_nested_query(Hash["a" => Hash["b" => "1"], "x" => Array["1", "2"], "n" => nil]))
p(Rack::Utils.build_nested_query(Array["a", "b"], "list"))
begin
  Rack::Utils.build_nested_query("bare")
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
p([Rack::Utils.escape("a b&c/d"), Rack::Utils.unescape("a+b%26c"), Rack::Utils.escape_path("/a b/c?d=é"), Rack::Utils.unescape_path("/a%20b")])
p([Rack::Utils.status_code(:not_found), Rack::Utils.status_code(:ok), Rack::Utils.status_code(200), Rack::Utils.status_code("201"), Rack::Utils.status_code(:unprocessable_content)])
begin
  Rack::Utils.status_code(:teapot)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
p([Rack::Utils.http_status_codes[200], Rack::Utils.http_status_codes[418], Rack::Utils.http_status_codes[511], Hash.size(Rack::Utils.http_status_codes)])
p(Rack::Utils.parse_cookies_header("a=1; b=x%20y; a=2; c; d="))
p(Rack::Utils.parse_cookies_header(nil))
p(Rack::Utils.set_cookie_header("s", "v w"))
p(Rack::Utils.set_cookie_header("s", Hash[value: "1", domain: "example.org", path: "/", max_age: 60, expires: Time.at(0), secure: true, http_only: true, same_site: :strict]))
p(Rack::Utils.set_cookie_header("s", Hash[value: Array["a", "b"], same_site: :none]))
begin
  Rack::Utils.set_cookie_header("bad key", "v")
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
p(Rack::Utils.delete_set_cookie_header("s", Hash[path: "/x"]))
p([Rack::Utils.clean_path_info("/a/../b/./c//"), Rack::Utils.clean_path_info("a/b/../../.."), Rack::Utils.clean_path_info("")])
p([Rack::Utils.valid_path?("/ok"), Rack::Utils.valid_path?("/n\0")])
p(Rack::Utils.q_values("text/html;q=0.9, */*;q=0.1, application/json"))
p([Rack::Utils.best_q_match("gzip;q=0.5, deflate", Array["gzip", "deflate", "identity"]), Rack::Utils.best_q_match("br", Array["gzip"])])

puts("-- Rack::MockRequest.env_for, Rack::Request")
env = Rack::MockRequest.env_for("/")
p(Hash.reject(env) { |k, v| String.start_with?(k, "rack.") })
env = Rack::MockRequest.env_for("https://example.com:8443/a/b?x=1&y[z]=2", method: :post, input: "k=v&list[]=1", headers: Hash["CONTENT_TYPE" => "application/x-www-form-urlencoded", "HTTP_COOKIE" => "a=1; b=x%20y", "HTTP_USER_AGENT" => "sake"])
p(Hash.reject(env) { |k, v| String.start_with?(k, "rack.") })
p(env["rack.input"])
req = Rack::Request.new(env)
p([Rack::Request.request_method(req), Rack::Request.get?(req), Rack::Request.post?(req), Rack::Request.put?(req)])
p([Rack::Request.path_info(req), Rack::Request.script_name(req), Rack::Request.path(req), Rack::Request.query_string(req), Rack::Request.fullpath(req)])
p([Rack::Request.scheme(req), Rack::Request.ssl?(req), Rack::Request.host(req), Rack::Request.hostname(req), Rack::Request.port(req), Rack::Request.host_with_port(req), Rack::Request.base_url(req), Rack::Request.url(req)])
p([Rack::Request.content_type(req), Rack::Request.media_type(req), Rack::Request.content_length(req), Rack::Request.form_data?(req), Rack::Request.user_agent(req), Rack::Request.xhr?(req)])
p(Rack::Request.GET(req))
p(Rack::Request.POST(req))
p(Rack::Request.params(req))
p(Rack::Request.cookies(req))
p(Rack::Request.body(req))
env = Rack::MockRequest.env_for("http://example.org:80/p", params: Hash["q" => "1", "r" => Array["a", "b"]], headers: Hash["HTTP_HOST" => "example.org", "HTTP_X_FORWARDED_PROTO" => "https", "CONTENT_TYPE" => "text/html; charset=utf-8"])
req = Rack::Request.new(env)
p([env["QUERY_STRING"], Rack::Request.params(req), Rack::Request.scheme(req), Rack::Request.port(req), Rack::Request.url(req), Rack::Request.media_type(req), Rack::Request.media_type_params(req), Rack::Request.content_charset(req)])
env = Rack::MockRequest.env_for("/p", method: "post", params: Hash["a" => "1", "b" => Hash["c" => "2"]])
req = Rack::Request.new(env)
p([env["CONTENT_TYPE"], env["rack.input"], env["CONTENT_LENGTH"], Rack::Request.params(req), Rack::Request.body(req)])
env = Rack::MockRequest.env_for("/p", method: "POST", input: "{\"a\":1}", headers: Hash["CONTENT_TYPE" => "application/json"])
req = Rack::Request.new(env)
p([Rack::Request.params(req), Rack::Request.form_data?(req), Rack::Request.body(req), Rack::Request.cookies(req)])
env = Rack::MockRequest.env_for("/p", headers: Hash["HTTP_HOST" => "[::1]:3000", "HTTP_ACCEPT_LANGUAGE" => "ja, en;q=0.5"])
req = Rack::Request.new(env)
p([Rack::Request.host(req), Rack::Request.hostname(req), Rack::Request.port(req), Rack::Request.url(req), Rack::Request.accept_language(req)])

puts("-- Rack::Response")
res = Rack::Response.new
p(Rack::Response.finish(res))
p([Rack::Response.status(res), Rack::Response.ok?(res), Rack::Response.successful?(res), Rack::Response.body(res), Rack::Response.headers(res)])
res = Rack::Response.new("hi")
p(Rack::Response.finish(res))
res = Rack::Response.new(String["a", "bc"], 201, Hash["Content-Type" => "text/plain", "X-Y" => "z"])
p(Rack::Response.finish(res))
Rack::Response.write(res, "d")
p(Rack::Response.finish(res))
p([Rack::Response.content_type(res), Rack::Response.media_type(res), Rack::Response.content_length(res), Rack::Response.get_header(res, "x-y"), Rack::Response.has_header?(res, "x-y"), Rack::Response.has_header?(res, "nope"), Rack::Response.created?(res)])
res = Rack::Response.new
Rack::Response.set_cookie(res, "s", Hash[value: "1", path: "/", http_only: true, same_site: :lax])
Rack::Response.set_cookie(res, "t", "2")
p(Rack::Response.headers(res))
Rack::Response.delete_cookie(res, "s")
p(Rack::Response.set_cookie_header(res))
Rack::Response.add_header(res, "vary", "accept-encoding")
Rack::Response.add_header(res, "vary", "cookie")
p([Rack::Response.get_header(res, "vary"), Rack::Response.add_header(res, "vary", nil)])
Rack::Response.redirect(res, "/elsewhere")
p([Rack::Response.status(res), Rack::Response.location(res), Rack::Response.redirect?(res), Rack::Response.redirection?(res)])
res = Rack::Response.new("gone", 204, Hash["content-type" => "text/plain"])
p(Rack::Response.finish(res))
p([Rack::Response.no_content?(res), Rack::Response.client_error?(res), Rack::Response.invalid?(res)])
res = Rack::Response.new(nil, 404)
Rack::Response.write(res, "a")
Rack::Response.write(res, "é")
p([Rack::Response.finish(res), Rack::Response.not_found?(res), Rack::Response.server_error?(res)])
res = Rack::Response.new(nil, "500")
p([Rack::Response.status(res), Rack::Response.server_error?(res)])
Rack::Response.set_content_type(res, "application/json")
Rack::Response.set_etag(res, "\"abc\"")
Rack::Response.set_cache_control(res, "no-store")
Rack::Response.set_header(res, "x-removed", "1")
Rack::Response.delete_header(res, "x-removed")
p(Rack::Response.headers(res))
parts = String[]
Rack::Response.each(Rack::Response.new(String["x", "y"])) { |s| Array.push(parts, s) }
p(parts)

puts("-- the app through Rack::MockRequest")
app = Counter.new(Hello.new)
status, headers, body = Rack::App.call(app, Rack::MockRequest.env_for("/?name=Sake"))
p([status, headers, body])
p(Rack::MockRequest.get(app, "/form", params: Hash["q" => "1"]))
p(Rack::MockRequest.post(app, "/form", params: Hash["a" => "1", "b" => Hash["c" => "2"]]))
p(Rack::MockRequest.post(app, "/form?x=9", input: "k=v", headers: Hash["CONTENT_TYPE" => "application/x-www-form-urlencoded"]))
p(Rack::MockRequest.post(app, "/raw", input: "k=v", headers: Hash["CONTENT_TYPE" => "application/x-www-form-urlencoded"]))
p(Rack::MockRequest.get(app, "/cookie", headers: Hash["HTTP_COOKIE" => "a=1; b=2"]))
p(Rack::MockRequest.get(app, "/go"))
p(Rack::MockRequest.get(app, "/nothing"))
p(Rack::MockRequest.get(app, "/missing"))
p(Counter.count(app))

puts("-- the app served by webrick (Rackup::Handler::WEBrick)")
srv = WEBrick::HTTPServer.new("127.0.0.1", 0)
port = WEBrick::HTTPServer.port(srv)
WEBrick::HTTPServer.mount(srv, "/", Rackup::Handler::WEBrick.new(app))
t = Thread.new { WEBrick::HTTPServer.start(srv) }
def url(port, path) = URI.parse("http://127.0.0.1:#{port}#{path}")
def show(res)
  puts("#{Net::HTTPResponse.code(res)} type=#{Kernel.inspect(res["content-type"])} length=#{Kernel.inspect(res["content-length"])} count=#{res["x-count"]} body=#{Kernel.inspect(Net::HTTPResponse.body(res))}")
end
show(Net::HTTP.get_response(url(port, "/")))
show(Net::HTTP.get_response(url(port, "/?name=net")))
show(Net::HTTP.post_form(url(port, "/form"), Hash["k" => "v w", "n" => "1"]))
show(Net::HTTP.post(url(port, "/form"), "{\"a\":1}", Hash["Content-Type" => "application/json"]))
show(Net::HTTP.post(url(port, "/raw"), "{\"a\":1}", Hash["Content-Type" => "application/json"]))
res = Net::HTTP.get_response(url(port, "/cookie"), Hash["Cookie" => "a=1; b=2"])
show(res)
p(Net::HTTPResponse.get_fields(res, "set-cookie"))
res = Net::HTTP.get_response(url(port, "/go"))
puts("#{Net::HTTPResponse.code(res)} location=#{String.sub(res["location"] || "", /:\d+\//, ":PORT/")}")
show(Net::HTTP.get_response(url(port, "/nothing")))
show(Net::HTTP.get_response(url(port, "/missing")))
res = Net::HTTP.get_response(url(port, "/info?q=1"), Hash["User-Agent" => "sake-test", "X-Requested-With" => "XMLHttpRequest"])
puts(String.gsub(Net::HTTPResponse.body(res) || "", /\d{4,5}/, "PORT"))
WEBrick::HTTPServer.shutdown(srv)
Thread.join(t)
p(Counter.count(app))
puts("end")
