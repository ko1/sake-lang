sql> SELECT name, age FROM people WHERE age > 30 ORDER BY age DESC
  name=cy, age=45
  name=fay, age=39
  name=ann, age=34
  name=dee, age=31
  (4 rows)
sql> select name from people where city = 'Tokyo' and salary >= 650 or name = 'eve'
  name=cy
  name=eve
  name=fay
  (3 rows)
sql> SELECT city, COUNT(*), AVG(salary), MAX(age) FROM people GROUP BY city ORDER BY city
  city=Kyoto, count(*)=1, avg(salary)=530.0, max(age)=31
  city=Osaka, count(*)=2, avg(salary)=415.0, max(age)=27
  city=Tokyo, count(*)=3, avg(salary)=661.67, max(age)=45
  (3 rows)
sql> SELECT SUM(salary) FROM people WHERE city != 'Osaka'
  sum(salary)=2515
  (1 rows)
sql> SELECT * FROM people WHERE age < 30 ORDER BY name LIMIT 1
  name=bob age=27 city=Osaka salary=480
  (1 rows)
sql> SELECT city, COUNT(*) FROM people GROUP BY city ORDER BY age
  error: cannot order by age
sql> SELECT name FROM people ORDER BY salary LIMIT 3
  name=eve
  name=bob
  name=dee
  (3 rows)
sql> SELECT name FROM people WHERE age > 'old'
  error: type mismatch on age
sql> SELECT name FROM pets
  error: no such table: pets
sql> SELECT height FROM people
  error: no such column: height
sql> SELECT name people
  error: expected FROM but got people
sql> SELECT name FROM people WHERE age ~ 3
  error: bad operator 3
sql> SELECT AVG(city) FROM people
  error: avg needs numbers
