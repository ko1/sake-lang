# Port of activesupport-8.1.3/lib/active_support/core_ext/string/indent.rb

class String
  def indent!(s, amount, indent_string = nil, indent_empty_lines = false)
    own = String.match(s, /^[ \t]/)
    is = indent_string || (own ? MatchData.to_s(own) : " ")
    String.gsub!(s, indent_empty_lines ? /^/ : /^(?!$)/, is * amount)
  end

  def indent(s, amount, indent_string = nil, indent_empty_lines = false)
    r = dup(s)
    String.indent!(r, amount, indent_string, indent_empty_lines)
    r
  end
end
