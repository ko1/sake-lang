def pct(c, active)
  return "0.0%" if active == 0
  v = (c * 2000 + active) / (2 * active)
  "#{v / 10}.#{v % 10}%"
end

def main
  lines = IO.readlines(IO.stdin)
  names = Array.empty?(lines) ? Array[] : String.split(lines[0])
  if Array.empty?(names)
    puts("no candidates")
    return
  end
  cands = Array.sort(Array.uniq(names))
  ballots = Array[]
  rejected = 0
  i = 1
  while i < Array.size(lines)
    raw = String.chomp(lines[i])
    i += 1
    next if String.empty?(String.strip(raw))
    ranks = Array.map(String.split(raw, ">", -1)) { |s| String.strip(s) }
    seen = Set[]
    reason = nil
    Array.each(ranks) do |nm|
      if String.empty?(nm)
        reason = "empty rank"
      elsif !Array.include?(cands, nm)
        reason = "unknown candidate #{nm}"
      elsif Set.include?(seen, nm)
        reason = "duplicate #{nm}"
      end
      break if reason
      Set.add(seen, nm)
    end
    if reason
      puts("rejected line #{i}: #{reason}")
      rejected += 1
    else
      Array.push(ballots, ranks)
    end
  end
  puts("ballots: #{Array.size(ballots)} valid, #{rejected} rejected")
  alive = Array.dup(cands)
  history = Array[]
  round = 1
  while true
    puts("round #{round}")
    votes = Hash[]
    Array.each(alive) { |c| votes[c] = 0 }
    exhausted = 0
    Array.each(ballots) do |b|
      pick = Array.find(b) { |nm| Array.include?(alive, nm) }
      if pick == nil
        exhausted += 1
      else
        votes[pick] += 1
      end
    end
    active = Array.size(ballots) - exhausted
    Array.push(history, votes)
    order = Array.sort_by(alive) { |c| [-votes[c], c] }
    Array.each(order) { |c| puts("  #{c} #{votes[c]} #{pct(votes[c], active)}") }
    puts("  exhausted #{exhausted}")
    if active == 0
      puts("no winner")
      return
    end
    win = Array.find(alive) { |c| votes[c] * 2 > active }
    if win != nil
      puts("winner #{win}")
      return
    end
    low = Array.min(Array.map(alive) { |c| votes[c] })
    tied = Array.select(alive) { |c| votes[c] == low }
    j = Array.size(history) - 2
    while j >= 0 && Array.size(tied) > 1
      h = history[j]
      m = Array.min(Array.map(tied) { |c| h[c] })
      tied = Array.select(tied) { |c| h[c] == m }
      j -= 1
    end
    out = Array.max(tied)
    puts("  eliminated #{out}")
    alive = Array.reject(alive) { |c| c == out }
    round += 1
  end
end

main
