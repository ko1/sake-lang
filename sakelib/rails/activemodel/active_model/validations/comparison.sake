# Port of activemodel-8.1.3/lib/active_model/validations/comparison.rb (partial: no Proc values)

module ActiveModel
  module Validations
    class ComparisonValidator < EachValidator
      include Comparability
      include ResolveValue

      def check_validity!(v)
        unless Array.any?(Comparability.COMPARE_CHECKS) { |k| Hash.key?(@options, k) }
          raise ArgumentError, "Expected one of :greater_than, :greater_than_or_equal_to, " +
            ":equal_to, :less_than, :less_than_or_equal_to, or :other_than option to be supplied."
        end
      end

      def validate_each(v, record, attr_name, value)
        errors = ActiveModel::Validations.errors(record)
        Array.each(Comparability.COMPARE_CHECKS) do |option|
          next unless Hash.key?(@options, option)
          begin
            option_value = resolve_value(v, record, @options[option])
            if (value in nil) || Object.blank?(value)
              ActiveModel::Errors.add_with(errors, attr_name, :blank, error_options(v, value, option_value))
              return nil
            end
            unless Comparability.check(option, value, option_value)
              ActiveModel::Errors.add_with(errors, attr_name, option, error_options(v, value, option_value))
            end
          rescue ArgumentError => e
            ActiveModel::Errors.add_with(errors, attr_name, Exception.message(e), Hash.new)
          end
        end
      end
    end
  end
end
