Member = Struct.new(:name, :plan, :expires, :punches, :visits)
AccessDenied = Exception.new()

class Member
  def check_in(m, day)
    case @plan
    in :punch
      raise AccessDenied.new("#{@name}: no punches left") if @punches == 0
      @punches -= 1
    in :monthly | :annual
      raise AccessDenied.new("#{@name}: expired on day #{@expires}") if day > @expires
    end
    Array.push(@visits, day)
  end
end

def plan_fee(plan)
  case plan
  in :monthly then 49
  in :annual then 480
  in :punch then 90
  end
end

members = Hash[
  "ann" => Member.new("Ann", :monthly, 30, 0, Array[]),
  "raj" => Member.new("Raj", :annual, 365, 0, Array[]),
  "sue" => Member.new("Sue", :punch, 0, 3, Array[]),
  "tom" => Member.new("Tom", :monthly, 12, 0, Array[]),
  "kim" => Member.new("Kim", :punch, 0, 10, Array[])
]

log = "1 ann,1 raj,2 sue,3 ann,4 tom,5 sue,8 raj,9 sue,10 ann,11 sue,13 tom,15 raj,16 ann,18 bob,20 raj,22 ann,25 raj,29 ann,31 ann"
denied = 0
Array.each(String.split(log, ",")) do |entry|
  day_s, who = String.split(entry, " ")
  m = members[who]
  if m == nil
    puts("day #{day_s}: unknown card #{who}")
    next
  end
  begin
    Member.check_in(m, String.to_i(day_s))
  rescue AccessDenied => e
    denied += 1
    puts("day #{day_s}: denied, #{Exception.message(e)}")
  end
end

puts
today = 31
Hash.each_value(members) do |m|
  visits = Member.visits(m)
  last = Array.last(visits)
  idle = last ? today - last : today
  per_visit = Array.empty?(visits) ? "-" : format("%.2f", plan_fee(Member.plan(m)) * 1.0 / Array.size(visits))
  flag = idle >= 14 ? "  <- at risk" : ""
  puts(format("%-4s %-8s visits %2d  idle %2d  per visit %6s%s", Member.name(m), Member.plan(m), Array.size(visits), idle, per_visit, flag))
end
puts
busiest = Array.tally(Array.flat_map(Hash.values(members)) { |m| Array.map(Member.visits(m)) { |d| d % 7 } })
day, n = Hash.max_by(busiest) { |d, c| [c, -d] }
puts("Busiest weekday index: #{day} (#{n} visits); denied #{denied}")
