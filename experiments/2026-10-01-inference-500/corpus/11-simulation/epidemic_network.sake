Person = Struct.new(:name, :state, :days_sick, :infected_by, :infected_on)
Lcg = Struct.new(:seed)

class Lcg
  def roll(r)
    @seed = (@seed * 214013 + 2531011) % 4294967296
    (@seed / 65536) % 1000
  end
end

def build_graph(edges)
  graph = Hash[]
  Array.each(edges) do |a, b|
    graph[a] = String[] if graph[a] == nil
    graph[b] = String[] if graph[b] == nil
    Array.push(graph[a], b)
    Array.push(graph[b], a)
  end
  graph
end

def simulate(graph, patient_zero, vaccinated, beta, recover_days, seed)
  rng = Lcg.new(seed)
  people = Hash[]
  Array.each(Array.sort(Hash.keys(graph))) do |name|
    state = Array.include?(vaccinated, name) ? :recovered : :susceptible
    people[name] = Person.new(name, state, 0, nil, nil)
  end
  zero = people[patient_zero]
  Person.set_state(zero, :infected)
  Person.set_infected_on(zero, 0)
  curve = Array[]
  day = 0
  while Hash.any?(people) { |n, p| Person.state(p) == :infected }
    day += 1
    sick = Array.select(Hash.values(people)) { Person.state(it) == :infected }
    newly = Array[]
    Array.each(sick) do |p|
      Array.each(graph[Person.name(p)]) do |other_name|
        other = people[other_name]
        next unless Person.state(other) == :susceptible
        next if Array.include?(newly, other)
        if Lcg.roll(rng) < beta
          Array.push(newly, other)
          Person.set_infected_by(other, Person.name(p))
        end
      end
    end
    Array.each(sick) do |p|
      Person.set_days_sick(p, Person.days_sick(p) + 1)
      Person.set_state(p, :recovered) if Person.days_sick(p) >= recover_days
    end
    Array.each(newly) do |p|
      Person.set_state(p, :infected)
      Person.set_infected_on(p, day)
    end
    counts = Hash.new(0)
    Hash.each(people) { |n, p| counts[Person.state(p)] += 1 }
    Array.push(curve, [day, counts[:susceptible], counts[:infected], counts[:recovered]])
  end
  [people, curve]
end

def chain(people, name)
  links = String[name]
  cur = people[name]
  while cur
    src = Person.infected_by(cur)
    break if src == nil
    Array.push(links, src)
    cur = people[src]
  end
  Array.join(Array.reverse(links), " > ")
end

def report(title, graph, vaccinated)
  people, curve = simulate(graph, "ann", vaccinated, 350, 3, 42)
  puts("== #{title}")
  Array.each(curve) do |day, s, i, r|
    puts(format("day %2d  S %2d  I %2d  R %2d  %s", day, s, i, r, "*" * i))
  end
  infected = Array.select(Hash.values(people)) { Person.infected_on(it) != nil }
  peak = Array.max_by(curve) { |d, s, i, r| i }
  if peak
    pd, ps, pi, pr = peak
    puts("peak: #{pi} infected on day #{pd}")
  end
  puts("total infected: #{Array.size(infected)} of #{Hash.size(people)}")
  spreaders = Array.tally(Array.filter_map(infected) { Person.infected_by(it) })
  top = Hash.max_by(spreaders) { |n, c| c }
  if top
    who, count = top
    puts("top spreader: #{who} (#{count})")
  end
  last = Array.max_by(infected) { Person.infected_on(it) }
  puts("longest chain: #{chain(people, Person.name(last))}") if last
  Array.size(infected)
end

edges = Array[
  ["ann", "bob"], ["ann", "cy"], ["ann", "dee"], ["bob", "cy"], ["bob", "eli"],
  ["cy", "fay"], ["dee", "gil"], ["eli", "fay"], ["eli", "hal"], ["fay", "ivy"],
  ["gil", "hal"], ["gil", "jo"], ["hal", "kai"], ["ivy", "kai"], ["jo", "kai"],
  ["kai", "lee"], ["lee", "max"], ["max", "ned"], ["ned", "oz"], ["lee", "oz"],
  ["fay", "pat"], ["pat", "quin"], ["quin", "ivy"], ["dee", "eli"]
]
graph = build_graph(edges)
degrees = Array.sort_by(Hash.to_a(graph)) { |n, nbrs| format("%03d %s", 100 - Array.size(nbrs), n) }
puts("most connected: #{Array.join(Array.map(Array.take(degrees, 3)) { |n, nbrs| "#{n}(#{Array.size(nbrs)})" }, " ")}")

base = report("no vaccination", graph, String[])
hubs = Array.map(Array.take(degrees, 3)) { |n, nbrs| n }
Array.delete(hubs, "ann")
targeted = report("vaccinate hubs #{Array.join(hubs, ",")}", graph, hubs)
puts(format("infections avoided: %d (%.0f%%)", base - targeted, 100.0 * (base - targeted) / base))
