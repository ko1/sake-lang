# sake: --strict=3
# A module in a pattern takes the types that include it; `in IndexError` also takes KeyError, as Ruby's ===.
module Shape
  def area(s) = 0
end
class Circle
  include Shape
  attr_reader r
  def area(c) = 3 * @r * @r
end
class Square
  include Shape
  attr_reader side
  def area(s) = @side * @side
end
def describe(x)
  case x
  in Shape then "shape of area #{Shape.area(x)}"
  in Integer then "number"
  end
end
p describe(Circle.new(2))
p describe(Square.new(3))
p describe(4)
p((Any[1] in Enum))
begin
  Hash.fetch(Hash.of("a" => 1), "b")
rescue => e
  case e
  in IndexError then puts "index-like: " + Exception.message(e)
  else puts "other"
  end
end
