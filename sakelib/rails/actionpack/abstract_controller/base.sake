# Port of actionpack-8.1.3/lib/abstract_controller/base.rb (partial: no DescendantsTracker, no DidYouMean corrections; config is ActionController's)
#
# Ruby's AbstractController::Base is the root of every controller class. Here it is a class whose fields and
# functions `class ActionController::Metal < AbstractController::Base` pastes (Sake's `<` is a copy).
# What Ruby finds by reflection is generated per controller (action_controller/generate/controllers.sake):
#
#   Ruby                                             Sake (generated from the controller's source)
#   public_instance_methods(true) - internal_methods def PostsController.action_methods(c) = Set.of("index", "show")
#   send(action_name)                                def PostsController.send_action(c, name) = case name in "index" then index(c) ...
#   self.class.name, controller_path                 def PostsController._class_name(c) = "PostsController", controller_path(c)

require "error"

module AbstractController
  class Base
    private attr_accessor _response_body, _action_name, _formats

    # Required of each controller (generated).
    def action_methods(c) = raise(NotImplementedError)
    def controller_path(c) = raise(NotImplementedError)
    def _class_name(c) = raise(NotImplementedError)
    def _send_action(c, method_name) = raise(NotImplementedError)       # Ruby's send(method_name)
    def _prefixes(c) = raise(NotImplementedError)                       # ActionView::ViewPaths' _prefixes

    def response_body(c) = @_response_body
    def action_name(c) = @_action_name || ""
    def set_action_name(c, name) = @_action_name = name
    def formats(c) = @_formats || Symbol[]
    def set_formats(c, formats) = @_formats = formats

    # Calls the action going through the entire action dispatch stack.
    def process(c, action)
      @_action_name = Kernel.to_s(action)
      action_name = _find_action_name(c, Kernel.to_s(action))
      unless action_name
        raise ActionNotFound.new("The action '#{action}' could not be found for #{_class_name(c)}", _class_name(c), Kernel.to_s(action))
      end
      @_response_body = nil
      process_action(c, action_name)
    end

    def available_action?(c, action_name) = _find_action_name(c, action_name) != nil

    def performed?(c) = @_response_body != nil

    def supports_path? = true

    def inspect(c) = "#<#{_class_name(c)}>"

    def action_method?(c, name) = Set.include?(action_methods(c), name)

    # Ruby's private process_action(...) = send_action(...); the controller's modules wrap it (see ActionController::Base).
    def process_action(c, method_name) = send_action(c, method_name)
    def send_action(c, method_name) = _send_action(c, method_name)

    def _find_action_name(c, action_name) = _valid_action_name?(action_name) ? method_for_action(c, action_name) : nil

    # Ruby also answers "_handle_action_missing" when the controller responds to action_missing.
    def method_for_action(c, action_name) = action_method?(c, action_name) ? action_name : nil

    def _valid_action_name?(action_name) = !String.include?(action_name, "/")
  end
end
