# Digit-based curiosities: digit sums, digital roots, Armstrong and Harshad
# numbers, palindromes, reverse-and-add (Lychrel candidates), Kaprekar's routine.

def digit_sum(n) = Array.sum(Integer.digits(n))

def digital_root(n)
  while n >= 10
    n = digit_sum(n)
  end
  n
end


def reverse_num(n)
  Array.reduce(Integer.digits(n), 0) { |acc, d| acc * 10 + d }
end

def palindrome?(n) = n == reverse_num(n)

def armstrong?(n)
  ds = Integer.digits(n)
  k = Array.size(ds)
  Array.sum(Array.map(ds) { |d| d ** k }) == n
end

def harshad?(n) = n % digit_sum(n) == 0

# returns [steps, palindrome] or nil when no palindrome within the limit
def reverse_and_add(n, limit)
  steps = 0
  while steps < limit
    n += reverse_num(n)
    steps += 1
    return [steps, n] if palindrome?(n)
  end
  nil
end

def kaprekar_steps(n)
  seen = Array[]
  while n != 6174 && n != 0
    ds = Integer.digits(n)
    Array.push(ds, 0) while Array.size(ds) < 4
    asc = Array.sort(ds)
    big = Array.reduce(Array.reverse(asc), 0) { |acc, d| acc * 10 + d }
    small = Array.reduce(asc, 0) { |acc, d| acc * 10 + d }
    Array.push(seen, "#{big}-#{String.rjust(Integer.to_s(small), 4, "0")}")
    n = big - small
  end
  [n, seen]
end

puts("digital roots:")
Array.each(Array[16, 942, 132189, 493193, 999999999]) do |n|
  puts("  #{String.rjust(Integer.to_s(n), 10)}  sum=#{digit_sum(n)}  root=#{digital_root(n)}")
end

arm = Range.select(1..9999) { |n| armstrong?(n) }
puts("Armstrong numbers < 10000: #{Array.join(arm, " ")}")

harshad = Range.select(1..60) { |n| harshad?(n) }
puts("Harshad numbers <= 60: #{Array.size(harshad)}")
puts("  #{Array.join(harshad, ",")}")

run = 0
best_run = 0
best_start = 0
Range.each(1..2000) do |n|
  if harshad?(n)
    run += 1
    if run > best_run
      best_run = run
      best_start = n - run + 1
    end
  else
    run = 0
  end
end
puts("longest run of consecutive Harshad numbers <= 2000: #{best_run} from #{best_start}")

pal_squares = Range.select(1..300) { |n| palindrome?(n * n) && n > 3 }
puts("n with palindromic n^2: #{Array.join(Array.map(pal_squares) { |n| "#{n}^2=#{n * n}" }, " ")}")

puts("reverse-and-add:")
Array.each(Array[56, 87, 89, 196, 295]) do |n|
  r = reverse_and_add(n, 30)
  if r
    steps, pal = r
    puts("  #{n}: #{steps} steps -> #{pal}")
  else
    puts("  #{n}: no palindrome in 30 steps (Lychrel candidate)")
  end
end

puts("Kaprekar routine:")
Array.each(Array[3524, 2111, 9831, 1000, 7777]) do |n|
  final, trail = kaprekar_steps(n)
  label = final == 0 ? "degenerate" : "#{Array.size(trail)} steps"
  puts("  #{n}: #{label}")
  puts("    #{Array.join(trail, " / ")}") if Array.size(trail) <= 3
end

hist = Hash.new(0)
Range.each(1000..1999) do |n|
  final, trail = kaprekar_steps(n)
  hist[Array.size(trail)] += 1 if final == 6174
end
Array.each(Array.sort(Hash.keys(hist))) { |k| puts("  #{k} steps: #{hist[k]}") }
