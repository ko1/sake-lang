first_line = gets
if first_line == nil
  puts("invalid width")
  exit()
end

width_str = String.strip(first_line)
if String.empty?(width_str) || !String.match?(width_str, /^\d+$/)
  puts("invalid width")
  exit()
end

width = String.to_i(width_str)
if width < 2 || width > 80
  puts("invalid width")
  exit()
end

# Read all text lines
text_lines = Array[]
while (line = gets)
  Array.push(text_lines, line)
end

# Split into paragraphs
paragraphs = Array[]
current_para = Array[]

Array.each(text_lines) { |line|
  stripped = String.strip(line)
  if String.empty?(stripped)
    if Array.size(current_para) > 0
      Array.push(paragraphs, current_para)
      current_para = Array[]
    end
  else
    Array.push(current_para, stripped)
  end
}

if Array.size(current_para) > 0
  Array.push(paragraphs, current_para)
end

# Extract all words and process paragraphs
all_words = Array[]
processed_paras = Array[]

Array.each(paragraphs) { |para|
  para_lines = Array[]

  Array.each(para) { |line|
    words = String.split(line)
    Array.each(words) { |word|
      Array.push(all_words, word)
    }
  }

  # Break long words
  broken_words = Array[]
  Array.each(all_words) { |word|
    while String.size(word) > width
      piece = String.slice(word, 0, width - 1) + String["-"]
      Array.push(broken_words, piece)
      word = String.slice(word, width - 1)
    end
    if String.size(word) > 0
      Array.push(broken_words, word)
    end
  }

  # Fill lines greedily
  lines = Array[]
  current_line = Array[]

  Array.each(broken_words) { |word|
    if Array.size(current_line) == 0
      Array.push(current_line, word)
    else
      # Check if adding this word fits
      joined = Array.join(current_line, " ")
      test_line = joined + " " + word
      if String.size(test_line) <= width
        Array.push(current_line, word)
      else
        Array.push(lines, current_line)
        current_line = Array[word]
      end
    end
  }

  if Array.size(current_line) > 0
    Array.push(lines, current_line)
  end

  Array.push(processed_paras, lines)
}

# Output
puts("+" + String.*(String["-"], width) + "+")

total_output_lines = 0
Array.each_with_index(processed_paras) { |para_lines, p_idx|
  is_last_para = p_idx == (Array.size(processed_paras) - 1)
  Array.each_with_index(para_lines) { |line_words, l_idx|
    is_last_line = l_idx == (Array.size(para_lines) - 1)

    if Array.size(line_words) == 1 || is_last_line
      # Left-align
      text = Array.join(line_words, " ")
      padded = String.ljust(text, width)
      puts("|" + padded + "|")
    else
      # Justify
      words_str = Array.join(line_words, "")
      words_len = String.size(words_str)
      gaps = Array.size(line_words) - 1
      spaces_needed = width - words_len
      spaces_per_gap = spaces_needed / gaps
      extra_spaces = spaces_needed % gaps

      line = String[""]
      Array.each_with_index(line_words) { |w, i|
        line += w
        if i < gaps
          spaces = spaces_per_gap
          if i < extra_spaces
            spaces += 1
          end
          line += String.*(String[" "], spaces)
        end
      }
      puts("|" + line + "|")
    end

    total_output_lines += 1
  }

  if !is_last_para
    puts("|" + String.*(String[" "], width) + "|")
  end
}

puts("+" + String.*(String["-"], width) + "+")
puts("paragraphs: #{Array.size(processed_paras)}, lines: #{total_output_lines}, words: #{Array.size(all_words)}")
