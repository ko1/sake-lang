module Sql
  module Modify
    def self.insert: (Ast::Insert statement, Catalog catalog) -> void
    def self.insert_targets: (Ast::Insert statement, Table table) -> Array[Integer]
    def self.update: (Ast::Update statement, Catalog catalog) -> void
    def self.delete: (Ast::Delete statement, Catalog catalog) -> void
    def self.target_resolver: (Table table, Catalog catalog) -> Resolver
    def self.matches?: (Ast::Expr? where, Array[value] row) -> bool
  end
end
