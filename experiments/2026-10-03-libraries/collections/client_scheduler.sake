# A task scheduler: tasks ordered by (priority, deadline). Other heaps in the same program hold
# Integers, Strings, and Tuples, each in its own type that includes HeapOps.

class Task < {reader: [name, priority, deadline]}
  include Comparable
  def <=>(a, b) = [@priority, @deadline] <=> [Task.get_priority(b), Task.get_deadline(b)]
  def to_s(t) = "#{@name}(p#{@priority},d#{@deadline})"
end

class TaskQueue < {reader: [items], accessor: [seq]}
  include HeapOps
end
class IntHeap < {reader: [items], accessor: [seq]}
  include HeapOps
end
class WordHeap < {reader: [items], accessor: [seq]}
  include HeapOps
end

tasks = TaskQueue.with_items(Task[])
TaskQueue.push(tasks, Task.new("write report", 2, 30))
TaskQueue.push(tasks, Task.new("fix prod bug", 1, 10))
TaskQueue.push(tasks, Task.new("lunch", 3, 12))
TaskQueue.push(tasks, Task.new("review PR", 1, 5))
TaskQueue.push(tasks, Task.new("reply mail", 2, 8))

clock = 0
TaskQueue.drain(tasks) do |t|
  clock += 3
  late = clock > Task.get_deadline(t) ? " LATE" : ""
  puts("t=#{clock} run #{t}#{late}")
end

nums = IntHeap.with_items(Integer[])
Array.each(Array[5, 3, 9, 1, 7]) { |n| IntHeap.push(nums, n) }
sorted = Integer[]
IntHeap.drain(nums) { |n| Array.push(sorted, n) }
p(sorted)

words = WordHeap.with_items(String[])
Array.each(String.split("pear apple fig kiwi", " ")) { |w| WordHeap.push(words, w) }
WordHeap.drain(words) { |w| print(String.upcase(w), " ") }
puts

# The ready-made Heap, used with one element type: a max-heap of words by length via a Tuple key.
by_len = Heap.create
Array.each(String.split("a abc ab abcd", " ")) { |w| Heap.push(by_len, [-String.size(w), w]) }
longest = Heap.pop(by_len)
if longest
  n, w = longest
  puts("longest: #{w} (#{-n})")
end
