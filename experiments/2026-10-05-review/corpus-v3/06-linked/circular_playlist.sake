Track = Struct.new(:title, :artist, :secs, :prev, :next)

class Track
  def to_s(t) = "#{@title} (#{@artist}, #{@secs / 60}:#{String.rjust(Integer.to_s(@secs % 60), 2, "0")})"
end

class Playlist
  attr_reader name, now, count
  def initialize(p)
    @now = nil
    @count = 0
  end

  def add(pl, title, artist, secs)
    t = Track.new(title, artist, secs, nil, nil)
    cur = @now
    if cur == nil
      Track.set_prev(t, t)
      Track.set_next(t, t)
      @now = t
    else
      last = Track.prev(cur)
      Track.set_next(last, t)
      Track.set_prev(t, last)
      Track.set_next(t, cur)
      Track.set_prev(cur, t)
    end
    @count += 1
    t
  end

  def each_from_now(pl)
    start = @now
    return unless start
    t = start
    Integer.times(@count) do
      yield(t)
      t = Track.next(t)
    end
  end

  def skip(pl, n)
    cur = @now
    return nil unless cur
    if n >= 0
      Integer.times(n) { cur = Track.next(cur) }
    else
      Integer.times(-n) { cur = Track.prev(cur) }
    end
    @now = cur
  end

  def remove_current(pl)
    cur = @now
    return nil unless cur
    if @count == 1
      @now = nil
    else
      p = Track.prev(cur)
      n = Track.next(cur)
      Track.set_next(p, n)
      Track.set_prev(n, p)
      @now = n
    end
    @count -= 1
    cur
  end

  def move_current_after(pl, title)
    target = nil
    each_from_now(pl) { |t| target ||= t if Track.title(t) == title }
    cur = @now
    return false if target == nil || cur == nil || Track.title(target) == Track.title(cur)
    moved = remove_current(pl)
    @count += 1
    after = Track.next(target)
    Track.set_next(target, moved)
    Track.set_prev(moved, target)
    Track.set_next(moved, after)
    Track.set_prev(after, moved)
    true
  end

  def total_secs(pl)
    s = 0
    each_from_now(pl) { |t| s += Track.secs(t) }
    s
  end

  def titles(pl)
    out = Array[]
    each_from_now(pl) { |t| Array.push(out, Track.title(t)) }
    Array.join(out, " | ")
  end
end

def play_for(pl, budget)
  played = Array[]
  while budget > 0 && Playlist.now(pl)
    t = Playlist.now(pl)
    secs = Track.secs(t)
    if secs > budget
      Array.push(played, "#{Track.title(t)} (partial #{budget}s)")
      budget = 0
    else
      Array.push(played, Track.title(t))
      budget -= secs
      Playlist.skip(pl, 1)
    end
  end
  played
end

pl = Playlist.new("road trip")
Array.each(Array[
  ["Intro", "Aster", 95], ["Highway", "Bellows", 241], ["Neon Rain", "Cato", 187],
  ["Detour", "Aster", 302], ["Last Exit", "Duna", 158], ["Homecoming", "Bellows", 214]
]) { |title, artist, secs| Playlist.add(pl, title, artist, secs) }

puts("#{Playlist.name(pl)}: #{Playlist.count(pl)} tracks, #{Playlist.total_secs(pl) / 60} min")
puts("order: #{Playlist.titles(pl)}")
puts("now: #{Playlist.now(pl)}")
puts("skip 2 -> #{Playlist.skip(pl, 2)}")
puts("skip -3 -> #{Playlist.skip(pl, -3)}")
puts("skip 7 -> #{Playlist.skip(pl, 7)}")
puts("removed: #{Playlist.remove_current(pl)}; now #{Playlist.now(pl)}")
puts("order: #{Playlist.titles(pl)}")
puts("move current after Last Exit: #{Playlist.move_current_after(pl, "Last Exit")}")
puts("order: #{Playlist.titles(pl)}")
puts("move after Nowhere: #{Playlist.move_current_after(pl, "Nowhere")}")
puts("played in 10 min: #{Array.join(play_for(pl, 600), ", ")}")
by_artist = Hash.new(0)
Playlist.each_from_now(pl) { |t| by_artist[Track.artist(t)] += Track.secs(t) }
Array.each(Hash.sort_by(by_artist) { |a, s| -s }) { |a, s| puts(format("  %-8s %3ds", a, s)) }
while Playlist.count(pl) > 0
  Playlist.remove_current(pl)
end
puts("emptied: now=#{Kernel.inspect(Playlist.now(pl))} skip=#{Kernel.inspect(Playlist.skip(pl, 1))}")
