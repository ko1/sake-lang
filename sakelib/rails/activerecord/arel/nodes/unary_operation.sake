# Port of activerecord-8.1.3/lib/arel/nodes/unary_operation.rb
#
# Ruby's BitwiseNot < UnaryOperation passes :~ to super's initialize; here new takes the operand and
# initialize fills the operator.

module Arel
  module Nodes
    class UnaryOperation
      attr_accessor expr
      attr_reader operator
      include Unary
    end

    class BitwiseNot
      attr_accessor expr
      attr_reader operator
      include Unary
      def initialize(o) = @operator = :~
    end
  end
end
