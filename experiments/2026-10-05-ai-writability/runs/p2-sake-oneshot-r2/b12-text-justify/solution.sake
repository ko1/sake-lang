def break_word(word, w)
  out = String[]
  rest = word
  while String.size(rest) > w
    Array.push(out, String.slice(rest, 0, w - 1) + "-")
    rest = String.slice(rest, w - 1, String.size(rest))
  end
  Array.push(out, rest)
  out
end

def layout(words, w)
  rows = Array[]
  cur = String[]
  curlen = 0
  Array.each(words) do |wd|
    sz = String.size(wd)
    if Array.empty?(cur)
      Array.push(cur, wd)
      curlen = sz
    elsif curlen + 1 + sz <= w
      Array.push(cur, wd)
      curlen += 1 + sz
    else
      Array.push(rows, cur)
      cur = String[wd]
      curlen = sz
    end
  end
  Array.push(rows, cur)
  res = String[]
  nrows = Array.size(rows)
  Array.each_with_index(rows) do |row, i|
    s = ""
    if i == nrows - 1 || Array.size(row) == 1
      s = Array.join(row, " ")
    else
      total = w - Array.sum(row, 0) { String.size(it) }
      gaps = Array.size(row) - 1
      base = total / gaps
      extra = total % gaps
      Array.each_with_index(row) do |wd, j|
        s = s + wd
        if j < gaps
          s = s + " " * (base + (j < extra ? 1 : 0))
        end
      end
    end
    Array.push(res, String.ljust(s, w))
  end
  res
end

lines = IO.readlines(IO.stdin)
width = 0
ok = false
if !Array.empty?(lines)
  first = String.strip(lines[0])
  if String.match?(first, /\A\d+\z/)
    width = String.to_i(first)
    ok = width >= 2 && width <= 80
  end
end

if !ok
  puts("invalid width")
else
  paras = Array[]
  cur = String[]
  kwords = 0
  Array.each(Array.drop(lines, 1)) do |raw|
    ws = Array.reject(String.split(String.chomp(raw), /[ \t]+/)) { String.empty?(it) }
    if Array.empty?(ws)
      unless Array.empty?(cur)
        Array.push(paras, cur)
        cur = String[]
      end
    else
      kwords += Array.size(ws)
      Array.concat(cur, ws)
    end
  end
  Array.push(paras, cur) unless Array.empty?(cur)

  border = "+" + "-" * width + "+"
  out = String[]
  Array.push(out, border)
  nlines = 0
  Array.each_with_index(paras) do |para, pi|
    if pi > 0
      Array.push(out, "|" + " " * width + "|")
    end
    pieces = String[]
    Array.each(para) do |wd|
      Array.concat(pieces, break_word(wd, width))
    end
    ls = layout(pieces, width)
    nlines += Array.size(ls)
    Array.each(ls) { |l| Array.push(out, "|" + l + "|") }
  end
  Array.push(out, border)
  Array.push(out, "paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{kwords}")
  Array.each(out) { |l| puts(l) }
end
