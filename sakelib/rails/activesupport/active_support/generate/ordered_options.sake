# (Sake only) The generator for OrderedOptions accessors: Ruby's method_missing answers `config.name`,
# `config.name = v` and `config.name!`; the program lists the names:
#   generate "rails/activesupport/active_support/generate/ordered_options", "log_level", "time_zone"
# prints `log_level(o)`, `set_log_level(o, v)` and `log_level!(o)` for each.

puts "class ActiveSupport::OrderedOptions"
Array.each(ARGV) do |name|
  raise ArgumentError, "not a method name: #{name}" unless String.match?(name, /\A[a-z_][a-z0-9_]*\z/)
  puts "  def #{name}(o) = option(o, :#{name})"
  puts "  def set_#{name}(o, v) = option(o, :#{name}=, v)"
  puts "  def #{name}!(o) = option(o, :#{name}!)"
end
puts "end"
