== delimit
             0 -> 0 | 0
           999 -> 999 | 999
          1000 -> 1,000 | 1 000
       1234567 -> 1,234,567 | 1 234 567
   -9876543210 -> -9,876,543,210 | -9 876 543 210
== currency
           0.0 -> $0.00
           5.5 -> $5.50
      1234.567 -> $1,234.57
         -42.0 -> ($42.00)
   1000000.004 -> $1,000,000.00
== percent
  1/3 -> 33.3%
  2/1000 -> <1%
  0/7 -> 0.0%
  7/7 -> 100.0%
  5/0 -> n/a
== bytes
               512 -> 512 B      512 B
              1024 -> 1.02 kB    1.00 KiB
              1536 -> 1.54 kB    1.50 KiB
           1000000 -> 1.00 MB    977 KiB
         123456789 -> 123 MB     118 MiB
  5000000000000000 -> 5000 TB    4547 TiB
== duration
         0s -> 0s
        59s -> 59s
        61s -> 1m 01s
      3600s -> 1h 00m
      3725s -> 1h 02m
     86399s -> 23h 59m
     90061s -> 1d 01h
   1000000s -> 11d 13h
== relative
        10 -> a few seconds ago
        75 -> a minute ago
       600 -> 10 minutes ago
      4000 -> an hour ago
     30000 -> 8 hours ago
    100000 -> a day ago
    400000 -> 5 days ago
   5000000 -> 2 months ago
      -120 -> in 2 minutes
   -200000 -> in 2 days
== significant figures
  3.14159 -> 3.14
  0.000123456 -> 0.000123
  98765.4 -> 98,800
  12.0 -> 12.0
