# `P => name` binds what P matched, narrowed as P (Ruby's pattern capture).
def describe(x)
  case x
  in [Integer => code, String => body] then "#{code + 1} #{String.upcase(body)}"
  in String => s then String.reverse(s)
  in Integer | Float => n then "number #{n * 2}"
  else "other"
  end
end
p describe([404, "not found"])
p describe("abc")
p describe(2.5)
p describe(nil)
v = Kernel.Integer("41")
v => Integer => m
p m + 1
p (["x", 1] in [String => a, Integer])
p a
