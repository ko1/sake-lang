Opened = Struct.new(:seq, :account, :owner)
Deposited = Struct.new(:seq, :account, :amount)
Withdrawn = Struct.new(:seq, :account, :amount)
Transferred = Struct.new(:seq, :from, :to, :amount)
Closed = Struct.new(:seq, :account)
Account = Struct.new(:id, :owner, :balance, :status)
Rejected = Exception.new(:seq)

module Event
  def seq(ev) = get_seq(ev)
end

class Opened
  include Event
end

class Deposited
  include Event
end

class Withdrawn
  include Event
end

class Transferred
  include Event
end

class Closed
  include Event
end

class Account
  def to_s(a) = format("%-3s %-5s %7d %s", @id, @owner, @balance, @status)
  def copy(a) = Account.new(@id, @owner, @balance, @status)
end

def open_account(state, id, seq)
  acct = state[id]
  raise Rejected.new("unknown account #{id}", seq) if acct == nil
  raise Rejected.new("account #{id} is closed", seq) if Account.get_status(acct) == :closed
  acct
end

def apply(state, ev)
  seq = Event.seq(ev)
  case ev
  in Opened
    id = Opened.get_account(ev)
    raise Rejected.new("duplicate account #{id}", seq) if Hash.key?(state, id)
    state[id] = Account.new(id, Opened.get_owner(ev), 0, :open)
  in Deposited
    acct = open_account(state, Deposited.get_account(ev), seq)
    Account.set_balance(acct, Account.get_balance(acct) + Deposited.get_amount(ev))
  in Withdrawn
    acct = open_account(state, Withdrawn.get_account(ev), seq)
    amount = Withdrawn.get_amount(ev)
    raise Rejected.new("insufficient funds in #{Account.get_id(acct)}", seq) if Account.get_balance(acct) < amount
    Account.set_balance(acct, Account.get_balance(acct) - amount)
  in Transferred
    src = open_account(state, Transferred.get_from(ev), seq)
    dst = open_account(state, Transferred.get_to(ev), seq)
    amount = Transferred.get_amount(ev)
    raise Rejected.new("insufficient funds in #{Account.get_id(src)}", seq) if Account.get_balance(src) < amount
    Account.set_balance(src, Account.get_balance(src) - amount)
    Account.set_balance(dst, Account.get_balance(dst) + amount)
  in Closed
    acct = open_account(state, Closed.get_account(ev), seq)
    raise Rejected.new("balance not zero in #{Account.get_id(acct)}", seq) if Account.get_balance(acct) != 0
    Account.set_status(acct, :closed)
  end
end

def snapshot(state)
  copy = Hash[]
  Hash.each(state) { |id, acct| copy[id] = Account.copy(acct) }
  copy
end

def replay(events, start_state, after_seq, rejected)
  state = snapshot(start_state)
  Array.each(events) do |ev|
    next if Event.seq(ev) <= after_seq
    begin
      apply(state, ev)
    rescue Rejected => e
      Array.push(rejected, "##{Rejected.get_seq(e)} #{Exception.message(e)}") if rejected
    end
  end
  state
end

def same_state?(a, b)
  return false if Hash.size(a) != Hash.size(b)
  Hash.all?(a) { |id, acct| b[id] != nil && Kernel.to_s(acct) == Kernel.to_s(b[id]) }
end

log = Array[
  Opened.new(1, "A1", "ann"), Opened.new(2, "B2", "bob"), Deposited.new(3, "A1", 500),
  Withdrawn.new(4, "B2", 50), Deposited.new(5, "B2", 120), Transferred.new(6, "A1", "B2", 200),
  Opened.new(7, "C3", "cy"), Transferred.new(8, "B2", "C3", 320), Closed.new(9, "B2"),
  Deposited.new(10, "B2", 10), Opened.new(11, "A1", "amy"), Withdrawn.new(12, "C3", 20),
  Closed.new(13, "A1"), Transferred.new(14, "C3", "X9", 1)
]

rejected = Array[]
full = replay(log, Hash[], 0, rejected)
puts("final state:")
Hash.each(full) { |id, acct| puts("  #{acct}") }
puts("rejected events:")
Array.each(rejected) { puts("  #{it}") }

snapshots = Hash[0 => Hash[]]
state = Hash[]
Array.each(log) do |ev|
  apply(state, ev) rescue nil
  snapshots[Event.seq(ev)] = snapshot(state) if Event.seq(ev) % 5 == 0
end
Hash.each(snapshots) do |at, snap|
  rebuilt = replay(log, snap, at, nil)
  total = Hash.sum(rebuilt) { |id, acct| Account.get_balance(acct) }
  puts(format("from snapshot @%-2d (%d accounts): total=%d consistent=%s", at, Hash.size(snap), total, same_state?(rebuilt, full)))
end
