require "rails/actionpack/action_controller/generate/controller"

# The source the controllers' generator writes for controller_base and for controller_view (with its view class:
# view_context, the layouts, helper_method) (no .rb twin: Ruby finds these by reflection), and its errors for
# class-body lines it has no Sake form for.
print(ActionController::Generate.source(String["controller_base_decl.rb", "controller_base.sake"]))
puts("# ---- controller_view")
print(ActionController::Generate.source(String["controller_view_decl.rb", "controller_view.sake", "view=AppView"]))

File.write("controller_generate_bad1.rb", "class PostsController < ApplicationController\n  before_action { redirect_to root_path }\nend\n")
File.write("controller_generate_bad2.rb", "class PostsController < ApplicationController\n  layout -> { \"admin\" }\nend\n")
File.write("controller_generate_bad3.rb", "class PostsController < ApplicationController\n  before_action :x, on: :show\nend\n")
Array.each(String["controller_generate_bad1.rb", "controller_generate_bad2.rb", "controller_generate_bad3.rb"]) do |path|
  begin
    ActionController::Generate.source(String[path, "controller_base.sake"])
  rescue ArgumentError => e
    puts(Exception.message(e))
  ensure
    File.delete(path)
  end
end
