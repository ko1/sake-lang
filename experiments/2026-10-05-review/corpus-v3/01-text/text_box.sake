class BoxOptions
  attr_reader style, padding, align, title, shadow, max_width
end

def border(style)
  case style
  in :ascii then {h: "-", v: "|", tl: "+", tr: "+", bl: "+", br: "+"}
  in :double then {h: "=", v: "#", tl: "#", tr: "#", bl: "#", br: "#"}
  in :rounded then {h: "-", v: "|", tl: ".", tr: ".", bl: "'", br: "'"}
  in :stars then {h: "*", v: "*", tl: "*", tr: "*", bl: "*", br: "*"}
  end
end

def wrap(text, width)
  lines = Array[]
  Array.each(String.split(text, "\n")) do |para|
    line = ""
    Array.each(String.split(para, " ")) do |w|
      if String.empty?(line)
        line = w
      elsif String.size(line) + 1 + String.size(w) <= width
        line += " " + w
      else
        Array.push(lines, line)
        line = w
      end
    end
    Array.push(lines, line)
  end
  lines
end

def place(s, width, align)
  case align
  in :left then String.ljust(s, width)
  in :right then String.rjust(s, width)
  in :center then String.center(s, width)
  end
end

def box(text, opts)
  border(BoxOptions.get_style(opts)) => {h:, v:, tl:, tr:, bl:, br:}
  pad = BoxOptions.get_padding(opts)
  lines = wrap(text, BoxOptions.get_max_width(opts))
  title = BoxOptions.get_title(opts)
  inner = Array.max(Array.map(lines) { |l| String.size(l) })
  inner = String.size(title) + 2 if title != nil && String.size(title) + 2 > inner
  full = inner + pad * 2
  top = if title == nil
    tl + h * full + tr
  else
    label = " #{title} "
    left = (full - String.size(label)) / 2
    tl + h * left + label + h * (full - left - String.size(label)) + tr
  end
  out = Array[top]
  blank = v + " " * full + v
  Integer.times(pad / 2) { Array.push(out, blank) }
  Array.each(lines) do |l|
    Array.push(out, v + " " * pad + place(l, inner, BoxOptions.get_align(opts)) + " " * pad + v)
  end
  Integer.times(pad / 2) { Array.push(out, blank) }
  Array.push(out, bl + h * full + br)
  if BoxOptions.get_shadow(opts)
    shadowed = Array[]
    Array.each_with_index(out) { |l, i| Array.push(shadowed, i == 0 ? l + " " : l + ":") }
    Array.push(shadowed, " " + ":" * (full + 2))
    out = shadowed
  end
  out
end

def side_by_side(left, right, gap)
  width = Array.max(Array.map(left) { |l| String.size(l) })
  rows = Array.max(Array[Array.size(left), Array.size(right)])
  Range.map(0...rows) do |i|
    l = left[i]
    r = right[i]
    String.rstrip(String.ljust(l == nil ? "" : l, width) + " " * gap + (r == nil ? "" : r))
  end
end

message = "Sake writes the type on every operation. The program says which code runs, and the checker can see it."
puts(Array.join(box(message, BoxOptions.new(:ascii, 1, :left, nil, false, 30)), "\n"))
puts(Array.join(box(message, BoxOptions.new(:double, 2, :center, "NOTICE", true, 24)), "\n"))
a = box("left\nside", BoxOptions.new(:rounded, 1, :right, nil, false, 20))
b = box("A longer note that wraps over lines.", BoxOptions.new(:stars, 2, :left, "tip", false, 14))
Array.each(side_by_side(a, b, 3)) { |l| puts(l) }
puts(Array.join(box("x", BoxOptions.new(:ascii, 0, :left, "a very long title", false, 10)), "\n"))
