# Port of activesupport-8.1.3/lib/active_support/core_ext/numeric/bytes.rb

# numeric/time.sake (next to this file) has the `include Numeric` in Integer and Float.
require "time"

module Numeric
  def bytes(n) = n
  def byte(n) = n
  def kilobytes(n) = n * 1024
  def kilobyte(n) = n * 1024
  def megabytes(n) = n * 1024 ** 2
  def megabyte(n) = n * 1024 ** 2
  def gigabytes(n) = n * 1024 ** 3
  def gigabyte(n) = n * 1024 ** 3
  def terabytes(n) = n * 1024 ** 4
  def terabyte(n) = n * 1024 ** 4
  def petabytes(n) = n * 1024 ** 5
  def petabyte(n) = n * 1024 ** 5
  def exabytes(n) = n * 1024 ** 6
  def exabyte(n) = n * 1024 ** 6
  def zettabytes(n) = n * 1024 ** 7
  def zettabyte(n) = n * 1024 ** 7
end
