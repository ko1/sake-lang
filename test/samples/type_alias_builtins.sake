# sake: --strict
# An alias of a built-in type is that type everywhere: the Hash[...] constructor, the constants
# Math::PI and Float::INFINITY, and `raise NotImplementedError` marking a required function.
H = Hash
M = Math
F = Float
module Shapes
  N = NotImplementedError
  module Area
    module_function
    def area(s) = raise N
  end
end
class Sq
  include Shapes::Area
  attr_reader n
  def area(s) = s.Sq.n * s.Sq.n
end
p H["a" => 1]
p H[a: 1]
p M::PI
p F::INFINITY
p Shapes::Area.area(Sq.new(3))
