# Unusual inputs: CRLF, empty fields, quoted newlines, a missing final newline; then a round trip.

def show(label, text)
  rows = Csv.parse(text)
  puts("#{label}: #{inspect(rows)}")
  back = Csv.generate(rows)
  same = Csv.parse(back) == rows
  puts("  round trip #{same ? "ok" : "CHANGED: #{inspect(back)}"}")
end

show("plain", "a,b,c\n1,2,3\n")
show("crlf", "a,b\r\n1,2\r\n")
show("empty fields", ",,\na,,b\n")
show("blank line", "a\n\nb\n")
show("no final newline", "x,y\n1,2")
show("quoted newline", "id,note\n1,\"line one\nline two\"\n2,plain\n")
show("escaped quotes", "\"he said \"\"hi\"\"\",\"\"\n")
show("quoted crlf", "\"a\r\nb\",c\r\n")

Array.each(Array["\"open", "ab\"c\",d", "\"x\"y,z"]) do |bad|
  begin
    Csv.parse(bad)
    puts("#{inspect(bad)}: accepted?")
  rescue CsvError => e
    puts("#{inspect(bad)}: #{Exception.message(e)} at line #{CsvError.line(e)}")
  end
end

# A table whose cells mix all four kinds, rendered and written back.
t = Table.new(Array["k", "v"], Array[Array["int", 1234567], Array["float", -0.5], Array["text", "hi"], Array["nil", nil]])
puts(Table.render(t, 3))
print(Table.to_csv(Table.sort_by_column(t, "v")))
