def digits?(tok) = String.match?(tok, /\A[0-9]+\z/)

def parse_ints(line)
  toks = String.split(line)
  ok = Array.all?(toks) { |tk| digits?(tk) }
  return nil unless ok
  Array.map(toks) { |tk| String.to_i(tk) }
end

def header_ok(h)
  return false if h == nil
  return false if Array.size(h) != 3
  n, d, c = h
  n >= 2 && n <= 50 && d >= 0 && d <= 5 && c >= 1 && c <= 20
end

def run(n, d, c, lines)
  ts = Integer[]
  fs = Integer[]
  gs = Integer[]
  prev = 0
  i = 1
  while i < Array.size(lines)
    line = lines[i]
    kno = i + 1
    i += 1
    next if String.strip(line) == ""
    v = parse_ints(line)
    ok = false
    if v != nil && Array.size(v) == 3
      rt, rf, rg = v
      ok = rf >= 1 && rf <= n && rg >= 1 && rg <= n && rf != rg && rt <= 1000 && rt >= prev
      if ok
        Array.push(ts, rt)
        Array.push(fs, rf)
        Array.push(gs, rg)
        prev = rt
      end
    end
    puts("line #{kno}: invalid request") unless ok
  end

  np = Array.size(ts)
  if np == 0
    puts("no passengers")
    return nil
  end

  state = Array.new(np, 0)
  pick = Array.new(np, 0)
  drop = Array.new(np, 0)
  t = 0
  f = 1
  dir = 0
  done = 0
  riders = 0
  last = 0
  while done < np
    j = 0
    while j < np
      state[j] = 1 if state[j] == 0 && ts[j] <= t
      j += 1
    end

    acted = false
    j = 0
    while j < np
      if state[j] == 2 && gs[j] == f
        state[j] = 3
        drop[j] = t
        done += 1
        riders -= 1
        last = t
        puts("t=#{t} floor #{f} drop P#{j + 1}")
        acted = true
      end
      j += 1
    end

    above = false
    below = false
    here = false
    best = 0
    bd = 1000
    j = 0
    while j < np
      tg = -1
      tg = gs[j] if state[j] == 2
      tg = fs[j] if state[j] == 1
      if tg > 0
        above = true if tg > f
        below = true if tg < f
        here = true if tg == f
        dist = Integer.abs(tg - f)
        if dist < bd || (dist == bd && tg < best)
          bd = dist
          best = tg
        end
      end
      j += 1
    end

    if dir == 1
      dir = above ? 1 : (below ? -1 : 0)
    elsif dir == -1
      dir = below ? -1 : (above ? 1 : 0)
    end
    if dir == 0 && (above || below || here)
      if best == f
        j = 0
        while j < np
          if state[j] == 1 && fs[j] == f
            dir = gs[j] > f ? 1 : -1
            break
          end
          j += 1
        end
      else
        dir = best > f ? 1 : -1
      end
    end

    j = 0
    while j < np
      if state[j] == 1 && fs[j] == f && riders < c
        pd = gs[j] > f ? 1 : -1
        if pd == dir
          state[j] = 2
          pick[j] = t
          riders += 1
          acted = true
          puts("t=#{t} floor #{f} pick P#{j + 1}")
        end
      end
      j += 1
    end

    if acted
      t += d
    else
      f += dir
      t += 1
    end
  end

  sw = 0
  sr = 0
  j = 0
  while j < np
    w = pick[j] - ts[j]
    r = drop[j] - pick[j]
    puts("P#{j + 1} wait #{w} ride #{r}")
    sw += w
    sr += r
    j += 1
  end
  puts(format("average wait %.2f ride %.2f", Integer.fdiv(sw, np), Integer.fdiv(sr, np)))
  puts("done at t=#{last}")
  nil
end

lines = Array.map(String.split(IO.read(IO.stdin), "\n")) { |l| String.chomp(l) }
hdr = nil
hdr = parse_ints(lines[0]) if Array.size(lines) > 0
if header_ok(hdr)
  hn, hd, hc = hdr
  run(hn, hd, hc, lines)
else
  puts("invalid header")
end
