module Sql
  class View
    attr_reader name: String
    attr_reader column_names: Array[String]?
    attr_reader query: Ast::Query

    def initialize: (String name, Array[String]? column_names, Ast::Query query) -> void
  end

  class Index
    attr_reader name: String
    attr_reader table_name: String
    attr_reader unique: bool

    def initialize: (String name, String table_name, bool unique) -> void
    def moved_to: (String new_table_name) -> Index
  end

  class Catalog
    @tables: Hash[String, Table]
    @views: Hash[String, View]
    @indexes: Hash[String, Index]

    def initialize: (?Hash[String, Table] tables, ?Hash[String, View] views, ?Hash[String, Index] indexes) -> void
    def copy: () -> Catalog
    def find: (String name) -> Table?
    def fetch: (String name) -> Table
    def view: (String name) -> View?
    def index: (String name) -> Index?
    def relation_kind: (String name) -> (:table | :view)?
    def taken?: (String name) -> bool
    def add: (Table table) -> void
    def remove: (String name) -> void
    def add_view: (View view) -> void
    def remove_view: (String name) -> void
    def add_index: (Index index) -> void
    def remove_index: (String name) -> void
    def rename_table: (Table table, String new_name) -> void
  end
end
