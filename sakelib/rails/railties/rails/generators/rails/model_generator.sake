# Port of railties-8.1.3/lib/rails/generators/rails/model/model_generator.rb, rails/resource/resource_generator.rb and rails/scaffold/scaffold_generator.rb (three small files: each is its parent plus hooks; partial: no --api, no test_framework hooks)
#
# Ruby: ModelGenerator hook_for :orm; ResourceGenerator < ModelGenerator adds hook_for :resource_controller and
# :resource_route; ScaffoldGenerator < ResourceGenerator swaps the controller for :scaffold_controller. Here each is
# the hooks it runs, in Ruby's order.

require "rails/activerecord/rails/generators/active_record/model_generator"
require "controller_generator"
require "scaffold_controller_generator"
require "resource_route_generator"

module Rails
  module Generators
    module ModelGenerator
      module_function

      def run(g, name, args, migration: true) = ActiveRecord::Generators::ModelGenerator.run(g, name, args, migration: migration)
    end

    module ResourceGenerator
      module_function

      def run(g, name, args, migration: true)
        ActiveRecord::Generators::ModelGenerator.run(g, name, args, migration: migration)
        Base.invoke(g, "controller") { ControllerGenerator.run(g, ActiveSupport::Inflector.pluralize(name), String[]) }
        Base.invoke(g, "resource_route") { ResourceRouteGenerator.run(g, name) }
        nil
      end
    end

    module ScaffoldGenerator
      module_function

      def run(g, name, args, migration: true)
        ActiveRecord::Generators::ModelGenerator.run(g, name, args, migration: migration)
        Base.invoke(g, "resource_route") { ResourceRouteGenerator.run(g, name) }
        n = Name.make(name, args)
        Base.invoke(g, "scaffold_controller") { ScaffoldControllerGenerator.run(g, n) }
        nil
      end
    end
  end
end
