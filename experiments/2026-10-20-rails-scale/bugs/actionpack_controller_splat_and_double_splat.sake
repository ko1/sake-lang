# Passing a function's own *rest and **opts on in one call: the checker accepts it, the interpreter crashes with
# "BUG: unknown node Sake::AST::Splat" (lib/sake/interpreter.rb:228). Either alone works.
# Ruby prints [[:a], {b: 1}]. Found by StrongParameters' expect! (Rails: `expect(*filters)` from `expect!(*filters)`).
def g(*xs, **kw) = p([xs, kw])
def f(*xs, **kw) = g(*xs, **kw)
f(:a, b: 1)
