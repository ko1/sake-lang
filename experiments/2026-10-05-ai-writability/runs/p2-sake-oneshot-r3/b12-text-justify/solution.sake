def justify(ws, width)
  return ws[0] if Array.size(ws) == 1
  chars = 0
  Array.each(ws) { |wd| chars += String.size(wd) }
  gaps = Array.size(ws) - 1
  spaces = width - chars
  base = spaces / gaps
  extra = spaces % gaps
  out = ""
  Array.each_with_index(ws) do |wd, i|
    out = out + wd
    if i < gaps
      pad = base + (i < extra ? 1 : 0)
      out = out + " " * pad
    end
  end
  out
end

def layout(words, width)
  pieces = Array[]
  Array.each(words) do |wd|
    rest = wd
    while String.size(rest) > width
      Array.push(pieces, rest[0, width - 1] + "-")
      rest = rest[width - 1, String.size(rest)]
    end
    Array.push(pieces, rest)
  end
  result = Array[]
  cur = Array[]
  curlen = 0
  Array.each(pieces) do |pc|
    sz = String.size(pc)
    need = Array.empty?(cur) ? sz : curlen + 1 + sz
    if !Array.empty?(cur) && need > width
      Array.push(result, cur)
      cur = Array[pc]
      curlen = sz
    else
      Array.push(cur, pc)
      curlen = need
    end
  end
  Array.push(result, cur) unless Array.empty?(cur)
  out = Array[]
  last = Array.size(result) - 1
  Array.each_with_index(result) do |ws, i|
    text = i < last ? justify(ws, width) : Array.join(ws, " ")
    Array.push(out, String.ljust(text, width))
  end
  out
end

lines = IO.readlines(IO.stdin)
if Array.empty?(lines)
  puts("invalid width")
  exit(0)
end
wl = String.strip(String.chomp(lines[0]))
if !String.match?(wl, /\A\d+\z/) || String.to_i(wl) < 2 || String.to_i(wl) > 80
  puts("invalid width")
  exit(0)
end
width = String.to_i(wl)

paras = Array[]
curp = Array[]
Array.each(Array.drop(lines, 1)) do |ln|
  ws = Array.reject(String.split(String.chomp(ln), /[ \t]+/)) { |x| String.empty?(x) }
  if Array.empty?(ws)
    unless Array.empty?(curp)
      Array.push(paras, curp)
      curp = Array[]
    end
  else
    Array.concat(curp, ws)
  end
end
Array.push(paras, curp) unless Array.empty?(curp)

nwords = 0
Array.each(paras) { |pw| nwords += Array.size(pw) }

border = "+" + "-" * width + "+"
puts(border)
nlines = 0
Array.each_with_index(paras) do |pw, i|
  puts("|" + " " * width + "|") if i > 0
  ls = layout(pw, width)
  Array.each(ls) { |l| puts("|" + l + "|") }
  nlines += Array.size(ls)
end
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{nwords}")
