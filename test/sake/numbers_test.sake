require "minitest"

# Integer, Float, Rational, Complex and Math: the arithmetic a program relies on, checked against Ruby.
suite = Minitest.suite("numbers")

Minitest.test(suite, "Integer: arithmetic, division, powers") do |t|
  Minitest.assert_equal(t, 7, 3 + 4)
  Minitest.assert_equal(t, 3, 7 / 2)
  Minitest.assert_equal(t, -4, -7 / 2)
  Minitest.assert_equal(t, 1, 7 % 2)
  Minitest.assert_equal(t, -1, 7 % -2)
  Minitest.assert_equal(t, 8, 2 ** 3)
  Minitest.assert_equal(t, 1_000_000_000_000_000_000_000_000, 10 ** 24)
  Minitest.assert_equal(t, [3, 1], Integer.divmod(7, 2))
  Minitest.assert_equal(t, 3.5, Integer.fdiv(7, 2))
  Minitest.assert_equal(t, 6, Integer.gcd(12, 18))
  Minitest.assert_equal(t, 36, Integer.lcm(12, 18))
  Minitest.assert_equal(t, 2, Integer.pow(2, 10, 7))
  Minitest.assert_equal(t, Array[3, 2, 1], Integer.digits(123))
  Minitest.assert_equal(t, 5, Integer.clamp(9, 1, 5))
  Minitest.assert(t, Integer.between?(3, 1, 5))
  Minitest.assert_equal(t, 3, Integer.sqrt(10))
  Minitest.assert_equal(t, 8, Integer.bit_length(255))
  Minitest.assert_equal(t, 5, Integer.abs(-5))
  Minitest.assert(t, Integer.even?(4))
  Minitest.assert_equal(t, "ff", Integer.to_s(255, 16))
  Minitest.assert_match(t, /divided by 0/, Minitest.assert_raises(t) { 1 / 0 })
  Minitest.assert_match(t, /negative Integer/, Minitest.assert_raises(t) { 2 ** -1 })
end

Minitest.test(suite, "Integer: bits and iteration") do |t|
  Minitest.assert_equal(t, 4, 0b1100 & 0b0110)
  Minitest.assert_equal(t, 14, 0b1100 | 0b0110)
  Minitest.assert_equal(t, 10, 0b1100 ^ 0b0110)
  Minitest.assert_equal(t, 16, 1 << 4)
  Minitest.assert_equal(t, 2, 16 >> 3)
  Minitest.assert_equal(t, -1, ~0)
  acc = Array[]
  Integer.times(3) { |i| Array.push(acc, i) }
  Integer.upto(1, 2) { |i| Array.push(acc, i) }
  Integer.downto(2, 1) { |i| Array.push(acc, i) }
  Integer.step(0, 10, 5) { |i| Array.push(acc, i) }
  Minitest.assert_equal(t, Array[0, 1, 2, 1, 2, 2, 1, 0, 5, 10], acc)
end

Minitest.test(suite, "Float: rounding, special values, mixing with Integer") do |t|
  Minitest.assert_equal(t, 3.5, 7 / 2.0)
  Minitest.assert_equal(t, 3, Float.round(3.4))
  Minitest.assert_equal(t, 3.14, Float.round(3.14159, 2))
  Minitest.assert_equal(t, 4, Float.ceil(3.1))
  Minitest.assert_equal(t, 3, Float.floor(3.9))
  Minitest.assert_equal(t, -3, Float.truncate(-3.9))
  Minitest.assert_equal(t, 3, Float.to_i(3.9))
  Minitest.assert(t, Float.nan?(0.0 / 0.0))
  Minitest.assert(t, Float.infinite?(1.0 / 0.0) == 1)
  Minitest.assert(t, Float.finite?(1.5))
  Minitest.assert_equal(t, 1.0 / 0.0, Float.INFINITY)
  Minitest.assert_in_delta(t, 0.3, 0.1 + 0.2, 1e-9)
  Minitest.refute(t, 0.1 + 0.2 == 0.3)
  Minitest.assert_equal(t, 2.5, Float.abs(-2.5))
  Minitest.assert_equal(t, [2, 0.5], Float.divmod(2.5, 1.0))
  Minitest.assert_equal(t, 1.5, Arithmetic.round(1.5, 1))
  Minitest.assert_equal(t, 2, Arithmetic.round(1.5))
  Minitest.assert_match(t, /NaN|Infinity/, Minitest.assert_raises(t) { Float.to_i(Float.NAN) })
end

Minitest.test(suite, "Rational and Complex") do |t|
  Minitest.assert_equal(t, 3r / 2, 1r / 2 + 1)
  Minitest.assert_equal(t, 1r / 3, Kernel.Rational(1, 3))
  Minitest.assert_equal(t, 1r / 3, Kernel.Rational("1/3"))
  Minitest.assert_equal(t, 2, Rational.numerator(2r / 3))
  Minitest.assert_equal(t, 0.5, Rational.to_f(1r / 2))
  Minitest.assert_equal(t, 1r / 2, Integer.to_r(1) / 2)
  Minitest.assert_equal(t, 1r / 2, 2r ** -1)
  Minitest.assert_equal(t, "3/2", Rational.to_s(3r / 2))
  Minitest.assert_equal(t, 1r / 4, Float.to_r(0.25))
  c = Kernel.Complex(1, 2) * Kernel.Complex(3, 4)
  Minitest.assert_equal(t, Kernel.Complex(-5, 10), c)
  Minitest.assert_equal(t, -5, Complex.real(c))
  Minitest.assert_equal(t, 10, Complex.imaginary(c))
  Minitest.assert_equal(t, "-5+10i", Complex.to_s(c))
  Minitest.assert_in_delta(t, 11.18, Complex.abs(c), 0.01)
  Minitest.assert_match(t, /divided by 0/, Minitest.assert_raises(t) { Kernel.Rational(1, 0) })
end

Minitest.test(suite, "Math and conversions") do |t|
  Minitest.assert_equal(t, 3.0, Math.sqrt(9))
  Minitest.assert_equal(t, 2.0, Math.cbrt(8))
  Minitest.assert_in_delta(t, 1.0, Math.sin(Math.PI / 2))
  Minitest.assert_in_delta(t, 2.0, Math.log2(4))
  Minitest.assert_in_delta(t, 2.0, Math.log10(100))
  Minitest.assert_in_delta(t, 1.0, Math.log(Math.E))
  Minitest.assert_in_delta(t, 5.0, Math.hypot(3, 4))
  Minitest.assert_in_delta(t, Math.PI / 4, Math.atan2(1, 1))
  Minitest.assert_equal(t, 42, Kernel.Integer("42"))
  Minitest.assert_equal(t, 255, Kernel.Integer("0xff"))
  Minitest.assert_equal(t, 1.5, Kernel.Float("1.5"))
  Minitest.assert_equal(t, 3, Kernel.Integer(3.7))
  Minitest.assert_equal(t, "3", Integer.to_s(3))
  Minitest.assert_equal(t, "1.5", Float.to_s(1.5))
  Minitest.assert_equal(t, 1.0, Integer.to_f(1))
  Minitest.assert_match(t, /Numerical argument is out of domain/, Minitest.assert_raises(t) { Math.sqrt(-1) })
end

Minitest.test(suite, "comparison across number types") do |t|
  Minitest.assert(t, 1 == 1.0)
  Minitest.assert(t, 1 < 1.5)
  Minitest.assert(t, 1r / 2 == 0.5)
  Minitest.assert_equal(t, -1, 1 <=> 2)
  Minitest.assert_equal(t, 0, 2.0 <=> 2)
  Minitest.assert_equal(t, 1, 3 <=> 2.5)
  Minitest.assert_equal(t, Array[1, 1.5, 2r], Array.sort(Array[2r, 1.5, 1]))
  Minitest.assert_equal(t, 2r, Array.max(Array[1, 1.5, 2r]))
  Minitest.refute(t, 1 == "1")
end

Minitest.run(suite)
