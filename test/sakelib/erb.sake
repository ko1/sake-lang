require "erb"

page = <<~T
  <h1><%= h(title) %></h1>
  <%# a comment %>
  <p>Hello, <%= h(user[:name]) %>!<% if user[:admin] %> (admin)<% end %></p>
  <% unless items.empty? %>
  <ul>
  <% items.each do |item| %>
    <li><%= h(item[:name]) %>: <%= item[:price] %> yen<% if item[:tags].any? %> [<%= item[:tags].join(", ") %>]<% end %></li>
  <% end %>
  </ul>
  <% else %>
  <p>no items</p>
  <% end %>
  <p><%= items.size %> items<% if items.any? %>, first: <%= items.first[:name] %><% end %></p>
  <%% literal %> and <%= "str" %> <%= 'single' %> <%= 42 %> <%= nil %>|<%= ratio %> <%= list %>
  <a href="/search?q=<%= u(query) %>">search</a>
T

data = Hash.of(
  title: "Tom & Jerry's <Shop>",
  user: Hash.of(name: "<script>alert(1)</script>", admin: true),
  items: Any[
    Hash.of(name: "Apple", price: 120, tags: Any["fruit", "red"]),
    Hash.of(name: "Bread \"fresh\"", price: 250, tags: Any[]),
    Hash.of(name: "日本酒", price: 1800, tags: Any["drink"])
  ],
  query: "sake & rice/日本",
  ratio: 0.5,
  list: Any[1, "two", :three, nil]
)
puts(ERB.result_with_hash(ERB.new(page), data))

puts("-- empty list")
puts(ERB.result_with_hash(ERB.new(page), Hash.of(title: "", user: Hash.of(name: "x", admin: false),
  items: Any[], query: "", ratio: 1, list: Any[])))

puts("-- each_with_index, Hash each, elsif, nesting, operators")
t = <<~T
  <% rows.each_with_index do |row, i| %><%= i %>:<% row.each do |cell| %> <%= cell %><% end %>
  <% end %><% scores.each do |name, score| %><%= name %>=<% if score >= 90 %>A<% elsif score >= 70 %>B<% elsif score >= 50 %>C<% else %>F<% end %> <% end %>
  <% if !hidden && word != "" %>shown<% end %> <% pairs.each do |a, b| %>(<%= a %>,<%= b %>)<% end %> <%= nested[:a]["b"][-1] %>
  <%= word.upcase %> <%= word.size %> <%= word[0] %> <%= hidden || "fallback" %> <%= word == "sake" %> <%= 1 < 2 %>
T
puts(ERB.result_with_hash(ERB.new(t), Hash.of(
  rows: Any[Any[1, 2], Any["a"], Any[]],
  scores: Hash.of("ann" => 95, "bob" => 70, "cy" => 55, "dee" => 10),
  hidden: false, word: "sake",
  pairs: Any[[1, "one"], [2, "two"]],
  nested: Hash.of(a: Hash.of("b" => Any[10, 20, 30]))
)))

puts("-- trim_mode -")
t = <<~T
  <ul>
    <%- items.each do |x| -%>
    <li><%= x %></li>
    <%- end -%>
  </ul>
  a <%- if true -%> b <%- end -%>
  <%# comment -%>
  end
T
p(ERB.result_with_hash(ERB.new(t, trim_mode: "-"), Hash.of(items: Any["a", "b"])))

puts("-- trim_mode >")
t = <<~T
  <% items.each do |x| %>
  <%= x %>
  <% end %>
  tail
T
p(ERB.result_with_hash(ERB.new(t, trim_mode: ">"), Hash.of(items: Any["a", "b"])))

puts("-- trim_mode <>")
p(ERB.result_with_hash(ERB.new(t, trim_mode: "<>"), Hash.of(items: Any["a", "b"])))
p(ERB.result_with_hash(ERB.new("x <%= 1 %>\n<%= 2 %>\ny\n", trim_mode: "<>"), Hash.new))

puts("-- no trim_mode")
p(ERB.result_with_hash(ERB.new(t), Hash.of(items: Any["a", "b"])))
p(ERB.result_with_hash(ERB.new(""), Hash.new))
p(ERB.result_with_hash(ERB.new("no tags, %> and %%> stay"), Hash.new))
p(ERB.result_with_hash(ERB.new("<%= '%%>' %>"), Hash.new))

puts("-- ERB::Util")
p(ERB::Util.h("<a href='x'>&\"</a>"))
p(ERB::Util.html_escape(1))
p(ERB::Util.url_encode("a b&c/~é"))
p(ERB::Util.u(""))

puts("-- errors")
begin
  ERB.result_with_hash(ERB.new("<%= missing %>"), Hash.new)
rescue ERB::Error
  puts("error: undefined name")
end
begin
  ERB.result_with_hash(ERB.new("<% if x %>open"), Hash.of(x: true))
rescue ERB::Error
  puts("error: missing end")
end
