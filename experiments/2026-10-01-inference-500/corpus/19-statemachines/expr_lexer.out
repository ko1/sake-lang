"x1 = 3.25 * (rate + 12)" => ident(x1) op(=) float(3.25) op(*) lparen(() ident(rate) op(+) int(12) rparen()) eof()
"a<=b and c!=d" => ident(a) op(<=) ident(b) keyword(and) ident(c) op(!=) ident(d) eof()
"2**10 % 7" => int(2) op(**) int(10) op(%) int(7) eof()
"count_2 >= .5" => ident(count_2) op(>=) float(.5) eof()
"1.2.3" => error at 3: malformed number
  1.2.3
     ^
"total = 4x" => error at 9: letter in number
  total = 4x
           ^
"price # comment" => error at 6: unexpected "#"
  price # comment
        ^
"  ( ( y ) )  " => lparen(() lparen(() ident(y) rparen()) rparen()) eof()
token kinds:
  eof       5
  float     2
  ident     8
  int       4
  keyword   1
  lparen    3
  op        8
  rparen    3
