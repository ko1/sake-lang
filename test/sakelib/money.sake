require "money"

puts("-- new, from_amount, fields")
m = Money.new(1234, "USD")
p(m)
puts(m)
p([Money.cents(m), Money.fractional(m), Money.amount(m), Money.to_d(m), Money.to_i(m)])
p(Money.currency(m))
puts(Money.currency(m))
p([Currency.iso_code(Money.currency(m)), Currency.symbol(Money.currency(m)), Currency.id(Money.currency(m)), Money.currency_as_string(m)])
p(Money.new(1234))
p(Money.new(1234, :eur))
p(Money.from_amount(12.34, "USD"))
p(Money.from_amount(12.345, "USD"))
p(Money.from_amount(12.355, "USD"))
p(Money.from_amount(1000, "JPY"))
p(Money.from_amount(10.5, "JPY"))
p(Money.from_amount(11.5, "JPY"))
p(Money.new(12.5, "USD"))
p(Money.new(13.5, "USD"))
p(Money.new(Rational(1, 3), "USD"))
p(Money.from_amount(1, "GBP"))
p([Money.us_dollar(100), Money.euro(100), Money.pound_sterling(100), Money.zero("JPY"), Money.from_cents(5, "EUR")])
begin
  Money.new(100, "XYZ")
rescue MoneyUnknownCurrency => e
  puts("MoneyUnknownCurrency: #{Exception.message(e)}")
end

puts("-- predicates")
Array.each(Array[Money.new(100, "USD"), Money.new(0, "USD"), Money.new(-100, "USD")]) do |x|
  p([Money.to_s(x), Money.zero?(x), Money.positive?(x), Money.negative?(x), Money.nonzero?(x), Money.abs(x), -x])
end

puts("-- arithmetic")
a = Money.new(1000, "USD")
b = Money.new(250, "USD")
p(a + b)
p(a - b)
p(b - a)
p(a * 3)
p(a * 1.5)
p(a * 0.333)
p(a * Rational(1, 3))
p(a / 3)
p(a / 4.0)
p(a / b)
p(b / a)
p(Money.div(a, 7))
p(-(a + b))
p(+a)
begin
  a * b
rescue TypeError => e
  puts("TypeError: #{Exception.message(e)}")
end
begin
  a / 0
rescue ZeroDivisionError => e
  puts("ZeroDivisionError: #{Exception.message(e)}")
end
begin
  a + Money.new(1, "EUR")
rescue MoneyUnknownRate => e
  puts("MoneyUnknownRate: #{Exception.message(e)}")
end

puts("-- comparison")
p([a == Money.new(1000, "USD"), a == b, a != b, a > b, a < b, a >= Money.new(1000, "USD"), a <=> b, b <=> a, a <=> a])
p(Money.new(0, "USD") == Money.new(0, "JPY"))
p(Money.new(100, "USD") == Money.new(100, "EUR"))
p(Money.new(100, "USD") <=> Money.new(100, "EUR"))
p(Array.map(Array.sort(Money[a, b, Money.new(500, "USD"), Money.new(-5, "USD")])) { |x| Money.cents(x) })
p(Money.cents(Array.max(Money[a, b])))
p(Money.eql?(a, Money.new(1000, "USD")))

puts("-- allocate, split")
def cents_of(xs) = Array.map(xs) { |x| Money.cents(x) }
p(cents_of(Money.allocate(Money.new(100, "USD"), Array[1, 1, 1])))
p(cents_of(Money.allocate(Money.new(100, "USD"), Array[0.5, 0.25, 0.25])))
p(cents_of(Money.allocate(Money.new(100, "USD"), Array[70, 30])))
p(cents_of(Money.allocate(Money.new(5, "USD"), Array[3, 7])))
p(cents_of(Money.allocate(Money.new(-100, "USD"), Array[1, 1, 1])))
p(cents_of(Money.allocate(Money.new(100, "USD"), Array[0, 0])))
p(cents_of(Money.split(Money.new(100, "USD"), 3)))
p(cents_of(Money.split(Money.new(1000, "JPY"), 7)))
p(Money.split(Money.new(100, "USD"), 2))
begin
  Money.allocate(Money.new(100, "USD"), Array[])
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end

puts("-- format")
Array.each(Array[[123457, "USD"], [123457, "EUR"], [123457, "GBP"], [123457, "JPY"], [-123457, "USD"], [-123457, "EUR"], [0, "USD"], [5, "USD"], [100, "USD"], [1234567890, "USD"], [1234567, "JPY"], [100, "CHF"], [123456, "KRW"], [123456, "INR"], [123456, "CNY"], [123456, "AUD"], [123456, "CAD"]]) do |cents, cur|
  x = Money.new(cents, cur)
  puts("#{cur} #{cents}: #{Money.format(x)} | #{Money.to_s(x)} | #{Money.format(x, symbol: false)} | #{Money.format(x, with_currency: true)}")
end
x = Money.new(123457, "USD")
p(Money.format(x, no_cents: true))
p(Money.format(x, no_cents_if_whole: true))
p(Money.format(Money.new(100, "USD"), no_cents_if_whole: true))
p(Money.format(x, thousands_separator: " ", decimal_mark: ","))
p(Money.format(x, thousands_separator: ""))
p(Money.format(x, symbol: "US$"))
p(Money.format(x, symbol_position: :after))
p(Money.format(Money.new(-123457, "USD"), sign_before_symbol: false))
p(Money.format(Money.new(-123457, "USD"), sign_before_symbol: false, symbol_position: :after))
p(Money.format(x, format: "%n %u"))
p(Money.format(x, format: "%u %n", with_currency: true))
p(Money.format(Money.new(-5, "EUR"), format: "%n%u"))
p(Money.to_s(Money.new(-5, "EUR")))
p(Money.to_s(Money.new(1, "JPY")))
p(Money.to_s(Money.new(100000, "JPY")))

puts("-- currency")
p(Currency.find("usd"))
p(Currency.find("nope"))
c = Currency.wrap("EUR")
p([Currency.iso_code(c), Currency.name(c), Currency.symbol(c), Currency.subunit_to_unit(c), Currency.decimal_mark(c), Currency.thousands_separator(c), Currency.symbol_first?(c), Currency.decimal_places(c), Currency.priority(c)])
p([Currency.decimal_places(Currency.wrap("JPY")), Currency.decimal_places(Currency.wrap(:usd))])
p(Currency.wrap(c) == c)
p(Currency.wrap("USD") < Currency.wrap("EUR"))
p(Array.map(Currency.all) { |k| Currency.iso_code(k) })
p(Array.map(Array.sort(Array[Currency.wrap("JPY"), Currency.wrap("USD"), Currency.wrap("GBP")])) { |k| Currency.to_s(k) })

puts("-- exchange")
bank = Bank.new
p(Bank.rates(bank))
p(Bank.add_rate(bank, "USD", "EUR", 0.9))
p(Bank.set_rate(bank, "EUR", "USD", Rational(10, 9)))
p(Bank.add_rate(bank, "USD", "JPY", 150))
p(Bank.get_rate(bank, "USD", "EUR"))
p(Bank.get_rate(bank, "EUR", "GBP"))
p(Bank.rates(bank))
p(Money.exchange_to(Money.new(1000, "USD"), "EUR", bank))
p(Money.exchange_to(Money.new(1000, "USD"), "JPY", bank))
p(Money.exchange_to(Money.new(1234, "USD"), "JPY", bank))
p(Money.exchange_to(Money.new(999, "EUR"), "USD", bank))
p(Money.exchange_to(Money.new(1000, "USD"), "USD", bank))
p(Bank.exchange_with(bank, Money.new(5, "USD"), :eur))
begin
  Money.exchange_to(Money.new(1000, "USD"), "GBP", bank)
rescue MoneyUnknownRate => e
  puts("MoneyUnknownRate: #{Exception.message(e)}")
end
p(Money.add_rate("USD", "EUR", 0.5))
Bank.add_rate(Money.default_bank, "EUR", "USD", 2)
p(Money.exchange_to(Money.new(1000, "USD"), "EUR"))
p(Money.new(1000, "USD") + Money.new(1000, "EUR"))
p(Money.new(1000, "EUR") - Money.new(1000, "USD"))
p(Money.new(500, "EUR") == Money.new(1000, "USD"))
p(Money.new(500, "EUR") > Money.new(999, "USD"))
p(Money.new(500, "EUR") / Money.new(1000, "USD"))
p(Money.exchange_to(Money.new(1000, "USD"), "EUR") == Money.default_bank.Bank.exchange_with(Money.new(1000, "USD"), "EUR"))
puts("end")
