# Port of nothing (Sake only): the program `generate` runs for an app's controllers
#
#   generate "rails/actionpack/action_controller/generate/controllers", "controllers_decl.rb", "app/controllers/posts_controller.sake"
#
# The .rb arguments are class bodies (before_action, rescue_from, ... lines); the .sake arguments are the
# controllers' source, read for their classes and actions. Prints controller.sake's source.

require "controller"

print(ActionController::Generate.source(ARGV))
