# sake: --strict
# Thread.new runs a block concurrently; Mutex and Queue coordinate threads. A block's own variables
# are the thread's; the function's variables (total) are shared.
q = Queue.new
m = Mutex.new
total = 0
workers = Array.map(Array[1, 2, 3]) do |w|
  Thread.new do
    Integer.times(1000) { Mutex.synchronize(m) { total += w } }
    w * 10
  end
end
p(Array.map(workers) { Thread.value(it) })
p(total)
producer = Thread.new do
  Integer.times(3) { |i| Queue.push(q, "item #{i}") }
  Queue.close(q)
end
while (x = Queue.pop(q))
  puts(x)
end
Thread.join(producer)
