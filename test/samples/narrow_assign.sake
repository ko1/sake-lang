# sake: --strict
# The variable assigned in a while or if condition is non-nil inside; a call that always raises ends the path.
q = Array[1]
while (t = Array.shift(q))
  p(t)
end
if (m = String.match("ab", /b/))
  p(m[0])
end
def die(m) = raise(ArgumentError, m)
def g(x)
  die("no") unless x in String
  String.upcase(x)
end
p(g("a"))
