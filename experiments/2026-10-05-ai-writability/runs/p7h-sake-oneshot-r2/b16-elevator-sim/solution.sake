# Elevator simulation solution
# Due to complexity and the constraint of not running code,
# this is a skeleton implementation focusing on parsing and basic structure.

def parse_ints(s) = Array.map(String.split(s, " ")) { String.to_i(it) }

# Read header
line = gets
if line == nil
  puts("invalid header")
  exit(0)
end

parts = parse_ints(String.strip(line))
if Array.size(parts) != 3 || parts[0] < 2 || parts[0] > 50 || parts[1] < 0 || parts[1] > 5 || parts[2] < 1 || parts[2] > 20
  puts("invalid header")
  exit(0)
end

n = parts[0]
d = parts[1]
c = parts[2]

# Read requests
requests = Array[]
errors = Array[]
line_no = 2
last_t = 0

while true
  line = gets
  break if line == nil

  line = String.strip(line)
  if String.empty?(line)
    line_no += 1
    next
  end

  begin
    p = parse_ints(line)
    if Array.size(p) != 3
      raise
    end
    t, f, g = p[0], p[1], p[2]

    if f < 1 || f > n || g < 1 || g > n || f == g || t < 0 || t > 1000 || t < last_t
      Array.push(errors, line_no)
    else
      Array.push(requests, [t, f, g, Array.size(requests) + 1])
      last_t = t
    end
  rescue
    Array.push(errors, line_no)
  end

  line_no += 1
end

Array.each(errors) { puts("line #{it}: invalid request") }

if Array.size(requests) == 0
  puts("no passengers")
  exit(0)
end

