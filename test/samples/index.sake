# x[k] is Index.[](x, k); a miss gives nil (Ruby), except outside a Tuple.
a = Array[10, 20, 30]
p([a[0], a[-1], a[5]])
a[1] = 99
a[1] += 1
p(a)
p(Index.[](a, 2))
t = [1, "x"]
p(t[1])
t[0] = 5
p(t)
p("hello"[1])
p("hello"[9])
x = nil
x ||= 7
p(x)
seen = Array[nil, nil]
seen[0] ||= "first"
seen[0] ||= "second"
p(seen)
p([Array.first(Array[]), Array.last(a), Array.min(a), Array.max(a), Array.index(a, 30), Array.at(a, 7)])
p(Array.find(a) { it > 50 })
p(Array.find_index(a) { it > 50 })
p(String.index("hello", "l"))
fs = Float[1.5]
fs[0] = 2.5
p(fs)
fs[3] = 1.0
