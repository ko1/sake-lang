# Port of activerecord-8.1.3/lib/arel/nodes/ordering.rb, ascending.rb and descending.rb (one file: the four
# ordering classes refer to each other's reverse)
#
# Ruby's Ordering < Unary is a module here; Ascending, Descending, NullsFirst and NullsLast include it.

module Arel
  module Nodes
    module Ordering
      include Unary
      def nulls_first(o) = NullsFirst.new(o)
      def nulls_last(o) = NullsLast.new(o)
      def reverse(o) = raise(NotImplementedError)
    end

    class NullsFirst
      attr_accessor expr
      include Ordering
      def reverse(o) = NullsLast.new(Ordering.reverse(@expr))
    end

    class NullsLast
      attr_accessor expr
      include Ordering
      def reverse(o) = NullsFirst.new(Ordering.reverse(@expr))
    end

    class Ascending
      attr_accessor expr
      include Ordering
      def reverse(o) = Descending.new(@expr)
      def direction(o) = :asc
      def ascending?(o) = true
      def descending?(o) = false
    end

    class Descending
      attr_accessor expr
      include Ordering
      def reverse(o) = Ascending.new(@expr)
      def direction(o) = :desc
      def ascending?(o) = false
      def descending?(o) = true
    end
  end
end
