# sake: --strict=0
# Inside a function of a Struct type, @x is field x of the first argument.
Point = Struct.new(:x, :y)

class Point
  def norm2(p) = @x * @x + @y * @y
  def move(p, dx, dy)
    @x += dx
    @y = @y + dy
    p
  end
  def to_s(p) = String.+(Integer.to_s(@x), String.+(",", Integer.to_s(@y)))
  def sum_with(p, others)
    Array.reduce(others, @x) { |acc, p| acc + Point.x(p) }   # @x stays the function's p
  end
end

def Point.scaled(p, k) = Point.new(@x * k, @y * k)

pt = Point.new(3, 4)
puts(Point.norm2(pt))
Point.move(pt, 1, 1)
puts(Point.to_s(pt))
puts(Point.to_s(Point.scaled(pt, 10)))
puts(Point.sum_with(pt, Array[Point.new(10, 0), Point.new(20, 0)]))
puts(Point.norm2(42))
