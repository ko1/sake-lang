module Sql
  class RecursivePlan < Plan
    attr_reader initial: Plan
    attr_reader step: SelectPlan
    attr_reader feed: RowFeed
    attr_reader distinct: bool
    attr_reader order_by: Array[Ast::OrderTerm]
    attr_reader limit: Ast::Expr?
    attr_reader offset: Ast::Expr?
    attr_reader collations: Array[collation]

    @names: Array[String?]

    def self.build: (Cte cte, Ast::Compound compound, Namespace env) -> RecursivePlan
    def self.initial_body: (Ast::Compound compound) -> Ast::QueryBody
    def initialize: (Plan initial, SelectPlan step, RowFeed feed, bool distinct, Array[String?] names, Array[Ast::OrderTerm] order_by, Ast::Expr? limit, Ast::Expr? offset, Array[collation] collations) -> void
    def result_exprs: () -> Array[Ast::Expr]
  end
end
