# Port of actionpack-8.1.3/lib/action_dispatch/http/permissions_policy.rb (partial: no Proc sources)
#
# The same shape as content_security_policy.sake: the define_method per directive is written out, the policy block
# is a function receiving the policy, and Request's "action_dispatch.permissions_policy" is a field.

require "request"
require "../app"

module ActionDispatch
  class PermissionsPolicy
    attr_reader directives

    def make = PermissionsPolicy.new(Hash.new)
    def initialize_copy(p) = PermissionsPolicy.new(Hash.transform_values(@directives) { |v| Array.dup(v) })

    class Middleware
      attr_reader app
      include App

      def call(mw, req)
        response = App.call(@app, req)
        _status, headers, _body = response
        return response if headers["feature-policy"] != nil
        policy = Request.permissions_policy(req)
        headers["feature-policy"] = PermissionsPolicy.build(policy) if policy
        Hash.delete(headers, "feature-policy") if policy && Hash.empty?(PermissionsPolicy.directives(policy))
        response
      end
    end

    def mappings = once { Hash.of(self: "'self'", none: "'none'") }

    # DIRECTIVES.each { |name, directive| define_method(name) { |*sources| ... } }
    def accelerometer(p, *sources) = directive(p, "accelerometer", sources)
    def ambient_light_sensor(p, *sources) = directive(p, "ambient-light-sensor", sources)
    def autoplay(p, *sources) = directive(p, "autoplay", sources)
    def camera(p, *sources) = directive(p, "camera", sources)
    def display_capture(p, *sources) = directive(p, "display-capture", sources)
    def encrypted_media(p, *sources) = directive(p, "encrypted-media", sources)
    def fullscreen(p, *sources) = directive(p, "fullscreen", sources)
    def geolocation(p, *sources) = directive(p, "geolocation", sources)
    def gyroscope(p, *sources) = directive(p, "gyroscope", sources)
    def hid(p, *sources) = directive(p, "hid", sources)
    def idle_detection(p, *sources) = directive(p, "idle-detection", sources)
    def keyboard_map(p, *sources) = directive(p, "keyboard-map", sources)
    def magnetometer(p, *sources) = directive(p, "magnetometer", sources)
    def microphone(p, *sources) = directive(p, "microphone", sources)
    def midi(p, *sources) = directive(p, "midi", sources)
    def payment(p, *sources) = directive(p, "payment", sources)
    def picture_in_picture(p, *sources) = directive(p, "picture-in-picture", sources)
    def screen_wake_lock(p, *sources) = directive(p, "screen-wake-lock", sources)
    def serial(p, *sources) = directive(p, "serial", sources)
    def sync_xhr(p, *sources) = directive(p, "sync-xhr", sources)
    def usb(p, *sources) = directive(p, "usb", sources)
    def web_share(p, *sources) = directive(p, "web-share", sources)

    def directive(p, directive, sources)
      if Array.first(sources)
        @directives[directive] = apply_mappings(p, sources)
      else
        Hash.delete(@directives, directive)
      end
      nil
    end

    def build(p, context = nil)
      Array.join(Array.map(Hash.to_a(@directives)) { |directive, sources| "#{directive} #{Array.join(sources, " ")}" }, "; ")
    end

    def apply_mappings(p, sources)
      Array.map(sources) do |source|
        case source
        in Symbol
          m = mappings[source]
          raise ArgumentError, "Unknown HTTP permissions policy source mapping: #{Kernel.inspect(source)}" unless m
          m
        in String then source
        else raise ArgumentError, "Invalid HTTP permissions policy source: #{Kernel.inspect(source)}"
        end
      end
    end
  end

  # PermissionsPolicy::Request, which Request includes in Rails
  class Request
    def permissions_policy(req) = @_permissions_policy
    def set_permissions_policy(req, policy) = @_permissions_policy = policy
  end
end
