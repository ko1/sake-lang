# BLOB values (CHANGE 7): the bytes are kept as uppercase hex digits, two per byte, so comparing two
# hex strings compares the bytes as unsigned and a shorter prefix comes first.
class Blob
  attr_reader hex

  # The BLOB of the bytes of a TEXT.
  def of_text(s) = Blob.new(Array.join(Array.map(String.bytes(s)) { format("%02X", it) }, ""))

  # The bytes read as characters: the text form of a BLOB (spec 7.1).
  def text(b) = Array.join(Array.map(String.scan(@hex, /../)) { Integer.chr(String.hex(it)) }, "")

  def size(b) = String.size(@hex) / 2

  # The printed form: X'..' with two uppercase hex digits per byte.
  def literal(b) = "X'" + @hex + "'"
end
