# Port of actionpack-8.1.3/lib/action_dispatch/testing/request_encoder.rb (partial: the :html parser gives the body String (no Nokogiri), no register_encoder of other types)
#
# Rails keeps encoder objects (IdentityEncoder, and one per registered MIME type with lambdas for the param encoder
# and the response parser); here an encoder is its MIME symbol (:identity, :html, :json) and each operation a `case`.

require "json"
require "../http/mime_type"

module ActionDispatch
  module RequestEncoder
    module_function

    def encoder(name) = name == :json || name == :html ? name : :identity

    def content_type(e)
      case e
      in :json then "application/json"
      in :html then "application/x-www-form-urlencoded"
      else nil
      end
    end

    def accept_header(e)
      case e
      in :json then "application/json"
      in :html then "text/html"
      else nil
      end
    end

    # encode_params(params): JSON for :json (params.to_json), the Hash itself otherwise
    def encode_params(e, params)
      return params unless e == :json && params != nil
      JSON.generate(params)
    end

    # parser(content_type): JSON.parse for a JSON response, else the body
    def parser(content_type)
      type = content_type ? Mime::Type.ref(Mime::Type.lookup(content_type)) : nil
      encoder(type == :json ? :json : :identity)
    end

    def parse(e, body) = e == :json ? JSON.parse(body) : body
  end
end
