# awesome_print: a value laid out the way the awesome_print gem's `ap` prints it.
#
#   AwesomePrint.ai(v, plain: true)   # Ruby: v.ai(plain: true)  => the String
#   AwesomePrint.ap(v)                # Ruby: ap(v)              => prints it, gives v back
#
# Arrays one element per line with its index, Hashes with the keys right-aligned on `=>` (or `name: v`
# with ruby19_syntax: true), nested containers indented by `indent` (4) more each level, scalars coloured
# with the gem's ANSI codes unless plain: true. Tuples and Sets print as Arrays, Records as Hashes
# (Record.to_h); Struct values and anything else are Kernel.inspect in one piece.
# The walk is `case v in Array ... in Hash ...` on the type tag, as pp.sake's is; its state (the options
# and the current indentation) is a Struct type, AwesomeInspector.

class AwesomeInspector
  attr_reader indent, plain, index, multiline, sort_keys, ruby19_syntax
  private attr_accessor indentation

  def initialize(ai)
    @indent => Integer
    @indentation = Integer.abs(@indent)
  end

  # The gem's default colour per type (Colors: `\e[1;Nm` for a colour, `\e[0;Nm` for its "ish" shade).
  def colors = once do
    Hash[array: "1;37", hash: "0;37", integer: "1;34", float: "1;34", rational: "1;34", string: "0;33",
         symbol: "0;36", nilclass: "1;31", trueclass: "1;32", falseclass: "1;31", struct: "0;37"]
  end

  def colorize(ai, s, type)
    return s if @plain
    code = colors[type]
    code == nil ? s : "\e[#{code}m#{s}\e[0m"
  end

  # Ruby: inspector.awesome(object), by the object's class.
  def awesome(ai, v)
    case v
    in Array then awesome_array(ai, v)
    in Tuple then awesome_array(ai, Tuple.to_a(v))
    in Set then awesome_array(ai, Set.to_a(v))
    in Hash then awesome_hash(ai, v)
    in Record then awesome_hash(ai, Record.to_h(v))
    in String then colorize(ai, Kernel.inspect(v), :string)
    in Symbol then colorize(ai, Kernel.inspect(v), :symbol)
    in Integer then colorize(ai, Integer.to_s(v), :integer)
    in Float then colorize(ai, Kernel.inspect(v), :float)
    in Rational then colorize(ai, Rational.to_s(v), :rational)
    in nil then colorize(ai, "nil", :nilclass)
    in true then colorize(ai, "true", :trueclass)
    in false then colorize(ai, "false", :falseclass)
    in Range | Regexp | Complex | Time | IO | MatchData then Kernel.inspect(v)   # the gem: inspect, no colour
    else colorize(ai, Kernel.inspect(v), :struct)                               # Struct values
    end
  end

  def indent_s(ai) = " " * @indentation
  def outdent(ai) = " " * (@indentation - Integer.abs(@indent))

  # Ruby: indented { ... }: one level deeper while the block runs.
  def indented(ai)
    @indentation += Integer.abs(@indent)
    begin
      yield
    ensure
      @indentation -= Integer.abs(@indent)
    end
  end

  # Ruby: ArrayFormatter: `[0] item` lines (the indices right-aligned to the widest), or `[ a, b ]` on one line.
  def awesome_array(ai, a)
    return "[]" if Array.empty?(a)
    return "[ " + Array.join(Array.map(a) { |x| awesome(ai, x) }, ", ") + " ]" unless @multiline
    width = String.size(Integer.to_s(Array.size(a) - 1))
    lines = Array.map(Array.each_with_index(a)) do |item, i|
      prefix = @index ? indent_s(ai) + colorize(ai, "[#{String.rjust(Integer.to_s(i), width)}] ", :array) : indent_s(ai)
      prefix + indented(ai) { awesome(ai, item) }
    end
    "[\n" + Array.join(lines, ",\n") + "\n" + outdent(ai) + "]"
  end

  # Ruby: HashFormatter: keys (printed plain, on one line) aligned on ` => `, or `k: v` for Symbol keys with
  # ruby19_syntax; the alignment width counts the indentation, so the longest key starts at the indent.
  def awesome_hash(ai, h)
    return "{}" if Hash.empty?(h)
    keys = Hash.keys(h)
    keys = Array.sort_by(keys) { |k| Kernel.to_s(k) } if @sort_keys
    data = Array.map(keys) { |k| [plain_single_line(ai, k), Hash.fetch(h, k)] }
    width = Array.reduce(data, 0) { |m, t| Tuple.max([m, String.size(t[0])]) }
    width += @indentation if @indent > 0
    lines = Array.map(data) do |k, v|
      indented(ai) do
        if @ruby19_syntax && String.start_with?(k, ":")
          align(ai, String.[](k, 1..) || "", width - 1) + colorize(ai, ": ", :hash) + awesome(ai, v)
        else
          align(ai, k, width) + colorize(ai, " => ", :hash) + awesome(ai, v)
        end
      end
    end
    return "{ " + Array.join(lines, ", ") + " }" unless @multiline
    "{\n" + Array.join(lines, ",\n") + "\n" + outdent(ai) + "}"
  end

  # Ruby: align(value, width): right-aligned for a positive indent, left-aligned (after the indent) otherwise.
  def align(ai, value, width)
    return value unless @multiline
    if @indent > 0
      String.rjust(value, width)
    elsif @indent == 0
      indent_s(ai) + String.ljust(value, width)
    else
      (String.[](indent_s(ai), 0, @indentation + @indent) || "") + String.ljust(value, width)
    end
  end

  # Ruby: plain_single_line { awesome(key) }: a key is printed without colours and on one line.
  def plain_single_line(ai, k)
    plain = @plain
    multiline = @multiline
    @plain = true
    @multiline = false
    s = awesome(ai, k)
    @plain = plain
    @multiline = multiline
    s
  end
end

module AwesomePrint
  module_function

  # Ruby: obj.ai(options) => the String. The options are the gem's: indent (negative: left-aligned keys),
  # plain (no colours), index (array indices), multiline, sort_keys, ruby19_syntax.
  def ai(v, indent: 4, plain: false, index: true, multiline: true, sort_keys: false, ruby19_syntax: false)
    AwesomeInspector.awesome(AwesomeInspector.new(indent, plain, index, multiline, sort_keys, ruby19_syntax), v)
  end

  # Ruby: ap(obj, options): prints and gives obj back.
  def ap(v, indent: 4, plain: false, index: true, multiline: true, sort_keys: false, ruby19_syntax: false)
    puts ai(v, indent: indent, plain: plain, index: index, multiline: multiline, sort_keys: sort_keys, ruby19_syntax: ruby19_syntax)
    v
  end
end
