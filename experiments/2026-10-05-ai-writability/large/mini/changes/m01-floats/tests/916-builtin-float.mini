print(float(3), float(-2), float(2.5), float("1.5"), float("-0.25"), float("007"), float("-0"), float("12.50"))
print(type(float(1)), float(9007199254740993), float(0))
fn try_it(x)
  try
    print(float(x))
  catch e
    print(e.kind, e.message, e.col)
  end
end
try_it("1.")
try_it(".5")
try_it("1e5")
try_it(" 1.5")
try_it("1_0.5")
try_it("+1.5")
try_it("")
try_it("-")
try_it(true)
try_it(nil)
try_it([1.5])
try_it(10 ** 400)
try_it("1" + join(map(range(400), fn (i) return "0" end), "") + ".5")
print(float)
