# Port of activerecord-8.1.3/lib/active_record/enum.rb (partial: no enum with a block of options per value,
# no validate: option, no instance_methods: false, no default:; the methods are generated, generate/features.sake)
#
# Ruby's EnumType decorates the column's type: it casts a label (String or Symbol) or a stored value to the
# label, and serializes the label to the stored value; an unknown label is an ArgumentError when assigned.

module ActiveRecord
  module Enum
    class EnumType
      attr_reader name, mapping, subtype
      include ActiveModel::Type::Value

      def precision(t) = nil
      def scale(t) = nil
      def limit(t) = nil
      def type(t) = ActiveModel::Type::Value.type(@subtype)

      def label_of(t, value)
        case value
        in nil then nil
        in ::String then Hash.key?(@mapping, value) ? value : Hash.key(@mapping, value)
        in Symbol then Hash.key?(@mapping, Symbol.to_s(value)) ? Symbol.to_s(value) : nil
        else Hash.key(@mapping, value)
        end
      end

      def cast(t, value)
        v = label_of(t, value)
        v ? v : nil
      end

      def deserialize(t, value) = label_of(t, ActiveModel::Type::Value.deserialize(@subtype, value))

      def serialize(t, value)
        label = label_of(t, value)
        mapped = label ? @mapping[label] : nil
        ActiveModel::Type::Value.serialize(@subtype, mapped)
      end
      def serialize_cast_value_compatible?(t) = false

      # Ruby: assert_valid_value raises for a value that is neither a label nor a stored value
      def assert_valid_value(t, value)
        return nil if (value in nil) || label_of(t, value) != nil
        s = case value
            in Symbol then Symbol.to_s(value)
            else Kernel.to_s(value)
            end
        raise ArgumentError, "'#{s}' is not a valid #{@name}"
      end
    end

    def defined_enums = ActiveRecord::ModelClass.defined_enums(__model)
  end
end
