# `a && b || c`: the false that `a && b` gives for a false `a` does not reach the result (`||` takes c then).
def off(utc, alt = nil) = utc && alt || "+09:00"
p(String.sub("12:00+09:00", /\+09:00\z/, off(true, "Z")))
p(String.sub("12:00+09:00", /\+09:00\z/, off(false)))
def flag(a, b) = (a || b) && "yes"
p(flag(false, false))
