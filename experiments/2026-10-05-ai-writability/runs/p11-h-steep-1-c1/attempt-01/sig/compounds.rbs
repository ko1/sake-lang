module Sql
  module Compounds
    def self.rows: (CompoundPlan plan, Array[value] outer) -> Array[Array[value]]
    def self.combine: (String op, Array[Array[value]] left, Array[Array[value]] right, Array[collation] collations) -> Array[Array[value]]
    def self.recursive_rows: (RecursivePlan plan, Array[value] outer) -> Array[Array[value]]
    def self.wanted_rows: (RecursivePlan plan) -> Integer?
    def self.enqueue: (Array[Array[value]] queue, Hash[Array[value], bool] seen, Array[Array[value]] rows, bool distinct, Array[collation] collations) -> void
    def self.key: (Array[value] row, Array[collation] collations) -> Array[value]
    def self.keys_of: (Array[Array[value]] rows, Array[collation] collations) -> Hash[Array[value], bool]
    def self.distinct: (Array[Array[value]] rows, Array[collation] collations) -> Array[Array[value]]
  end
end
