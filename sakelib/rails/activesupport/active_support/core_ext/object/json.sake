# Port of activesupport-8.1.3/lib/active_support/core_ext/object/json.rb (partial: no Object#as_json through instance_values, no Process::Status, Pathname, IPAddr, URI)
#
# Ruby defines as_json in some twenty classes; here `Object.as_json(x)` is one `case` over the built-in types,
# and a type that includes ActiveSupport::AsJson (as_json.sake) answers with its own as_json, as ActiveSupport's
# own types do. Ruby's Object#as_json (the instance variables) has no Sake form: no reflection over an unknown type.

require "../../time_with_zone"
require "../../duration"
require "../../hash_with_indifferent_access"
require "../../ordered_options"
require "../string/output_safety"
require "../../as_json"
require "../../json/encoding"

module Object
  module_function

  def as_json(value, options = nil)
    case value
    in nil | true | false then value
    in String | Integer then value
    in Symbol then Symbol.to_s(value)
    in Float then Float.finite?(value) ? value : nil
    in Rational then Kernel.to_s(value)
    in Array then Array.map(value) { |v| as_json(v, options) }
    in Tuple then Array.map(Tuple.to_a(value)) { |v| as_json(v, options) }
    in Hash
      result = Hash.new
      Hash.each(value) { |k, v| result[Kernel.to_s(k)] = as_json(v, options) }
      result
    in Set then Array.map(Set.to_a(value)) { |v| as_json(v, options) }
    in Range | Regexp then Kernel.to_s(value)
    in Time then Time.xmlschema(value, ActiveSupport::JSON::Encoding.time_precision)
    in Date then Date.strftime(value, "%Y-%m-%d")
    in ActiveSupport::AsJson then as_json(ActiveSupport::AsJson.as_json(value, options), options)
    else Exception.message(value)   # Ruby: Exception#as_json is to_s; the other values have no case here
    end
  end
end
