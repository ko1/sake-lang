# A truthiness test (`u ? 1 : 2`, `u && x`, `if u`, `!u`) of an instance whose class defines `==` does
# not call that ==: only nil and false are false, by identity.
class U
  attr_reader n
  include Comparable
  def ==(a, b)
    puts("== called with #{Kernel.inspect(b)}")
    U.n(a) == U.n(b)
  end
  def <=>(a, b) = @n <=> U.n(b)
end
u = Array.first(Array[U.new(1)])
p(u ? 1 : 2)
p(u && 3)
p(!u)
