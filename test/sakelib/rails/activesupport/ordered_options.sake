require "rails/activesupport/active_support/ordered_options"
generate "rails/activesupport/active_support/generate/ordered_options", "log_level", "time_zone", "api_key"

# ActiveSupport::OrderedOptions and InheritableOptions (ordered_options)
config = ActiveSupport::OrderedOptions.make
ActiveSupport::OrderedOptions.set_log_level(config, :debug)
config[:time_zone] = "UTC"
ActiveSupport::OrderedOptions.option(config, :retries=, 3)
p(ActiveSupport::OrderedOptions.log_level(config), config["time_zone"], ActiveSupport::OrderedOptions.option(config, :retries), ActiveSupport::OrderedOptions.api_key(config))
p(ActiveSupport::OrderedOptions.log_level!(config), ActiveSupport::OrderedOptions.key?(config, "log_level"), ActiveSupport::OrderedOptions.keys(config))
begin
  ActiveSupport::OrderedOptions.api_key!(config)
rescue KeyError => e
  puts Exception.message(e)
end
config[:db] = Hash.of(primary: Hash.of(host: "localhost"))
p(ActiveSupport::OrderedOptions.dig(config, :db, :primary, :host), ActiveSupport::OrderedOptions.dig(config, :nothing, :x))
p(config)
child = ActiveSupport::InheritableOptions.new(config)
child[:time_zone] = "Tokyo"
p(ActiveSupport::OrderedOptions.time_zone(child), ActiveSupport::OrderedOptions.log_level(child), ActiveSupport::OrderedOptions.key?(child, :retries))
p(ActiveSupport::InheritableOptions.overridden?(child, :time_zone), ActiveSupport::InheritableOptions.overridden?(child, :log_level), Hash.keys(ActiveSupport::OrderedOptions.to_h(child)))
grand = ActiveSupport::InheritableOptions.inheritable_copy(child)
p(ActiveSupport::OrderedOptions.time_zone(grand), grand == child)
from_hash = ActiveSupport::InheritableOptions.new(Hash.of(a: 1))
p(from_hash[:a], ActiveSupport::OrderedOptions.to_h(from_hash))
