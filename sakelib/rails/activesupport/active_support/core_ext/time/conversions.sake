# Port of activesupport-8.1.3/lib/active_support/core_ext/time/conversions.rb
#
# Ruby's DATE_FORMATS holds Strings and lambdas; the Strings are a Hash here and the lambdas the cases of to_fs.

require "time"
require "../../inflector/methods"
require "../../values/time_zone"

class Time
  def date_formats = once do
    Hash.of(db: "%Y-%m-%d %H:%M:%S", inspect: "%Y-%m-%d %H:%M:%S.%9N %z", number: "%Y%m%d%H%M%S",
            nsec: "%Y%m%d%H%M%S%9N", usec: "%Y%m%d%H%M%S%6N", time: "%H:%M", short: "%d %b %H:%M",
            long: "%B %d, %Y %H:%M")
  end

  def to_fs(t, format = :default)
    case format
    in :long_ordinal then Time.strftime(t, "%B #{ActiveSupport::Inflector.ordinalize(Time.day(t))}, %Y %H:%M")
    in :rfc822 then Time.strftime(t, "%a, %d %b %Y %H:%M:%S #{Time.formatted_offset(t, false)}")
    in :rfc2822 then Time.rfc2822(t)
    in :iso8601 then Time.iso8601(t)
    else
      formatter = date_formats[format]
      formatter ? Time.strftime(t, formatter) : Time.to_s(t)
    end
  end

  def to_formatted_s(t, format = :default) = Time.to_fs(t, format)

  def formatted_offset(t, colon = true, alternate_utc_string = nil)
    Time.utc?(t) && alternate_utc_string || ActiveSupport::TimeZone.seconds_to_utc_offset(Time.utc_offset(t), colon)
  end
end
