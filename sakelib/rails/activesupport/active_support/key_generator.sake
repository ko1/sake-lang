# Port of activesupport-8.1.3/lib/active_support/key_generator.rb (partial: the digest is named by a String ("SHA1", "SHA256"), not an OpenSSL::Digest class)
#
# Ruby's OpenSSL::PKCS5.pbkdf2_hmac is the built-in of the same name (the first wave wrote PBKDF2 over HMAC here).

module ActiveSupport
  class KeyGenerator
    attr_reader secret, iterations, hash_digest_class

    # Ruby's KeyGenerator.new(secret, iterations: 2**16, hash_digest_class: SHA1).
    def initialize(k)
      @iterations = 65536 if @iterations == nil
      @hash_digest_class = KeyGenerator.default_hash_digest_class if @hash_digest_class == nil
    end

    def default_hash_digest_class = "SHA1"

    def generate_key(k, salt, key_size = 64)
      OpenSSL::PKCS5.pbkdf2_hmac(@secret, salt, @iterations, key_size, @hash_digest_class)
    end

    def inspect(k) = "#<ActiveSupport::KeyGenerator>"
  end

  # Ruby's CachingKeyGenerator: a key per (salt, key size) is derived once.
  class CachingKeyGenerator
    attr_reader key_generator
    private attr_reader cache_keys

    def initialize(c)
      @cache_keys = Hash.new
    end

    def generate_key(c, salt, key_size = 64)
      k = "#{salt}|#{key_size}"
      cached = @cache_keys[k]
      return cached if cached != nil
      @cache_keys[k] = KeyGenerator.generate_key(@key_generator, salt, key_size)
    end
  end
end
