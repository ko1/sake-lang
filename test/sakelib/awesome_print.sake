require "awesome_print"

def show(title, s)
  puts "--- #{title}"
  puts s
end

# arrays: indices right-aligned to the widest; nested containers one level deeper
show("array", AwesomePrint.ai(Array[1, "two", :three, nil, true, false, 1.5], plain: true))
show("array of 11", AwesomePrint.ai(Array.new(11) { |i| i * i }, plain: true))
show("nested", AwesomePrint.ai(Array[1, Array[2, Array[3, Array[]]], Hash[k: "v"]], plain: true))
show("no index", AwesomePrint.ai(Array["a", "b"], plain: true, index: false))

# hashes: keys aligned on =>; Symbol, String, Integer, Tuple keys; nested hash
h = Hash[name: "alice", "age" => 30, 7 => "seven", [1, 2] => Array[3], :"foo bar" => nil, roles: Array[:admin, :dev]]
show("hash", AwesomePrint.ai(h, plain: true))
show("hash ruby19", AwesomePrint.ai(h, plain: true, ruby19_syntax: true))
show("hash sorted", AwesomePrint.ai(h, plain: true, sort_keys: true))
show("hash in hash", AwesomePrint.ai(Hash[a: 1, bb: Hash[ccc: 2, d: Hash[e: Array[1, 2]]], f: Hash[]], plain: true))
show("hash in array", AwesomePrint.ai(Array[Hash[x: 1, long_key: 2], Hash[]], plain: true))

# indent: 2, 0 (left-aligned after the indent), -4 (left-aligned keys)
show("indent 2", AwesomePrint.ai(Hash[a: 1, bbb: Array[1, 2]], plain: true, indent: 2))
show("indent 0", AwesomePrint.ai(Hash[a: 1, bbb: Array[1, 2]], plain: true, indent: 0))
show("indent -4", AwesomePrint.ai(Hash[a: 1, bbb: Hash[cc: 2]], plain: true, indent: -4))

# one line
show("single line", AwesomePrint.ai(Hash[a: Array[1, 2], b: Hash[c: :d]], plain: true, multiline: false))
show("single line array", AwesomePrint.ai(Array[1, Array[2, 3]], plain: true, multiline: false))

# empty containers and scalars
show("empties", AwesomePrint.ai(Array[Array[], Hash[], Set[], ""], plain: true))
show("scalars", AwesomePrint.ai(Array[42, -1.5, Rational(1, 3), Complex(1, 2), 1..3, /re/i, "s\n", :sym, nil, true, false], plain: true))
show("string", AwesomePrint.ai("plain", plain: true))
show("integer", AwesomePrint.ai(7, plain: true))
show("nil", AwesomePrint.ai(nil, plain: true))

# Sets print as Arrays, Tuples as Arrays, Records as Hashes, Struct values in one piece
S = Struct.new(:x, :y)
show("set", AwesomePrint.ai(Set[1, 2, 3], plain: true))
show("tuple", AwesomePrint.ai([1, "a"], plain: true))
show("record", AwesomePrint.ai({x: 1, y: Array[2]}, plain: true))
show("struct", AwesomePrint.ai(Array[S.new(1, Array[2, 3])], plain: true))

# colours: the gem's ANSI codes (shown with p so the escapes are visible)
p AwesomePrint.ai(Array[1, "s", :sym, nil, true, false, 1.5, Rational(1, 2), 1..2])
p AwesomePrint.ai(Hash[a: 1, "b" => Array[]])
p AwesomePrint.ai(Hash[a: S.new(1, 2)], ruby19_syntax: true)
p AwesomePrint.ai(Hash[a: 1], multiline: false)

# ap prints and gives the value back
r = AwesomePrint.ap(Array[1, Hash[a: 2]], plain: true)
p r
r2 = AwesomePrint.ap(Hash[k: "v"], plain: true, indent: 2, ruby19_syntax: true)
p r2 == Hash[k: "v"]
