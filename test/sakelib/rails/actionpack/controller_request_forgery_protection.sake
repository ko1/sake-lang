require "rails/actionpack/action_controller/base"
require "rails/actionpack/action_dispatch/middleware/stack"

# Request forgery protection over a cookie session: protect_from_forgery with :exception, :null_session and
# :reset_session, skip_forgery_protection, the masked form token (as a param and as X-CSRF-Token), a token for
# another session, a malformed one, an unmasked raw token, and the cross-origin JavaScript check.
class FormsController < ActionController::Base
  def new_(c) = render c, plain: form_authenticity_token(c)
  def create(c) = render c, plain: "created"
  def script(c) = render c, js: "alert(1)"
  def raw(c) = render c, plain: Base64.urlsafe_encode64(real_csrf_token(c), padding: false)
end
class OpenController < FormsController
end
class NullController < ActionController::Base
  def login(c)
    session(c)[:user] = "ann"
    render c, plain: "logged in #{form_authenticity_token(c) != ""}"
  end
  def create(c) = render c, plain: "user=#{Kernel.inspect(session(c)[:user])}"
end
class ResetController < ActionController::Base
  def login(c)
    session(c)[:user] = "bob"
    render c, plain: "logged in"
  end
  def create(c) = render c, plain: "user=#{Kernel.inspect(session(c)[:user])}"
end
generate "rails/actionpack/action_controller/generate/controllers", "controller_request_forgery_protection_decl.rb", "controller_request_forgery_protection.sake"

class ActionDispatch::Routing::Mapper
  def forgery_routes(map)
    Array.each(String["forms", "open"]) do |r|
      get map, "#{r}/new", to: "#{r}#new"
      post map, r, to: "#{r}#create"
      get map, "#{r}/script", to: "#{r}#script"
      get map, "#{r}/raw", to: "#{r}#raw"
    end
    Array.each(String["null", "reset"]) do |r|
      get map, "#{r}/login", to: "#{r}#login"
      post map, r, to: "#{r}#create"
    end
  end
end
set = ActionDispatch::Routing::RouteSet.make
ActionDispatch::Routing::RouteSet.draw(set) { |map| ActionDispatch::Routing::Mapper.forgery_routes(map) }
set.ActionDispatch::Routing::RouteSet.controllers = ActionController::ControllerSet.new

def configure(req)
  c = ActionDispatch::Request.env_config(req)
  c["action_dispatch.key_generator"] = ActiveSupport::CachingKeyGenerator.new(ActiveSupport::KeyGenerator.new("b" * 64, iterations: 2))
  c["action_dispatch.signed_cookie_salt"] = "signed cookie"
  c["action_dispatch.cookies_serializer"] = :json
  c["action_dispatch.use_cookies_with_metadata"] = true
end
class Config
  attr_reader app
  include ActionDispatch::App
  def call(c, req)
    configure(req)
    ActionDispatch::App.call(@app, req)
  end
end
stack = ActionDispatch::MiddlewareStack.new
ActionDispatch::MiddlewareStack.use(stack, "ActionDispatch::Cookies")
ActionDispatch::MiddlewareStack.use(stack, "ActionDispatch::Session::CookieStore", Hash.of(key: "_app_session"))
ActionDispatch::MiddlewareStack.use(stack, "ActionDispatch::Flash")
app = ActionDispatch::RackApp.new(Config.new(ActionDispatch::MiddlewareStack.build(stack, set)))

# Returns the session cookie to send next and the body.
def request(app, method, path, cookie, query = nil, headers = Hash.new)
  env = Rack::MockRequest.env_for("http://www.example.com#{path}#{query ? "?#{query}" : ""}", method: method)
  env["HTTP_COOKIE"] = cookie if cookie
  Hash.each(headers) { |k, v| env[k] = v }
  begin
    status, hs, body = Rack::App.call(app, env)
  rescue => e
    puts("#{method} #{path} -> #{class_name(e)}: #{String.slice(Exception.message(e), 0, 60)}")
    return [cookie, ""]
  end
  out = ""
  Array.each(body) { |s| out += s }
  h = hs["set-cookie"]
  sc = (h in Array) ? Array.first(h) : h
  shown = String.size(out) > 40 ? "(#{String.size(out)} chars)" : Kernel.inspect(out)
  puts("#{method} #{path} -> #{status} #{shown} cookie=#{sc != nil}")
  [sc ? String.[](Kernel.to_s(sc), /\A[^;]*/) : cookie, out]
end

def esc(s) = Rack::Utils.escape(s)

c, token = request(app, "GET", "/forms/new", nil)
request(app, "POST", "/forms", c)
request(app, "POST", "/forms", c, "authenticity_token=#{esc(token)}")
request(app, "POST", "/forms", c, nil, Hash.of("HTTP_X_CSRF_TOKEN" => token))
c2, token2 = request(app, "GET", "/forms/new", c)
request(app, "POST", "/forms", c2, "authenticity_token=#{esc(token2)}")
request(app, "POST", "/forms", c, "authenticity_token=#{esc(token)}")
other, other_token = request(app, "GET", "/forms/new", nil)
request(app, "POST", "/forms", c, "authenticity_token=#{esc(other_token)}")
request(app, "POST", "/forms", c, "authenticity_token=not-base64!!")
request(app, "POST", "/forms", c, "authenticity_token=YWJj")
_, raw = request(app, "GET", "/forms/raw", c)
request(app, "POST", "/forms", c, "authenticity_token=#{esc(raw)}")
request(app, "GET", "/forms/script", c)
request(app, "GET", "/forms/script", c, nil, Hash.of("HTTP_X_REQUESTED_WITH" => "XMLHttpRequest"))
request(app, "POST", "/open", c)
request(app, "GET", "/open/script", c)
n, _ = request(app, "GET", "/null/login", nil)
request(app, "POST", "/null", n)
r, _ = request(app, "GET", "/reset/login", nil)
r2, _ = request(app, "POST", "/reset", r)
request(app, "POST", "/reset", r2)
p(ActionController::RequestForgeryProtection.protection_method(:exception))
begin
  ActionController::RequestForgeryProtection.protection_method(:nope)
rescue ArgumentError => e
  puts(Exception.message(e))
end
