# String helpers whose built-in versions may answer nil outside the string.
module Text
  module_function

  # `len` bytes of s from byte `start` ("" outside the string).
  def byteslice(s, start, len)
    r = String.byteslice(s, start, len)
    r == nil ? "" : r
  end

  # `len` characters of s from character `start` ("" outside the string).
  def slice(s, start, len)
    r = String.slice(s, start, len)
    r == nil ? "" : r
  end
end
