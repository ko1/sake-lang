# Status (2026-10-05): fixed.
# `@port => Integer` in initialize does not narrow the field: the String given by the second new
# (which raises NoMatchingPatternError at run time) still reaches `@port > 0` and `@port + 1`, and
# bin/sake --strict=2 -c reports both as [mixed]; --types shows Cfg.port: Integer | String.
# Spec §10.1 says the fields hold what initialize leaves in them, and §2.1 suggests this very check.
class Cfg
  attr_reader port
  def initialize(c)
    @port => Integer
    raise ArgumentError, "bad" unless @port > 0
  end
  def next_port(c) = @port + 1
end
p Cfg.next_port(Cfg.new(80))
begin
  Cfg.new(Array.fetch(Array[1, "big"], 1))
rescue NoMatchingPatternError
  puts "no"
end
