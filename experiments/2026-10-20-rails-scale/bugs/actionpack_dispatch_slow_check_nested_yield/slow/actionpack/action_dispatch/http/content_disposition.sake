# Port of actionpack-8.1.3/lib/action_dispatch/http/content_disposition.rb

require "i18n"

module ActionDispatch
  module Http
    class ContentDisposition
      attr_reader disposition, filename

      # Rails: ContentDisposition.format(disposition:, filename:)
      def format(disposition:, filename:) = to_s(ContentDisposition.new(disposition, filename))

      def traditional_escaped_char = /[^ A-Za-z0-9!\#$+.^_`|~-]/
      def ascii_filename(cd)
        "filename=\"" + percent_escape(I18n.transliterate(Kernel.to_s(@filename)), traditional_escaped_char) + "\""
      end

      def rfc_5987_escaped_char = /[^A-Za-z0-9!\#$&+.^_`|~-]/
      def utf8_filename(cd)
        "filename*=UTF-8''" + percent_escape(Kernel.to_s(@filename), rfc_5987_escaped_char)
      end

      def to_s(cd)
        if @filename
          "#{@disposition}; #{ascii_filename(cd)}; #{utf8_filename(cd)}"
        else
          "#{@disposition}"
        end
      end

      def percent_escape(string, pattern)
        String.gsub(string, pattern) do |char|
          Array.join(Array.map(String.bytes(char)) { |byte| Kernel.format("%%%02X", byte) })
        end
      end
    end
  end
end
