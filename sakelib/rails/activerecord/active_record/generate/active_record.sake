# Port of nothing (Sake only): the program `generate` runs for a Rails app's models and schema
#
#   generate "rails/activerecord/active_record/generate/active_record", "db/schema.rb", "app/models.rb"
#
# Each argument is db/schema.rb (it has `ActiveRecord::Schema`) or a file of model class bodies (Ruby's
# app/models, one declaration per line; Ruby requires the same file), or `includes=A,B` / `protocols=A,B`
# (Generate.on_load_includes / protocol_includes, model.sake). It prints the schema's loader module and
# each model's Sake source (model.sake).

require "model"
require "associations"
require "features"

tables = ActiveRecord::Generate::SchemaTable[]
bodies = ActiveSupport::Generate::ClassBody[]
model_paths = String[]
Array.each(ARGV) do |path|
  if String.start_with?(path, "includes=") || String.start_with?(path, "protocols=")
    key, list = String.split(path, "=", 2).Array.values_at(0, 1)
    to = key == "includes" ? ActiveRecord::Generate.on_load_includes : ActiveRecord::Generate.protocol_includes
    Array.each(String.split(Kernel.to_s(list), ",")) { |m| Array.push(to, m) }
    next
  end
  text = File.read(path)
  if String.include?(text, "ActiveRecord::Schema")
    Array.each(ActiveRecord::Generate.parse_schema(text, path)) { |t| Array.push(tables, t) }
    print(ActiveRecord::Generate.loader_source(text, path))
  else
    Array.each(ActiveSupport::Generate.parse(text, path)) { |b| Array.push(bodies, b) }
    Array.push(model_paths, path)
  end
end
path = Array.first(model_paths) || ""
Array.each(bodies) { |b| print(ActiveRecord::Generate.class_source(b, bodies, tables, path)) }
