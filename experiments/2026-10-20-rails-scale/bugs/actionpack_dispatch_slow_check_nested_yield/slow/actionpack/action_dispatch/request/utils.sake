# Port of actionpack-8.1.3/lib/action_dispatch/request/utils.rb (partial: no CustomParamEncoder (encoding templates need the controller class), no UploadedFile)
#
# normalize_encode_params turns a parsed Hash (from JSON) into params: String keys (HashWithIndifferentAccess in
# Rails), and, with perform_deep_munge (the default), nils dropped from Arrays (NoNilParamEncoder).
#
# `module ActionDispatch::Request::Utils` (not `class Request` + `module Utils`): a file read before
# http/request.sake must not open `class Request`, whose first opening declares its fields.

module ActionDispatch::Request::Utils
  module_function

  def perform_deep_munge = true

  def each_param_value(params, &block)
    case params
    in Array then Array.each(params) { |element| each_param_value(element, &block) }
    in Hash then Hash.each_value(params) { |value| each_param_value(value, &block) }
    in String then yield(params)
    else nil
    end
    nil
  end

  def normalize_encode_params(params)
    case params
    in Array
      list = Array.map(params) { |el| normalize_encode_params(el) }
      perform_deep_munge ? Array.compact(list) : list
    in Hash
      hwia = Hash.new
      Hash.each(params) { |key, val| hwia[Kernel.to_s(key)] = normalize_encode_params(val) }
      hwia
    else
      params
    end
  end

  def check_param_encoding(params)
    case params
    in Array then Array.each(params) { |element| check_param_encoding(element) }
    in Hash then Hash.each_value(params) { |value| check_param_encoding(value) }
    in String
      raise ActionDispatch::InvalidParameterError, "Invalid encoding for parameter: #{String.scrub(params)}" unless String.valid_encoding?(params)
    else nil
    end
    nil
  end
end
