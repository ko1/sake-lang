Review = Struct.new(:product, :stars, :text)
Score = Struct.new(:total, :hits, :words)

def lexicon
  Hash[
    "good" => 2, "great" => 3, "excellent" => 4, "love" => 3, "nice" => 2, "fast" => 1,
    "bad" => -2, "terrible" => -4, "slow" => -1, "broken" => -3, "hate" => -3, "poor" => -2,
    "cheap" => -1, "sturdy" => 2, "flimsy" => -2, "happy" => 2, "disappointed" => -3
  ]
end

def intensifiers = Hash["very" => 1.5, "really" => 1.5, "extremely" => 2.0, "slightly" => 0.5]
def negators = Set["not", "never", "no", "hardly"]

def reviews
  Review[
    Review.new("kettle", 5, "Great kettle, really fast and very sturdy. Love it!"),
    Review.new("kettle", 2, "Not good. The lid feels flimsy and the switch is slow."),
    Review.new("kettle", 4, "Nice design, slightly slow but not bad at all."),
    Review.new("toaster", 1, "Terrible. Arrived broken and support was no help. Extremely disappointed."),
    Review.new("toaster", 3, "It is fine. Not great, not terrible."),
    Review.new("toaster", 5, "Excellent toast every time, I am very happy."),
    Review.new("blender", 4, "Good blender, never slow, a bit loud."),
    Review.new("blender", 2, "Cheap plastic, hardly sturdy, I hate the noise.")
  ]
end

def tokenize(text) = Array.reject(String.split(String.downcase(text), /[^a-z]+/)) { |w| String.empty?(w) }

def score_text(text)
  score = Score.new(0.0, 0, Array[])
  negate = false
  boost = 1.0
  Array.each(tokenize(text)) do |w|
    if Set.include?(negators, w)
      negate = true
      next
    end
    factor = intensifiers[w]
    if factor
      boost = factor
      next
    end
    base = lexicon[w]
    if base
      value = base * boost
      value = -value if negate
      Score.set_total(score, Score.total(score) + value)
      Score.set_hits(score, Score.hits(score) + 1)
      Array.push(Score.words(score), negate ? "not-#{w}" : w)
    end
    negate = false
    boost = 1.0
  end
  score
end

def label(total)
  if total >= 2.0
    "positive"
  elsif total <= -2.0
    "negative"
  else
    "neutral"
  end
end

def expected(stars)
  return "positive" if stars >= 4
  return "negative" if stars <= 2
  "neutral"
end

agree = 0
per_product = Hash[]
confusion = Hash.new(0)
Array.each(reviews) do |r|
  s = score_text(Review.text(r))
  total = Score.total(s)
  got = label(total)
  want = expected(Review.stars(r))
  agree += 1 if got == want
  confusion[[want, got]] += 1
  per_product[Review.product(r)] ||= Float[]
  Array.push(per_product[Review.product(r)], total)
  puts(format("%-8s %d* %6.2f %-8s %s", Review.product(r), Review.stars(r), total, got, Array.join(Score.words(s), " ")))
end
puts("agreement with stars: #{agree}/#{Array.size(reviews)}")

puts("confusion (expected -> predicted):")
Array.each(Array["positive", "neutral", "negative"]) do |want|
  cells = Array.map(Array["positive", "neutral", "negative"]) { |got| format("%3d", confusion[[want, got]]) }
  puts(format("  %-9s", want) + Array.join(cells))
end

puts("per product mean sentiment:")
ranking = Array.sort_by(Hash.to_a(per_product)) { |name, scores| -Array.sum(scores) / Array.size(scores) }
Array.each(ranking) do |name, scores|
  mean = Array.sum(scores) / Array.size(scores)
  puts(format("  %-8s %6.2f  (min %.2f, max %.2f)", name, mean, Array.min(scores), Array.max(scores)))
end

used = Hash.new(0)
Array.each(reviews) { |r| Array.each(tokenize(Review.text(r))) { |w| used[w] += 1 if Hash.key?(lexicon, w) } }
unused = Array.sort(Array.reject(Hash.keys(lexicon)) { |w| Hash.key?(used, w) })
puts("lexicon words never used: #{Array.join(unused, ", ")}")
