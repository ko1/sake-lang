require "rails/actionview/action_view/base"

view = ActionView::Base.empty
V = ActionView::Base

# truncate
p V.truncate(view, "Once upon a time in a world far far away")
p V.truncate(view, "Once upon a time in a world far far away", length: 17)
p V.truncate(view, "Once upon a time in a world far far away", length: 17, separator: " ")
p V.truncate(view, "And they found that many people were sleeping better.", length: 25, omission: "... (continued)")
p V.truncate(view, "<p>Once upon a time in a world far far away</p>")
p V.truncate(view, "<p>Once upon a time in a world far far away</p>", escape: false)
p V.truncate(view, "Once upon a time in a world far far away") { "!" }
p V.truncate(view, nil)
# highlight
p V.highlight(view, "You searched for: rails", "rails")
p V.highlight(view, "You searched for: rails", /for|rails/)
p V.highlight(view, "You searched for: ruby, rails, dhh", "actionpack")
p V.highlight(view, "You searched for: rails", Any["for", "rails"], highlighter: '<em>\1</em>')
p V.highlight(view, "You searched for: rails", "rails", highlighter: '<a href="search?q=\1">\1</a>')
p V.highlight(view, "You searched for: rails", "rails") { |match| "<b>#{match}</b>" }
p V.highlight(view, "<a href=\"javascript:alert('no!')\">ruby</a> on rails", "rails", sanitize: false)
p V.highlight(view, "<p>rails <script>x</script></p>", "rails")
p V.highlight(view, "", "rails")
# excerpt
p V.excerpt(view, "This is an example", "an", radius: 5)
p V.excerpt(view, "This is an example", "is", radius: 5)
p V.excerpt(view, "This is an example", "is")
p V.excerpt(view, "This next thing is an example", "ex", radius: 2)
p V.excerpt(view, "This is also an example", "an", radius: 8, omission: "<chop> ")
p V.excerpt(view, "This is a very beautiful morning", "very", separator: " ", radius: 1)
p V.excerpt(view, "This is a very beautiful morning", "nothing")
# pluralize
p V.pluralize(view, 1, "person")
p V.pluralize(view, 2, "person")
p V.pluralize(view, 3, "person", plural: "users")
p V.pluralize(view, 0, "person")
p V.pluralize(view, 1.0, "comment")
p V.pluralize(view, "1", "comment")
p V.pluralize(view, 2, "child", "kids")
p V.pluralize(view, nil, "post")
# word_wrap
p V.word_wrap(view, "Once upon a time")
p V.word_wrap(view, "Once upon a time", line_width: 8)
p V.word_wrap(view, "Once upon a time", line_width: 1)
p V.word_wrap(view, "Once upon a time", line_width: 1, break_sequence: "</br>")
p V.word_wrap(view, "")
# simple_format
p V.simple_format(view, "Here is some basic text...\n...with a line break.")
p V.simple_format(view, "We want to put a paragraph...\n\n...right there.")
p V.simple_format(view, "Look ma! A class!", Hash.of(class: "description"))
p V.simple_format(view, "<blink>Unblinkable.</blink>")
p V.simple_format(view, "<blink>Blinkable!</blink> It's true.", nil, sanitize: false)
p V.simple_format(view, "<a target=\"_blank\" href=\"http://example.com\">Continue</a>", nil, sanitize_options: Hash.of(attributes: String["target", "href"]))
p V.simple_format(view, "one\r\ntwo\r\n\r\nthree", nil, wrapper_tag: "div")
p V.simple_format(view, nil)
# cycle
r = String[]
Integer.times(4) { Array.push(r, V.cycle(view, "odd", "even")) }
p r
r = String[]
Integer.times(3) { Array.push(r, V.cycle(view, Any["a", "b", "c"], name: "letters")) }
p r
p V.current_cycle(view, "letters")
V.reset_cycle(view, "letters")
p V.cycle(view, Any["a", "b", "c"], name: "letters")
p V.cycle(view, 1, 2)
p V.current_cycle(view, "nope")
# concat / safe_concat
V.set_output_buffer(view, ActionView::OutputBuffer.make)
V.concat(view, "<b>x</b>")
V.safe_concat(view, "<i>y</i>")
p ActionView::OutputBuffer.to_s(V.output_buffer(view))
# javascript
p V.escape_javascript(view, "</script>\n'quotes' \"double\" `tick` $x \\  ")
p V.j(view, "ab")
p V.escape_javascript(view, nil)
p Object.html_safe?(V.escape_javascript(view, String.html_safe("<b>")))
p V.javascript_tag(view, "alert('All is good')")
p V.javascript_tag(view, "alert(1)", type: "module")
p V.javascript_tag(view, nonce: false) { "x = 1" }
p V.javascript_cdata_section(view, "y")
