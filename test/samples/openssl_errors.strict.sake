# Rejected before running: a Cipher is its own type, keys and data are Strings, digests are named by Strings.
c = OpenSSL::Cipher.new("aes-256-gcm")
OpenSSL::Cipher.update(c, 1)
OpenSSL::Cipher.set_key(c, :k)
OpenSSL::Cipher.encrypt("aes-256-gcm")
OpenSSL::HMAC.hexdigest(:sha256, "k", "d")
OpenSSL::KDF.pbkdf2_hmac("pw", salt: "s", iterations: "1", length: 16, hash: "sha1")
p(OpenSSL::Cipher.key_len(c) + "")
