# A mixin's function calls `request(j)` bare, a function the module does not declare but every includer
# defines (Ruby: a call on self). Without a top-level `request` this resolves to the includer's function (the
# mixin is copied into the includer). With a top-level `def request` of another arity anywhere in the program,
# the bare call resolves to the top-level one instead, and the program is rejected before running:
#   error: wrong number of arguments for request (given 1, expected 2)
# Expected: "cookie.a", as without the top-level function (the includer's function is the nearer name).
# Seen when a test program defined `def request(app, method, path, cookie)` and required middleware/cookies.sake.
module Jar
  def purpose(j) = "cookie.#{request(j)}"
end
class CookieJar
  attr_reader request
  include Jar
end
def request(a, b) = a + b
p(Jar.purpose(CookieJar.new("a")))
