def search(adj, pen, src)
  best = Hash[]
  Array.each(Hash.fetch(adj, src)) do |v, ln, m|
    key = [m, 0, Array[src, v], Array[ln]]
    k2 = [v, ln]
    cur = best[k2]
    if cur == nil || key < cur
      best[k2] = key
    end
  end
  changed = true
  while changed
    changed = false
    Array.each(Hash.keys(best)) do |sk|
      u, l = sk
      t, k, sts, lns = Hash.fetch(best, sk)
      Array.each(Hash.fetch(adj, u)) do |v, ln, m|
        diff = ln != l
        nt = t + m + (diff ? pen : 0)
        nk = k + (diff ? 1 : 0)
        key = [nt, nk, sts + Array[v], lns + Array[ln]]
        k2 = [v, ln]
        cur = best[k2]
        if cur == nil || key < cur
          best[k2] = key
          changed = true
        end
      end
    end
  end
  best
end

def route_line(sts, lns)
  legs = String[]
  curline = lns[0]
  curst = Array[sts[0]]
  Integer.times(Array.size(lns)) do |i|
    if lns[i] != curline
      Array.push(legs, "#{curline}: #{Array.join(curst, " > ")}")
      curst = Array[sts[i]]
      curline = lns[i]
    end
    Array.push(curst, sts[i + 1])
  end
  Array.push(legs, "#{curline}: #{Array.join(curst, " > ")}")
  "  " + Array.join(legs, "; ")
end

lines = IO.readlines(IO.stdin)
pen = 0
havep = false
inq = false
adj = Hash[]

Array.each_with_index(lines) do |raw, idx|
  no = idx + 1
  line = String.strip(raw)
  next if String.empty?(line)
  if !havep
    pen = String.to_i(line)
    havep = true
    next
  end
  f = String.split(line, " ")
  if inq
    if Array.size(f) != 2
      puts("invalid query at line #{no}")
      next
    end
    src, dst = f
    if !Hash.key?(adj, src)
      puts("#{src} -> #{dst}: unknown station #{src}")
    elsif !Hash.key?(adj, dst)
      puts("#{src} -> #{dst}: unknown station #{dst}")
    elsif src == dst
      puts("#{src} -> #{dst}: 0 min, 0 transfers")
    else
      best = search(adj, pen, src)
      found = nil
      Hash.each(best) do |sk, key|
        u, l = sk
        if u == dst
          found = key if found == nil || key < found
        end
      end
      if found == nil
        puts("#{src} -> #{dst}: no route")
      else
        t, k, sts, lns = found
        puts("#{src} -> #{dst}: #{t} min, #{k} #{k == 1 ? "transfer" : "transfers"}")
        puts(route_line(sts, lns))
      end
    end
  elsif line == "QUERIES"
    inq = true
  else
    if Array.size(f) == 4 && String.match?(f[3], /\A[1-9]\d{0,2}\z/) && f[1] != f[2]
      ln, a, b, ms = f
      m = String.to_i(ms)
      adj[a] = Array[] unless Hash.key?(adj, a)
      adj[b] = Array[] unless Hash.key?(adj, b)
      Array.push(adj[a], [b, ln, m])
      Array.push(adj[b], [a, ln, m])
    else
      puts("invalid segment at line #{no}")
    end
  end
end
