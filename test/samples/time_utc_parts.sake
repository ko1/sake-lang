# Time.utc(year, month, day, hour, min, sec) and Time.gm make a time in UTC; Time.utc(t) is Ruby's t.getutc.
p Time.utc(2026, 10, 13, 9, 30, 15)
p Time.gm(2000, 1, 2, 3, 4, 5.5)
p Time.utc(2026)
p Time.utc(Time.at(0, in: "+09:00"))
p Time.year(Time.utc(2026, 10)) + 1
begin
  Time.utc(2026, 13)
rescue ArgumentError => e
  puts Exception.message(e)
end
begin
  Time.utc(Time.at(0), 1)
rescue ArgumentError => e
  puts Exception.message(e)
end
