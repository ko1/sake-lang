# Regression: an unqualified call inside a class that falls through to Kernel
# (no top-level functions exist) used to crash the resolver.
Counter = Struct.new(:n)
class Counter
  def bump(c) = set_n(c, get_n(c) + 1)
  def show(c) = puts(get_n(c))
end
c = Counter.new(0)
Counter.bump(c)
Counter.show(c)
