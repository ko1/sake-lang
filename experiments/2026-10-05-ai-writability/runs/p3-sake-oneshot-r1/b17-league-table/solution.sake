class Team
  attr_reader name, played, won, drawn, lost, gf, ga
  def record(t, sf, sa)
    @played += 1
    @gf += sf
    @ga += sa
    if sf > sa
      @won += 1
    elsif sf == sa
      @drawn += 1
    else
      @lost += 1
    end
  end
  def pts(t) = 3 * @won + @drawn
  def gd(t) = @gf - @ga
end

class Game
  attr_reader home, away, hg, ag
end

def name?(s) = String.match?(s, /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/)

def team_of(teams, nm)
  tm = teams[nm]
  return tm if tm
  tm = Team.new(nm, 0, 0, 0, 0, 0, 0)
  teams[nm] = tm
  tm
end

def earned(g, nm)
  hg = Game.hg(g)
  ag = Game.ag(g)
  if Game.home(g) == nm
    hg > ag ? 3 : (hg == ag ? 1 : 0)
  elsif Game.away(g) == nm
    ag > hg ? 3 : (hg == ag ? 1 : 0)
  else
    0
  end
end

def key3(x) = [Team.pts(x), Team.gd(x), Team.gf(x)]

def h2h(teams, games, x)
  sum = 0
  kx = key3(x)
  nm = Team.name(x)
  Array.each(games) do |g|
    hn = Game.home(g)
    an = Game.away(g)
    opp = nil
    opp = an if hn == nm
    opp = hn if an == nm
    if opp
      ot = teams[opp]
      sum += earned(g, nm) if key3(ot) == kx
    end
  end
  sum
end

def key4(x, hh) = [-Team.pts(x), -Team.gd(x), -Team.gf(x), -hh[Team.name(x)]]

def main
  lines = IO.readlines(IO.stdin)
  teams = Hash[]
  games = Game[]
  k = 0
  while k < Array.size(lines)
    raw = String.chomp(lines[k])
    k += 1
    toks = String.split(String.strip(raw), /\s+/)
    next if Array.empty?(toks)
    ok = Array.size(toks) == 3 && name?(toks[0]) && name?(toks[2]) && toks[0] != toks[2]
    played = false
    hg = 0
    ag = 0
    if ok
      sc = toks[1]
      if sc != "P-P"
        m = String.match(sc, /\A(\d{1,2})-(\d{1,2})\z/)
        if m
          hg = String.to_i(m[1])
          ag = String.to_i(m[2])
          played = true
        else
          ok = false
        end
      end
    end
    if ok
      home = team_of(teams, toks[0])
      away = team_of(teams, toks[2])
      if played
        Team.record(home, hg, ag)
        Team.record(away, ag, hg)
        Array.push(games, Game.new(toks[0], toks[2], hg, ag))
      end
    else
      puts("invalid line #{k}: #{raw}")
    end
  end

  if Hash.empty?(teams)
    puts("no teams")
    return
  end

  list = Hash.values(teams)
  hh = Hash[]
  Array.each(list) { |x| hh[Team.name(x)] = h2h(teams, games, x) }
  sorted = Array.sort_by(list) { |x| [-Team.pts(x), -Team.gd(x), -Team.gf(x), -hh[Team.name(x)], Team.name(x)] }

  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
  pos = 0
  i = 0
  while i < Array.size(sorted)
    x = sorted[i]
    if i == 0 || key4(x, hh) != key4(sorted[i - 1], hh)
      pos = i + 1
    end
    gd = Team.gd(x)
    gds = gd > 0 ? "+#{gd}" : "#{gd}"
    puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", pos, Team.name(x), Team.played(x), Team.won(x), Team.drawn(x), Team.lost(x), Team.gf(x), Team.ga(x), gds, Team.pts(x)))
    i += 1
  end
end

main()
