# A field whose name starts with `set_` is read by the checker as another field: `@set_cookies` is typed as
# `@cookies` (lib/sake/lower.rb field_name strips /\Aset_/ from the reader's name too, not only the writer's), so
# what goes into @set_cookies shows up in @cookies. Here: "String.size: argument 1 must be String, but can be
# Hash@L17[:value => String]". Ruby (and Sake's run) read the field itself: this prints 1.
# Not caused by 04cea37b; seen in ActionDispatch::Cookies::CookieJar (Rails' @set_cookies, beside @cookies), whose
# cookie values then were "String | the options Hash" in MessageVerifier#extract_encoded / MessageEncryptor once the
# checker got past the signed jar's construction. Workaround: the port names the field cookies_to_set.
class Jar
  attr_reader set_cookies, cookies
  def get(jar, name) = @cookies[name]
  def set(jar, name, opts)
    @cookies[name] = "s"
    @set_cookies[name] = opts
  end
end
jar = Jar.new(Hash.new, Hash.new)
Jar.set(jar, "a", Hash.of(value: "x"))
v = Jar.get(jar, "a")
p(String.size(v)) if v
