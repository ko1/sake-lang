module Arel
  module Nodes
    class DeleteStatement
      attr_accessor relation, wheres, groups, havings, orders, limit, offset, comment, key
      include Node
      def initialize(o)
        @wheres ||= Any[]
        @groups ||= Any[]
        @havings ||= Any[]
        @orders ||= Any[]
      end
    end
  end
end
