module Sql
  class Blob
    HEX_DIGITS: Regexp

    attr_reader bytes: String

    def self.from_hex: (String digits) -> Blob?
    def initialize: (String bytes) -> void
    def size: () -> Integer
    def hex: () -> String
    def text: () -> String
    def <=>: (Blob other) -> Integer
    def eql?: (Object other) -> bool
    def ==: (Object other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end
end
