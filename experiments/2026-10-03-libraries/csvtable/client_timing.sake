# Stress: where the time goes for a 2000-row file (parse vs convert vs render).

def line(i) = "#{i},\"name #{i}, x\",#{i * 7 % 100},#{i % 13}.5\n"

def build(n)
  parts = String[]
  Array.push(parts, "id,name,qty,price\n")
  Integer.times(n) { |i| Array.push(parts, line(i)) }
  Array.join(parts, "")
end

def seconds_since(t0) = Float.round(Time.to_f(Time.now) - Time.to_f(t0), 2)

text = build(2000)
t0 = Time.now
rows = Csv.parse(text)
puts("Csv.parse      #{Array.size(rows)} rows: #{seconds_since(t0)}s")
t0 = Time.now
t = Table.from_csv(text)
puts("Table.from_csv  #{Table.size(t)} rows: #{seconds_since(t0)}s")
t0 = Time.now
Array.each(Array["id", "qty", "price"]) { |c| Table.map_column!(t, c) { |s| (s in String) ? Num.parse(s) : s } }
puts("convert 3 columns: #{seconds_since(t0)}s")
t0 = Time.now
s = Table.render(t)
puts("render #{String.size(s)} chars: #{seconds_since(t0)}s")
t0 = Time.now
c = Table.to_csv(t)
puts("to_csv #{String.size(c)} chars: #{seconds_since(t0)}s")
