require "securerandom"

def show(label, v) = puts("#{label}: #{v}")

# hex: 2n lowercase hex digits
Array.each(Array[nil, 0, 1, 8, 32]) do |n|
  h = n == nil ? SecureRandom.hex : SecureRandom.hex(n)
  show("hex(#{Kernel.inspect(n)})", "#{String.size(h)} #{String.match?(h, /\A[0-9a-f]*\z/)}")
end

# random_bytes: binary, n bytes
b = SecureRandom.random_bytes
show("random_bytes", "#{String.bytesize(b)} #{String.encoding(b)}")
show("random_bytes(5)", String.bytesize(SecureRandom.random_bytes(5)))
show("bytes(300)", String.bytesize(SecureRandom.bytes(300)))

# base64 / urlsafe_base64
show("base64", "#{String.size(SecureRandom.base64)} #{String.match?(SecureRandom.base64(4), /\A[A-Za-z0-9+\/]{6}==\z/)}")
show("urlsafe_base64", "#{String.size(SecureRandom.urlsafe_base64)} #{String.match?(SecureRandom.urlsafe_base64(30), /\A[A-Za-z0-9_-]{40}\z/)}")
show("urlsafe_base64 padding", String.match?(SecureRandom.urlsafe_base64(4, true), /\A[A-Za-z0-9_-]{6}==\z/))

# uuid: version 4, variant 10xx
uuid_re = /\A[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\z/
ok = Range.all?(1..200) { String.match?(SecureRandom.uuid, uuid_re) }
show("uuid", "#{String.size(SecureRandom.uuid)} #{ok}")
show("uuid_v4", String.match?(SecureRandom.uuid_v4, uuid_re))
show("uuids differ", SecureRandom.uuid != SecureRandom.uuid)
v7 = SecureRandom.uuid_v7
show("uuid_v7", String.match?(v7, /\A[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\z/))
ms = String.hex(String.delete(v7, "-")[0, 12] || "")
show("uuid_v7 time", Integer.abs(ms - Arithmetic.to_i(Time.to_f(Time.now) * 1000)) < 10000)

# random_number: ranges of each form, over many draws
ints = Range.map(1..2000) { SecureRandom.random_number(6) }
show("random_number(6)", "#{Array.all?(ints) { |x| x in Integer }} #{Array.sort(Array.uniq(ints))}")
show("random_number(1)", Array.uniq(Range.map(1..20) { SecureRandom.random_number(1) }))
big = SecureRandom.random_number(2 ** 100)
show("random_number(2**100)", (big in Integer) && big >= 0 && big < 2 ** 100)
fs = Range.map(1..500) { SecureRandom.random_number }
show("random_number", Array.all?(fs) { |x| (x in Float) && x >= 0.0 && x < 1.0 })
fs = Range.map(1..500) { SecureRandom.random_number(2.5) }
show("random_number(2.5)", Array.all?(fs) { |x| (x in Float) && x >= 0.0 && x < 2.5 })
Array.each(Array[0, -3, 0.0, -1.5]) do |n|
  x = SecureRandom.random_number(n)
  show("random_number(#{n})", (x in Float) && x >= 0.0 && x < 1.0)
end
rs = Range.map(1..2000) { SecureRandom.random_number(10..12) }
show("random_number(10..12)", Array.sort(Array.uniq(rs)))
rs = Range.map(1..2000) { SecureRandom.random_number(10...12) }
show("random_number(10...12)", Array.sort(Array.uniq(rs)))
show("random_number(2..2)", SecureRandom.random_number(2..2))
e = SecureRandom.random_number(5..1)
show("random_number(5..1)", (e in Float) && e < 1.0)
fr = Range.map(1..500) { SecureRandom.random_number(2.0..3.0) }
show("random_number(2.0..3.0)", Array.all?(fr) { |x| (x in Float) && x >= 2.0 && x <= 3.0 })
show("rand(3)", SecureRandom.rand(3) < 3)

# alphanumeric
a = SecureRandom.alphanumeric
show("alphanumeric", "#{String.size(a)} #{String.match?(a, /\A[A-Za-z0-9]+\z/)}")
show("alphanumeric(40)", String.match?(SecureRandom.alphanumeric(40), /\A[A-Za-z0-9]{40}\z/))
show("alphanumeric(0)", Kernel.inspect(SecureRandom.alphanumeric(0)))
abc = SecureRandom.alphanumeric(200, chars: Array["a", "b", "c"])
show("alphanumeric chars", Array.sort(Array.uniq(String.chars(abc))))
all = String.chars(Range.map(1..50) { SecureRandom.alphanumeric(100) }.Array.join)
show("alphabet", Set.size(Set[*all]) > 55)

# errors
begin
  SecureRandom.hex(-1)
rescue ArgumentError => e
  show("hex(-1)", Exception.message(e))
end
begin
  SecureRandom.random_bytes(-5)
rescue ArgumentError => e
  show("random_bytes(-5)", Exception.message(e))
end
