# Status (2026-10-04): fixed.
# Friction/bug: passing `&b` on to a function that checks block_given? still makes the caller need a block,
# and the error says "info uses `yield`" though info has no yield. Ruby prints "plain".
# Workaround in logger.sake: def info2(msg = nil, &b) = block_given? ? add(msg, &b) : add(msg)
def add(msg = nil)
  msg = yield if block_given?
  puts(msg)
end
def info(msg = nil, &b) = add(msg, &b)
info("plain")
