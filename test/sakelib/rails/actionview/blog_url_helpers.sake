# The generator of the blog's named route helpers: `generate "blog_url_helpers", "BlogUrlHelpers"` (run alone, it prints them)
require "fixtures/blog_routes"
require "rails/actionpack/action_dispatch/routing/generate/url_helpers"

print(ActionDispatch::Routing::Generate.url_helpers(blog_route_set, Array.first(ARGV) || "BlogUrlHelpers"))
