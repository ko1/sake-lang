module Sql
  module Ast
    class Expr
    end

    class Literal < Expr
      attr_reader value: value

      def initialize: (value value) -> void
    end

    class ColumnRef < Expr
      attr_reader name: String

      def initialize: (String name) -> void
    end

    class ResolvedColumn < Expr
      attr_reader index: Integer
      attr_reader type: column_type

      def initialize: (Integer index, column_type type) -> void
    end

    class Unary < Expr
      attr_reader op: String
      attr_reader operand: Expr

      def initialize: (String op, Expr operand) -> void
    end

    class Binary < Expr
      attr_reader op: String
      attr_reader left: Expr
      attr_reader right: Expr

      def initialize: (String op, Expr left, Expr right) -> void
    end

    class Is < Expr
      attr_reader left: Expr
      attr_reader right: Expr
      attr_reader negated: bool

      def initialize: (Expr left, Expr right, bool negated) -> void
    end

    class FunctionCall < Expr
      attr_reader name: String
      attr_reader args: Array[Expr]

      def initialize: (String name, Array[Expr] args) -> void
    end

    class Statement
    end

    class ColumnDef
      attr_reader name: String
      attr_reader type: column_type

      def initialize: (String name, column_type type) -> void
    end

    class CreateTable < Statement
      attr_reader name: String
      attr_reader columns: Array[ColumnDef]
      attr_reader if_not_exists: bool

      def initialize: (String name, Array[ColumnDef] columns, bool if_not_exists) -> void
    end

    class DropTable < Statement
      attr_reader name: String
      attr_reader if_exists: bool

      def initialize: (String name, bool if_exists) -> void
    end

    class Insert < Statement
      attr_reader table: String
      attr_reader columns: Array[String]?
      attr_reader rows: Array[Array[Expr]]

      def initialize: (String table, Array[String]? columns, Array[Array[Expr]] rows) -> void
    end

    class SelectItem
      attr_reader expr: Expr?
      attr_reader alias_name: String?

      def initialize: (Expr? expr, String? alias_name) -> void
    end

    class OrderTerm
      attr_reader expr: Expr
      attr_reader descending: bool
      attr_reader nulls_first: bool?

      def initialize: (Expr expr, bool descending, bool? nulls_first) -> void
    end

    class Select < Statement
      attr_reader items: Array[SelectItem]
      attr_reader table: String?
      attr_reader where: Expr?
      attr_reader order_by: Array[OrderTerm]
      attr_reader limit: Expr?
      attr_reader offset: Expr?

      def initialize: (Array[SelectItem] items, String? table, Expr? where, Array[OrderTerm] order_by, Expr? limit, Expr? offset) -> void
    end
  end
end
