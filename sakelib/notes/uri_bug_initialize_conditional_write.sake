# A field that initialize writes only on some paths is typed as the written values only:
# --types gives C.s: Integer (the "x" from C.new("x") is lost); in uri.sake, URI.scheme shows String, not nil | String.
# Expected: C.s: Integer | String, and a report at line 12 for String (and Integer).
class C
  attr_reader s
  def initialize(c)
    @s = 1 if @s == nil
  end
end
c = C.new("x")
d = C.new(nil)
p(String.size(C.s(c)))
