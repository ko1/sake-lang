class Player
  attr_reader name, index
  attr_accessor left, turns, darts
end

def mult(c)
  return 3 if c == "T"
  return 2 if c == "D"
  1
end

# [points, double?] or nil for a bad token
def dart_value(tok)
  return [0, false] if tok == "MISS"
  return [25, false] if tok == "25"
  return [50, true] if tok == "BULL"
  m = String.match(tok, /\A([SDT])([1-9]|1[0-9]|20)\z/)
  return nil unless m
  c = m[1]
  d = m[2]
  return nil unless c && d
  [mult(c) * String.to_i(d), c == "D"]
end

def valid_header?(words)
  return false unless Array.size(words) >= 2 && Array.size(words) <= 5
  first = Array.fetch(words, 0)
  return false unless String.match?(first, /\A\d+\z/)
  start = String.to_i(first)
  return false unless start >= 2 && start <= 1001
  names = Array.drop(words, 1)
  Array.all?(names) { |n| String.match?(n, /\A[a-z]{1,10}\z/) } && Array.size(Array.uniq(names)) == Array.size(names)
end

def main
  lines = String.split(IO.read(IO.stdin), "\n")
  header = String.split(Array.fetch(lines, 0, ""), " ")
  unless valid_header?(header)
    puts("invalid header")
    return
  end
  start = String.to_i(Array.fetch(header, 0))
  players = Hash[]
  Array.each_with_index(Array.drop(header, 1)) { |n, i| players[n] = Player.new(n, i, start, 0, 0) }
  winner = nil

  Array.each_with_index(lines) do |line, i|
    next if i == 0
    words = String.split(line, " ")
    next if Array.empty?(words)
    no = i + 1
    if winner
      puts("line #{no}: game over")
      next
    end
    who = Array.fetch(words, 0)
    pl = players[who]
    unless pl
      puts("line #{no}: unknown player #{who}")
      next
    end
    darts = Array.drop(words, 1)
    unless Array.size(darts) >= 1 && Array.size(darts) <= 3
      puts("line #{no}: expected 1 to 3 darts")
      next
    end
    bad = Array.find(darts) { |d| dart_value(d) == nil }
    if bad
      puts("line #{no}: bad dart #{bad}")
      next
    end
    Player.set_turns(pl, Player.turns(pl) + 1)
    rem = Player.left(pl)
    result = "open"
    kind = :open
    Array.each(darts) do |d|
      v = dart_value(d)
      next unless v
      pts, dbl = v
      Player.set_darts(pl, Player.darts(pl) + 1)
      rem -= pts
      if rem < 0 || (rem == 0 && !dbl)
        kind = :bust
        break
      elsif rem == 0
        kind = :out
        result = d
        break
      end
    end
    case kind
    in :bust
      puts("#{Player.name(pl)} busts, #{Player.left(pl)} left")
    in :open
      puts("#{Player.name(pl)} scores #{Player.left(pl) - rem}, #{rem} left")
      Player.set_left(pl, rem)
    in :out
      Player.set_left(pl, 0)
      winner = pl
      puts("#{Player.name(pl)} checks out with #{result}")
    end
  end

  puts("STANDINGS")
  ranked = Array.sort_by(Hash.values(players)) { |pl| [Player.left(pl), Player.index(pl)] }
  Array.each_with_index(ranked) do |pl, r|
    darts = Player.darts(pl)
    avg = darts > 0 ? format("%.2f", (start - Player.left(pl)) * 3.0 / darts) : "-"
    puts(format("%d. %-10s %4d %3d %6s", r + 1, Player.name(pl), Player.left(pl), Player.turns(pl), avg))
  end
  if winner
    puts("winner: #{Player.name(winner)}")
  else
    puts("no winner")
  end
end

main
