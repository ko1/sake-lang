# BLOB values (CHANGE 7): a string of bytes. A Blob keeps its bytes as uppercase hexadecimal, two digits
# per byte, so two Blobs are equal exactly when their `hex` are, and comparing the `hex` strings compares
# the bytes as unsigned numbers (the digits 0-9 sort before A-F, and every byte is two digits).
class Blob
  attr_reader hex

  # Is `digits` a whole number of bytes of hexadecimal digits (the inside of X'...')?
  def hex_digits?(digits) = Integer.even?(String.size(digits)) && String.match?(digits, /\A[0-9A-Fa-f]*\z/)

  # The Blob of the bytes of a TEXT.
  def from_text(s) = Blob.new(Array.join(Array.map(String.bytes(s)) { format("%02X", it) }, ""))

  # The text form of a Blob: its bytes read as characters.
  def text(b) = Array.join(Array.map(String.scan(@hex, /../)) { Integer.chr(String.hex(it)) }, "")

  # The number of bytes.
  def size(b) = String.size(@hex) / 2

  # `count` bytes from byte `first` (0-based, inside the Blob).
  def slice(b, first, count) = Blob.new(String.slice(@hex, 2 * first, 2 * count))

  # The 1-based byte position of the first occurrence of the bytes of `target` in `b`, or 0.
  def index(b, target)
    last = Blob.size(b) - Blob.size(target)
    i = 0
    while i <= last
      return i + 1 if String.slice(@hex, 2 * i, String.size(Blob.hex(target))) == Blob.hex(target)
      i += 1
    end
    0
  end
end
