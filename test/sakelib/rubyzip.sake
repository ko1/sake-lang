require "rubyzip"
require "base64"

def t0 = Time.new(2024, 7, 1, 13, 5, 8)

def show(e)
  data = Zip::Entry.directory?(e) ? "" : Zip::Entry.data(e)
  shown = String.bytesize(data) > 40 ? "bytes=#{String.bytesize(data)}" : "data=#{Kernel.inspect(data)}"
  puts "#{Zip::Entry.name(e)}: size=#{Zip::Entry.size(e)} compressed=#{Zip::Entry.compressed_size(e)} method=#{Zip::Entry.compression_method(e)} crc=#{Integer.to_s(Zip::Entry.crc(e), 16)} time=#{Time.strftime(Zip::Entry.time(e), "%Y-%m-%d %H:%M:%S")} dir=#{Zip::Entry.directory?(e)} ftype=#{Zip::Entry.ftype(e)} #{shown}"
end

# An archive written by rubyzip 3.4.1 (zip64 extra fields, UTF-8 name, archive comment).
def fixture = ""

puts "-- an archive written by rubyzip"
entries = Zip.parse(Base64.decode64(fixture))
Array.each(entries) { |e| show(e) }
puts Array.join(Zip.names(entries), " ")
p Zip.entry_data(entries, "s.txt")
e = Zip.find_entry(entries, "dir/x.bin")
puts e == nil ? "none" : "found #{Zip::Entry.name(e)}"
p Zip.find_entry(entries, "nope")
puts Array.join(Zip.names(Zip.glob(entries, "dir/*")), " ")
puts Array.join(Zip.names(Zip.glob(entries, "*.txt")), " ")
puts Array.join(Zip.names(Zip.glob(entries, "**/*.bin")), " ")
p Array.size(entries)

puts "-- round trip through a file"
Dir.mktmpdir do |d|
  path = File.join(d, "a.zip")
  written = Zip::Entry[]
  Zip.add(written, "hello.txt", "hello hello hello hello", time: t0)
  Zip.add(written, "s.txt", "plain", compression_method: 0, time: t0)
  Zip.mkdir(written, "dir", time: t0)
  Zip.add(written, "dir/x.bin", String.b("\x00\x01\x02"), time: t0)
  Zip.add(written, "big.txt", "abc " * 1000, time: t0)
  Zip.add(written, "日本語.txt", "nihongo", time: t0)
  Zip.add(written, "empty.txt", "", time: t0)
  Zip.write(path, written)
  read = Zip.read(path)
  Array.each(read) { |e| show(e) }
  puts Array.join(Zip.names(read), " ")
  p Zip.entry_data(read, "s.txt")
  p Zip.entry_data(read, "big.txt") == "abc " * 1000
  p Array.size(read)

  puts "-- extract"
  out = File.join(d, "out")
  Dir.mkdir(out)
  Zip.extract(read, out)
  p Array.sort(Dir.glob("**/*", base: out))
  p File.read(File.join(out, "hello.txt"))
  p File.read(File.join(out, "dir/x.bin")) == String.b("\x00\x01\x02")

  puts "-- errors"
  begin
    Zip.entry_data(read, "nope")
  rescue Zip::Error => e
    puts Exception.message(e)
  end
end
begin
  Zip.parse("garbage")
rescue Zip::Error => e
  puts Exception.message(e)
end
