Match = Struct.new(:home, :away, :hgoals, :agoals, :postponed)

def valid_team_name(name)
  if String.empty?(name) || String.size(name) > 12
    return false
  end

  c = String.at(name, 0)
  if !String.match(c, /[A-Za-z]/)
    return false
  end

  String.size(name).times do |i|
    c = String.at(name, i)
    if !String.match(c, /[A-Za-z0-9_]/)
      return false
    end
  end
  true
end

def parse_score(score_str)
  if score_str == "P-P"
    return Array[nil, nil, true]
  end

  parts = String.split(score_str, "-")
  if Array.size(parts) != 2
    return nil
  end

  h_str = Array.at(parts, 0)
  a_str = Array.at(parts, 1)

  if String.empty?(h_str) || String.empty?(a_str)
    return nil
  end

  if !String.match(h_str, /^\d{1,2}$/) || !String.match(a_str, /^\d{1,2}$/)
    return nil
  end

  Array[String.to_i(h_str), String.to_i(a_str), false]
end

def main
  matches = Array[]
  team_names = Set[]
  errors = Array[]
  line_num = 1

  loop do
    line = gets
    break if line == nil

    line_clean = String.strip(line)
    if String.empty?(line_clean)
      line_num += 1
      next
    end

    tokens = String.split(line_clean, /\s+/)
    if Array.size(tokens) != 3
      Array.push(errors, Array[line_num, line_clean])
      line_num += 1
      next
    end

    home = Array.at(tokens, 0)
    score_str = Array.at(tokens, 1)
    away = Array.at(tokens, 2)

    valid = valid_team_name(home) && valid_team_name(away) && home != away
    unless valid
      Array.push(errors, Array[line_num, line_clean])
      line_num += 1
      next
    end

    score_data = parse_score(score_str)
    unless score_data
      Array.push(errors, Array[line_num, line_clean])
      line_num += 1
      next
    end

    h_goals = Array.at(score_data, 0)
    a_goals = Array.at(score_data, 1)
    postponed = Array.at(score_data, 2)

    Array.push(matches, Match.new(home, away, h_goals, a_goals, postponed))
    Set.add(team_names, home)
    Set.add(team_names, away)

    line_num += 1
  end

  Array.each(errors) { |e| puts("invalid line #{Array.at(e, 0)}: #{Array.at(e, 1)}") }

  if Set.empty?(team_names)
    puts("no teams")
    return
  end

  # Initialize teams stats
  teams = Hash[]
  Set.each(team_names) do |name|
    teams = Hash.merge(teams, Hash[name, Array[0, 0, 0, 0, 0, 0, 0]])
  end

  # Process matches
  Array.each(matches) do |m|
    unless Match.postponed(m)
      home = Match.home(m)
      away = Match.away(m)
      hg = Match.hgoals(m)
      ag = Match.agoals(m)

      h_stats = Hash[](teams, home)
      a_stats = Hash[](teams, away)

      h_w = hg > ag ? 1 : 0
      h_d = hg == ag ? 1 : 0
      h_l = hg < ag ? 1 : 0
      a_w = ag > hg ? 1 : 0
      a_d = ag == hg ? 1 : 0
      a_l = ag < hg ? 1 : 0
      h_pts = (hg > ag ? 3 : 0) + (hg == ag ? 1 : 0)
      a_pts = (ag > hg ? 3 : 0) + (ag == hg ? 1 : 0)

      new_h = Array[
        Array.at(h_stats, 0) + 1,
        Array.at(h_stats, 1) + h_w,
        Array.at(h_stats, 2) + h_d,
        Array.at(h_stats, 3) + h_l,
        Array.at(h_stats, 4) + hg,
        Array.at(h_stats, 5) + ag,
        Array.at(h_stats, 6) + h_pts
      ]

      new_a = Array[
        Array.at(a_stats, 0) + 1,
        Array.at(a_stats, 1) + a_w,
        Array.at(a_stats, 2) + a_d,
        Array.at(a_stats, 3) + a_l,
        Array.at(a_stats, 4) + ag,
        Array.at(a_stats, 5) + hg,
        Array.at(a_stats, 6) + a_pts
      ]

      teams = Hash.merge(teams, Hash[home, new_h])
      teams = Hash.merge(teams, Hash[away, new_a])
    end
  end

  # Build team list
  team_list = Array[]
  Hash.each(teams) do |name, stats|
    gf = Array.at(stats, 4)
    ga = Array.at(stats, 5)
    gd = gf - ga
    pts = Array.at(stats, 6)
    Array.push(team_list, Array[name, stats, gd, pts])
  end

  sorted = Array.sort_by(team_list) do |t|
    name = Array.at(t, 0)
    pts = Array.at(t, 3)
    gd = Array.at(t, 2)
    stats = Array.at(t, 1)
    gf = Array.at(stats, 4)
    [-pts, -gd, -gf, name]
  end

  # Output
  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))

  pos = 1
  prev_pts = nil
  prev_gd = nil
  prev_gf = nil

  Array.each_with_index(sorted) do |t, idx|
    name = Array.at(t, 0)
    stats = Array.at(t, 1)
    gd = Array.at(t, 2)
    pts = Array.at(t, 3)

    p_played = Array.at(stats, 0)
    won = Array.at(stats, 1)
    drawn = Array.at(stats, 2)
    lost = Array.at(stats, 3)
    gf = Array.at(stats, 4)
    ga = Array.at(stats, 5)

    if prev_pts != pts || prev_gd != gd || prev_gf != gf
      pos = idx + 1
    end
    prev_pts = pts
    prev_gd = gd
    prev_gf = gf

    gd_str = gd > 0 ? "+#{gd}" : "#{gd}"

    puts(format("%3d %-12s%3d%3d%3d%3d%4d%4d%4s%4d", pos, name, p_played, won, drawn, lost, gf, ga, gd_str, pts))
  end
end

main
