def words_of(line)
  Array.reject(String.split(line, /[ \t]+/)) { String.empty?(it) }
end

def justify(ws, w)
  return Array.join(ws, " ") if Array.size(ws) == 1
  k = Array.size(ws) - 1
  letters = Array.sum(Array.map(ws) { String.size(it) })
  extra = w - letters
  base = extra / k
  rem = extra % k
  out = ""
  Array.each_with_index(ws) do |x, i|
    out += x
    if i < k
      out += " " * (base + (i < rem ? 1 : 0))
    end
  end
  out
end

def layout(words, w)
  pieces = String[]
  Array.each(words) do |x|
    rest = x
    while String.size(rest) > w
      Array.push(pieces, String.slice(rest, 0, w - 1) + "-")
      rest = String.slice(rest, w - 1, String.size(rest) - (w - 1))
    end
    Array.push(pieces, rest)
  end
  lines = Array[]
  cur = String[]
  curlen = 0
  Array.each(pieces) do |x|
    if Array.empty?(cur)
      Array.push(cur, x)
      curlen = String.size(x)
    elsif curlen + 1 + String.size(x) <= w
      Array.push(cur, x)
      curlen += 1 + String.size(x)
    else
      Array.push(lines, cur)
      cur = String[]
      Array.push(cur, x)
      curlen = String.size(x)
    end
  end
  Array.push(lines, cur) unless Array.empty?(cur)
  res = String[]
  Array.each_with_index(lines) do |ln, i|
    if i < Array.size(lines) - 1
      Array.push(res, justify(ln, w))
    else
      Array.push(res, Array.join(ln, " "))
    end
  end
  res
end

all = IO.readlines(IO.stdin)
if Array.empty?(all)
  puts("invalid width")
  exit
end
m = String.match(String.chomp(all[0]), /\A *(\d+) *\z/)
if m == nil
  puts("invalid width")
  exit
end
w = String.to_i(MatchData.captures(m)[0])
if w < 2 || w > 80
  puts("invalid width")
  exit
end

paras = Array[]
cur = String[]
total_words = 0
Array.each(Array.drop(all, 1)) do |raw|
  ws = words_of(String.chomp(raw))
  if Array.empty?(ws)
    unless Array.empty?(cur)
      Array.push(paras, cur)
      cur = String[]
    end
  else
    total_words += Array.size(ws)
    Array.concat(cur, ws)
  end
end
Array.push(paras, cur) unless Array.empty?(cur)

border = "+" + "-" * w + "+"
puts(border)
nlines = 0
Array.each_with_index(paras) do |pw, i|
  puts("|" + " " * w + "|") if i > 0
  Array.each(layout(pw, w)) do |l|
    puts("|" + String.ljust(l, w) + "|")
    nlines += 1
  end
end
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{total_words}")
