# Caesar cipher with ROT13 and a frequency-based cracker.

def english_freq = once do
  Hash["a" => 8.2, "b" => 1.5, "c" => 2.8, "d" => 4.3, "e" => 12.7, "f" => 2.2,
       "g" => 2.0, "h" => 6.1, "i" => 7.0, "j" => 0.15, "k" => 0.77, "l" => 4.0,
       "m" => 2.4, "n" => 6.7, "o" => 7.5, "p" => 1.9, "q" => 0.095, "r" => 6.0,
       "s" => 6.3, "t" => 9.1, "u" => 2.8, "v" => 0.98, "w" => 2.4, "x" => 0.15,
       "y" => 2.0, "z" => 0.074]
end

def shift_char(c, k)
  o = String.ord(c)
  if o >= 65 && o <= 90
    Integer.chr((o - 65 + k) % 26 + 65)
  elsif o >= 97 && o <= 122
    Integer.chr((o - 97 + k) % 26 + 97)
  else
    c
  end
end

def encrypt(text, k) = Array.join(Array.map(String.chars(text)) { |c| shift_char(c, k) }, "")

def decrypt(text, k) = encrypt(text, 26 - k % 26)

def rot13(text) = encrypt(text, 13)

def letter_counts(text)
  counts = Hash.new(0)
  String.each_char(String.downcase(text)) do |c|
    counts[c] += 1 if String.match?(c, /[a-z]/)
  end
  counts
end

def chi_squared(text)
  counts = letter_counts(text)
  total = Hash.sum(counts) { |_, n| n }
  return 1.0e9 if total == 0
  freq = english_freq
  score = 0.0
  Hash.each(freq) do |letter, pct|
    expected = total * pct / 100.0
    observed = Hash.fetch(counts, letter, 0)
    diff = observed - expected
    score += diff * diff / expected
  end
  score
end

def crack(cipher)
  candidates = Range.map(0..25) do |k|
    plain = decrypt(cipher, k)
    {key: k, score: chi_squared(plain), plain: plain}
  end
  ranked = Array.sort_by(candidates) { |c| c => {score:}; score }
  Array.take(ranked, 3)
end

messages = Array[
  "Meet me at the old bridge after sunset",
  "The quick brown fox jumps over the lazy dog",
  "Attack at dawn, hold the northern ridge!",
  "Cryptography is the art of writing secret messages"
]
keys = Array[3, 11, 19, 7]

Array.each_with_index(messages) do |msg, i|
  k = keys[i]
  enc = encrypt(msg, k)
  puts("plain : #{msg}")
  puts("key #{k}: #{enc}")
  back = decrypt(enc, k)
  puts("roundtrip ok: #{back == msg}")
  top = crack(enc)
  Array.each(top) do |cand|
    cand => {key:, score:, plain:}
    puts(format("  guess k=%2d chi2=%9.2f %s", key, score, plain[0...30]))
  end
  best = Array.first(top)
  if best
    best => {key: guessed}
    puts("  cracked: #{guessed == k ? "yes" : "no"}")
  end
end

puts(rot13("Why did the chicken cross the road?"))
puts(rot13(rot13("Why did the chicken cross the road?")))
