2026-10-01       -> 2026-10-01  Thu  1 Oct 2026
1969-7-20        -> 1969-07-20  Sun 20 Jul 1969
02/29/2024       -> 2024-02-29  Thu 29 Feb 2024
02/29/2023       !! no such day ("02/29/2023")
31 Dec 1999      -> 1999-12-31  Fri 31 Dec 1999
4 July 1776      -> 1776-07-04  Thu  4 Jul 1776
13 Smarch 2020   !! unknown month 'Sma' ("13 Smarch 2020")
2000-13-01       !! no such day ("2000-13-01")
yesterday        !! unrecognized date format ("yesterday")
1 jan 2001       -> 2001-01-01  Mon  1 Jan 2001

pattern "%A, %B %o, %Y":
  Thursday, October 1st, 2026
  Sunday, July 20th, 1969
  Thursday, February 29th, 2024
pattern "day %j of %Y (%y)":
  day 274 of 2026 (26)
  day 201 of 1969 (69)
  day 060 of 2024 (24)
pattern "100%% %q":
  100% %q
  100% %q
  100% %q

by weekday: Sunday=1, Monday=1, Thursday=3, Friday=1
