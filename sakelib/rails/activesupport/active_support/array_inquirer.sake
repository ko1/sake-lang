# Port of activesupport-8.1.3/lib/active_support/array_inquirer.rb and core_ext/array/inquiry.rb (two small files)
#
# Ruby: `variants.phone?` reaches method_missing, which is `any?(:phone)`. As StringInquirer: its body is `inquire`, taking
# the name, and generate/inquirers.sake writes `ArrayInquirer.phone?(variants)` for the names a program uses.

require "string_inquirer"

module ActiveSupport
  class ArrayInquirer
    attr_reader items

    # Ruby: any?(*candidates): a candidate matches as a Symbol or as a String; with none, Array#any?.
    def any?(ai, *candidates)
      return !Array.empty?(@items) if Array.empty?(candidates)
      Array.any?(candidates) do |candidate|
        sym = (candidate in Symbol) ? candidate : String.to_sym(Kernel.to_s(candidate))
        Array.include?(@items, sym) || Array.include?(@items, Symbol.to_s(sym))
      end
    end

    def inquire(ai, name)
      s = Symbol.to_s(name)
      raise NoMethodError, "undefined method '#{s}' for an instance of ActiveSupport::ArrayInquirer" unless String.end_with?(s, "?")
      any?(ai, String.delete_suffix(s, "?"))
    end

    def respond_to_missing?(ai, name) = Symbol.end_with?(name, "?")
    def to_a(ai) = @items
    def inspect(ai) = Kernel.inspect(@items)
    def to_s(ai) = Kernel.inspect(@items)
  end
end

class Array
  def inquiry(xs) = ActiveSupport::ArrayInquirer.new(xs)
end
