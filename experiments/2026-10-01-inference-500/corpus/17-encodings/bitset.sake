# A fixed-width bit set stored in one Integer, with indexing and the set operators,
# plus classic bit tricks: popcount, bit reversal, Gray code, and power-of-two rounding.

class BitSet < {reader: [width, bits]}
  include Indexable
  include Bitwise

  def [](s, i)
    raise IndexError, "bit #{i} outside width #{@width}" if i < 0 || i >= @width
    (@bits >> i) & 1 == 1
  end

  def []=(s, i, v)
    raise IndexError, "bit #{i} outside width #{@width}" if i < 0 || i >= @width
    @bits = v ? @bits | (1 << i) : @bits & (BitSet.full_mask(@width) ^ (1 << i))
  end

  def &(a, b) = BitSet.new(@width, @bits & BitSet.get_bits(b))
  def |(a, b) = BitSet.new(@width, @bits | BitSet.get_bits(b))
  def ^(a, b) = BitSet.new(@width, @bits ^ BitSet.get_bits(b))

  def full_mask(width) = (1 << width) - 1
  def complement(s) = BitSet.new(@width, @bits ^ full_mask(@width))
  def count(s) = popcount(@bits)
  def members(s) = Range.select(0...@width) { |i| (@bits >> i) & 1 == 1 }
  def to_s(s) = String.rjust(format("%b", @bits), @width, "0")

  def from_list(width, list)
    s = BitSet.new(width, 0)
    Array.each(list) { |i| s[i] = true }
    s
  end
end

def popcount(n)
  c = 0
  while n != 0
    n &= n - 1
    c += 1
  end
  c
end

def reverse_bits(n, width)
  r = 0
  Integer.times(width) do
    r = (r << 1) | (n & 1)
    n >>= 1
  end
  r
end

def gray(n) = n ^ (n >> 1)

def gray_decode(g)
  n = g
  shift = g >> 1
  while shift != 0
    n ^= shift
    shift >>= 1
  end
  n
end

def next_pow2(n)
  return 1 if n <= 1
  v = n - 1
  Array.each(Integer[1, 2, 4, 8, 16, 32]) { |s| v |= v >> s }
  v + 1
end

def lowest_set(n) = n & (0 - n)

puts("== bit tricks ==")
Array.each(Integer[0, 1, 6, 255, 1023, 0xDEADBEEF]) do |n|
  puts(format("%10d popcount=%2d lowest=%d next_pow2=%d", n, popcount(n), lowest_set(n), next_pow2(n)))
end
puts(format("reverse 0b00010110 (8) = %08b", reverse_bits(0b00010110, 8)))
puts(format("reverse 0x1 (32) = %08x", reverse_bits(1, 32)))

puts("== gray code ==")
codes = Array.map(Range.to_a(0..7)) { |i| gray(i) }
puts(Array.join(Array.map(codes) { |g| format("%03b", g) }, " "))
adjacent = Array.all?(Range.to_a(1..7)) { |i| popcount(codes[i] ^ codes[i - 1]) == 1 }
puts("neighbours differ in one bit: #{adjacent}")
puts("decoded: #{Array.join(Array.map(codes) { |g| gray_decode(g) }, ",")}")

puts("== bit sets ==")
primes = BitSet.from_list(16, Integer[2, 3, 5, 7, 11, 13])
odds = BitSet.from_list(16, Array.select(Range.to_a(0...16)) { |i| Integer.odd?(i) })
puts("primes     #{primes}  #{Array.join(BitSet.members(primes), ",")}")
puts("odds       #{odds}")
puts("both       #{primes & odds}")
puts("either     #{primes | odds}")
puts("exactly 1  #{primes ^ odds}")
puts("not prime  #{BitSet.complement(primes)} count=#{BitSet.count(BitSet.complement(primes))}")
primes[2] = false
primes[15] = true
puts("edited     #{primes} has 15? #{primes[15]} has 2? #{primes[2]}")
begin
  primes[16] = true
rescue IndexError => e
  puts("error: #{Exception.message(e)}")
end
