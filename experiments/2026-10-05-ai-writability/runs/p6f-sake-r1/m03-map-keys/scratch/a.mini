let m = {true: "yes", 1: "one", nil: "none"}
m[false] = "no"
print(m, m[true], m[1], nil in m, keys(m))
m[nil] += "!"
print(m == {true: 1}, has(m, false), get(m, "x", 5), del(m, true), [] in m, type(keys(m)[2]))
print({true: 1} == {1: 1}, {nil: 1, nil: 2})
print(get({false: 0}, false), get({}, [1], 0))
