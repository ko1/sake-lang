# Run with --strict: only the unchecked uses (bad, bad_arith) are reported.
Node = Struct.new(:value, :next)

def sum(n)
  total = 0
  while n
    total += Node.value(n)
    n = Node.next(n)
  end
  total
end

def second(n)
  m = Node.next(n)
  return 0 if m == nil
  Node.value(m)
end

def with_and(n)
  m = Node.next(n)
  m != nil && Node.value(m) > 0
end

def with_unless(n)
  m = Node.next(n)
  return 0 unless m
  Node.value(m) + 1
end

def with_else(n)
  m = Node.next(n)
  if m == nil
    0
  else
    Node.value(m)
  end
end

def bad(n) = Node.value(Node.next(n))

def bad_arith(n)
  m = Node.next(n)
  v = m && Node.value(m)
  v + 1
end

list = Node.new(2, nil)
Array.each(Array[1]) { |v| list = Node.new(v, list) } # the loop's site: its `next` may be nil
p([sum(list), second(list), with_and(list), with_unless(list), with_else(list), bad(list), bad_arith(list)])
