#!/usr/bin/env ruby
# frozen_string_literal: true

# Thread stack sizes are read when Ruby boots, so re-exec once with room for deep recursion.
unless ENV.key?("RUBY_THREAD_VM_STACK_SIZE")
  require "rbconfig"
  env = { "RUBY_THREAD_VM_STACK_SIZE" => (256 << 20).to_s, "RUBY_THREAD_MACHINE_STACK_SIZE" => (1 << 30).to_s }
  exec(env, RbConfig.ruby, __FILE__, *ARGV)
end

require_relative "../lib/sake/cli"
exit Sake::CLI.main(ARGV)
