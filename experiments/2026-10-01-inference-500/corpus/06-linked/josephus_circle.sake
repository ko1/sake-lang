Seat = Struct.new(:name, :next)

def make_circle(names)
  first = nil
  last = nil
  Array.each(names) do |n|
    seat = Seat.new(n, nil)
    if last
      Seat.set_next(last, seat)
    else
      first = seat
    end
    last = seat
  end
  Seat.set_next(last, first) if last
  last
end

def circle_names(before_start)
  out = Array[]
  return out if before_start == nil
  cur = Seat.next(before_start)
  loop_start = cur
  Array.push(out, Seat.name(cur))
  cur = Seat.next(cur)
  while cur != loop_start
    Array.push(out, Seat.name(cur))
    cur = Seat.next(cur)
  end
  out
end

def eliminate(names, k)
  raise ArgumentError, "k must be positive, got #{k}" if k < 1
  prev = make_circle(names)
  order = Array[]
  return [order, nil] if prev == nil
  while Seat.next(prev) != prev
    Integer.times(k - 1) { prev = Seat.next(prev) }
    out = Seat.next(prev)
    Array.push(order, Seat.name(out))
    Seat.set_next(prev, Seat.next(out))
  end
  [order, Seat.name(prev)]
end

def josephus_formula(n, k)
  pos = 0
  Range.each(2..n) { |m| pos = (pos + k) % m }
  pos
end

players = Array["Ada", "Bo", "Cy", "Di", "Ed", "Flo", "Gus"]
puts("circle: #{Array.join(circle_names(make_circle(players)), " -> ")} -> (back to Ada)")
Array.each(Array[1, 2, 3, 5]) do |k|
  order, winner = eliminate(players, k)
  formula = players[josephus_formula(Array.size(players), k)]
  puts(format("k=%d out: %-30s winner: %-4s formula: %s", k, Array.join(order, ","), winner, formula))
end

soldiers = Array.map(Range.to_a(1..41)) { |i| "s#{i}" }
order, survivor = eliminate(soldiers, 3)
puts("41 soldiers, every 3rd: last two out #{Kernel.inspect(Array.last(order))} then #{survivor}")
puts("first ten out: #{Array.join(Array.take(order, 10), " ")}")

order, winner = eliminate(Array[], 2)
puts("empty circle: #{Kernel.inspect(order)} winner=#{Kernel.inspect(winner)}")
order, winner = eliminate(Array["solo"], 4)
puts("one player: winner=#{winner}")
begin
  eliminate(players, 0)
rescue ArgumentError => e
  puts("error: #{Exception.message(e)}")
end

wins = Hash.new(0)
Range.each(1..12) { |k| wins[eliminate(players, k)[1]] += 1 }
Array.each(Array.sort_by(Hash.to_a(wins)) { |name, n| format("%03d %s", 100 - n, name) }) { |name, n| puts("  #{name}: #{n}") }
