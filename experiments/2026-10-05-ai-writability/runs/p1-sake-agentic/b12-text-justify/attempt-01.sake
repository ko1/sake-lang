def pieces(word, w)
  out = Array[]
  rest = word
  while String.size(rest) > w
    Array.push(out, rest[0, w - 1] + "-")
    rest = rest[(w - 1)..]
  end
  Array.push(out, rest)
  out
end

def justify(words, w)
  gaps = Array.size(words) - 1
  return words[0] if gaps == 0
  total = Array.sum(Array.map(words) { |x| String.size(x) })
  extra = w - total
  base = extra / gaps
  rem = extra % gaps
  out = words[0]
  i = 0
  while i < gaps
    out += " " * (base + (i < rem ? 1 : 0)) + words[i + 1]
    i += 1
  end
  out
end

lines = Array.map(IO.readlines(IO.stdin)) { |l| String.chomp(l) }
head = Array.empty?(lines) ? "" : String.gsub(lines[0], /\A +| +\z/, "")
if !String.match?(head, /\A\d+\z/) || String.to_i(head) < 2 || String.to_i(head) > 80
  puts("invalid width")
  exit
end
w = String.to_i(head)

paras = Array[]
cur = nil
nwords = 0
Array.each(lines[1..]) do |l|
  ws = String.scan(l, /[^ \t]+/)
  if Array.empty?(ws)
    cur = nil
  else
    nwords += Array.size(ws)
    if cur == nil
      cur = Array[]
      Array.push(paras, cur)
    end
    Array.concat(cur, ws)
  end
end

border = "+" + "-" * w + "+"
puts(border)
nlines = 0
Array.each_with_index(paras) do |pw, pi|
  puts("|" + " " * w + "|") if pi > 0
  ps = Array.flat_map(pw) { |x| pieces(x, w) }
  rows = Array[]
  curl = Array[]
  curlen = 0
  Array.each(ps) do |x|
    if Array.empty?(curl)
      Array.push(curl, x)
      curlen = String.size(x)
    elsif curlen + 1 + String.size(x) <= w
      Array.push(curl, x)
      curlen += 1 + String.size(x)
    else
      Array.push(rows, curl)
      curl = Array[x]
      curlen = String.size(x)
    end
  end
  Array.push(rows, curl)
  Array.each_with_index(rows) do |r, ri|
    s = ri < Array.size(rows) - 1 ? justify(r, w) : Array.join(r, " ")
    puts("|" + String.ljust(s, w) + "|")
    nlines += 1
  end
end
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{nwords}")
