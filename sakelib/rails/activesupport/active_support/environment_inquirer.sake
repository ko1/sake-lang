# Port of activesupport-8.1.3/lib/active_support/environment_inquirer.rb
#
# Ruby's class_eval writes development?/test?/production? from DEFAULT_ENVIRONMENTS; here they are written out.
# A StringInquirer's other names (`staging?`) go through StringInquirer.inquire.

require "string_inquirer"

module ActiveSupport
  class EnvironmentInquirer
    attr_reader str, development, test, production, local
    def DEFAULT_ENVIRONMENTS = String["development", "test", "production"]
    def LOCAL_ENVIRONMENTS = String["development", "test"]

    def make(env)
      raise ArgumentError, "'local' is a reserved environment name" if env == "local"
      EnvironmentInquirer.new(env, env == "development", env == "test", env == "production", Array.include?(EnvironmentInquirer.LOCAL_ENVIRONMENTS, env))
    end

    def development?(e) = @development
    def test?(e) = @test
    def production?(e) = @production
    def local?(e) = @local
    def inquire(e, method_name) = ActiveSupport::StringInquirer.inquire(ActiveSupport::StringInquirer.new(@str), method_name)
    def to_s(e) = @str
    def to_str(e) = @str
    def inspect(e) = Kernel.inspect(@str)
    def ==(e, other) = (other in ::String) ? @str == other : (other in EnvironmentInquirer) && @str == EnvironmentInquirer.str(other)
  end
end
