# Port of activerecord-8.1.3/lib/arel/crud.rb

module Arel
  module Crud
    def compile_insert(m, values)
      im = create_insert(m)
      InsertManager.insert(im, values)
      im
    end

    def create_insert(m) = InsertManager.new

    def compile_update(m, values, key = nil)
      um = UpdateManager.new(source(m))
      UpdateManager.set(um, values)
      UpdateManager.take(um, limit(m))
      UpdateManager.offset(um, offset(m))
      UpdateManager.order(um, *orders(m))
      UpdateManager.set_wheres(um, constraints(m))
      UpdateManager.comment(um, comment_node(m))
      UpdateManager.set_key(um, key)
      Nodes::UpdateStatement.set_groups(UpdateManager.ast(um), Nodes::SelectCore.groups(@ctx))
      Array.each(Nodes::SelectCore.havings(@ctx)) { |h| UpdateManager.having(um, h) }
      um
    end

    def compile_delete(m, key = nil)
      dm = DeleteManager.new(source(m))
      DeleteManager.take(dm, limit(m))
      DeleteManager.offset(dm, offset(m))
      DeleteManager.order(dm, *orders(m))
      DeleteManager.set_wheres(dm, constraints(m))
      DeleteManager.comment(dm, comment_node(m))
      DeleteManager.set_key(dm, key)
      Nodes::DeleteStatement.set_groups(DeleteManager.ast(dm), Nodes::SelectCore.groups(@ctx))
      Array.each(Nodes::SelectCore.havings(@ctx)) { |h| DeleteManager.having(dm, h) }
      dm
    end
  end
end
