# FIXED in 23307e9a (the lead); the ActionController workaround was removed.
# A function of a module that B includes beats A's (B < A), as the spec says (Ruby: B, M, A). But in C < B the
# pasted A function wins again: C.f prints "A", where Ruby prints "M" (C's ancestors are C, B, M, A).
# Found by ActionController: ApplicationController < ActionController::Base (which includes BasicImplicitRender)
# < Metal < AbstractController::Base ran AbstractController::Base#send_action, so no implicit render happened.
# Workaround: Base defines the overriding function itself (`def send_action(c, n) = ...`).
module M
  def f(x) = "M"
end
class A
  attr_reader v
  def f(x) = "A"
end
class B < A
  include M
end
class C < B
end
p(B.f(B.new(1)), C.f(C.new(1)))   # Ruby: "M", "M"; Sake: "M", "A"
