module Sql
  class WindowDefs
    @by_name: Hash[String, Ast::WindowSpec]

    def initialize: (Array[Ast::NamedWindow] named) -> void
    def bind: (Ast::WindowSpec spec) -> Ast::WindowSpec

    private

    def expand: (Ast::WindowSpec spec, Array[String] seen) -> Ast::WindowSpec
    def check_frame: (Ast::WindowSpec spec) -> void
    def check_offset: (Ast::Frame frame, Ast::FrameBound bound, String which) -> void
  end
end
