def ints_of(line, k)
  toks = String.split(line)
  return nil if Array.size(toks) != k
  return nil unless Array.all?(toks) { String.match?(it, /\A\d+\z/) }
  Array.map(toks) { String.to_i(it) }
end

lines = Array.map(IO.readlines(IO.stdin())) { String.chomp(it) }
hdr = nil
hdr = ints_of(lines[0], 3) if lines[0] != nil
ok = false
if hdr != nil
  ok = hdr[0] >= 2 && hdr[0] <= 50 && hdr[1] <= 5 && hdr[2] >= 1 && hdr[2] <= 20
end
if !ok
  puts("invalid header")
  exit(0)
end
nf = hdr[0]
dd = hdr[1]
cap = hdr[2]

pT = Integer[]
pF = Integer[]
pG = Integer[]
last = 0
Array.each_with_index(lines) do |line, idx|
  next if idx == 0
  next if String.strip(line) == ""
  v = ints_of(line, 3)
  good = v != nil
  if good
    good = v[1] >= 1 && v[1] <= nf && v[2] >= 1 && v[2] <= nf && v[1] != v[2] && v[0] <= 1000 && v[0] >= last
  end
  if good
    Array.push(pT, v[0])
    Array.push(pF, v[1])
    Array.push(pG, v[2])
    last = v[0]
  else
    puts("line #{idx + 1}: invalid request")
  end
end

n = Array.size(pT)
if n == 0
  puts("no passengers")
  exit(0)
end

st = Array.new(n, 0)
pickT = Array.new(n, 0)
dropT = Array.new(n, 0)
t = 0
f = 1
dir = 0
dropped = 0
riders = 0
lastdrop = 0
while dropped < n
  Integer.times(n) { |i| st[i] = 1 if st[i] == 0 && pT[i] <= t }
  got = false
  Integer.times(n) do |i|
    if st[i] == 2 && pG[i] == f
      puts("t=#{t} floor #{f} drop P#{i + 1}")
      st[i] = 3
      dropT[i] = t
      lastdrop = t
      dropped += 1
      riders -= 1
      got = true
    end
  end
  tg = Integer[]
  Integer.times(n) do |i|
    Array.push(tg, pG[i]) if st[i] == 2
    Array.push(tg, pF[i]) if st[i] == 1
  end
  above = Array.any?(tg) { it > f }
  below = Array.any?(tg) { it < f }
  if dir == 1
    dir = above ? 1 : (below ? -1 : 0)
  elsif dir == -1
    dir = below ? -1 : (above ? 1 : 0)
  end
  if dir == 0 && Array.size(tg) > 0
    best = nil
    bd = 0
    Array.each(tg) do |x|
      d = x > f ? x - f : f - x
      if best == nil || d < bd || (d == bd && x < best)
        best = x
        bd = d
      end
    end
    if best == f
      first = nil
      Integer.times(n) { |i| first = i if first == nil && st[i] == 1 && pF[i] == f }
      dir = pG[first] > f ? 1 : -1
    else
      dir = best > f ? 1 : -1
    end
  end
  if dir != 0
    Integer.times(n) do |i|
      if st[i] == 1 && pF[i] == f && riders < cap
        pd = pG[i] > pF[i] ? 1 : -1
        if pd == dir
          puts("t=#{t} floor #{f} pick P#{i + 1}")
          st[i] = 2
          pickT[i] = t
          riders += 1
          got = true
        end
      end
    end
  end
  if got
    t += dd
  else
    f += dir
    t += 1
  end
end

sw = 0
sr = 0
Integer.times(n) do |i|
  w = pickT[i] - pT[i]
  r = dropT[i] - pickT[i]
  sw += w
  sr += r
  puts("P#{i + 1} wait #{w} ride #{r}")
end
puts(format("average wait %.2f ride %.2f", sw * 1.0 / n, sr * 1.0 / n))
puts("done at t=#{lastdrop}")
