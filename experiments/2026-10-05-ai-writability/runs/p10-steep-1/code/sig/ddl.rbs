module Sql
  module Ddl
    def self.create_table: (Ast::CreateTable statement, Catalog catalog) -> void
    def self.create_view: (Ast::CreateView statement, Catalog catalog) -> void
    def self.claim_name: (String name, bool if_not_exists, Catalog catalog) -> bool
    def self.drop_table: (Ast::DropTable statement, Catalog catalog) -> void
    def self.drop_view: (Ast::DropView statement, Catalog catalog) -> void
    def self.create_index: (Ast::CreateIndex statement, Catalog catalog) -> void
    def self.drop_index: (Ast::DropIndex statement, Catalog catalog) -> void
    def self.add_column: (Ast::AddColumn statement, Catalog catalog) -> void
    def self.rename_table: (Ast::RenameTable statement, Catalog catalog) -> void
    def self.rename_column: (Ast::RenameColumn statement, Catalog catalog) -> void
    def self.alter_target: (String name, Catalog catalog) -> Table
  end
end
