def is_valid_name(s)
  if String.size(s) < 1 || String.size(s) > 16
    false
  else
    chars = String.chars(s)
    valid = true
    Array.each(chars) do |c|
      unless c >= "a" && c <= "z"
        valid = false
      end
    end
    valid
  end
end

def parse_money(s)
  if String.include?(s, ".")
    parts = String.split(s, ".")
    if Array.size(parts) != 2
      nil
    else
      whole_str = parts[0]
      frac_str = parts[1]
      if String.size(frac_str) > 2 || String.size(frac_str) == 0
        nil
      else
        whole = String.to_i(whole_str)
        frac = String.to_i(frac_str)
        if String.size(frac_str) == 1
          frac = frac * 10
        end
        whole * 100 + frac
      end
    end
  else
    String.to_i(s) * 100
  end
end

def format_money(cents)
  if cents < 0
    "-" + format_money(-cents)
  else
    whole = cents / 100
    frac = cents % 100
    frac_str = frac < 10 ? "0" + Integer.to_s(frac) : Integer.to_s(frac)
    Integer.to_s(whole) + "." + frac_str
  end
end

# Main logic
accounts = Hash[]  # name -> {balance, limit, lowest, txns, txns_this_month}
month = 0
line_num = 1

loop do
  line = gets
  if line == nil
    break
  end

  if String.strip(line) == ""
    # skip
  else
    fields = String.split(line, /\s+/)

    if Array.empty?(fields)
      # skip
    elsif fields[0] == "OPEN"
      if Array.size(fields) != 3
        puts("line #{line_num}: error: wrong field count")
      else
        name = fields[1]
        limit_str = fields[2]

        if !is_valid_name(name)
          puts("line #{line_num}: error: bad name")
        else
          limit_cents = parse_money(limit_str)
          if limit_cents == nil
            puts("line #{line_num}: error: bad amount")
          elsif Hash.key?(accounts, name)
            puts("line #{line_num}: error: account #{name} exists")
          else
            accounts[name] = {
              balance: 0,
              limit: limit_cents,
              lowest: 0,
              txns: 0,
              txns_this_month: 0
            }
          end
        end
      end
    elsif fields[0] == "DEPOSIT"
      if Array.size(fields) != 3
        puts("line #{line_num}: error: wrong field count")
      else
        name = fields[1]
        amount_str = fields[2]

        if !is_valid_name(name)
          puts("line #{line_num}: error: bad name")
        else
          amount_cents = parse_money(amount_str)
          if amount_cents == nil || amount_cents <= 0
            puts("line #{line_num}: error: bad amount")
          elsif !Hash.key?(accounts, name)
            puts("line #{line_num}: error: no account #{name}")
          else
            acct = accounts[name]
            acct["balance"] = acct["balance"] + amount_cents
            acct["txns"] = acct["txns"] + 1
            if acct["balance"] < acct["lowest"]
              acct["lowest"] = acct["balance"]
            end
          end
        end
      end
    elsif fields[0] == "WITHDRAW"
      if Array.size(fields) != 3
        puts("line #{line_num}: error: wrong field count")
      else
        name = fields[1]
        amount_str = fields[2]

        if !is_valid_name(name)
          puts("line #{line_num}: error: bad name")
        else
          amount_cents = parse_money(amount_str)
          if amount_cents == nil || amount_cents <= 0
            puts("line #{line_num}: error: bad amount")
          elsif !Hash.key?(accounts, name)
            puts("line #{line_num}: error: no account #{name}")
          else
            acct = accounts[name]
            new_balance = acct["balance"] - amount_cents
            if new_balance < -acct["limit"]
              puts("line #{line_num}: error: insufficient funds in #{name}")
            else
              acct["balance"] = new_balance
              acct["txns"] = acct["txns"] + 1
              acct["txns_this_month"] = acct["txns_this_month"] + 1
              if acct["balance"] < acct["lowest"]
                acct["lowest"] = acct["balance"]
              end
            end
          end
        end
      end
    elsif fields[0] == "TRANSFER"
      if Array.size(fields) != 4
        puts("line #{line_num}: error: wrong field count")
      else
        from_name = fields[1]
        to_name = fields[2]
        amount_str = fields[3]

        if !is_valid_name(from_name)
          puts("line #{line_num}: error: bad name")
        elsif !is_valid_name(to_name)
          puts("line #{line_num}: error: bad name")
        else
          amount_cents = parse_money(amount_str)
          if amount_cents == nil || amount_cents <= 0
            puts("line #{line_num}: error: bad amount")
          elsif !Hash.key?(accounts, from_name)
            puts("line #{line_num}: error: no account #{from_name}")
          elsif !Hash.key?(accounts, to_name)
            puts("line #{line_num}: error: no account #{to_name}")
          elsif from_name == to_name
            puts("line #{line_num}: error: same account")
          else
            from_acct = accounts[from_name]
            to_acct = accounts[to_name]
            new_balance = from_acct["balance"] - amount_cents
            if new_balance < -from_acct["limit"]
              puts("line #{line_num}: error: insufficient funds in #{from_name}")
            else
              from_acct["balance"] = new_balance
              from_acct["txns"] = from_acct["txns"] + 1
              from_acct["txns_this_month"] = from_acct["txns_this_month"] + 1
              if from_acct["balance"] < from_acct["lowest"]
                from_acct["lowest"] = from_acct["balance"]
              end

              to_acct["balance"] = to_acct["balance"] + amount_cents
              to_acct["txns"] = to_acct["txns"] + 1
              if to_acct["balance"] < to_acct["lowest"]
                to_acct["lowest"] = to_acct["balance"]
              end
            end
          end
        end
      end
    elsif fields[0] == "MONTHEND"
      if Array.size(fields) != 1
        puts("line #{line_num}: error: wrong field count")
      else
        month = month + 1
        puts("== month #{month} ==")

        sorted_names = Array.sort(Hash.keys(accounts))
        Array.each(sorted_names) do |name|
          acct = accounts[name]
          balance = acct["balance"]

          # Calculate interest
          if balance < 0
            overdrawn = -balance
            interest = (overdrawn * 3 + 199) / 200  # 1.5% rounded up: ceil(x * 1.5 / 100) = ceil(x * 3 / 200)
            if interest > 0
              acct["balance"] = acct["balance"] - interest
              if acct["balance"] < acct["lowest"]
                acct["lowest"] = acct["balance"]
              end
              puts("#{name} interest -#{format_money(interest)}")
            end
          else
            interest = balance / 400  # 0.25% rounded down: floor(x * 0.25 / 100) = floor(x / 400)
            if interest > 0
              acct["balance"] = acct["balance"] + interest
              if acct["balance"] < acct["lowest"]
                acct["lowest"] = acct["balance"]
              end
              puts("#{name} interest +#{format_money(interest)}")
            end
          end

          # Calculate fee
          if acct["txns_this_month"] > 4
            fee = 200  # $2.00
            acct["balance"] = acct["balance"] - fee
            if acct["balance"] < acct["lowest"]
              acct["lowest"] = acct["balance"]
            end
            puts("#{name} fee -2.00")
          end

          acct["txns_this_month"] = 0
        end
      end
    else
      puts("line #{line_num}: error: unknown command")
    end
  end

  line_num = line_num + 1
end

# Print final report
if Hash.empty?(accounts)
  puts("no accounts")
else
  # Sort by balance (descending), then by name
  sorted_accounts = Array[]
  Hash.each(accounts) do |name, acct|
    Array.push(sorted_accounts, {name: name, acct: acct})
  end

  sorted_accounts = Array.sort_by(sorted_accounts) do |row|
    [-row["acct"]["balance"], row["name"]]
  end

  puts(format("%-16s %12s %12s %5s", "account", "balance", "lowest", "txns"))

  total_balance = 0
  Array.each(sorted_accounts) do |row|
    name = row["name"]
    acct = row["acct"]
    total_balance = total_balance + acct["balance"]
    puts(format("%-16s %12s %12s %5d", name, format_money(acct["balance"]), format_money(acct["lowest"]), acct["txns"]))
  end

  puts("total: #{format_money(total_balance)}")
end
