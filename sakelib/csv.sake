# csv: Ruby's CSV library (csv 3.3) in Sake.
#
# Options are Ruby's keyword arguments: CSV.parse(s, col_sep: ";", headers: true).
# A row is an Array of String | nil (nil for an empty unquoted field, as in Ruby).
# With `headers:` in the options, the result is a CSVTable of CSVRow (Ruby's CSV::Table / CSV::Row).

# Ruby's CSV::MalformedCSVError: the message and the line number.
class MalformedCSVError < Exception
  attr_reader line_number
end

# A writer (Ruby's CSV object for output): `csv << row` appends a line, to a String (generate) or to
# an IO: `CSV.new(IO.stdout, col_sep: ";")`, or the file of `CSV.open`.
class CSV
  private attr_reader io
  attr_reader col_sep, row_sep, quote_char, headers
  private attr_reader force_quotes, quote_empty, write_headers
  attr_reader path, lineno
  private attr_reader lines
  include Bitwise

  # As Ruby's CSV.new for writing: row_sep :auto is "\n"; headers as a header line String (split
  # by col_sep) or a Tuple become an Array; write_headers writes them first.
  def initialize(c)
    @col_sep = "," if @col_sep == nil
    @row_sep = :auto if @row_sep == nil
    @quote_char = "\"" if @quote_char == nil
    @force_quotes = false if @force_quotes == nil
    @quote_empty = true if @quote_empty == nil
    @write_headers = false if @write_headers == nil
    @lineno = 0
    @lines = String[]
    @row_sep = case @row_sep
               in String then @row_sep
               else "\n"
               end
    hs = case @headers
         in String then parse_line(@headers, col_sep: @col_sep)
         in Tuple then Tuple.to_a(@headers)
         in Array then @headers
         else nil
         end
    @headers = hs
    c << hs if @write_headers && hs
  end

  def to_io(c) = @io
  def force_quotes?(c) = @force_quotes
  def quote_empty?(c) = @quote_empty

  # ---- parsing ----

  # Ruby's :auto: the first "\r\n", "\n", or "\r" in the data, else "\n".
  def detect_row_sep(text)
    m = String.match(text, /\r\n|\n|\r/)
    m ? MatchData.to_s(m) : "\n"
  end

  def malformed(msg, line)
    MalformedCSVError.new("#{msg} in line #{line}.", line)
  end

  def unquoted(f, line)
    return nil if String.empty?(f)
    m = String.match(f, /[\r\n]/)
    raise malformed("Unquoted fields do not allow new line <#{Kernel.inspect(MatchData.to_s(m))}>", line) if m
    f
  end

  # One field at the position, then its delimiter: 1 the quoted text (with doubled quotes), 2 the
  # unquoted text, 3 the col_sep, the row_sep, or "" at the end; 3 is nil when something else
  # follows (an error).
  def field_regexp(col_sep, quote, row_sep)
    q = Regexp.escape(quote)
    sep = "#{Regexp.escape(col_sep)}|#{Regexp.escape(row_sep)}"
    Regexp.new("\\G(?:#{q}((?:[^#{q}]++|#{q}#{q})*+)#{q}|((?:(?!#{sep})[^#{q}])*+))(#{sep}|\\z)?")
  end

  # Text -> Array of rows of String | nil, no conversion; only the first row when `first`.
  # Each field is one Regexp.match at the position; a quoted field may span row_seps. `line` counts
  # records, as Ruby's lineno does (the old split-based parser counted row_seps).
  # rs is :auto or a String; skip_lines is nil or a Regexp.
  def raw_rows(text, col_sep, rs, quote, skip_blanks, skip_lines, first = false)
    rows = Array[]
    return rows if String.empty?(text)
    row_sep = rs == :auto ? detect_row_sep(text) : rs
    re = field_regexp(col_sep, quote, row_sep)
    qq = quote + quote
    n = String.length(text)
    pos = 0
    line = 1
    while pos < n
      start = pos
      start_line = line
      row = Array[]
      delim = nil
      at_end = false
      until at_end
        m = Regexp.match(re, text, pos)
        raise malformed("Unclosed quoted field", start_line) unless m   # not reached: group 2 matches ""
        delim = m[3]
        qtext = m[1]
        if delim == nil
          raise malformed("Any value after quoted field isn't allowed", start_line) if qtext
          raise malformed("Illegal quoting", start_line) unless String.empty?(m[2] || "")
          raise malformed("Unclosed quoted field", start_line)
        end
        if qtext
          Array.push(row, String.include?(qtext, qq) ? String.gsub(qtext, qq, quote) : qtext)
        else
          Array.push(row, unquoted(m[2] || "", start_line))
        end
        pos = MatchData.end(m, 0)
        at_end = delim != col_sep
      end
      line += 1
      # a record of nothing is an empty row, not [nil]
      row = Array[] if Array.size(row) == 1 && row[0] == nil && pos - start <= String.length(row_sep)
      next if skip_blanks && Array.empty?(row)
      next if skip_lines && skip_line?(skip_lines, text, start, pos - String.length(delim || ""))
      Array.push(rows, row)
      return rows if first
    end
    rows
  end

  # The record's text (characters start...stop, without its row_sep) matches skip_lines.
  def skip_line?(re, text, start, stop) = String.match?(String.[](text, start, stop - start) || "", re)

  # ---- converters ----

  # One named converter on a String field; Ruby's `Integer(f) rescue f` and `Float(f) rescue f`.
  def convert_named(f, name)
    case name
    in :integer then (Integer(f) rescue f)
    in :float then (Float(f) rescue f)
    in :numeric | :all
      v = (Integer(f) rescue f)
      (v in String) ? (Float(v) rescue v) : v
    else raise ArgumentError, "unknown converter name: #{Kernel.inspect(name)}"
    end
  end

  # converters: a Symbol, or a Tuple / Array of Symbols applied in order while the field is a String.
  def convert_field(f, conv)
    case conv
    in Symbol then convert_named(f, conv)
    in Tuple | Array
      v = f
      names = (conv in Tuple) ? Tuple.to_a(conv) : conv
      Array.each(names) do |name|
        v = convert_named(v, name) if v in String
      end
      v
    end
  end

  # c: Ruby's nil_value, empty_value, and converters, as a Record.
  def convert_row(row, c)
    case c
    in {nil_value:, empty_value:, converters:}
      row = Array.map(row) { |f| f == nil ? nil_value : f } if nil_value != nil
      row = Array.map(row) { |f| f == "" ? empty_value : f } if empty_value != ""
      converters ? Array.map(row) { |f| (f in String) ? convert_field(f, converters) : f } : row
    end
  end

  def convert_header(h, conv)
    case conv
    in :downcase then String.downcase(h)
    in :symbol
      String.downcase(h).String.gsub(/[^\s\w]+/, "").String.strip.String.gsub(/\s+/, "_").String.to_sym
    in :symbol_raw then String.to_sym(h)
    else raise ArgumentError, "unknown header converter name: #{Kernel.inspect(conv)}"
    end
  end

  def convert_headers(hs, conv)
    conv ? Array.map(hs) { |h| (h in String) ? convert_header(h, conv) : h } : hs
  end

  def make_table(rows, c, headers, header_converters)
    hs = case headers
         in true
           first = Array.shift(rows)
           first ? first : Array[]
         in String then parse_line(headers)
         in Tuple then Tuple.to_a(headers)
         in Array then headers
         in false then raise ArgumentError, "headers: false makes Arrays: omit headers:"
         end
    hs = Array.map(hs ? hs : Array[]) { it }
    hs = convert_headers(hs, header_converters)
    CSVTable.new(hs, Array.map(rows) { |r| CSVRow.new(hs, convert_row(r, c)) })
  end

  # ---- parsing API ----

  # Without `headers:` (or with nil) -> Array of rows; with `headers:` -> CSVTable.
  # With a block, as Ruby: yields each row (a CSVRow with headers:) and gives nil.
  def parse(text, col_sep: ",", row_sep: :auto, quote_char: "\"", headers: nil, converters: nil,
            header_converters: nil, skip_blanks: false, skip_lines: nil, nil_value: nil, empty_value: "")
    rows = raw_rows(text, col_sep, row_sep, quote_char, skip_blanks, skip_lines)
    c = {nil_value: nil_value, empty_value: empty_value, converters: converters}
    # nil (the default) is its own type, so a call without headers: is typed an Array of rows;
    # false would share true's type, so it is rejected in make_table
    result = case headers
             in nil then Array.map(rows) { |r| convert_row(r, c) }
             else make_table(rows, c, headers, header_converters)
             end
    # if/else, not `return result unless block_given?`: notes/csv_bug_return_unless_block_given.sake
    if block_given?
      case result
      in CSVTable then CSVTable.each(result) { |r| yield(r) }
      in Array then Array.each(result) { |r| yield(r) }
      end
      nil
    else
      result
    end
  end

  # The first row, or nil for empty text; the rest of the text is not parsed, as Ruby's.
  def parse_line(line, col_sep: ",", row_sep: :auto, quote_char: "\"", converters: nil, skip_blanks: false,
                 skip_lines: nil, nil_value: nil, empty_value: "")
    rows = raw_rows(line, col_sep, row_sep, quote_char, skip_blanks, skip_lines, true)
    c = {nil_value: nil_value, empty_value: empty_value, converters: converters}
    Array.first(Array.map(rows) { |r| convert_row(r, c) })
  end

  def read(path, col_sep: ",", row_sep: :auto, quote_char: "\"", headers: nil, converters: nil,
           header_converters: nil, skip_blanks: false, skip_lines: nil, nil_value: nil, empty_value: "")
    parse(File.read(path), col_sep:, row_sep:, quote_char:, headers:, converters:, header_converters:,
                           skip_blanks:, skip_lines:, nil_value:, empty_value:)
  end

  def readlines(path, col_sep: ",", row_sep: :auto, quote_char: "\"", headers: nil, converters: nil,
                header_converters: nil, skip_blanks: false, skip_lines: nil, nil_value: nil, empty_value: "")
    read(path, col_sep:, row_sep:, quote_char:, headers:, converters:, header_converters:, skip_blanks:,
               skip_lines:, nil_value:, empty_value:)
  end

  # Ruby's CSV.table: headers, numeric converters, Symbol headers.
  def table(path) = read(path, headers: true, converters: :numeric, header_converters: :symbol)

  # Ruby's foreach(path, mode = "r", **opts): yields CSVRows when `headers:` is given, otherwise Arrays.
  # The file is read whole through File.open (a quoted field may span lines).
  def foreach(path, mode = "r", col_sep: ",", row_sep: :auto, quote_char: "\"", headers: nil, converters: nil,
              header_converters: nil, skip_blanks: false, skip_lines: nil, nil_value: nil, empty_value: "", &b)
    text = File.open(path, mode) { |f| IO.read(f) }
    parse(text, col_sep:, row_sep:, quote_char:, headers:, converters:, header_converters:, skip_blanks:,
                skip_lines:, nil_value:, empty_value:, &b)
  end

  # ---- generating ----

  def field_text(c, f)
    q = @quote_char
    return q + q if @force_quotes && f == nil
    return "" if f == nil
    s = Kernel.to_s(f)
    if @force_quotes || (@quote_empty && String.empty?(s)) ||
       String.match?(s, /[\r\n]/) || String.include?(s, @col_sep) || String.include?(s, q)
      q + String.gsub(s, q, q + q) + q
    else
      s
    end
  end

  def row_fields(c, row)
    case row
    in Array then row
    in Tuple then Tuple.to_a(row)
    in CSVRow then CSVRow.fields(row)
    in Hash
      hs = @headers
      raise ArgumentError, "a Hash row needs headers:" unless hs
      Array.map(hs) { |h| row[h] }
    end
  end

  def line_of(c, row)
    fs = row_fields(c, row)
    Array.join(Array.map(fs) { |f| field_text(c, f) }, @col_sep) + @row_sep
  end

  def <<(c, row)
    line = line_of(c, row)
    f = @io
    if f == nil
      Array.push(@lines, line)
    else
      IO.write(f, line)
    end
    @lineno += 1
    c
  end

  def add_row(c, row) = c << row
  def puts(c, row) = c << row

  def string(c) = Array.join(@lines)

  # Ruby's generate(str = nil, **options) appends to str; here str is not changed.
  def generate(str = "", col_sep: ",", row_sep: :auto, quote_char: "\"", headers: nil, force_quotes: false,
               quote_empty: true, write_headers: false)
    c = CSV.new(col_sep:, row_sep:, quote_char:, headers:, force_quotes:, quote_empty:, write_headers:)
    yield(c)
    str + string(c)
  end

  def generate_line(row, col_sep: ",", row_sep: :auto, quote_char: "\"", headers: nil, force_quotes: false,
                    quote_empty: true)
    line_of(CSV.new(col_sep:, row_sep:, quote_char:, headers:, force_quotes:, quote_empty:), row)
  end

  def generate_lines(rows, col_sep: ",", row_sep: :auto, quote_char: "\"", headers: nil, force_quotes: false,
                     quote_empty: true)
    c = CSV.new(col_sep:, row_sep:, quote_char:, headers:, force_quotes:, quote_empty:)
    Array.join(Array.map(rows) { |r| line_of(c, r) })
  end

  # Ruby's open(path, mode = "r", **opts) for writing: mode "w" or "a" (and their "b"/"+" forms).
  # With a block, yields the writer, closes the file after it, and gives the block's value; without
  # one, gives the writer (close it with CSV.close). Reading ("r") is not supported.
  def open(path, mode = "r", col_sep: ",", row_sep: :auto, quote_char: "\"", headers: nil, force_quotes: false,
           quote_empty: true, write_headers: false)
    unless String.start_with?(mode, "w") || String.start_with?(mode, "a")
      raise ArgumentError, "CSV.open: only writing (\"w\" or \"a\") is supported, got #{Kernel.inspect(mode)}"
    end
    f = File.open(path, mode)
    c = CSV.new(f, col_sep:, row_sep:, quote_char:, headers:, force_quotes:, quote_empty:, write_headers:, path:)
    if block_given?
      begin
        yield(c)
      ensure
        IO.close(f)
      end
    else
      c
    end
  end

  # Closes the file of a writer from open; a generate writer has none.
  def close(c)
    f = @io
    IO.close(f) if f != nil
    nil
  end

  def io_desc(c)
    path = @path
    path == nil ? "io_type:StringIO" : "io_type:File io_path:#{Kernel.inspect(path)} encoding:UTF-8"
  end

  def inspect(c) = "#<CSV #{io_desc(c)} lineno:#{@lineno} col_sep:#{Kernel.inspect(@col_sep)} row_sep:#{Kernel.inspect(@row_sep)} quote_char:#{Kernel.inspect(@quote_char)}>"
end

# Ruby's CSV::Row: headers and fields of the same length.
class CSVRow
  attr_reader headers, fields
  include Indexable
  include Bitwise

  # As Ruby's Row.new(headers, fields): copies both and pads the shorter side with nil.
  def initialize(r)
    @headers = Array.dup(@headers)
    @fields = Array.dup(@fields)
    Array.push(@fields, nil) while Array.size(@fields) < Array.size(@headers)
    Array.push(@headers, nil) while Array.size(@headers) < Array.size(@fields)
  end

  def headers(r) = Array.dup(@headers)
  def fields(r) = Array.dup(@fields)
  def to_a(r) = Array.zip(@headers, @fields)

  # An Integer is a position; anything else is a header.
  def [](r, k)
    case k
    in Integer then @fields[k]
    else
      i = Array.index(@headers, k)
      i ? @fields[i] : nil
    end
  end

  def field(r, k) = r[k]

  def []=(r, k, v)
    case k
    in Integer
      @fields[k] = v
    else
      i = Array.index(@headers, k)
      if i
        @fields[i] = v
      else
        Array.push(@headers, k)
        Array.push(@fields, v)
      end
    end
    v
  end

  # As Ruby's fetch(header, *default) { |header| }: a missing header gives the block's value, then
  # the default, then KeyError.
  def fetch(r, h, *default)
    raise ArgumentError, "Too many arguments" if Array.size(default) > 1
    i = Array.index(@headers, h)
    return @fields[i] if i
    if block_given?
      yield(h)
    elsif Array.empty?(default)
      raise KeyError, "key not found: #{h}"
    else
      default[0]
    end
  end

  def has_key?(r, h) = Array.include?(@headers, h)
  def header?(r, h) = has_key?(r, h)
  def include?(r, h) = has_key?(r, h)
  def key?(r, h) = has_key?(r, h)
  def member?(r, h) = has_key?(r, h)
  def field?(r, v) = Array.include?(@fields, v)
  def index(r, h) = Array.index(@headers, h)
  def size(r) = Array.size(@fields)
  def length(r) = size(r)
  def empty?(r) = Array.empty?(@fields)
  def header_row?(r) = false
  def field_row?(r) = true
  def values_at(r, *hs) = Array.map(hs) { |h| r[h] }

  # Appends a field (with a nil header), or a [header, field] Tuple.
  def <<(r, x)
    case x
    in Tuple
      h, v = x
      Array.push(@headers, h)
      Array.push(@fields, v)
    else
      Array.push(@headers, nil)
      Array.push(@fields, x)
    end
    r
  end

  # Removes the field of header h (or at position h); returns [header, field] or nil.
  def delete(r, h)
    i = (h in Integer) ? h : Array.index(@headers, h)
    return nil unless i
    return nil unless i < Array.size(@fields)
    [Array.delete_at(@headers, i), Array.delete_at(@fields, i)]
  end

  def to_h(r)
    h = Hash[]
    Array.each(Array.zip(@headers, @fields)) { |k, v| h[k] = v unless Hash.key?(h, k) }
    h
  end
  def to_hash(r) = to_h(r)

  def each(r)
    Array.each(Array.zip(@headers, @fields)) { |h, v| yield(h, v) }
    r
  end

  def to_csv(r) = CSV.generate_line(@fields)
  def to_s(r) = to_csv(r)

  def ==(a, b) = (b in CSVRow) && CSVRow.headers(a) == CSVRow.headers(b) && CSVRow.fields(a) == CSVRow.fields(b)

  def inspect(r)
    parts = Array.map(Array.zip(@headers, @fields)) do |h, v|
      hs = (h in Symbol) ? Symbol.to_s(h) : Kernel.inspect(h)
      " #{hs}:#{Kernel.inspect(v)}"
    end
    "#<CSV::Row#{Array.join(parts)}>"
  end
end

# Ruby's CSV::Table (row mode only): rows sharing the headers.
class CSVTable
  private attr_reader header_list
  attr_reader rows
  include Indexable
  include Bitwise

  # The first row's headers, or those it was made with when it has no rows.
  def headers(t)
    first = Array.first(@rows)
    first ? CSVRow.headers(first) : Array.dup(@header_list)
  end

  # An Integer gives a row; a header gives the column (an Array of fields).
  def [](t, k)
    case k
    in Integer then @rows[k]
    else Array.map(@rows) { |r| r[k] }
    end
  end

  def []=(t, k, v)
    case k
    in Integer then @rows[k] = v
    else
      Array.each_with_index(@rows) { |r, i| r[k] = (v in Array) ? v[i] : v }
    end
    v
  end

  def size(t) = Array.size(@rows)
  def length(t) = size(t)
  def empty?(t) = Array.empty?(@rows)

  def each(t, &b)
    Array.each(@rows, &b)
    t
  end

  def map(t, &b) = Array.map(@rows, &b)
  def select(t, &b) = Array.select(@rows, &b)
  def find(t, &b) = Array.find(@rows, &b)

  def <<(t, row)
    case row
    in CSVRow then Array.push(@rows, row)
    in Tuple then Array.push(@rows, CSVRow.new(headers(t), Tuple.to_a(row)))
    in Array then Array.push(@rows, CSVRow.new(headers(t), row))
    end
    t
  end
  def push(t, row) = t << row

  # Deletes a row (Integer) or a column (header); returns what was removed.
  def delete(t, k)
    case k
    in Integer then Array.delete_at(@rows, k)
    else Array.map(@rows) { |r| (x = CSVRow.delete(r, k)) ? x[1] : nil }
    end
  end

  def values_at(t, *is) = Array.map(is) { |i| @rows[i] }

  def to_a(t)
    out = Array[headers(t)]
    Array.each(@rows) { |r| Array.push(out, CSVRow.fields(r)) }
    out
  end

  def to_csv(t)
    CSV.generate_line(headers(t)) + Array.join(Array.map(@rows) { |r| CSVRow.to_csv(r) })
  end
  def to_s(t) = to_csv(t)

  # Ruby's: a summary line, then the CSV of the headers and the first 5 rows.
  def inspect(t)
    first = CSVTable.new(@header_list, Array.take(@rows, 5))
    "#<CSV::Table mode:col_or_row row_count:#{Array.size(@rows) + 1}>\n#{to_csv(first)}"
  end
end

# Ruby's core extensions from csv.
class String
  def parse_csv(s) = CSV.parse_line(s)
end

class Array
  def to_csv(a) = CSV.generate_line(a)
end

class Tuple
  def to_csv(t) = CSV.generate_line(t)
end
