def read_all_lines
  lines = Array[]
  while line = Kernel.gets
    Array.push(lines, line)
  end
  lines
end

def extract_words(lines)
  words = Array[]
  Array.each(lines) do |line|
    parts = String.split(line, /[\s\t]+/)
    Array.each(parts) do |word|
      if !String.empty?(word)
        Array.push(words, word)
      end
    end
  end
  words
end

def is_blank_line?(line)
  String.empty?(String.strip(line))
end

def group_into_paragraphs(lines)
  paragraphs = Array[]
  current_para = Array[]
  in_paragraph = false

  Array.each(lines) do |line|
    if is_blank_line?(line)
      if in_paragraph
        Array.push(paragraphs, current_para)
        current_para = Array[]
        in_paragraph = false
      end
    else
      Array.push(current_para, line)
      in_paragraph = true
    end
  end

  if in_paragraph
    Array.push(paragraphs, current_para)
  end

  paragraphs
end

def break_long_words(words, w)
  result = Array[]
  Array.each(words) do |word|
    if String.size(word) <= w
      Array.push(result, word)
    else
      remaining = word
      while String.size(remaining) > w
        piece = String.slice(remaining, 0, w - 1)
        piece = String.+(piece, "-")
        Array.push(result, piece)
        remaining = String.slice(remaining, w - 1, String.size(remaining) - (w - 1))
      end
      if !String.empty?(remaining)
        Array.push(result, remaining)
      end
    end
  end
  result
end

def fill_lines(words, w)
  lines = Array[]
  current_line = Array[]
  current_len = 0

  Array.each(words) do |word|
    word_len = String.size(word)

    if Array.empty?(current_line)
      Array.push(current_line, word)
      current_len = word_len
    else
      # try adding this word
      needed = current_len + 1 + word_len
      if needed <= w
        Array.push(current_line, word)
        current_len = needed
      else
        # start new line
        Array.push(lines, current_line)
        current_line = Array[word]
        current_len = word_len
      end
    end
  end

  if !Array.empty?(current_line)
    Array.push(lines, current_line)
  end

  lines
end

def justify_line(words, w, is_last)
  if is_last || Array.size(words) == 1
    # left-aligned with single spaces
    line = Array.join(words, " ")
    line = String.+(line, String.*(String[], w - String.size(line)))
    line
  else
    # fully justified
    total_word_len = 0
    Array.each(words) do |w|
      total_word_len += String.size(w)
    end

    num_gaps = Array.size(words) - 1
    total_spaces = w - total_word_len
    spaces_per_gap = total_spaces / num_gaps
    extra_spaces = total_spaces % num_gaps

    line = ""
    Array.each_with_index(words) do |word, i|
      line = String.+(line, word)
      if i < num_gaps
        gap_spaces = spaces_per_gap
        if i < extra_spaces
          gap_spaces += 1
        end
        line = String.+(line, String.*(String[], gap_spaces))
      end
    end
    line
  end
end

raw_lines = read_all_lines

if Array.empty?(raw_lines)
  puts("invalid width")
  Kernel.exit(0)
end

width_line = String.strip(Array.at(raw_lines, 0))

if /^\d+$/ !~ width_line
  puts("invalid width")
  Kernel.exit(0)
end

w = String.to_i(width_line)

if w < 2 || w > 80
  puts("invalid width")
  Kernel.exit(0)
end

text_lines = Array[]
Integer.times(Array.size(raw_lines) - 1) do |i|
  Array.push(text_lines, Array.at(raw_lines, i + 1))
end

paragraphs = group_into_paragraphs(text_lines)

all_para_lines = Array[]
total_words = 0

Array.each(paragraphs) do |para_lines|
  para_words = extract_words(para_lines)
  total_words += Array.size(para_words)

  broken_words = break_long_words(para_words, w)
  filled_lines = fill_lines(broken_words, w)

  Array.each_with_index(filled_lines) do |line_words, idx|
    is_last = (idx == Array.size(filled_lines) - 1)
    justified = justify_line(line_words, w, is_last)
    Array.push(all_para_lines, justified)
  end
end

# Output
puts(String.+("+", String.+(String.*(String[], w), "+")))

if Array.empty?(paragraphs)
  puts(String.+("|", String.+(String.*(String[], w), "|")))
else
  Array.each_with_index(paragraphs) do |para, pidx|
    if pidx > 0
      puts(String.+("|", String.+(String.*(String[], w), "|")))
    end

    para_lines = extract_words(para)
    total_words_temp = Array.size(para_lines)
    broken = break_long_words(para_lines, w)
    filled = fill_lines(broken, w)

    Array.each_with_index(filled) do |line_words, idx|
      is_last = (idx == Array.size(filled) - 1)
      justified = justify_line(line_words, w, is_last)
      puts(String.+("|", String.+(justified, "|")))
    end
  end
end

puts(String.+("+", String.+(String.*(String[], w), "+")))
puts(format("paragraphs: %d, lines: %d, words: %d", Array.size(paragraphs), Array.size(all_para_lines), total_words))
