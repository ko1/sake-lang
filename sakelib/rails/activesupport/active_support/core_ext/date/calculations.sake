# Port of activesupport-8.1.3/lib/active_support/core_ext/date/calculations.rb (partial: no Date.current with Time.zone, no beginning_of_day (a Time) & co.)

require "date"
require "../date_and_time/calculations"

class Date
  include DateAndTime::Calculations

  def yesterday_date = Date.today - 1
  def tomorrow_date = Date.today + 1
  def current = Date.today

  # (Sake only) an option read as an Integer, or nil
  def opt_int(options, key)
    v = options[key]
    case v
    in nil then nil
    in Integer then v
    in Float | Rational then Arithmetic.to_i(v)
    else raise ArgumentError, "#{key} must be an Integer: #{Kernel.inspect(v)}"
    end
  end

  # Ruby: advance(options) with :years, :months, :weeks, :days
  def advance(d, options)
    r = d
    if (years = opt_int(options, :years))
      r = r >> years * 12
    end
    if (months = opt_int(options, :months))
      r = r >> months
    end
    if (weeks = opt_int(options, :weeks))
      r = r + weeks * 7
    end
    if (days = opt_int(options, :days))
      r = r + days
    end
    r
  end

  # Ruby: change(options) with :year, :month, :day
  def change(d, options)
    Date.new(opt_int(options, :year) || @year, opt_int(options, :month) || @month, opt_int(options, :day) || @day)
  end

  def first_hour(d, date_or_time) = date_or_time
  def last_hour(d, date_or_time) = date_or_time
  def midnight_if_time(d, date_or_time) = date_or_time
  def copy_time_to(d, other) = other
  def past?(d) = d < Date.today
  def future?(d) = d > Date.today
  def today?(d) = d == Date.today
end
