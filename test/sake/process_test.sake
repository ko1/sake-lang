require "minitest"

# ENV, Kernel.system and Open3 (built in on 2026-10-09: a program cannot reach the environment or spawn a child
# process otherwise).
suite = Minitest.suite("process")

Minitest.test(suite, "ENV: get, fetch, key?, set, delete, keys, to_h") do |t|
  Minitest.refute_nil(t, ENV.get("PATH"))
  Minitest.assert_nil(t, ENV.get("SAKE_TEST_NO_SUCH_VARIABLE"))
  Minitest.assert_equal(t, "fallback", ENV.fetch("SAKE_TEST_NO_SUCH_VARIABLE", "fallback"))
  Minitest.assert_match(t, /key not found/, Minitest.assert_raises(t) { ENV.fetch("SAKE_TEST_NO_SUCH_VARIABLE") })
  Minitest.assert_equal(t, "1", ENV.set("SAKE_TEST_VARIABLE", "1"))
  Minitest.assert(t, ENV.key?("SAKE_TEST_VARIABLE"))
  Minitest.assert_equal(t, "1", ENV.to_h["SAKE_TEST_VARIABLE"])
  Minitest.assert_includes(t, ENV.keys, "SAKE_TEST_VARIABLE")
  Minitest.assert_equal(t, "1", ENV.delete("SAKE_TEST_VARIABLE"))
  Minitest.refute(t, ENV.key?("SAKE_TEST_VARIABLE"))
end

Minitest.test(suite, "Kernel.system and Open3.capture*") do |t|
  Minitest.assert_equal(t, true, Kernel.system("true"))
  Minitest.assert_equal(t, false, Kernel.system("false"))
  Minitest.assert_nil(t, Kernel.system("sake-no-such-command-xyz"))
  Minitest.assert_equal(t, ["hi\n", 0], Open3.capture2("echo", "hi"))
  out, err, status = Open3.capture3("sh", "-c", "echo out; echo err >&2; exit 3")
  Minitest.assert_equal(t, "out\n", out)
  Minitest.assert_equal(t, "err\n", err)
  Minitest.assert_equal(t, 3, status)
  Minitest.assert_equal(t, ["both\n", 0], Open3.capture2e("sh", "-c", "echo both"))
  Minitest.assert_match(t, /No such file/, Minitest.assert_raises(t) { Open3.capture2("sake-no-such-command-xyz") })
end

Minitest.run(suite)
