# Inside initialize the new instance's fields are followed like locals: a field written on some paths
# keeps what new gave on the others, a function given the instance may write any field, and
# `@x in T` / `if @x` narrow them.
class C
  attr_reader s
  def initialize(c)
    @s = 1 if @s == nil
  end
end
p(C.new("x"))
p(C.new(nil))

class Session
  attr_reader rcpts
  def initialize(s)
    @rcpts = nil
    reset(s)
  end
  def reset(s) = @rcpts = Array["a"]
end
p(Array.size(Session.rcpts(Session.new) || Array[]))

class Url
  attr_reader port
  def initialize(u)
    @port = String.to_i(@port) if @port in String
  end
end
p(Integer.to_s(Url.port(Url.new("8080")) + 1))
p(Url.port(Url.new(80)) + 1)

class UnionFind
  attr_reader parent
  def initialize(uf)
    @parent = nil
    @parent ||= Hash[]
  end     # `||=` on a field: a Hash afterwards
end
p(Hash.size(UnionFind.parent(UnionFind.new)))
