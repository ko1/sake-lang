# timeout: Ruby's Timeout.timeout(sec) { ... }.
#
# The block runs in a Thread of its own; the caller waits for it up to sec seconds (Thread.join with a
# limit). If it is still running then, Thread.raise interrupts it where it is (its ensure clauses run, as
# in Ruby) and TimeoutError is raised here. If it finished in time its value is returned, and an exception
# in it is raised here (through Thread.value).
# A block run this way is in a thread: `break` and `return` out of it are errors, and the locals of the
# blocks around the call are copies (spec §15, Threads). `Timeout.timeout(nil) { }` and `0` run the block
# directly, as Ruby.
#
# Ruby's `timeout(sec, klass = nil, message = nil)`: `klass`, an exception class to raise instead, has no
# counterpart (exception types are not values); it is accepted only as nil, so Ruby's
# `Timeout.timeout(5, nil, "msg")` reads unchanged. Ruby's Timeout::Error is `TimeoutError` (no nested names).
# A block that rescues every error (a bare rescue) swallows the interruption, as in Ruby.

class TimeoutError < StandardError
end

module Timeout
  module_function

  def timeout(sec, klass = nil, message = nil)
    return yield if sec == nil || sec == 0
    raise ArgumentError, "Timeout sec must be a non-negative number" if sec < 0
    raise ArgumentError, "Timeout.timeout: klass is not supported (exception types are not values)" if klass != nil
    t = Thread.new { yield }
    return Thread.value(t) if Thread.join(t, sec)
    expired = message || "execution expired"
    Thread.raise(t, expired)
    begin
      Thread.value(t) # the interruption, or the block's own result if it finished just now
    rescue => e
      raise TimeoutError, expired if Exception.message(e) == expired
      raise
    end
  end
end
