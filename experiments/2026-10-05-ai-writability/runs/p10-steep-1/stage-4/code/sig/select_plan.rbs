module Sql
  class SelectPlan
    attr_reader distinct: bool
    attr_reader from: FromPlan
    attr_reader results: Array[Ast::Expr]
    attr_reader result_names: Array[String?]
    attr_reader where: Ast::Expr?
    attr_reader group_by: Array[Ast::Expr]
    attr_reader having: Ast::Expr?
    attr_reader order_by: Array[Ast::OrderTerm]
    attr_reader limit: Ast::Expr?
    attr_reader offset: Ast::Expr?
    attr_reader aggregates: Array[Ast::Aggregate]
    attr_reader width: Integer
    attr_reader local_width: Integer
    attr_reader outer_width: Integer

    @grouped: bool

    def self.build: (Ast::Select select, Catalog catalog, Scope? parent) -> SelectPlan
    def self.resolve_results: (Array[Ast::SelectItem] items, Scope scope, Hash[String, Ast::Expr] aliases, Array[String?] names, AggregateSlots slots) -> Array[Ast::Expr]
    def self.plan_group_term: (Ast::Expr expr, Integer index, Array[Ast::Expr] results, Resolver scope) -> Ast::Expr
    def self.plan_term: (Ast::OrderTerm term, Integer index, Array[Ast::Expr] results, Hash[String, Ast::Expr] aliases, Resolver scope) -> Ast::OrderTerm
    def self.literal_position: (Ast::Expr expr) -> Integer?
    def self.ordinal: (Integer n) -> String
    def initialize: (distinct: bool, from: FromPlan, results: Array[Ast::Expr], result_names: Array[String?], where: Ast::Expr?, group_by: Array[Ast::Expr], having: Ast::Expr?, order_by: Array[Ast::OrderTerm], limit: Ast::Expr?, offset: Ast::Expr?, aggregates: Array[Ast::Aggregate]?, width: Integer, local_width: Integer, outer_width: Integer) -> void
    def result_types: () -> Array[column_type?]
    def grouped?: () -> bool
  end
end
