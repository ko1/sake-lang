# Text scalar functions (spec 2.4): substr, trim / ltrim / rtrim, replace, instr.
# Arguments are non-NULL values; `text` is always a value's text form (substr_range is also used for BLOBs).
module TextFunctions
  module_function

  # An "infinite" length for substr without a third argument.
  def unbounded = 4611686018427387904

  # The characters of `text` selected by substr's `start` and `len`.
  def substr(text, start, len)
    first, count = substr_range(String.size(text), start, len)
    String.slice(text, first, count)
  end

  # substr's selection (2.4) of a value `l` characters (or bytes) long: the 0-based first position and
  # the count, which is 0 when nothing is selected.
  def substr_range(l, start, len)
    p = start
    q = len
    if p < 0
      p += l
      if p < 0
        q += p
        p = 0
        q = 0 if q < 0
      end
    elsif p > 0
      p -= 1
    elsif q > 0
      q -= 1
    end
    if q < 0
      q = -q
      p -= q
      if p < 0
        q += p
        p = 0
      end
    end
    first = p
    last = Integer.clamp(p + q, 0, l)
    return [0, 0] if q <= 0 || first >= last
    [first, last - first]
  end

  # Removes the characters of `chars` from the left and/or the right end of `text`.
  def trim(text, chars, left, right)
    cs = String.chars(text)
    set = String.chars(chars)
    from = 0
    to = Array.size(cs)
    from += 1 while left && from < to && Array.include?(set, Array.fetch(cs, from))
    to -= 1 while right && to > from && Array.include?(set, Array.fetch(cs, to - 1))
    String.slice(text, from, to - from)
  end

  def replace(text, from, to)
    return text if from == ""
    String.gsub(text, from) { to }
  end

  def instr(text, target)
    i = String.index(text, target)
    i == nil ? 0 : i + 1
  end
end
