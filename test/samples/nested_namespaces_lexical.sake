# A constant in a function body resolves where the function was written, also after `include` copies the
# function into a class elsewhere; `rescue Error` inside the module names the module's Error.
module Lib
  class Error < StandardError
    attr_reader code
  end

  module Util                          # a mixin whose body names Lib::Error as `Error`
    def boom(x) = raise Error.new("bad #{label(x)}", 7)
  end

  module_function
  def try = (begin; raise Error.new("inner", 1); rescue Error => e; Exception.message(e); end)
end

class App
  include Lib::Util
  attr_reader label
end

begin
  App.boom(App.new("app"))
rescue Lib::Error => e
  puts(Exception.message(e), Lib::Error.code(e))
end
puts(Lib.try)
