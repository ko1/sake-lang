<!DOCTYPE html>
<html>
<head>
  <title><%= content_for?(:title) ? yield(:title) : "Blog" %></title>
  <%= csrf_meta_tags %>
</head>
<body>
<p class="user"><%= greeting "Hello" %> <%= current_user %> on <%= controller_name %>#<%= action_name %></p>
<% if notice %><p class="notice"><%= notice %></p><% end %>
<%= yield %>
</body>
</html>
