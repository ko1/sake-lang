require "diff"

def show_hunks(label, hunks)
  puts("#{label}:")
  Array.each(hunks) { |h| puts("  #{Kernel.inspect(h)}") }
end

seq1 = Array["a", "b", "c", "e", "h", "j", "l", "m", "n", "p"]
seq2 = Array["b", "c", "d", "e", "f", "j", "k", "l", "m", "r", "s", "t"]

puts("== lcs")
p(DiffLCS.lcs(seq1, seq2))
p(DiffLCS.lcs("abcxyz", "xbczya"))
p(DiffLCS.lcs(Array[1, 2, 3], Array[4, 5]))
p(DiffLCS.lcs(Array[], Array[1]))

puts("== diff")
d = DiffLCS.diff(seq1, seq2)
show_hunks("seq", d)
show_hunks("strings", DiffLCS.diff("abcd", "acbd"))
show_hunks("same", DiffLCS.diff("same", "same"))
show_hunks("to empty", DiffLCS.diff(Array[1, 2], Array[]))
Array.each(Array.first(d) || Array[]) do |c|
  p([DiffChange.action(c), DiffChange.position(c), DiffChange.element(c), DiffChange.adding?(c), DiffChange.deleting?(c)])
end

puts("== sdiff")
s = DiffLCS.sdiff(seq1, seq2)
Array.each(s) { |c| p(c) }
p(Array.map(DiffLCS.sdiff("abc", "axc")) { |c| DiffContextChange.to_a(c) })
p(Array.count(s) { |c| DiffContextChange.changed?(c) })
p(Array.map(DiffLCS.sdiff(Array[], Array["x"])) { |c| DiffContextChange.to_a(c) })

puts("== traverse")
DiffLCS.traverse_sequences("abc", "bcd") { |kind, i, j| puts("#{kind} #{i} #{j}") }
DiffLCS.traverse_balanced("abc", "xbz") { |kind, i, j| puts("#{kind} #{i} #{j}") }

puts("== patch")
p(DiffLCS.patch(seq1, d) == seq2)
p(DiffLCS.unpatch(seq2, d) == seq1)
p(DiffLCS.patch(seq1, s) == seq2)
p(DiffLCS.unpatch(seq2, s) == seq1)
p(DiffLCS.patch("kitten", DiffLCS.diff("kitten", "sitting")))
p(DiffLCS.patch("kitten", DiffLCS.sdiff("kitten", "sitting")))
p(DiffLCS.unpatch("sitting", DiffLCS.diff("kitten", "sitting")))
p(DiffLCS.patch("abc", Array[]))

puts("== lines")
old = String.lines("one\ntwo\nthree\nfour\nfive\n")
nw = String.lines("zero\none\nthree\nfour\n4.5\nfive\n")
DiffLCS.sdiff(old, nw).Array.each do |c|
  case DiffContextChange.action(c)
  in "=" then print("  ", DiffContextChange.old_element(c))
  in "-" then print("- ", DiffContextChange.old_element(c))
  in "+" then print("+ ", DiffContextChange.new_element(c))
  in "!"
    print("- ", DiffContextChange.old_element(c))
    print("+ ", DiffContextChange.new_element(c))
  end
end
words = DiffLCS.lcs(String.split("the quick brown fox jumps", " "), String.split("the slow brown dog jumps high", " "))
p(words)

puts("== errors")
begin
  actions = Array[:bad, "-"]
  DiffChange.new(actions[0], 0, "x")
rescue NoMatchingPatternError => e
  puts("NoMatchingPatternError")
end
