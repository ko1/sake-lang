# Port of activerecord-8.1.3/lib/arel/expressions.rb

module Arel
  module Expressions
    def count(e, distinct = false) = Nodes::Count.new(Any[e], distinct)
    def sum(e) = Nodes::Sum.new(Any[e])
    def maximum(e) = Nodes::Max.new(Any[e])
    def minimum(e) = Nodes::Min.new(Any[e])
    def average(e) = Nodes::Avg.new(Any[e])
    def extract(e, field) = Nodes::Extract.new(Any[e], field)
  end
end
