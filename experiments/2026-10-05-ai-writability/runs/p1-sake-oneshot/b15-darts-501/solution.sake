def dart_points(tok)
  return [25, false] if tok == "25"
  return [50, true] if tok == "BULL"
  return [0, false] if tok == "MISS"
  m = String.match(tok, /\A([STD])([1-9]|1\d|20)\z/)
  return nil if m == nil
  n = String.to_i(m[2])
  k = m[1]
  if k == "S"
    [n, false]
  elsif k == "D"
    [2 * n, true]
  else
    [3 * n, false]
  end
end

def header_ok(f)
  return false if Array.size(f) < 2 || Array.size(f) > 5
  return false unless String.match?(f[0], /\A\d+\z/)
  start = String.to_i(f[0])
  return false if start < 2 || start > 1001
  names = Array.drop(f, 1)
  return false unless Array.all?(names) { String.match?(it, /\A[a-z]{1,10}\z/) }
  Array.size(Array.uniq(names)) == Array.size(names)
end

def main
  lines = String.lines(IO.read(IO.stdin))
  if Array.empty?(lines)
    puts("invalid header")
    return
  end
  hf = String.split(lines[0])
  unless header_ok(hf)
    puts("invalid header")
    return
  end
  start = String.to_i(hf[0])
  names = Array.drop(hf, 1)
  left = Hash[]
  turns = Hash[]
  thrown = Hash[]
  Array.each(names) do |nm|
    left[nm] = start
    turns[nm] = 0
    thrown[nm] = 0
  end
  winner = nil
  Array.each_with_index(lines) do |raw, i|
    next if i == 0
    n = i + 1
    line = String.strip(raw)
    next if String.empty?(line)
    f = String.split(line)
    name = f[0]
    darts = Array.drop(f, 1)
    if winner != nil
      puts("line #{n}: game over")
    elsif !Hash.key?(left, name)
      puts("line #{n}: unknown player #{name}")
    elsif Array.size(darts) < 1 || Array.size(darts) > 3
      puts("line #{n}: expected 1 to 3 darts")
    else
      bad = Array.find(darts) { dart_points(it) == nil }
      if bad != nil
        puts("line #{n}: bad dart #{bad}")
      else
        s0 = Hash.fetch(left, name)
        cur = s0
        total = 0
        count = 0
        state = "ok"
        last = ""
        Array.each(darts) do |d|
          next if state != "ok"
          pts, dbl = dart_points(d)
          count += 1
          nxt = cur - pts
          if nxt < 0 || nxt == 1 || (nxt == 0 && !dbl)
            state = "bust"
          elsif nxt == 0
            state = "out"
            last = d
            cur = 0
          else
            cur = nxt
            total += pts
          end
        end
        turns[name] += 1
        thrown[name] += count
        if state == "bust"
          puts("#{name} busts, #{s0} left")
        elsif state == "out"
          left[name] = 0
          winner = name
          puts("#{name} checks out with #{last}")
        else
          left[name] = cur
          puts("#{name} scores #{total}, #{cur} left")
        end
      end
    end
  end
  puts("STANDINGS")
  order = Array.sort_by(Array.each_with_index(names)) { |nm, i| [Hash.fetch(left, nm), i] }
  Array.each_with_index(order) do |(nm, _i), r|
    l = Hash.fetch(left, nm)
    th = Hash.fetch(thrown, nm)
    avg = th == 0 ? "-" : format("%.2f", (start - l) * 3.0 / th)
    puts(format("%d. %-10s %4d %3d %6s", r + 1, nm, l, Hash.fetch(turns, nm), avg))
  end
  puts(winner == nil ? "no winner" : "winner: #{winner}")
end

main
