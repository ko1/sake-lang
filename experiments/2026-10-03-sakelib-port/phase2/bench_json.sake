require "json"

# One document of about 15 KB: objects, arrays, escaped and non-ASCII strings, numbers.
items = Any[]
Integer.times(150) do |i|
  Array.push(items, Hash.of("id" => i, "name" => "item \"#{i}\"\n\tテスト", "price" => i * 1.25, "tags" => Any["a", "b", "c#{i}"], "ok" => i % 2 == 0, "none" => nil))
end
doc = JSON.generate(Hash.of("items" => items, "count" => 150))
t0 = Time.now
n = 0
Integer.times(1) do
  v = JSON.parse(doc)
  s = JSON.generate(v)
  n += String.size(s)
end
el = Time.to_f(Time.now) - Time.to_f(t0)
p [String.size(doc), n]
warn "work #{Float.round(el * 1000)}ms"
