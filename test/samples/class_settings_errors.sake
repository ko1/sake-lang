class A
  attr_acessor x            # a misspelled attr_ line
end
class B
  attr_reader x = 1, y      # a field with a default before one without
end
class C
  attr_reader x = Array[]   # a default must be a literal
end
class D
  attr_reader :x            # Ruby's symbols: the name is written bare
end
class E
  attr_reader x
end
class E
  attr_reader y             # fields are declared in the first `class E`
end
class F < {reader: [x]}     # the old form
end
class G < Comparable        # `<` takes a class; a module is included
end
D.set_x(D.new(1), 2)
class H < I                 # a cycle
end
class I < H
end
class Integer < A           # `class Integer` adds functions to the built-in type
end
class P
  private attr_reader secret
end
P.secret(P.new(1))
