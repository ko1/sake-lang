usage: tool [options] FILE...
  -v, --verbose            more output (repeatable)
  -c, --color              colorize output
  -j, --jobs VALUE         parallel jobs
  -o, --output VALUE       output file
  -I, --include VALUE      include path (repeatable)
  -n, --dry-run            do nothing
$ tool build.c -vv --jobs=4 -o out.bin util.c
    verbose  = 2
    jobs     = 4
    output   = "out.bin"
    files    = [build.c, util.c]
$ tool -I inc -Ilib --include vendor --no-color -nv main.c
    verbose  = 1
    color    = false
    include  = [inc, lib, vendor]
    dry-run  = true
    files    = [main.c]
$ tool -j8 --output=- -- -weird-file --jobs
    jobs     = 8
    files    = [-weird-file, --jobs]
$ tool - --dry-run --verbose --verbose
    verbose  = 2
    dry-run  = true
    files    = [-]
$ tool --jobs many
    error: --jobs needs an integer, got 'many' (in '--jobs')
$ tool --frobnicate
    error: unknown option --frobnicate (in '--frobnicate')
$ tool -vx
    error: unknown option -x (in '-vx')
$ tool --output
    error: --output needs a value (in '--output')
$ tool --dry-run=yes
    error: --dry-run does not take a value (in '--dry-run=yes')
$ tool --no-jobs 3
    error: unknown option --no-jobs (in '--no-jobs')
