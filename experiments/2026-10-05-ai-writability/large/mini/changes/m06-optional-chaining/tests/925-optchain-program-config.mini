let config = {"server": {"port": 8080, "hosts": ["a", "b"]}, "log": nil}
fn setting(path)
  let node = config
  for key in path do
    node = node?[key]
  end
  return node
end
print(setting(["server", "port"]), setting(["log", "level"]), setting(["server", "hosts", 1]))
print(config?.log?.level or "info", config?.server?.hosts?[0:1])
try
  print(setting(["server", "missing", "x"]))
catch e
  print(e.kind, e.message, e.line, e.col)
end
let err = nil
try throw nil catch e err = e end
print(err?.message)
try 1 / 0 catch e err = e end
print(err?.message, err?["kind"])
