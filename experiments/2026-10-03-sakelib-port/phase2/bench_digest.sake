# Digest bench: arguments = [md5|sha1|sha256|sha512, KiB]; KiB 0 is the start-up baseline.
require "digest"
args = Kernel.ARGV
alg = args[0]
s = String.*("abcdefgh", String.to_i(args[1]) * 128)
h = if alg == "md5" then MD5.hexdigest(s)
    elsif alg == "sha1" then SHA1.hexdigest(s)
    elsif alg == "sha256" then SHA256.hexdigest(s)
    else SHA512.hexdigest(s)
    end
puts(h)
