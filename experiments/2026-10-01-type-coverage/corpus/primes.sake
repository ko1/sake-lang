def prime?(n)
  return false if n < 2
  d = 2
  while d * d <= n
    return false if n % d == 0
    d += 1
  end
  true
end

primes = Integer[]
Integer.upto(2, 99) { |i| Array.push(primes, i) if prime?(i) }

puts(Array.join(Array.map(primes) { |x| Integer.to_s(x) }, " "))
puts(String.+("count: ", Integer.to_s(Array.length(primes))))
puts(String.+("sum: ", Integer.to_s(Array.sum(primes))))
