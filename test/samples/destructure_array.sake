# Multiple assignment and block parameters take an Array apart; as Ruby, missing elements are nil
# and extra elements are dropped.
key, value = String.split("name=sake", "=")
p([key, value])
Array.each_cons(Any[1, 2, 3, 4], 2) { |a, b| p(b - a) }
Array.each(Any[Any["x", 1], Any["y", 2]]) { |k, v| p([k, v]) }
a, b = String.split("only", "=")
p([a, b])
x, y = Any[1, 2, 3]
p([x, y])
Array.each_slice(Any[1, 2, 3], 2) { |l, r| p([l, r]) }
