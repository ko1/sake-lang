# FIXED 2026-10-11 (experiments/2026-10-11-libraries3/README.md); kept as the record of the bug.
# Array.flatten leaves the groups of String.scan (with capture groups) nested: prints [["ab", "cd"]]; Ruby prints ["ab", "cd"].
re = Regexp.new("\\A(?<a>[a-z]*)/(?<b>[a-z]*)?\\z")
p(String.scan("ab/cd", re))
p(Array.flatten(String.scan("ab/cd", re)))
md = String.match("ab/cd", re)
p(MatchData.captures(md)) if md
