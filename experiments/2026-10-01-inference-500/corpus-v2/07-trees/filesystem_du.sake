Dir = Struct.new(:name, :parent, :subdirs, :files)
FileEntry = Struct.new(:name, :size, :dir)
NotFound = Exception.new(:path)

class Dir
  def create(name, parent) = Dir.new(name, parent, Hash[], Array[])

  def path(d)
    parent = @parent
    return "/" if parent == nil
    pp = path(parent)
    pp == "/" ? "/#{@name}" : "#{pp}/#{@name}"
  end

  def mkdir_p(root, parts)
    d = root
    Array.each(parts) do |name|
      kids = Dir.get_subdirs(d)
      sub = kids[name]
      if sub == nil
        sub = Dir.create(name, d)
        kids[name] = sub
      end
      d = sub
    end
    d
  end

  def total(d)
    own = Array.sum(Array.map(@files) { |f| FileEntry.get_size(f) })
    Array.reduce(Hash.values(@subdirs), own) { |acc, s| acc + total(s) }
  end
end

def human(n)
  return "#{n}B" if n < 1024
  return format("%.1fK", n / 1024.0) if n < 1024 * 1024
  format("%.1fM", n / (1024.0 * 1024))
end

def resolve(root, cwd, path)
  d = String.start_with?(path, "/") ? root : cwd
  Array.each(String.split(path, "/")) do |part|
    next if part == "" || part == "."
    if part == ".."
      up = Dir.get_parent(d)
      d = up if up != nil
    else
      nxt = Dir.get_subdirs(d)[part]
      raise NotFound.new("no such directory: #{path}", path) if nxt == nil
      d = nxt
    end
  end
  d
end

def print_tree(d, indent, max_depth)
  label = indent == "" ? "/" : "#{Dir.get_name(d)}/"
  puts(format("%-28s %8s", indent + label, human(Dir.total(d))))
  return if String.size(indent) / 2 >= max_depth
  subs = Array.sort_by(Hash.values(Dir.get_subdirs(d))) { |s| -Dir.total(s) }
  Array.each(subs) { |s| print_tree(s, indent + "  ", max_depth) }
  files = Dir.get_files(d)
  puts(format("%-28s %8s", indent + "  (#{Array.size(files)} files)", "")) if Array.size(files) > 0
end

def each_dir(d)
  yield(d)
  Hash.each_value(Dir.get_subdirs(d)) { |s| each_dir(s) { |x| yield(x) } }
end

listing = <<~LS
  /etc/hosts 220
  /etc/nginx/nginx.conf 2400
  /etc/nginx/sites/default.conf 900
  /etc/nginx/sites/api.conf 1300
  /home/ann/notes.txt 5300
  /home/ann/photos/cat.jpg 840000
  /home/ann/photos/dog.jpg 1250000
  /home/ann/photos/raw/IMG_0001.cr2 9800000
  /home/bob/.bashrc 3100
  /home/bob/src/app/main.rb 12000
  /home/bob/src/app/util.rb 4100
  /home/bob/src/app/test/main_test.rb 7700
  /home/bob/src/lib/parser.rb 26000
  /var/log/syslog 3400000
  /var/log/nginx/access.log 2100000
  /var/log/nginx/error.log 64000
  /var/cache/apt/pkgcache.bin 31000000
LS

root = Dir.create("", nil)
all_files = Array[]
String.each_line(listing) do |line|
  path, size = String.split(String.strip(line), " ")
  parts = String.split(path, "/")
  Array.shift(parts)
  name = Array.pop(parts)
  dir = Dir.mkdir_p(root, parts)
  f = FileEntry.new(name, String.to_i(size), dir)
  Array.push(Dir.get_files(dir), f)
  Array.push(all_files, f)
end

print_tree(root, "", 3)

puts("-- directories over 1M --")
big = Array[]
each_dir(root) { |d| Array.push(big, d) if Dir.total(d) > 1024 * 1024 }
Array.each(Array.sort_by(big) { |d| Dir.path(d) }) { |d| puts(format("  %-24s %s", Dir.path(d), human(Dir.total(d)))) }

puts("-- largest files --")
top = Array.take(Array.sort_by(all_files) { |f| -FileEntry.get_size(f) }, 3)
Array.each(top) { |f| puts("  #{Dir.path(FileEntry.get_dir(f))}/#{FileEntry.get_name(f)} #{human(FileEntry.get_size(f))}") }

puts("-- by extension --")
by_ext = Hash.new(0)
Array.each(all_files) do |f|
  name = FileEntry.get_name(f)
  dot = String.rindex(name, ".")
  ext = dot == nil || dot == 0 ? "(none)" : name[(dot + 1)..]
  by_ext[ext] += FileEntry.get_size(f)
end
Array.each(Array.sort_by(Hash.to_a(by_ext)) { |_e, s| -s }) { |e, s| puts(format("  %-7s %s", e, human(s))) }

puts("-- navigation --")
cwd = resolve(root, root, "/home/bob/src")
Array.each(Array["app/test", "../..", "../../ann/photos/raw", "/var/log/nginx", "lib/missing", "/../etc"]) do |p|
  begin
    target = resolve(root, cwd, p)
    puts("  cd #{p} -> #{Dir.path(target)} (#{human(Dir.total(target))})")
  rescue NotFound => e
    puts("  cd #{p} -> error: #{Exception.message(e)}")
  end
end
