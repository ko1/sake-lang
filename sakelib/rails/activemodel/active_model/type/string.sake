# Port of activemodel-8.1.3/lib/active_model/type/immutable_string.rb and string.rb (one file: String < ImmutableString)
#
# Ruby's ImmutableString.new(true: "1", false: "0") keeps them as @true and @false; here the fields are
# true_s and false_s (`true` and `false` cannot be field names), set to "t" and "f" when not given.

module ActiveModel
  module Type
    class ImmutableString
      attr_reader precision, scale, limit
      private attr_accessor true_s, false_s
      include Value
      include Helpers::Immutable

      def initialize(t)
        @true_s ||= "t"
        @false_s ||= "f"
      end

      def type(t) = :string

      def serialize(t, value)
        case value
        in ::Integer | ::Float | ::Rational | BigDecimal | Symbol then Kernel.to_s(value)
        in true then @true_s
        in false then @false_s
        else value
        end
      end

      def serialize_cast_value(t, value) = value

      def cast_value(t, value)
        case value
        in true then @true_s
        in false then @false_s
        else Kernel.to_s(value)
        end
      end
    end

    class String < ImmutableString
      def changed_in_place?(t, raw_old_value, new_value)
        (new_value in ::String) && !ActiveModel::Type.same_value?(raw_old_value, new_value)
      end
      def mutable?(t) = true
      def to_immutable_string(t)
        ImmutableString.new(true_s: @true_s, false_s: @false_s, limit: @limit, precision: @precision, scale: @scale)
      end
    end
  end
end
