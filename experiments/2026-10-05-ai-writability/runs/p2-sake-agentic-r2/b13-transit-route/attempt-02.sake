def better(a, b) = a < b

# labels: state [station, last line] -> [T, K, stations, lines]
def search(adj, p, src)
  best = Hash[]
  best[[src, ""]] = [0, 0, String[src], String[]]
  changed = true
  while changed
    changed = false
    Array.each(Hash.keys(best)) do |st|
      lab = best[st]
      here = st[0]
      last = st[1]
      next unless Hash.key?(adj, here)
      Array.each(adj[here]) do |e|
        ln = e[0]
        to = e[1]
        mins = e[2]
        t = lab[0] + mins
        k = lab[1]
        if last != "" && last != ln
          t += p
          k += 1
        end
        nl = [t, k, Array.+(lab[2], String[to]), Array.+(lab[3], String[ln])]
        key = [to, ln]
        if !Hash.key?(best, key) || better(nl, best[key])
          best[key] = nl
          changed = true
        end
      end
    end
  end
  best
end

def route_line(stations, lines)
  legs = String[]
  i = 0
  n = Array.size(lines)
  while i < n
    ln = lines[i]
    seg = String[stations[i]]
    while i < n && lines[i] == ln
      Array.push(seg, stations[i + 1])
      i += 1
    end
    Array.push(legs, "#{ln}: #{Array.join(seg, " > ")}")
  end
  "  " + Array.join(legs, "; ")
end

def answer(adj, p, from, to)
  head = "#{from} -> #{to}: "
  return puts(head + "unknown station #{from}") unless Hash.key?(adj, from)
  return puts(head + "unknown station #{to}") unless Hash.key?(adj, to)
  return puts(head + "0 min, 0 transfers") if from == to
  best = search(adj, p, from)
  found = nil
  Hash.each(best) do |st, lab|
    if st[0] == to && (found == nil || better(lab, found))
      found = lab
    end
  end
  if found == nil
    puts(head + "no route")
    return
  end
  k = found[1]
  puts(head + "#{found[0]} min, #{k} #{k == 1 ? "transfer" : "transfers"}")
  puts(route_line(found[2], found[3]))
end

adj = Hash[]
p_ = 0
queries = false
n = 0
Array.each(IO.readlines(IO.stdin())) do |raw|
  n += 1
  line = String.strip(raw)
  next if String.empty?(line)
  if n == 1
    p_ = String.to_i(line)
    next
  end
  if !queries
    if line == "QUERIES"
      queries = true
      next
    end
    f = String.split(line)
    if Array.size(f) == 4 && String.match?(f[3], /\A[1-9]\d{0,2}\z/) && f[1] != f[2]
      m = String.to_i(f[3])
      adj[f[1]] = Tuple[] unless Hash.key?(adj, f[1])
      adj[f[2]] = Tuple[] unless Hash.key?(adj, f[2])
      Array.push(adj[f[1]], [f[0], f[2], m])
      Array.push(adj[f[2]], [f[0], f[1], m])
    else
      puts("invalid segment at line #{n}")
    end
  else
    f = String.split(line)
    if Array.size(f) == 2
      answer(adj, p_, f[0], f[1])
    else
      puts("invalid query at line #{n}")
    end
  end
end
