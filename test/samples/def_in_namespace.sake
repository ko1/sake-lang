# Inside `module Admin`, `def PostsC.f` is Admin::PostsC.f, as Ruby finds the constant (generated code adds
# functions to a namespaced class this way).
module Admin
  def PostsC.f(c) = "gen #{g(c)}"
end
module Admin
  class PostsC
    attr_reader x
    def g(c) = @x
  end
end
p(Admin::PostsC.f(Admin::PostsC.new(1)))
