# The prelude: read before every program (Sake.load), as if the program began with `require "prelude"`.
#
# Enum is Enumerable under a short name. `Enum.map(x) { }`, `Enum.select(x) { }`, ... dispatch on the
# type of x: Array, Hash, Set and Range include Enum and answer with their own operations, so
# `Enum.map(xs)` is `Array.map(xs)` when xs is an Array. A class of the program joins with
# `include Enum` and `def each(c) = ... yield(v) ...`: every other function here is written over
# `each`, so the class gets all of them. (Tuple does not include Enum: its length and position types
# are fixed, so it is indexed and destructured rather than iterated.)
module Enum
  def each(x) = raise NotImplementedError

  def map(x)
    out = Array[]
    each(x) { |v| Array.push(out, yield(v)) }
    out
  end

  def select(x)
    out = Array[]
    each(x) { |v| Array.push(out, v) if yield(v) }
    out
  end

  def filter(x)
    out = Array[]
    each(x) { |v| Array.push(out, v) if yield(v) }
    out
  end

  def reject(x)
    out = Array[]
    each(x) { |v| Array.push(out, v) unless yield(v) }
    out
  end

  def filter_map(x)
    out = Array[]
    each(x) do |v|
      r = yield(v)
      Array.push(out, r) if r
    end
    out
  end

  def flat_map(x)
    out = Array[]
    each(x) { |v| Array.concat(out, Array.to_a(yield(v))) }
    out
  end

  def find(x)
    each(x) { |v| return v if yield(v) }
    nil
  end

  def detect(x)
    each(x) { |v| return v if yield(v) }
    nil
  end

  def reduce(x, init)
    acc = init
    each(x) { |v| acc = yield(acc, v) }
    acc
  end

  def inject(x, init)
    acc = init
    each(x) { |v| acc = yield(acc, v) }
    acc
  end

  def sum(x, init = 0)
    acc = init
    each(x) { |v| acc += block_given? ? yield(v) : v }
    acc
  end

  def count(x)
    n = 0
    each(x) { |v| n += 1 if !block_given? || yield(v) }
    n
  end

  def include?(x, v)
    each(x) { |e| return true if e == v }
    false
  end

  def any?(x)
    each(x) { |v| return true if block_given? ? yield(v) : v }
    false
  end

  def all?(x)
    each(x) { |v| return false unless block_given? ? yield(v) : v }
    true
  end

  def none?(x)
    each(x) { |v| return false if block_given? ? yield(v) : v }
    true
  end

  def one?(x)
    n = 0
    each(x) { |v| n += 1 if block_given? ? yield(v) : v }
    n == 1
  end

  def min_by(x)
    best = nil
    key = nil
    each(x) do |v|
      k = yield(v)
      if key == nil || k < key
        best = v
        key = k
      end
    end
    best
  end

  def max_by(x)
    best = nil
    key = nil
    each(x) do |v|
      k = yield(v)
      if key == nil || k > key
        best = v
        key = k
      end
    end
    best
  end

  def sort_by(x)
    Array.sort_by(to_a(x)) { |v| yield(v) }
  end

  def to_a(x)
    out = Array[]
    each(x) { |v| Array.push(out, v) }
    out
  end

  def first(x, n = nil)
    if n == nil
      each(x) { |v| return v }
      return nil
    end
    out = Array[]
    each(x) do |v|
      break if Array.size(out) >= n
      Array.push(out, v)
    end
    out
  end

  def take(x, n)
    out = Array[]
    each(x) do |v|
      break if Array.size(out) >= n
      Array.push(out, v)
    end
    out
  end

  def drop(x, n)
    out = Array[]
    i = 0
    each(x) do |v|
      Array.push(out, v) if i >= n
      i += 1
    end
    out
  end

  def group_by(x)
    groups = Hash.new
    each(x) do |v|
      k = yield(v)
      groups[k] = Array[] unless Hash.key?(groups, k)
      Array.push(Hash.fetch(groups, k), v)
    end
    groups
  end

  def partition(x)
    yes = Array[]
    no = Array[]
    each(x) { |v| Array.push(yield(v) ? yes : no, v) }
    [yes, no]
  end

  def each_with_object(x, memo)
    each(x) { |v| yield(v, memo) }
    memo
  end

  def compact(x)
    out = Array[]
    each(x) { |v| Array.push(out, v) if v != nil }
    out
  end
end
