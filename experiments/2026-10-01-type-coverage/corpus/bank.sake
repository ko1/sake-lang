Account = Data.define(:owner, :balance, :history)

def open_account(owner) = Account.new(owner, 0, Array[])

class Account
  def deposit(acct, amount)
    set_balance(acct, get_balance(acct) + amount)
    Array.push(get_history(acct), ["deposit", amount])
  end

  def withdraw(acct, amount)
    if get_balance(acct) < amount
      Array.push(get_history(acct), ["refused", amount])
      return false
    end
    set_balance(acct, get_balance(acct) - amount)
    Array.push(get_history(acct), ["withdraw", amount])
    true
  end

  def statement(acct)
    puts(String.+("Statement for ", get_owner(acct)))
    Array.each(get_history(acct)) { |entry|
      kind, amount = entry
      puts(String.+("  ", String.+(String.ljust(kind, 10), Integer.to_s(amount))))
    }
    puts(String.+("  balance: ", Integer.to_s(get_balance(acct))))
  end
end

alice = open_account("Alice")
bob = open_account("Bob")

Account.deposit(alice, 100)
Account.withdraw(alice, 30)
Account.withdraw(alice, 200)
Account.deposit(bob, 50)
Account.withdraw(bob, 60)
Account.deposit(bob, 25)
Account.withdraw(bob, 70)

Account.statement(alice)
Account.statement(bob)
