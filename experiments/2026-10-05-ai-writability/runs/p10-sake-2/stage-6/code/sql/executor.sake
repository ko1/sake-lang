# Runs one parsed statement against the database and returns the lines it prints.
module Executor
  module_function

  def run(db, stmt)
    case stmt
    in SelectStmt then Select.run(db, stmt)
    in InsertStmt then Insert.run(db, stmt)
    in UpdateStmt then Update.run(db, stmt)
    in DeleteStmt then Delete.run(db, stmt)
    in CompoundStmt then Select.run(db, stmt)
    in WithStmt then run_with(db, stmt)
    in CreateStmt then done(Catalog.create_table(db, stmt))
    in DropStmt then done(Catalog.drop_table(db, stmt))
    in CreateViewStmt then done(Views.create(db, stmt))
    in DropViewStmt then done(Views.drop(db, stmt))
    in CreateIndexStmt then done(Indexes.create(db, stmt))
    in DropIndexStmt then done(Indexes.drop(db, stmt))
    in AlterAddStmt then done(Alter.add_column(db, stmt))
    in RenameTableStmt then done(Alter.rename_table(db, stmt))
    in RenameColumnStmt then done(Alter.rename_column(db, stmt))
    in TxnStmt then done(Transaction.run(db, stmt))
    end
  end

  # WITH ... INSERT runs the insert with the ctes in sight; WITH ... SELECT is a query like any other.
  def run_with(db, stmt)
    body = WithStmt.body(stmt)
    case body
    in InsertStmt then Insert.run(Ctes.layer(db, stmt), body)
    else Select.run(db, stmt)
    end
  end

  # A statement that prints nothing.
  def done(result)
    String[]
  end
end
