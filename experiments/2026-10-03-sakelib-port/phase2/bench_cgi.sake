require "cgi"

# 20 KB of mixed ASCII, reserved characters, and Japanese: URL and HTML escaping both ways.
s = "Tom & 'Jerry' <b>\"日本語\"</b> a+b=c/d?e " * 500
t0 = Time.now
e = CGI.escape(s)
u = CGI.unescape(e)
c = CGI.unescapeURIComponent(CGI.escapeURIComponent(s))
h = CGI.escapeHTML(s)
uh = CGI.unescapeHTML(h + "&#x65e5;&#26412;" * 200)
el = Time.to_f(Time.now) - Time.to_f(t0)
p [String.size(e), u == s, c == s, String.size(h), String.size(uh)]
warn "work #{Float.round(el * 1000)}ms"
