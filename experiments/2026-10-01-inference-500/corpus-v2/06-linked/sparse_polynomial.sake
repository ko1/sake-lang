Term = Struct.new(:coef, :exp, :next)

class Poly < {reader: [terms]}
  include Arithmetic

  def from_pairs(pairs)
    result = Poly.new(nil)
    Array.each(pairs) { |c, e| add_term!(result, c, e) }
    result
  end

  def add_term!(poly, coef, exp)
    return poly if coef == 0
    prev = nil
    cur = @terms
    while cur && Term.get_exp(cur) > exp
      prev = cur
      cur = Term.get_next(cur)
    end
    if cur && Term.get_exp(cur) == exp
      sum = Term.get_coef(cur) + coef
      if sum == 0
        prev ? Term.set_next(prev, Term.get_next(cur)) : @terms = Term.get_next(cur)
      else
        Term.set_coef(cur, sum)
      end
    else
      fresh = Term.new(coef, exp, cur)
      prev ? Term.set_next(prev, fresh) : @terms = fresh
    end
    poly
  end

  def each_term(poly)
    t = @terms
    while t
      yield(Term.get_coef(t), Term.get_exp(t))
      t = Term.get_next(t)
    end
  end

  def +(a, b)
    out = Poly.new(nil)
    each_term(a) { |c, e| add_term!(out, c, e) }
    each_term(b) { |c, e| add_term!(out, c, e) }
    out
  end

  def -(a, b)
    out = Poly.new(nil)
    each_term(a) { |c, e| add_term!(out, c, e) }
    each_term(b) { |c, e| add_term!(out, -c, e) }
    out
  end

  def *(a, b)
    out = Poly.new(nil)
    each_term(a) do |c1, e1|
      each_term(b) { |c2, e2| add_term!(out, c1 * c2, e1 + e2) }
    end
    out
  end

  def degree(poly) = @terms ? Term.get_exp(@terms) : 0

  def eval(poly, x)
    total = 0
    each_term(poly) { |c, e| total += c * x ** e }
    total
  end

  def derivative(poly)
    out = Poly.new(nil)
    each_term(poly) { |c, e| add_term!(out, c * e, e - 1) if e > 0 }
    out
  end

  def power(poly, n)
    result = Poly.from_pairs(Array[[1, 0]])
    Integer.times(n) { result = result * poly }
    result
  end

  def to_s(poly)
    return "0" if @terms == nil
    s = ""
    each_term(poly) do |c, e|
      sign = c < 0 ? "-" : "+"
      mag = Kernel.to_s((Integer|Rational).abs(c))
      body = if e == 0
        mag
      elsif e == 1
        (mag == "1" ? "" : mag) + "x"
      else
        (mag == "1" ? "" : mag) + "x^#{e}"
      end
      s = String.empty?(s) ? (sign == "-" ? "-" : "") + body : s + " #{sign} " + body
    end
    s
  end
end

p1 = Poly.from_pairs(Array[[3, 2], [-2, 1], [5, 0]])
p2 = Poly.from_pairs(Array[[1, 1], [-1, 0]])
p3 = Poly.from_pairs(Array[[1, 3], [2, 3], [-3, 3], [4, 0]])
puts("p1 = #{p1}")
puts("p2 = #{p2}")
puts("p3 = #{p3} (degree #{Poly.degree(p3)})")
puts("p1 + p2 = #{p1 + p2}")
puts("p1 - p1 = #{p1 - p1}")
puts("p1 * p2 = #{p1 * p2}")
puts("(p1 * p2)' = #{Poly.derivative(p1 * p2)}")
puts("p2^5 = #{Poly.power(p2, 5)}")
Array.each(Array[-2, 0, 1, 3]) do |x|
  puts(format("x=%2d  p1=%4d  p1*p2=%5d  p2^5=%6d", x, Poly.eval(p1, x), Poly.eval(p1 * p2, x), Poly.eval(Poly.power(p2, 5), x)))
end

rational = Poly.from_pairs(Array[[1/2r, 2], [1/3r, 0]])
puts("r = #{rational}, r(3) = #{Poly.eval(rational, 3)}")
sum = Poly.new(nil)
Range.each(1..6) { |k| sum = sum + Poly.from_pairs(Array[[k, k % 3]]) }
puts("sum of k*x^(k%3), k=1..6: #{sum}")
