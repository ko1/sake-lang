class MenuItem
  attr_reader code, name, price, station
  attr_accessor stock
end

class Table
  attr_reader number, lines
  attr_accessor open
end

class SoldOut < StandardError
  attr_reader code
end

def modifier_price(mod)
  case mod
  in "extra cheese" then 150
  in "bacon" then 200
  in "large" then 100
  else 0
  end
end

class OrderLine
  attr_reader table, seat, item, mods, at
  attr_accessor status
  def price(l) = MenuItem.price(@item) + Array.sum(@mods) { |m| modifier_price(m) }
end

def money(c) = format("%d.%02d", c / 100, c % 100)

class Restaurant
  attr_reader menu, tables = nil, queue = nil

  def initialize(r)
    @tables = Hash[]
    @queue = OrderLine[]
  end

  def table(r, n)
    @tables[n] ||= Table.new(n, OrderLine[], true)
  end

  def order(r, n, seat, code, mods, at)
    item = Hash.fetch(@menu, code)
    raise SoldOut.new("#{MenuItem.name(item)} is sold out", code) if MenuItem.stock(item) == 0
    MenuItem.set_stock(item, MenuItem.stock(item) - 1)
    line = OrderLine.new(n, seat, item, mods, at, :queued)
    Array.push(Table.lines(table(r, n)), line)
    Array.push(@queue, line)
    line
  end

  # the kitchen cooks grill first, then fryer, then cold; older orders first
  def next_for(r, station)
    waiting = Array.select(@queue) { |l| OrderLine.status(l) == :queued && MenuItem.station(OrderLine.item(l)) == station }
    first = Array.min_by(waiting) { |l| OrderLine.at(l) }
    OrderLine.set_status(first, :served) if first
    first
  end
end

def bill(t, split)
  lines = Table.lines(t)
  subtotal = Array.sum(lines) { |l| OrderLine.price(l) }
  tax = Float.round(subtotal * 0.0875)
  tip = Float.round(subtotal * 0.18)
  total = subtotal + tax + tip
  puts("Table #{Table.number(t)}: subtotal #{money(subtotal)} tax #{money(tax)} tip #{money(tip)} total #{money(total)}")
  case split
  in :even
    seats = Array.size(Array.uniq(Array.map(lines) { |l| OrderLine.seat(l) }))
    share, extra = Integer.divmod(total, seats)
    Integer.times(seats) { |i| puts("  guest #{i + 1} pays #{money(share + (i < extra ? 1 : 0))}") }
  in :by_seat
    by_seat = Array.group_by(lines) { |l| OrderLine.seat(l) }
    Array.each(Array.sort(Hash.keys(by_seat))) do |seat|
      own = Array.sum(Hash.fetch(by_seat, seat)) { |l| OrderLine.price(l) }
      part = Float.round(own * total * 1.0 / subtotal)
      items = Array.map(Hash.fetch(by_seat, seat)) { |l| MenuItem.name(OrderLine.item(l)) }
      puts("  seat #{seat} pays #{money(part)} (#{Array.join(items, ", ")})")
    end
  end
  Table.set_open(t, false)
  total
end

menu = Hash[]
Array.each(Array[
  ["B1", "Burger", 1450, :grill, 10], ["B2", "Veggie burger", 1350, :grill, 1],
  ["F1", "Fries", 500, :fryer, 20], ["F2", "Onion rings", 650, :fryer, 2],
  ["S1", "Caesar salad", 1100, :cold, 5], ["D1", "Lemonade", 400, :cold, 30]
]) do |code, name, price, station, stock|
  menu[code] = MenuItem.new(code, name, price, station, stock)
end
r = Restaurant.new(menu)

orders = Array[
  [4, 1, "B1", Array["bacon", "extra cheese"], 1], [4, 2, "B2", Array[], 2],
  [4, 2, "F2", Array["large"], 3], [7, 1, "S1", Array[], 4], [7, 1, "D1", Array["large"], 5],
  [4, 3, "B2", Array[], 6], [7, 2, "B1", Array[], 7], [7, 3, "F2", Array[], 8],
  [9, 1, "F2", Array[], 9], [9, 1, "F1", Array[], 10], [4, 3, "B1", Array["no onion"], 11],
  [9, 2, "D1", Array[], 12]
]
Array.each(orders) do |n, seat, code, mods, at|
  Restaurant.order(r, n, seat, code, mods, at)
rescue SoldOut => e
  puts("t#{n} s#{seat}: #{Exception.message(e)} (#{SoldOut.code(e)})")
end

puts
puts("Kitchen:")
Array.each(Array[:grill, :fryer, :cold]) do |station|
  served = 0
  while (l = Restaurant.next_for(r, station))
    mods = OrderLine.mods(l)
    extra = Array.empty?(mods) ? "" : " [#{Array.join(mods, ", ")}]"
    puts(format("  %-5s t%d s%d %s%s", station, OrderLine.table(l), OrderLine.seat(l), MenuItem.name(OrderLine.item(l)), extra))
    served += 1
  end
  puts("  #{station}: #{served} plates")
end

puts
takings = 0
Array.each(Array[[4, :by_seat], [7, :even], [9, :even]]) do |n, split|
  takings += bill(Restaurant.table(r, n), split)
end
puts
puts("Takings: #{money(takings)}")
low = Array.select(Hash.values(menu)) { |m| MenuItem.stock(m) < 3 }
puts("Low stock: #{Array.join(Array.map(low) { |m| "#{MenuItem.name(m)}=#{MenuItem.stock(m)}" }, ", ")}")
open_tables = Array.count(Hash.values(Restaurant.tables(r))) { |t| Table.open(t) }
puts("Open tables: #{open_tables}")
