# Shell sort with three gap sequences, compared by comparison counts on
# several input shapes.

module Gaps
  module_function

  def shell(n)
    gaps = Array[]
    g = n / 2
    while g > 0
      Array.push(gaps, g)
      g /= 2
    end
    gaps
  end

  def knuth(n)
    gaps = Array[]
    g = 1
    while g < n
      Array.unshift(gaps, g)
      g = 3 * g + 1
    end
    gaps
  end

  def ciura(n)
    Array.select(Array[701, 301, 132, 57, 23, 10, 4, 1]) { |g| g < n }
  end

  def sequence(name, n)
    case name
    in :shell then shell(n)
    in :knuth then knuth(n)
    in :ciura then ciura(n)
    end
  end
end

def shell_sort(input, gaps)
  a = Array.dup(input)
  compares = 0
  Array.each(gaps) do |gap|
    Integer.upto(gap, Array.size(a) - 1) do |i|
      x = a[i]
      j = i
      while j >= gap
        compares += 1
        break unless a[j - gap] > x
        a[j] = a[j - gap]
        j -= gap
      end
      a[j] = x
    end
  end
  [a, compares]
end

def lcg_list(n, seed, mod)
  out = Array[]
  x = seed
  Integer.times(n) do
    x = (x * 1664525 + 1013904223) % 4294967296
    Array.push(out, x % mod)
  end
  out
end

def shapes(n)
  random = lcg_list(n, 42, 10000)
  ascending = Range.to_a(0...n)
  descending = Array.reverse(ascending)
  sawtooth = Array.map(ascending) { |i| i % 17 }
  few = lcg_list(n, 7, 4)
  almost = Array.dup(ascending)
  Integer.step(0, n - 2, 25) do |i|
    t = almost[i]
    almost[i] = almost[i + 1]
    almost[i + 1] = t
  end
  Hash["random" => random, "ascending" => ascending, "descending" => descending,
       "sawtooth" => sawtooth, "few-unique" => few, "almost" => almost]
end

n = 400
names = Array[:shell, :knuth, :ciura]
puts(format("%-11s %8s %8s %8s", "input", "shell", "knuth", "ciura"))
totals = Hash.new(0)
Hash.each(shapes(n)) do |label, data|
  expected = Array.join(Array.sort(data), ",")
  row = Array.map(names) do |name|
    sorted, compares = shell_sort(data, Gaps.sequence(name, n))
    raise "#{name} failed on #{label}" unless Array.join(sorted, ",") == expected
    totals[name] += compares
    compares
  end
  puts(format("%-11s %8d %8d %8d", label, row[0], row[1], row[2]))
end
best = Array.min_by(names) { |nm| totals[nm] }
puts("gaps for n=#{n}: knuth=#{Gaps.knuth(n)} ciura=#{Gaps.ciura(n)}")
puts("fewest comparisons overall: #{best} (#{totals[best]})")

words = String.split("pear fig apple kiwi banana cherry date grape lime mango nectarine olive", " ")
sorted_words, c = shell_sort(words, Gaps.ciura(Array.size(words)))
puts("#{Array.join(sorted_words, " ")} (#{c} comparisons)")
