# The part of ActiveSupport the Rails-shaped framework needs: SafeBuffer (Rails' html_safe String) and the
# inflector (sakelib's port).
#
# Ruby: "<b>".html_safe is a String subclass marked safe; `<%= x %>` escapes x unless it is one. Here the mark is
# the type: ActiveSupport::SafeBuffer holds the String, and ActionView::OutputBuffer.append escapes every other
# value. A helper that returns HTML returns a SafeBuffer, so the checker knows which values are already HTML.

require "active_support_inflector"
require "cgi"

module ActiveSupport
  class SafeBuffer
    attr_reader s
    include Arithmetic
    def to_s(b) = @s
    def to_str(b) = @s
    def +(a, b) = SafeBuffer.new(@s + ERB::Util.html_escape(b))
    def empty?(b) = String.empty?(@s)
  end
end

# ERB::Util as Rails extends it (html_escape keeps a SafeBuffer as it is).
class ERB
  module Util
    module_function
    def html_escape(x)
      case x
      in ActiveSupport::SafeBuffer then ActiveSupport::SafeBuffer.to_s(x)
      in nil then ""
      in String then CGI.escapeHTML(x)
      else CGI.escapeHTML(Kernel.to_s(x))
      end
    end
    def h(x) = html_escape(x)
  end
end

# Ruby: str.html_safe / raw(str)
def html_safe(s) = ActiveSupport::SafeBuffer.new(s)
