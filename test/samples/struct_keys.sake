# Struct values, Arrays, Sets and Hashes can be Hash keys and Set elements; they compare as == does.
P = Struct.new(:x, :y)
seen = Set[]
Set.add(seen, P.new(1, 2))
p(Set.include?(seen, P.new(1, 2)))
counts = Hash.new(0)
Array.each(Array[P.new(0, 0), P.new(0, 0), P.new(1, 0)]) { |pt| counts[pt] += 1 }
p(Hash.values(counts))
cycles = Hash[]
cycles[Array[1, 2, 3]] = "loop"
p(cycles[Array[1, 2, 3]])
p(Array.uniq(Array[Set[1, 2], Set[2, 1]]))
V = Struct.new(:n)
class V
  include Comparable
  def <=>(a, b) = @n <=> V.get_n(b)
end
s = Set[]
Set.add(s, V.new(1))
