def digit_chars(base) = Array.take(String.chars("0123456789abcdef"), base)

def to_base(n, base)
  return "0" if n == 0
  digits = digit_chars(base)
  s = ""
  while n > 0
    s = digits[n % base] + s
    n /= base
  end
  s
end

class Dfa
  attr_reader name, start, delta, accept
  def divisible_by(n, base)
    delta = Hash[]
    Integer.times(n) do |r|
      Array.each_with_index(digit_chars(base)) { |ch, d| delta[[r, ch]] = (r * base + d) % n }
    end
    Dfa.new("div#{n}/b#{base}", 0, delta, Set[0])
  end

  def run(dfa, word)
    s = @start
    String.each_char(word) do |c|
      s = @delta[[s, c]]
      return false if s == nil
    end
    Set.include?(@accept, s)
  end

  def states(dfa) = Array.uniq(Array.map(Hash.keys(@delta)) { |s, c| s })

  def product(a, b, mode, name)
    delta = Hash[]
    accept = Set[]
    start = [Dfa.start(a), Dfa.start(b)]
    work = Array[start]
    seen = Set[start]
    alphabet = Array.uniq(Array.map(Hash.keys(Dfa.delta(a))) { |s, c| c })
    until Array.empty?(work)
      pair = Array.pop(work)
      sa, sb = pair
      in_a = Set.include?(Dfa.accept(a), sa)
      in_b = Set.include?(Dfa.accept(b), sb)
      ok = case mode
           in :and then in_a && in_b
           in :or then in_a || in_b
           in :and_not then in_a && !in_b
           end
      Set.add(accept, pair) if ok
      Array.each(alphabet) do |c|
        ta = Dfa.delta(a)[[sa, c]]
        tb = Dfa.delta(b)[[sb, c]]
        next if ta == nil || tb == nil
        target = [ta, tb]
        delta[[pair, c]] = target
        unless Set.include?(seen, target)
          Set.add(seen, target)
          Array.push(work, target)
        end
      end
    end
    Dfa.new(name, start, delta, accept)
  end
end

def check(dfa, numbers, base)
  wrong = 0
  hits = Array[]
  Array.each(numbers) do |n|
    got = Dfa.run(dfa, to_base(n, base))
    want = yield(n)
    wrong += 1 if got != want
    Array.push(hits, n) if got
  end
  puts(format("%-22s states=%2d accepted=%3d wrong=%d first: %s", Dfa.name(dfa), Array.size(Dfa.states(dfa)),
    Array.size(hits), wrong, Array.join(Array.take(hits, 8), ",")))
end

nums = Range.to_a(1..150)
div3 = Dfa.divisible_by(3, 2)
div4 = Dfa.divisible_by(4, 2)
div7 = Dfa.divisible_by(7, 10)
div5 = Dfa.divisible_by(5, 10)
check(div3, nums, 2) { |n| n % 3 == 0 }
check(div4, nums, 2) { |n| n % 4 == 0 }
check(div7, nums, 10) { |n| n % 7 == 0 }
check(Dfa.product(div3, div4, :and, "div3 and div4"), nums, 2) { |n| n % 12 == 0 }
check(Dfa.product(div3, div4, :and_not, "div3 but not div4"), nums, 2) { |n| n % 3 == 0 && n % 4 != 0 }
check(Dfa.product(div7, div5, :or, "div7 or div5"), nums, 10) { |n| n % 7 == 0 || n % 5 == 0 }
check(Dfa.divisible_by(6, 16), nums, 16) { |n| n % 6 == 0 }
p(Dfa.run(div7, "12a"))
