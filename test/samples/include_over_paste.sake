# A module that B includes itself wins over what `class B < A` pasted, as in Ruby (ancestors: B, M, A).
class A
  attr_reader x
  def host(a) = "A"
  def port(a) = 80
end
module M
  def host(m) = "M"
  def url(m) = "#{host(m)}:#{port(m)}"
end
class B < A
  include M
end
p(B.url(B.new(1)))
p(A.host(A.new(1)))
