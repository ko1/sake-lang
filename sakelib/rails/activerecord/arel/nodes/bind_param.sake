# Port of activerecord-8.1.3/lib/arel/nodes/bind_param.rb (partial: no hash/eql?)
#
# Ruby asks the value `respond_to?(:value_before_type_cast)`; here the value is an ActiveModel::Attribute or a
# plain value, told apart by a pattern.

module Arel
  module Nodes
    class BindParam
      attr_reader value
      include Node
      def nil_value?(o) = @value == nil
      def value_before_type_cast(o)
        v = @value
        case v
        in ActiveModel::Attribute then ActiveModel::Attribute.value_before_type_cast(v)
        else v
        end
      end
      def infinite?(o)
        v = @value
        case v
        in ActiveModel::Attribute then false
        in Float then Float.infinite?(v) != nil
        else false
        end
      end
      def unboundable?(o) = false
    end
  end
end
