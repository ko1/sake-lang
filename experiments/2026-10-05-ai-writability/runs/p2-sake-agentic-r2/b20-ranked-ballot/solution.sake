def pct(c, active)
  return "0.0%" if active == 0
  t = (c * 2000 + active) / (2 * active)
  "#{t / 10}.#{t % 10}%"
end

lines = IO.readlines(IO.stdin)
cands = Array.uniq(Array.size(lines) > 0 ? String.split(String.chomp(lines[0]), " ") : Array[])
cands = Array.reject(cands) { |c| c == "" }

ballots = Array[]
rejected = 0
i = 1
while i < Array.size(lines)
  text = String.chomp(lines[i])
  num = i + 1
  i += 1
  next if String.match?(text, /\A *\z/)
  parts = Array.map(String.split(text, ">", -1)) { |s| String.strip(s) }
  seen = Array[]
  reason = nil
  Array.each(parts) do |nm|
    if reason == nil
      if nm == ""
        reason = "empty rank"
      elsif !Array.include?(cands, nm)
        reason = "unknown candidate #{nm}"
      elsif Array.include?(seen, nm)
        reason = "duplicate #{nm}"
      else
        Array.push(seen, nm)
      end
    end
  end
  if reason != nil
    puts("rejected line #{num}: #{reason}")
    rejected += 1
  else
    Array.push(ballots, Array.map(seen) { |nm| Array.index(cands, nm) })
  end
end

if Array.empty?(cands)
  puts("no candidates")
  exit
end

nb = Array.size(ballots)
puts("ballots: #{nb} valid, #{rejected} rejected")
nc = Array.size(cands)
out = Array.new(nc, false)
hist = Array[]
round = 0
done = false
until done
  round += 1
  counts = Array.new(nc, 0)
  active = 0
  Array.each(ballots) do |b|
    pick = Array.find(b) { |c| !out[c] }
    if pick != nil
      counts[pick] += 1
      active += 1
    end
  end
  Array.push(hist, counts)
  puts("round #{round}")
  live = Array.select(Range.to_a(0...nc)) { |c| !out[c] }
  Array.each(Array.sort_by(live) { |c| [-counts[c], cands[c]] }) do |c|
    puts("  #{cands[c]} #{counts[c]} #{pct(counts[c], active)}")
  end
  puts("  exhausted #{nb - active}")
  if active == 0
    puts("no winner")
    done = true
  else
    win = Array.find(live) { |c| counts[c] * 2 > active }
    if win != nil
      puts("winner #{cands[win]}")
      done = true
    else
      mn = Array.min(Array.map(live) { |c| counts[c] })
      tied = Array.select(live) { |c| counts[c] == mn }
      k = round - 2
      while k >= 0 && Array.size(tied) > 1
        m = Array.min(Array.map(tied) { |c| hist[k][c] })
        tied = Array.select(tied) { |c| hist[k][c] == m }
        k -= 1
      end
      e = Array.max_by(tied) { |c| cands[c] }
      out[e] = true
      puts("  eliminated #{cands[e]}")
    end
  end
end
