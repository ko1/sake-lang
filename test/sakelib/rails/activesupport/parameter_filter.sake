# ActiveSupport::ParameterFilter: Strings, Symbols, Regexps, dotted keys, nested Hashes and Arrays, a mask.

require "rails/activesupport/active_support/parameter_filter"
require "json"

params = JSON.parse('{"name": "ko1", "password": "x", "Password_confirmation": "x", "credit_card": {"number": "4242", "code": "123"},
  "tokens": [{"api_key": "k1"}, {"api_key": "k2", "label": "ci"}], "otp_attempt": 5, "ids": [1, 2]}')
params => Hash
f = ActiveSupport::ParameterFilter.of(Any[:passw, "secret", /\Aapi_/, "credit_card.code", :otp])
p(ActiveSupport::ParameterFilter.filter(f, params))
p(ActiveSupport::ParameterFilter.filter_param(f, "password", "x"))
p(ActiveSupport::ParameterFilter.filter_param(f, "name", "ko1"))
p(ActiveSupport::ParameterFilter.of(Any[], "***").ActiveSupport::ParameterFilter.filter(params) == params)
p(ActiveSupport::ParameterFilter.of(Any[:name, /\.number\z/], "***").ActiveSupport::ParameterFilter.filter(params))
