module Sql
  class Blob
    attr_reader bytes: String

    def initialize: (String bytes) -> void
    def self.from_hex: (String digits) -> Blob
    def hex: () -> String
    def text: () -> String
    def compare: (Blob other) -> Integer
    def eql?: (Object other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end
end
