fn search(xs, target)
  let lo = 0
  let hi = len(xs) - 1
  while lo <= hi do
    let mid = (lo + hi) / 2
    if xs[mid] == target then return mid
    elif xs[mid] < target then lo = mid + 1
    else hi = mid - 1
    end
  end
  return -1
end
let xs = [1, 3, 5, 7, 9, 11]
print(search(xs, 7), search(xs, 1), search(xs, 11), search(xs, 4), search([], 1))
