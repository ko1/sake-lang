# Ruby: config/application.rb + config/environment.rb (require "rails/all"; the app's classes are autoloaded).
# Sake reads every file before running, so the app's files are listed here. What Rails defines while booting
# (models' columns, route helpers, compiled templates, the dispatcher) is printed by `bin/rails source` and joined
# in by `generate`, which runs it before the app is checked, at every start (`bin/sake --dump=generated` shows it).
require "../../rails"
generate "../bin/rails", "source"
require "../app/models/*"
require "../app/controllers/*"
require "./routes"

module Blog
  module_function
  def application = once { Rails::Application.new("Blog") }
end
