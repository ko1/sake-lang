require "text"

# Levenshtein
pairs = Array[["kitten", "sitting"], ["flaw", "lawn"], ["", "abc"], ["abc", ""], ["", ""], ["same", "same"],
              ["gumbo", "gambol"], ["日本語", "日本"], ["Saturday", "Sunday"]]
Array.each(pairs) { |a, b| puts "levenshtein(#{a.Kernel.inspect}, #{b.Kernel.inspect}) = #{Levenshtein.distance(a, b)}" }
p Levenshtein.distance("kitten", "sitting", 2)
p Levenshtein.distance("kitten", "sitting", 5)
begin
  Levenshtein.distance("a", Array.fetch(Array["a", 1], 1))   # a literal 1 is reported before running
rescue NoMatchingPatternError => e
  puts "error: not a String"
end

# Soundex
names = Array["Robert", "Rupert", "Rubin", "Ashcraft", "Ashcroft", "Tymczak", "Pfister", "Honeyman",
              "Lee", "Washington", "O'Hara", "a", "", "123"]
Array.each(names) { |n| puts "soundex(#{n.Kernel.inspect}) = #{Soundex.soundex(n).Kernel.inspect}" }
p Soundex.soundex("Robert") == Soundex.soundex("Rupert")

# Jaro-Winkler
jw = Array[["MARTHA", "MARHTA"], ["DWAYNE", "DUANE"], ["DIXON", "DICKSONX"], ["abc", "abc"], ["abc", "xyz"],
           ["", ""], ["a", ""], ["CRATE", "TRACE"], ["dixon", "DIXON"]]
Array.each(jw) do |a, b|
  puts "#{a} ~ #{b}: jaro=#{Float.round(JaroWinkler.jaro_distance(a, b), 6)} jw=#{Float.round(JaroWinkler.distance(a, b), 6)}"
end
p JaroWinkler.distance("dixon", "DIXON", ignore_case: true)
p JaroWinkler.distance("MARTHA", "MARHTA", weight: 0.2)
p JaroWinkler.distance("CRATE", "CRACK", threshold: 0.9)
begin
  JaroWinkler.distance("a", "b", weight: 0.5)
rescue ArgumentError => e
  puts Exception.message(e)
end

# word wrap
text = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs."
puts WordWrap.word_wrap(text, line_width: 20)
puts "--"
puts WordWrap.word_wrap(text, line_width: 30, break_sequence: " /\n")
puts "--"
puts WordWrap.word_wrap("short\nlines stay\n\nas they are", line_width: 20)
puts "--"
puts WordWrap.word_wrap("a supercalifragilisticexpialidocious word", line_width: 10)
p WordWrap.word_wrap(text)
begin
  WordWrap.word_wrap(text, line_width: 0)
rescue ArgumentError => e
  puts Exception.message(e)
end
