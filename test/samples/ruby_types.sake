# Ruby types: Hash, Range, Set, Symbol, Regexp/MatchData, format, and more built-ins.
h = Hash["a" => 1, b: 2]
p(h)
p(h["a"]); p(h[:b]); p(h["zz"])
h["c"] = 3
h["a"] += 10
p(h)
Hash.each(h) { |k, v| print(k, "=", v, " ") }
puts
counts = Hash.new(0)
Array.each(String.split("a b a c a", " ")) { |w| counts[w] += 1 }
p(counts)
p(Array.tally(Array["x", "y", "x"]))
p(Hash.sort_by(counts) { |k, v| 0 - v })
p(Array.group_by(Array[1, 2, 3, 4]) { Integer.even?(it) })
r = 1..5
p(r); p(Range.to_a(r)); p(Range.sum(1...4)); p(Range.map(1..3) { it * 2 })
Range.each(1..3) { |i| print(i) }
puts
p(Array[10, 20, 30, 40][1..2]); p("hello"[1..3])
s = Set[1, 2]
Set.add(s, 3)
p(s); p(Set.include?(s, 2)); p(s | Set[9])
p(:sym); p(Symbol.to_s(:abc)); p(:a == :a)
m = String.match("key=val", /(\w+)=(\w+)/)
p(m); p(m[1]); p(MatchData.captures(m))
p("abc" =~ /b/)
p(String.scan("a1b22c333", /\d+/))
p(String.gsub("a-b-c", /-/, "+"))
p(format("%05.1f|%s|%d", 3.14159, "x", 42))
p("%d items" % 3)
p(Integer.divmod(17, 5)); p(Integer.gcd(12, 18)); p(Integer("42"))
p(Array.zip(Array[1, 2], Array["a", "b"]))
p(Array.partition(Array[1, 2, 3]) { it > 1 })
p(Array.each_with_object(Array[1, 2], Array[]) { |x, acc| Array.push(acc, x * 10) })
p(Array.sum(Array[1, 2, 3]) { it * it })
p(Array.count(Array[1, 2, 1], 1))
p(Array.to_h(Array[["a", 1], ["b", 2]]))
h2 = Hash[[1, 2] => "tuple key"]
p(h2[[1, 2]])
