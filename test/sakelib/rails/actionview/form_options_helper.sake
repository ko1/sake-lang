require "rails/actionview/action_view/base"

# Records for the collection helpers (Sake: types that include ActionView::ModelNaming::Model)
class Person
  attr_accessor id, name, city_id
  include ActionView::ModelNaming::Model
  def to_key(r) = Any[@id]
  def to_param(r) = Kernel.to_s(@id)
  def persisted?(r) = true
  def param_key(r) = "person"
  def route_key(r) = "people"
  def singular_route_key(r) = "person"
  def read_attribute_for_validation(r, name)
    case name
    in "id" then @id
    in "name" then @name
    in "city_id" then @city_id
    else nil
    end
  end
end
class Continent
  attr_accessor name, countries
  include ActionView::ModelNaming::Model
  def to_key(r) = nil
  def to_param(r) = nil
  def persisted?(r) = false
  def param_key(r) = "continent"
  def route_key(r) = "continents"
  def singular_route_key(r) = "continent"
  def read_attribute_for_validation(r, name)
    case name
    in "name" then @name
    in "countries" then @countries
    else nil
    end
  end
end

view = ActionView::Base.empty
B = ActionView::Base
people = Any[Person.new(1, "David", 2), Person.new(2, "Sam <b>", 1), Person.new(3, "Tobias", 2)]
person = Person.new(4, "Ann", 2)

# options_for_select
puts B.options_for_select(view, Any["VISA", "MasterCard"])
puts B.options_for_select(view, Any[Any["Dollar", "$"], Any["Kroner", "DKK"]])
puts B.options_for_select(view, Any[Any["Dollar", "$"], Any["Kroner", "DKK"]], "$")
puts B.options_for_select(view, Any["VISA", "MasterCard", "Discover"], Any["VISA", "Discover"])
puts B.options_for_select(view, Hash.of("Basic" => "$20", "Plus" => "$40"), "$40")
puts B.options_for_select(view, Any[Any["Lisbon", 1, Hash.of(data: Hash.of(size: "2.8 million"))], Any["Madrid", 2, Hash.of(class: "big")]], 2)
puts B.options_for_select(view, Any["Free", "Basic", "Advanced", "Super Platinum"], disabled: "Super Platinum")
puts B.options_for_select(view, Any["Free", "Basic", "Advanced"], selected: "Free", disabled: Any["Basic", "Advanced"])
puts B.options_for_select(view, 1..3, 2)
puts B.options_for_select(view, Any["<a>", "b&c"])
puts B.options_for_select(view, String.html_safe("<option>raw</option>"))
# collections
puts B.options_from_collection_for_select(view, people, "id", "name")
puts B.options_from_collection_for_select(view, people, :id, :name, 3)
puts B.options_from_collection_for_select(view, people, :id, :name, Any[1, 3])
puts B.options_from_collection_for_select(view, people, :id, :name, selected: 1, disabled: 2)
continents = Any[Continent.new("Africa", Any[Person.new(5, "Egypt", nil), Person.new(6, "Rwanda", nil)]), Continent.new("Europe", Any[Person.new(7, "Denmark", nil)])]
puts B.option_groups_from_collection_for_select(view, continents, :countries, :name, :id, :name, 6)
puts B.grouped_options_for_select(view, Hash.of("North America" => Any[Any["United States", "US"], "Canada"], "Europe" => Any["Denmark", "Germany"]), "Canada")
puts B.grouped_options_for_select(view, Any[Any["North America", Any["US", "Canada"]], Any["Europe", Any["Denmark"]]], nil, prompt: "Choose")
puts B.grouped_options_for_select(view, Any[Any["US", "Canada"], Any["Denmark", "Germany"]], nil, divider: "---------")
puts B.weekday_options_for_select(view)
puts B.weekday_options_for_select(view, "Friday", day_format: :abbr_day_names)
puts B.weekday_options_for_select(view, 2, index_as_value: true, beginning_of_week: :sunday)
# select and friends on an object
puts B.select(view, :person, :city_id, Any[Any["Paris", 1], Any["Tokyo", 2]], Hash.of(object: person))
puts B.select(view, :person, :city_id, Any[Any["Paris", 1], Any["Tokyo", 2]], Hash.of(object: person, include_blank: "None"), Hash.of(class: "city"))
puts B.select(view, :person, :city_id, Any[Any["Paris", 1]], Hash.of(object: person, prompt: true), Hash.of(required: true))
puts B.select(view, :person, :name, Any["a", "b"], Hash.of(object: person, selected: "b", disabled: "a"))
puts B.select(view, :person, :name, Any[Any["Group 1", Any["a", "b"]], Any["Group 2", Any["c"]]], Hash.of(object: person))
puts B.select(view, :person, :name, Hash.new, Hash.new) { String.html_safe("<option>block</option>") }
puts B.collection_select(view, :person, :city_id, people, :id, :name, Hash.of(object: person, prompt: "Pick"))
puts B.grouped_collection_select(view, :person, :city_id, continents, :countries, :name, :id, :name, Hash.of(object: person))
puts B.collection_radio_buttons(view, :person, :city_id, people, :id, :name, Hash.of(object: person))
puts B.collection_checkboxes(view, :person, :city_id, people, :id, :name, Hash.of(object: person, include_hidden: false))
puts B.collection_check_boxes(view, :person, :city_id, people, :id, :name, Hash.of(object: person)) { |b| ActiveSupport::SafeBuffer.+(ActionView::Helpers::Tags::CollectionHelpers::Builder.label(b), ActionView::Helpers::Tags::CollectionHelpers::Builder.checkbox(b)) }
