# Unqualified calls: own namespace first (inner wins), then top level, then Kernel.
def label(x) = String.+("top:", x)

class Door
  def open(d) = label("door")
  def label(x) = String.+("door:", x)
  def puts(x) = Kernel.puts(String.+("[door] ", x))
  def show(d) = puts(open(d))
end

def open(x) = label("top")

Door.show(1)
puts(open(1))
puts(Door.open(1))
