# Arithmetic.round & co. (any real number), blockless each_cons / each_slice / each_with_index,
# first / last with a count, fetch with a default, Hash.dup, loop, and Math::PI-style constants.
def avg(xs) = Array.sum(xs) / Array.size(xs)
p(Arithmetic.round(avg(Array[1, 2, 4])))
p(Arithmetic.round(avg(Array[1.0, 2.5]), 1))
p(Arithmetic.to_f(3r / 2))
xs = Array[3, 1, 4, 1, 5, 9]
p(Array.map(Array.each_cons(xs, 2)) { |a, b| b - a })
p(Array.each_slice(xs, 4))
p(Array.map(Array.each_with_index(xs)) { |x, i| x * i })
p([Array.first(xs, 2), Array.last(xs, 2), Array.fetch(xs, 10, -1)])
h = Hash["a" => 1]
g = Hash.dup(h)
g["b"] = 2
p([h, g])
n = 0
r = loop do
  n += 1
  break n * 10 if n == 3
end
p(r)
p(Arithmetic.round(Math::PI * 2, 3))
p(Float::INFINITY > 1e308)
