# Port of actionpack-8.1.3/lib/abstract_controller/translation.rb (partial: no HtmlSafeTranslation for `_html` keys; that is ActionView's translation helper)
#
# `t(c, ".title")` in PostsController#index looks up "posts.index.title", then "posts.title", as Rails'
# lazy lookup does; other keys go to I18n as they are (sakelib/i18n).

require "i18n"

module AbstractController
  module Translation
    def translate(c, key, default: nil, scope: nil, count: nil, locale: nil, **options)
      d = default
      if String.start_with?(Kernel.to_s(key), ".")
        path = String.tr(controller_path(c), "/", ".")
        defaults = Any[String.to_sym("#{path}#{key}")]
        case default
        in nil then nil
        in Array then Array.concat(defaults, default)
        else Array.push(defaults, default)
        end
        d = defaults
        key = "#{path}.#{action_name(c)}#{key}"
      end
      I18n.translate_with(key, locale, scope, d, count, ".", options, false)
    end
    def t(c, key, default: nil, scope: nil, count: nil, locale: nil, **options)
      translate(c, key, default: default, scope: scope, count: count, locale: locale, **options)
    end

    def localize(c, object, locale: nil, format: :default) = I18n.localize(object, locale: locale, format: format)
    def l(c, object, locale: nil, format: :default) = I18n.localize(object, locale: locale, format: format)
  end
end
