require "concurrent_ruby"

# Deterministic: every thread is joined or waited for before its result is printed; results of
# concurrent work are sorted or counted.

# 1. Future
puts "-- Future"
f = ConcurrentFuture.execute { 1 + 1 }
p ConcurrentFuture.value(f)
p ConcurrentFuture.state(f)
p ConcurrentFuture.fulfilled?(f)
p ConcurrentFuture.rejected?(f)
p ConcurrentFuture.reason(f)
p ConcurrentFuture.value(f, 0.1)
g = ConcurrentFuture.execute { raise "boom" }
ConcurrentFuture.wait(g)
p ConcurrentFuture.value(g)
p ConcurrentFuture.state(g)
r = ConcurrentFuture.reason(g)
puts(r == nil ? "no reason" : Exception.message(r))
p ConcurrentFuture.rejected?(g)
begin
  ConcurrentFuture.value!(g)
rescue RuntimeError => e
  puts "value! raised: #{Exception.message(e)}"
end
h = ConcurrentFuture.execute do
  sleep 0.3
  :late
end
p ConcurrentFuture.value(h, 0.01)   # not yet
p ConcurrentFuture.complete?(h)
ConcurrentFuture.wait(h)
p ConcurrentFuture.value(h)
p ConcurrentFuture.complete?(h)

# 2. Promise: then / rescue / zip / fulfill / reject
puts "-- Promise"
pr = ConcurrentPromise.execute { 10 }
# A promise's value has no type of its own (one field for every promise), so the block states it.
c = ConcurrentPromise.then(pr) do |v|
  v => Integer
  v * 2
end
d = ConcurrentPromise.then(c) do |v|
  v => Integer
  v + 1
end
p ConcurrentPromise.value(d)
p ConcurrentPromise.value(c)
p ConcurrentPromise.value(pr)
p ConcurrentPromise.state(d)
bad = ConcurrentPromise.then(ConcurrentPromise.execute { raise "bad" }) do |v|
  v => Integer
  v * 2
end
ConcurrentPromise.wait(bad)
p ConcurrentPromise.state(bad)
r2 = ConcurrentPromise.reason(bad)
puts(r2 == nil ? "no reason" : Exception.message(r2))
p ConcurrentPromise.value(bad)
res = ConcurrentPromise.rescue(ConcurrentPromise.execute { raise "bad" }) { |reason| "rescued #{Exception.message(reason)}" }
p ConcurrentPromise.value(res)
p ConcurrentPromise.state(res)
p ConcurrentPromise.value(ConcurrentPromise.rescue(ConcurrentPromise.execute { 5 }) { |reason| 0 })
z = ConcurrentPromise.zip(ConcurrentPromise.execute { 1 }, ConcurrentPromise.execute { 2 }, ConcurrentPromise.execute { 3 })
p ConcurrentPromise.value(z)
p ConcurrentPromise.value(ConcurrentPromise.fulfilled(3))
rj = ConcurrentPromise.reason(ConcurrentPromise.rejected(RuntimeError.new("x")))
puts(rj == nil ? "no reason" : Exception.message(rj))
t = ConcurrentPromise.then(ConcurrentPromise.execute { 1 }) { |v| raise "in then" }
ConcurrentPromise.wait(t)
rt = ConcurrentPromise.reason(t)
puts(rt == nil ? "no reason" : Exception.message(rt))

# 3. Atom, AtomicFixnum, AtomicBoolean, AtomicReference
puts "-- Atom"
a = ConcurrentAtom.new(0)
p ConcurrentAtom.value(a)
p ConcurrentAtom.swap(a) { |v| v + 1 }
p ConcurrentAtom.compare_and_set(a, 1, 5)
p ConcurrentAtom.compare_and_set(a, 1, 7)
p ConcurrentAtom.value(a)
p ConcurrentAtom.reset(a, 9)
p ConcurrentAtom.value(a)

n = AtomicFixnum.new(5)
p AtomicFixnum.increment(n)
p AtomicFixnum.increment(n, 3)
p AtomicFixnum.decrement(n)
p AtomicFixnum.value(n)
p AtomicFixnum.compare_and_set(n, 8, 1)
p AtomicFixnum.value(n)
p AtomicFixnum.update(n) { |v| v * 10 }
p AtomicFixnum.set_value(n, 3)
p AtomicFixnum.value(n)
# 4 threads x 1000 increments
counter = AtomicFixnum.new
ts = Array.map(Range.to_a(1..4)) do |i|
  Thread.new { Integer.times(1000) { AtomicFixnum.increment(counter) } }
end
Array.each(ts) { |th| Thread.join(th) }
p AtomicFixnum.value(counter)

b = AtomicBoolean.new
p AtomicBoolean.value(b)
p AtomicBoolean.make_true(b)
p AtomicBoolean.make_true(b)
p AtomicBoolean.true?(b)
p AtomicBoolean.false?(b)
p AtomicBoolean.make_false(b)
p AtomicBoolean.set_value(b, true)
p AtomicBoolean.value(b)

ar = AtomicReference.new(:a)   # Symbols: the gem's compare_and_set compares by identity
p AtomicReference.get(ar)
p AtomicReference.set(ar, :b)
p AtomicReference.get_and_set(ar, :c)
p AtomicReference.get(ar)
p AtomicReference.compare_and_set(ar, :c, :d)
p AtomicReference.value(ar)
p AtomicReference.update(ar) { |v| String.to_sym(Symbol.to_s(v) + "!") }

# 4. Map
puts "-- Map"
m = ConcurrentMap.new
p ConcurrentMap.put_if_absent(m, :a, 1)
p ConcurrentMap.put_if_absent(m, :a, 2)
p m[:a]
p ConcurrentMap.compute_if_absent(m, :b) { 7 }
p ConcurrentMap.compute_if_absent(m, :b) { 8 }
p ConcurrentMap.fetch(m, :b)
p ConcurrentMap.fetch(m, :c, 0)
p ConcurrentMap.fetch(m, :c) { |k| "no #{k}" }
begin
  ConcurrentMap.fetch(m, :zz)
rescue KeyError => e
  puts "KeyError: #{Exception.message(e)}"
end
p ConcurrentMap.key?(m, :a)
p ConcurrentMap.keys(m)
p ConcurrentMap.values(m)
p ConcurrentMap.size(m)
p ConcurrentMap.delete(m, :a)
p ConcurrentMap.delete(m, :a)
p ConcurrentMap.fetch_or_store(m, :d) { 4 }
p ConcurrentMap.fetch_or_store(m, :d, 5)
p ConcurrentMap.get_and_set(m, :d, 6)
p ConcurrentMap.compute(m, :d) { |v| (v == nil ? 0 : v) + 1 }
p ConcurrentMap.compute_if_present(m, :zz) { |v| v + 1 }
p ConcurrentMap.compute_if_present(m, :d) { |v| v + 1 }
p ConcurrentMap.replace_if_exists(m, :d, 0)
p ConcurrentMap.replace_if_exists(m, :nope, 0)
p ConcurrentMap.replace_pair(m, :d, 0, 1)
p ConcurrentMap.replace_pair(m, :d, 0, 2)
p ConcurrentMap.delete_pair(m, :d, 9)
p ConcurrentMap.delete_pair(m, :d, 1)
p ConcurrentMap.empty?(m)
p ConcurrentMap.merge_pair(m, :x, 1) { |old| old + 1 }
p ConcurrentMap.merge_pair(m, :x, 1) { |old| old + 1 }
m[:q] = 3
p m[:q]
p ConcurrentMap.key(m, 3)
p ConcurrentMap.value?(m, 3)
pairs = Array[]
ConcurrentMap.each_pair(m) { |k, v| Array.push(pairs, "#{k}=#{v}") }
p Array.sort(pairs)
# compute_if_absent from 4 threads computes once
calls = AtomicFixnum.new
shared = ConcurrentMap.new
ts = Array.map(Range.to_a(1..4)) do |i|
  Thread.new do
    Integer.times(100) do |j|
      ConcurrentMap.compute_if_absent(shared, j) do
        AtomicFixnum.increment(calls)
        j * j
      end
    end
  end
end
Array.each(ts) { |th| Thread.join(th) }
p AtomicFixnum.value(calls)
p ConcurrentMap.size(shared)
p shared[7]

# 5. CountDownLatch
puts "-- CountDownLatch"
l = CountDownLatch.new(3)
p CountDownLatch.count(l)
p CountDownLatch.wait(l, 0.01)
done = Array[]
lock = Mutex.new
ts = Array.map(Range.to_a(1..3)) do |i|
  Thread.new do
    Mutex.synchronize(lock) { Array.push(done, i) }
    CountDownLatch.count_down(l)
  end
end
p CountDownLatch.wait(l)
p Array.sort(done)
p CountDownLatch.count(l)
p CountDownLatch.wait(l, 0.01)
Array.each(ts) { |th| Thread.join(th) }
CountDownLatch.count_down(l)
p CountDownLatch.count(l)

# 6. Semaphore
puts "-- Semaphore"
s = Semaphore.new(2)
p Semaphore.available_permits(s)
p Semaphore.acquire(s)
p Semaphore.try_acquire(s)
p Semaphore.try_acquire(s)
p Semaphore.try_acquire(s, 1, 0.01)
p Semaphore.release(s)
p Semaphore.available_permits(s)
p Semaphore.drain_permits(s)
p Semaphore.available_permits(s)
p Semaphore.release(s, 3)
p Semaphore.available_permits(s)
p Semaphore.acquire(s, 2)
p Semaphore.available_permits(s)
# at most 2 of 6 workers inside at once
sem = Semaphore.new(2)
inside = AtomicFixnum.new
peak = AtomicFixnum.new
ts = Array.map(Range.to_a(1..6)) do |i|
  Thread.new do
    Semaphore.acquire(sem)
    now = AtomicFixnum.increment(inside)
    AtomicFixnum.update(peak) { |v| now > v ? now : v }
    sleep 0.01
    AtomicFixnum.decrement(inside)
    Semaphore.release(sem)
  end
end
Array.each(ts) { |th| Thread.join(th) }
p AtomicFixnum.value(peak) <= 2
p AtomicFixnum.value(peak) >= 1
p Semaphore.available_permits(sem)
# a waiter with a timeout gets the permit when it is released in time
sem2 = Semaphore.new(0)
waiter = Thread.new { Semaphore.try_acquire(sem2, 1, 2) }
sleep 0.02
Semaphore.release(sem2)
p Thread.value(waiter)
p Semaphore.available_permits(sem2)

# 7. Event
puts "-- Event"
ev = ConcurrentEvent.new
p ConcurrentEvent.set?(ev)
p ConcurrentEvent.wait(ev, 0.01)
w = Thread.new { ConcurrentEvent.wait(ev) }
p ConcurrentEvent.set(ev)
p Thread.value(w)
p ConcurrentEvent.set?(ev)
p ConcurrentEvent.wait(ev)
p ConcurrentEvent.wait(ev, 0.01)
p ConcurrentEvent.try?(ev)
p ConcurrentEvent.reset(ev)
p ConcurrentEvent.set?(ev)
p ConcurrentEvent.try?(ev)

# 8. FixedThreadPool
puts "-- FixedThreadPool"
pool = FixedThreadPool.new(2)
p FixedThreadPool.max_length(pool)
p FixedThreadPool.running?(pool)
results = Queue.new
busy = AtomicFixnum.new
peak = AtomicFixnum.new
# The posted block runs later and reads `i` as it is then; a function parameter is per call
# (notes/concurrent_ruby_bug_yield_in_thread_loop_var.sake).
def post_square(pool, results, busy, peak, i)
  FixedThreadPool.post(pool) do
    now = AtomicFixnum.increment(busy)
    AtomicFixnum.update(peak) { |v| now > v ? now : v }
    sleep 0.01
    AtomicFixnum.decrement(busy)
    Queue.push(results, i * i)
  end
end
Integer.times(6) { |i| p post_square(pool, results, busy, peak, i) }
FixedThreadPool.post(pool) { raise "a task failing does not stop the pool" }
FixedThreadPool.shutdown(pool)
p FixedThreadPool.running?(pool)
p FixedThreadPool.wait_for_termination(pool, 5)
p FixedThreadPool.shutdown?(pool)
p FixedThreadPool.completed_task_count(pool)
p FixedThreadPool.scheduled_task_count(pool)
p FixedThreadPool.length(pool)
got = Array[]
Array.push(got, Queue.pop(results)) until Queue.empty?(results)
p Array.sort(got)
p AtomicFixnum.value(peak) <= 2
begin
  FixedThreadPool.post(pool) { 1 }
rescue ConcurrentRejectedExecutionError => e
  puts "rejected: #{Exception.message(e)}"
end
p FixedThreadPool.wait_for_termination(pool)

# 9. ScheduledTask
puts "-- ScheduledTask"
st = ScheduledTask.execute(0.5) { :never }
p ScheduledTask.pending?(st)
p ScheduledTask.cancel(st)
# (the gem's cancelled? is false after cancel, its state being :rejected; Sake's says true; not compared)
p ScheduledTask.value(st)
p ScheduledTask.cancel(st)
st2 = ScheduledTask.execute(0.01) { :done }
p ScheduledTask.value(st2)
p ScheduledTask.fulfilled?(st2)
p ScheduledTask.cancel(st2)

# 10. IVar
puts "-- IVar"
iv = IVar.new
p IVar.pending?(iv)
waiter = Thread.new { IVar.value(iv) }
IVar.set(iv, 3)
p Thread.value(waiter)
p IVar.value(iv)
p IVar.complete?(iv)
p IVar.fulfilled?(iv)
begin
  IVar.set(iv, 4)
rescue ConcurrentMultipleAssignmentError => e
  puts "second set: #{Exception.message(e)}"
end
p IVar.try_set(iv, 5)
p IVar.value(iv)
iv2 = IVar.new
IVar.fail(iv2, RuntimeError.new("f"))
p IVar.rejected?(iv2)
rf = IVar.reason(iv2)
puts(rf == nil ? "no reason" : Exception.message(rf))
p IVar.value(iv2)
