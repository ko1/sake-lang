# sake: --strict
# once { ... }: computed the first time its place runs, then kept for the whole program.
def squares = once do
  puts("computing")
  Array.map(Range.to_a(0..4)) { it * it }
end
p(squares)
p(Array.sum(squares))                   # not computed again
def first_label(x) = once { "first: #{x}" }
p(first_label(1))
p(first_label("two"))                   # the place keeps its first value
counter = Array[0]
ts = Array.map(Range.to_a(1..4)) { |i| Thread.new { once { Array.push(counter, i); Array.size(counter) } } }
p(Array.map(ts) { Thread.value(it) })   # every thread sees the one value
