class Point
  attr_accessor x, y

  def norm2(p) = @x * @x + @y * @y

  def move(p, dx, dy)
    @x += dx
    @y += dy
    p
  end
end

def fib(n)
  if n < 2
    n
  else
    fib(n - 1) + fib(n - 2)
  end
end

def twice(x) = yield(yield(x))

pt = Point.new(3, 4)
Point.move(pt, 1, 1)
puts(Point.norm2(pt))                 # 41
puts(fib(20))                         # 6765

nums = Array[1, 2, 3, 4]
total = 0
Array.each(nums) { |x| total += x }
puts(total)                           # 10
sq = Array.map(nums) { |x| x * x }
puts(Array.length(sq))                # 4

name, v = [String.upcase("sake"), 1.5 * 2]
puts(name + "!")                      # SAKE!
puts(v)                               # 3.0
puts(twice(3) { |x| x * 10 })         # 300

i = 0
while i < 3
  puts(i)
  i += 1
end
p(pt)
