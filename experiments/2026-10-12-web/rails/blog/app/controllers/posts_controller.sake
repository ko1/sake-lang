# Rails 8.1's scaffold controller (app/controllers/posts_controller.rb), action by action.
class PostsController < ApplicationController
  attr_reader posts, post              # Ruby: @posts, @post (instance variables need no declaration); a reader
                                       # only: attr_accessor's writer would be `set_post`, the callback's name

  # before_action :set_post, only: %i[ show edit update destroy ]
  def before_action(c, action)
    case action
    in :show | :edit | :update | :destroy then set_post(c)
    else
    end
  end

  # GET /posts
  def index(c)
    @posts = Post.order({created_at: :desc})
  end

  # GET /posts/1
  def show(c) = nil

  # GET /posts/new  (Ruby: def new; `new` is the constructor in Sake)
  def new_(c)
    @post = Post.build
  end

  # GET /posts/1/edit
  def edit(c) = nil

  # POST /posts
  def create(c)
    post = Post.build(post_params(c))
    @post = post
    if Post.save(post)
      redirect_to c, post, {notice: "Post was successfully created."}
    else
      render c, :new, {status: :unprocessable_content}
    end
  end

  # PATCH/PUT /posts/1
  def update(c)
    post = @post
    return unless post
    if Post.update(post, post_params(c))
      redirect_to c, post, {notice: "Post was successfully updated.", status: :see_other}
    else
      render c, :edit, {status: :unprocessable_content}
    end
  end

  # DELETE /posts/1
  def destroy(c)
    post = @post
    Post.destroy(post) if post
    redirect_to c, posts_path, {notice: "Post was successfully destroyed.", status: :see_other}
  end

  # private
  # Use callbacks to share common setup or constraints between actions.
  def set_post(c)
    @post = Post.find(@params[:id])
  end

  # Only allow a list of trusted parameters through.
  def post_params(c)
    ActionController::Parameters.expect(@params, {post: Array[:title, :body]})
  end
end
