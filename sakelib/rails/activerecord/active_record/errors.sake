# Port of activerecord-8.1.3/lib/active_record/errors.rb (partial: the errors the adapter and the model layer raise)
#
# Ruby's hierarchy (ActiveRecordError > StatementInvalid > WrapperError > RecordNotUnique ...) is a module
# ActiveRecordError that every error includes, so `rescue ActiveRecord::ActiveRecordError` catches them all.
# Sake's `class B < A` is not a subtype, so `rescue ActiveRecord::StatementInvalid` does not catch
# RecordNotUnique here; the module StatementInvalidError (Sake only) groups StatementInvalid and the errors
# that are its subclasses in Ruby. Ruby's StatementInvalid.new(message, sql:, binds:, connection_pool:) is
# new(message, sql, binds) here.

module ActiveRecord
  module ActiveRecordError
  end

  module StatementInvalidError
    include ActiveRecordError
  end

  class StatementInvalid < StandardError
    attr_reader sql, binds
    include StatementInvalidError
  end

  class RecordNotUnique < StandardError
    attr_reader sql, binds
    include StatementInvalidError
  end

  class NotNullViolation < StandardError
    attr_reader sql, binds
    include StatementInvalidError
  end

  class InvalidForeignKey < StandardError
    attr_reader sql, binds
    include StatementInvalidError
  end

  class CheckViolation < StandardError
    attr_reader sql, binds
    include StatementInvalidError
  end

  class StatementTimeout < StandardError
    attr_reader sql, binds
    include StatementInvalidError
  end

  class ConnectionNotEstablished < StandardError
    include ActiveRecordError
  end

  class NoDatabaseError < StandardError
    include ActiveRecordError
  end

  class TransactionIsolationError < StandardError
    include ActiveRecordError
  end

  class ActiveRecordRangeError < StandardError
    include ActiveRecordError
  end

  # Ruby: raise ActiveRecord::Rollback inside a transaction block rolls it back and is swallowed.
  class Rollback < StandardError
    include ActiveRecordError
  end

  # Ruby: RecordNotFound.new(message = nil, model = nil, primary_key = nil, id = nil) (model is the class's name)
  class RecordNotFound < StandardError
    attr_reader model, primary_key, id
    include ActiveRecordError
  end

  class RecordNotSaved < StandardError
    attr_reader record
    include ActiveRecordError
  end

  class RecordNotDestroyed < StandardError
    attr_reader record
    include ActiveRecordError
  end

  class ReadOnlyRecord < StandardError
    include ActiveRecordError
  end

  # Ruby raises ActiveRecordError itself; a module here (rescue groups), so this class is raised (Sake only)
  class PlainActiveRecordError < StandardError
    include ActiveRecordError
  end

  class UnknownAttributeError < StandardError
    attr_reader record_name, attribute
    include ActiveRecordError
  end

  class AssociationTypeMismatch < StandardError
    include ActiveRecordError
  end

  class StrictLoadingViolationError < StandardError
    include ActiveRecordError
  end
end
