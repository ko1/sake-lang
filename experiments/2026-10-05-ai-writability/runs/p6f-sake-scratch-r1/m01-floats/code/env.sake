# Runtime scopes (SPEC section 6.4). Each Env corresponds to one scope of the
# static checks: vars has one slot per declaration, found by the hops and slot
# that the checks recorded. A slot whose `let` has not run yet holds
# Env.unset, a Symbol, which no Mini value is.

class Env
  attr_reader vars, parent

  def open(nslots, parent) = Env.new(Array.new(nslots, unset), parent)

  def unset = :unset

  # The scope hops levels out from env.
  def up(env, hops)
    e = env
    while hops > 0
      outer = Env.parent(e)
      Fail.internal("scope chain shorter than the static scopes") unless outer
      e = outer
      hops -= 1
    end
    e
  end
end
