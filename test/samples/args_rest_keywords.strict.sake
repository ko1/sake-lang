# `*rest` collects the positional arguments after the fixed ones (an Array), `**opts` the keywords that are
# not parameters (a Hash of Symbol keys). T.new takes fields by keyword too. A reserved word can be a field
# when written as a Symbol, and a failed `x => T` can be rescued.
def join_all(sep, *parts) = Array.join(parts, sep)
p(join_all("-", "a", "b", "c"))
p(join_all("-"))
def tag(name, *children, cls: nil, **attrs)
  as = Array.map(Hash.to_a(attrs)) { |k, v| " #{k}=\"#{v}\"" }
  "<#{name}#{cls ? " class=\"#{cls}\"" : ""}#{Array.join(as)}>#{Array.join(children)}</#{name}>"
end
p(tag("p", "hi", "!", cls: "x", id: "main"))
p(tag("br"))

class Logger2
  attr_reader dev
  attr_accessor level = :info, progname = nil
end
p(Logger2.new(:stdout, level: :warn))
p(Logger2.new(:stderr, progname: "app"))

class Node
  attr_reader val
  attr_accessor :next
end
n = Node.new(1, Node.new(2, nil))
m = n.Node.next
p(m.Node.val) if m

def port(x)
  x => Integer | String
  x => Integer
  x
end
Array.each(Array[80, "80"]) do |v|
  p(port(v))
rescue NoMatchingPatternError => e
  puts("rescued: #{Exception.message(e)}")
end
