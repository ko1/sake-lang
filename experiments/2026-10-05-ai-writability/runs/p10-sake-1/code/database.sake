# The in-memory database: tables, their columns and their rows.

# name as created; key lower-cased for lookups; type :integer / :real / :text.
# not_null is true for NOT NULL and for PRIMARY KEY columns; default is the value an INSERT that
# gives no value uses (nil: NULL), still to be converted to the column's type.
class Column
  attr_reader name, key, type, not_null, default
end

# A UNIQUE or non-rowid PRIMARY KEY constraint: positions of its columns, in the constraint's order.
class UniqueConstraint
  attr_reader positions
end

# rows: Array of rows, each an Array of values in column order.
# uniques: the UniqueConstraints in declaration order (column constraints, then table constraints).
# rowid: position of the INTEGER PRIMARY KEY column (spec 2.1), or -1 if there is none.
class Table
  attr_reader name, columns, rows, uniques, rowid

  # Replaces the rows with a validated set (so a failing statement leaves the table alone).
  def set_rows(t, new_rows) = @rows = new_rows

  def column_position(t, name)
    key = Value.lower(name)
    Array.find_index(@columns) { Column.key(it) == key }
  end
end

# tables: Hash from the lower-cased table name to its Table.
class Database
  attr_reader tables

  # The table called `name` (case-insensitive) or SqlError.
  def table(db, name)
    t = @tables[Value.lower(name)]
    raise SqlError.new("no such table: #{name}") if t == nil
    t
  end

  def table?(db, name) = Hash.key?(@tables, Value.lower(name))

  def add_table(db, table)
    @tables[Value.lower(Table.name(table))] = table
  end

  def remove_table(db, name)
    Hash.delete(@tables, Value.lower(name))
  end
end
