# `*` takes the rest of a multiple assignment or of block parameters (an Array), and spreads a Tuple
# or an Array into a built-in's rest arguments.
first, *rest = Any[1, 2, 3, 4]
p([first, rest])
a, *mid, z = Any[1, 2, 3, 4, 5]
p([a, mid, z])
a, *mid, z = Any[1]
p([a, mid, z])
h, *t = [1, "two", :three]
p([h, t])
x, * = Any[7, 8]
p(x)
Array.each(Any[[1, 2, 3], [4, 5, 6]]) { |k, *vs| p([k, vs]) }
def three
  yield(1, 2, 3)
end
three { |*all| p(all) }
three { |q, *r| p([q, r]) }
three { |q, *r, s| p([q, r, s]) }
xs = Any[1, 2]
ys = Any[*xs, 3, *xs]
p(ys)
p(Set.size(Set.of(*ys)))
row = Any["a", 1]
puts(format("%s=%d", *row))
puts(format("%s=%d", *["b", 2]))
Array.push(ys, *xs)
p(ys)
p(Array.values_at(Any[10, 20, 30], *Any[0, 2]))
puts(*Any["p", "q"])
