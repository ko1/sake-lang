class User
  attr_reader name, team, email, active
end
class Item
  attr_reader name, count, price, qty
end
class Event
  attr_reader name, time
end
class Cart
  attr_reader items
end
class Result
  attr_reader name, score
end

# R1
def low_stock(items)
  Array.select(items) { |i| Item.count(i) <= 5 }.Array.map { |i| Item.name(i) }
end
p low_stock(Item[Item.new("a", 5, 1, 1), Item.new("b", 2, 1, 1), Item.new("c", 9, 1, 1)])

# R2
def average(scores)
  return 0 if Array.empty?(scores)
  Array.sum(scores) / Array.size(scores)
end
p average(Any[1, 2])

# R3
users = User[User.new("a", "x", "A@x", true), User.new("b", "y", "a@x", false), User.new("c", "x", "c@x", true)]
counts = Array.group_by(users) { |u| User.team(u) }.Hash.transform_values { |ms| Array.size(ms) }
Hash.sort_by(counts) { |team, n| -n }.Array.each do |team, n|
  puts "#{team}: #{n}"
end

# R4
def recent(events)
  Array.sort_by(events) { |e| Event.time(e) }.Array.first(3).Array.map { |e| Event.name(e) }
end
p recent(Event[Event.new("e1", 1), Event.new("e2", 2), Event.new("e3", 3), Event.new("e4", 4)])

# R5
def unique_emails(users)
  Array.map(users) { |u| String.downcase(User.email(u)) }.Array.uniq.Array.size
end
p unique_emails(users)

# R6
def price(cart)
  total = Cart.items(cart).Array.sum { |i| Item.price(i) * Item.qty(i) }
  total >= 10_000 ? total * 9 / 10 : total
end
p price(Cart.new(Item[Item.new("a", 1, 5000, 2)]))

# G1
text = "to be or not to be to"
words = String.split(text)
counts = Array.tally(words)
top = Hash.max_by(counts) { |w, n| n }
puts top[0]

# G2
values = Any[1, 2, 3, 9, 1, 1, 4]
sums = Array.each_slice(values, 3).Array.map { |r| Array.sum(r) }
puts Array.max(sums)

# G3
defaults = Hash.of("color" => "red", "size" => "M")
prefs = Hash.of("color" => "blue")
settings = Hash.merge(defaults, prefs)
Hash.each(settings) { |k, v| puts "#{k}=#{v}" }

# G4
results = Result[Result.new("a", 70), Result.new("b", 40), Result.new("c", 59)]
passed, failed = Array.partition(results) { |r| Result.score(r) >= 60 }
puts "#{Array.size(failed)} failed"

# G5
names = Array.select(users) { |u| User.active(u) }.Array.map { |u| User.name(u) }.Array.sort
puts Array.first(names, 5).Array.join(", ")

# G6
ns = Any["ann", "bob"]
scores = Any[35, 72]
Array.zip(ns, scores).Array.each do |name, score|
  puts "#{name}: #{"*" * (score / 10)}"
end
