# A small SQL engine: reads a SQL script on standard input and runs it (see SPEC.md).
#
#   sql/errors     SqlError and its helpers        sql/lexer       text -> tokens -> statements
#   sql/text       nil-free string slices          sql/parser      tokens -> statement trees (queries, DML)
#   sql/numtext    numbers read out of text        sql/parse_schema  CREATE, DROP, ALTER, transactions
#                                                  sql/ast         the trees
#   sql/values     SQL values: print, order, truth sql/catalog     tables, keys, rows
#   sql/arith      + - * / %                       sql/storage     column types enforced on store
#   sql/strfn      substr, trim, replace, instr    sql/constraints NOT NULL, UNIQUE, PRIMARY KEY checks
#   sql/rounding   round()                         sql/functions   scalar functions (dispatch)
#   sql/like, sql/cast, sql/predicates   LIKE, CAST, CASE/BETWEEN/IN
#   sql/scope      what names refer to             sql/resolver    expressions: names -> row positions
#   sql/eval       expressions on a row            sql/subquery    scalar, EXISTS and IN subqueries
#   sql/from       FROM sources and joins
#   sql/sorter     ORDER BY                        sql/grouping    group keys, GROUP BY, DISTINCT
#   sql/summation  sum/total/avg arithmetic        sql/aggregates  count, sum, min, max, group_concat
#   sql/parse_window  OVER (...), WINDOW clause    sql/window_plan window calls resolved, frames checked
#   sql/window_run    partitions, order, peers     sql/window_frame  the rows of a frame
#   sql/window_fns    rank, lag, nth_value, ...
#   sql/select_plan  SELECT: names resolved, clauses planned   sql/select  running a planned SELECT
#   sql/compound   UNION, INTERSECT, EXCEPT        sql/ctes        WITH and WITH RECURSIVE
#   sql/views, sql/indexes, sql/alter              schema objects and changes
#   sql/transaction  BEGIN, COMMIT, ROLLBACK
#   sql/insert, sql/update, sql/delete
#   sql/executor   statement -> module
require "sql/*"          # every file of sql/, in name order (the definitions are collected before anything runs)

def run_script(src)
  db = Catalog.new_database
  Array.each(Lexer.split_statements(Lexer.tokenize(src))) do |toks|
    begin
      lines = Executor.run(db, Parser.parse_statement(toks))
      Array.each(lines) { |line| puts(line) }
    rescue SqlError => e
      puts("Error: #{Exception.message(e)}")
    end
  end
end

run_script(IO.read(IO.stdin))
