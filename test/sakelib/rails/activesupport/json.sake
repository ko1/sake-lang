require "rails/activesupport/active_support/json"
require "rails/activesupport/active_support/time"

# ActiveSupport::JSON (json/encoding, json/decoding) and as_json (core_ext/object/json)
class Point
  attr_reader x, y
  include ActiveSupport::AsJson
  def as_json(pt, options = nil) = Hash.of("x" => @x, "y" => @y)
end

tokyo = Time.find_zone!("Tokyo")
data = Hash.of(:id => 1, "name" => "<b>Ann & Bob</b>", :tags => Any[:a, "b"], :score => 1.5, :nan => Float.NAN, :none => nil,
               :ok => true, 2 => "two", :at => Time.utc(2024, 1, 2, 3, 4, 5), :zoned => ActiveSupport::TimeZone.local(tokyo, 2024, 1, 2, 3, 4, 5),
               :day => Date.new(2024, 1, 2), :wait => Integer.minutes(5), :range => 1..3, :set => Set.of(1, 2), :pt => Point.new(1, 2), :rat => Rational(1, 3))
puts(ActiveSupport::JSON.encode(data))
puts(ActiveSupport::JSON.encode(data, Hash.of(escape: false)))
puts(ActiveSupport::JSON.encode("  line separator"), ActiveSupport::JSON.encode(Any[]), ActiveSupport::JSON.encode(nil))
p(Object.as_json(Hash.of(a: Any[1, :b])), Object.as_json(Time.utc(2024, 1, 2)), Object.as_json(Point.new(3, 4)))
puts(Object.to_json(Hash.of(html: "<script>")))
decoded = ActiveSupport::JSON.decode("{\"a\":[1,2.5,\"x\",null,true],\"b\":{\"c\":\"d\"}}")
p(decoded)
begin
  ActiveSupport::JSON.decode("{bad json")
rescue ActiveSupport::JSON::ParseError
  puts("parse error")
end
