InsufficientFunds = Exception.new(:account, :needed)
UnknownAccount = Exception.new(:id)

class Account
  attr_reader id, owner, kind
  attr_accessor balance = 0, frozen = false
  def to_s(a) = format("%-6s %-8s %-8s %10s", @id, @owner, @kind, cents(@balance))
end

def cents(n)
  sign = n < 0 ? "-" : ""
  m = Integer.abs(n)
  "#{sign}#{m / 100}.#{String.rjust(Integer.to_s(m % 100), 2, "0")}"
end

class Bank
  attr_reader accounts, journal, rates
  def find(b, id)
    acct = @accounts[id]
    raise UnknownAccount.new("no account #{id}", id) if acct == nil
    acct
  end

  def open(b, id, owner, kind)
    acct = Account.new(id, owner, kind)
    @accounts[id] = acct
    acct
  end

  def record(b, kind, id, amount)
    Array.push(@journal, [kind, id, amount])
  end

  def deposit(b, id, amount)
    acct = find(b, id)
    Account.set_balance(acct, Account.get_balance(acct) + amount)
    record(b, "dep", id, amount)
  end

  def withdraw(b, id, amount)
    acct = find(b, id)
    raise "account #{id} is frozen" if Account.get_frozen(acct)
    limit = Account.get_kind(acct) == "checking" ? -5000 : 0
    after = Account.get_balance(acct) - amount
    raise InsufficientFunds.new("insufficient funds in #{id}", id, amount) if after < limit
    Account.set_balance(acct, after)
    record(b, "wd", id, amount)
  end

  def transfer(b, from, to, amount)
    find(b, to)
    withdraw(b, from, amount)
    deposit(b, to, amount)
  end

  def month_end(b)
    Hash.each(@accounts) do |id, acct|
      bal = Account.get_balance(acct)
      if bal < 0
        fee = 1500
        Account.set_balance(acct, bal - fee)
        record(b, "fee", id, fee)
      else
        rate = Hash.fetch(@rates, Account.get_kind(acct), 0)
        interest = bal * rate / 10000
        if interest > 0
          Account.set_balance(acct, bal + interest)
          record(b, "int", id, interest)
        end
      end
    end
  end

  def total(b) = Array.sum(Array.map(Hash.values(@accounts)) { Account.get_balance(it) })
end

bank = Bank.new(Hash[], Array[], Hash["savings" => 125, "checking" => 5])
Bank.open(bank, "A100", "alice", "checking")
Bank.open(bank, "A101", "alice", "savings")
Bank.open(bank, "B200", "bob", "checking")
Bank.open(bank, "C300", "carol", "savings")

ops = Array[
  [:dep, "A100", "", 120000], [:dep, "A101", "", 500000], [:dep, "B200", "", 30000],
  [:dep, "C300", "", 75000], [:xfer, "A100", "B200", 45000], [:wd, "B200", "", 80000],
  [:wd, "B200", "", 2000], [:xfer, "C300", "D400", 100], [:wd, "C300", "", 90000],
  [:month, "", "", 0], [:freeze, "B200", "", 0], [:wd, "B200", "", 100],
  [:xfer, "A101", "A100", 250000], [:dep, "Z999", "", 5], [:month, "", "", 0],
  [:wd, "A100", "", 330000], [:month, "", "", 0]
]

failures = Hash.new(0)
step = 0
Array.each(ops) do |op, a, b, amount|
  step += 1
  begin
    case op
    in :dep then Bank.deposit(bank, a, amount)
    in :wd then Bank.withdraw(bank, a, amount)
    in :xfer then Bank.transfer(bank, a, b, amount)
    in :month then Bank.month_end(bank)
    in :freeze then Account.set_frozen(Bank.find(bank, a), true)
    end
  rescue InsufficientFunds => e
    puts("step #{step}: #{Exception.message(e)} (needed #{cents(InsufficientFunds.get_needed(e))})")
    failures["funds"] += 1
  rescue UnknownAccount => e
    puts("step #{step}: unknown account #{UnknownAccount.get_id(e)}")
    failures["unknown"] += 1
  rescue RuntimeError => e
    puts("step #{step}: #{Exception.message(e)}")
    failures["other"] += 1
  end
end

puts("--- accounts")
Hash.each(Bank.get_accounts(bank)) { |id, acct| puts(acct) }
puts("total: #{cents(Bank.total(bank))}")

puts("--- journal by kind")
by_kind = Array.group_by(Bank.get_journal(bank)) { |kind, id, amount| kind }
Hash.each(by_kind) do |kind, entries|
  sum = Array.sum(Array.map(entries) { |k, id, amount| amount })
  puts(format("%-4s %3d entries %12s", kind, Array.size(entries), cents(sum)))
end

puts("--- failures")
Hash.each(failures) { |k, n| puts("#{k}: #{n}") }

richest = Array.max_by(Hash.values(Bank.get_accounts(bank))) { Account.get_balance(it) }
puts("richest: #{Account.get_owner(richest)} #{Account.get_id(richest)}") if richest
owners = Hash.new(0)
Hash.each(Bank.get_accounts(bank)) { |id, acct| owners[Account.get_owner(acct)] += Account.get_balance(acct) }
Array.each(Array.sort_by(Hash.to_a(owners)) { |o, bal| -bal }) { |o, bal| puts("#{o}: #{cents(bal)}") }
