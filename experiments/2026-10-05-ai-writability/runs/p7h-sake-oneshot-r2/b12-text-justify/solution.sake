def read_all_lines
  lines = Array[]
  while true
    line = gets
    break unless line
    Array.push(lines, line)
  end
  lines
end

def parse_width(width_str)
  width_str = String.strip(width_str)
  if String.match?(width_str, /^\d+$/)
    w = String.to_i(width_str)
    if w >= 2 && w <= 80
      w
    else
      nil
    end
  else
    nil
  end
end

def split_words(text)
  String.split(text, /[\s\t]+/)
end

def break_long_word(word, width)
  pieces = Array[]
  while String.size(word) > width
    piece = String.slice(word, 0, width - 1)
    Array.push(pieces, piece + "-")
    word = String.slice(word, width - 1, String.size(word))
  end
  Array.push(pieces, word)
  pieces
end

def get_words_and_break(text, width)
  words = split_words(text)
  all_words = Array[]
  Array.each(words) do |word|
    if String.size(word) > width
      broken = break_long_word(word, width)
      Array.each(broken) { |w| Array.push(all_words, w) }
    else
      Array.push(all_words, word)
    end
  end
  all_words
end

def build_paragraphs(all_lines, width)
  paragraphs = Array[]
  current_para = Array[]
  in_text = false

  Array.each(all_lines) do |line|
    stripped = String.strip(line)
    if String.empty?(stripped)
      if in_text
        Array.push(paragraphs, current_para)
        current_para = Array[]
        in_text = false
      end
    else
      in_text = true
      words = get_words_and_break(stripped, width)
      Array.each(words) { |w| Array.push(current_para, w) }
    end
  end

  if Array.size(current_para) > 0
    Array.push(paragraphs, current_para)
  end

  paragraphs
end

def fill_lines(words, width)
  lines = Array[]
  current_line = Array[]

  Array.each(words) do |word|
    if Array.size(current_line) == 0
      Array.push(current_line, word)
    else
      test_line = Array.join(current_line, " ")
      if String.size(test_line) + 1 + String.size(word) <= width
        Array.push(current_line, word)
      else
        Array.push(lines, current_line)
        current_line = Array[word]
      end
    end
  end

  if Array.size(current_line) > 0
    Array.push(lines, current_line)
  end

  lines
end

def justify_line(words, width, is_last)
  if is_last || Array.size(words) == 1
    line = Array.join(words, " ")
    String.ljust(line, width)
  else
    line_without_spaces = Array.join(words, "")
    total_chars = Array.reduce(words, 0) { |sum, w| sum + String.size(w) }
    total_gaps = Array.size(words) - 1
    total_spaces = width - total_chars
    spaces_per_gap = total_spaces / total_gaps
    extra_spaces = total_spaces % total_gaps

    result = ""
    Integer.times(Array.size(words)) do |i|
      result = result + Array.at(words, i)
      if i < Array.size(words) - 1
        gap_spaces = spaces_per_gap
        if i < extra_spaces
          gap_spaces += 1
        end
        Integer.times(gap_spaces) { result = result + " " }
      end
    end
    result
  end
end

def main
  all_lines = read_all_lines

  if Array.size(all_lines) == 0
    puts("invalid width")
    return
  end

  width_str = Array.at(all_lines, 0)
  width = parse_width(width_str)

  unless width
    puts("invalid width")
    return
  end

  text_lines = Array[]
  Integer.times(Array.size(all_lines) - 1) do |i|
    Array.push(text_lines, Array.at(all_lines, i + 1))
  end

  paragraphs = build_paragraphs(text_lines, width)

  puts("+" + String.*(String["-"], width) + "+")

  total_output_lines = 0
  total_words = 0

  Integer.times(Array.size(paragraphs)) do |p_idx|
    para = Array.at(paragraphs, p_idx)

    Array.each(para) do |word|
      if !String.end_with?(word, "-")
        total_words += 1
      end
    end

    lines = fill_lines(para, width)

    Integer.times(Array.size(lines)) do |l_idx|
      line_words = Array.at(lines, l_idx)
      is_last_line = (l_idx == Array.size(lines) - 1)
      justified = justify_line(line_words, width, is_last_line)
      puts("|" + justified + "|")
      total_output_lines += 1
    end

    if p_idx < Array.size(paragraphs) - 1
      puts("|" + String.*(String[" "], width) + "|")
    end
  end

  puts("+" + String.*(String["-"], width) + "+")
  puts("paragraphs: #{Array.size(paragraphs)}, lines: #{total_output_lines}, words: #{total_words}")
end

main
