require "logger"

# logger: 15000 formatted entries (to no device, so formatting only) plus 2000 below the level.
log = Logger.new(nil)
Logger.set_progname(log, "bench")
Logger.set_fixed_time(log, Time.new(2026, 10, 3, 12, 34, 56))
Integer.times(5000) do |i|
  Logger.info(log, "message #{i}")
  Logger.warn(log, "warning #{i}")
  Logger.add(log, Logger.ERROR, "via add", "other")
  Logger.debug(log, "debug #{i}") if i < 0
end
Logger.set_level(log, :warn)
Integer.times(2000) { |i| Logger.info(log, "hidden #{i}") }
p(Logger.format_message(log, "INFO", Time.new(2026, 10, 3, 12, 34, 56), "p", "m"))
