sentence = "the quick brown fox jumps over the lazy dog and the cat"
words = String.split(sentence, " ")

puts(String.+("word count: ", Integer.to_s(Array.length(words))))
puts(String.+("longer than 3: ", Integer.to_s(Array.count(words) { |w| String.length(w) > 3 })))

longest = ""
Array.each(words) { |w|
  longest = w if String.length(w) > String.length(longest)
}
puts(String.+("longest: ", longest))

puts(Array.join(Array.map(words) { |w| String.upcase(w) }, "-"))
puts(String.+("'the' count: ", Integer.to_s(Array.count(words) { |w| w == "the" })))
