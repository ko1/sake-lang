# Port of railties-8.1.3/lib/rails/health_controller.rb
#
# Its class body (`rescue_from(Exception) { render_down }`: a block, here `with: :render_down`) is in
# health_controller_decl.rb, which the boot generator passes to ActionController's generator when the app's
# routes reach rails/health.

module Rails
  class HealthController < ActionController::Base
    def show(c) = render_up(c)

    # private
    def render_up(c)
      respond_to(c, :html, :json) do |format|
        case format
        in :html then render c, html: html_status(c, color: "green")
        in :json then render c, json: Hash.of(status: "up", timestamp: Time.iso8601(Time.current))
        else nil
        end
      end
    end

    def render_down(c, exception = nil)
      respond_to(c, :html, :json) do |format|
        case format
        in :html then render c, html: html_status(c, color: "red"), status: 500
        in :json then render c, json: Hash.of(status: "down", timestamp: Time.iso8601(Time.current)), status: 500
        else nil
        end
      end
    end

    def html_status(c, color:) = String.html_safe("<!DOCTYPE html><html><body style=\"background-color: #{color}\"></body></html>")
  end
end
