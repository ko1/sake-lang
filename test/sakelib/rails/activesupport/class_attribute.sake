# class_attribute: a class-level value a subclass inherits until it writes its own.

require "rails/activesupport/active_support/core_ext/class/attribute"
generate "rails/activesupport/active_support/generate/active_support", "class_attribute_decl.rb"

p([Base.setting, Sub.setting, SubSub.setting, Other.setting])
Sub.set_setting(2)
p([Base.setting, Sub.setting, SubSub.setting, Other.setting])
Base.set_setting(5)
p([Base.setting, Sub.setting, SubSub.setting, Other.setting])
SubSub.set_setting(3)
p([Base.setting, Sub.setting, SubSub.setting, Other.setting])
p([Base.setting?, false])   # Ruby: Base.respond_to?(:quiet?) (instance_predicate: false); no reflection in Sake
# A mutable default is shared: an in-place change shows in every class that has not written its own.
Array.push(Base.tags, :a)
p([Base.tags, Sub.tags, Other.tags])
Other.set_tags(Base.tags + Any[:b])
p([Base.tags, Sub.tags, Other.tags])
p([Base.name_format, Sub.name_format])
Sub.set_name_format("%s!")
p([Base.name_format, Sub.name_format, SubSub.name_format])
