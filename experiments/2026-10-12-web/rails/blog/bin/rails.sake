# bin/rails: `routes`, and `source` (prints the Sake source of the models, route helpers, views and dispatch, from
# the schema, the routes and app/views; config/application.sake runs it with `generate "../bin/rails", "source"`).
# Run from the app's directory: bin/sake bin/rails.sake routes
require "../../rails_generate"
require "../config/routes"
require "../db/schema"

Rails::Generate.run(Array.first(ARGV) || "routes")
