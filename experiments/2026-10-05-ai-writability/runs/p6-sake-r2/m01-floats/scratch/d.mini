try
  print(1.0 / 0)
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(1 % -0.0)
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(10.0 ** 400)
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print((-8.0) ** 0.5)
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(float("1."))
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(float("abc"))
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(float([1]))
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(int(nil))
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print({1.5: 2})
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print([1][1.0])
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(min(1, "a"))
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(1.5 < "a")
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(-"a")
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(10 ** 400 * 1.0)
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(int("x"))
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(slice([1,2], 0.5))
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(float("-"))
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print(float(10 ** 400))
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
try
  print("ab"[1.5:])
catch e
  print(e["kind"], e["message"], e["line"], e["col"])
end
print(-7.5 % 2, 7.5 % -2, 5 % 2.0, 2 ** 3.0, (-2.0) ** 3, -0.0 * 1, int(-0.5))
print(sort([1.5, 1, 1.0, 0.5, 1]), max(1, 1.0), max(2.0, 2), [0.1, 0.25, 100.0, 0.0000001, 123456789012345680.0])
print(float("007.50"), float(3), 0.1 * 3, 100.0 * 100, 1 / 3.0)
