Layout = Struct.new(:rows, :cols, :widths, :order)

class Layout
  def cell_index(layout, r, c) = @order == :down ? c * @rows + r : r * @cols + c
end

def try_layout(items, cols, order, gap, width)
  n = Array.size(items)
  rows = Integer.ceildiv(n, cols)
  layout = Layout.new(rows, cols, Integer[], order)
  Integer.times(cols) do |c|
    w = 0
    Integer.times(rows) do |r|
      item = items[Layout.cell_index(layout, r, c)]
      w = String.size(item) if item != nil && String.size(item) > w
    end
    Array.push(Layout.widths(layout), w)
  end
  total = Array.sum(Layout.widths(layout)) + gap * (cols - 1)
  total <= width ? layout : nil
end

def best_layout(items, order, gap, width)
  best = Layout.new(Array.size(items), 1, Integer[Array.max(Array.map(items) { |s| String.size(s) })], order)
  cols = 2
  while cols <= Array.size(items)
    layout = try_layout(items, cols, order, gap, width)
    if layout != nil && Layout.rows(layout) < Layout.rows(best)
      best = layout
    end
    cols += 1
  end
  best
end

def render(items, layout, gap)
  lines = Array[]
  Integer.times(Layout.rows(layout)) do |r|
    cells = Array[]
    Integer.times(Layout.cols(layout)) do |c|
      item = items[Layout.cell_index(layout, r, c)]
      next if item == nil
      Array.push(cells, String.ljust(item, Layout.widths(layout)[c]))
    end
    Array.push(lines, String.rstrip(Array.join(cells, " " * gap)))
  end
  lines
end

def show(title, items, order, width)
  layout = best_layout(items, order, 2, width)
  puts("#{title}: #{Array.size(items)} items, width #{width}, #{Layout.cols(layout)} columns x #{Layout.rows(layout)} rows (#{order})")
  puts("|" + "-" * (width - 2) + "|")
  Array.each(render(items, layout, 2)) { |l| puts(l) }
  puts
end

def files
  String.split("Gemfile Gemfile.lock README.md Rakefile app bin config config.ru db lib log public " +
               "storage test tmp vendor .gitignore .ruby-version Procfile docker-compose.yml", " ")
end

def ruby_methods
  Array["each", "map", "select", "reject", "reduce", "each_with_index", "each_with_object",
        "group_by", "partition", "zip", "flat_map", "min_by", "max_by", "sum", "tally", "sort_by",
        "take_while", "drop_while", "chunk_while", "slice_when", "each_slice", "each_cons"]
end

show("files", files, :down, 60)
show("files", files, :across, 60)
show("methods", Array.sort(ruby_methods), :down, 72)
show("methods", Array.sort(ruby_methods), :down, 40)
show("single", Array["only-one-entry"], :down, 20)
show("too wide", Array["a-very-long-entry-name-that-does-not-fit", "short"], :down, 20)
