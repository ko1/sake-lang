Stat = Struct.new(:count, :n4, :n5, :bytes, :dsum, :dmax)

def digits?(s) = String.match?(s, /\A\d+\z/)

def ts_ok(ts)
  m = String.match(ts, /\A(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)\z/)
  return false unless m
  mo = String.to_i(m[2])
  d = String.to_i(m[3])
  h = String.to_i(m[4])
  mi = String.to_i(m[5])
  s = String.to_i(m[6])
  mo >= 1 && mo <= 12 && d >= 1 && d <= 31 && h <= 23 && mi <= 59 && s <= 59
end

def reason(f)
  return "wrong field count" if Array.size(f) != 6
  ts, meth, path, status, bytes, dur = f
  return "bad timestamp" unless ts_ok(ts)
  return "bad method" unless Array.include?(Array["GET", "POST", "PUT", "DELETE"], meth)
  return "bad path" unless String.start_with?(path, "/")
  return "bad status" unless String.match?(status, /\A\d{3}\z/)
  st = String.to_i(status)
  return "bad status" if st < 100 || st > 599
  return "bad bytes" unless bytes == "-" || digits?(bytes)
  return "bad duration" unless digits?(dur)
  nil
end

lines = IO.readlines(IO.stdin)
stats = Hash[]
hours = Hash.new(0)
bad = Array[]
Array.each_with_index(lines) do |raw, i|
  f = String.split(String.chomp(raw), " ")
  next if Array.empty?(f)
  why = reason(f)
  if why
    Array.push(bad, "  line #{i + 1}: #{why}")
    next
  end
  ts, meth, path, status, bytes, dur = f
  q = String.index(path, "?")
  base = q ? path[0, q] : path
  key = "#{meth} #{base}"
  s = stats[key]
  if s == nil
    s = Stat.new(0, 0, 0, 0, 0, 0)
    stats[key] = s
  end
  st = String.to_i(status)
  dd = String.to_i(dur)
  Stat.set_count(s, Stat.count(s) + 1)
  Stat.set_n4(s, Stat.n4(s) + 1) if st >= 400 && st <= 499
  Stat.set_n5(s, Stat.n5(s) + 1) if st >= 500 && st <= 599
  Stat.set_bytes(s, Stat.bytes(s) + String.to_i(bytes)) if bytes != "-"
  Stat.set_dsum(s, Stat.dsum(s) + dd)
  Stat.set_dmax(s, dd) if dd > Stat.dmax(s)
  hk = "#{ts[0, 10]} #{ts[11, 2]}"
  hours[hk] += 1
end

if Hash.empty?(stats)
  puts("no valid requests")
else
  keys = Array.sort_by(Hash.keys(stats)) { |k| [-Stat.count(Hash.fetch(stats, k)), k] }
  w = 8
  Array.each(keys) { |k| w = String.size(k) if String.size(k) > w }
  puts(String.ljust("endpoint", w) + format(" %5s %4s %4s %8s %7s %6s", "count", "4xx", "5xx", "bytes", "avg_ms", "max_ms"))
  Array.each(keys) do |k|
    s = Hash.fetch(stats, k)
    c = Stat.count(s)
    tenths = (Stat.dsum(s) * 20 + c) / (2 * c)
    avg = "#{tenths / 10}.#{tenths % 10}"
    puts(String.ljust(k, w) + format(" %5d %4d %4d %8d %7s %6d", c, Stat.n4(s), Stat.n5(s), Stat.bytes(s), avg, Stat.dmax(s)))
  end
  best = ""
  bestn = 0
  Array.each(Array.sort(Hash.keys(hours))) do |hk|
    n = Hash.fetch(hours, hk)
    if n > bestn
      bestn = n
      best = hk
    end
  end
  puts("busiest hour: #{best}:00 (#{bestn} requests)")
end
puts("invalid lines: #{Array.size(bad)}")
Array.each(bad) { |l| puts(l) }
