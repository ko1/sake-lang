# Bytes and encodings as Ruby: mixing encodings raises EncodingError; pack and force_encoding build UTF-8.
s = Integer.chr(227)
begin
  p("い" + s)
rescue EncodingError => e
  puts("caught: #{Exception.message(e)}")
end
bytes = Array[227, 129, 132]                       # the UTF-8 bytes of "い"
t = String.force_encoding(Array.pack(bytes, "C*"), "UTF-8")
p([t, String.valid_encoding?(t), String.encoding(t)])
p(Array.pack(Array[12354, 12356], "U*"))           # codepoints to UTF-8: "あい"
p("x" + Integer.chr(227))
