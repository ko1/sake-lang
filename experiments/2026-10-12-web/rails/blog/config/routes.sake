# Ruby (config/routes.rb):
#   Rails.application.routes.draw do
#     resources :posts do
#       resources :comments, only: [:create, :destroy]
#     end
#     root "posts#index"
#   end
class ActionDispatch::Routing::Mapper
  def draw(map)
    resources map, :posts do
      resources map, :comments, {only: Array[:create, :destroy]}
    end
    root map, "posts#index"
  end
end
