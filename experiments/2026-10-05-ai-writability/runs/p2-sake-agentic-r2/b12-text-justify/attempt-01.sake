def frame(s) = "|" + s + "|"

def justify(ws, width)
  gaps = Array.size(ws) - 1
  letters = Array.sum(Array.map(ws) { |w| String.size(w) })
  extra = width - letters
  base = extra / gaps
  rem = extra % gaps
  out = ""
  Array.each_with_index(ws) do |w, i|
    out = out + w
    if i < gaps
      out = out + String.*(" ", base + (i < rem ? 1 : 0))
    end
  end
  out
end

def layout(words, width)
  pieces = Array[]
  Array.each(words) do |w|
    while String.size(w) > width
      Array.push(pieces, String.slice(w, 0, width - 1) + "-")
      w = String.slice(w, width - 1, String.size(w) - (width - 1))
    end
    Array.push(pieces, w)
  end
  lines = Array[]
  cur = Array[]
  len = 0
  Array.each(pieces) do |w|
    if Array.empty?(cur)
      cur = Array[w]
      len = String.size(w)
    elsif len + 1 + String.size(w) <= width
      Array.push(cur, w)
      len += 1 + String.size(w)
    else
      Array.push(lines, cur)
      cur = Array[w]
      len = String.size(w)
    end
  end
  Array.push(lines, cur) unless Array.empty?(cur)
  res = Array[]
  Array.each_with_index(lines) do |ws, i|
    text = if i < Array.size(lines) - 1 && Array.size(ws) > 1
      justify(ws, width)
    else
      String.ljust(Array.join(ws, " "), width)
    end
    Array.push(res, text)
  end
  res
end

input = IO.readlines(IO.stdin())
wm = Array.empty?(input) ? nil : String.match(String.chomp(input[0]), /\A *(\d+) *\z/)
width = wm ? String.to_i(MatchData.captures(wm)[0]) : 0
if width < 2 || width > 80
  puts("invalid width")
  exit
end

paras = Array[]
cur = Array[]
Array.each(Array.drop(input, 1)) do |raw|
  ws = Array.reject(String.split(String.chomp(raw), /[ \t]+/)) { |x| String.empty?(x) }
  if Array.empty?(ws)
    unless Array.empty?(cur)
      Array.push(paras, cur)
      cur = Array[]
    end
  else
    Array.concat(cur, ws)
  end
end
Array.push(paras, cur) unless Array.empty?(cur)

border = "+" + String.*("-", width) + "+"
puts(border)
nlines = 0
nwords = 0
Array.each_with_index(paras) do |words, i|
  puts(frame(String.*(" ", width))) if i > 0
  nwords += Array.size(words)
  ls = layout(words, width)
  nlines += Array.size(ls)
  Array.each(ls) { |l| puts(frame(l)) }
end
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{nwords}")
