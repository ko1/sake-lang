# initialize(c) runs after T.new has stored the fields (Ruby's place for checks and conversions).
# The checker runs it for each construction, so a wrong argument is reported for that call.
class Config
  attr_reader host, port
  def initialize(c)
    @port = 80 if @port == nil
    @port => Integer
    @host = String.downcase(@host)
  end
  def next_port(c) = @port + 1
end
p(Config.new("EXAMPLE.com"))
p(Config.next_port(Config.new("h", 8080)))

class Temp
  attr_reader celsius
  def initialize(t) = @celsius = Float(@celsius)    # a conversion: the field is always a Float
end
p(Temp.new(20))
p(Temp.new("21.5"))
