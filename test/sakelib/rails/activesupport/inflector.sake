require "rails/activesupport/active_support/inflector"

# ActiveSupport::Inflector and String's inflections (core_ext/string/inflections), as Rails apps call them.
Array.each(String["post", "person", "status", "octopus", "sheep", "category", "mouse", "datum", "analysis", "news"]) do |w|
  puts "#{w} #{String.pluralize(w)} #{String.singularize(String.pluralize(w))} #{String.pluralize(w, 1)}"
end
p(String.camelize("active_record/base"), String.camelize("user_session", :lower), String.underscore("ActiveRecord::Base"))
p(String.tableize("BlogPost"), String.classify("blog_posts"), String.foreign_key("Admin::User"), String.humanize("author_id"))
p(String.titleize("x-men: the last stand"), String.dasherize("puni_puni"), String.demodulize("Admin::User"), String.deconstantize("Admin::User"))
p(String.parameterize("Ærøskøbing is nice!"), String.parameterize("Hello World", separator: "_"), String.upcase_first("hello"))
p(ActiveSupport::Inflector.ordinalize(1), ActiveSupport::Inflector.ordinalize(12), ActiveSupport::Inflector.ordinalize(-23), ActiveSupport::Inflector.ordinal(102))
p(ActiveSupport::Inflector.transliterate("Jürgen Müller"), ActiveSupport::Inflector.transliterate("日本", "*"))
begin
  String.camelize("x", :middle)
rescue ArgumentError => e
  puts Exception.message(e)
end

# config/initializers/inflections.rb
ActiveSupport::Inflector.inflections(:en) do |inflect|
  ActiveSupport::Inflector::Inflections.plural(inflect, /^(ox)$/i, '\1en')
  ActiveSupport::Inflector::Inflections.irregular(inflect, "octopus", "octopodes")
  ActiveSupport::Inflector::Inflections.uncountable(inflect, "equipment", "feedback")
  ActiveSupport::Inflector::Inflections.acronym(inflect, "API")
  ActiveSupport::Inflector::Inflections.acronym(inflect, "HTML")
  ActiveSupport::Inflector::Inflections.human(inflect, /_cnt$/i, '\1_count')
end
p(String.pluralize("ox"), String.pluralize("octopus"), String.singularize("octopodes"), String.pluralize("feedback"))
p(String.camelize("api_controller"), String.underscore("APIController"), String.camelize("html_api/v1"), String.underscore("HTMLParser"))
p(String.titleize("html_api"), String.humanize("comments_cnt"), String.tableize("APIKey"))
ins = ActiveSupport::Inflector.inflections
p(Array.size(ActiveSupport::Inflector::Inflections.plurals(ins)) > 20, Hash.keys(ActiveSupport::Inflector::Inflections.acronyms(ins)))
ActiveSupport::Inflector::Inflections.clear(ins, :acronyms)
p(String.camelize("api_controller"))
