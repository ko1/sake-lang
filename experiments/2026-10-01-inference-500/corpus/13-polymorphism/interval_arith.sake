EmptyInterval = Exception.new(:lo, :hi)

class Interval
  attr_reader lo, hi
  include Arithmetic

  def of(lo, hi)
    raise EmptyInterval.new("empty interval [#{lo}, #{hi}]", lo, hi) if lo > hi
    Interval.new(lo, hi)
  end

  def point(x) = Interval.new(x, x)
  def lift(b) = (b in Interval) ? b : point(b)

  def +(a, b)
    b = lift(b)
    Interval.new(@lo + Interval.get_lo(b), @hi + Interval.get_hi(b))
  end

  def -(a, b)
    b = lift(b)
    Interval.new(@lo - Interval.get_hi(b), @hi - Interval.get_lo(b))
  end

  def *(a, b)
    b = lift(b)
    ps = Array[@lo * Interval.get_lo(b), @lo * Interval.get_hi(b), @hi * Interval.get_lo(b), @hi * Interval.get_hi(b)]
    Interval.new(Array.min(ps), Array.max(ps))
  end

  def /(a, b)
    b = lift(b)
    if contains?(b, 0)
      raise ZeroDivisionError, "divisor #{b} contains zero"
    end
    a * Interval.new(1.0 / Interval.get_hi(b), 1.0 / Interval.get_lo(b))
  end

  def **(a, n)
    return Interval.new(1, 1) if n == 0
    if Integer.odd?(n) || @lo >= 0
      Interval.new(@lo ** n, @hi ** n)
    elsif @hi <= 0
      Interval.new(@hi ** n, @lo ** n)
    else
      Interval.new(0, Array.max(Array[@lo ** n, @hi ** n]))
    end
  end

  def width(a) = @hi - @lo
  def mid(a) = (@lo + @hi) / 2.0
  def contains?(a, x) = @lo <= x && x <= @hi
  def overlaps?(a, b) = @lo <= Interval.get_hi(b) && Interval.get_lo(b) <= @hi

  def intersect(a, b)
    lo = Array.max(Array[@lo, Interval.get_lo(b)])
    hi = Array.min(Array[@hi, Interval.get_hi(b)])
    lo <= hi ? Interval.new(lo, hi) : nil
  end

  def hull(a, b) = Interval.new(Array.min(Array[@lo, Interval.get_lo(b)]), Array.max(Array[@hi, Interval.get_hi(b)]))

  def to_s(a) = "[#{num(@lo)}, #{num(@hi)}]"
  def num(x) = (x in Float) ? format("%.4g", x) : Integer.to_s(x)
end

def merge_all(intervals)
  sorted = Array.sort_by(intervals) { |iv| Interval.get_lo(iv) }
  merged = Array[]
  Array.each(sorted) do |iv|
    last = Array.last(merged)
    if last && Interval.overlaps?(last, iv)
      merged[-1] = Interval.hull(last, iv)
    else
      Array.push(merged, iv)
    end
  end
  merged
end

# f(x) = x^3 - 2x - 5 evaluated on intervals; also works on plain numbers.
def f(x) = x ** 3 - x * 2 - 5

def bisect_roots(iv, depth, out)
  y = f(iv)
  return out unless Interval.contains?(y, 0)
  if depth == 0 || Interval.width(iv) < 0.0001
    Array.push(out, iv)
    return out
  end
  m = Interval.mid(iv)
  bisect_roots(Interval.new(Interval.get_lo(iv), m), depth - 1, out)
  bisect_roots(Interval.new(m, Interval.get_hi(iv)), depth - 1, out)
  out
end

a = Interval.of(1, 3)
b = Interval.of(-2, 4)
puts("a = #{a}, b = #{b}")
puts("a + b = #{a + b}")
puts("a - b = #{a - b}")
puts("a * b = #{a * b}")
puts("a + 10 = #{a + 10}, a * -1 = #{a * -1}")
puts("b ** 2 = #{b ** 2}, b ** 3 = #{b ** 3}")
puts("a / Interval[2, 4] = #{a / Interval.of(2, 4)}")
begin
  puts(a / b)
rescue ZeroDivisionError => e
  puts("error: #{Exception.message(e)}")
end
begin
  Interval.of(5, 1)
rescue EmptyInterval => e
  puts("error: #{Exception.message(e)}")
end

inter = Interval.intersect(a, Interval.of(2, 8))
puts("a & [2, 8] = #{inter}") if inter
none = Interval.intersect(a, Interval.of(5, 6))
puts("a & [5, 6] = #{none == nil ? "empty" : none}")

puts("== dependency problem ==")
x = Interval.of(0, 1)
puts("x - x = #{x - x} (width #{Interval.width(x - x)})")
puts("x * (1 - x) on [0, 1] = #{x * (Interval.point(1) - x)}")

puts("== bookings ==")
bookings = Array[Interval.of(9, 10), Interval.of(13, 15), Interval.of(9.5, 11), Interval.of(14, 16),
                 Interval.of(18, 19), Interval.of(11, 12), Interval.of(15.5, 17)]
busy = merge_all(bookings)
puts("busy: #{Array.join(busy, " ")}")
total = Array.sum(Array.map(busy) { |iv| Interval.width(iv) })
puts("busy hours: #{total}")
free = Array[]
Array.each_cons(busy, 2) { |pair| Array.push(free, Interval.new(Interval.get_hi(pair[0]), Interval.get_lo(pair[1]))) }
puts("gaps: #{Array.join(free, " ")}")
longest = Array.max_by(free) { |iv| Interval.width(iv) }
puts("longest gap: #{longest}") if longest

puts("== root of x^3 - 2x - 5 ==")
puts("f(2) = #{f(2)}, f(3) = #{f(3)}, f(2.5) = #{f(2.5)}")
puts("f([1, 3]) = #{f(Interval.of(1.0, 3.0))}")
roots = bisect_roots(Interval.of(-3.0, 3.0), 20, Array[])
puts("candidate boxes: #{Array.size(roots)}")
if Array.empty?(roots) == false
  hull = Array.reduce(roots, roots[0]) { |acc, iv| Interval.hull(acc, iv) }
  puts("root enclosure: #{hull}")
  puts(format("root ~ %.5f", Interval.mid(hull)))
end
