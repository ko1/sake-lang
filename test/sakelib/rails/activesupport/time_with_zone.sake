require "rails/activesupport/active_support/time"

# ActiveSupport::TimeZone (values/time_zone), TimeWithZone, Duration and the Time/Date calculations.
puts "== TimeZone"
ny = Time.find_zone!("Eastern Time (US & Canada)")
tokyo = Time.find_zone!("Tokyo")
utc = Time.find_zone!("UTC")
p(ActiveSupport::TimeZone.name(ny), TZInfo::Timezone.identifier(ActiveSupport::TimeZone.tzinfo(ny)), ActiveSupport::TimeZone.utc_offset(tokyo), ActiveSupport::TimeZone.formatted_offset(ny))
puts(ActiveSupport::TimeZone.to_s(ny), ActiveSupport::TimeZone.to_s(tokyo), ActiveSupport::TimeZone.to_s(utc))
p(ActiveSupport::TimeZone.seconds_to_utc_offset(-18000), ActiveSupport::TimeZone.seconds_to_utc_offset(19800, false), Time.find_zone("Nowhere"), ActiveSupport::TimeZone.name(Time.find_zone!("America/Chicago")))
p(ActiveSupport::TimeZone.name(ActiveSupport::TimeZone.lookup(9) || utc), Array.size(ActiveSupport::TimeZone.all) > 100, ActiveSupport::TimeZone.name(Array.first(ActiveSupport::TimeZone.all) || utc))
p(ActiveSupport::TimeZone.match?(ny, /New_York/), ny < tokyo)

puts "== TimeWithZone"
t = ActiveSupport::TimeZone.local(ny, 2024, 3, 10, 1, 30, 0)
p(t, ActiveSupport::TimeWithZone.zone(t), ActiveSupport::TimeWithZone.dst?(t), ActiveSupport::TimeWithZone.utc_offset(t))
t2 = t + Integer.hours(1)
p(t2, ActiveSupport::TimeWithZone.zone(t2), ActiveSupport::TimeWithZone.dst?(t2), t2 - t)
p(ActiveSupport::TimeZone.local(ny, 2024, 3, 10, 2, 30, 0), ActiveSupport::TimeZone.local(ny, 2024, 11, 3, 1, 30, 0))
puts(t, ActiveSupport::TimeWithZone.xmlschema(t), ActiveSupport::TimeWithZone.iso8601(t, 3), ActiveSupport::TimeWithZone.httpdate(t), ActiveSupport::TimeWithZone.rfc2822(t))
puts(ActiveSupport::TimeWithZone.to_fs(t, :db), ActiveSupport::TimeWithZone.to_fs(t, :long), ActiveSupport::TimeWithZone.to_fs(t, :short), ActiveSupport::TimeWithZone.to_fs(t, :long_ordinal), ActiveSupport::TimeWithZone.to_fs(t, :number))
puts(ActiveSupport::TimeWithZone.strftime(t, "%a %b %e %H:%M %Z %z %%Z"), ActiveSupport::TimeWithZone.as_json(t))
p(ActiveSupport::TimeWithZone.in_time_zone(t, "Tokyo"), ActiveSupport::TimeWithZone.utc(t), ActiveSupport::TimeWithZone.to_i(t), ActiveSupport::TimeWithZone.to_a(t))
p(ActiveSupport::TimeWithZone.year(t), ActiveSupport::TimeWithZone.month(t), ActiveSupport::TimeWithZone.day(t), ActiveSupport::TimeWithZone.hour(t), ActiveSupport::TimeWithZone.wday(t), ActiveSupport::TimeWithZone.yday(t))
p(ActiveSupport::TimeWithZone.change(t, Hash.of(hour: 12)), ActiveSupport::TimeWithZone.change(t, Hash.of(day: 1)), ActiveSupport::TimeWithZone.advance(t, Hash.of(days: 1, hours: 2)), ActiveSupport::TimeWithZone.advance(t, Hash.of(minutes: 90)))
p(ActiveSupport::TimeWithZone.beginning_of_day(t), ActiveSupport::TimeWithZone.end_of_day(t), ActiveSupport::TimeWithZone.beginning_of_month(t), ActiveSupport::TimeWithZone.end_of_month(t), ActiveSupport::TimeWithZone.beginning_of_week(t))
p(ActiveSupport::TimeWithZone.next_week(t), ActiveSupport::TimeWithZone.prev_week(t), ActiveSupport::TimeWithZone.tomorrow(t), ActiveSupport::TimeWithZone.next_occurring(t, :friday), ActiveSupport::TimeWithZone.quarter(t))
p(t == ActiveSupport::TimeWithZone.utc(t), t < t2, ActiveSupport::TimeWithZone.between?(t, t, t2), ActiveSupport::TimeWithZone.utc?(t), ActiveSupport::TimeWithZone.utc?(ActiveSupport::TimeWithZone.in_time_zone(t, "UTC")))
p(ActiveSupport::TimeZone.parse(tokyo, "2024-05-06 07:08:09"), ActiveSupport::TimeZone.parse(tokyo, "2024-05-06 07:08:09 +0000"), ActiveSupport::TimeZone.iso8601(ny, "2024-07-04T12:00:00Z"), ActiveSupport::TimeZone.at(tokyo, 0))
p(Date.readable_inspect(ActiveSupport::TimeWithZone.to_date(t)), ActiveSupport::TimeWithZone.to_fs(ActiveSupport::TimeZone.local(utc, 2024, 1, 1), :rfc822))

puts "== Time.zone"
p(Time.current_zone)
Time.set_zone("Tokyo")
p(ActiveSupport::TimeZone.name(Time.current_zone || utc), Time.in_time_zone(Time.utc(2024, 1, 1, 0, 0, 0)))
Time.use_zone("Hawaii") { p(Time.in_time_zone(Time.utc(2024, 1, 1, 0, 0, 0))) }
p(Time.in_time_zone(Time.utc(2024, 1, 1, 0, 0, 0), "Eastern Time (US & Canada)"))
begin
  Time.set_zone("Mars")
rescue ArgumentError => e
  puts Exception.message(e)
end

puts "== Duration"
jan31 = ActiveSupport::TimeZone.local(ny, 2024, 1, 31, 10, 0, 0)
p(ActiveSupport::Duration.since(Integer.month(1), jan31), ActiveSupport::Duration.ago(Integer.year(1), jan31), ActiveSupport::Duration.since(Integer.days(45), jan31), ActiveSupport::Duration.since(Float.days(1.5), jan31))
p(jan31 + Integer.weeks(2), jan31 - Integer.hours(3), ActiveSupport::Duration.after(Integer.minutes(30), jan31), ActiveSupport::Duration.inspect(Integer.hours(3) + Integer.minutes(5)))
p(ActiveSupport::Duration.iso8601(Integer.years(1) + Integer.days(2) + Integer.hours(3)), ActiveSupport::Duration.parse("P1M2DT3H").ActiveSupport::Duration.parts, ActiveSupport::Duration.variable?(Integer.hours(1)), ActiveSupport::Duration.variable?(Integer.days(1)))
p(ActiveSupport::Duration.build(100000).ActiveSupport::Duration.parts, Integer.fortnights(1).ActiveSupport::Duration.in_days, ActiveSupport::Duration.as_json(Integer.minutes(2)))

puts "== Time and Date calculations"
tm = Time.utc(2024, 2, 29, 15, 45, 30)
p(Time.change(tm, Hash.of(year: 2025)), Time.change(tm, Hash.of(hour: 9)), Time.change(tm, Hash.of(min: 5)), Time.advance(tm, Hash.of(years: 1, months: 1)), Time.advance(tm, Hash.of(weeks: 1.5)))
p(Time.beginning_of_day(tm), Time.end_of_day(tm), Time.middle_of_day(tm), Time.beginning_of_hour(tm), Time.end_of_minute(tm), Time.seconds_since_midnight(tm))
p(Time.beginning_of_week(tm), Time.end_of_week(tm), Time.beginning_of_month(tm), Time.end_of_quarter(tm), Time.beginning_of_year(tm), Time.next_weekday(tm), Time.prev_weekday(tm))
p(Time.days_in_month(2, 2024), Time.days_in_month(2, 2023), Time.days_in_year(2024), Time.on_weekend?(tm), Time.ago(tm, 60), Time.since(tm, 60), Time.last_month(tm), Time.next_quarter(tm))
puts(Time.to_fs(tm, :db), Time.to_fs(tm, :rfc822), Time.to_fs(tm, :long_ordinal), Time.formatted_offset(tm), Time.formatted_offset(tm, true, "UTC"))
d = Date.new(2024, 2, 29)
Array.each(Any[Date.advance(d, Hash.of(months: 1)), Date.change(d, Hash.of(day: 1)), Date.beginning_of_week(d), Date.end_of_month(d), Date.next_week(d), Date.prev_occurring(d, :monday), Date.days_ago(d, 3), Date.beginning_of_quarter(d)]) { |x| puts(Date.readable_inspect(x)) }
puts(Date.to_fs(d, :long), Date.to_fs(d, :long_ordinal), Date.to_fs(d, :db), Date.to_fs(d, :rfc822), Date.to_fs(d, :number), Date.to_fs(d))
