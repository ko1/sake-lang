# Port of activerecord-8.1.3/lib/active_record/connection_adapters/abstract/quoting.rb (partial: no
# column_name_matcher regexps (the model layer's sanitization), no quote_default_expression with a Proc)
#
# Ruby's ClassMethods (quote_column_name on the adapter class) are the adapter's own functions here. Where
# SQLite3::Quoting calls `super`, the body here is also kept as super_<name>.

module ActiveRecord
  module ConnectionAdapters
    module Quoting
      def quote_column_name(c, column_name) = raise(NotImplementedError)
      def quote_string(c, s) = raise(NotImplementedError)

      # Quotes the column value to help prevent SQL injection attacks.
      def quote(c, value) = super_quote(c, value)

      def super_quote(c, value)
        case value
        in String then "'#{quote_string(c, value)}'"
        in Symbol then "'#{quote_string(c, Symbol.to_s(value))}'"
        in true then quoted_true(c)
        in false then quoted_false(c)
        in nil then "NULL"
        in BigDecimal then BigDecimal.format(value, "F")
        in Integer | Float | Rational then Kernel.to_s(value)
        in ActiveModel::Type::Binary::Data then quoted_binary(c, value)
        in Date | Time then "'#{quoted_date(c, value)}'"
        else raise TypeError, "can't quote #{Arel.class_name(value)}"
        end
      end

      # Cast a value to a type that the database understands (Integer, Float, String or nil for SQLite3).
      def type_cast(c, value) = super_type_cast(c, value)

      def super_type_cast(c, value)
        case value
        in Symbol then Symbol.to_s(value)
        in ActiveModel::Type::Binary::Data then ActiveModel::Type::Binary::Data.to_s(value)
        in true then unquoted_true(c)
        in false then unquoted_false(c)
        in BigDecimal then BigDecimal.format(value, "F")
        in nil | Integer | Float | String then value
        in Date | Time then quoted_date(c, value)
        else raise TypeError, "can't cast #{Arel.class_name(value)}"
        end
      end

      def cast_bound_value(c, value) = value

      # Quotes a string, escaping any ' (single quote) and \ (backslash) characters.
      def super_quote_string(c, s) = String.gsub(s, "\\", "\\\\\\\\").String.gsub("'", "''")

      def quote_table_name(c, table_name) = quote_column_name(c, table_name)

      def quote_table_name_for_assignment(c, table, attr) = quote_table_name(c, "#{table}.#{attr}")

      def quote_default_expression(c, value, column)
        cast_type = Column.fetch_cast_type(column, c)
        quote(c, ActiveModel::Type::Value.serialize(cast_type, value))
      end

      def quoted_true(c) = "TRUE"
      def unquoted_true(c) = true
      def quoted_false(c) = "FALSE"
      def unquoted_false(c) = false

      # Quote date/time values for use in SQL input. Includes microseconds if the value is a Time responding to usec.
      def quoted_date(c, value)
        case value
        in Time
          v = ActiveRecord.default_timezone == :utc ? Time.getutc(value) : Time.getlocal(value)
          result = Time.strftime(v, "%Y-%m-%d %H:%M:%S")
          Time.usec(v) > 0 ? result + "." + format("%06d", Time.usec(v)) : result
        in Date then Date.strftime(value, "%Y-%m-%d")
        end
      end

      def quoted_time(c, value)
        value => Time
        t = Time.utc(2000, 1, 1, Time.hour(value), Time.min(value), Time.sec(value) + Rational(Time.nsec(value), 1_000_000_000))
        String.sub(quoted_date(c, t), /\A\d\d\d\d-\d\d-\d\d /, "")
      end

      def quoted_binary(c, value)
        "'#{quote_string(c, ActiveModel::Type::Binary::Data.to_s(value))}'"
      end

      def sanitize_as_sql_comment(c, value)
        comment = Kernel.to_s(value)
        comment = String.gsub(comment, %r{\A\s*/\*\+?\s?|\s?\*/\s*\Z}, "")
        comment = String.gsub(comment, "*/", "* /")
        String.gsub(comment, "/*", "/ *")
      end

      def lookup_cast_type(c, sql_type) = ActiveRecord::Type::TypeMap.lookup(type_map(c), sql_type)

      def type_map(c) = raise(NotImplementedError)

      def type_casted_binds(c, binds)
        Array.map(binds) do |value|
          (value in ActiveModel::Attribute) ? type_cast(c, ActiveModel::Attribute.value_for_database(value)) : type_cast(c, value)
        end
      end
    end
  end
end
