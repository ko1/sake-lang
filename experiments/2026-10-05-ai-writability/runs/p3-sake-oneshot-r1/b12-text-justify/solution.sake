def break_word(word, w)
  out = Array[]
  rest = word
  while String.size(rest) > w
    Array.push(out, String.slice(rest, 0, w - 1) + "-")
    rest = String.slice(rest, w - 1, String.size(rest))
  end
  Array.push(out, rest)
  out
end

def justify(ws, w)
  n = Array.size(ws)
  return Array.join(ws, " ") if n == 1
  chars = 0
  Array.each(ws) { |x| chars += String.size(x) }
  gaps = n - 1
  spaces = w - chars
  base = spaces / gaps
  extra = spaces % gaps
  out = ""
  Array.each_with_index(ws) do |x, i|
    out += x
    if i < gaps
      out += String.*(" ", base + (i < extra ? 1 : 0))
    end
  end
  out
end

def layout(words, w)
  pieces = Array[]
  Array.each(words) { |x| Array.concat(pieces, break_word(x, w)) }
  lines = Array[]
  cur = Array[]
  curlen = 0
  Array.each(pieces) do |x|
    len = String.size(x)
    if Array.empty?(cur)
      cur = Array[x]
      curlen = len
    elsif curlen + 1 + len <= w
      Array.push(cur, x)
      curlen += 1 + len
    else
      Array.push(lines, cur)
      cur = Array[x]
      curlen = len
    end
  end
  Array.push(lines, cur) unless Array.empty?(cur)
  out = Array[]
  last = Array.size(lines) - 1
  Array.each_with_index(lines) do |ws, i|
    if i == last
      Array.push(out, Array.join(ws, " "))
    else
      Array.push(out, justify(ws, w))
    end
  end
  out
end

all = IO.readlines(IO.stdin)
if Array.empty?(all)
  puts("invalid width")
  exit
end
head = String.strip(all[0])
if !String.match?(head, /\A\d+\z/) || String.to_i(head) < 2 || String.to_i(head) > 80
  puts("invalid width")
  exit
end
w = String.to_i(head)

paras = Array[]
cur = Array[]
k = 0
Array.each(Array.drop(all, 1)) do |raw|
  ws = String.split(raw, " ")
  if Array.empty?(ws)
    unless Array.empty?(cur)
      Array.push(paras, cur)
      cur = Array[]
    end
  else
    k += Array.size(ws)
    Array.concat(cur, ws)
  end
end
Array.push(paras, cur) unless Array.empty?(cur)

border = "+" + String.*("-", w) + "+"
puts(border)
nlines = 0
Array.each_with_index(paras) do |pw, i|
  if i > 0
    puts("|" + String.*(" ", w) + "|")
  end
  Array.each(layout(pw, w)) do |l|
    puts("|" + String.ljust(l, w) + "|")
    nlines += 1
  end
end
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{k}")
