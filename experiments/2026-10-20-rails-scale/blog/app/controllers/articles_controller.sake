class ArticlesController < ApplicationController
  attr_reader articles, article

  def index(c)
    @articles = Article.all
  end

  def show(c) = nil

  def new_(c)
    @article = Article.build
  end

  def edit(c) = nil

  def create(c)
    article = Article.build_with(ActionController::Parameters.to_hash(article_params(c)))
    @article = article

    if Article.save(article)
      redirect_to c, article, notice: "Article was successfully created."
    else
      render c, :new, status: :unprocessable_content
    end
  end

  def update(c)
    article = @article || raise(ArgumentError, "@article is not set")
    if Article.update_with(article, ActionController::Parameters.to_hash(article_params(c)))
      redirect_to c, article, notice: "Article was successfully updated.", status: :see_other
    else
      render c, :edit, status: :unprocessable_content
    end
  end

  def destroy(c)
    article = @article || raise(ArgumentError, "@article is not set")
    Article.destroy!(article)
    redirect_to c, articles_path(c), notice: "Article was successfully destroyed.", status: :see_other
  end

  # private
  def set_article(c)
    @article = Article.find(ActionController::Parameters.expect(params(c), :id))
  end

  def article_params(c) = ActionController::Parameters.expect(params(c), article: Any[:title, :body])
end
