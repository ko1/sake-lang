# Kruskal's minimum spanning tree over links parsed with a regexp, using a union-find with rank and
# path compression; Edge is Comparable.
# Shows: initialize filling fields after `new`, include Comparable, Record literals and patterns,
# Regexp match groups.

class UnionFind
  attr_reader sets
  attr_reader parent, rank

  def initialize(uf)
    @parent = nil
    @rank = nil
    @parent = Range.to_a(0...@sets)
    @rank = Array.new(@sets, 0)
  end

  def find(uf, x)
    root = x
    root = @parent[root] while @parent[root] != root
    while @parent[x] != root
      @parent[x], x = root, @parent[x]
    end
    root
  end

  def union(uf, a, b)
    ra = find(uf, a)
    rb = find(uf, b)
    return false if ra == rb
    ra, rb = rb, ra if @rank[ra] < @rank[rb]
    @parent[rb] = ra
    @rank[ra] += 1 if @rank[ra] == @rank[rb]
    @sets -= 1
    true
  end
end

class Edge
  include Comparable
  attr_reader a, b, cost

  def <=>(e, other)
    c = @cost <=> Edge.cost(other)
    return c if c != 0
    "#{@a}-#{@b}" <=> "#{Edge.a(other)}-#{Edge.b(other)}"
  end
  def to_s(e) = "#{@a}-#{@b} (#{@cost})"
end

def kruskal(names, edges)
  index = Hash[]
  Array.each_with_index(names) { |n, i| index[n] = i }
  uf = UnionFind.new(Array.size(names))
  chosen = Array[]
  rejected = 0
  Array.each(Array.sort(edges)) do |e|
    if UnionFind.union(uf, index[Edge.a(e)], index[Edge.b(e)])
      Array.push(chosen, e)
    else
      rejected += 1
    end
  end
  {tree: chosen, rejected: rejected, parts: UnionFind.sets(uf)}
end

def parse_edges(text)
  edges = Edge[]
  Array.each(String.lines(text)) do |line|
    m = String.match(line, /^\s*(\w+)\s*-\s*(\w+)\s*:\s*(\d+)/)
    next unless m
    Array.push(edges, Edge.new(m[1], m[2], String.to_i(m[3])))
  end
  edges
end

def summarize(title, names, text)
  puts("== #{title}")
  edges = parse_edges(text)
  result = kruskal(names, edges)
  result => {tree:, rejected:, parts:}
  Array.each(tree) { |e| puts("  #{e}") }
  total = Array.sum(tree) { |e| Edge.cost(e) }
  all = Array.sum(edges) { |e| Edge.cost(e) }
  puts("  cable: #{total} of #{all} (#{rejected} links skipped)")
  if parts > 1
    puts("  WARNING: network splits into #{parts} parts")
  end
  cheapest = Array.min(edges)
  priciest = Array.max(tree)
  puts("  cheapest link: #{cheapest}") if cheapest
  puts("  priciest used: #{priciest}") if priciest
end

office = Array["hq", "lab", "dock", "shop", "mill", "farm", "port"]
office_links = "hq - lab : 7\n" \
               "hq - dock : 5\n" \
               "lab - dock : 8\n" \
               "lab - shop : 9\n" \
               "lab - mill : 7\n" \
               "dock - shop : 15\n" \
               "dock - farm : 6\n" \
               "shop - farm : 8\n" \
               "shop - mill : 5\n" \
               "farm - mill : 9\n" \
               "farm - port : 11\n" \
               "mill - port : 9\n" \
               "# a comment line\n"
summarize("office campus", office, office_links)

islands = Array["a", "b", "c", "d", "e"]
island_links = "a - b : 3\nb - c : 1\na - c : 2\nd - e : 4\n"
summarize("two islands", islands, island_links)
