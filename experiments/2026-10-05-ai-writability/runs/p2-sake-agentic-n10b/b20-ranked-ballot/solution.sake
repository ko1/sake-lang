def pct(c, active)
  return "0.0%" if active == 0
  t = (c * 2000 + active) / (2 * active)
  "#{t / 10}.#{t % 10}%"
end

lines = Array.map(String.lines(IO.read(IO.stdin))) { |l| String.chomp(l) }
cands = Array.empty?(lines) ? String[] : Array.uniq(String.split(lines[0]))
if Array.empty?(cands)
  puts("no candidates")
  exit
end

out = String[]
ballots = Array[]
rejected = 0
Array.each_with_index(lines) do |raw, idx|
  next if idx == 0
  next if String.empty?(String.strip(raw))
  n = idx + 1
  ranks = Array.map(String.split(raw, ">", -1)) { |x| String.strip(x) }
  seen = String[]
  reason = nil
  Array.each(ranks) do |nm|
    if String.empty?(nm)
      reason = "empty rank"
    elsif !Array.include?(cands, nm)
      reason = "unknown candidate #{nm}"
    elsif Array.include?(seen, nm)
      reason = "duplicate #{nm}"
    end
    break if reason
    Array.push(seen, nm)
  end
  if reason
    Array.push(out, "rejected line #{n}: #{reason}")
    rejected += 1
  else
    Array.push(ballots, ranks)
  end
end
Array.push(out, "ballots: #{Array.size(ballots)} valid, #{rejected} rejected")

alive = Array.dup(cands)
history = Array[]
round = 0
done = false
while !done
  round += 1
  counts = Hash[]
  Array.each(alive) { |c| counts[c] = 0 }
  active = 0
  Array.each(ballots) do |b|
    top = Array.find(b) { |c| Array.include?(alive, c) }
    if top != nil
      counts[top] += 1
      active += 1
    end
  end
  Array.push(history, counts)
  Array.push(out, "round #{round}")
  order = Array.sort_by(alive) { |c| [-counts[c], c] }
  Array.each(order) { |c| Array.push(out, "  #{c} #{counts[c]} #{pct(counts[c], active)}") }
  Array.push(out, "  exhausted #{Array.size(ballots) - active}")
  winner = Array.find(alive) { |c| counts[c] * 2 > active }
  if active == 0
    Array.push(out, "no winner")
    done = true
  elsif winner != nil
    Array.push(out, "winner #{winner}")
    done = true
  else
    lo = Array.min(Array.map(alive) { |c| counts[c] })
    tied = Array.select(alive) { |c| counts[c] == lo }
    r = round - 2
    while Array.size(tied) > 1 && r >= 0
      h = history[r]
      m = Array.min(Array.map(tied) { |c| h[c] })
      tied = Array.select(tied) { |c| h[c] == m }
      r -= 1
    end
    victim = Array.last(Array.sort(tied))
    Array.push(out, "  eliminated #{victim}")
    alive = Array.reject(alive) { |c| c == victim }
  end
end
puts(*out)
