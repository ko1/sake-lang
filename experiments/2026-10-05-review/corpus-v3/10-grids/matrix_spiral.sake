class Matrix
  attr_reader height, width, data
  include Indexable

  def filled(h, w, v) = Matrix.new(h, w, Array.new(h * w, v))

  def from_rows(rows) = Matrix.new(Array.size(rows), Array.size(rows[0]), Array.flatten(rows))

  def [](m, r, c) = @data[r * @width + c]

  def []=(m, r, c, v)
    @data[r * @width + c] = v
  end

  def row(m, r) = @data[r * @width, @width]

  def transpose(m)
    out = filled(@width, @height, 0)
    Integer.times(@height) do |r|
      Integer.times(@width) { |c| out[c, r] = m[r, c] }
    end
    out
  end

  def rotate(m)
    out = filled(@width, @height, 0)
    Integer.times(@height) do |r|
      Integer.times(@width) { |c| out[c, @height - 1 - r] = m[r, c] }
    end
    out
  end

  def symmetric?(m)
    return false if @height != @width
    Range.all?(0...@height) { |r| Range.all?(0...r) { |c| m[r, c] == m[c, r] } }
  end

  def to_s(m)
    cell_width = Array.max(Array.map(@data) { String.size(Integer.to_s(it)) }) || 1
    Range.map(0...@height) { |r| Array.join(Array.map(row(m, r)) { String.rjust(Integer.to_s(it), cell_width) }, " ") }
      .Array.join("\n")
  end
end

def spiral(h, w)
  m = Matrix.filled(h, w, 0)
  top = 0
  left = 0
  bottom = h - 1
  right = w - 1
  n = 1
  while top <= bottom && left <= right
    Integer.upto(left, right) { |c| m[top, c] = n; n += 1 }
    top += 1
    Integer.upto(top, bottom) { |r| m[r, right] = n; n += 1 }
    right -= 1
    if top <= bottom
      Integer.downto(right, left) { |c| m[bottom, c] = n; n += 1 }
      bottom -= 1
    end
    if left <= right
      Integer.downto(bottom, top) { |r| m[r, left] = n; n += 1 }
      left += 1
    end
  end
  m
end

def spiral_order(m)
  out = Array[]
  seen = Set[]
  dirs = Array[[0, 1], [1, 0], [0, -1], [-1, 0]]
  r = 0
  c = 0
  d = 0
  while Array.size(out) < Matrix.get_height(m) * Matrix.get_width(m)
    Array.push(out, m[r, c])
    Set.add(seen, [r, c])
    dr, dc = dirs[d]
    nr = r + dr
    nc = c + dc
    if nr < 0 || nr >= Matrix.get_height(m) || nc < 0 || nc >= Matrix.get_width(m) || Set.include?(seen, [nr, nc])
      d = (d + 1) % 4
      dr, dc = dirs[d]
      nr = r + dr
      nc = c + dc
    end
    r = nr
    c = nc
  end
  out
end

Array.each(Array[[4, 4], [3, 5], [1, 4], [5, 2]]) do |h, w|
  m = spiral(h, w)
  puts("spiral #{h}x#{w}:")
  puts(m)
  order = spiral_order(m)
  puts("reads back in order: #{order == Range.to_a(1..(h * w))}")
  puts("rotated:")
  puts(Matrix.rotate(m))
end

sym = Matrix.from_rows(Array[Array[1, 7, 3], Array[7, 4, 5], Array[3, 5, 0]])
puts("symmetric: #{Matrix.symmetric?(sym)} / #{Matrix.symmetric?(spiral(3, 3))}")
t = Matrix.transpose(spiral(2, 3))
puts("transpose of 2x3 spiral is #{Matrix.get_height(t)}x#{Matrix.get_width(t)}:")
puts(t)
puts("trace: #{Range.sum(0...3) { |i| sym[i, i] }}")
