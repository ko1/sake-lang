# A module function whose body is only `raise NotImplementedError` is required from each type that includes it.
module Shape
  def area(s) = raise(NotImplementedError, "area")
  def each_corner(s) = raise(NotImplementedError)
  def describe(s) = "#{Shape.area(s)}"
end
Sq = Struct.new(:side)
class Sq
  include Shape
  def area(q) = @side * @side
  def each_corner(q)
    Integer.times(4) { |i| yield(i) }
  end
end
Ci = Struct.new(:r)
class Ci
  include Shape
  def area(c) = 3 * @r * @r
  def each_corner(c)
    yield(0)
  end
end
p(Shape.area(Sq.new(2)))
p(Shape.describe(Ci.new(1)))
Shape.each_corner(Sq.new(1)) { |i| print(i) }
puts
