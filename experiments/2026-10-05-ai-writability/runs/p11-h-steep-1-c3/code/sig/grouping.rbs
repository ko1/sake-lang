module Sql
  module Grouping
    def self.collapse: (SelectPlan plan, Array[Array[value]] rows, Array[value] outer) -> Array[Array[value]]
    def self.partition: (Array[Ast::Expr] terms, Array[Array[value]] rows) -> Array[Array[Array[value]]]
    def self.group_row: (SelectPlan plan, Array[Array[value]] group, Array[value] outer) -> Array[value]
    def self.representative: (SelectPlan plan, Array[Array[value]] group, Array[value] outer) -> Array[value]
  end
end
