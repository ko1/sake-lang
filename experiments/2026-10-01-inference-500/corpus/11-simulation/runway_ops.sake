Flight = Struct.new(:callsign, :op, :scheduled, :fuel, :heavy, :done_at, :emergency)

class Flight
  include Comparable

  def urgency(f)
    return 0 if @emergency
    @op == :land ? 1 : 2
  end

  def <=>(a, b)
    c = urgency(a) <=> Flight.urgency(b)
    return c if c != 0
    c = @scheduled <=> Flight.scheduled(b)
    c != 0 ? c : @callsign <=> Flight.callsign(b)
  end

  def to_s(f) = "#{@callsign}(#{@op == :land ? "L" : "T"}#{@emergency ? "!" : ""})"
end

def separation(prev, cur)
  return 0 if prev == nil
  base = Flight.op(prev) == Flight.op(cur) ? 2 : 1
  base += 2 if Flight.heavy(prev) && Flight.heavy(cur) == false
  base
end

def simulate(flights, closed)
  waiting = Flight[]
  done = Flight[]
  diverted = Flight[]
  last = nil
  free_at = 0
  t = 0
  while Array.size(done) + Array.size(diverted) < Array.size(flights) && t < 200
    Array.each(flights) { |f| Array.push(waiting, f) if Flight.scheduled(f) == t }
    Array.each(waiting) do |f|
      next unless Flight.op(f) == :land
      Flight.set_fuel(f, Flight.fuel(f) - 1)
      if Flight.fuel(f) <= 5 && Flight.emergency(f) == false
        Flight.set_emergency(f, true)
        puts(format("t=%3d %s declares fuel emergency", t, Flight.callsign(f)))
      end
    end
    out = Array.select(waiting) { |f| Flight.op(f) == :land && Flight.fuel(f) <= 0 }
    Array.each(out) do |f|
      Array.push(diverted, f)
      puts(format("t=%3d %s diverts", t, Flight.callsign(f)))
    end
    Array.delete_if(waiting) { |f| Array.include?(out, f) }
    closed_now = Array.any?(closed) { |r| Range.include?(r, t) }
    unless closed_now || Array.empty?(waiting)
      nxt = Array.min(waiting)
      ready = free_at + separation(last, nxt)
      if t >= ready
        Array.delete(waiting, nxt)
        Flight.set_done_at(nxt, t)
        Array.push(done, nxt)
        last = nxt
        free_at = t
      end
    end
    if t % 15 == 0 && Array.empty?(waiting) == false
      puts(format("t=%3d queue: %s", t, Array.join(Array.map(Array.sort(waiting)) { |f| "#{f}" }, " ")))
    end
    t += 1
  end
  [done, diverted, t]
end

def schedule
  rows = Array[
    ["BA12", :land, 0, 30, true], ["LH4", :take, 0, 0, false], ["AF77", :land, 1, 25, false],
    ["KL9", :take, 2, 0, true], ["UA90", :land, 3, 12, true], ["IB3", :take, 3, 0, false],
    ["SK5", :land, 5, 9, false], ["AY1", :take, 6, 0, false], ["EI8", :land, 8, 40, false],
    ["TP2", :take, 9, 0, false], ["LX6", :land, 10, 14, false], ["OS7", :take, 11, 0, true],
    ["AZ4", :land, 12, 20, false], ["SN3", :take, 14, 0, false], ["LO2", :land, 15, 8, false]
  ]
  Array.map(rows) { |cs, op, at, fuel, heavy| Flight.new(cs, op, at, fuel, heavy, nil, false) }
end

def report(title, closed)
  puts("== #{title}")
  flights = schedule
  done, diverted, finished = simulate(flights, closed)
  delays = Array.map(done) { |f| Flight.done_at(f) - Flight.scheduled(f) }
  puts("order: #{Array.join(Array.map(done) { |f| Flight.callsign(f) }, " ")}")
  Array.each(Array[:land, :take]) do |op|
    group = Array.select(done) { Flight.op(it) == op }
    d = Array.map(group) { |f| Flight.done_at(f) - Flight.scheduled(f) }
    avg = Array.empty?(d) ? 0.0 : Array.sum(d) / Integer.to_f(Array.size(d))
    puts(format("  %-4s %2d ops, avg delay %5.2f, max %2d", op, Array.size(group), avg, Array.max(d) || 0))
  end
  worst = Array.max_by(done) { |f| Flight.done_at(f) - Flight.scheduled(f) }
  puts("  worst: #{worst} delayed #{Flight.done_at(worst) - Flight.scheduled(worst)}") if worst
  puts("  diverted: #{Array.empty?(diverted) ? "none" : Array.join(Array.map(diverted) { "#{it}" }, ", ")}")
  puts("  runway clear at t=#{finished}")
  Array.sum(delays)
end

a = report("normal operations", Array[])
b = report("runway inspection 6..20", Array[6..20])
c = report("two closures", Array[4..9, 18..26])
puts("total delay minutes: #{a} / #{b} / #{c}")
