# Math scalar functions (spec 7): ceil / ceiling, floor, trunc, mod, pow / power, sqrt. (pi is in functions.sake.)
module MathFunctions
  module_function

  # The result of `fn` on `args` (already evaluated, not all-NULL-checked), or NULL.
  def call(fn, args)
    nums = Array.map(args) { argument(it) }
    return nil if Array.any?(nums) { it == nil }
    x = Array.fetch(nums, 0)
    case fn
    in "ceil" | "ceiling" then whole(x) { Float.ceil(it) }
    in "floor" then whole(x) { Float.floor(it) }
    in "trunc" then whole(x) { Float.truncate(it) }
    in "sqrt" then square_root(Arithmetic.to_f(x))
    in "mod" then remainder(Arithmetic.to_f(x), Arithmetic.to_f(Array.fetch(nums, 1)))
    in "pow" | "power" then power(Arithmetic.to_f(x), Arithmetic.to_f(Array.fetch(nums, 1)))
    end
  end

  # An argument as a number (7.1): NULL and TEXT that is not a whole numeric literal give nil.
  def argument(v)
    case v
    in nil then nil
    in String then Value.parse_numeric(v)
    in Integer | Float then v
    end
  end

  # An INTEGER is kept; a REAL is rounded by the block and stays a REAL.
  def whole(x)
    case x
    in Integer then x
    in Float then Arithmetic.to_f(yield(x))
    end
  end

  def square_root(x) = x < 0.0 ? nil : Arithmetic.to_f(Math.sqrt(x))

  # C's fmod: the sign of x; NULL for a zero y.
  def remainder(x, y)
    return nil if y == 0.0
    m = Float.modulo(Float.abs(x), Float.abs(y))
    x < 0.0 ? 0.0 - m : m
  end

  # x to the power y; NULL for a negative x with a fractional y.
  def power(x, y)
    return nil if x < 0.0 && y != Arithmetic.to_f(Float.floor(y))
    x ** y
  end
end
