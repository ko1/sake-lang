# What the ActiveModel generator writes for a class body (model_decl.rb's Person and Admin, attributes_decl.rb's
# Product): the class with its fields and includes, model_name, __send, _assign_attribute, the validators and
# their callbacks, the typed attribute readers and the Dirty methods. No Ruby twin: Ruby defines these at run time.
require "rails/activemodel/active_model/generate/active_model"

Array.each(String["model_decl.rb", "attributes_decl.rb"]) do |path|
  src = ActiveModel::Generate.program_source(File.read(path), path)
  lines = String.lines(src)
  puts("#{path}: #{Array.size(lines)} lines")
  Array.each(Array.take(lines, 60)) { |l| print(l) }
  puts("...")
end
