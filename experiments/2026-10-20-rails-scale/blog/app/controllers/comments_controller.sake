class CommentsController < ApplicationController
  attr_reader article, comment

  def create(c)
    article = Article.find(params(c)[:article_id])
    @article = article
    @comment = Comment::ActiveRecord_Associations_CollectionProxy.create_with_hash(Article.comments(article), ActionController::Parameters.to_hash(comment_params(c)))
    redirect_to c, article_path(c, article)
  end

  def destroy(c)
    article = Article.find(params(c)[:article_id])
    @article = article
    comment = Comment::ActiveRecord_Associations_CollectionProxy.find(Article.comments(article), params(c)[:id])
    @comment = comment
    Comment.destroy(comment)
    redirect_to c, article_path(c, article), status: :see_other
  end

  # private
  def comment_params(c) = ActionController::Parameters.expect(params(c), comment: Any[:commenter, :body])
end
