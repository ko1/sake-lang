# Mini: reads a program from standard input and runs it (SPEC section 1).
#
#   sake main.sake [--tokens | --ast] < program.mini
#
# Phases: lexing (lexer.sake), parsing (parser.sake, parser_expr.sake), the static checks
# (checker.sake), evaluation (evaluator.sake). Everything, errors included, goes to standard output.

require "errors"
require "lexer"
require "ast"
require "parser"
require "parser_expr"
require "static_scope"
require "checker"
require "values"
require "text"
require "runtime"
require "operators"
require "evaluator"
require "builtins"
require "dump"

def usage = "usage: sake main.sake [--tokens | --ast] < program.mini"

def main(args)
  mode = Array.first(args)
  if Array.size(args) > 1 || (mode != nil && mode != "--tokens" && mode != "--ast")
    emit_line(usage)
    return
  end
  source = IO.read(IO.stdin)
  begin
    tokens = lex(source)
    if mode == "--tokens"
      dump_tokens(tokens, "")
      return
    end
    program = parse(tokens)
    check_program(program)
    if mode == "--ast"
      dump_program(program)
      return
    end
  rescue CompileError => e
    emit_line(error_line(CompileError.phase(e), CompileError.line(e), CompileError.col(e), Exception.message(e)))
    return
  end
  run_program(program)
end

main(ARGV)
