# Integer matrix power: Fibonacci numbers from [[1,1],[1,0]]**n, and its determinant.
q = Mat.of(Any[Any[1, 1], Any[1, 0]])
def fib(q, n) = Mat.at(q ** n, 0, 1)

Array.each(Any[1, 2, 10, 50, 100, 300]) { |n| puts("fib(#{n}) = #{fib(q, n)}") }

# Cassini's identity: det(Q**n) = (-1)**n, i.e. F(n+1)F(n-1) - F(n)**2.
Array.each(Any[5, 6, 99]) { |n| puts("det(Q**#{n}) = #{Mat.det(q ** n)}") }

# Counting walks: paths of length k in a graph are entries of A**k.
adj = Mat.of(Any[Any[0, 1, 1, 0], Any[1, 0, 1, 1], Any[1, 1, 0, 1], Any[0, 1, 1, 0]])
puts("walks of length 6 =")
puts(adj ** 6)
puts("det(adj) = #{Mat.det(adj)}")
puts("transpose(adj) == adj: #{Mat.transpose(adj) == adj}")
