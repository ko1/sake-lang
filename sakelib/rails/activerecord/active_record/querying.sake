# Port of activerecord-8.1.3/lib/active_record/querying.rb (partial: no find_by_sql with binds of Arel, no
# async_*, no count_by_sql's preparable)
#
# Ruby delegates ~100 class methods to `all` (delegate(*QUERYING_METHODS, to: :all)); here each is a one-line
# mixin function of the model calling the Relation's (Post.where(...) is Relation.where(Post.all, ...)).

module ActiveRecord
  module Querying
    def find(id) = Relation.find(all, id)
    def find_some(ids) = Relation.find_some(all, ids)
    def find_by(conds = nil, **kwconds) = Relation.find_by(all, conds, **kwconds)
    def find_by!(conds = nil, **kwconds) = Relation.find_by!(all, conds, **kwconds)
    def take = Relation.take(all)
    def take! = Relation.take!(all)
    def first = Relation.first(all)
    def first! = Relation.first!(all)
    def last = Relation.last(all)
    def last! = Relation.last!(all)
    def first_n(n) = Relation.first_n(all, n)
    def last_n(n) = Relation.last_n(all, n)
    def exists?(conditions = :none) = Relation.exists?(all, conditions)
    def any? = Relation.any?(all)
    def many? = Relation.many?(all)
    def none? = Relation.none?(all)
    def one? = Relation.one?(all)
    def find_or_create_by(**attributes) = Relation.find_or_create_by(all, **attributes)
    def find_or_create_by!(**attributes) = Relation.find_or_create_by!(all, **attributes)
    def find_or_initialize_by(**attributes) = Relation.find_or_initialize_by(all, **attributes)
    def find_each(batch_size: 1000, &b) = Relation.find_each(all, batch_size: batch_size, &b)
    def find_in_batches(batch_size: 1000, &b) = Relation.find_in_batches(all, batch_size: batch_size, &b)
    def destroy_all = Relation.destroy_all(all)
    def delete_all = Relation.delete_all(all)
    def update_all(updates = nil, **attrs) = Relation.update_all(all, updates, **attrs)
    def destroy_by(**conds) = Relation.destroy_by(all, **conds)
    def delete_by(**conds) = Relation.delete_by(all, **conds)
    def where(opts = nil, *rest, **conds) = Relation.where(all, opts, *rest, **conds)
    def where_not(opts = nil, *rest, **conds) = Relation.where_not(all, opts, *rest, **conds)
    def rewhere(**conds) = Relation.rewhere(all, **conds)
    def order(*args, **dirs) = Relation.order(all, *args, **dirs)
    def reorder(*args, **dirs) = Relation.reorder(all, *args, **dirs)
    def limit(value) = Relation.limit(all, value)
    def offset(value) = Relation.offset(all, value)
    def select(*fields) = Relation.select(all, *fields)
    def group(*fields) = Relation.group(all, *fields)
    def having(opts, *rest) = Relation.having(all, opts, *rest)
    def distinct(value = true) = Relation.distinct(all, value)
    def joins(*args) = Relation.joins(all, *args)
    def left_joins(*args) = Relation.left_outer_joins(all, *args)
    def left_outer_joins(*args) = Relation.left_outer_joins(all, *args)
    def includes(*args) = Relation.includes(all, *args)
    def preload(*args) = Relation.preload(all, *args)
    def eager_load(*args) = Relation.eager_load(all, *args)
    def references(*args) = Relation.references(all, *args)
    def readonly(value = true) = Relation.readonly(all, value)
    def lock(locks = true) = Relation.lock(all, locks)
    def none = Relation.none(all)
    def unscope(*args) = Relation.unscope(all, *args)
    def create_with(value) = Relation.create_with(all, value)
    def from(value) = Relation.from(all, value)
    def strict_loading(value = true) = Relation.strict_loading(all, value)
    def annotate(*args) = Relation.annotate(all, *args)
    def merge(other) = Relation.merge(all, other)
    def count(column_name = nil) = Relation.count(all, column_name)
    def average(column_name) = Relation.average(all, column_name)
    def minimum(column_name) = Relation.minimum(all, column_name)
    def maximum(column_name) = Relation.maximum(all, column_name)
    def sum(column_name = nil) = Relation.sum(all, column_name)
    def calculate(operation, column_name) = Relation.calculate(all, operation, column_name)
    def pluck(*column_names) = Relation.pluck(all, *column_names)
    def pick(*column_names) = Relation.pick(all, *column_names)
    def ids = Relation.ids(all)

    # Ruby: find_by_sql(sql, binds = []) (records from any SELECT)
    def find_by_sql(sql, binds = Any[])
      result = ConnectionAdapters::SQLite3Adapter.select_all(ActiveRecord::Base.connection, sql, "#{ModelClass.name(__model)} Load", binds)
      Array.map(ActiveRecord::Result.to_a(result)) { |row| instantiate(row) }
    end

    def count_by_sql(sql)
      v = ConnectionAdapters::SQLite3Adapter.select_value(ActiveRecord::Base.connection, sql, "#{ModelClass.name(__model)} Count")
      (v in Integer) ? v : String.to_i(Kernel.to_s(v))
    end
  end
end
