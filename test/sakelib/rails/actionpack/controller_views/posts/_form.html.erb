<%# locals: (post:) -%>
<%= form_with view, model: post do |form| %>
  <% if post && Post.errors_count(post) > 0 %>
    <p class="errors"><%= pluralize view, Post.errors_count(post), "error" %></p>
  <% end %>
  <%= FormBuilder.label form, :title %>
  <%= FormBuilder.text_field form, :title %>
  <%= FormBuilder.submit form %>
<% end %>
