# Port of activerecord-8.1.3/lib/arel/collectors/plain_string.rb
#
# The collectors share no Ruby superclass but answer the same messages (<<, add_bind, add_binds, value,
# retryable=); Collector (Sake only) is the module they include so that the visitor's
# `Collector.add_bind(collector, ...)` dispatches. `<<` is Bitwise's operator.

module Arel
  module Collectors
    module Collector
      include Bitwise
      def <<(c, str) = raise(NotImplementedError)
      def value(c) = raise(NotImplementedError)
      def add_bind(c, bind, &block) = raise(NotImplementedError)
      def add_binds(c, binds, proc_for_binds = nil, &block) = raise(NotImplementedError)
      def retryable(c) = raise(NotImplementedError)
      def set_retryable(c, v) = raise(NotImplementedError)
    end

    class PlainString
      attr_reader str
      def initialize(c) = @str ||= ""
      def value(c) = @str
      include Bitwise
      def <<(c, s)
        @str += s
        c
      end
    end
  end
end
