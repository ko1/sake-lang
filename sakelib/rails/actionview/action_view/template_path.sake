# Port of actionview-8.1.3/lib/action_view/template_path.rb

module ActionView
  class TemplatePath
    attr_reader name, prefix, partial, virtual
    include Comparable

    def virtual_path(t) = @virtual
    def partial?(t) = @partial

    # Ruby: TemplatePath.virtual(name, prefix, partial)
    def virtual_of(name, prefix, partial)
      if String.empty?(prefix)
        "#{partial ? "_" : ""}#{name}"
      elsif partial
        "#{prefix}/_#{name}"
      else
        "#{prefix}/#{name}"
      end
    end

    def parse(virtual)
      nameidx = String.rindex(virtual, "/")
      if nameidx
        prefix = String.[](virtual, 0, nameidx) || ""
        name = String.[](virtual, (nameidx + 1)..) || ""
        prefix = String.[](prefix, 1..) || "" if String.start_with?(prefix, "/")
      else
        prefix = ""
        name = virtual
      end
      partial = String.start_with?(name, "_")
      name = String.[](name, 1..) || "" if partial
      TemplatePath.new(name, prefix, partial, virtual)
    end

    def build(name, prefix, partial) = TemplatePath.new(name, prefix, partial, virtual_of(name, prefix, partial))

    def to_str(t) = @virtual
    def to_s(t) = @virtual
    def <=>(a, b) = @virtual <=> TemplatePath.virtual(b)
  end
end
