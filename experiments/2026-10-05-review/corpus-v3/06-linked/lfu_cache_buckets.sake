Item = Struct.new(:key, :value, :bucket, :prev, :next)
Bucket = Struct.new(:freq, :head, :tail, :prev, :next)

class Bucket
  def empty?(b) = @head == nil

  def append(b, item)
    Item.set_bucket(item, b)
    Item.set_prev(item, @tail)
    Item.set_next(item, nil)
    t = @tail
    if t
      Item.set_next(t, item)
    else
      @head = item
    end
    @tail = item
  end

  def remove(b, item)
    pv = Item.prev(item)
    nx = Item.next(item)
    pv ? Item.set_next(pv, nx) : @head = nx
    nx ? Item.set_prev(nx, pv) : @tail = pv
  end

  def keys(b)
    out = Array[]
    it = @head
    while it
      Array.push(out, Item.key(it))
      it = Item.next(it)
    end
    out
  end
end

class LFU
  attr_reader capacity, items, lowest, log

  def initialize(c)
    @items = nil
    @lowest = nil
    @log = nil
    @items = Hash[]
    @log = Array[]
  end

  def drop_bucket(c, b)
    pv = Bucket.prev(b)
    nx = Bucket.next(b)
    pv ? Bucket.set_next(pv, nx) : @lowest = nx
    Bucket.set_prev(nx, pv) if nx
  end

  def touch(c, item)
    b = Item.bucket(item)
    target = Bucket.next(b)
    if target == nil || Bucket.freq(target) != Bucket.freq(b) + 1
      target = Bucket.new(Bucket.freq(b) + 1, nil, nil, b, target)
      after = Bucket.next(target)
      Bucket.set_prev(after, target) if after
      Bucket.set_next(b, target)
    end
    Bucket.remove(b, item)
    Bucket.append(target, item)
    drop_bucket(c, b) if Bucket.empty?(b)
  end

  def get(c, key)
    item = @items[key]
    return nil unless item
    touch(c, item)
    Item.value(item)
  end

  def put(c, key, value)
    item = @items[key]
    if item
      Item.set_value(item, value)
      touch(c, item)
      return
    end
    if Hash.size(@items) >= @capacity
      low = @lowest
      victim = Bucket.head(low)
      Bucket.remove(low, victim)
      Hash.delete(@items, Item.key(victim))
      Array.push(@log, "evict #{Item.key(victim)} (freq #{Bucket.freq(low)})")
      drop_bucket(c, low) if Bucket.empty?(low)
    end
    first = @lowest
    if first == nil || Bucket.freq(first) != 1
      first = Bucket.new(1, nil, nil, nil, first)
      nx = Bucket.next(first)
      Bucket.set_prev(nx, first) if nx
      @lowest = first
    end
    item = Item.new(key, value, first, nil, nil)
    Bucket.append(first, item)
    @items[key] = item
  end

  def layout(c)
    parts = Array[]
    b = @lowest
    while b
      Array.push(parts, "#{Bucket.freq(b)}:#{Array.join(Bucket.keys(b), ",")}")
      b = Bucket.next(b)
    end
    Array.join(parts, " | ")
  end
end

cache = LFU.new(3)
script = Array[
  [:put, "x", 10], [:put, "y", 20], [:get, "x", 0], [:put, "z", 30], [:get, "x", 0],
  [:get, "y", 0], [:put, "w", 40], [:get, "z", 0], [:get, "w", 0], [:put, "v", 50],
  [:get, "w", 0], [:get, "w", 0], [:put, "y", 21], [:get, "y", 0], [:put, "u", 60], [:get, "x", 0]
]
Array.each(script) do |op, key, value|
  if op == :put
    LFU.put(cache, key, value)
    puts(format("put %s=%-3d  %s", key, value, LFU.layout(cache)))
  else
    got = LFU.get(cache, key)
    puts(format("get %s -> %-4s %s", key, got ? Integer.to_s(got) : "miss", LFU.layout(cache)))
  end
end
puts("log:")
Array.each(LFU.log(cache)) { |line| puts("  " + line) }

words = String.split("to be or not to be that is the question to ask or not", " ")
wc = LFU.new(4)
misses = 0
Array.each(words) do |w|
  n = LFU.get(wc, w)
  if n
    LFU.put(wc, w, n + 1)
  else
    misses += 1
    LFU.put(wc, w, 1)
  end
end
puts("word cache: #{LFU.layout(wc)} misses=#{misses}")
puts("evictions: #{Array.size(LFU.log(wc))}")
