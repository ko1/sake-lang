class Booking
  attr_reader id, room, day, s, e, who
end

def days = Array["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

def tmin(t)
  return -1 unless Regexp.match?(/\A\d\d:\d\d\z/, t)
  h = String.to_i(String.slice(t, 0, 2))
  m = String.to_i(String.slice(t, 3, 2))
  return -1 if m >= 60 || m % 15 != 0
  v = h * 60 + m
  return -1 if v < 480 || v > 1200
  v
end

def hhmm(v) = format("%02d:%02d", v / 60, v % 60)

def err(n, msg) = puts("line #{n}: error: #{msg}")

def good_room(r) = Regexp.match?(/\A[A-Z0-9]{1,8}\z/, r)

def good_day(d) = Array.include?(days, d)

def dayidx(d) = Array.index(days, d) || 0

bs = Booking[]
nextid = 1
lineno = 0
while (line = gets)
  lineno += 1
  l = String.strip(String.chomp(line))
  next if String.empty?(l)
  f = String.split(l, " ")
  cmd = f[0]
  n = Array.size(f)
  if cmd == "BOOK"
    if n != 5
      err(lineno, "wrong field count")
      next
    end
    room = f[1]
    day = f[2]
    if !good_room(room)
      err(lineno, "bad room")
      next
    end
    if !good_day(day)
      err(lineno, "bad day")
      next
    end
    tp = String.split(f[3], "-", -1)
    s = Array.size(tp) == 2 ? tmin(tp[0]) : -1
    e = Array.size(tp) == 2 ? tmin(tp[1]) : -1
    if s < 0 || e < 0 || s >= e
      err(lineno, "bad time")
      next
    end
    who = f[4]
    if !Regexp.match?(/\A[a-z]{1,12}\z/, who)
      err(lineno, "bad name")
      next
    end
    cs = Array.select(bs) { |b| Booking.room(b) == room && Booking.day(b) == day && Booking.s(b) < e && s < Booking.e(b) }
    if !Array.empty?(cs)
      c = Array.min_by(cs) { Booking.s(it) }
      c => Booking
      puts("CONFLICT #{room} #{day} with ##{Booking.id(c)} (#{Booking.who(c)} #{hhmm(Booking.s(c))}-#{hhmm(Booking.e(c))})")
      next
    end
    cnt = Array.count(bs) { |b| Booking.who(b) == who && Booking.day(b) == day }
    if cnt >= 3
      puts("LIMIT #{who} #{day}")
      next
    end
    Array.push(bs, Booking.new(nextid, room, day, s, e, who))
    puts("OK ##{nextid} #{room} #{day} #{hhmm(s)}-#{hhmm(e)} #{who}")
    nextid += 1
  elsif cmd == "CANCEL"
    if n != 2
      err(lineno, "wrong field count")
      next
    end
    if !Regexp.match?(/\A\d+\z/, f[1])
      err(lineno, "bad id")
      next
    end
    id = String.to_i(f[1])
    if Array.any?(bs) { Booking.id(it) == id }
      Array.delete_if(bs) { Booking.id(it) == id }
      puts("CANCELLED ##{id}")
    else
      puts("NO BOOKING ##{id}")
    end
  elsif cmd == "FREE"
    if n != 4
      err(lineno, "wrong field count")
      next
    end
    room = f[1]
    day = f[2]
    if !good_room(room)
      err(lineno, "bad room")
      next
    end
    if !good_day(day)
      err(lineno, "bad day")
      next
    end
    if !Regexp.match?(/\A\d+\z/, f[3]) || String.to_i(f[3]) <= 0 || String.to_i(f[3]) % 15 != 0
      err(lineno, "bad duration")
      next
    end
    m = String.to_i(f[3])
    st = 480
    found = -1
    while st + m <= 1200
      en = st + m
      if !Array.any?(bs) { |b| Booking.room(b) == room && Booking.day(b) == day && Booking.s(b) < en && st < Booking.e(b) }
        found = st
        break
      end
      st += 15
    end
    if found < 0
      puts("FULL #{room} #{day}")
    else
      puts("FREE #{room} #{day} #{hhmm(found)}-#{hhmm(found + m)}")
    end
  else
    err(lineno, "unknown command")
  end
end

puts("== schedule ==")
sorted = Array.sort_by(bs) { |b| [dayidx(Booking.day(b)), Booking.room(b), Booking.s(b)] }
puts("(none)") if Array.empty?(sorted)
Array.each(sorted) do |b|
  puts(format("%s %-8s %s-%s #%d %s", Booking.day(b), Booking.room(b), hhmm(Booking.s(b)), hhmm(Booking.e(b)), Booking.id(b), Booking.who(b)))
end
puts("== usage ==")
tot = Hash.new(0)
Array.each(bs) { |b| tot[Booking.room(b)] += Booking.e(b) - Booking.s(b) }
rooms = Array.sort(Hash.keys(tot))
puts("(none)") if Array.empty?(rooms)
Array.each(rooms) do |r|
  puts(format("%-8s %dh%02dm", r, tot[r] / 60, tot[r] % 60))
end
