Hit = Struct.new(:word, :row, :col, :dir)

def directions
  Array[
    {name: "E", dr: 0, dc: 1}, {name: "W", dr: 0, dc: -1},
    {name: "S", dr: 1, dc: 0}, {name: "N", dr: -1, dc: 0},
    {name: "SE", dr: 1, dc: 1}, {name: "NW", dr: -1, dc: -1},
    {name: "NE", dr: -1, dc: 1}, {name: "SW", dr: 1, dc: -1},
  ]
end

Puzzle = Struct.new(:letters, :used)

class Puzzle
  def parse(rows)
    letters = Array.map(rows) { |row| String.chars(String.upcase(String.delete(row, " "))) }
    used = Array.map(letters) { |row| Array.map(row) { false } }
    Puzzle.new(letters, used)
  end

  def letter(pz, r, c)
    return nil if r < 0 || c < 0
    row = @letters[r]
    row ? row[c] : nil
  end

  def matches?(pz, word, r, c, dr, dc)
    i = 0
    n = String.size(word)
    while i < n
      return false if letter(pz, r + dr * i, c + dc * i) != word[i]
      i += 1
    end
    true
  end

  def find(pz, word)
    target = String.upcase(word)
    first = target[0]
    Array.each_with_index(@letters) do |row, r|
      Array.each_with_index(row) do |ch, c|
        next if ch != first
        Array.each(directions) do |d|
          d => {name:, dr:, dc:}
          return Hit.new(target, r, c, name) if matches?(pz, target, r, c, dr, dc)
        end
      end
    end
    nil
  end

  def mark(pz, hit)
    d = Array.find(directions) { |x| x => {name:}; name == Hit.get_dir(hit) }
    return unless d
    d => {dr:, dc:}
    Integer.times(String.size(Hit.get_word(hit))) do |i|
      @used[Hit.get_row(hit) + dr * i][Hit.get_col(hit) + dc * i] = true
    end
  end

  def leftovers(pz)
    out = Array[]
    Array.each_with_index(@letters) do |row, r|
      Array.each_with_index(row) { |ch, c| Array.push(out, ch) unless @used[r][c] }
    end
    Array.join(out)
  end

  def render(pz)
    lines = Array.map(Array.zip(@letters, @used)) do |letters, used|
      Array.join(Array.map(Array.zip(letters, used)) { |ch, u| u ? ch : String.downcase(ch) }, " ")
    end
    Array.join(lines, "\n")
  end
end

grid = Array[
  "R U B Y T K O H N",
  "A S T R I N G E L",
  "N H S E T N I O O",
  "G E A R R A Y P O",
  "E K H S A H S P E",
  "W L U P O R C A K",
  "M A P T U P L E A",
  "B L O C K S I T S",
]
words = Array["ruby", "string", "array", "hash", "range", "block", "tuple", "loop", "map", "shell", "sake", "yield", "keys", "set"]

pz = Puzzle.parse(grid)
found = Array[]
missing = Array[]
Array.each(words) do |w|
  hit = Puzzle.find(pz, w)
  if hit
    Array.push(found, hit)
    Puzzle.mark(pz, hit)
  else
    Array.push(missing, w)
  end
end

Array.each(Array.sort_by(found) { |h| Hit.get_word(h) }) do |h|
  puts(format("%-7s at (%d,%d) going %s", Hit.get_word(h), Hit.get_row(h), Hit.get_col(h), Hit.get_dir(h)))
end
puts("not found: #{Array.join(missing, ", ")}")
by_dir = Array.tally(Array.map(found) { Hit.get_dir(it) })
puts("directions: #{Array.join(Array.map(Array.sort(Hash.keys(by_dir))) { |k| "#{k}=#{by_dir[k]}" }, " ")}")
puts(Puzzle.render(pz))
puts("leftover letters: #{Puzzle.leftovers(pz)}")
