# Typical use: a sales report from CSV text.

def sales_csv
  "date,region,product,units,price\n" \
  "2026-09-01,North,Widget,12,9.99\n" \
  "2026-09-01,South,\"Gadget, large\",3,24.50\n" \
  "2026-09-02,North,Gadget,7,19.00\n" \
  "2026-09-02,East,\"The \"\"Best\"\" Widget\",1,120.00\n" \
  "2026-09-03,South,Widget,40,9.99\n" \
  "2026-09-03,East,Widget,5,9.99\n"
end

t = Table.from_csv(sales_csv)
Table.map_column!(t, "units") { |s| (s in String) ? Num.parse(s) : s }
Table.map_column!(t, "price") { |s| (s in String) ? Num.parse(s) : s }

# Add a revenue column: units * price.
rows = Array.map(Table.get_rows(t)) do |r|
  r + Array[Table.number_at(t, r, "units") * Table.number_at(t, r, "price")]
end
sales = Table.new(Table.get_headers(t) + Array["revenue"], rows)

puts("== All sales, by revenue ==")
puts(Table.render(Table.sort_by_column(sales, "revenue", descending: true)))
puts

puts("== Revenue by region ==")
by_region = Table.group_sum(sales, "region", Array["units", "revenue"])
puts(Table.render(Table.sort_by_column(by_region, "revenue", descending: true)))
puts

puts("== Widgets only, as CSV ==")
widgets = Table.filter(sales) { |r| String.include?(Table.string_at(sales, r, "product"), "Widget") }
print(Table.to_csv(Table.select(widgets, Array["date", "product", "revenue"])))
