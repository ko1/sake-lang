# sake: --strict=0
# Unchecked, `g(**opts)` raises Ruby's ArgumentError at the call: a key g does not take, a required keyword missing.
def need(s, sep:) = String.split(s, sep)
def via(s, **opts) = need(s, **opts)
begin
  via("a,b")
rescue ArgumentError => e
  puts Exception.message(e)
end
begin
  via("a,b", sep: ",", limit: 1, x: 2)
rescue ArgumentError => e
  puts Exception.message(e)
end
p via("a,b", sep: ",")
