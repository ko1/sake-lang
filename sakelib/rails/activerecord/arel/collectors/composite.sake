# Port of activerecord-8.1.3/lib/arel/collectors/composite.rb
#
# Ruby passes the visitor's bind block on with &block; here the block given to add_bind is yielded where the
# string half needs it (the left, a SQLString), and the bind half (a Bind) takes no block.

module Arel
  module Collectors
    class Composite
      private attr_reader left, right
      attr_accessor preparable
      attr_reader retryable
      include Collector
      def initialize(c) = nil

      def set_retryable(c, retryable)
        Collector.set_retryable(@left, retryable)
        Collector.set_retryable(@right, retryable)
        @retryable = retryable
      end

      def <<(c, str)
        @left << str
        @right << str
        c
      end

      def add_bind(c, bind)
        Collector.add_bind(@left, bind) { |i| yield(i) }
        Collector.add_bind(@right, bind) { |i| yield(i) }
        c
      end

      def add_binds(c, binds, proc_for_binds = nil)
        Collector.add_binds(@left, binds, proc_for_binds) { |i| yield(i) }
        Collector.add_binds(@right, binds, proc_for_binds) { |i| yield(i) }
        c
      end

      def value(c) = [Collector.value(@left), Collector.value(@right)]
    end
  end
end
