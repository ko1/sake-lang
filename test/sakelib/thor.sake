require "thor"

# A CLI with the usual thor features: desc, method_option of each type, class_option, long_desc, an alias.
# Ruby: class Repo < Thor with one method per command; here the commands are a table (build_repo) and
# `run` dispatches by name.
class Repo
  attr_reader thor
  include ThorCLI

  def run(cli, name, args, options)
    case name
    in "greet" then greet(cli, Array.fetch(args, 0), options)
    in "add" then add(cli, args, options)
    in "commit" then commit(cli, options)
    in "config" then config(cli, Array.fetch(args, 0), args[1])
    in "tag" then tag(cli, Array.fetch(args, 0), options)
    in "version" then version(cli)
    else raise "unknown command #{name}"
    end
  end

  def greet(cli, name, options)
    g = "Hello, #{name}!"
    g = String.upcase(g) if Thor.flag?(options, :shout)
    Integer.times(Thor.integer(options, :times)) { puts g }
    puts "(verbose)" if Thor.flag?(options, :verbose)
  end

  def add(cli, files, options)
    puts "add #{Kernel.inspect(files)} force=#{Kernel.inspect(options[:force])} tags=#{Kernel.inspect(options[:tags])}"
  end

  def commit(cli, options)
    puts "commit message=#{Kernel.inspect(options[:message])} author=#{Kernel.inspect(options[:author])} level=#{Kernel.inspect(options[:level])}"
  end

  def config(cli, key, value) = puts("config #{key}=#{Kernel.inspect(value)}")

  def tag(cli, name, options) = puts("tag #{name} meta=#{Kernel.inspect(options[:meta])}")

  def version(cli) = puts("repo 1.0")
end

def build_repo
  app = Thor.app("repo")
  Thor.class_option(app, :verbose, type: :boolean, aliases: "-v", desc: "Print more")

  Thor.desc(app, "greet NAME", "Say hello to NAME")
  Thor.long_desc(app, "Greets NAME.\nWith --shout the greeting is upcased.")
  Thor.method_option(app, :shout, type: :boolean, aliases: "-s", desc: "Shout the greeting")
  Thor.method_option(app, :times, type: :numeric, default: 1, aliases: "-t", desc: "How many times")
  Thor.command(app, "greet")

  Thor.desc(app, "add FILES...", "Add FILES to the index")
  Thor.method_option(app, :force, type: :boolean, default: false)
  Thor.method_option(app, :tags, type: :array, aliases: "-T", desc: "Tags to attach")
  Thor.command(app, "add")

  Thor.desc(app, "commit", "Record changes")
  Thor.method_option(app, :message, type: :string, required: true, aliases: "-m", banner: "MSG", desc: "Commit message")
  Thor.method_option(app, :author, type: :string, default: "me", desc: "Author name")
  Thor.method_option(app, :level, type: :numeric, enum: Integer[1, 2, 3], default: 1)
  Thor.command(app, "commit")

  Thor.desc(app, "config KEY [VALUE]", "Get or set KEY")
  Thor.command(app, "config")

  Thor.desc(app, "tag NAME", "Tag with NAME", hide: true)
  Thor.method_option(app, :meta, type: :hash, desc: "key:value pairs")
  Thor.command(app, "tag")

  Thor.map(app, "ci", :commit)
  Thor.map(app, String["--version", "-V"], :version)

  Thor.desc(app, "version", "Print the version")
  Thor.command(app, "version")
  Repo.new(app)
end

def run(cli, argv)
  puts "$ repo #{Array.join(argv, " ")}"
  begin
    Thor.start(cli, argv, debug: true)
  rescue ThorError => e
    puts Exception.message(e)
  end
end

cli = build_repo
run(cli, String["greet", "World"])
run(cli, String["greet", "World", "--shout"])
run(cli, String["greet", "World", "-s", "-t", "2"])
run(cli, String["greet", "--times=3", "Bob"])
run(cli, String["greet", "World", "--no-shout", "--verbose"])
run(cli, String["greet", "World", "-v", "--times", "0"])
run(cli, String["add", "a.rb", "b.rb", "--force", "--tags", "x", "y"])
run(cli, String["add", "--tags=one", "--", "c.rb"])
run(cli, String["add", "a.rb", "-T", "t1", "t2", "--no-force"])
run(cli, String["commit", "-m", "first"])
run(cli, String["commit", "--message", "second", "--author", "ko1", "--level", "3"])
run(cli, String["ci", "--message=third"])
run(cli, String["config", "user"])
run(cli, String["config", "user", "ko1"])
run(cli, String["tag", "v1"])
run(cli, String["tag", "v2", "--meta", "a:1", "b:two", "plain"])
run(cli, String["greet", "-sv", "-t2", "Combined"])
run(cli, String["greet", "World", "--shout", "false"])
run(cli, String["gr", "Prefix"])
run(cli, String["c"])
run(cli, String["version"])
run(cli, String["tree"])
run(cli, String["help", "tag"])
run(cli, String["help", "help"])
run(cli, String["--version"])
run(cli, String["-V"])
run(cli, String[])
run(cli, String["help"])
run(cli, String["help", "greet"])
run(cli, String["help", "add"])
run(cli, String["help", "commit"])
run(cli, String["help", "config"])
run(cli, String["greet", "--help"])
run(cli, String["greet"])
run(cli, String["greet", "a", "b"])
run(cli, String["config"])
run(cli, String["config", "a", "b", "c"])
run(cli, String["commit"])
run(cli, String["commit", "-m", "x", "--level", "9"])
run(cli, String["commit", "-m", "x", "--level", "abc"])
run(cli, String["greet", "World", "--times", "abc"])
run(cli, String["greet", "World", "--bogus"])
run(cli, String["greet", "World", "-x"])
run(cli, String["commit", "--message"])
run(cli, String["push"])
run(cli, String["help", "push"])
