# find: Ruby's Find module (Find.find, Find.prune) and Pathname#find.
#
# The walk is Ruby's find.rb: depth first, each directory's children sorted, symbolic links not
# followed. Find.prune is an exception (FindPrune) that Find.find rescues, where Ruby throws :prune.
require "pathname"

class FindPrune < Exception
end

module Find
  module_function

  # Ruby checks every path before yielding any. With ignore_error (the default), a directory that
  # cannot be listed is skipped, as Ruby does.
  def find(*paths, ignore_error: true)
    list = Array.map(paths) do |x|
      s = Pathname.path_of(x)
      raise IOError, "No such file or directory - #{s}" unless File.exist?(s) || File.symlink?(s)
      s
    end
    found = String[]
    Array.each(list) do |path|
      ps = String[path]
      while (file = Array.shift(ps))
        pruned = false
        if block_given?
          begin
            yield file
          rescue FindPrune
            pruned = true
          end
        else
          Array.push(found, file)
        end
        next if pruned || !File.directory?(file) || File.symlink?(file)
        begin
          fs = Dir.children(file)
        rescue IOError
          raise unless ignore_error
          next
        end
        Array.each(Array.reverse(Array.sort(fs))) { |f| Array.unshift(ps, File.join(file, f)) }
      end
    end
    block_given? ? nil : found
  end

  def prune = raise FindPrune
end

class Pathname
  # Ruby's Pathname#find: Pathnames, "./" dropped when the path is ".".
  def find(pn, ignore_error: true)
    found = Pathname[]
    Find.find(@path, ignore_error:) do |f|
      x = Pathname.new(@path == "." ? String.delete_prefix(f, "./") : f)
      if block_given?
        yield x
      else
        Array.push(found, x)
      end
    end
    block_given? ? nil : found
  end
end
