# Business-day arithmetic for support tickets: working-day calendars with
# weekends and holidays, SLA due dates, and an overdue report.

WorkCalendar = Struct.new(:name, :weekend, :holidays)
Ticket = Struct.new(:id, :opened, :priority, :closed)

def days_from_civil(y, m, d)
  y -= 1 if m <= 2
  era = y / 400
  yoe = y - era * 400
  doy = (153 * ((m + 9) % 12) + 2) / 5 + d - 1
  era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468
end

def civil_from_days(z)
  z += 719468
  era = z / 146097
  doe = z - era * 146097
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  mp = (5 * doy + 2) / 153
  m = mp < 10 ? mp + 3 : mp - 9
  [yoe + era * 400 + (m <= 2 ? 1 : 0), m, doy - (153 * mp + 2) / 5 + 1]
end

def date(s)
  m = String.match(s, /(\d+)-(\d+)-(\d+)/)
  raise ArgumentError, "bad date #{s}" unless m
  days_from_civil(String.to_i(m[1]), String.to_i(m[2]), String.to_i(m[3]))
end

def show(z)
  y, m, d = civil_from_days(z)
  format("%04d-%02d-%02d", y, m, d)
end

def wday(z) = (z + 4) % 7

class WorkCalendar
  def open?(cal, z) = !Set.include?(@weekend, wday(z)) && !Set.include?(@holidays, z)

  # Moves n working days forward (or backward when n < 0).
  def add(cal, z, n)
    step = n < 0 ? -1 : 1
    left = Integer.abs(n)
    while left > 0
      z += step
      left -= 1 if open?(cal, z)
    end
    z
  end

  # Working days in the half-open range (from, to].
  def between(cal, from, to)
    return -between(cal, to, from) if to < from
    Range.count((from + 1)..to) { |z| open?(cal, z) }
  end

  def next_open(cal, z)
    z += 1 until open?(cal, z)
    z
  end
end

def sla_days(priority)
  case priority
  in :urgent then 1
  in :high then 3
  in :normal then 5
  in :low then 10
  end
end

holidays = Set[]
Array.each(Array["2026-10-12", "2026-11-11", "2026-11-26", "2026-11-27", "2026-12-25", "2027-01-01"]) do |s|
  Set.add(holidays, date(s))
end
us = WorkCalendar.new("US office", Set[0, 6], holidays)
gulf = WorkCalendar.new("Gulf office", Set[5, 6], Set[date("2026-12-02")])

puts("Adding working days from Fri 2026-10-09:")
start = date("2026-10-09")
Array.each(Array[1, 2, 5, 10, 30, -1, -5]) do |n|
  puts(format("  %+3d  US %s   Gulf %s", n, show(WorkCalendar.add(us, start, n)), show(WorkCalendar.add(gulf, start, n))))
end

ranges = Array[["2026-10-01", "2026-10-31"], ["2026-11-01", "2026-11-30"], ["2026-12-20", "2027-01-05"], ["2026-11-30", "2026-11-01"]]
Array.each(ranges) do |a, b|
  puts(format("Working days %s..%s: US %3d, Gulf %3d", a, b, WorkCalendar.between(us, date(a), date(b)), WorkCalendar.between(gulf, date(a), date(b))))
end

tickets = Ticket[
  Ticket.new(501, date("2026-11-20"), :high, date("2026-11-25")),
  Ticket.new(502, date("2026-11-24"), :urgent, date("2026-11-30")),
  Ticket.new(503, date("2026-11-25"), :normal, nil),
  Ticket.new(504, date("2026-12-18"), :low, date("2027-01-04")),
  Ticket.new(505, date("2026-12-23"), :high, nil),
  Ticket.new(506, date("2026-10-10"), :normal, date("2026-10-16")),
  Ticket.new(507, date("2026-12-28"), :urgent, nil)
]

today = date("2026-12-31")
puts
puts("Tickets (today #{show(today)}):")
late = Array[]
Array.each(tickets) do |t|
  opened = WorkCalendar.next_open(us, Ticket.get_opened(t))
  due = WorkCalendar.add(us, opened, sla_days(Ticket.get_priority(t)))
  closed = Ticket.get_closed(t)
  status =
    if closed
      closed <= due ? "met" : "missed by #{WorkCalendar.between(us, due, closed)}"
    elsif today > due
      "OVERDUE #{WorkCalendar.between(us, due, today)}"
    else
      "open, #{WorkCalendar.between(us, today, due)} left"
    end
  Array.push(late, t) if String.start_with?(status, "missed") || String.start_with?(status, "OVERDUE")
  puts(format("  #%d %-7s opened %s due %s  %s", Ticket.get_id(t), Symbol.to_s(Ticket.get_priority(t)), show(Ticket.get_opened(t)), show(due), status))
end
by_priority = Array.tally(Array.map(late) { |t| Ticket.get_priority(t) })
puts("Late by priority: #{Array.join(Array.map(Hash.to_a(by_priority)) { |pr, n| "#{pr}=#{n}" }, " ")}")
