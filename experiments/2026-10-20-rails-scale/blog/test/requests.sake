# The blog's requests without a server: Rails.application called as a Rack app (Rack::MockRequest's env)
require "../config/environment"

def get(path)
  env = Rack::MockRequest.env_for("http://localhost#{path}", method: "GET")
  status, headers, body = Rack::App.call(Rails.application, env)
  puts("GET #{path} -> #{status} #{headers["content-type"]}")
end
get("/up")
get("/")
