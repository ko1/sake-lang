# include copies a module's functions into the class; inside them, unqualified names resolve in the includer.
# Summary.total(x) dispatches to the total of x's type; module_function functions are called directly.
module Summary
  def total(c)
    sum = 0
    each(c) { |x| sum += x }
    sum
  end
  def average(c) = total(c) / count(c)
end

class Basket
  attr_reader items
  include Summary
  def each(b) = Array.each(@items) { |x| yield(x) }
  def count(b) = Array.size(@items)
end

class Countdown
  attr_reader n
  include Summary
  def each(c) = Integer.downto(@n, 1) { |i| yield(i) }
  def count(c) = @n
  def total(c) = 0 - @n                # an own definition wins over the included one
end

module Geometry
  module_function
  def double(x) = x * 2
end
module Shapes
  module_function
  include Geometry
  def quad(x) = double(double(x))
end

b = Basket.new(Array[3, 4, 5])
c = Countdown.new(4)
puts(Basket.total(b))
puts(Basket.average(b))
puts(Countdown.total(c))
puts(Countdown.average(c))
puts(Summary.total(b))                 # dispatches to Basket.total
puts(Summary.total(c))                 # dispatches to Countdown.total
puts(Shapes.quad(3))
puts(Geometry.double(5))
