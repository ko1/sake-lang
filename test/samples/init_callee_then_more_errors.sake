# A function initialize calls, called again later: the code after that call is checked (it was taken as unreachable).
class K
  attr_reader name
  attr_accessor size
  def initialize(k)
    @size = String.size(up(k))
  end
  def up(k) = String.upcase(@name)
end
p(K.up(K.new("abc")))
p(1 + "x")   # expected: a static error here
