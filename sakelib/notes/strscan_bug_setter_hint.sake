# `ss.pos = 1` gets the hint `Type.pos=(ss, ...)`, which is not valid syntax (Prism: "unexpected
# write target"), and no `pos=` can be defined to be called that way. A setter has to be named
# set_pos; the hint could say so (as it does for Struct fields: `Point.set_x(p, v)`).
class Scanner
  attr_accessor n
  def set_pos(s, v) = @n = v
end
ss = Scanner.new(0)
ss.pos = 1
