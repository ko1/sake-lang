# Port of actionview-8.1.3/lib/action_view/flows.rb (partial: no StreamingFlow: it waits on a Fiber)

require "../../activesupport/active_support/core_ext/string/output_safety"

module ActionView
  class OutputFlow
    attr_reader content

    # Ruby: Hash.new { |h, k| h[k] = ActiveSupport::SafeBuffer.new }
    def make = OutputFlow.new(Hash.new)

    def get(f, key) = @content[key] ||= ActiveSupport::SafeBuffer.make

    # Ruby: SafeBuffer.new(value.to_s) (the value is not escaped)
    def set(f, key, value) = @content[key] = ActiveSupport::SafeBuffer.make(Object.html_text(value))

    def append(f, key, value) = ActiveSupport::SafeBuffer.concat(get(f, key), value)
    def append!(f, key, value) = append(f, key, value)
  end
end
