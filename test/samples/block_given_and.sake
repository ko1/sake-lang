# `block_given?` joined with `&&` in an `elsif` condition does not prune the branch for a call without a block.
# Found writing HashExt.deep_merge (2026-10-09). Expected: runs and prints {a: 1, b: 2} then {a: 3}.
# Got (bin/sake --strict): `12:14: error: yield: no block is given on this call [type]`, reached by the
# block-less call at line 18. The same body with a nested `if block_given?` (as in active_support_core_ext.sake)
# is accepted; so is `block_given? ? yield(x) : x` (a ternary).
def merge_with(a, b)
  r = Hash.dup(a)
  Hash.each(b) do |k, v|
    if !Hash.key?(r, k)
      r[k] = v
    elsif Hash.key?(r, k) && block_given?
      r[k] = yield(k, r[k], v)
    else
      r[k] = v
    end
  end
  r
end
p merge_with(Hash[a: 1], Hash[b: 2])
p merge_with(Hash[a: 1], Hash[a: 2]) { |k, x, y| (x in Integer) && (y in Integer) ? x + y : y }
