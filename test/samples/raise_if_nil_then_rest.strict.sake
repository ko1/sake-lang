# After `raise if x == nil` with an x that is only nil, nothing more runs in that call: here the block, which
# reads the caller's nil `post`, and a nil argument's other returns (f() is a String, not nil | String).
class Post
  attr_reader title
end
def form_with(model)
  raise ArgumentError, "Passed nil to the :model argument" if model == nil
  yield
end
def form(post) = form_with(post) { Post.title(post) }
p(form(Post.new("a")))
begin
  form(nil)
rescue ArgumentError => e
  puts(Exception.message(e))
end
def f(length = nil)
  return "" if length == nil
  return nil if length > 3
  "abc"
end
p(f() + "x")
p(f(1))
