# sake: --strict
# Optional parameters, as in Ruby: trailing ones with a default, evaluated at the call; a default may use earlier parameters.
def greet(name, greeting = "Hello", punct = greeting == "Hello" ? "!" : ".") = "#{greeting}, #{name}#{punct}"
puts(greet("Sake"))
puts(greet("Sake", "Bye"))
puts(greet("Sake", "Hi", "?"))
def crc(s, start = 0) = start + String.size(s)
p(crc("abc"))
p(crc("abc", 10))
def scale(x, k = 2) = x * k
p([scale(3), scale(1.5), scale(2, 10)])            # each call is checked with the types it gives
