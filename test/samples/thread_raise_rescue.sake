# A block that Thread.new runs later reads a raise from its own block: Thread.value / Thread.join raise it.
t = Thread.new { raise "x" }
begin
  Thread.value(t)
rescue RuntimeError => e
  puts(Exception.message(e))
end
class Boom < StandardError
end
u = Thread.new { raise Boom, "y" }
begin
  Thread.join(u)
rescue Boom => e
  puts(Exception.message(e))
end
