# Port of activerecord-8.1.3/lib/active_record/internal_metadata.rb (partial: no schema_sha1 checks, no
# enabled? switch)
#
# ar_internal_metadata keeps the environment the schema was loaded in ("default_env" outside a Rails app).

module ActiveRecord
  class InternalMetadata
    attr_reader connection

    def table_name(i) = "ar_internal_metadata"
    def primary_key(i) = "key"
    def value_key(i) = "value"
    def arel_table(i) = Arel::Table.new(table_name(i))

    def value_of(i, key)
      entry = select_entry(i, key)
      entry ? entry[value_key(i)] : nil
    end

    def create_table_and_set_flags(i, environment, schema_sha1 = nil)
      create_table(i)
      update_or_create_entry(i, "environment", environment)
      update_or_create_entry(i, "schema_sha1", schema_sha1) if schema_sha1
      nil
    end

    def create_table(i)
      return nil if ConnectionAdapters::SQLite3Adapter.table_exists?(@connection, table_name(i))
      ConnectionAdapters::SQLite3Adapter.create_table(@connection, table_name(i), Hash.of(id: false)) do |t|
        ConnectionAdapters::TableDefinitionMethods.string(t, :key, Hash.of(primary_key: true, null: false))
        ConnectionAdapters::TableDefinitionMethods.string(t, :value)
        ConnectionAdapters::TableDefinitionMethods.timestamps(t)
      end
    end

    def drop_table(i) = ConnectionAdapters::SQLite3Adapter.drop_table(@connection, table_name(i), Hash.of(if_exists: true))

    def update_or_create_entry(i, key, value)
      entry = select_entry(i, key)
      if entry
        entry[value_key(i)] != value ? update_entry(i, key, value) : entry[value_key(i)]
      else
        create_entry(i, key, value)
      end
    end

    def current_time(i) = Time.utc(Time.now)

    def create_entry(i, key, value)
      t = arel_table(i)
      im = Arel::InsertManager.new(t)
      now = current_time(i)
      Arel::InsertManager.insert(im, Any[[t[primary_key(i)], key], [t[value_key(i)], value], [t[:created_at], now], [t[:updated_at], now]])
      ConnectionAdapters::SQLite3Adapter.insert(@connection, im, "ActiveRecord::InternalMetadata Create", primary_key(i), key)
    end

    def update_entry(i, key, new_value)
      t = arel_table(i)
      um = Arel::UpdateManager.new(t)
      Arel::UpdateManager.set(um, Any[[t[value_key(i)], new_value], [t[:updated_at], current_time(i)]])
      Arel::UpdateManager.set_wheres(um, Any[Arel::Attributes::Attribute.eq(t[primary_key(i)], key)])
      ConnectionAdapters::SQLite3Adapter.update(@connection, um, "ActiveRecord::InternalMetadata Update")
    end

    def select_entry(i, key)
      t = arel_table(i)
      sm = Arel::SelectManager.new(t)
      Arel::SelectManager.project(sm, Arel::Nodes::SqlLiteral.new("*"))
      Arel::SelectManager.where(sm, Arel::Attributes::Attribute.eq(t[primary_key(i)], Arel::Nodes::BindParam.new(key)))
      Arel::SelectManager.order(sm, Arel::Attributes::Attribute.asc(t[primary_key(i)]))
      Arel::SelectManager.take(sm, 1)
      Array.first(ActiveRecord::Result.to_a(ConnectionAdapters::SQLite3Adapter.select_all(@connection, sm, "ActiveRecord::InternalMetadata Load")))
    end

    def table_exists?(i) = ConnectionAdapters::SQLite3Adapter.data_source_exists?(@connection, table_name(i))
  end
end
