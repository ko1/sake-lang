# The routes of view_records (Rails' config/routes.rb), for the test and for its url helpers' generator
require "rails/actionpack/action_dispatch/routing"

class ActionDispatch::Routing::Mapper
  def view_records_routes(map)
    resources map, :articles do
      resources map, :comments, only: Any[:create, :destroy]
    end
  end
end

def view_records_route_set
  set = ActionDispatch::Routing::RouteSet.make
  ActionDispatch::Routing::RouteSet.draw(set) { |map| ActionDispatch::Routing::Mapper.view_records_routes(map) }
  set
end
