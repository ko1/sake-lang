# Port of activerecord-8.1.3/lib/arel/insert_manager.rb
#
# Ruby's insert(fields) takes a String or an Array of [attribute, value] pairs.

module Arel
  class InsertManager
    private attr_reader table
    attr_reader ast
    include Arel::TreeManager

    def initialize(m) = @ast = Nodes::InsertStatement.new(@table)

    def into(m, table)
      Nodes::InsertStatement.set_relation(@ast, table)
      m
    end

    def columns(m) = Nodes::InsertStatement.columns(@ast)
    def set_values(m, val) = Nodes::InsertStatement.set_values(@ast, val)
    def select(m, select) = Nodes::InsertStatement.set_select(@ast, select)

    def insert(m, fields)
      case fields
      in String
        return nil if String.empty?(fields)
        Nodes::InsertStatement.set_values(@ast, Nodes::SqlLiteral.new(fields))
      in Array
        return nil if Array.empty?(fields)
        unless Nodes::InsertStatement.relation(@ast)
          first = Array.first(fields)
          Nodes::InsertStatement.set_relation(@ast, Arel::Attributes::Attribute.relation(first[0])) if first
        end
        values = Any[]
        Array.each(fields) do |column, value|
          Array.push(Nodes::InsertStatement.columns(@ast), column)
          Array.push(values, value)
        end
        Nodes::InsertStatement.set_values(@ast, create_values(m, values))
      end
      m
    end

    def create_values(m, values) = Nodes::ValuesList.new(Array[values])
    def create_values_list(m, rows) = Nodes::ValuesList.new(rows)
  end
end
