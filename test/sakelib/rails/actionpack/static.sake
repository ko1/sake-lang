require "rails/actionpack/action_dispatch/middleware/static"

class Endpoint
  include ActionDispatch::App
  def call(e, req) = [200, Hash.of("content-type" => "text/plain"), String["app: #{ActionDispatch::Request.path_info(req)}"]]
end
app = ActionDispatch::RackApp.new(ActionDispatch::Static.new_static(Endpoint.new, "fixtures/public", headers: Hash.of("cache-control" => "public, max-age=60")))

def run(app, path, headers = Hash.new)
  status, h, body = Rack::App.call(app, Rack::MockRequest.env_for(path, headers: headers))
  p([path, status, Hash.except(h, "last-modified"), Hash.key?(h, "last-modified"), String.bytesize(Array.join(body))])
end

run(app, "/")
run(app, "/index.html")
run(app, "/about")
run(app, "/about.html")
run(app, "/docs")
run(app, "/docs/")
run(app, "/hello.txt")
run(app, "/style.css")
run(app, "/app.js")
run(app, "/app.js", Hash.of("HTTP_ACCEPT_ENCODING" => "gzip, deflate"))
run(app, "/missing")
run(app, "/../static.rb")
run(app, "/about", Hash.of("REQUEST_METHOD" => "POST"))
run(app, "/about", Hash.of("REQUEST_METHOD" => "HEAD"))
