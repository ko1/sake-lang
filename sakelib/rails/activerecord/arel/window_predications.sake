# Port of activerecord-8.1.3/lib/arel/window_predications.rb and filter_predications.rb (one file: two one-line mixins)

module Arel
  module WindowPredications
    def over(a, expr = nil) = Nodes::Over.new(a, expr)
  end

  module FilterPredications
    def filter(a, expr) = Nodes::Filter.new(a, expr)
  end
end
