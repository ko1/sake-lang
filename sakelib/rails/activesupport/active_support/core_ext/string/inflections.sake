# Port of activesupport-8.1.3/lib/active_support/core_ext/string/inflections.rb (partial: no constantize, safe_constantize, locale arguments)
#
# Ruby reopens String; a Sake library adds the operations to String the same way (`String.pluralize(s)`).

require "../../inflector/methods"
require "../../inflector/transliterate"

class String
  def pluralize(s, count = nil)
    count == 1 ? dup(s) : ActiveSupport::Inflector.pluralize(s)
  end

  def singularize(s) = ActiveSupport::Inflector.singularize(s)

  # Ruby: camelize(first_letter = :upper); :lower gives lowerCamelCase.
  def camelize(s, first_letter = :upper)
    case first_letter
    in :upper then ActiveSupport::Inflector.camelize(s, true)
    in :lower then ActiveSupport::Inflector.camelize(s, false)
    else raise ArgumentError, "Invalid option, use either :upper or :lower."
    end
  end

  def camelcase(s, first_letter = :upper) = String.camelize(s, first_letter)

  def titleize(s, keep_id_suffix: false) = ActiveSupport::Inflector.titleize(s, keep_id_suffix: keep_id_suffix)

  def titlecase(s, keep_id_suffix: false) = String.titleize(s, keep_id_suffix: keep_id_suffix)
  def underscore(s) = ActiveSupport::Inflector.underscore(s)
  def dasherize(s) = ActiveSupport::Inflector.dasherize(s)
  def demodulize(s) = ActiveSupport::Inflector.demodulize(s)
  def deconstantize(s) = ActiveSupport::Inflector.deconstantize(s)

  def parameterize(s, separator: "-", preserve_case: false)
    ActiveSupport::Inflector.parameterize(s, separator: separator, preserve_case: preserve_case)
  end

  def tableize(s) = ActiveSupport::Inflector.tableize(s)
  def classify(s) = ActiveSupport::Inflector.classify(s)

  def humanize(s, capitalize: true, keep_id_suffix: false)
    ActiveSupport::Inflector.humanize(s, capitalize: capitalize, keep_id_suffix: keep_id_suffix)
  end

  def upcase_first(s) = ActiveSupport::Inflector.upcase_first(s)
  def downcase_first(s) = ActiveSupport::Inflector.downcase_first(s)

  def foreign_key(s, separate_class_name_and_id_with_underscore = true)
    ActiveSupport::Inflector.foreign_key(s, separate_class_name_and_id_with_underscore)
  end
end
