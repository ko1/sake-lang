# Port of actionview-8.1.3/lib/action_view/renderer/renderer.rb (partial: no streaming, no render_partial_to_object choice at run time: a template's literal render call is sorted into partial/object/collection when it is compiled)

require "template_renderer"
require "partial_renderer"
require "collection_renderer"

module ActionView
  class Renderer
    attr_accessor lookup_context

    # Ruby: render(context, options): a template (and layout), or a partial without locals
    def render(r, context, template: nil, layout: nil, prefixes: nil, plain: nil, html: nil, body: nil, formats: nil, partial: nil)
      if partial
        return PartialRenderer.render(context, partial, Symbol[]) { |t, buf| Context._compiled(context, Template.method_name(t), buf) }
      end
      TemplateRenderer.render(context, @lookup_context, template: template, layout: layout, prefixes: prefixes, plain: plain, html: html, body: body, formats: formats)
    end
  end
end
