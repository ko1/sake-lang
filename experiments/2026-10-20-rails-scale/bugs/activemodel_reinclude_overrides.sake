# A module included again (through another module) pastes its functions again, over a later module's override.
# P2 includes AM (which includes AS and overrides AS's run), then V (which includes AS): Sake prints "AS" for P2;
# Ruby prints "AM" (AS is already among P2's ancestors, so including V does not move it above AM).
# Rails models include ActiveModel::Validations (with ActiveSupport::Callbacks) through several modules, so an
# override of an ActiveSupport::Callbacks function in an ActiveModel module would depend on include order;
# the ActiveModel port avoids overriding them (the generated class's own functions always win).
module AS
  def run(r) = "AS"
end
module V
  include AS
end
module AM
  include AS
  def run(r) = "AM"
end
class P1
  attr_accessor x
  include V
  include AM
end
class P2
  attr_accessor x
  include AM
  include V
end
p(P1.run(P1.new(1)), P2.run(P2.new(1)))
