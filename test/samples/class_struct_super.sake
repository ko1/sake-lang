# Ruby's `class C < Struct.new(:x, :y)`: the fields come first, then the body's attr_* lines and functions.
class Point < Struct.new(:x, :y)
  attr_reader label
  def initialize(p) = @label = "(#{@x}, #{@y})"
  def norm2(p) = @x * @x + @y * @y
end

pt = Point.new(3, 4)
Point.set_x(pt, 6)
p(pt)
puts(Point.label(pt), Point.norm2(pt))

class Point                       # a later class adds functions only
  def swap(p) = Point.new(@y, @x)
end
p(Point.swap(pt))
