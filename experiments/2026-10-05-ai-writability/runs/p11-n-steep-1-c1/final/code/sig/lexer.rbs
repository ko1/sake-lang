module Sql
  class Token
    attr_reader kind: Symbol
    attr_reader text: String

    def initialize: (Symbol kind, String text) -> void
    def keyword?: (String word) -> bool
    def op?: (String symbol) -> bool
  end

  class Lexer
    KEYWORDS: Hash[String, bool]
    TWO_CHAR_OPS: Array[String]
    ONE_CHAR_OPS: Array[String]

    @source: String
    @pos: Integer

    def initialize: (String source) -> void
    def statements: () -> Array[Array[Token]]

    private

    def char: (?Integer offset) -> String
    def digit?: (String c) -> bool
    def next_token: () -> Token?
    def skip_blank: () -> void
    def word: () -> Token
    def number: () -> Token
    def quoted: (String quote, Symbol kind) -> Token
    def operator: () -> Token
  end
end
