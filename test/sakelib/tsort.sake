require "tsort"

# 1. Ruby's doc example: Hash includes TSort
class Hash
  include TSort
  def tsort_each_node(h)
    Hash.each_key(h) { |n| yield(n) }
  end
  def tsort_each_child(h, node)
    Array.each(Hash.fetch(h, node)) { |c| yield(c) }
  end
end

p(Hash.tsort(Hash.of(1 => Any[2, 3], 2 => Any[3], 3 => Any[], 4 => Any[])))
p(TSort.tsort(Hash.of(1 => Any[2, 3], 2 => Any[3], 3 => Any[], 4 => Any[])))
p(Hash.strongly_connected_components(Hash.of(1 => Any[2], 2 => Any[3, 4], 3 => Any[2], 4 => Any[])))
g = Hash.of(1 => Any[2], 2 => Any[3, 4], 3 => Any[2], 4 => Any[])
Hash.each_strongly_connected_component(g) { |c| p(c) }
p(Hash.each_strongly_connected_component_from(g, 2) { |c| p(c) })
id_map = Hash.new
stack = Any[]
p(Hash.each_strongly_connected_component_from(g, 4, id_map, stack) { |c| p(c) })
p(Hash.each_strongly_connected_component_from(g, 1, id_map, stack) { |c| p(c) })
p([id_map, stack])
Hash.tsort_each(Hash.of(1 => Any[2, 3], 2 => Any[3], 3 => Any[], 4 => Any[])) { |n| puts("node #{n}") }
p(Hash.tsort(Hash.new))
begin
  Hash.tsort(Hash.of(1 => Any[2], 2 => Any[3, 4], 3 => Any[2], 4 => Any[]))
rescue TSort::Cyclic => e
  puts("Cyclic: #{Exception.message(e)}")
end
begin
  Hash.tsort(Hash.of(:a => Any[:a]))
rescue TSort::Cyclic => e
  puts("Cyclic: #{Exception.message(e)}")
end
p(Hash.strongly_connected_components(Hash.of(:a => Any[:a])))
begin
  Hash.tsort(Hash.of(1 => Any[9]))
rescue KeyError => e
  p(String.end_with?(Exception.message(e), "key not found: 9"))   # Sake prefixes "Hash.fetch: "
end

# 2. A type of your own includes TSort
class Build
  attr_reader names, deps
  include TSort
  def tsort_each_node(b)
    Array.each(@names) { |n| yield(n) }
  end

  def tsort_each_child(b, name)
    ds = @deps[name]
    Array.each(ds) { |d| yield(d) } if ds
    nil
  end
end

b = Build.new(String["app", "lib", "test", "util", "docs"],
              Hash.of("app" => String["lib", "util"], "lib" => String["util"], "test" => String["app", "lib"]))
p(Build.tsort(b))
p(TSort.strongly_connected_components(b))
puts(Array.join(Build.tsort(b), " -> "))

# 3. A Hash graph without including anything
p(TSort.tsort_hash(Hash.of("c" => Any["b"], "b" => Any["a"], "a" => Any[])))
p(TSort.tsort_hash(Hash.of("c" => Any["b"], "b" => Any["a"])))
p(TSort.strongly_connected_components_hash(Hash.of(1 => Any[2], 2 => Any[1, 3], 3 => Any[4], 4 => Any[3], 5 => Any[])))
TSort.tsort_each_hash(Hash.of([0, 0] => Any[[0, 1]], [0, 1] => Any[])) { |n| p(n) }
TSort.each_strongly_connected_component_hash(Hash.of(:x => Any[:y], :y => Any[:x])) { |c| p(c) }
begin
  TSort.tsort_hash(Hash.of("a" => Any["b"], "b" => Any["c"], "c" => Any["a"]))
rescue TSort::Cyclic => e
  puts("Cyclic: #{Exception.message(e)}")
end
p(TSort.tsort_hash(Hash.new))

# a long chain
h = Hash.new
Range.each(0...1000) { |i| h[i] = Any[i + 1] }
order = TSort.tsort_hash(h)
p([Array.size(order), Array.first(order), Array.last(order)])

# without a block: an Array (Ruby: an Enumerator, compared through to_a)
p(Hash.tsort_each(Hash.of(1 => Any[2, 3], 2 => Any[3], 3 => Any[])))
p(Build.each_strongly_connected_component(b))
p(TSort.tsort_each(b))
