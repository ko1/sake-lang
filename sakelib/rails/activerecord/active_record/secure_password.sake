# Port of activerecord-8.1.3/lib/active_record/secure_password.rb
#
# Ruby's ClassMethods#authenticate_by is a class-level function of the model (as Querying's); the
# `record.public_send(:"authenticate_#{name}", value)` is the generated `__authenticate_attribute` (generate/model.sake),
# and has_secure_password itself is ActiveModel's (its generator). `attributes.to_h`: the caller passes a Hash
# (`ActionController::Parameters.to_h(params)` for permitted params).

module ActiveRecord
  module SecurePassword
    def __authenticate_attribute(r, name, value) = raise(NotImplementedError)

    def authenticate_by(attributes)
      types = attribute_types
      passwords = Hash.new
      identifiers = Hash.new
      Hash.each(attributes) do |name, value|
        if !Hash.key?(types, Kernel.to_s(name)) && Hash.key?(types, "#{name}_digest")
          passwords[name] = value
        else
          identifiers[name] = value
        end
      end

      raise ArgumentError, "One or more password arguments are required" if Hash.empty?(passwords)
      raise ArgumentError, "One or more finder arguments are required" if Hash.empty?(identifiers)

      return nil if Hash.any?(passwords) { |name, value| value == nil || Kernel.to_s(value) == "" }

      record = find_by(identifiers)
      if record
        n = Hash.count(passwords) { |name, value| __authenticate_attribute(record, Kernel.to_s(name), Kernel.to_s(value)) != false }
        n == Hash.size(passwords) ? record : nil
      else
        build_with(passwords)
        nil
      end
    end
  end
end
