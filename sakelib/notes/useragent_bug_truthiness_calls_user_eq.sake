# FIXED 2026-10-11 (experiments/2026-10-11-libraries3/README.md); kept as the record of the bug.
# A truthiness test (`u ? 1 : 2`, `u && x`, `if u`) of an instance whose class defines `==` calls that `==`
# with false (Values.truthy? does `v == false`). Expected: 1, 3, false; got: "== called with false", TypeError.
class U
  attr_reader n
  include Comparable
  def ==(a, b)
    puts("== called with #{Kernel.inspect(b)}")
    U.n(a) == U.n(b)
  end
  def <=>(a, b) = @n <=> U.n(b)
end
u = Array.first(Array[U.new(1)])
p(u ? 1 : 2)
p(u && 3)
p(!u)
