# Borrowed functions are checked per includer, but an Array made inside one (`create`) is one
# allocation site for all includers: both IntBox.items and StrBox.items become Integer | String.
module BoxOps
  def create = new(Array[])
  def add(b, x) = Array.push(@items, x)
end
class IntBox < {reader: [items]}
  include BoxOps
end
class StrBox < {reader: [items]}
  include BoxOps
end
a = IntBox.create
IntBox.add(a, 1)
b = StrBox.create
StrBox.add(b, "x")
p(a); p(b)
