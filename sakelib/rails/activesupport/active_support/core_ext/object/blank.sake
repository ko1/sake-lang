# Port of activesupport-8.1.3/lib/active_support/core_ext/object/blank.rb (partial: no Object#blank? through respond_to?(:empty?))
#
# Ruby defines blank? in eleven classes; a value of any type goes through `Object.blank?(x)`, one `case` over
# them (Sake has no Object type to reopen, so `module Object` names the namespace). The typed forms are
# String.blank?(s), Array.blank?(xs), Hash.blank?(h), as Ruby's per-class methods.

module Object
  module_function

  def blank?(x)
    case x
    in nil | false then true
    in true then false
    in String then String.blank?(x)
    in Array then Array.empty?(x)
    in Hash then Hash.empty?(x)
    in Set then Set.empty?(x)
    in Symbol then Symbol.empty?(x)
    else false
    end
  end

  def present?(x) = !blank?(x)

  # Ruby: `self if present?`; the result is `x | nil`.
  def presence(x) = blank?(x) ? nil : x
end

class String
  # Ruby: BLANK_RE = /\A[[:space:]]*\z/ (with an empty? fast path)
  def blank?(s) = String.empty?(s) || String.match?(s, /\A[[:space:]]*\z/)
  def present?(s) = !String.blank?(s)
  def presence(s) = String.blank?(s) ? nil : s
end

class Array
  def blank?(xs) = Array.empty?(xs)
  def present?(xs) = !Array.empty?(xs)
  def presence(xs) = Array.empty?(xs) ? nil : xs
end

class Hash
  def blank?(h) = Hash.empty?(h)
  def present?(h) = !Hash.empty?(h)
  def presence(h) = Hash.empty?(h) ? nil : h
end

class Integer
  def blank?(n) = false
  def present?(n) = true
end

class Float
  def blank?(n) = false
  def present?(n) = true
end
