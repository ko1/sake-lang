# In-place quicksort (median-of-three pivot, insertion sort for small ranges),
# generic over a key given by a block. Used on a product catalog.

Product = Struct.new(:sku, :name, :price, :stock)

Stats = Struct.new(:compares, :swaps, :max_depth)

def swap(a, i, j, stats)
  t = a[i]
  a[i] = a[j]
  a[j] = t
  Stats.set_swaps(stats, Stats.swaps(stats) + 1)
end

def less(a, i, j, stats)
  Stats.set_compares(stats, Stats.compares(stats) + 1)
  yield(a[i]) < yield(a[j])
end

def insertion(a, lo, hi, stats)
  Integer.upto(lo + 1, hi) do |i|
    j = i
    while j > lo && less(a, j, j - 1, stats) { |x| yield(x) }
      swap(a, j, j - 1, stats)
      j -= 1
    end
  end
end

def median3(a, lo, hi, stats)
  mid = (lo + hi) / 2
  swap(a, mid, lo, stats) if less(a, mid, lo, stats) { |x| yield(x) }
  swap(a, hi, lo, stats) if less(a, hi, lo, stats) { |x| yield(x) }
  swap(a, hi, mid, stats) if less(a, hi, mid, stats) { |x| yield(x) }
  mid
end

def quicksort(a, lo, hi, depth, stats)
  Stats.set_max_depth(stats, depth) if depth > Stats.max_depth(stats)
  if hi - lo < 6
    insertion(a, lo, hi, stats) { |x| yield(x) }
    return a
  end
  mid = median3(a, lo, hi, stats) { |x| yield(x) }
  swap(a, mid, hi - 1, stats)
  pivot = hi - 1
  i = lo
  j = hi - 1
  while true
    i += 1
    i += 1 while less(a, i, pivot, stats) { |x| yield(x) }
    j -= 1
    j -= 1 while j > lo && less(a, pivot, j, stats) { |x| yield(x) }
    break if i >= j
    swap(a, i, j, stats)
  end
  swap(a, i, hi - 1, stats)
  quicksort(a, lo, i - 1, depth + 1, stats) { |x| yield(x) }
  quicksort(a, i + 1, hi, depth + 1, stats) { |x| yield(x) }
  a
end

def sort_by_key(items)
  a = Array.dup(items)
  stats = Stats.new(0, 0, 0)
  quicksort(a, 0, Array.size(a) - 1, 1, stats) { |x| yield(x) }
  [a, stats]
end

def sorted?(a)
  Array.each_cons(a, 2) { |pair| return false if yield(pair[0]) > yield(pair[1]) }
  true
end

def report(label, stats)
  puts(format("%-10s compares=%d swaps=%d depth=%d", label,
              Stats.compares(stats), Stats.swaps(stats), Stats.max_depth(stats)))
end

catalog = Array[
  Product.new("A100", "kettle", 34.5, 12), Product.new("A101", "toaster", 29.99, 3),
  Product.new("B200", "blender", 89.0, 7), Product.new("B201", "mixer", 149.5, 0),
  Product.new("C300", "mug", 6.25, 120), Product.new("C301", "teapot", 22.0, 15),
  Product.new("D400", "scale", 18.75, 40), Product.new("D401", "grinder", 54.0, 9),
  Product.new("E500", "whisk", 4.5, 65), Product.new("E501", "ladle", 7.8, 33),
  Product.new("F600", "wok", 41.0, 5), Product.new("F601", "pan", 38.0, 21),
  Product.new("G700", "knife", 64.9, 18), Product.new("G701", "board", 15.0, 26)
]

by_price, st = sort_by_key(catalog) { |pr| Product.price(pr) }
report("price", st)
Array.each(by_price) { |pr| puts(format("  %-5s %-8s %7.2f", Product.sku(pr), Product.name(pr), Product.price(pr))) }

by_name, st = sort_by_key(catalog) { |pr| Product.name(pr) }
report("name", st)
puts("  " + Array.join(Array.map(by_name) { |pr| Product.name(pr) }, ", "))

by_stock, st = sort_by_key(catalog) { |pr| Product.stock(pr) }
report("stock", st)
puts("  out of stock first: #{Product.name(by_stock[0])}; most stocked: #{Product.name(Array.last(by_stock))}")

nums = Array[]
x = 7
Integer.times(200) do
  x = (x * 1103 + 12345) % 1000
  Array.push(nums, x)
end
sorted_nums, st = sort_by_key(nums) { |n| n }
report("ints", st)
puts("  first=#{Array.take(sorted_nums, 6)} last=#{sorted_nums[-1]} ok=#{sorted?(sorted_nums) { |n| n }}")

already, st = sort_by_key(sorted_nums) { |n| n }
report("presorted", st)
desc, st = sort_by_key(sorted_nums) { |n| 0 - n }
report("reversed", st)
puts("  top3=#{Array.take(desc, 3)} ok=#{sorted?(desc) { |n| 0 - n }}")
