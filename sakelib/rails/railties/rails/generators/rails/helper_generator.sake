# Port of railties-8.1.3/lib/rails/generators/rails/helper/helper_generator.rb and templates/helper.rb.tt (a Sake module: app/helpers/*.sake are included in the app's view class)

require "../named_base"

module Rails
  module Generators
    module HelperGenerator
      module_function

      def run(g, name)
        file = String.sub(ActiveSupport::Inflector.underscore(name), /_helper\z/i, "")
        Base.create_file(g, "app/helpers/#{file}_helper.sake", "module #{ActiveSupport::Inflector.camelize(file)}Helper\nend\n")
        nil
      end
    end
  end
end
