# Runs one parsed statement; returns the lines it prints (only a query prints any).
module Executor
  module_function

  def execute(db, stmt)
    case stmt
    in CreateTable
      Ddl.create_table(db, stmt)
      Array[]
    in DropTable
      Ddl.drop_table(db, stmt)
      Array[]
    in Insert
      Dml.insert(db, stmt)
      Array[]
    in Update
      Dml.update(db, stmt)
      Array[]
    in Delete
      Dml.delete(db, stmt)
      Array[]
    in CreateView
      Views.create(db, stmt)
      Array[]
    in DropView
      Views.drop(db, stmt)
      Array[]
    in CreateIndex
      Indexes.create(db, stmt)
      Array[]
    in DropIndex
      Indexes.drop(db, stmt)
      Array[]
    in AlterAddColumn
      Alter.add_column(db, stmt)
      Array[]
    in AlterRenameTable
      Alter.rename_table(db, stmt)
      Array[]
    in AlterRenameColumn
      Alter.rename_column(db, stmt)
      Array[]
    in Transaction
      Transactions.run(db, stmt)
      Array[]
    in Select | Compound | WithQuery then Query.run(db, stmt)
    end
  end
end
