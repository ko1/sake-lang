# A function that checks block_given? may be called with or without a block; `&b` passes the
# function's block on to another call.
def info(msg = nil)
  msg = yield if block_given?
  puts("INFO #{msg}")
end
info("plain")
info { "from a block #{1 + 1}" }

def total(xs)
  return Array.sum(xs) unless block_given?
  Array.sum(Array.map(xs) { |x| yield x })
end
p(total(Any[1, 2, 3]))
p(total(Any[1, 2, 3]) { |x| x * 10 })

def each_twice(xs, &blk)
  Array.each(xs, &blk)
  Array.each(xs, &blk)
  nil
end
each_twice(Any[1, 2]) { |x| p(x) }

def mapped(xs, &) = Array.map(xs, &)
p(mapped(Any[1, 2]) { |x| x * 10 })

# break in a passed-on block ends the call the block was written for.
def scan(xs, &b) = Array.each(xs, &b)
p(scan(Any[1, 2, 3]) { |x| break x * 100 if x == 2 })
