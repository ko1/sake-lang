# Decimal expansions of fractions by long division: terminating vs. repeating,
# the repetend in parentheses, period lengths, and full-reptend (cyclic) primes.

def expand(num, den)
  int_part, rem = Integer.divmod(num, den)
  digits = ""
  seen = Hash[]
  pos = 0
  while rem != 0 && !Hash.key?(seen, rem)
    seen[rem] = pos
    rem *= 10
    d, rem = Integer.divmod(rem, den)
    digits += Integer.to_s(d)
    pos += 1
  end
  if rem == 0
    {int: int_part, prefix: digits, cycle: ""}
  else
    start = seen[rem]
    {int: int_part, prefix: digits[0...start], cycle: digits[start..]}
  end
end

def format_expansion(e)
  e => {int:, prefix:, cycle:}
  return Integer.to_s(int) if String.empty?(prefix) && String.empty?(cycle)
  return "#{int}.#{prefix}" if String.empty?(cycle)
  "#{int}.#{prefix}(#{cycle})"
end

def multiplicative_order(base, n)
  return nil if Integer.gcd(base, n) != 1
  k = 1
  x = base % n
  while x != 1
    x = x * base % n
    k += 1
  end
  k
end

def strip_2_5(n)
  n /= 2 while n % 2 == 0
  n /= 5 while n % 5 == 0
  n
end

def period(den)
  core = strip_2_5(den)
  core == 1 ? 0 : multiplicative_order(10, core)
end

puts("expansions:")
Array.each(Array[[1, 3], [1, 7], [22, 7], [1, 12], [3, 8], [5, 6], [1, 81], [7, 1], [1, 97]]) do |n, d|
  shown = format_expansion(expand(n, d))
  shown = shown[0...40] + "..." if String.length(shown) > 40
  puts(format("  %3d/%-3d = %s", n, d, shown))
end

puts("period of 1/d, checked against long division:")
mismatches = Range.count(2..300) do |d|
  expand(1, d) => {cycle:}
  String.length(cycle) != period(d)
end
puts("  mismatches for d in 2..300: #{mismatches}")

lens = Range.map(2..40) { |d| period(d) }
puts("  periods for d = 2..40: #{Array.join(lens, " ")}")

longest = Range.max_by(2..1000) { |d| period(d) }
puts("  longest period below 1000: 1/#{longest} with #{period(longest)} digits")

primes = Range.select(3..500) { |p| p != 5 && Range.none?(2..Integer.sqrt(p)) { |q| p % q == 0 } }
full = Array.select(primes) { |p| period(p) == p - 1 }
puts("full reptend primes < 500: #{Array.join(full, " ")}")
puts("share among primes != 2, 5: #{Array.size(full)}/#{Array.size(primes)}")

expand(1, 7) => {cycle:}
puts("cyclic number #{cycle}:")
Range.each(1..6) do |k|
  prod = String.to_i(cycle) * k
  puts("  #{cycle} x #{k} = #{String.rjust(Integer.to_s(prod), 6, "0")}")
end

puts("midy's theorem (halves of the repetend sum to 9...9):")
Array.each(Integer[7, 13, 17, 19]) do |p|
  expand(1, p) => {cycle:}
  half = String.length(cycle) / 2
  a = String.to_i(cycle[0...half])
  b = String.to_i(cycle[half..])
  puts("  1/#{p}: #{cycle[0...half]} + #{cycle[half..]} = #{a + b}")
end
