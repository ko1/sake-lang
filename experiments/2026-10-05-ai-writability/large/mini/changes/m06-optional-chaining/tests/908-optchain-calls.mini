fn make()
  return {"double": fn(x) return x * 2 end, "next": nil}
end
let obj = make()
print(obj?.double(21))
print(make()?.double(4))
print(obj?.next?.double(1))
print(obj?.double)
try obj?.missing(1) catch e print(e.kind, e.message, e.col) end
try obj?.next(1) catch e print(e.kind, e.message, e.col) end
try obj?.double(1, 2) catch e print(e.kind, e.message, e.col) end
