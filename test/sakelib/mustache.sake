require "mustache"

def show(label, s)
  puts("#{label}: #{Kernel.inspect(s)}")
end

def try(t, view = Hash[])
  show(Kernel.inspect(t), Mustache.render(t, view))
rescue Mustache::Parser::SyntaxError => e
  puts("Mustache::Parser::SyntaxError: #{Exception.message(e)}")
end

puts("== variables")
show("hello", Mustache.render("Hello {{planet}}!", Hash["planet" => "World"]))
show("symbol keys", Mustache.render("{{a}} and {{ b }}", Hash[a: 1, b: 2.5]))
show("escape", Mustache.render("{{x}} {{{x}}} {{& x}}", Hash["x" => "<a href=\"q\">&'</a>"]))
show("missing", Mustache.render("[{{nope}}][{{{nope}}}]"))
show("nil false", Mustache.render("[{{n}}][{{f}}]", Hash["n" => nil, "f" => false]))
show("dotted", Mustache.render("{{person.name.first}} / {{person.age}} / {{person.none.x}}",
                               Hash["person" => Hash["name" => Hash["first" => "Ann"], "age" => 30]]))
show("no view", Mustache.render("plain text"))
show("array value", Mustache.render("{{list}}", Hash["list" => Array[1, 2]]))

puts("== sections")
view = Hash[
  "name" => "Chris", "value" => 10000, "in_ca" => true, "taxed" => 6000.0,
  "repo" => Array[Hash["name" => "resque"], Hash["name" => "hub"], Hash["name" => "rip"]],
  "empty" => Array[], "person?" => Hash["name" => "Jon"], "nums" => Array[1, 2, 3],
]
tmpl = <<~T
  Hello {{name}}
  You have just won {{value}} dollars!
  {{#in_ca}}
  Well, {{taxed}} dollars, after taxes.
  {{/in_ca}}
  {{#repo}}
    <b>{{name}}</b>
  {{/repo}}
  {{^empty}}
  No repos :(
  {{/empty}}
  {{#person?}}Hi {{name}}!{{/person?}}
  {{#nums}}{{.}},{{/nums}}
  {{! a comment
      over lines }}
  done
T
print(Mustache.render(tmpl, view))
show("falsy section", Mustache.render("[{{#f}}x{{/f}}][{{#n}}x{{/n}}][{{#e}}x{{/e}}]", Hash["f" => false, "e" => Array[]]))
show("truthy scalar", Mustache.render("{{#s}}<{{.}}>{{/s}}", Hash["s" => "str"]))
show("inverted", Mustache.render("{{^f}}no{{/f}}{{^t}}yes{{/t}}{{^missing}}!{{/missing}}", Hash["f" => false, "t" => true]))
show("outer scope", Mustache.render("{{#a}}{{b}}{{c}}{{/a}}", Hash["a" => Hash["b" => 1], "c" => 2]))
show("nested", Mustache.render("{{#rows}}{{#cells}}{{.}}{{/cells}};{{/rows}}",
                               Hash["rows" => Array[Hash["cells" => Array[1, 2]], Hash["cells" => Array[3]]]]))
show("dotted section", Mustache.render("{{#a.b}}{{c}}{{/a.b}}", Hash["a" => Hash["b" => Hash["c" => "deep"]]]))

puts("== standalone")
show("lines", Mustache.render("| a\n  {{#s}}\n  x\n  {{/s}}\n| b\n", Hash["s" => true]))
show("indented inline", Mustache.render(" {{#s}}x{{/s}}\n", Hash["s" => true]))
show("comment line", Mustache.render("a\n  {{! c }}  \nb"))
show("crlf", Mustache.render("a\r\n{{#s}}\r\nx\r\n{{/s}}\r\n", Hash["s" => true]))
show("at end", Mustache.render("a\n{{#s}}\n{{/s}}", Hash["s" => true]))

puts("== partials")
partials = Hash["user" => "<{{name}}>", "list" => "{{#items}}\n- {{> user}}\n{{/items}}", "rec" => "{{#kids}}({{n}}{{> rec}}){{/kids}}"]
show("partial", Mustache.render("Users: {{> user}}", Hash["name" => "ann"], partials:))
show("in section", Mustache.render("{{> list}}", Hash["items" => Array[Hash["name" => "a"], Hash["name" => "b"]]], partials:))
show("indented", Mustache.render("x\n  {{> list}}\ny", Hash["items" => Array[Hash["name" => "a"]]], partials:))
show("recursive", Mustache.render("{{> rec}}", Hash["kids" => Array[Hash["n" => 1, "kids" => Array[Hash["n" => 2, "kids" => false]]], Hash["n" => 3, "kids" => false]]], partials:))
show("missing partial", Mustache.render("[{{> nope}}]", Hash[], partials:))
show("symbol partials", Mustache.render("{{>p}}", Hash["v" => 1], partials: Hash[p: "v={{v}}"]))

puts("== errors")
try("{{#a}}x")
try("x{{/a}}")
try("{{#a}}{{/b}}")
try("{{#a}}{{#b}}{{/a}}{{/b}}")
try("{{name")
try("{{{name}}", Hash["name" => 1])
