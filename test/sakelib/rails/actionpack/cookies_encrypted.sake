require "rails/actionpack/action_dispatch/middleware/cookies_encrypted"
require "cgi"

# Encrypted cookies (aes-256-gcm, and aes-256-cbc with an HMAC when authenticated encryption is off): written and
# read back, a tampered one, and cookies Rails wrote with the same secrets (so the format is Rails').
Jar = ActionDispatch::Cookies::CookieJar

def configure(req, authenticated)
  c = ActionDispatch::Request.env_config(req)
  c["action_dispatch.key_generator"] = ActiveSupport::CachingKeyGenerator.new(ActiveSupport::KeyGenerator.new("b" * 64, iterations: 2))
  c["action_dispatch.secret_key_base"] = "b" * 64
  c["action_dispatch.authenticated_encrypted_cookie_salt"] = "authenticated encrypted cookie"
  c["action_dispatch.encrypted_cookie_salt"] = "encrypted cookie"
  c["action_dispatch.encrypted_signed_cookie_salt"] = "signed encrypted cookie"
  c["action_dispatch.use_authenticated_cookie_encryption"] = authenticated
  c["action_dispatch.cookies_serializer"] = :json
  c["action_dispatch.use_cookies_with_metadata"] = true
end

# Written by Rails 8.1.3 with these secrets: encrypted[:fixed] = {value: {"made_by" => "rails", "n" => [1, 2]}} (gcm)
# and encrypted[:fixed_cbc] = "cbc from rails" (cbc)
def fixed = "fixed=5fQiPY7bViJ%2BnxG8IHKR%2FX7%2BRQI%2Bv3aKgYtLmce4Yzf2raF3eVy3bFEoZJM%2FfnDVkE0MRQIUZxdCyU5dtm4MIBq3IxW0%2Bk%2B4pNDfVjTMyFr8Fz%2B%2BU%2BQM%2FdHfR2GnhksCrA%3D%3D--eWKlbONAle%2B%2BNDVX--unXocTznbuawxOSRilYRQQ%3D%3D"
def fixed_cbc = "fixed_cbc=UGhXNkxKMCtqZWR3R1pqYzhyejkwbG1XOHRIRXZ4QlZKRUNGT1o0NEUrN2g5aEVCQ2dKLzMvY3lwUUUyWVp4OVJRVHorTG95T0RkSTVIakhSaENpSWFxbHlWT2FpeE82NGg1TXQ1SUk5a0dla0F4WnFQNW9JRzJPNnM2VkZJNXMtLWFQWWRKMW1PMllpakNDR1ZKNnhkN0E9PQ%3D%3D--7245568aba72b82e9a27fa7fabf481731f8d3053"

class Endpoint
  attr_reader authenticated
  include ActionDispatch::App
  def call(e, req)
    configure(req, @authenticated)
    jar = ActionDispatch::Request.cookie_jar(req)
    case ActionDispatch::Request.path_info(req)
    in "/write"
      Jar.encrypted(jar)[:user] = "ko1"
      Jar.encrypted(jar)[:cart] = Hash.of(value: Any[1, Hash.of("id" => 2)], httponly: true)
      ActionDispatch::Cookies::PermanentCookieJar.encrypted(Jar.permanent(jar))[:remember] = 42
    in "/read"
      en = Jar.encrypted(jar)
      p([en[:user], en[:cart], en[:remember], jar[:user] != nil, en[:forged], en[:missing], en[:fixed], en[:fixed_cbc]])
      p(en[:renamed])
    else
    end
    [200, Hash.of("content-type" => "text/plain"), String["ok"]]
  end
end

# The parts of an encrypted value: the ciphertext, the iv and the auth tag (gcm), or base64 data and an HMAC (cbc)
def shape(c)
  name, rest = String.split(c, "=", 2).Array.values_at(0, 1)
  r = Kernel.to_s(rest)
  value = String.split(r, ";", 2)[0] || ""
  parts = String.split(CGI.unescape(value), "--")
  "#{name}=<#{Array.join(Array.map(parts) { |x| String.size(x) }, ", ")}>#{String.sub(String.sub(r, /\A[^;]*/, ""), /expires=[^;]*/, "expires=<20 years>")}"
end

Array.each(Any[true, false]) do |authenticated|
  puts(authenticated ? "-- aes-256-gcm" : "-- aes-256-cbc")
  app = ActionDispatch::RackApp.new(ActionDispatch::Cookies.new(Endpoint.new(authenticated)))
  env = Rack::MockRequest.env_for("http://www.example.com/write")
  _, headers, _ = Rack::App.call(app, env)
  sc = headers["set-cookie"]
  sc => Array
  set = Array.map(sc) { |c| Kernel.to_s(c) }
  Array.each(set) { |c| puts(shape(c)) }
  values = Array.map(set) { |c| String.[](c, /\A[^;]*/) || "" }
  user = String.split(values[0] || "", "=", 2)[1] || ""
  forged = String.sub(user, /\A./) { |d| d == "A" ? "B" : "A" }
  cookie = Array.join(values + String["forged=#{forged}", "renamed=#{user}", fixed, fixed_cbc], "; ")
  env = Rack::MockRequest.env_for("http://www.example.com/read", headers: Hash.of("HTTP_COOKIE" => cookie))
  Rack::App.call(app, env)
end
