def header_ok(f)
  return false if Array.size(f) < 2 || Array.size(f) > 5
  return false unless String.match?(f[0], /\A\d+\z/)
  st = String.to_i(f[0])
  return false if st < 2 || st > 1001
  names = Array.drop(f, 1)
  return false unless Array.all?(names) { String.match?(it, /\A[a-z]{1,10}\z/) }
  Array.size(Array.uniq(names)) == Array.size(names)
end

def dart(tok)
  return [25, false] if tok == "25"
  return [50, true] if tok == "BULL"
  return [0, false] if tok == "MISS"
  m = String.match(tok, /\A([SDT])(1[0-9]|20|[1-9])\z/)
  return [-1, false] if m == nil
  n = String.to_i(m[2])
  k = m[1]
  return [n, false] if k == "S"
  return [n * 2, true] if k == "D"
  [n * 3, false]
end

lines = String.lines(IO.read(IO.stdin))
f0 = Array.empty?(lines) ? Array[] : String.split(lines[0], " ")
if !header_ok(f0)
  puts("invalid header")
else
  start0 = String.to_i(f0[0])
  names = Array.drop(f0, 1)
  left = Hash[]
  turns = Hash.new(0)
  thrown = Hash.new(0)
  Array.each(names) { |nm| left[nm] = start0 }
  winner = nil
  n = 1
  Array.each(Array.drop(lines, 1)) do |raw|
    n += 1
    f = String.split(raw, " ")
    next if Array.empty?(f)
    name = f[0]
    if winner != nil
      puts("line #{n}: game over")
      next
    end
    if !Hash.key?(left, name)
      puts("line #{n}: unknown player #{name}")
      next
    end
    toks = Array.drop(f, 1)
    if Array.size(toks) < 1 || Array.size(toks) > 3
      puts("line #{n}: expected 1 to 3 darts")
      next
    end
    bad = Array.find(toks) { dart(it)[0] < 0 }
    if bad != nil
      puts("line #{n}: bad dart #{bad}")
      next
    end
    beg = left[name]
    cur = beg
    total = 0
    cnt = 0
    state = 0
    last = ""
    Array.each(toks) do |tk|
      pts, dbl = dart(tk)
      cnt += 1
      total += pts
      cur -= pts
      last = tk
      if cur < 0 || cur == 1 || (cur == 0 && !dbl)
        state = 1
        break
      elsif cur == 0
        state = 2
        break
      end
    end
    turns[name] += 1
    thrown[name] += cnt
    if state == 1
      puts("#{name} busts, #{beg} left")
    elsif state == 2
      left[name] = 0
      winner = name
      puts("#{name} checks out with #{last}")
    else
      left[name] = cur
      puts("#{name} scores #{total}, #{cur} left")
    end
  end
  puts("STANDINGS")
  order = Array.sort_by(Array.each_with_index(names)) { |nm, i| [left[nm], i] }
  Array.each_with_index(order) do |(nm, i), rank|
    thr = thrown[nm]
    avg = thr == 0 ? "-" : format("%.2f", Integer.fdiv((start0 - left[nm]) * 3, thr))
    puts(format("%d. %-10s %4d %3d %6s", rank + 1, nm, left[nm], turns[nm], avg))
  end
  puts(winner == nil ? "no winner" : "winner: #{winner}")
end
