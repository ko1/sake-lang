# Matrix bench: ARGV = [n]; determinant, inverse, and square of an n x n Integer matrix; 0 is the baseline.
require "matrix"
n = String.to_i(Kernel.ARGV[0])
m = Matrix.build(n, n) { |i, j| (i * 7 + j * 13) % 17 + (i == j ? 20 : 0) }
p(Matrix.determinant(m))
inv = Matrix.inverse(m)
p(Matrix.trace(inv))
p(Matrix.trace(m * m))
