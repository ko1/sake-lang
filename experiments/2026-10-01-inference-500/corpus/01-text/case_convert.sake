Ident = Struct.new(:source, :style, :words)

def upper?(c) = c >= "A" && c <= "Z"
def lower?(c) = c >= "a" && c <= "z"
def digit?(c) = c >= "0" && c <= "9"

def detect_style(s)
  if String.include?(s, "_")
    String.upcase(s) == s ? :screaming : :snake
  elsif String.include?(s, "-")
    :kebab
  elsif String.include?(s, " ")
    :words
  elsif upper?(s[0])
    :pascal
  else
    :camel
  end
end

def split_words(s)
  words = Array[]
  current = ""
  chars = String.chars(s)
  Array.each_with_index(chars) do |c, i|
    if c == "_" || c == "-" || c == " "
      Array.push(words, current) unless String.empty?(current)
      current = ""
      next
    end
    prev = i > 0 ? chars[i - 1] : ""
    nxt = chars[i + 1]
    boundary = false
    if upper?(c) && String.empty?(current) == false
      boundary = true if lower?(prev) || digit?(prev)
      boundary = true if upper?(prev) && nxt != nil && lower?(nxt)
    end
    if digit?(c) && lower?(prev) && String.size(current) > 1
      boundary = true
    end
    if boundary
      Array.push(words, current)
      current = ""
    end
    current += c
  end
  Array.push(words, current) unless String.empty?(current)
  Array.map(words) { |w| String.downcase(w) }
end

def parse_ident(s) = Ident.new(s, detect_style(s), split_words(s))

def convert(words, style)
  case style
  in :snake then Array.join(words, "_")
  in :screaming then String.upcase(Array.join(words, "_"))
  in :kebab then Array.join(words, "-")
  in :camel
    first = Array.first(words)
    rest = Array.map(Array.drop(words, 1)) { |w| String.capitalize(w) }
    first + Array.join(rest, "")
  in :pascal then Array.join(Array.map(words) { |w| String.capitalize(w) }, "")
  in :words then Array.join(words, " ")
  in :title then Array.join(Array.map(words) { |w| small_word?(w) ? w : String.capitalize(w) }, " ")
  end
end

def small_word?(w) = Array.include?(Array["of", "the", "and", "to", "in", "a"], w)

def styles = Array[:snake, :screaming, :kebab, :camel, :pascal, :title]

def inputs
  Array[
    "parseHTTPResponse", "user_id", "MAX_RETRY_COUNT", "content-type",
    "XMLHttpRequest", "base64Encode", "the lord of the rings", "OAuth2Token",
    "already_snake_case", "iPhone"
  ]
end

idents = Array.map(inputs) { |s| parse_ident(s) }
width = Array.max(Array.map(inputs) { |s| String.size(s) })
Array.each(idents) do |id|
  label = String.ljust(Ident.get_source(id), width)
  puts("#{label}  #{Symbol.to_s(Ident.get_style(id))}: #{Array.join(Ident.get_words(id), " | ")}")
  Array.each(styles) do |st|
    out = convert(Ident.get_words(id), st)
    marker = st == Ident.get_style(id) && out == Ident.get_source(id) ? " (same)" : ""
    puts("    #{String.ljust(Symbol.to_s(st), 10)} #{out}#{marker}")
  end
end

by_style = Hash.new(0)
Array.each(idents) { |id| by_style[Ident.get_style(id)] += 1 }
puts("styles seen:")
Array.each(Hash.sort_by(by_style) { |k, v| Symbol.to_s(k) }) do |k, v|
  puts("  #{k}: #{v}")
end

round_trip = Array.count(idents) do |id|
  st = Ident.get_style(id)
  st != :words && convert(Ident.get_words(id), st) == Ident.get_source(id)
end
puts("round-trip exact: #{round_trip}/#{Array.size(idents)}")
