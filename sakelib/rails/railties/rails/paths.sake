# Port of railties-8.1.3/lib/rails/paths.rb (partial: no autoload_once/autoload flags, no filter_by, no Pathname results: paths are Strings)

module Rails
  module Paths
    class Path
      attr_reader root_path, current, paths, eager_load, load_path
      attr_accessor glob, exclude

      def absolute_current(p) = File.expand_path(@current, @root_path)
      def first(p) = Array.first(expanded(p))
      def last(p) = Array.last(expanded(p))
      def eager_load?(p) = @eager_load
      def load_path?(p) = @load_path
      def push(p, path) = Array.push(@paths, path)
      def unshift(p, *paths) = Array.unshift(@paths, *paths)
      def to_ary(p) = @paths

      def extensions(p)
        m = String.match(@glob || "", /\{([\S]+)\}/)
        m ? String.split(Kernel.to_s(m[1]), ",") : nil
      end

      def expanded(p)
        result = String[]
        Array.each(@paths) do |path|
          full = File.expand_path(path, @root_path)
          g = @glob
          if g && File.directory?(full)
            Array.concat(result, files_in(p, full, g))
          else
            Array.push(result, full)
          end
        end
        Array.uniq(result)
      end

      def existent(p) = Array.select(expanded(p)) { |f| File.exist?(f) }
      def existent_directories(p) = Array.select(expanded(p)) { |d| File.directory?(d) }
      def to_a(p) = expanded(p)

      def files_in(p, path, glob)
        files = Array.map(Dir.glob(glob, base: path)) { |f| Kernel.to_s(f) }
        files = Array.reject(files) { |f| Array.include?(@exclude || String[], f) }
        Array.sort(Array.map(files) { |file| File.join(path, file) })
      end
    end

    class Root
      attr_accessor path
      attr_reader root

      # Ruby: add(path, with: nil, glob: nil, eager_load: false, load_path: false, ...)
      def add(r, path, with: nil, glob: nil, exclude: nil, eager_load: false, load_path: false)
        withs = with ? String[with] : String[path]
        @root[path] = Path.new(@path, path, withs, eager_load, load_path, glob, exclude)
      end

      def [](r, path) = @root[path]
      def fetch(r, path) = @root[path] || raise(KeyError, "key not found: #{Kernel.inspect(path)}")
      def keys(r) = Hash.keys(@root)
      def values(r) = Hash.values(@root)
      def values_at(r, *list) = Array.compact(Array.map(list) { |k| @root[k] })
      def all_paths(r) = Array.uniq(values(r))
      def eager_load(r) = Array.uniq(Array.flat_map(Array.select(all_paths(r)) { |p| Path.eager_load?(p) }) { |p| Path.existent(p) })
      def load_paths(r) = Array.uniq(Array.flat_map(Array.select(all_paths(r)) { |p| Path.load_path?(p) }) { |p| Path.existent(p) })
    end
  end
end
