# An event emitter: handlers stored per event name, called with payloads of different types.
class Emitter
  attr_reader handlers
  def on(em, name, &blk)
    list = @handlers[name] || Array[]
    Array.push(list, blk)
    @handlers[name] = list
    em
  end

  def emit(em, name, payload)
    Array.each(@handlers[name] || Array[]) { |h| Proc.call(h, payload) }
    nil
  end
end

em = Emitter.new(Hash[])
ticks = 0
log = String[]
users = Array[]
Emitter.on(em, :tick) { |n| ticks = ticks + n }
Emitter.on(em, :msg) { |s| Array.push(log, String.upcase(s)) }
Emitter.on(em, :msg) { |s| Array.push(log, "len=#{String.size(s)}") }
Emitter.on(em, :user) do |u|
  u => {name:}
  Array.push(users, name)
end
Emitter.emit(em, :tick, 3)
Emitter.emit(em, :tick, 4)
Emitter.emit(em, :msg, "hello")
Emitter.emit(em, :user, {name: "ko1", age: 20})
p ticks
p log
p users
