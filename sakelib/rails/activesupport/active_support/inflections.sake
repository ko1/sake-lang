# Port of activesupport-8.1.3/lib/active_support/inflections.rb

require "inflector/inflections"

# Ruby runs this inside `module ActiveSupport`; a Sake statement is at the top level, so the names are full.
ActiveSupport::Inflector.inflections(:en) do |inflect|
  ActiveSupport::Inflector::Inflections.plural(inflect, /$/, "s")
  ActiveSupport::Inflector::Inflections.plural(inflect, /s$/i, "s")
  ActiveSupport::Inflector::Inflections.plural(inflect, /^(ax|test)is$/i, '\1es')
  ActiveSupport::Inflector::Inflections.plural(inflect, /(octop|vir)us$/i, '\1i')
  ActiveSupport::Inflector::Inflections.plural(inflect, /(octop|vir)i$/i, '\1i')
  ActiveSupport::Inflector::Inflections.plural(inflect, /(alias|status)$/i, '\1es')
  ActiveSupport::Inflector::Inflections.plural(inflect, /(bu)s$/i, '\1ses')
  ActiveSupport::Inflector::Inflections.plural(inflect, /(buffal|tomat)o$/i, '\1oes')
  ActiveSupport::Inflector::Inflections.plural(inflect, /([ti])um$/i, '\1a')
  ActiveSupport::Inflector::Inflections.plural(inflect, /([ti])a$/i, '\1a')
  ActiveSupport::Inflector::Inflections.plural(inflect, /sis$/i, "ses")
  ActiveSupport::Inflector::Inflections.plural(inflect, /(?:([^f])fe|([lr])f)$/i, '\1\2ves')
  ActiveSupport::Inflector::Inflections.plural(inflect, /(hive)$/i, '\1s')
  ActiveSupport::Inflector::Inflections.plural(inflect, /([^aeiouy]|qu)y$/i, '\1ies')
  ActiveSupport::Inflector::Inflections.plural(inflect, /(x|ch|ss|sh)$/i, '\1es')
  ActiveSupport::Inflector::Inflections.plural(inflect, /(matr|vert|ind)(?:ix|ex)$/i, '\1ices')
  ActiveSupport::Inflector::Inflections.plural(inflect, /^(m|l)ouse$/i, '\1ice')
  ActiveSupport::Inflector::Inflections.plural(inflect, /^(m|l)ice$/i, '\1ice')
  ActiveSupport::Inflector::Inflections.plural(inflect, /^(ox)$/i, '\1en')
  ActiveSupport::Inflector::Inflections.plural(inflect, /^(oxen)$/i, '\1')
  ActiveSupport::Inflector::Inflections.plural(inflect, /(quiz)$/i, '\1zes')

  ActiveSupport::Inflector::Inflections.singular(inflect, /s$/i, "")
  ActiveSupport::Inflector::Inflections.singular(inflect, /(ss)$/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(n)ews$/i, '\1ews')
  ActiveSupport::Inflector::Inflections.singular(inflect, /([ti])a$/i, '\1um')
  ActiveSupport::Inflector::Inflections.singular(inflect, /((a)naly|(b)a|(d)iagno|(p)arenthe|(p)rogno|(s)ynop|(t)he)(sis|ses)$/i, '\1sis')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(^analy)(sis|ses)$/i, '\1sis')
  ActiveSupport::Inflector::Inflections.singular(inflect, /([^f])ves$/i, '\1fe')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(hive)s$/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(tive)s$/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /([lr])ves$/i, '\1f')
  ActiveSupport::Inflector::Inflections.singular(inflect, /([^aeiouy]|qu)ies$/i, '\1y')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(s)eries$/i, '\1eries')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(m)ovies$/i, '\1ovie')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(x|ch|ss|sh)es$/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /^(m|l)ice$/i, '\1ouse')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(bus)(es)?$/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(o)es$/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(shoe)s$/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(cris|test)(is|es)$/i, '\1is')
  ActiveSupport::Inflector::Inflections.singular(inflect, /^(a)x[ie]s$/i, '\1xis')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(octop|vir)(us|i)$/i, '\1us')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(alias|status)(es)?$/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /^(ox)en/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(vert|ind)ices$/i, '\1ex')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(matr)ices$/i, '\1ix')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(quiz)zes$/i, '\1')
  ActiveSupport::Inflector::Inflections.singular(inflect, /(database)s$/i, '\1')

  ActiveSupport::Inflector::Inflections.irregular(inflect, "person", "people")
  ActiveSupport::Inflector::Inflections.irregular(inflect, "man", "men")
  ActiveSupport::Inflector::Inflections.irregular(inflect, "child", "children")
  ActiveSupport::Inflector::Inflections.irregular(inflect, "sex", "sexes")
  ActiveSupport::Inflector::Inflections.irregular(inflect, "move", "moves")
  ActiveSupport::Inflector::Inflections.irregular(inflect, "zombie", "zombies")

  ActiveSupport::Inflector::Inflections.uncountable(inflect, "equipment", "information", "rice", "money", "species", "series", "fish", "sheep", "jeans", "police")
end
