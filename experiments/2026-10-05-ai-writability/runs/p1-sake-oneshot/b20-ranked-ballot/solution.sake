def pct(votes, active)
  return "0.0%" if active == 0
  t = (votes * 2000 + active) / (2 * active)
  "#{t / 10}.#{t % 10}%"
end

def solve_main
  lines = IO.readlines(IO.stdin)
  cands = Array[]
  if !Array.empty?(lines)
    names = String.split(String.strip(String.chomp(lines[0])), /\s+/)
    cands = Array.uniq(names)
  end
  if Array.empty?(cands)
    puts("no candidates")
    return
  end
  ballots = Array[]
  rejected = 0
  k = 1
  while k < Array.size(lines)
    raw = String.chomp(lines[k])
    lineno = k + 1
    k += 1
    next if String.empty?(String.strip(raw))
    parts = String.split(raw + ">x", ">")
    Array.pop(parts)
    ranks = Array[]
    reason = nil
    Array.each(parts) do |pt|
      nm = String.strip(pt)
      if reason == nil
        if String.empty?(nm)
          reason = "empty rank"
        elsif !Array.include?(cands, nm)
          reason = "unknown candidate #{nm}"
        elsif Array.include?(ranks, nm)
          reason = "duplicate #{nm}"
        else
          Array.push(ranks, nm)
        end
      end
    end
    if reason
      puts("rejected line #{lineno}: #{reason}")
      rejected += 1
    else
      Array.push(ballots, ranks)
    end
  end
  total = Array.size(ballots)
  puts("ballots: #{total} valid, #{rejected} rejected")
  alive = Hash[]
  Array.each(cands) { |c| alive[c] = true }
  hist = Array[]
  round = 0
  while true
    round += 1
    counts = Hash[]
    Array.each(cands) { |c| counts[c] = 0 if alive[c] }
    active = 0
    Array.each(ballots) do |b|
      top = Array.find(b) { |c| alive[c] }
      if top
        counts[top] += 1
        active += 1
      end
    end
    Array.push(hist, counts)
    puts("round #{round}")
    conts = Array.select(cands) { alive[it] }
    shown = Array.sort_by(conts) { |c| [-counts[c], c] }
    Array.each(shown) { |c| puts("  #{c} #{counts[c]} #{pct(counts[c], active)}") }
    puts("  exhausted #{total - active}")
    if active == 0
      puts("no winner")
      break
    end
    win = Array.find(conts) { |c| counts[c] * 2 > active }
    if win
      puts("winner #{win}")
      break
    end
    mn = Array.min(Array.map(conts) { |c| counts[c] })
    tied = Array.select(conts) { |c| counts[c] == mn }
    r = round - 2
    while Array.size(tied) > 1 && r >= 0
      h = hist[r]
      m2 = Array.min(Array.map(tied) { |c| h[c] })
      tied = Array.select(tied) { |c| h[c] == m2 }
      r -= 1
    end
    victim = Array.max(tied)
    Hash.delete(alive, victim)
    puts("  eliminated #{victim}")
  end
end

solve_main
