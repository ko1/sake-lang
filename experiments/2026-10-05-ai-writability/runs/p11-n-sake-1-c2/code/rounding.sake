# round(x, n) (spec 2.4): round the 17-significant-digit decimal form of x, halves away from zero.
module Rounding
  module_function

  def round(x, n)
    return Arithmetic.to_f(x) if x == 0
    f = Arithmetic.to_f(x)
    sign = f < 0 ? "-" : ""
    # "d.dddddddddddddddde+XX": 17 digits and a decimal exponent.
    mantissa, exponent = String.split(format("%.16e", Float.abs(f)), "e")
    digits = String.delete(mantissa, ".")
    keep = String.to_i(exponent) + 1 + n  # digits before the cut
    return f if keep >= String.size(digits)
    return 0.0 if keep < 0
    head = keep == 0 ? 0 : String.to_i(String.slice(digits, 0, keep))
    head += 1 if String.to_i(String.slice(digits, keep, 1)) >= 5
    String.to_f("#{sign}#{head}e-#{n}")
  end
end
