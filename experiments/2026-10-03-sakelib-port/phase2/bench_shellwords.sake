require "shellwords"

# A command line of 2000 words in every quoting form; split it, then escape and join the words.
parts = String[]
Integer.times(500) { |i| Array.push(parts, "word#{i}", "'single #{i}'", "\"dq \\\"#{i}\\\"\"", "esc\\ #{i}") }
line = Array.join(parts, " ")
t0 = Time.now
words = Shellwords.split(line)
joined = Shellwords.join(words)
back = Shellwords.split(joined)
el = Time.to_f(Time.now) - Time.to_f(t0)
p [Array.size(words), String.size(joined), back == words]
warn "work #{Float.round(el * 1000)}ms"
