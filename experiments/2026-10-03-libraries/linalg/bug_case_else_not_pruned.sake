# `case b in A ... in B ... else ...`: when b is known to be B, the `else`
# branch is unreachable, yet its result type is still joined into the case's type.
class A
  attr_reader v
  include Arithmetic
  def *(a, b)
    case b
    in B then B.new(@v * B.w(b))
    else A.new(@v)
    end
  end
end
class B
  attr_reader w
end
x = A.new(2) * B.new(3)
p(B.w(x))
# $ bin/sake --strict bug_case_else_not_pruned.sake
# expected: 6.  got: error: B.w: argument 1 must be B, but can be A [type]
