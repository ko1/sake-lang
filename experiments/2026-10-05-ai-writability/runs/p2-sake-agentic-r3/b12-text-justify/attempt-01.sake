def words_of(line) = Array.reject(String.split(line, /[ \t]+/)) { |s| String.empty?(s) }

def pieces(word, w)
  out = Any[]
  rest = word
  while String.size(rest) > w
    Array.push(out, String.slice(rest, 0, w - 1) + "-")
    rest = String.slice(rest, w - 1, String.size(rest) - (w - 1))
  end
  Array.push(out, rest)
  out
end

def justify(ws, w)
  total = w - Array.sum(Array.map(ws) { |s| String.size(s) })
  gaps = Array.size(ws) - 1
  base = total / gaps
  rem = total % gaps
  out = ""
  Array.each_with_index(ws) do |s, i|
    out += s
    if i < gaps
      out += " " * (base + (i < rem ? 1 : 0))
    end
  end
  out
end

lines = IO.readlines(IO.stdin())
first = Array.first(lines)
ws = first == nil ? "" : String.strip(first)
if !String.match?(ws, /\A\d+\z/) || String.to_i(ws) < 2 || String.to_i(ws) > 80
  puts("invalid width")
  exit
end
w = String.to_i(ws)

paras = Any[]
cur = Any[]
nwords = 0
Array.each(Array.drop(lines, 1)) do |raw|
  ws2 = words_of(raw)
  if Array.empty?(ws2)
    unless Array.empty?(cur)
      Array.push(paras, cur)
      cur = Any[]
    end
  else
    nwords += Array.size(ws2)
    Array.each(ws2) { |x| Array.push(cur, x) }
  end
end
Array.push(paras, cur) unless Array.empty?(cur)

border = "+" + "-" * w + "+"
puts(border)
nlines = 0
Array.each_with_index(paras) do |para, pi|
  puts("|" + " " * w + "|") if pi > 0
  ps = Any[]
  Array.each(para) { |x| Array.each(pieces(x, w)) { |y| Array.push(ps, y) } }
  ls = Any[]
  curl = Any[]
  len = 0
  Array.each(ps) do |x|
    if Array.empty?(curl)
      Array.push(curl, x)
      len = String.size(x)
    elsif len + 1 + String.size(x) <= w
      Array.push(curl, x)
      len += 1 + String.size(x)
    else
      Array.push(ls, curl)
      curl = Any[x]
      len = String.size(x)
    end
  end
  Array.push(ls, curl)
  Array.each_with_index(ls) do |l, li|
    text = (li < Array.size(ls) - 1 && Array.size(l) > 1) ? justify(l, w) : Array.join(l, " ")
    puts("|" + String.ljust(text, w) + "|")
    nlines += 1
  end
end
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{nwords}")
