# Port of activerecord-8.1.3/lib/arel/collectors/substitute_binds.rb
#
# Ruby: bind.value_for_database if bind.respond_to?(:value_for_database); an ActiveModel::Attribute here.

module Arel
  module Collectors
    class SubstituteBinds
      private attr_reader quoter, delegate
      attr_accessor preparable, retryable
      include Collector
      def initialize(c) = nil

      def <<(c, str)
        @delegate << str
        c
      end

      def add_bind(c, bind, &block)
        b = (bind in ActiveModel::Attribute) ? ActiveModel::Attribute.value_for_database(bind) : bind
        c << ActiveRecord::ConnectionAdapters::Quoting.quote(@quoter, b)
      end

      def add_binds(c, binds, proc_for_binds = nil, &block)
        c << Array.map(binds) { |bind| ActiveRecord::ConnectionAdapters::Quoting.quote(@quoter, bind) }.Array.join(", ")
      end

      def value(c) = Collector.value(@delegate)
    end
  end
end
