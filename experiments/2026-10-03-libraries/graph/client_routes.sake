# Route finding between city names: String nodes, Integer km weights.
roads = Graph.undirected_graph
Array.each(Array[
  ["Tokyo", "Yokohama", 30], ["Tokyo", "Saitama", 35], ["Yokohama", "Shizuoka", 140],
  ["Saitama", "Takasaki", 75], ["Takasaki", "Nagano", 120], ["Shizuoka", "Nagoya", 180],
  ["Nagano", "Nagoya", 250], ["Nagoya", "Kyoto", 135], ["Kyoto", "Osaka", 50],
  ["Takasaki", "Niigata", 190], ["Naha", "Itoman", 12]
]) { |a, b, km| Graph.add_edge(roads, a, b, km) }

puts("#{Graph.size(roads)} cities, #{Array.size(Graph.edges(roads))} roads")

def show_route(g, from, to)
  r = Graph.shortest_path(g, from, to)
  if r
    km, path = r
    puts(format("%-8s -> %-8s %4d km  %s", from, to, km, Array.join(path, " > ")))
  else
    puts(format("%-8s -> %-8s no route", from, to))
  end
end

show_route(roads, "Tokyo", "Osaka")
show_route(roads, "Niigata", "Kyoto")
show_route(roads, "Tokyo", "Naha")

hops = Graph.bfs_path(roads, "Tokyo", "Osaka")
puts("fewest hops Tokyo -> Osaka: #{Array.size(hops) - 1} (#{Array.join(hops, ", ")})") if hops

puts("within 2 hops of Tokyo:")
Graph.each_bfs(roads, "Tokyo") do |city, depth|
  break if depth > 2
  puts("  #{depth} #{city}")
end

Array.each(Graph.components(roads)) { |c| puts("island: #{Array.join(Array.sort(c), ", ")}") }
