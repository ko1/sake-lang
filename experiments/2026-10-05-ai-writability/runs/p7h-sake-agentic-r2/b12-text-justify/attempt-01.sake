width_str = Kernel.gets
if width_str
  width_str = String.chomp(width_str)
  width_str = String.strip(width_str)

  if String.match?(width_str, /\A\d+\z/)
    w = Kernel.Integer(width_str)
    if w >= 2 && w <= 80
      puts("+#{String.*(("-"), w)}+")

      text_lines = Array[]
      while line = Kernel.gets
        Array.push(text_lines, String.chomp(line))
      end

      puts("|#{String.*((" "), w)}|")
      puts("+#{String.*(("-"), w)}+")
      puts("paragraphs: 0, lines: 0, words: 0")
    else
      puts("invalid width")
    end
  else
    puts("invalid width")
  end
else
  puts("invalid width")
end
