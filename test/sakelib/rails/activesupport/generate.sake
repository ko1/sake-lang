# The Sake source the class-body generators write for the declaration files of the other tests (no Ruby
# twin: Ruby runs those class bodies instead). bin/sake --dump=generated shows the same per program.

require "rails/activesupport/active_support/generate/class_body"
require "rails/activesupport/active_support/generate/callbacks"
require "rails/activesupport/active_support/generate/class_attribute"
require "rails/activesupport/active_support/generate/rescuable"
require "rails/activesupport/active_support/generate/current_attributes"

Array.each(String["callbacks_decl.rb", "class_attribute_decl.rb", "rescuable_decl.rb", "current_attributes_decl.rb"]) do |path|
  puts("==== #{path}")
  bodies = ActiveSupport::Generate.parse(File.read(path), path)
  Array.each(bodies) { |body| ActiveSupport::CurrentAttributes::Generate.expand(body) }
  Array.each(bodies) do |body|
    print(ActiveSupport::ClassAttribute::Generate.class_source(body, bodies, path))
    print(ActiveSupport::Callbacks::Generate.class_source(body, bodies, path))
    print(ActiveSupport::Rescuable::Generate.class_source(body, bodies, path))
    print(ActiveSupport::CurrentAttributes::Generate.class_source(body, path))
  end
end
puts("==== an error: a block in a class body")
begin
  ActiveSupport::Generate.value("-> { published? }", 3, "post.rb")
rescue ArgumentError => e
  puts(Exception.message(e))
end
