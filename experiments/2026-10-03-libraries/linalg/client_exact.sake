# Typical use: solve a linear system exactly with Rationals, check the answer, invert.
a = Mat.of(Array[Array[2, 1, -1], Array[-3, -1, 2], Array[-2, 1, 2]])
b = Vec.of(Array[8, -11, -3])
puts("A =")
puts(a)
puts("det A = #{la_fmt(Mat.det(a))}")
x = Mat.solve(a, b)
if x
  puts("x = #{x}")
  puts("A x == b: #{a * x == Vec.exact(b)}")
end

# A system whose answer is not integral: exact fractions, no rounding.
h = Mat.build(4, 4) { |i, j| Rational(1, i + j + 1) }   # Hilbert matrix
puts("Hilbert(4) =")
puts(h)
puts("det = #{la_fmt(Mat.det(h))}")
hi = Mat.inverse(h)
if hi
  puts("inverse =")
  puts(hi)
  puts("H * H^-1 == I: #{h * hi == Mat.exact(Mat.identity(4))}")
end

# Same Hilbert system in Floats: residual is not zero.
hf = Mat.to_float(h)
ones = Vec.of(Array[1.0, 1.0, 1.0, 1.0])
xf = Mat.solve(hf, ones)
xr = Mat.solve(h, Vec.of(Array[1, 1, 1, 1]))
if xf && xr
  puts("float solve: #{xf}")
  puts("exact solve: #{xr}")
  err = Vec.to_a(xf - xr)
  puts("max |float - exact| = #{Array.max(Array.map(err) { |e| la_abs(e) })}")
end

singular = Mat.of(Array[Array[1, 2], Array[2, 4]])
p(Mat.solve(singular, Vec.of(Array[1, 2])))
