# Kernel#throw and #catch, as ActiveSupport::Callbacks halts a chain with `throw :abort`.
def run_chain(steps)
  catch(:abort) do
    Array.each(steps) do |s|
      puts "  step #{s}"
      throw :abort if s == "halt"
    end
    true
  end
end
p run_chain(Any["a", "b"])
p run_chain(Any["a", "halt", "c"])

def search(rows, want)
  catch(:found) do
    Array.each_with_index(rows) do |row, i|
      Array.each_with_index(row) { |x, j| throw :found, [i, j] if x == want }
    end
    nil
  end
end
p search(Any[Any[1, 2], Any[3, 4]], 4)
p search(Any[Any[1, 2]], 9)

# Inner catches of other tags let a throw pass; ensure clauses run on the way out.
out = catch(:outer) do
  catch(:inner) do
    begin
      throw :outer, "left both"
    ensure
      puts "ensure ran"
    end
  end
  "not here"
end
p out
p catch(:t) { |tag| tag }

begin
  throw :nobody, 1
rescue UncaughtThrowError => e
  puts Exception.message(e)
end
begin
  catch(:x) { throw :y }
rescue ArgumentError => e
  puts "#{Kernel.class_name(e)}: #{Exception.message(e)}"
end
