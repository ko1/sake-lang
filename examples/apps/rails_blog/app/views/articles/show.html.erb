<% article = @article || raise(ArgumentError, "@article is not set") %>
<p style="color: green"><%= notice view %></p>

<%= render article %>

<div>
  <%= link_to view, "Edit this article", edit_article_path(view, article) %> |
  <%= link_to view, "Back to articles", articles_path(view) %>

  <%= button_to view, "Destroy this article", article, method: :delete %>
</div>

<h2>Comments</h2>
<%= render ActiveRecord::Relation.to_a(Article.comments(article)) %>

<h2>Add a comment:</h2>
<%= render "comments/form", article: article %>
