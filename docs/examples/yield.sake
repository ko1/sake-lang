def twice(x) = yield(yield(x))

def each_pair(a)
  Array.each(a) { |x| yield([x, x * x]) }   # yield a Tuple...
  a
end

def first_over(a, limit)
  Array.each(a) { |x| return x if x > limit }   # return leaves first_over
  0
end

puts(twice(3) { |x| x + 4 })
each_pair(Array[1, 2, 3]) { |x, sq| puts(String.+(Integer.to_s(x), String.+(" -> ", Integer.to_s(sq)))) }   # ...destructured here
puts(first_over(Array[1, 5, 10], 4))
odd_only = Array.map(Array[1, 2, 3, 4]) { |x| next 0 if Integer.even?(x); x }
p(odd_only)
