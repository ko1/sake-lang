# yaml: a useful subset of Ruby's YAML (Psych 5): YAML.load / YAML.safe_load / YAML.load_file / YAML.dump.
#
# Values are plain Sake values, as in Ruby: a mapping is a Hash, a sequence an Array, and a scalar a
# String, Integer, Float, true/false or nil, resolved as Psych does for YAML 1.1 (yes/no/on/off are
# booleans, 012 is octal, 0x1F hex, .inf/.nan floats; 1e3 stays a String).
# Loading: block mappings and sequences (also "- key: v" and "- - x"), flow [..] and {..} (over several
# lines too), plain, 'single' and "double" quoted scalars (\n \t \xNN \uNNNN ...), literal | and folded >
# block scalars with - / + chomping, comments, a leading "---" and a closing "...".
# Not supported: anchors and aliases (&a, *a), tags (!!str), complex keys (? ), several documents, sexagesimal
# and comma numbers, dates (they stay Strings, where Psych makes a Date or refuses one).
# Dumping follows Psych's choice of plain, 'single', "double" and | styles; long lines are not folded.
# Ruby's Psych::SyntaxError is YAMLSyntaxError; messages are this port's own.

class YAMLSyntaxError < Exception
end

class YAMLParser
  attr_reader lines, symbolize = false, final_newline = true
  private attr_accessor i = 0, fsrc = "", fpos = 0

  def initialize(yp)
    @lines => Array
  end

  def fail(yp, msg)
    raise YAMLSyntaxError, "#{msg} at line #{@i + 1}"
  end

  def indent_of(line) = String.size(line) - String.size(String.lstrip(line))
  def blank?(line)
    t = String.strip(line)
    t == "" || String.start_with?(t, "#")
  end

  def skip_blank(yp)
    while @i < Array.size(@lines)
      line = Array.fetch(@lines, @i)
      break unless blank?(line)
      @i += 1
    end
    yp
  end

  def eof?(yp) = @i >= Array.size(@lines)
  def cur(yp) = Array.fetch(@lines, @i)

  def seq_item?(text) = text == "-" || String.start_with?(text, "- ") || String.start_with?(text, "-\t")

  # The key part of a "key: value" line and the rest, or nil.
  def split_key(text)
    m = String.match(text, /\A("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[^\s#'"\[\]{},&*!|>%@`?-][^#]*?|-[^\s#][^#]*?|\?[^\s#][^#]*?)[ \t]*:(?:[ \t]+|\z)/)
    m ? [m[1] || "", MatchData.post_match(m)] : nil
  end

  def key(yp, k)
    v =
      if String.start_with?(k, "\"") || String.start_with?(k, "'")
        r = quoted(yp, k)
        r ? r[0] : k
      else
        YAML.resolve(k)
      end
    (@symbolize && (v in String)) ? String.to_sym(v) : v
  end

  def parse(yp)
    # directives and document markers
    while !eof?(yp) && String.start_with?(cur(yp), "%")
      @i += 1
    end
    skip_blank(yp)
    if !eof?(yp) && String.match?(cur(yp), /\A---(?:[ \t]|\z)/)
      @lines[@i] = String.lstrip(String.delete_prefix(cur(yp), "---"))
      @i += 1 if blank?(cur(yp))
    end
    stop = Array.find_index(@lines) { |l| String.match?(l, /\A(?:\.\.\.|---)(?:[ \t]|\z)/) }
    if stop && stop >= @i
      @lines = Array.first(@lines, stop)
      @final_newline = true
    end
    v = node(yp, 0)
    skip_blank(yp)
    fail(yp, "unexpected content #{Kernel.inspect(String.strip(cur(yp)))}") unless eof?(yp)
    v
  end

  # The value whose lines start here, indented at least min; nil when there is none.
  def node(yp, min)
    skip_blank(yp)
    return nil if eof?(yp)
    line = cur(yp)
    ind = indent_of(line)
    return nil if ind < min
    text = String.strip(line)
    return seq(yp, ind) if seq_item?(text)
    return map(yp, ind) if split_key(text)
    @i += 1
    inline(yp, text, ind - 1)
  end

  def seq(yp, ind)
    a = Array[]
    while true
      skip_blank(yp)
      break if eof?(yp)
      line = cur(yp)
      text = String.strip(line)
      break unless indent_of(line) == ind && seq_item?(text)
      rest = String.size(text) > 1 ? text[1, String.size(text) - 1] || "" : ""
      if blank?(rest)
        @i += 1
        Array.push(a, node(yp, ind + 1))
      else
        # the item's content takes the place of "-", so "- k: v" and "- - x" nest as in a block
        @lines[@i] = " " * (ind + 1) + rest
        Array.push(a, node(yp, ind + 1))
      end
    end
    a
  end

  def map(yp, ind)
    h = Hash[]
    while true
      skip_blank(yp)
      break if eof?(yp)
      line = cur(yp)
      break unless indent_of(line) == ind
      text = String.strip(line)
      kv = split_key(text)
      fail(yp, "expected a mapping key, got #{Kernel.inspect(text)}") unless kv
      k, rest = kv
      @i += 1
      h[key(yp, k)] =
        if blank?(rest)
          skip_blank(yp)
          if eof?(yp)
            nil
          elsif indent_of(cur(yp)) > ind
            node(yp, ind + 1)
          elsif indent_of(cur(yp)) == ind && seq_item?(String.strip(cur(yp)))
            seq(yp, ind)
          end
        elsif String.start_with?(rest, "|") || String.start_with?(rest, ">")
          block_scalar(yp, rest, ind)
        else
          inline(yp, rest, ind)
        end
    end
    h
  end

  # A value written after "key: " (or alone on its line); its line is already consumed.
  # Continuation lines are those indented more than ind.
  def inline(yp, text, ind)
    if String.start_with?(text, "!!str ")
      # the one tag read: the scalar stays a String
      v = inline(yp, String.lstrip(String.delete_prefix(text, "!!str ")), ind)
      return (v in String) ? v : String.strip(String.delete_prefix(text, "!!str "))
    end
    c = text[0]
    if c == "[" || c == "{"
      src = text
      until flow_closed?(src)
        fail(yp, "unterminated flow collection") if eof?(yp)
        src = src + "\n" + cur(yp)
        @i += 1
      end
      @fsrc = src
      @fpos = 0
      v = flow_value(yp)
      flow_skip(yp)
      fail(yp, "unexpected text after a flow collection") if @fpos < String.size(@fsrc)
      return v
    end
    if c == "|" || c == ">"
      return block_scalar(yp, text, ind)
    end
    if c == "\"" || c == "'"
      src = text
      r = quoted(yp, src)
      while r == nil
        fail(yp, "unterminated quoted scalar") if eof?(yp)
        src = src + "\n" + String.strip(cur(yp))
        @i += 1
        r = quoted(yp, src)
      end
      r => Tuple
      s, rest = r
      fail(yp, "unexpected text after a quoted scalar") unless blank?(rest)
      return s
    end
    s = plain(text)
    while true
      skip_blank(yp)
      break if eof?(yp) || indent_of(cur(yp)) <= ind
      s = s + " " + plain(String.strip(cur(yp)))
      @i += 1
    end
    fail(yp, "mapping values are not allowed here") if String.match?(s, /:(?:\s|\z)/)
    YAML.resolve(s)
  end

  # A plain scalar's text: up to a comment, without surrounding spaces.
  def plain(text)
    k = String.index(text, /(?:\A|[ \t])#/)
    String.strip(k ? text[0, k] || "" : text)
  end

  # Whether the brackets of a flow collection are closed (outside quotes and comments).
  def flow_closed?(src)
    depth = 0
    q = nil
    prev = " "
    comment = false
    String.each_char(src) do |ch|
      if comment
        comment = false if ch == "\n"
      elsif q
        q = nil if ch == q && prev != "\\"
      elsif ch == "\"" || ch == "'"
        q = ch
      elsif ch == "#" && (prev == " " || prev == "\n")
        comment = true
      elsif ch == "[" || ch == "{"
        depth += 1
      elsif ch == "]" || ch == "}"
        depth -= 1
      end
      prev = ch
    end
    depth <= 0
  end

  # A quoted scalar at the start of src: [value, rest of src], or nil when it is not closed.
  def quoted(yp, src)
    if String.start_with?(src, "'")
      m = String.match(src, /\A'((?:[^']|'')*)'/)
      return nil unless m
      return [fold(String.gsub(m[1] || "", "''", "'")), MatchData.post_match(m)]
    end
    m = String.match(src, /\A"((?:[^"\\]|\\.)*)"/m)
    return nil unless m
    [unescape(yp, fold(m[1] || "")), MatchData.post_match(m)]
  end

  # Line breaks inside a quoted scalar: one becomes a space, an empty line a newline.
  def fold(s) = String.gsub(s, /[ \t]*\n[ \t]*(\n*)/) { |m| String.count(m, "\n") > 1 ? "\n" * (String.count(m, "\n") - 1) : " " }

  def escapes = once do
    Hash["0" => "\0", "a" => "\a", "b" => "\b", "t" => "\t", "\t" => "\t", "n" => "\n", "v" => "\v",
         "f" => "\f", "r" => "\r", "e" => "\e", " " => " ", "\"" => "\"", "/" => "/", "\\" => "\\",
         "N" => "\u0085", "_" => "\u00a0", "L" => "\u2028", "P" => "\u2029"]
  end

  def unescape(yp, s)
    String.gsub(s, /\\(?:x(\h{2})|u(\h{4})|U(\h{8})|(.))/m) do |m|
      e = m[1] || ""
      if e == "x" || e == "u" || e == "U"
        format("%c", String.hex(m[2, String.size(m) - 2] || ""))
      else
        r = escapes[e]
        fail(yp, "invalid escape \\#{e}") unless r
        r
      end
    end
  end

  # A literal (|) or folded (>) block scalar: its lines are those indented more than ind.
  def block_scalar(yp, header, ind)
    hm = String.match(header, /\A([|>])([-+]?)([1-9]?)([-+]?)\s*(?:#.*)?\z/)
    fail(yp, "invalid block scalar header #{Kernel.inspect(header)}") unless hm
    style = hm[1]
    chomp = (hm[2] || "") + (hm[4] || "")
    body = String[]
    block_indent = nil
    explicit = hm[3] || ""
    block_indent = (ind < 0 ? 0 : ind) + Integer(explicit) if explicit != ""
    while !eof?(yp)
      line = cur(yp)
      if String.strip(line) == ""
        Array.push(body, "")
        @i += 1
        next
      end
      li = indent_of(line)
      break if li <= ind
      block_indent ||= li
      break if li < block_indent
      Array.push(body, line[block_indent, String.size(line)] || "")
      @i += 1
    end
    trailing = 0
    while Array.last(body) == ""
      Array.pop(body)
      trailing += 1
    end
    text = style == "|" ? Array.join(body, "\n") : fold_block(body)
    return "" if Array.empty?(body) && chomp != "+"
    # the last line has a line break unless it ends the source without one
    brk = (eof?(yp) && !@final_newline) ? "" : "\n"
    case chomp
    in "-" then text
    in "+" then text + "\n" * trailing + brk
    else trailing > 0 ? text + "\n" : text + brk
    end
  end

  # Folding of a > block: lines join with a space, empty lines give newlines, more-indented lines keep theirs.
  def fold_block(body)
    out = ""
    prev = nil
    blanks = 0
    Array.each(body) do |l|
      if l == ""
        blanks += 1
        next
      end
      if prev != nil
        more = String.start_with?(l, " ") || String.start_with?(l, "\t") || String.start_with?(prev, " ") || String.start_with?(prev, "\t")
        out += more ? "\n" * (blanks + 1) : (blanks == 0 ? " " : "\n" * blanks)
      end
      out += l
      prev = l
      blanks = 0
    end
    out
  end

  # ---- flow collections ----

  def flow_skip(yp)
    while @fpos < String.size(@fsrc)
      c = @fsrc[@fpos]
      if c == " " || c == "\t" || c == "\n" || c == "\r"
        @fpos += 1
      elsif c == "#"
        nl = String.index(@fsrc, "\n", @fpos)
        @fpos = nl || String.size(@fsrc)
      else
        break
      end
    end
    yp
  end

  def flow_value(yp)
    flow_skip(yp)
    c = @fsrc[@fpos]
    fail(yp, "unterminated flow collection") if c == nil
    if c == "["
      @fpos += 1
      a = Array[]
      while true
        flow_skip(yp)
        if @fsrc[@fpos] == "]"
          @fpos += 1
          break
        end
        item = flow_value(yp)
        flow_skip(yp)
        if @fsrc[@fpos] == ":"
          # [k: v] is a sequence of one single-pair mapping
          @fpos += 1
          flow_skip(yp)
          e = @fsrc[@fpos]
          v = (e == "," || e == "]") ? nil : flow_value(yp)
          item = Hash[((@symbolize && (item in String)) ? String.to_sym(item) : item) => v]
          flow_skip(yp)
        end
        Array.push(a, item)
        d = @fsrc[@fpos]
        if d == ","
          @fpos += 1
        elsif d == "]"
          @fpos += 1
          break
        else
          fail(yp, "did not find expected ',' or ']'")
        end
      end
      return a
    end
    if c == "{"
      @fpos += 1
      h = Hash[]
      while true
        flow_skip(yp)
        if @fsrc[@fpos] == "}"
          @fpos += 1
          break
        end
        k = flow_scalar(yp, true)
        flow_skip(yp)
        v = nil
        if @fsrc[@fpos] == ":"
          @fpos += 1
          flow_skip(yp)
          d = @fsrc[@fpos]
          v = flow_value(yp) unless d == "," || d == "}"
        end
        h[(@symbolize && (k in String)) ? String.to_sym(k) : k] = v
        flow_skip(yp)
        d = @fsrc[@fpos]
        if d == ","
          @fpos += 1
        elsif d == "}"
          @fpos += 1
          break
        else
          fail(yp, "did not find expected ',' or '}'")
        end
      end
      return h
    end
    flow_scalar(yp, false)
  end

  def flow_scalar(yp, is_key)
    c = @fsrc[@fpos]
    if c == "\"" || c == "'"
      r = quoted(yp, @fsrc[@fpos, String.size(@fsrc)] || "")
      fail(yp, "unterminated quoted scalar") unless r
      s, rest = r
      @fpos = String.size(@fsrc) - String.size(rest)
      return s
    end
    m = String.match(@fsrc, /\G(?:[^,\[\]{}:#\n]|:(?![\s,\[\]{}])|(?<=\S)#)*/, @fpos)
    text = m ? MatchData.to_s(m) : ""
    fail(yp, "unexpected character #{Kernel.inspect(c)}") if text == "" && !(c == ":" && is_key)
    @fpos += String.size(text)
    YAML.resolve(String.strip(text))
  end
end

module YAML
  module_function

  def load(s, symbolize_names: false)
    s => String
    src = String.gsub(s, "\r\n", "\n")
    lines = String.lines(src).Array.map { |l| String.chomp(l) }
    YAMLParser.parse(YAMLParser.new(lines, symbolize_names, String.end_with?(src, "\n")))
  end

  def safe_load(s, symbolize_names: false) = load(s, symbolize_names:)
  def load_file(path, symbolize_names: false) = load(File.read(path), symbolize_names:)

  def bools = once do
    Hash["true" => true, "True" => true, "TRUE" => true, "yes" => true, "Yes" => true, "YES" => true,
         "on" => true, "On" => true, "ON" => true, "false" => false, "False" => false, "FALSE" => false,
         "no" => false, "No" => false, "NO" => false, "off" => false, "Off" => false, "OFF" => false]
  end

  # A plain scalar's value, as Psych's ScalarScanner resolves it.
  def resolve(s)
    return nil if s == "" || s == "~" || s == "null" || s == "Null" || s == "NULL"
    if String.match?(s, /\A[-+]?[0-9][0-9_]*(?::[0-5]?[0-9]){1,2}\z/)
      # Psych's sexagesimal Integer, with its weights (1:20 is 1 * 3600 + 20 * 60; the sign is the first part's)
      n = 0
      String.split(String.delete(s, "_"), ":").Array.each_with_index { |d, e| n += String.to_i(d) * 60 ** Integer.abs(e - 2) }
      return n
    end
    return bools[s] if Hash.key?(bools, s)
    return Float.INFINITY if String.match?(s, /\A\+?\.(?:inf|Inf|INF)\z/)
    return -Float.INFINITY if String.match?(s, /\A-\.(?:inf|Inf|INF)\z/)
    return Float.NAN if String.match?(s, /\A\.(?:nan|NaN|NAN)\z/)
    if String.match?(s, /\A[-+]?0b[01][01_]*\z/) || String.match?(s, /\A[-+]?0x\h[\h_]*\z/) || String.match?(s, /\A[-+]?0[0-7_]+\z/)
      neg = String.start_with?(s, "-")
      n = String.oct(String.delete(String.delete_prefix(String.delete_prefix(s, "-"), "+"), "_"))
      return neg ? -n : n
    end
    return String.to_i(String.delete(s, "_")) if String.match?(s, /\A[-+]?(?:0|[1-9][0-9_]*)\z/) && !String.include?(s, "__")
    if String.match?(s, /\A[-+]?(?:\d[\d_]*)?\.\d*(?:[eE][-+]\d+)?\z/) && String.match?(s, /\d/)
      t = String.delete(s, "_")
      t = String.sub(t, /\.(?=[eE]|\z)/, ".0")
      t = String.sub(t, /\A([-+]?)\./, "\\10.")
      return Float(t)
    end
    s
  end

  # ---- dumping ----

  def dump(v, io = nil)
    s = "---" + top(v)
    return s if io == nil
    IO.write(io, s)
    io
  end

  def top(v)
    if (v in Hash) && !Hash.empty?(v)
      out = String["\n"]
      emit_map(out, v, 0, false)
      return Array.join(out, "")
    end
    if (v in Array) && !Array.empty?(v)
      out = String["\n"]
      emit_seq(out, v, 0, false)
      return Array.join(out, "")
    end
    return "\n" if v == nil
    if (v in String) && literal?(v)
      return " " + literal(v, 2)
    end
    " #{scalar(v)}\n"
  end

  def literal?(s) = String.match?(s, /\n(?!\z|\n\z)/) && !String.start_with?(s, " ")

  # A | block: its header and its lines indented by n.
  def literal(s, n)
    trailing = String.size(s) - String.size(String.sub(s, /\n*\z/, ""))
    chomp = trailing == 0 ? "-" : (trailing == 1 ? "" : "+")
    body = String.sub(s, /\n*\z/, "")
    lines = Array.map(String.split(body, "\n", -1)) { |l| l == "" ? "" : " " * n + l }
    extra = trailing > 1 ? "\n" * (trailing - 1) : ""
    "|#{chomp}\n#{Array.join(lines, "\n")}\n#{extra}"
  end

  # The text after "key:" or "-" for v (with its leading space), and its following lines.
  def emit_value(out, v, indent, in_seq)
    if (v in Hash) && !Hash.empty?(v)
      if in_seq
        Array.push(out, " ")
        emit_map(out, v, indent + 2, true)
      else
        Array.push(out, "\n")
        emit_map(out, v, indent + 2, false)
      end
    elsif (v in Array) && !Array.empty?(v)
      if in_seq
        Array.push(out, " ")
        emit_seq(out, v, indent + 2, true)
      else
        Array.push(out, "\n")
        emit_seq(out, v, indent, false)
      end
    elsif v == nil
      Array.push(out, "\n")
    elsif (v in String) && literal?(v)
      Array.push(out, " ", literal(v, indent + 2))
    else
      Array.push(out, " ", scalar(v), "\n")
    end
    out
  end

  def emit_map(out, h, indent, inline_first)
    first = true
    Hash.each(h) do |k, v|
      Array.push(out, " " * indent) unless first && inline_first
      first = false
      Array.push(out, scalar(k), ":")
      emit_value(out, v, indent, false)
    end
    out
  end

  def emit_seq(out, a, indent, inline_first)
    first = true
    Array.each(a) do |v|
      Array.push(out, " " * indent) unless first && inline_first
      first = false
      Array.push(out, "-")
      emit_value(out, v, indent, true)
    end
    out
  end

  def scalar(v)
    case v
    in nil then ""
    in true then "true"
    in false then "false"
    in Integer then Integer.to_s(v)
    in Float
      if Float.nan?(v)
        ".nan"
      elsif Float.infinite?(v)
        v > 0 ? ".inf" : "-.inf"
      else
        Float.to_s(v)
      end
    in Symbol then ":#{Symbol.to_s(v)}"
    in String then string(v)
    in Hash then Hash.empty?(v) ? "{}" : raise(ArgumentError, "a Hash as a mapping key is not supported")
    in Array then Array.empty?(v) ? "[]" : raise(ArgumentError, "an Array as a mapping key is not supported")
    else raise ArgumentError, "cannot dump #{Kernel.inspect(v)} to YAML"
    end
  end

  # Psych's choice of style for a String, then libyaml's check that a plain scalar is allowed.
  def string(s)
    return "!!str '<<'" if s == "<<"
    return double(s) if s == "y" || s == "Y" || s == "n" || s == "N"
    return double(s) if String.match?(s, /\A[^[:word:]][^"]*\z/) || String.include?(s, "\n")
    return single(s) if !(resolve(s) in String) || String.match?(s, /\A0[0-7]*[89]/)
    special = String.match?(s, /[\x00-\x08\x0b-\x1f\x7f\t]/)
    return double(s) if special
    plain_ok = s != "" && !String.match?(s, /\A[\s#,\[\]{}&*!|>'"%@`]|\A[-?:](?:\s|\z)|\s\z|:(?:\s|\z)|\s#/)
    plain_ok ? s : single(s)
  end

  def single(s) = "'#{String.gsub(s, "'", "''")}'"

  def double_escapes = once do
    Hash["\"" => "\\\"", "\\" => "\\\\", "\t" => "\\t", "\n" => "\\n", "\r" => "\\r", "\0" => "\\0",
         "\e" => "\\e", "\a" => "\\a", "\b" => "\\b", "\f" => "\\f", "\v" => "\\v"]
  end

  def double(s)
    body = String.gsub(s, /[\x00-\x1f\x7f"\\]/) { |c| double_escapes[c] || format("\\x%02X", String.ord(c)) }
    "\"#{body}\""
  end
end

# Ruby's obj.to_yaml for the containers.
class Hash
  def to_yaml(h) = YAML.dump(h)
end

class Array
  def to_yaml(a) = YAML.dump(a)
end
