class Sale
  attr_reader date, region, rep, product, units, unit_price

  def revenue(s) = @units * @unit_price
  def month(s) = String.to_i(String.split(@date, "-")[1])
  def quarter(s) = (month(s) - 1) / 3 + 1
end

def parse_sales(text)
  rows = Array.map(String.lines(String.strip(text))) { |l| String.split(String.strip(l), "|") }
  header = Array.map(Array.shift(rows)) { |h| String.to_sym(String.strip(h)) }
  Array.map(rows) do |cells|
    rec = Array.to_h(Array.zip(header, Array.map(cells) { |c| String.strip(c) }))
    Sale.new(rec[:date], rec[:region], rec[:rep], rec[:product], String.to_i(rec[:units]), String.to_f(rec[:price]))
  end
end

# commission: 3% up to 20k, 5% up to 50k, 8% above, per rep for the period
def commission(total)
  bands = Array[[20000.0, 0.03], [50000.0, 0.05], [nil, 0.08]]
  paid = 0.0
  floor = 0.0
  Array.each(bands) do |cap, rate|
    top = cap ? Array.min(Array[total, cap]) : total
    paid += (top - floor) * rate if top > floor
    floor = cap || total
  end
  paid
end

def bar(value, max, width) = "*" * Float.round(value / max * width)

data = <<~TXT
  date       | region | rep    | product  | units | price
  2026-01-14 | North  | Hana   | Widget   | 120   | 25.00
  2026-01-20 | South  | Omar   | Gadget   | 15    | 310.00
  2026-02-03 | North  | Hana   | Gadget   | 22    | 295.00
  2026-02-17 | West   | Luis   | Widget   | 300   | 24.50
  2026-02-28 | South  | Omar   | Gizmo    | 40    | 99.90
  2026-03-09 | West   | Luis   | Gadget   | 31    | 300.00
  2026-03-22 | North  | Pia    | Gizmo    | 75    | 95.00
  2026-04-02 | South  | Omar   | Widget   | 210   | 25.00
  2026-04-15 | North  | Hana   | Gadget   | 48    | 290.00
  2026-05-06 | West   | Luis   | Gizmo    | 60    | 97.50
  2026-05-19 | North  | Pia    | Widget   | 500   | 23.75
  2026-05-30 | South  | Omar   | Gadget   | 12    | 315.00
  2026-06-11 | West   | Luis   | Widget   | 150   | 25.00
  2026-06-25 | North  | Hana   | Gizmo    | 90    | 96.00
TXT

sales = parse_sales(data)
puts("#{Array.size(sales)} sales, total #{format("%.2f", Array.sum(sales) { |s| Sale.revenue(s) })}")
puts

# pivot: region x quarter
cells = Hash.new(0.0)
Array.each(sales) { |s| cells[[Sale.get_region(s), Sale.quarter(s)]] += Sale.revenue(s) }
regions = Array.sort(Array.uniq(Array.map(sales) { |s| Sale.get_region(s) }))
quarters = Array.sort(Array.uniq(Array.map(sales) { |s| Sale.quarter(s) }))
puts(format("%-7s", "") + Array.join(Array.map(quarters) { |q| format("%12s", "Q#{q}") }, "") + format("%12s", "growth"))
Array.each(regions) do |r|
  vals = Array.map(quarters) { |q| cells[[r, q]] }
  growth = (Array.last(vals) - Array.first(vals)) / Array.first(vals) * 100
  puts(format("%-7s", r) + Array.join(Array.map(vals) { |v| format("%12.2f", v) }, "") + format("%+11.1f%%", growth))
end

puts
puts("Revenue by product:")
by_product = Hash.transform_values(Array.group_by(sales) { |s| Sale.get_product(s) }) { |ss| Array.sum(ss) { |s| Sale.revenue(s) } }
top = Array.max(Hash.values(by_product))
Array.each(Hash.sort_by(by_product) { |p, v| -v }) do |p, v|
  puts(format("  %-7s %10.2f %s", p, v, bar(v, top, 30)))
end

puts
puts("Commissions (H1):")
by_rep = Array.group_by(sales) { |s| Sale.get_rep(s) }
rows = Hash.map(by_rep) do |rep, ss|
  total = Array.sum(ss) { |s| Sale.revenue(s) }
  best = Array.max_by(ss) { |s| Sale.revenue(s) }
  [rep, total, commission(total), "#{Sale.get_product(best)} #{Sale.get_date(best)}"]
end
Array.each(Array.sort_by(rows) { |rep, total, c, b| -total }) do |rep, total, c, best|
  puts(format("  %-5s sold %10.2f  commission %8.2f  best deal %s", rep, total, c, best))
end

puts
avg_price = Hash.transform_values(Array.group_by(sales) { |s| Sale.get_product(s) }) do |ss|
  Array.sum(ss) { |s| Sale.revenue(s) } / Array.sum(ss) { |s| Sale.get_units(s) }
end
Hash.each(avg_price) do |p, avg|
  below = Array.select(sales) { |s| Sale.get_product(s) == p && Sale.get_unit_price(s) < avg * 0.98 }
  next if Array.empty?(below)
  puts("#{p}: discounted deals by #{Array.join(Array.uniq(Array.map(below) { |s| Sale.get_rep(s) }), ", ")} (avg #{format("%.2f", avg)})")
end
