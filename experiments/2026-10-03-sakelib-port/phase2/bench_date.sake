require "date"

# date: strftime, strptime, parse and month arithmetic over 400 days.
d = Date.civil(2024, 1, 31)
n = 0
Integer.times(400) do |i|
  x = d + i
  s = Date.strftime(x, "%Y-%m-%d %a %b %e %j %U %V")
  n += String.size(s)
  y = Date.strptime(Date.to_s(x), "%Y-%m-%d")
  n += Date.day(y)
  z = Date.parse("#{Date.day(x)} #{Date.strftime(x, "%b")} #{Date.year(x)}")
  n += Date.month(z)
  n += Date.day(x >> 1)
end
p(n)
