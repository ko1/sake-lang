# A contribution heatmap: daily activity counts over half a year rendered as a
# weekday-by-week grid, plus streaks, monthly totals and busiest weekdays.

def days_from_civil(y, m, d)
  y -= 1 if m <= 2
  era = y / 400
  yoe = y - era * 400
  doy = (153 * ((m + 9) % 12) + 2) / 5 + d - 1
  era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468
end

def civil_from_days(z)
  z += 719468
  era = z / 146097
  doe = z - era * 146097
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  mp = (5 * doy + 2) / 153
  m = mp < 10 ? mp + 3 : mp - 9
  [yoe + era * 400 + (m <= 2 ? 1 : 0), m, doy - (153 * mp + 2) / 5 + 1]
end

def wday(z) = (z + 4) % 7

# Deterministic pseudo activity: weekdays busier, a holiday gap, a crunch week.
def activity(z)
  h = (z * 2654435761) % 4294967296
  base = h % 9
  base = base / 3 if wday(z) == 0 || wday(z) == 6
  base = 0 if h % 5 == 0
  y, m, d = civil_from_days(z)
  base = 0 if m == 8 && d >= 10 && d <= 23
  base += 6 if m == 9 && d >= 21 && d <= 25
  base
end

def level(n, cuts)
  i = Array.find_index(cuts) { |c| n <= c }
  i == nil ? Array.size(cuts) : i
end

first = days_from_civil(2026, 4, 1)
last = days_from_civil(2026, 9, 30)
counts = Hash[]
Range.each(first..last) { |z| counts[z] = activity(z) }

# Quartile cut points over the active days.
active = Array.sort(Array.select(Hash.values(counts)) { |n| n > 0 })
cuts = Array[0, active[Array.size(active) / 4], active[Array.size(active) / 2], active[Array.size(active) * 3 / 4]]
glyphs = Array[".", "-", "+", "*", "#"]

grid_start = first - wday(first)
weeks = (last - grid_start) / 7 + 1

header = String.ljust("", 4)
prev_month = 0
Integer.times(weeks) do |w|
  y, m, d = civil_from_days(grid_start + w * 7)
  label = m != prev_month ? Array["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][m - 1][0] : " "
  header += label
  prev_month = m
end
puts(header)
Array.each_with_index(Array["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]) do |name, wd|
  row = name + " "
  Integer.times(weeks) do |w|
    z = grid_start + w * 7 + wd
    n = counts[z]
    row += n == nil ? " " : glyphs[level(n, cuts)]
  end
  puts(String.rstrip(row))
end
puts("Legend: #{Array.join(Array.map(Range.to_a(0..4)) { |i| "#{glyphs[i]}#{i == 0 ? "=0" : "<=#{i < 4 ? cuts[i] : "max"}"}" }, " ")}")

# Streaks of consecutive active days.
longest = 0
longest_end = first
current = 0
Range.each(first..last) do |z|
  if Hash.fetch(counts, z) > 0
    current += 1
    if current > longest
      longest = current
      longest_end = z
    end
  else
    current = 0
  end
end
sy, sm, sd = civil_from_days(longest_end - longest + 1)
ey, em, ed = civil_from_days(longest_end)
puts(format("Longest streak: %d days (%02d-%02d .. %02d-%02d), current streak: %d", longest, sm, sd, em, ed, current))

monthly = Hash.new(0)
Hash.each(counts) do |z, n|
  y, m, d = civil_from_days(z)
  monthly[m] += n
end
puts("Monthly: " + Array.join(Array.map(Hash.to_a(monthly)) { |m, n| "#{m}=#{n}" }, " "))

by_wday = Array[0, 0, 0, 0, 0, 0, 0]
Hash.each(counts) { |z, n| by_wday[wday(z)] += n }
top = Array.max_by(Range.to_a(0..6)) { |wd| by_wday[wd] }
puts("Per weekday: #{Array.join(by_wday, " ")}; busiest #{top}")
total = Array.sum(Hash.values(counts))
best_day = Hash.max_by(counts) { |z, n| n }
if best_day
  z, n = best_day
  y, m, d = civil_from_days(z)
  puts(format("Total %d over %d days (%.2f/day); best day %04d-%02d-%02d with %d", total, Hash.size(counts),
              Integer.to_f(total) / Hash.size(counts), y, m, d, n))
end
