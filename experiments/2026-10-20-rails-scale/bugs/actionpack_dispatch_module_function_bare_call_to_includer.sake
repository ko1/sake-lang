# In a module that is both a mixin and has `module_function` functions, a bare call inside a module function
# resolves to the includer's function of that name (here C's field reader `conf`) instead of the module's own
# `M.conf`: "wrong number of arguments for C.conf (given 0, expected 1)". Ruby: `M.limit` calls M.conf (=> 10).
# Workaround: give the module function a name the includer does not have, or call it as `M.conf`.
module M
  def twice(m) = M.limit * 2
  module_function
  def conf = once { Hash.of(:limit => 10) }
  def limit = conf[:limit]
end
class C
  attr_reader conf
  include M
end
p(M.limit)
p(C.twice(C.new(nil)))
