# Moon phases with fixed-point integer arithmetic (micro-days), a lunar
# calendar for one month, the year's full moons with traditional names, and
# the sexagenary (stem-branch) year cycle.

def days_from_civil(y, m, d)
  y -= 1 if m <= 2
  era = y / 400
  yoe = y - era * 400
  doy = (153 * ((m + 9) % 12) + 2) / 5 + d - 1
  era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468
end

def civil_from_days(z)
  z += 719468
  era = z / 146097
  doe = z - era * 146097
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  mp = (5 * doy + 2) / 153
  m = mp < 10 ? mp + 3 : mp - 9
  [yoe + era * 400 + (m <= 2 ? 1 : 0), m, doy - (153 * mp + 2) / 5 + 1]
end

# Micro-days: 1 day = 1_000_000 units.
def unit = 1000000
def synodic = 29530589
# Reference new moon: 2000-01-06 18:14 UTC.
def epoch_new_moon = days_from_civil(2000, 1, 6) * unit + (18 * 60 + 14) * unit / 1440

def age_at(day) = (day * unit + unit / 2 - epoch_new_moon) % synodic

def phase_name(age)
  eighth = synodic / 8
  idx = ((age + eighth / 2) / eighth) % 8
  Array["new moon", "waxing crescent", "first quarter", "waxing gibbous",
        "full moon", "waning gibbous", "last quarter", "waning crescent"][idx]
end

# Illuminated fraction in percent, approximated by a triangle wave.
def illumination(age)
  half = synodic / 2
  dist = age <= half ? age : synodic - age
  dist * 100 / half
end

def glyph(age) = Array["@", ")", "D", "O", "O", "O", "C", "("][((age + synodic / 16) / (synodic / 8)) % 8]

def fmt(z)
  y, m, d = civil_from_days(z)
  format("%04d-%02d-%02d", y, m, d)
end

def fmt_moment(units)
  z = units / unit
  mins = (units % unit) * 1440 / unit
  "#{fmt(z)} #{format("%02d:%02d", mins / 60, mins % 60)}"
end

puts("Phases for selected dates:")
Array.each(Array[[2026, 10, 1], [2026, 10, 10], [2026, 10, 17], [2026, 10, 26], [2000, 1, 6], [1969, 7, 20]]) do |y, m, d|
  z = days_from_civil(y, m, d)
  age = age_at(z)
  puts(format("  %s  age %5.2f d  %3d%%  %s", fmt(z), age / Integer.to_f(unit), illumination(age), phase_name(age)))
end

puts
puts("October 2026:")
first = days_from_civil(2026, 10, 1)
line = ""
Range.each(0..30) do |i|
  line += glyph(age_at(first + i))
end
puts("  1#{" " * 8}10#{" " * 8}20#{" " * 8}30")
puts("  #{line}")

# Every new and full moon in 2026 by stepping whole synodic months.
start_units = days_from_civil(2026, 1, 1) * unit
stop_units = days_from_civil(2027, 1, 1) * unit
k = (start_units - epoch_new_moon) / synodic
moons = Array[]
while epoch_new_moon + k * synodic < stop_units
  new_at = epoch_new_moon + k * synodic
  full_at = new_at + synodic / 2
  Array.push(moons, [:new, new_at]) if new_at >= start_units
  Array.push(moons, [:full, full_at]) if full_at >= start_units && full_at < stop_units
  k += 1
end

names = Array["Wolf", "Snow", "Worm", "Pink", "Flower", "Strawberry", "Buck", "Sturgeon", "Harvest", "Hunter's", "Beaver", "Cold"]
fulls = Array.select(moons) { |kind, at| kind == :full }
puts
puts("Full moons of 2026 (#{Array.size(fulls)}):")
by_month = Array.group_by(fulls) { |kind, at| civil_from_days(at / unit)[1] }
Array.each(fulls) do |kind, at|
  m = civil_from_days(at / unit)[1]
  blue = Array.size(Hash.fetch(by_month, m)) > 1 && Array.index(Hash.fetch(by_month, m), [kind, at]) == 1
  puts(format("  %s  %s%s", fmt_moment(at), names[m - 1], blue ? " (blue moon)" : ""))
end
news = Array.count(moons) { |kind, at| kind == :new }
puts("New moons: #{news}")

puts
stems = Array["Jia", "Yi", "Bing", "Ding", "Wu", "Ji", "Geng", "Xin", "Ren", "Gui"]
branches = Array["Rat", "Ox", "Tiger", "Rabbit", "Dragon", "Snake", "Horse", "Goat", "Monkey", "Rooster", "Dog", "Pig"]
elements = Array["Wood", "Fire", "Earth", "Metal", "Water"]
puts("Sexagenary years:")
Range.each(2020..2031) do |y|
  s = (y - 4) % 10
  b = (y - 4) % 12
  puts(format("  %d  %-5s %-8s %-5s %s, cycle year %2d", y, stems[s], branches[b], elements[s / 2], s % 2 == 0 ? "yang" : "yin", (y - 4) % 60 + 1))
end
golden = Range.map(2024..2030) { |y| "#{y}:#{y % 19 + 1}" }
puts("Golden numbers: #{Array.join(golden, " ")}")
