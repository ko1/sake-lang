# A type's own to_s is used by puts, interpolation, Kernel.to_s, Array.join and format's %s;
# its own inspect by p, Kernel.inspect, containers, and format's %p. p does not fall back to
# to_s (as Ruby's Struct). Both may come from an included module.
module Show
  def to_s(x) = "Show(#{label(x)})"
  def inspect(x) = "<#{label(x)}>"
end
class A
  attr_reader n
  include Show
  def label(a) = "A#{@n}"
end
class B
  attr_reader n
  def to_s(b) = "b#{@n}"
end
Pt = Struct.new(:x)
puts(A.new(1), "#{A.new(2)}", Kernel.to_s(A.new(3)), Array.join(Array[A.new(4), A.new(5)], ","))
p(A.new(6), Array[A.new(7)], Hash["k" => A.new(8)], [A.new(9), {a: A.new(10)}])
puts(Kernel.inspect(A.new(11)))
puts(B.new(1))
p(B.new(2))
puts(format("%s|%p", A.new(12), A.new(12)))
puts(format("%p %p %p %p", [1, "a"], {k: 1}, Pt.new(1), Integer[1]))
