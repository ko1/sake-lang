# LIKE patterns (2.3): % matches any run of characters, _ exactly one; ASCII case is ignored.
module Like
  module_function

  def matches?(text, pattern)
    t = String.chars(String.downcase(text))
    p = String.chars(String.downcase(pattern))
    nt = Array.size(t)
    np = Array.size(p)
    ti = 0
    pi = 0
    star = -1
    mark = 0
    while ti < nt
      if pi < np && p[pi] == "%"
        star = pi
        mark = ti
        pi += 1
      elsif pi < np && (p[pi] == "_" || p[pi] == t[ti])
        pi += 1
        ti += 1
      elsif star >= 0
        pi = star + 1
        mark += 1
        ti = mark
      else
        return false
      end
    end
    pi += 1 while pi < np && p[pi] == "%"
    pi == np
  end
end
