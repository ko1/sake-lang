# Port of activesupport-8.1.3/lib/active_support/core_ext/string/output_safety.rb (part 2 of 2: SafeBuffer is in safe_buffer.sake)
#
# Ruby defines SafeBuffer's unsafe methods (upcase, upcase!, ...: 39 of them) with class_eval over a list of
# names; here `generate` writes them (safe_buffer_unsafe_methods.sake). A generated `class SafeBuffer` must come
# after the one that declares its fields, and a file's requires are read before its own code, so the class is in
# safe_buffer.sake and this file only joins the two.

require "safe_buffer"
require "../erb/util"

generate "safe_buffer_unsafe_methods"
