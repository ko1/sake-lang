Account = Data.define(:owner, :balance, :history)

class Account
  def open(owner) = Account.new(owner, 0, Array[])

  def deposit(acct, amount)
    set_balance(acct, get_balance(acct) + amount)
    Array.push(get_history(acct), ["deposit", amount])
    acct
  end

  def withdraw(acct, amount)
    if get_balance(acct) < amount
      Array.push(get_history(acct), ["refused", amount])
      return false
    end
    set_balance(acct, get_balance(acct) - amount)
    Array.push(get_history(acct), ["withdraw", amount])
    true
  end

  def statement(acct)
    puts(String.+("Statement for ", get_owner(acct)))
    Array.each(get_history(acct)) do |kind, amount|
      puts(String.+("  ", String.+(String.ljust(kind, 10), String.rjust(Integer.to_s(amount), 6))))
    end
    puts(String.+("  balance   ", String.rjust(Integer.to_s(get_balance(acct)), 6)))
  end
end

alice = Account.open("Alice")
Account.deposit(alice, 500)
Account.withdraw(alice, 120)
Account.withdraw(alice, 1000)
Account.statement(alice)
