# Port of actionpack-8.1.3/lib/action_dispatch/routing/url_for.rb (partial: no Classes, no route_for, no _with_routes; records and Arrays go to polymorphic_routes.sake)
#
# Rails' UrlFor is a concern included in controllers, views and mailers; its `included` block adds the class
# attribute default_url_options. Here it is a mixin whose includer defines `_routes(t)` (the RouteSet) and
# `url_options(t)` (Rails' default: default_url_options); the generated `*_path`/`*_url` helpers call through it.

require "polymorphic_routes"

module ActionDispatch
  module Routing
    module UrlFor
      def _routes(t) = raise(NotImplementedError)
      def url_options(t) = raise(NotImplementedError)
      def default_url_options(t) = Hash.new

      def url_for(t, options = nil) = full_url_for(t, options)

      def full_url_for(t, options = nil)
        case options
        in nil then RouteSet.url_for(_routes(t), Hash.dup(url_options(t)))
        in Hash
          route_name = options[:use_route]
          o = Hash.dup(options)
          Hash.delete(o, :use_route)
          merged_url_options = Hash.merge(url_options(t), o)
          RouteSet.url_for(_routes(t), merged_url_options, route_name == nil ? nil : Kernel.to_s(route_name))
        in String then options
        in Symbol then PolymorphicRoutes::HelperMethodBuilder.polymorphic_method(t, options, nil, :url, Hash.new)
        in Array
          last = Array.last(options)
          opts = (last in Hash) ? last : Hash.new
          components = Array.compact(Array.map(options) do |x|
            case x
            in Hash then nil
            else x
            end
          end)
          polymorphic_url(t, components, opts)
        in PolymorphicRoutes::Model then polymorphic_url(t, options)
        end
      end

      def optimize_routes_generation?(t)
        RouteSet.optimize_routes_generation?(_routes(t)) && Hash.empty?(default_url_options(t))
      end
    end

    # Rails' `routes.url_helpers` called on the module itself (url_options are {}): `RouteSet.url_helpers(set)`
    class RoutesProxy
      attr_reader routes
      include UrlFor
      def _routes(p) = @routes
      def url_options(p) = Hash.new
    end
  end
end
