# The checks on one row before it is stored (2.1), in the order the specification gives them.
module Constraints
  module_function

  # The row as it will be stored (columns, then the rowid), or the first error. `raw` has one value per
  # column plus the rowid slot (defaults already applied); `rows` is the table as it stands, whose row
  # number `skip` (-1 for none) is the row being replaced. A NULL rowid is filled in only when
  # `auto_key` (INSERT).
  def check_row(table, raw, rows, skip, auto_key)
    columns = Table.columns(table)
    ipk = Table.rowid(table)
    row = Array.dup(raw)
    settle_rowid(row, Array.size(columns), ipk, rows, auto_key)
    check_not_null(table, row)
    check_rowid_unique(table, row, rows, skip)
    i = 0
    Array.each(columns) do |c|
      row[i] = Storage.coerce(row[i], c, Table.name(table)) if i != ipk
      i += 1
    end
    Array.each(Array.reverse(Table.keys(table))) { |k| check_unique(table, k, row, rows, skip) unless Key.is_rowid(k) }
    row
  end

  # The rowid (the INTEGER PRIMARY KEY column if there is one, else the slot after the columns) gets
  # the next number when NULL, and must be an INTEGER otherwise. Afterwards the slot after the columns
  # holds it in either case.
  def settle_rowid(row, ncols, ipk, rows, auto_key)
    at = ipk >= 0 ? ipk : ncols
    v = row[at]
    if v == nil
      Errors.sql_error("datatype mismatch") unless auto_key
      row[at] = next_rowid(rows, ncols)
    else
      n = Storage.key_value(v)
      Errors.sql_error("datatype mismatch") if n == nil
      row[at] = n
    end
    row[ncols] = row[at]
  end

  # One more than the largest rowid present, or 1 if there are no rows.
  def next_rowid(rows, ncols)
    return 1 if Array.empty?(rows)
    best = rows[0][ncols]
    Array.each(rows) { |r| best = r[ncols] if r[ncols] > best }
    best + 1
  end

  # Another row with the same rowid conflicts; the message names the INTEGER PRIMARY KEY column if any.
  def check_rowid_unique(table, row, rows, skip)
    ncols = Array.size(Table.columns(table))
    i = 0
    Array.each(rows) do |other|
      if i != skip && other[ncols] == row[ncols]
        ipk = Table.rowid(table)
        name = ipk >= 0 ? Column.name(Table.columns(table)[ipk]) : "rowid"
        Errors.sql_error("UNIQUE constraint failed: #{Table.name(table)}.#{name}")
      end
      i += 1
    end
  end

  def check_not_null(table, row)
    i = 0
    Array.each(Table.columns(table)) do |c|
      Errors.sql_error("NOT NULL constraint failed: #{Table.name(table)}.#{Column.name(c)}") if Column.not_null(c) && row[i] == nil
      i += 1
    end
  end

  # Another row with equal values in all the key's columns conflicts, unless one of them is NULL.
  def check_unique(table, key, row, rows, skip)
    return if Array.any?(Key.cols(key)) { |c| row[c] == nil }
    i = 0
    Array.each(rows) do |other|
      if i != skip && same_key?(key, row, other)
        names = Array.map(Key.cols(key)) { |c| "#{Table.name(table)}.#{Column.name(Table.columns(table)[c])}" }
        Errors.sql_error("UNIQUE constraint failed: #{Array.join(names, ", ")}")
      end
      i += 1
    end
  end

  def same_key?(key, a, b) = Array.all?(Key.cols(key)) { |c| Values.compare(a[c], b[c]) == 0 }
end
