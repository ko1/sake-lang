def corpus
  "It was the best of times, it was the worst of times, it was the age of wisdom, " +
  "it was the age of foolishness, it was the epoch of belief, it was the epoch of " +
  "incredulity, it was the season of Light, it was the season of Darkness, it was " +
  "the spring of hope, it was the winter of despair, we had everything before us, " +
  "we had nothing before us, we were all going direct to Heaven, we were all going " +
  "direct the other way. In short, the period was so far like the present period, " +
  "that some of its noisiest authorities insisted on its being received, for good " +
  "or for evil, in the superlative degree of comparison only."
end

def stopwords
  Set["the", "of", "it", "was", "we", "a", "an", "and", "in", "to", "on", "for", "or", "so", "that", "its", "us", "all", "had", "were"]
end

def tokenize(text)
  words = String.split(String.downcase(text), /[^a-z']+/)
  Array.reject(words) { |w| String.empty?(w) }
end

class Rank < {reader: [word, count]}
  include Comparable
  def <=>(a, b)
    c = Rank.get_count(b) <=> @count
    c == 0 ? @word <=> Rank.get_word(b) : c
  end
  def to_s(r) = format("%-14s %3d", @word, @count)
end

def count_words(words, stop)
  counts = Hash.new(0)
  Array.each(words) do |w|
    next if Set.include?(stop, w)
    counts[w] += 1
  end
  counts
end

def top_n(counts, n)
  ranks = Hash.map(counts) { |w, c| Rank.new(w, c) }
  Array.take(Array.sort(ranks), n)
end

def length_histogram(words)
  hist = Hash.new(0)
  Array.each(words) { |w| hist[String.size(w)] += 1 }
  hist
end

def bar(n) = "#" * n

words = tokenize(corpus)
puts("tokens: #{Array.size(words)}")
puts("distinct: #{Array.size(Array.uniq(words))}")

counts = count_words(words, stopwords)
puts("content words: #{Hash.size(counts)}")
puts("-- top 10 --")
Array.each_with_index(top_n(counts, 10)) do |r, i|
  puts("#{String.rjust(Integer.to_s(i + 1), 2)}. #{r}")
end

puts("-- word lengths --")
hist = length_histogram(words)
Array.each(Array.sort(Hash.keys(hist))) do |len|
  puts(format("%2d %-20s %d", len, bar(hist[len]), hist[len]))
end

longest = Array.max_by(Hash.keys(counts)) { |w| String.size(w) }
puts("longest content word: #{longest}")
singles = Array.sort(Hash.keys(Hash.select(counts) { |w, c| c == 1 }))
puts("hapax (#{Array.size(singles)}): #{Array.join(Array.take(singles, 8), ", ")} ...")
share = Float.round(100.0 * Array.size(singles) / Hash.size(counts), 1)
puts("hapax share: #{share}%")
