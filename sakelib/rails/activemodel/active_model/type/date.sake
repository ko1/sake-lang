# Port of activemodel-8.1.3/lib/active_model/type/date.rb (partial: no ::Date._parse fallback for other formats)

module ActiveModel
  module Type
    class Date
      attr_reader precision, scale, limit
      include Value
      include Helpers::Immutable
      include Helpers::Timezone
      include Helpers::AcceptsMultiparameterTime

      def initialize(t) = nil
      def multiparameter_defaults(t) = Hash.new

      def type(t) = :date

      def type_cast_for_schema(t, value)
        value => ::Date
        Kernel.inspect(::Date.strftime(value, "%Y-%m-%d"))
      end

      def cast_value(t, value)
        case value
        in ::String
          return nil if ::String.empty?(value)
          fast_string_to_date(t, value)
        in ::Time then ::Date.new(::Time.year(value), ::Time.month(value), ::Time.day(value))
        else value
        end
      end

      def fast_string_to_date(t, string)
        m = ::String.match(string, /\A(\d{4})-(\d\d)-(\d\d)\z/)
        m ? new_date(t, ::String.to_i(m[1] || ""), ::String.to_i(m[2] || ""), ::String.to_i(m[3] || "")) : nil
      end

      def new_date(t, year, mon, mday)
        return nil if year == 0 && mon == 0 && mday == 0
        ::Date.new(year, mon, mday) rescue nil
      end

      def value_from_multiparameter_assignment(t, values_hash)
        y = values_hash[1]
        m = values_hash[2]
        d = values_hash[3]
        return nil unless y && m && d
        new_date(t, y, m, d)
      end
    end
  end
end
