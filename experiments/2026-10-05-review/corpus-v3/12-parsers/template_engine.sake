class Tag
  attr_reader kind, name, children
  def initialize(t)
    @children = nil
    @children = Tag[]
  end
end

class TemplateError < Exception
  attr_reader pos
end

def parse_template(src)
  root = Tag.new(:root, "")
  stack = Array[root]
  pos = 0
  while true
    open = String.index(src, "{{", pos)
    if open == nil
      Array.push(Tag.children(Array.last(stack)), Tag.new(:text, src[pos..])) if pos < String.size(src)
      break
    end
    Array.push(Tag.children(Array.last(stack)), Tag.new(:text, src[pos...open])) if open > pos
    raw = src[open + 2] == "{"
    closer = raw ? "}}}" : "}}"
    body_start = open + (raw ? 3 : 2)
    close = String.index(src, closer, body_start)
    raise TemplateError.new("unclosed tag", open) if close == nil
    inner = String.strip(src[body_start...close])
    pos = close + String.size(closer)
    sigil = inner[0]
    name = String.strip(inner[1..] || "")
    current = Tag.children(Array.last(stack))
    if raw
      Array.push(current, Tag.new(:raw, inner))
    elsif sigil == "#" || sigil == "^"
      tag = Tag.new(sigil == "#" ? :section : :inverted, name)
      Array.push(current, tag)
      Array.push(stack, tag)
    elsif sigil == "/"
      top = Array.pop(stack)
      raise TemplateError.new("unexpected {{/#{name}}}", open) if Array.empty?(stack) || Tag.name(top) != name
    elsif sigil == "!"
      nil
    else
      raise TemplateError.new("empty tag", open) if String.empty?(inner)
      Array.push(current, Tag.new(:var, inner))
    end
  end
  raise TemplateError.new("unclosed section '#{Tag.name(Array.last(stack))}'", String.size(src)) if Array.size(stack) > 1
  root
end

def lookup(contexts, name)
  return Array.last(contexts) if name == "."
  first, *rest = String.split(name, ".")
  Array.reverse_each(contexts) do |ctx|
    next unless (ctx in Hash) && Hash.key?(ctx, first)
    return Array.reduce(rest, ctx[first]) { |v, part| (v in Hash) ? v[part] : nil }
  end
  nil
end

def escape(s) = s.String.gsub("&", "&amp;").String.gsub("<", "&lt;").String.gsub(">", "&gt;").String.gsub("\"", "&quot;")

def blank?(v) = v == nil || v == false || ((v in Array) && Array.empty?(v))

def render(tag, contexts, out)
  Array.each(Tag.children(tag)) do |t|
    name = Tag.name(t)
    case Tag.kind(t)
    in :text then Array.push(out, name)
    in :var then Array.push(out, escape(Kernel.to_s(lookup(contexts, name))))
    in :raw then Array.push(out, Kernel.to_s(lookup(contexts, name)))
    in :inverted then render(t, contexts, out) if blank?(lookup(contexts, name))
    in :section
      v = lookup(contexts, name)
      if v in Array
        Array.each(v) do |item|
          Array.push(contexts, item)
          render(t, contexts, out)
          Array.pop(contexts)
        end
      elsif !blank?(v)
        Array.push(contexts, v)
        render(t, contexts, out)
        Array.pop(contexts)
      end
    end
  end
  out
end

def fill(template, data) = Array.join(render(parse_template(template), Array[data], Array[]))

def data = once do
  Hash[
    "shop" => "Tea & Co",
    "user" => Hash["name" => "Ada <admin>", "vip" => true, "address" => Hash["city" => "Kyoto"]],
    "items" => Array[
      Hash["name" => "sencha", "qty" => 2, "price" => 3.5],
      Hash["name" => "matcha", "qty" => 1, "price" => 12.0, "note" => "ceremonial"],
      Hash["name" => "hojicha", "qty" => 3, "price" => 2.25]
    ],
    "tags" => Array["green", "loose", "organic"],
    "coupons" => Array[],
    "footer" => "<em>thanks</em>"
  ]
end

def templates = once do
  Array[
    "Hello {{user.name}} from {{user.address.city}}!{{#user.vip}} (VIP){{/user.vip}}",
    "{{! receipt }}{{shop}} receipt:\n{{#items}}- {{qty}} x {{name}} @ {{price}}{{#note}} [{{note}}]{{/note}}\n{{/items}}",
    "Tags: {{#tags}}<{{.}}> {{/tags}}| coupons: {{#coupons}}{{code}}{{/coupons}}{{^coupons}}none{{/coupons}}",
    "{{footer}} vs {{{footer}}}; missing=[{{nothing}}] [{{user.zip.code}}]",
    "{{#items}}{{name}} for {{user.name}}; {{/items}}",
    "{{#items}}oops",
    "{{name}} {{/items}}",
    "Hi {{user.name",
    "{{ }}"
  ]
end

Array.each_with_index(templates) do |t, i|
  puts("--- template #{i + 1}")
  begin
    puts(fill(t, data))
  rescue TemplateError => e
    puts("error at #{TemplateError.pos(e)}: #{Exception.message(e)}")
  end
end
