module Sql
  module Query
    class Entry
      attr_reader values: Array[value]
      attr_reader keys: Array[value]

      def initialize: (Array[value] values, Array[value] keys) -> void
    end

    def self.run: (Ast::Select statement, Catalog catalog) -> Array[String]
    def self.result_rows: (SelectPlan plan, Array[value] outer) -> Array[Array[value]]
    def self.source_rows: (SelectPlan plan, Array[value] outer) -> Array[Array[value]]
    def self.item_rows: (PlanSource item) -> Array[Array[value]]
    def self.entries: (SelectPlan plan, Array[Array[value]] rows) -> Array[Entry]
    def self.distinct: (Array[Entry] entries) -> Array[Entry]
    def self.bound: (Ast::Expr? expr) -> Integer?
  end
end
