class Edge
  attr_reader line, to, minutes, group
end

class Network
  attr_reader penalty, adj

  def initialize(n) = @adj = Hash[]

  def add_one(n, a, e)
    list = @adj[a]
    if list
      Array.push(list, e)
    else
      @adj[a] = Edge[e]
    end
  end

  def add(n, line, a, b, minutes, group)
    add_one(n, a, Edge.new(line, b, minutes, group))
    add_one(n, b, Edge.new(line, a, minutes, group))
  end

  def known?(n, s) = Hash.key?(@adj, s)

  def edges(n, s) = Hash.fetch(@adj, s, Edge[])

  def better?(n, key, old) = old == nil || key < old

  # [time, transfers, stations, lines] of the best trip, or nil
  def route(n, from, to)
    best = Hash[]
    done = Set[]
    Array.each(edges(n, from)) do |e|
      key = [Edge.minutes(e), 0, Array[from, Edge.to(e)], Array[Edge.line(e)]]
      st = [Edge.to(e), Edge.line(e)]
      best[st] = key if better?(n, key, best[st])
    end
    loop do
      cur = Hash.reject(best) { |st, _| Set.include?(done, st) }.Hash.min_by { |_, k| k }
      return nil unless cur
      st, key = cur
      Set.add(done, st)
      station, line = st
      return key if station == to
      time, transfers, stations, lines = key
      Array.each(edges(n, station)) do |e|
        nxt = Edge.to(e)
        next if Array.include?(stations, nxt)
        ns = [nxt, Edge.line(e)]
        next if Set.include?(done, ns)
        change = Edge.line(e) == line ? 0 : 1
        nk = [time + Edge.minutes(e) + change * @penalty, transfers + change, stations + Array[nxt], lines + Array[Edge.line(e)]]
        best[ns] = nk if better?(n, nk, best[ns])
      end
    end
  end
end

def seg_lines(net, a, b, line)
  e = Array.find(Network.edges(net, a)) { |x| Edge.to(x) == b && Edge.line(x) == line }
  Edge.group(e)
end

def legs(net, stations, lines)
  out = String[]
  i = 0
  size = Array.size(lines)
  while i < size
    j = i
    j += 1 while j + 1 < size && lines[j + 1] == lines[i]
    common = seg_lines(net, stations[i], stations[i + 1], lines[i])
    k = i + 1
    while k <= j
      here = seg_lines(net, stations[k], stations[k + 1], lines[k])
      common = Array.select(common) { |l| Array.include?(here, l) }
      k += 1
    end
    seg = Array.join(Array.take(Array.drop(stations, i), j - i + 2), " > ")
    Array.push(out, "#{Array.join(Array.sort(common), "/")}: #{seg}")
    i = j + 1
  end
  Array.join(out, "; ")
end

def query(net, from, to)
  head = "#{from} -> #{to}:"
  bad = Array.find(Array[from, to]) { |s| !Network.known?(net, s) }
  if bad
    puts("#{head} unknown station #{bad}")
    return
  end
  if from == to
    puts("#{head} 0 min, 0 transfers")
    return
  end
  r = Network.route(net, from, to)
  if r
    time, transfers, stations, lines = r
    puts("#{head} #{time} min, #{transfers} transfer#{transfers == 1 ? "" : "s"}")
    puts("  #{legs(net, stations, lines)}")
  else
    puts("#{head} no route")
  end
end

def valid_minutes?(s) = String.match?(s, /\A[1-9]\d*\z/) && String.to_i(s) <= 999

first = gets
net = Network.new(first ? String.to_i(first) : 0)
in_queries = false
used = Set[]
n = 1
while (raw = gets)
  n += 1
  raw = String.chomp(raw)
  f = String.split(raw, " ")
  next if Array.empty?(f)
  if !in_queries
    if raw == "QUERIES"
      in_queries = true
    elsif Array.size(f) == 4 && valid_minutes?(Array.fetch(f, 3)) && f[1] != f[2]
      spec = Array.fetch(f, 0)
      names = String.split(spec, "/")
      lo = f[1] < f[2] ? f[1] : f[2]
      hi = f[1] < f[2] ? f[2] : f[1]
      ok = !String.start_with?(spec, "/") && !String.end_with?(spec, "/") && !String.include?(spec, "//")
      ok = false if Array.size(Array.uniq(names)) != Array.size(names)
      ok = false if ok && Array.any?(names) { |l| Set.include?(used, "#{l} #{lo} #{hi}") }
      if ok
        Array.each(names) do |l|
          Set.add(used, "#{l} #{lo} #{hi}")
          Network.add(net, l, Array.fetch(f, 1), Array.fetch(f, 2), String.to_i(Array.fetch(f, 3)), names)
        end
      else
        puts("invalid segment at line #{n}")
      end
    else
      puts("invalid segment at line #{n}")
    end
  elsif Array.size(f) == 2
    query(net, Array.fetch(f, 0), Array.fetch(f, 1))
  else
    puts("invalid query at line #{n}")
  end
end
