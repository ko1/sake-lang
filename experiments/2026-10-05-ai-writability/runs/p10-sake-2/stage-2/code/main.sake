# A small SQL engine: reads a SQL script on standard input and runs it (see SPEC.md).
#
#   sql/errors     SqlError and its helpers        sql/lexer       text -> tokens -> statements
#   sql/text       nil-free string slices          sql/parser      tokens -> statement trees
#   sql/numtext    numbers read out of text        sql/ast         the trees
#   sql/values     SQL values: print, order, truth sql/catalog     tables, keys, rows
#   sql/arith      + - * / %                       sql/storage     column types enforced on store
#   sql/strfn      substr, trim, replace, instr    sql/constraints NOT NULL, UNIQUE, PRIMARY KEY checks
#   sql/rounding   round()                         sql/functions   scalar functions (dispatch)
#   sql/like, sql/cast, sql/predicates   LIKE, CAST, CASE/BETWEEN/IN
#   sql/resolver   names -> row positions          sql/eval        expressions on a row
#   sql/sorter     ORDER BY                        sql/select, sql/insert, sql/update, sql/delete
#   sql/executor   statement -> module
require "sql/errors"
require "sql/text"
require "sql/numtext"
require "sql/values"
require "sql/ast"
require "sql/lexer"
require "sql/parser"
require "sql/catalog"
require "sql/storage"
require "sql/strfn"
require "sql/rounding"
require "sql/functions"
require "sql/arith"
require "sql/resolver"
require "sql/eval"
require "sql/like"
require "sql/cast"
require "sql/predicates"
require "sql/sorter"
require "sql/select"
require "sql/constraints"
require "sql/insert"
require "sql/update"
require "sql/delete"
require "sql/executor"

def run_script(src)
  db = Catalog.new_database
  Array.each(Lexer.split_statements(Lexer.tokenize(src))) do |toks|
    begin
      lines = Executor.run(db, Parser.parse_statement(toks))
      Array.each(lines) { |line| puts(line) }
    rescue SqlError => e
      puts("Error: #{Exception.message(e)}")
    end
  end
end

run_script(IO.read(IO.stdin))
