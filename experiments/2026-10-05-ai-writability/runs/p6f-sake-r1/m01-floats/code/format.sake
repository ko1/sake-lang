# How values are written as text (SPEC.md, "Printing values"), and small
# helpers for wording messages.
module Format
  module_function

  # The text `print`, `str`, `join` and interpolation produce: a string as it is,
  # any other value as `repr` writes it.
  def show(value) = (value in String) ? value : repr(value)

  # The text of a value as it appears inside an array or map: strings are quoted.
  def repr(value, depth = 0)
    return "..." if depth > max_nesting

    case value
    in nil then "nil"
    in true then "true"
    in false then "false"
    in Integer then Integer.to_s(value)
    in Float then float_text(value)
    in String then quote(value)
    in Array then "[#{Array.join(Array.map(value) { |element| repr(element, depth + 1) }, ", ")}]"
    in Hash then "{#{Array.join(Hash.map(value) { |key, element| "#{repr(key, depth + 1)}: #{repr(element, depth + 1)}" }, ", ")}}"
    in Closure then FnExpr.name(Closure.fn(value)) == nil ? "<fn>" : "<fn #{FnExpr.name(Closure.fn(value))}>"
    in Builtin then "<builtin #{Builtin.name(value)}>"
    else raise ArgumentError, "not a Mini value: #{Kernel.inspect(value)}"
    end
  end

  # The shortest digits that read back as `x`, laid out as SPEC.md "Text" says.
  def float_text(x)
    text = Float.to_s(x)
    negative = String.start_with?(text, "-")
    body = negative ? text[1..] : text
    mantissa, exponent = String.split(body, "e")
    whole, fraction = String.split(mantissa, ".")
    digits = whole + fraction
    point = String.length(whole) + (exponent == nil ? 0 : String.to_i(exponent))
    while String.length(digits) > 1 && String.start_with?(digits, "0")
      digits = digits[1..]
      point -= 1
    end
    while String.length(digits) > 1 && String.end_with?(digits, "0")
      digits = digits[0...-1]
    end
    sign = negative ? "-" : ""
    return "#{sign}0.0" if digits == "0"

    n = String.length(digits)
    e10 = point - 1
    if e10 < -4 || e10 >= 16 || (e10 >= 15 && n <= point)
      rest = n == 1 ? "0" : digits[1..]
      power = Integer.abs(e10)
      power_text = power < 10 ? "0#{power}" : Integer.to_s(power)
      "#{sign}#{digits[0]}.#{rest}e#{e10 < 0 ? "-" : "+"}#{power_text}"
    elsif point <= 0
      "#{sign}0.#{"0" * -point}#{digits}"
    elsif point >= n
      "#{sign}#{digits}#{"0" * (point - n)}.0"
    else
      "#{sign}#{digits[0...point]}.#{digits[point..]}"
    end
  end

  # A string literal that reads back as `text`.
  def quote(text)
    escaped = Array.map(String.chars(text)) do |c|
      case c
      in "\\" then "\\\\"
      in "\"" then "\\\""
      in "\n" then "\\n"
      in "\t" then "\\t"
      in "{" then "\\{"
      else c
      end
    end
    "\"#{Array.join(escaped)}\""
  end

  # "1 argument", "2 arguments", "0 arguments".
  def count(n, noun) = n == 1 ? "1 #{noun}" : "#{n} #{noun}s"

  # The edit distance between two names: the fewest single-character
  # insertions, deletions, substitutions and swaps of two adjacent characters
  # that turn `a` into `b` (the optimal string alignment distance).
  def edit_distance(a, b)
    x = String.chars(a)
    y = String.chars(b)
    d = Array.new(Array.length(x) + 1) { |i| Array.new(Array.length(y) + 1) { |j| i == 0 ? j : (j == 0 ? i : 0) } }
    Range.each(1..Array.length(x)) do |i|
      Range.each(1..Array.length(y)) do |j|
        cost = x[i - 1] == y[j - 1] ? 0 : 1
        best = Tuple.min([d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost])
        if i > 1 && j > 1 && x[i - 1] == y[j - 2] && x[i - 2] == y[j - 1]
          best = Tuple.min([best, d[i - 2][j - 2] + 1])
        end
        d[i][j] = best
      end
    end
    d[Array.length(x)][Array.length(y)]
  end

  # The name a message uses for a function: "f", or "function" when anonymous.
  def function_label(fn) = FnExpr.name(fn) == nil ? "function" : FnExpr.name(fn)
end
