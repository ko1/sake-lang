# ipaddr: Ruby's IPAddr (ipaddr 1.2.8) in Sake: IPv4 and IPv6 addresses and networks.
#
# IPAddr.new("192.168.1.0/24"), IPAddr.new(3232235777, Socket.AF_INET); operators & | ~ << >> + -
# == <=> (Comparable) and include?. Ruby's IPAddr::InvalidAddressError & co. are IPAddrInvalidAddressError
# & co. (no nested names, no hierarchy); Socket::AF_INET is Socket.AF_INET.

class IPAddrError < Exception
end

class IPAddrInvalidAddressError < Exception
end

class IPAddrAddressFamilyError < Exception
end

class IPAddrInvalidPrefixError < Exception
end

class Socket
  def AF_UNSPEC = 0
  def AF_INET = 2
  def AF_INET6 = 10
end

class IPAddr
  include Comparable
  include Bitwise
  include Arithmetic

  # `src` is what IPAddr.new was given (a String, or an Integer with a family); initialize parses it.
  attr_reader src, family
  private attr_accessor addr, mask_addr, zone_id_

  def in4mask = 0xffffffff
  def in6mask = 0xffffffffffffffffffffffffffffffff

  def ipv4_re = once { /\A\d+\.\d+\.\d+\.\d+\z/ }
  def ipv6_full_re = once { /\A(?:(?:[\da-f]{1,4}:){7}[\da-f]{1,4}|((?:[\da-f]{1,4}:){6})(\d+)\.(\d+)\.(\d+)\.(\d+))\z/i }
  def ipv6_compressed_re = once { /\A((?:(?:[\da-f]{1,4}:)*[\da-f]{1,4})?)::(((?:[\da-f]{1,4}:)*)(?:[\da-f]{1,4}|(\d+)\.(\d+)\.(\d+)\.(\d+)))?\z/i }

  def initialize(ip)
    @src = "::" if @src == nil
    @family = 0 if @family == nil
    @addr = 0
    @mask_addr = 0
    @zone_id_ = nil
    src = @src
    family = @family
    family => Integer
    if src in Integer
      if family == Socket.AF_INET || family == Socket.AF_INET6
        set!(ip, src, family)
        @mask_addr = family == Socket.AF_INET ? in4mask : in6mask
        return
      end
      raise IPAddrAddressFamilyError, "address family must be specified" if family == Socket.AF_UNSPEC
      raise IPAddrAddressFamilyError, "unsupported address family: #{family}"
    end
    src => String
    prefix, prefixlen = String.split(src, "/", 2)
    prefix ||= ""
    if (m = String.match(prefix, /\A\[(.*)\]\z/i))
      prefix = m[1] || ""
      family = Socket.AF_INET6
    end
    zone_id = nil
    if (m = String.match(prefix, /\A(.*)(%\w+)\z/))
      prefix = m[1] || ""
      zone_id = m[2]
      family = Socket.AF_INET6
    end
    addr = nil
    found = nil
    if family == Socket.AF_UNSPEC || family == Socket.AF_INET
      addr = in_addr(prefix)
      found = Socket.AF_INET if addr
    end
    if addr == nil && (family == Socket.AF_UNSPEC || family == Socket.AF_INET6)
      addr = in6_addr(prefix, src)
      found = Socket.AF_INET6
    end
    @zone_id_ = zone_id
    raise IPAddrAddressFamilyError, "address family mismatch" if family != Socket.AF_UNSPEC && found != family
    raise IPAddrInvalidAddressError, "invalid address: #{src}" unless addr && found
    @addr = addr
    @family = found
    if prefixlen
      mask!(ip, prefixlen)
    else
      @mask_addr = found == Socket.AF_INET ? in4mask : in6mask
    end
  end

  # ---- parsing ----

  def in_addr(addr)
    return nil unless String.match?(addr, ipv4_re)
    octets(String.split(addr, "."), addr)
  end

  def octets(parts, addr)
    Array.reduce(parts, 0) do |i, s|
      n = String.to_i(s)
      raise IPAddrInvalidAddressError, "invalid address: #{addr}" unless n < 256
      if s != "0" && String.start_with?(s, "0")
        raise IPAddrInvalidAddressError, "zero-filled number in IPv4 address is ambiguous: #{addr}"
      end
      (i << 8) | n
    end
  end

  # Ruby's message shows @addr, which is still nil at this point ("invalid address: ").
  def in6_addr(left, src)
    if (m = String.match(left, ipv6_full_re))
      if (pre = m[1])
        addr = octets(Array[m[2] || "", m[3] || "", m[4] || "", m[5] || ""], src)
        left = pre + ":"
      else
        addr = 0
      end
      right = ""
    elsif (m = String.match(left, ipv6_compressed_re))
      l1 = m[1] || ""
      if m[4]
        raise IPAddrInvalidAddressError, "invalid address: " unless String.count(left, ":") <= 6
        addr = octets(Array[m[4] || "", m[5] || "", m[6] || "", m[7] || ""], src)
        left = l1
        right = (m[3] || "") + "0:0"
      else
        r2 = m[2] || ""
        limit = l1 == "" || r2 == "" ? 8 : 7
        raise IPAddrInvalidAddressError, "invalid address: " unless String.count(left, ":") <= limit
        left = l1
        right = r2
        addr = 0
      end
    else
      raise IPAddrInvalidAddressError, "invalid address: "
    end
    l = String.split(left, ":")
    r = String.split(right, ":")
    rest = 8 - Array.size(l) - Array.size(r)
    return nil if rest < 0
    Array.reduce(l + Array.new(rest, "0") + r, 0) { |i, s| (i << 16) | String.hex(s) } | addr
  end

  # ---- internal setters (Ruby's protected set / mask!) ----

  def set!(ip, addr, family = @family)
    if family == Socket.AF_INET
      raise IPAddrInvalidAddressError, "invalid address: #{addr}" if addr < 0 || addr > in4mask
    elsif family == Socket.AF_INET6
      raise IPAddrInvalidAddressError, "invalid address: #{addr}" if addr < 0 || addr > in6mask
    else
      raise IPAddrAddressFamilyError, "unsupported address family"
    end
    @addr = addr
    if family != @family
      @family = family
      @mask_addr = @mask_addr & in4mask if family == Socket.AF_INET
    end
    ip
  end

  def mask!(ip, mask)
    if mask in String
      if String.match?(mask, /\A(0|[1-9]+\d*)\z/)
        prefixlen = String.to_i(mask)
      elsif String.match?(mask, /\A\d+\z/)
        raise IPAddrInvalidPrefixError, "leading zeros in prefix"
      else
        m = IPAddr.new(mask)
        raise IPAddrInvalidPrefixError, "address family is not same" if IPAddr.family(m) != @family
        @mask_addr = to_i(m)
        n = @mask_addr ^ IPAddr.raw_mask(m)
        raise IPAddrInvalidPrefixError, "invalid mask #{mask}" unless ((n + 1) & n) == 0
        @addr = @addr & @mask_addr
        return ip
      end
    else
      mask => Integer
      prefixlen = mask
    end
    bits = @family == Socket.AF_INET ? 32 : 128
    raise IPAddrInvalidPrefixError, "invalid length" if prefixlen < 0 || prefixlen > bits
    masklen = bits - prefixlen
    @mask_addr = ((full_mask(ip) >> masklen) << masklen)
    @addr = ((@addr >> masklen) << masklen)
    ip
  end

  def raw_mask(ip) = @mask_addr
  def full_mask(ip) = @family == Socket.AF_INET ? in4mask : in6mask
  def addr_mask(ip, a) = a & full_mask(ip)
  def copy_with(ip, addr, family = @family) = set!(Kernel.dup(ip), addr, family)

  # Ruby's coerce_other: an IPAddr, a String to parse, or an Integer in this family.
  def coerce(ip, other)
    case other
    in IPAddr then other
    in String then IPAddr.new(other)
    in Integer then IPAddr.new(other, @family)
    end
  end

  def begin_addr(ip) = @addr & @mask_addr
  def end_addr(ip) = @addr | (full_mask(ip) ^ @mask_addr)

  # ---- class methods ----

  def new_ntoh(addr) = IPAddr.new(ntop(addr))

  def ntop(addr)
    if String.encoding(addr) != "ASCII-8BIT"
      raise IPAddrInvalidAddressError, "invalid encoding (given #{String.encoding(addr)}, expected BINARY)"
    end
    case String.bytesize(addr)
    in 4 then Array.join(String.unpack(addr, "C4"), ".")
    in 16 then format("%.4x:%.4x:%.4x:%.4x:%.4x:%.4x:%.4x:%.4x", *String.unpack(addr, "n8"))
    in Integer then raise IPAddrAddressFamilyError, "unsupported address family"
    end
  end

  # ---- operators ----

  def &(a, b) = copy_with(a, @addr & to_i(coerce(a, b)))
  def |(a, b) = copy_with(a, @addr | to_i(coerce(a, b)))
  def >>(a, n) = copy_with(a, @addr >> n)
  def <<(a, n) = copy_with(a, addr_mask(a, @addr << n))
  def ~(a) = copy_with(a, addr_mask(a, ~@addr))
  def +(a, n) = copy_with(a, @addr + n)
  def -(a, n) = copy_with(a, @addr - n)

  # Ruby compares the family and the address (not the mask); a String is parsed, a bad one is unequal.
  # nil is unequal (Ruby takes it as 0.0.0.0, so that `ip == nil` holds for it).
  def ==(a, b)
    return false if (b in nil)
    o = begin
      coerce(a, b)
    rescue IPAddrInvalidAddressError, IPAddrAddressFamilyError, IPAddrInvalidPrefixError
      nil
    end
    (o in IPAddr) && @family == IPAddr.family(o) && @addr == to_i(o)
  end

  def <=>(a, b)
    return nil if (b in nil)
    o = begin
      coerce(a, b)
    rescue IPAddrInvalidAddressError, IPAddrAddressFamilyError, IPAddrInvalidPrefixError
      nil
    end
    return nil unless (o in IPAddr) && IPAddr.family(o) == @family
    @addr <=> to_i(o)
  end

  def include?(ip, other)
    o = coerce(ip, other)
    return false unless IPAddr.family(o) == @family
    begin_addr(ip) <= begin_addr(o) && end_addr(ip) >= end_addr(o)
  end

  def ===(ip, other) = include?(ip, other)

  def mask(ip, prefixlen) = mask!(Kernel.dup(ip), prefixlen)

  # ---- conversions ----

  def to_i(ip) = @addr

  def to_s(ip)
    str = to_string(ip)
    return str if ipv4?(ip)
    str = String.gsub(str, /\b0{1,3}([\da-f]+)\b/i, "\\1")
    Array.each_with_index(zero_runs) do |re, i|
      if String.match?(str, re)
        str = String.sub(str, re, i == 0 ? "::" : ":")
        break
      end
    end
    str = String.sub(str, /:{3,}/, "::")
    if (m = String.match(str, /\A::(ffff:)?([\da-f]{1,4}):([\da-f]{1,4})\z/i))
      a = String.hex(m[2] || "")
      b = String.hex(m[3] || "")
      str = format("::%s%d.%d.%d.%d", m[1] || "", a / 256, a % 256, b / 256, b % 256)
    end
    str
  end

  # Ruby's to_s: the longest run of zero groups becomes "::".
  def zero_runs = once do
    Array[/\A0:0:0:0:0:0:0:0\z/, /\b0:0:0:0:0:0:0\b/, /\b0:0:0:0:0:0\b/, /\b0:0:0:0:0\b/,
          /\b0:0:0:0\b/, /\b0:0:0\b/, /\b0:0\b/]
  end

  def to_string(ip)
    str = to_string_of(ip, @addr)
    @family == Socket.AF_INET6 ? str + (@zone_id_ || "") : str
  end

  def to_string_of(ip, a)
    if @family == Socket.AF_INET
      Range.map(0..3) { |i| (a >> (24 - 8 * i)) & 0xff }.Array.join(".")
    else
      String.gsub(format("%.32x", a), /.{4}(?!$)/) { |m| m + ":" }
    end
  end

  def cidr(ip) = "#{to_s(ip)}/#{prefix(ip)}"

  def as_json(ip)
    (ipv4?(ip) && prefix(ip) == 32) || (ipv6?(ip) && prefix(ip) == 128) ? to_s(ip) : cidr(ip)
  end

  def to_json(ip) = "\"#{as_json(ip)}\""

  def hton(ip)
    if @family == Socket.AF_INET
      Array.pack(Array[@addr], "N")
    else
      Array.pack(Range.map(0..7) { |i| (@addr >> (112 - 16 * i)) & 0xffff }, "n8")
    end
  end

  def inspect(ip)
    af = @family == Socket.AF_INET ? "IPv4" : "IPv6"
    zone = @family == Socket.AF_INET6 ? @zone_id_ || "" : ""
    format("#<IPAddr: %s:%s%s/%s>", af, to_string_of(ip, @addr), zone, to_string_of(ip, @mask_addr))
  end

  def netmask(ip) = to_string_of(ip, @mask_addr)
  def wildcard_mask(ip) = to_string_of(ip, full_mask(ip) ^ @mask_addr)

  # Ruby's to_range is a Range of IPAddr; Sake's Ranges hold numbers and Strings, so this is
  # [first, last] (a Tuple of IPAddr).
  def to_range(ip) = [IPAddr.new(begin_addr(ip), @family), IPAddr.new(end_addr(ip), @family)]

  def prefix(ip)
    n = full_mask(ip) ^ @mask_addr
    i = @family == Socket.AF_INET ? 32 : 128
    while n > 0
      n >>= 1
      i -= 1
    end
    i
  end

  # Ruby's ip.prefix = n, written ip.IPAddr.prefix = n.
  def prefix=(ip, n)
    raise IPAddrInvalidPrefixError, "prefix must be an integer" unless n in Integer
    mask!(ip, n)
  end

  # ---- predicates ----

  def ipv4?(ip) = @family == Socket.AF_INET
  def ipv6?(ip) = @family == Socket.AF_INET6

  def loopback?(ip)
    if @family == Socket.AF_INET
      @addr & 0xff000000 == 0x7f000000
    else
      @addr == 1 || (mapped_bits?(ip) && @addr & 0xff000000 == 0x7f000000)
    end
  end

  def private?(ip)
    if @family == Socket.AF_INET
      private4?(@addr)
    else
      @addr & 0xfe00_0000_0000_0000_0000_0000_0000_0000 == 0xfc00_0000_0000_0000_0000_0000_0000_0000 ||
        (mapped_bits?(ip) && private4?(@addr))
    end
  end

  def private4?(a) = a & 0xff000000 == 0x0a000000 || a & 0xfff00000 == 0xac100000 || a & 0xffff0000 == 0xc0a80000

  def link_local?(ip)
    if @family == Socket.AF_INET
      @addr & 0xffff0000 == 0xa9fe0000
    else
      @addr & 0xffc0_0000_0000_0000_0000_0000_0000_0000 == 0xfe80_0000_0000_0000_0000_0000_0000_0000 ||
        (mapped_bits?(ip) && @addr & 0xffff0000 == 0xa9fe0000)
    end
  end

  def mapped_bits?(ip) = @addr & 0xffff_0000_0000 == 0xffff_0000_0000

  def ipv4_mapped?(ip) = ipv6?(ip) && (@addr >> 32) == 0xffff

  def ipv4_compat?(ip)
    return false if !ipv6?(ip) || (@addr >> 32) != 0
    a = @addr & in4mask
    a != 0 && a != 1
  end

  # ---- conversions between families ----

  def ipv4_mapped(ip)
    raise IPAddrInvalidAddressError, "not an IPv4 address: #{@addr}" unless ipv4?(ip)
    c = copy_with(ip, @addr | 0xffff00000000, Socket.AF_INET6)
    widen_mask!(c, @mask_addr)
  end

  def ipv4_compat(ip)
    raise IPAddrInvalidAddressError, "not an IPv4 address: #{@addr}" unless ipv4?(ip)
    c = copy_with(ip, @addr, Socket.AF_INET6)
    widen_mask!(c, @mask_addr)
  end

  def widen_mask!(ip, m)
    @mask_addr = m | 0xffffffffffffffffffffffff00000000
    ip
  end

  def native(ip)
    return ip if !ipv4_mapped?(ip) && !ipv4_compat?(ip)
    copy_with(ip, @addr & in4mask, Socket.AF_INET)
  end

  def reverse(ip)
    @family == Socket.AF_INET ? reverse_of(ip) + ".in-addr.arpa" : ip6_arpa(ip)
  end

  def ip6_arpa(ip)
    raise IPAddrInvalidAddressError, "not an IPv6 address: #{@addr}" unless ipv6?(ip)
    reverse_of(ip) + ".ip6.arpa"
  end

  def ip6_int(ip)
    raise IPAddrInvalidAddressError, "not an IPv6 address: #{@addr}" unless ipv6?(ip)
    reverse_of(ip) + ".ip6.int"
  end

  def reverse_of(ip)
    if @family == Socket.AF_INET
      Range.map(0..3) { |i| (@addr >> (8 * i)) & 0xff }.Array.join(".")
    else
      String.chars(String.reverse(format("%.32x", @addr))).Array.join(".")
    end
  end

  def succ(ip) = copy_with(ip, @addr + 1)

  # ---- zone id ----

  def zone_id(ip)
    raise IPAddrInvalidAddressError, "not an IPv6 address" unless ipv6?(ip)
    @zone_id_
  end

  def zone_id=(ip, zid)
    raise IPAddrInvalidAddressError, "not an IPv6 address" unless ipv6?(ip)
    unless zid == nil || ((zid in String) && String.match?(zid, /\A%(\w+)\z/))
      raise IPAddrInvalidAddressError, "invalid zone identifier for address"
    end
    @zone_id_ = zid
  end
end
