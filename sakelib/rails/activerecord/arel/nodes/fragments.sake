# Port of activerecord-8.1.3/lib/arel/nodes/fragments.rb (partial: no hash/eql?)

module Arel
  module Nodes
    class Fragments
      attr_reader values
      include Node
      include Arithmetic
      def +(o, other)
        raise ArgumentError, "Expected Arel node" unless Arel.arel_node?(other)
        Fragments.new(Any[*@values, other])
      end
    end
  end
end
