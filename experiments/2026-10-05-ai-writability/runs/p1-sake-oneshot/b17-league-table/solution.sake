Team = Struct.new(:name, :played, :w, :d, :l, :gf, :ga, :h2h)

class Team
  def pts(t) = @w * 3 + @d
  def gd(t) = @gf - @ga
  def key3(t) = [@w * 3 + @d, @gf - @ga, @gf]
  def rank4(t) = [@w * 3 + @d, @gf - @ga, @gf, @h2h]
  def record(t, gf, ga)
    @played += 1
    @gf += gf
    @ga += ga
    if gf > ga
      @w += 1
    elsif gf == ga
      @d += 1
    else
      @l += 1
    end
  end
  def add_h2h(t, points)
    @h2h += points
  end
end

def valid_name?(s) = String.match?(s, /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/)

def team_of(tab, name)
  t = tab[name]
  return t if t
  t = Team.new(name, 0, 0, 0, 0, 0, 0, 0)
  tab[name] = t
  t
end

def points(a, b)
  return 3 if a > b
  return 1 if a == b
  0
end

def solve_main
  lines = IO.readlines(IO.stdin)
  tab = Hash[]
  matches = Tuple[]
  n = 0
  Array.each(lines) do |raw|
    n += 1
    line = String.chomp(raw)
    s = String.strip(line)
    next if String.empty?(s)
    toks = String.split(s, /\s+/)
    ok = false
    if Array.size(toks) == 3
      home, score, away = toks
      if valid_name?(home) && valid_name?(away) && home != away && String.match?(score, /\A(\d{1,2}-\d{1,2}|P-P)\z/)
        ok = true
        th = team_of(tab, home)
        ta = team_of(tab, away)
        if score != "P-P"
          parts = String.split(score, "-")
          hg, ag = Array.map(parts) { String.to_i(it) }
          Team.record(th, hg, ag)
          Team.record(ta, ag, hg)
          Array.push(matches, [home, away, hg, ag])
        end
      end
    end
    puts("invalid line #{n}: #{line}") unless ok
  end
  teams = Hash.values(tab)
  if Array.empty?(teams)
    puts("no teams")
    return
  end
  Array.each(matches) do |home, away, hg, ag|
    th = tab[home]
    ta = tab[away]
    if Team.key3(th) == Team.key3(ta)
      Team.add_h2h(th, points(hg, ag))
      Team.add_h2h(ta, points(ag, hg))
    end
  end
  sorted = Array.sort_by(teams) { |x| [-Team.pts(x), -Team.gd(x), -Team.gf(x), -Team.h2h(x), Team.name(x)] }
  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
  Array.each(sorted) do |x|
    r = Team.rank4(x)
    pos = 1 + Array.count(teams) { |u| Team.rank4(u) > r }
    gdv = Team.gd(x)
    gds = gdv > 0 ? "+#{gdv}" : "#{gdv}"
    puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", pos, Team.name(x), Team.played(x), Team.w(x), Team.d(x), Team.l(x), Team.gf(x), Team.ga(x), gds, Team.pts(x)))
  end
end

solve_main
