# Port of activesupport-8.1.3/lib/active_support/string_inquirer.rb and core_ext/string/inquiry.rb (two small files)
#
# Ruby: `env.production?` reaches method_missing, which compares the String with the name less its "?". Here
# its body is `StringInquirer.inquire(env, :production?)` (the name `method_missing` is rejected in Sake), and
# `generate "rails/activesupport/active_support/generate/inquirers", "production", ...` writes
# `StringInquirer.production?(env)` for each name the program uses (generate/inquirers.sake).

require "as_json"

module ActiveSupport
  class StringInquirer
    attr_reader str
    include AsJson

    def inquire(si, method_name)
      name = Symbol.to_s(method_name)
      raise NoMethodError, "undefined method '#{name}' for an instance of ActiveSupport::StringInquirer" unless String.end_with?(name, "?")
      @str == String.delete_suffix(name, "?")
    end

    def respond_to_missing?(si, method_name) = Symbol.end_with?(method_name, "?")
    def to_s(si) = @str
    def as_json(si, options = nil) = @str
    def to_str(si) = @str
    def inspect(si) = Kernel.inspect(@str)
    def ==(si, other) = (other in String) ? @str == other : (other in StringInquirer) && @str == StringInquirer.str(other)
  end

  # Ruby's NoMethodError, which Sake does not have as a built-in.
  class NoMethodError < StandardError
  end
end

class String
  def inquiry(s) = ActiveSupport::StringInquirer.new(s)
end
