# Port of actionview-8.1.3/lib/action_view/helpers/javascript_helper.rb (partial: no auto_include_nonce / nonce: true (the nonce comes from the controller's content_security_policy_nonce))

require "tag_helper"

module ActionView
  module Helpers
    module JavaScriptHelper
      include TagHelper

      def escape_javascript(v, javascript)
        js = Object.html_text(javascript)
        result = String.empty?(js) ? "" : String.gsub(js, /(\\|<\/|\r\n| | |[\n\r"']|[`]|[$])/, JavaScriptHelper.js_escape_map)
        Object.html_safe?(javascript) ? String.html_safe(result) : result
      end

      def j(v, javascript) = escape_javascript(v, javascript)

      # Ruby: javascript_tag(content_or_options_with_block = nil, html_options = {}, &block)
      def javascript_tag(v, content_or_options_with_block = nil, html_options = nil, **options)
        html_options = options if html_options == nil
        content = if block_given?
                    html_options = content_or_options_with_block if content_or_options_with_block in Hash
                    capture(v) { yield }
                  else
                    content_or_options_with_block
                  end
        opts = Hash.dup(html_options)
        Hash.delete(opts, :nonce) if opts[:nonce] == false
        content_tag(v, "script", javascript_cdata_section(v, content), opts)
      end

      def javascript_cdata_section(v, content) = String.html_safe("\n//#{Object.html_text(cdata_section(v, "\n#{Object.html_text(content)}\n//"))}\n")

      module_function

      def js_escape_map = once do
        Hash.of("\\" => "\\\\", "</" => "<\\/", "\r\n" => "\\n", "\n" => "\\n", "\r" => "\\n", "\"" => "\\\"", "'" => "\\'",
                "`" => "\\`", "$" => "\\$", " " => "&#x2028;", " " => "&#x2029;")
      end
    end
  end
end
