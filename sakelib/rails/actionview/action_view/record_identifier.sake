# Port of actionview-8.1.3/lib/action_view/record_identifier.rb (partial: no Class arguments: a Class is not a value in Sake; pass a new record)
#
# Rails' RecordIdentifier is `extend self` and included by views and controllers; here a mixin of the view
# (`dom_id(view, post)`), and `RecordIdentifier.dom_id(view, post)` dispatches to it.

require "model_naming"

module ActionView
  module RecordIdentifier
    def dom_class(v, record_or_class, prefix = nil)
      singular = ModelNaming::Model.param_key(ModelNaming.convert_to_model(record_or_class))
      prefix ? "#{prefix}_#{singular}" : singular
    end

    def dom_id(v, record_or_class, prefix = nil)
      raise ArgumentError, "dom_id must be passed a record_or_class as the first argument, you passed #{Kernel.inspect(record_or_class)}" unless record_or_class
      record_id = RecordIdentifier.record_key_for_dom_id(record_or_class)
      if record_id
        "#{dom_class(v, record_or_class, prefix)}_#{record_id}"
      else
        dom_class(v, record_or_class, prefix || "new")
      end
    end

    def dom_target(v, *objects)
      parts = Array.map(objects) do |object|
        case object
        in Symbol | String then Kernel.to_s(object)
        else dom_id(v, object)
        end
      end
      Array.join(parts, "_")
    end

    module_function

    # private
    def record_key_for_dom_id(record)
      key = ModelNaming::Model.to_key(ModelNaming.convert_to_model(record))
      key && Array.all?(key) { |k| k != nil && k != false } ? Array.join(key, "_") : nil
    end
  end
end
