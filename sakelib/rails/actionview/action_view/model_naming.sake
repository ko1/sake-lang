# Port of actionview-8.1.3/lib/action_view/model_naming.rb
#
# Rails reads a record through ActiveModel's interface: to_model, model_name (param_key, route_key,
# singular_route_key, human), to_key, to_param, persisted?, to_partial_path, errors, and its attribute readers
# (public_send). ModelNaming::Model (Sake only) lists what ActionView calls, as functions a record type defines;
# ActiveModel's Conversion/Naming give them (an ActiveModel type includes this module). The routes' part
# (route_key, singular_route_key, persisted?, to_param) is ActionDispatch's PolymorphicRoutes::Model and ToParam.

require "../../actionpack/action_dispatch/routing/polymorphic_routes"
require "../../activesupport/active_support/inflector"

module ActionView
  module ModelNaming
    module Model
      include ActionDispatch::Routing::PolymorphicRoutes::Model
      include ActionDispatch::Routing::ToParam

      # Ruby: record.to_key (Array of the key's values, nil for a new record)
      def to_key(r) = raise(NotImplementedError)
      # Ruby: record.model_name.param_key ("post", "admin_post")
      def param_key(r) = raise(NotImplementedError)
      # Ruby: record.public_send(name), name a String (ActiveModel's read_attribute_for_validation is `send`)
      def read_attribute_for_validation(r, name) = raise(NotImplementedError)
      # Ruby: record.to_partial_path (ActiveModel::Conversion: "posts/post")
      def to_partial_path(r) = "#{route_key(r)}/#{singular_route_key(r)}"
      # Ruby: record.model_name.human ("Post")
      def model_name_human(r) = ActiveSupport::Inflector.humanize(param_key(r))
      # Ruby: record.class.human_attribute_name(attribute) (ActiveModel::Translation without I18n: humanize)
      def human_attribute_name(r, attribute) = ActiveSupport::Inflector.humanize(Kernel.to_s(attribute))
      # Ruby: record.errors[attribute] (the messages); a type without errors has none
      def errors_for(r, attribute) = String[]
    end

    module_function

    # Ruby: object.respond_to?(:to_model) ? object.to_model : object
    def convert_to_model(object) = object
  end
end
