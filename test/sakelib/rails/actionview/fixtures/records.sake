# Model-like records for the actionview tests: what ActiveModel::Model gives (naming, conversion, persisted?, errors)
require "rails/actionview/action_view/model_naming"

class Post
  attr_reader id, title, body
  attr_accessor errors
  include ActionView::ModelNaming::Model
  def initialize(r)
    @errors = Hash.new if @errors == nil
  end
  def route_key(r) = "posts"
  def singular_route_key(r) = "post"
  def param_key(r) = "post"
  def persisted?(r) = @id != nil
  def to_param(r) = persisted?(r) ? Kernel.to_s(@id) : nil
  def to_key(r) = persisted?(r) ? Any[@id] : nil
  def to_s(r) = "Post #{@id}"
  def read_attribute_for_validation(r, name)
    case Kernel.to_s(name)
    in "id" then @id
    in "title" then @title
    in "body" then @body
    else nil
    end
  end
  def errors_for(r, attribute) = @errors[attribute] || String[]
end

class Comment
  attr_reader id, post_id, body
  include ActionView::ModelNaming::Model
  def route_key(r) = "comments"
  def singular_route_key(r) = "comment"
  def param_key(r) = "comment"
  def persisted?(r) = @id != nil
  def to_param(r) = persisted?(r) ? Kernel.to_s(@id) : nil
  def to_key(r) = persisted?(r) ? Any[@id] : nil
  def read_attribute_for_validation(r, name)
    case Kernel.to_s(name)
    in "id" then @id
    in "post_id" then @post_id
    in "body" then @body
    else nil
    end
  end
end
