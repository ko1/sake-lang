module Sql
  module Functions
    class Spec
      attr_reader min: Integer
      attr_reader max: Integer?

      def initialize: (Integer min, Integer? max) -> void
      def accepts?: (Integer count) -> bool
    end

    SPECS: Hash[String, Spec]

    def self.lookup: (String name) -> Spec?
    def self.call: (String name, Array[value] args) -> value
    def self.non_null: (String function, Array[Integer | Float | String] args) -> value
    def self.concat_ws: (value sep, Array[value] items) -> String?
    def self.unicode: (String text) -> Integer?
    def self.sign: (Integer | Float | String arg) -> Integer?
    def self.absolute: (Integer | Float | String arg) -> number
    def self.integer: (Integer | Float | String arg) -> Integer
    def self.substr: (String text, Integer start, Integer? len) -> String
    def self.trim: (String which, String text, String chars) -> String
    def self.replace: (String text, String from, String to) -> String
    def self.round: (Integer | Float | String arg, Integer digits) -> Float
    def self.extreme: (Array[Integer | Float | String] args, Integer direction) -> (Integer | Float | String)
  end
end
