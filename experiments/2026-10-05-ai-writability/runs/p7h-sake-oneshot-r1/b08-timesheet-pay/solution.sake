def valid_emp_id?(s)
  String.match?(s, /^E[0-9]{3}$/)
end

def valid_name?(s)
  String.size(s) >= 1 && String.size(s) <= 10 && String.match?(s, /^[A-Za-z]+$/)
end

def valid_money?(s)
  String.match?(s, /^[0-9]+\.[0-9]{2}$/)
end

def valid_date?(s)
  parts = String.split(s, "-")
  if Array.size(parts) != 3
    false
  else
    year_str = Array.at(parts, 0)
    month_str = Array.at(parts, 1)
    day_str = Array.at(parts, 2)

    if !String.match?(year_str, /^[0-9]{4}$/) || !String.match?(month_str, /^[0-9]{2}$/) || !String.match?(day_str, /^[0-9]{2}$/)
      false
    else
      year = String.to_i(year_str)
      month = String.to_i(month_str)
      day = String.to_i(day_str)

      if year < 1970 || year > 2099 || month < 1 || month > 12 || day < 1 || day > 31
        false
      else
        true
      end
    end
  end
end

def valid_time?(s)
  parts = String.split(s, ":")
  if Array.size(parts) != 2
    false
  else
    hour_str = Array.at(parts, 0)
    min_str = Array.at(parts, 1)

    if !String.match?(hour_str, /^[0-9]{2}$/) || !String.match?(min_str, /^[0-9]{2}$/)
      false
    else
      hour = String.to_i(hour_str)
      min = String.to_i(min_str)
      hour >= 0 && hour <= 23 && min >= 0 && min <= 59
    end
  end
end

def date_to_day_of_week(year, month, day)
  y = year
  m = month
  if m < 3
    m += 12
    y -= 1
  end

  k = y % 100
  j = y / 100
  h = (day + Integer((13 * (m + 1)) / 5) + k + Integer(k / 4) + Integer(j / 4) - 2 * j) % 7

  dow = (h + 6) % 7
  dow
end

def is_monday(year, month, day)
  date_to_day_of_week(year, month, day) == 1
end

def next_sunday(year, month, day)
  y = year
  m = month
  d = day

  loop do
    if date_to_day_of_week(y, m, d) == 0
      [y, m, d]
    else
      d += 1
      if d > 31
        d = 1
        m += 1
        if m > 12
          m = 1
          y += 1
        end
      end
    end
  end
end

employees = Hash[]
shifts = Array[]
line_no = 0

loop do
  line = gets
  break if line == nil
  line_no += 1

  if String.empty?(String.strip(line))
    next
  end

  parts = String.split(String.strip(line), /\s+/)
  if Array.size(parts) < 1
    next
  end

  cmd = Array.at(parts, 0)

  case cmd
  in "EMP"
    if Array.size(parts) != 4
      puts("line #{line_no}: error: wrong field count")
    else
      id = Array.at(parts, 1)
      name = Array.at(parts, 2)
      rate_str = Array.at(parts, 3)

      if !valid_emp_id?(id)
        puts("line #{line_no}: error: bad id")
      elsif !valid_name?(name)
        puts("line #{line_no}: error: bad name")
      elsif !valid_money?(rate_str)
        puts("line #{line_no}: error: bad rate")
      elsif Hash.key?(employees, id)
        puts("line #{line_no}: error: duplicate employee ID")
      else
        employees[id] = {name: name, rate: Float(rate_str), shifts: Array[]}
      end
    end
  in "SHIFT"
    if Array.size(parts) < 5 || Array.size(parts) > 6
      puts("line #{line_no}: error: wrong field count")
    else
      id = Array.at(parts, 1)
      date = Array.at(parts, 2)
      start_str = Array.at(parts, 3)
      end_str = Array.at(parts, 4)
      break_str = if Array.size(parts) == 6 then Array.at(parts, 5) else "0" end

      if !valid_emp_id?(id)
        puts("line #{line_no}: error: bad id")
      elsif !Hash.key?(employees, id)
        puts("line #{line_no}: error: unknown employee ID")
      elsif !valid_date?(date)
        puts("line #{line_no}: error: bad date")
      elsif !valid_time?(start_str)
        puts("line #{line_no}: error: bad time")
      elsif !valid_time?(end_str)
        puts("line #{line_no}: error: bad time")
      elsif !String.match?(break_str, /^[0-9]+$/)
        puts("line #{line_no}: error: bad break")
      else
        shift = {emp_id: id, date: date, start: start_str, end: end_str, break: String.to_i(break_str)}
        Array.push(shifts, shift)
      end
    end
  else
    puts("line #{line_no}: error: unknown command")
  end
end

def format_time(minutes)
  hours = minutes / 60
  mins = minutes % 60
  format("%d:%02d", hours, mins)
end

sorted_emps = Array.sort(Hash.keys(employees))

puts(format("%-4s %-10s %8s %8s %10s", "id", "name", "regular", "overtime", "pay"))

total_regular = 0
total_overtime = 0
total_pay = 0.0

Array.each(sorted_emps) do |emp_id|
  emp = employees[emp_id]
  puts(format("%-4s %-10s %8s %8s %10s", emp_id, emp[:name], format_time(0), format_time(0), format("%.2f", 0.0)))
end

puts(format("%-4s %-10s %8s %8s %10s", "", "total", format_time(total_regular), format_time(total_overtime), format("%.2f", total_pay)))
