module Sql
  module Aggregates
    NAMES: Array[String]

    def self.aggregate?: (String function, Integer argc) -> bool
    def self.accepts?: (String function, Integer argc, bool star) -> bool
    def self.compute: (Ast::Aggregate call, Array[Array[value]] rows) -> value
    def self.picks_row?: (Ast::Aggregate call) -> bool
    def self.extreme_row: (Ast::Aggregate call, Array[Array[value]] rows) -> Array[value]
    def self.ordered_rows: (Ast::Aggregate call, Array[Array[value]] rows) -> Array[Array[value]]
    def self.argument_values: (Ast::Expr arg, Array[Array[value]] rows) -> Array[present]
    def self.distinct_values: (Ast::Aggregate call, Array[present] values) -> Array[present]
    def self.fold: (String function, Array[present] values) -> value
    def self.group_concat: (Ast::Aggregate call, Array[Array[value]] rows) -> String?
    def self.integer_value: (present value) -> Integer?
    def self.sum: (Array[present] values) -> (Integer | Float)
    def self.real_sum: (Array[present] values) -> Float
  end
end
