# Port of activemodel-8.1.3/lib/active_model/conversion.rb
#
# Ruby's `respond_to?(:id) && id` is the generated `__id` (nil for a class without an id); the class attribute
# param_delimiter is a function the class may define (default "-"); _to_partial_path is the class's.

require "naming"

module ActiveModel
  module Conversion
    def __id(r) = nil
    def param_delimiter = "-"

    def to_model(r) = r

    def to_key(r)
      key = __id(r)
      key ? Array.wrap(key) : nil
    end

    def to_param(r)
      return nil unless persisted?(r)
      key = to_key(r)
      return nil if key == nil || !Array.all?(key) { |k| k }
      Array.join(key, param_delimiter)
    end

    def to_partial_path(r) = _to_partial_path

    # Ruby's ClassMethods#_to_partial_path: "people/person"
    def _to_partial_path
      n = model_name
      "#{ActiveModel::Name.collection(n)}/#{ActiveModel::Name.element(n)}"
    end
  end
end
