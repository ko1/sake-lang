Booking = Struct.new(:id, :room, :day, :start_minutes, :end_minutes, :who)

DAYS = Array["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
DAY_INDEX = Hash["Mon" => 0, "Tue" => 1, "Wed" => 2, "Thu" => 3, "Fri" => 4, "Sat" => 5, "Sun" => 6]

def validate_room(room)
  if String.size(room) < 1 || String.size(room) > 8
    return false
  end
  String.match?(room, /^[A-Z0-9]+$/)
end

def validate_day(day)
  Array.include?(DAYS, day)
end

def time_to_minutes(time_str)
  if !String.match?(time_str, /^\d{2}:\d{2}$/)
    return nil
  end
  parts = String.split(time_str, ":")
  h = String.to_i(Array.at(parts, 0))
  m = String.to_i(Array.at(parts, 1))

  if h < 0 || h > 23 || m < 0 || m > 59
    return nil
  end

  h * 60 + m
end

def minutes_to_time(mins)
  h = mins / 60
  m = mins % 60
  format("%02d:%02d", h, m)
end

def validate_time_slot(start_str, end_str)
  start_mins = time_to_minutes(start_str)
  return false unless start_mins

  end_mins = time_to_minutes(end_str)
  return false unless end_mins

  if start_mins < 8 * 60 || start_mins > 20 * 60
    return false
  end

  if end_mins < 8 * 60 || end_mins > 20 * 60
    return false
  end

  if start_mins % 15 != 0 || end_mins % 15 != 0
    return false
  end

  if start_mins >= end_mins
    return false
  end

  [start_mins, end_mins]
end

def validate_who(who)
  if String.size(who) < 1 || String.size(who) > 12
    return false
  end
  String.match?(who, /^[a-z]+$/)
end

def validate_id(id_str)
  String.match?(id_str, /^\d+$/)
end

def validate_duration(dur_str)
  if !String.match?(dur_str, /^\d+$/)
    return false
  end
  dur = String.to_i(dur_str)
  dur > 0 && dur % 15 == 0
end

def find_conflict(bookings, room, day, start_mins, end_mins)
  # Find earliest conflicting booking
  earliest = nil
  Array.each(bookings) do |b|
    if Booking.room(b) == room && Booking.day(b) == day
      b_start = Booking.start_minutes(b)
      b_end = Booking.end_minutes(b)
      # Overlap check (touching is OK)
      if start_mins < b_end && end_mins > b_start
        if earliest == nil || b_start < Booking.start_minutes(earliest)
          earliest = b
        end
      end
    end
  end
  earliest
end

def count_bookings_for_person(bookings, who, day)
  count = 0
  Array.each(bookings) do |b|
    if Booking.who(b) == who && Booking.day(b) == day
      count += 1
    end
  end
  count
end

def find_free_slot(bookings, room, day, duration_mins)
  # Find earliest start time from 08:00 where room is free for duration_mins
  current_mins = 8 * 60
  end_time = 20 * 60

  while current_mins + duration_mins <= end_time
    # Check if this slot is free
    is_free = true
    Array.each(bookings) do |b|
      if Booking.room(b) == room && Booking.day(b) == day
        b_start = Booking.start_minutes(b)
        b_end = Booking.end_minutes(b)
        slot_end = current_mins + duration_mins
        if current_mins < b_end && slot_end > b_start
          is_free = false
        end
      end
    end

    if is_free
      return [current_mins, current_mins + duration_mins]
    end

    current_mins += 15
  end

  nil
end

bookings = Array[]
next_id = 1
line_num = 0

Kernel.loop do
  line = Kernel.gets
  line_num += 1

  unless line
    break
  end

  line = String.chomp(line)

  if String.empty?(line) || String.empty?(String.strip(line))
    next
  end

  fields = String.split(line, /\s+/)

  if Array.empty?(fields)
    next
  end

  cmd = Array.at(fields, 0)

  if cmd == "BOOK"
    if Array.size(fields) != 6
      puts("line #{line_num}: error: wrong field count")
      next
    end

    room = Array.at(fields, 1)
    day = Array.at(fields, 2)
    time_slot = Array.at(fields, 3)
    who = Array.at(fields, 4)

    unless validate_room(room)
      puts("line #{line_num}: error: bad room")
      next
    end

    unless validate_day(day)
      puts("line #{line_num}: error: bad day")
      next
    end

    time_parts = String.split(time_slot, "-")
    if Array.size(time_parts) != 2
      puts("line #{line_num}: error: bad time")
      next
    end

    start_str = Array.at(time_parts, 0)
    end_str = Array.at(time_parts, 1)

    slot_times = validate_time_slot(start_str, end_str)
    unless slot_times
      puts("line #{line_num}: error: bad time")
      next
    end

    start_mins, end_mins = slot_times

    unless validate_who(who)
      puts("line #{line_num}: error: bad name")
      next
    end

    # Check for conflicts
    conflict = find_conflict(bookings, room, day, start_mins, end_mins)
    if conflict
      conf_start = minutes_to_time(Booking.start_minutes(conflict))
      conf_end = minutes_to_time(Booking.end_minutes(conflict))
      conf_who = Booking.who(conflict)
      conf_id = Booking.id(conflict)
      puts("CONFLICT #{room} #{day} with ##{conf_id} (#{conf_who} #{conf_start}-#{conf_end})")
      next
    end

    # Check person's booking limit for this day
    if count_bookings_for_person(bookings, who, day) >= 3
      puts("LIMIT #{who} #{day}")
      next
    end

    # Create booking
    booking = Booking.new(next_id, room, day, start_mins, end_mins, who)
    Array.push(bookings, booking)
    puts("OK ##{next_id} #{room} #{day} #{start_str}-#{end_str} #{who}")
    next_id += 1

  elsif cmd == "CANCEL"
    if Array.size(fields) != 2
      puts("line #{line_num}: error: wrong field count")
      next
    end

    id_str = Array.at(fields, 1)

    unless validate_id(id_str)
      puts("line #{line_num}: error: bad id")
      next
    end

    cancel_id = String.to_i(id_str)

    # Find and remove booking
    found = false
    Array.each_with_index(bookings) do |b, idx|
      if Booking.id(b) == cancel_id
        Array.delete_at(bookings, idx)
        found = true
      end
    end

    if found
      puts("CANCELLED ##{cancel_id}")
    else
      puts("NO BOOKING ##{cancel_id}")
    end

  elsif cmd == "FREE"
    if Array.size(fields) != 4
      puts("line #{line_num}: error: wrong field count")
      next
    end

    room = Array.at(fields, 1)
    day = Array.at(fields, 2)
    dur_str = Array.at(fields, 3)

    unless validate_room(room)
      puts("line #{line_num}: error: bad room")
      next
    end

    unless validate_day(day)
      puts("line #{line_num}: error: bad day")
      next
    end

    unless validate_duration(dur_str)
      puts("line #{line_num}: error: bad duration")
      next
    end

    duration_mins = String.to_i(dur_str)

    slot = find_free_slot(bookings, room, day, duration_mins)
    if slot
      start_mins, end_mins = slot
      start_time = minutes_to_time(start_mins)
      end_time = minutes_to_time(end_mins)
      puts("FREE #{room} #{day} #{start_time}-#{end_time}")
    else
      puts("FULL #{room} #{day}")
    end

  else
    puts("line #{line_num}: error: unknown command")
  end
end

# Print final schedule
puts("== schedule ==")

# Sort bookings by day, room, start time
sorted = Array.sort_by(bookings) do |b|
  day_idx = Hash.fetch(DAY_INDEX, Booking.day(b))
  [day_idx, Booking.room(b), Booking.start_minutes(b)]
end

if Array.empty?(sorted)
  puts("(none)")
else
  Array.each(sorted) do |b|
    day = Booking.day(b)
    room = Booking.room(b)
    start_time = minutes_to_time(Booking.start_minutes(b))
    end_time = minutes_to_time(Booking.end_minutes(b))
    id = Booking.id(b)
    who = Booking.who(b)
    puts(format("%s %-8s %s-%s #%d %s", day, room, start_time, end_time, id, who))
  end
end

# Print usage per room
puts("== usage ==")

rooms_used = Hash[]
Array.each(sorted) do |b|
  room = Booking.room(b)
  duration = Booking.end_minutes(b) - Booking.start_minutes(b)
  if Hash.key?(rooms_used, room)
    Hash.store(rooms_used, room, Hash.fetch(rooms_used, room) + duration)
  else
    Hash.store(rooms_used, room, duration)
  end
end

if Hash.empty?(rooms_used)
  puts("(none)")
else
  sorted_rooms = Array.sort(Array.keys(rooms_used))
  Array.each(sorted_rooms) do |room|
    total_mins = Hash.fetch(rooms_used, room)
    hours = total_mins / 60
    mins = total_mins % 60
    puts(format("%-8s %dh%02dm", room, hours, mins))
  end
end
