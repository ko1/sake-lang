require "awesome_print"

def show(title, s)
  puts "--- #{title}"
  puts s
end

# arrays: indices right-aligned to the widest; nested containers one level deeper
show("array", AwesomePrint.ai(Any[1, "two", :three, nil, true, false, 1.5], plain: true))
show("array of 11", AwesomePrint.ai(Array.new(11) { |i| i * i }, plain: true))
show("nested", AwesomePrint.ai(Any[1, Any[2, Any[3, Any[]]], Hash.of(k: "v")], plain: true))
show("no index", AwesomePrint.ai(Any["a", "b"], plain: true, index: false))

# hashes: keys aligned on =>; Symbol, String, Integer, Tuple keys; nested hash
h = Hash.of(name: "alice", "age" => 30, 7 => "seven", [1, 2] => Any[3], :"foo bar" => nil, roles: Any[:admin, :dev])
show("hash", AwesomePrint.ai(h, plain: true))
show("hash ruby19", AwesomePrint.ai(h, plain: true, ruby19_syntax: true))
show("hash sorted", AwesomePrint.ai(h, plain: true, sort_keys: true))
show("hash in hash", AwesomePrint.ai(Hash.of(a: 1, bb: Hash.of(ccc: 2, d: Hash.of(e: Any[1, 2])), f: Hash.new), plain: true))
show("hash in array", AwesomePrint.ai(Any[Hash.of(x: 1, long_key: 2), Hash.new], plain: true))

# indent: 2, 0 (left-aligned after the indent), -4 (left-aligned keys)
show("indent 2", AwesomePrint.ai(Hash.of(a: 1, bbb: Any[1, 2]), plain: true, indent: 2))
show("indent 0", AwesomePrint.ai(Hash.of(a: 1, bbb: Any[1, 2]), plain: true, indent: 0))
show("indent -4", AwesomePrint.ai(Hash.of(a: 1, bbb: Hash.of(cc: 2)), plain: true, indent: -4))

# one line
show("single line", AwesomePrint.ai(Hash.of(a: Any[1, 2], b: Hash.of(c: :d)), plain: true, multiline: false))
show("single line array", AwesomePrint.ai(Any[1, Any[2, 3]], plain: true, multiline: false))

# empty containers and scalars
show("empties", AwesomePrint.ai(Any[Any[], Hash.new, Set.new, ""], plain: true))
show("scalars", AwesomePrint.ai(Any[42, -1.5, Rational(1, 3), Complex(1, 2), 1..3, /re/i, "s\n", :sym, nil, true, false], plain: true))
show("string", AwesomePrint.ai("plain", plain: true))
show("integer", AwesomePrint.ai(7, plain: true))
show("nil", AwesomePrint.ai(nil, plain: true))

# Sets print as Arrays, Tuples as Arrays, Records as Hashes, values of a program's classes in one piece
S = Struct.new(:x, :y)
show("set", AwesomePrint.ai(Set.of(1, 2, 3), plain: true))
show("tuple", AwesomePrint.ai([1, "a"], plain: true))
show("record", AwesomePrint.ai({x: 1, y: Any[2]}, plain: true))
show("struct", AwesomePrint.ai(Any[S.new(1, Any[2, 3])], plain: true))

# colours: the gem's ANSI codes (shown with p so the escapes are visible)
p AwesomePrint.ai(Any[1, "s", :sym, nil, true, false, 1.5, Rational(1, 2), 1..2])
p AwesomePrint.ai(Hash.of(a: 1, "b" => Any[]))
p AwesomePrint.ai(Hash.of(a: S.new(1, 2)), ruby19_syntax: true)
p AwesomePrint.ai(Hash.of(a: 1), multiline: false)

# ap prints and gives the value back
r = AwesomePrint.ap(Any[1, Hash.of(a: 2)], plain: true)
p r
r2 = AwesomePrint.ap(Hash.of(k: "v"), plain: true, indent: 2, ruby19_syntax: true)
p r2 == Hash.of(k: "v")
