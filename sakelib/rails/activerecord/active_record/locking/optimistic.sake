# Port of activerecord-8.1.3/lib/active_record/locking/optimistic.rb (partial: no lock_optimistically = false
# per class, no update_counters' touch of the lock column)
#
# Ruby's Locking::Optimistic#_create_record / #_update_row / #destroy_row in the super chain (persistence.sake):
# a model with a lock_version column increments it on each update and adds `AND lock_version = old` to the
# UPDATE and DELETE; no row changed raises StaleObjectError.

module ActiveRecord
  class StaleObjectError < StandardError
    attr_reader record, attempted_action
    include ActiveRecordError
  end

  module Locking
    module Optimistic
      def locking_column = ModelClass.locking_column(__model)
      def locking_enabled? = Array.include?(column_names, locking_column)

      def locking__create_record(r)
        # Ruby: attribute_names |= [locking_column] (always persisted, even when not changed from the default)
        return counter_cache__create_record(r) unless locking_enabled?
        _write_attribute(r, locking_column, 0) if (_read_attribute(r, locking_column) in nil)
        counter_cache__create_record(r, String[locking_column])
      end

      def locking__update_record(r) = persistence__update_record(r)

      # Ruby: _update_row(attribute_names, attempted_action = "update")
      def _update_row(r, names, attempted_action = "update")
        return persistence__update_row(r, names, attempted_action) unless locking_enabled?
        lock_col = locking_column
        previous = _read_attribute(r, lock_col)
        previous_value = (previous in Integer) ? previous : 0
        _write_attribute(r, lock_col, previous_value + 1)
        all_names = Array.include?(names, lock_col) ? names : names + String[lock_col]
        affected = _update_record_with(attributes_with_values(r, all_names), Any[[primary_key || "id", id_in_database(r)], [lock_col, previous_value]])
        if affected != 1
          ActiveModel::AttributeSet.write_from_user(@attribute_set, lock_col, previous_value)
          raise StaleObjectError.new("Attempted to #{attempted_action} a stale object: #{ModelClass.name(__model)}.", r, attempted_action)
        end
        affected
      end

      def destroy_row(r)
        return counter_cache_destroy_row(r) unless locking_enabled?
        lock_col = locking_column
        affected = _delete_record(Any[[primary_key || "id", id_in_database(r)], [lock_col, attribute_in_database(r, lock_col)]])
        raise StaleObjectError.new("Attempted to destroy a stale object: #{ModelClass.name(__model)}.", r, "destroy") if affected != 1
        affected
      end
    end
  end
end
