module Sql
  class Blob
    attr_reader bytes: String

    def initialize: (String bytes) -> void
    def self.valid_hex?: (String text) -> bool
    def self.from_hex: (String text) -> Blob
    def hex: () -> String
    def text: () -> String
    def length: () -> Integer
    def <=>: (Blob other) -> Integer
    def eql?: (Object other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end
end
