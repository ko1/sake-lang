# Iterating "sum of the k-th powers of the digits": happy numbers (k = 2),
# the cycles every start falls into for k = 2..5, and the fixed points.

def digit_power_sum(n, k)
  s = 0
  while n > 0
    n, d = Integer.divmod(n, 10)
    s += d ** k
  end
  s
end

# walk until a value repeats; return the cycle rotated to start at its smallest member
def cycle_from(n, k)
  seen = Hash[]
  order = Integer[]
  until Hash.key?(seen, n)
    seen[n] = Array.size(order)
    Array.push(order, n)
    n = digit_power_sum(n, k)
  end
  cyc = Array.drop(order, seen[n])
  smallest = Array.index(cyc, Array.min(cyc))
  Array.rotate(cyc, smallest)
end

def happy?(n, memo)
  path = Integer[]
  while memo[n] == nil && n != 1
    if Array.include?(path, n)
      Array.each(path) { |m| memo[m] = false }
      return false
    end
    Array.push(path, n)
    n = digit_power_sum(n, 2)
  end
  result = n == 1 || memo[n] == true
  Array.each(path) { |m| memo[m] = result }
  result
end

memo = Hash[]
happy = Range.select(1..100) { |n| happy?(n, memo) }
puts("happy numbers <= 100 (#{Array.size(happy)}): #{Array.join(happy, " ")}")
count1000 = Range.count(1..1000) { |n| happy?(n, memo) }
puts("happy numbers <= 1000: #{count1000}")

consecutive = Range.select(1..1000) { |n| happy?(n, memo) && happy?(n + 1, memo) }
puts("consecutive happy pairs <= 1000: #{Array.join(consecutive, " ")}")

trail = Integer[7]
Array.push(trail, digit_power_sum(Array.last(trail), 2)) while Array.last(trail) != 1
puts("trail of 7: #{Array.join(trail, " -> ")}")

Range.each(2..5) do |k|
  bound = k <= 3 ? 300 : 80
  cycles = Hash.new(0)
  Range.each(1..bound) { |n| cycles[cycle_from(n, k)] += 1 }
  puts("k=#{k}: #{Hash.size(cycles)} cycles for starts 1..#{bound}")
  Array.each(Hash.sort_by(cycles) { |members, c| [-c, Array.first(members)] }) do |members, c|
    label = Array.size(members) == 1 ? "fixed point" : "cycle of #{Array.size(members)}"
    shown = Array.size(members) > 6 ? Array.join(Array.take(members, 6), " ") + " ..." : Array.join(members, " ")
    puts(format("  %-14s %5d starts: %s", label, c, shown))
  end
end
