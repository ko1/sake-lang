# Goldbach's conjecture checks: every even number has a prime-pair decomposition.
# Counts partitions (Goldbach's comet), finds the "hardest" evens, and checks the
# weak (ternary) conjecture for small odds.

def prime_table(limit)
  flags = Array[false, false] + Array.new(limit - 1, true)
  Range.each(2..Integer.sqrt(limit)) do |i|
    next unless flags[i]
    Range.step((i * i)..limit, i) { |j| flags[j] = false }
  end
  flags
end

def partitions(n, flags)
  Range.select(2..(n / 2)) { |p| flags[p] && flags[n - p] }
    .Array.map { |p| [p, n - p] }
end

def min_partition(n, flags, primes)
  p = Array.find(primes) { |q| flags[n - q] }
  p ? [p, n - p] : nil
end

limit = 1000
flags = prime_table(limit)
primes = Array.select(Range.to_a(2..limit)) { |n| flags[n] }

puts("partitions of small evens:")
Range.step(4..40, 6) do |n|
  ps = partitions(n, flags)
  puts("  #{n} = " + Array.join(Array.map(ps) { |a, b| "#{a}+#{b}" }, " = "))
end

failures = Array[]
Range.step(4..limit, 2) { |n| Array.push(failures, n) if min_partition(n, flags, primes) == nil }
puts("evens <= #{limit} without a partition: #{Array.empty?(failures) ? "none" : failures}")

counts = Hash[]
Range.step(4..limit, 2) { |n| counts[n] = Array.size(partitions(n, flags)) }

puts("Goldbach's comet (min / max count per block of 250):")
Array.each_slice(Hash.to_a(counts), 125) do |block|
  lo_n, lo_c = Array.min_by(block) { |_, c| c }
  hi_n, hi_c = Array.max_by(block) { |_, c| c }
  puts(format("  %4d..%4d  min %2d at %4d   max %3d at %4d", Array.first(block)[0], Array.last(block)[0], lo_c, lo_n, hi_c, hi_n))
end

puts("evens with a record-large smallest prime in their partition:")
record = 0
Range.step(4..limit, 2) do |n|
  pair = min_partition(n, flags, primes)
  next unless pair
  p, q = pair
  if p > record
    record = p
    puts("  #{n} = #{p} + #{q}")
  end
end

puts("multiples of 30 vs neighbours:")
Array.each(Integer[210, 420, 840, 1050]) do |n|
  around = Array.map(Integer[n - 2, n, n + 2]) { |m| "#{m}:#{counts[m]}" }
  puts("  " + Array.join(around, "  "))
end

puts("weak Goldbach (odd n = p + q + r), fewest decompositions for 7..151:")
weak = Hash[]
Range.step(7..151, 2) do |n|
  c = 0
  small = Array.take_while(primes) { |p| p <= n }
  Array.each(small) do |p|
    Array.each(small) do |q|
      next if q < p || p + q > n
      r = n - p - q
      c += 1 if r >= q && flags[r]
    end
  end
  weak[n] = c
end
fewest = Array.take(Array.sort_by(Hash.to_a(weak)) { |n, c| [c, n] }, 6)
puts("  " + Array.join(Array.map(fewest) { |n, c| "#{n}(#{c})" }, " "))
