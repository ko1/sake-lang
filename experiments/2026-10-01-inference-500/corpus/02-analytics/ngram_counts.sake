def text
  "the cat sat on the mat . the dog sat on the log . the cat saw the dog . " +
  "the dog chased the cat off the mat . a cat and a dog sat on the mat together . " +
  "the cat sat on the dog ."
end

class Gram
  attr_reader key, count
  include Comparable
  def <=>(a, b)
    c = Gram.get_count(b) <=> @count
    c == 0 ? @key <=> Gram.get_key(b) : c
  end
end

def ngrams(tokens, n)
  counts = Hash.new(0)
  Array.each_cons(tokens, n) { |window| counts[Array.join(window, " ")] += 1 }
  counts
end

def pair_counts(tokens)
  counts = Hash.new(0)
  Array.each_cons(tokens, 2) do |window|
    a = window[0]
    b = window[1]
    next if a == "." || b == "."
    counts[[a, b]] += 1
  end
  counts
end

def ranked(counts)
  Array.sort(Hash.map(counts) { |k, c| Gram.new(k, c) })
end

def show_top(title, counts, limit)
  puts("== #{title} (#{Hash.size(counts)} distinct) ==")
  Array.each(Array.take(ranked(counts), limit)) do |g|
    puts(format("  %-22s %2d", Gram.get_key(g), Gram.get_count(g)))
  end
end

def successors(pairs)
  table = Hash[]
  Hash.each(pairs) do |pair, c|
    a, b = pair
    table[a] ||= Hash.new(0)
    table[a][b] += c
  end
  table
end

def next_word_probs(table, word)
  followers = table[word]
  return Array[] if followers == nil
  total = Array.sum(Hash.values(followers))
  probs = Hash.map(followers) { |w, c| [w, c * 1.0 / total] }
  Array.sort_by(probs) { |w, pr| 1.0 - pr }
end

tokens = String.split(text, " ")
puts("tokens: #{Array.size(tokens)}")
show_top("unigrams", ngrams(tokens, 1), 5)
show_top("bigrams", ngrams(tokens, 2), 6)
show_top("trigrams", ngrams(tokens, 3), 4)

pairs = pair_counts(tokens)
table = successors(pairs)
Array.each(Array["the", "cat", "sat", "zebra"]) do |w|
  probs = next_word_probs(table, w)
  if Array.empty?(probs)
    puts("after '#{w}': (never seen)")
  else
    parts = Array.map(probs) { |nw, pr| "#{nw}=#{Float.round(pr, 2)}" }
    puts("after '#{w}': #{Array.join(parts, " ")}")
  end
end

best = Hash.max_by(pairs) { |pair, c| c }
if best
  pair, c = best
  a, b = pair
  puts("most frequent pair: #{a} -> #{b} (#{c})")
end
