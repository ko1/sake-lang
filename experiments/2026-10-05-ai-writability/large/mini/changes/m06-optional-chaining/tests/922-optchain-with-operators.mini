let a = nil
let m = {"n": 4}
print(not a?.b, a?.b or "default", a?.b == nil, m?.n + 1, -m?.n, m?.n ** 2)
print(a?.b in [nil, 1], m?.n in [4], a?.b and 1)
try print(-a?.b) catch e print(e.message) end
try print(a?.b ** 2) catch e print(e.message) end
try print(a?.b + 1) catch e print(e.message) end
try print(a?.b < 1) catch e print(e.message) end
