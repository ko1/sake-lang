# Port of actionview-8.1.3/lib/action_view/helpers/rendering_helper.rb (partial: no render_in objects, no layout: with a block)
#
# Rails' `render(options = {}, locals = {}, &block)`. A template's literal render call with locals is compiled into a
# typed call (generate/templates.sake); this is the run-time form: a template (and layout) or a partial without locals.

require "../renderer/renderer"

module ActionView
  module Helpers
    module RenderingHelper
      def view_renderer(v) = raise(NotImplementedError)

      def render(v, partial_name = nil, template: nil, layout: nil, partial: nil, plain: nil, html: nil, body: nil, formats: nil)
        Renderer.render(view_renderer(v), v, template: template, layout: layout, plain: plain, html: html, body: body, formats: formats, partial: partial || partial_name)
      end
    end
  end
end
