# Port of activesupport-8.1.3/lib/active_support/inflector/transliterate.rb (partial: no locale:, no encoding checks or tidy_bytes)

require "i18n"

module ActiveSupport
  module Inflector
    module_function

    def transliterate(string, replacement = "?")
      return dup(string) if String.ascii_only?(string)
      I18n.transliterate(String.unicode_normalize(string, :nfc), replacement: replacement)
    end

    def parameterize(string, separator: "-", preserve_case: false)
      parameterized_string = String.gsub(transliterate(string), /[^a-z0-9\-_]+/i, separator)
      unless String.empty?(separator)
        if String.length(separator) == 1
          parameterized_string = String.squeeze(parameterized_string, separator)
        else
          re_sep = Regexp.escape(separator)
          parameterized_string = String.gsub(parameterized_string, Regexp.new("#{re_sep}{2,}"), separator)
        end
        parameterized_string = String.delete_prefix(parameterized_string, separator).delete_suffix(separator)
      end
      preserve_case ? parameterized_string : String.downcase(parameterized_string)
    end
  end
end
