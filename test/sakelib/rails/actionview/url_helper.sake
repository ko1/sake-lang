require "rails/actionview/action_view/base"
require "fixtures/blog_routes"
require "fixtures/records"
generate "blog_url_helpers", "BlogUrlHelpers"

# A view with the routes' url helpers (Rails: the view class includes routes.url_helpers), as an app's has
class AppView < ActionView::Base
  include BlogUrlHelpers
  def button_to_generates_button_tag(v) = true
end

env = Rack::MockRequest.env_for("http://www.example.com/posts?page=2")
view = AppView.new(routes: blog_route_set, request: ActionDispatch::Request.new(env))
post = Post.new(1, "Hello", "World")
comment = Comment.new(5, 1, "Nice")

# url_for
puts AppView.url_for(view, "/plain")
puts AppView.url_for(view, Hash.of(controller: "posts", action: "show", id: 3))
puts AppView.url_for(view, Hash.of(controller: "posts", action: "index", only_path: false, host: "example.org"))
puts AppView.url_for(view, post)
puts AppView.url_for(view, Any[post, comment])
puts AppView.url_for(view, Any[post, Hash.of(only_path: false, host: "h.example")])
puts AppView.url_for(view, :posts)
puts AppView.url_for(view, :back)
puts AppView.posts_path(view), AppView.post_path(view, post), AppView.edit_post_comment_path(view, post, comment)
puts AppView.post_url(view, post, host: "example.com")
# link_to
puts AppView.link_to(view, "Home", AppView.root_path(view))
puts AppView.link_to(view, "Show", post)
puts AppView.link_to(view, "Show", post, class: "btn", data: Hash.of(turbo_confirm: "Sure?"))
puts AppView.link_to(view, "Delete", post, method: :delete, rel: "external")
puts AppView.link_to(view, "Remote", "/x", remote: true)
puts AppView.link_to(view, "<Escaped>", Any[post, comment])
puts AppView.link_to(view, nil, "http://www.rubyonrails.org/")
puts AppView.link_to(view, post) { "Block <b>" }
puts AppView.link_to(view, AppView.posts_path(view), class: "nav") { String.html_safe("<b>All</b>") }
puts AppView.link_to(view, "About", Hash.of(controller: "pages", action: "about"))
# button_to
puts AppView.button_to(view, "New", "/posts/new", method: :get)
puts AppView.button_to(view, "Create", "/posts")
puts AppView.button_to(view, "Destroy", post, method: :delete)
puts AppView.button_to(view, "Update", post, form: Hash.of(id: "f"), form_class: "inline", params: Hash.of(page: 2, tags: Any["a", "b"]))
puts AppView.button_to(view, post, class: "b") { "Inside" }
# link_to_if / unless / unless_current
puts AppView.link_to_if(view, true, "Yes", "/yes")
puts AppView.link_to_if(view, false, "No <1>", "/no")
puts AppView.link_to_unless(view, true, "Hidden", "/h") { |name| "[#{name}]" }
puts AppView.link_to_unless_current(view, "Posts", AppView.posts_path(view))
puts AppView.link_to_unless_current(view, "Root", AppView.root_path(view))
# current_page?
p(AppView.current_page?(view, "/posts"), AppView.current_page?(view, "/posts?page=2"), AppView.current_page?(view, "/posts?page=3"))
p(AppView.current_page?(view, "/posts", check_parameters: true), AppView.current_page?(view, "http://www.example.com/posts"))
p(AppView.current_page?(view, Hash.of(controller: "posts", action: "index")), AppView.current_page?(view, "/posts", method: :post))
# mail_to / sms_to / phone_to
puts AppView.mail_to(view, "me@example.com")
puts AppView.mail_to(view, "me@example.com", "My email", class: "m")
puts AppView.mail_to(view, "me@example.com", cc: "ccaddress@example.com", subject: "This is an example email", body: "Hi & bye")
puts AppView.mail_to(view, "me@example.com") { "Email me" }
puts AppView.sms_to(view, "5155555785", "Text me", country_code: "01", body: "I have a question")
puts AppView.phone_to(view, "1234567890", "Call me", country_code: "01")
# dom_id / dom_class / dom_target
puts AppView.dom_id(view, post), AppView.dom_id(view, Post.new(nil, "", "")), AppView.dom_id(view, post, :edit)
puts AppView.dom_class(view, post), AppView.dom_class(view, post, :edit), AppView.dom_target(view, post, :comments, comment)
