# Port of activerecord-8.1.3/lib/active_record/integration.rb (partial: to_param only; no cache_key/cache_version (cache_versioning), no to_param(method_name) class macro)
#
# Over ActiveModel::Conversion (to_key, to_partial_path). Ruby's Base sets `self.param_delimiter = "_"`
# (base.rb); the class attribute is the function here.

module ActiveRecord
  module Integration
    def param_delimiter = "_"

    # Ruby: return unless id; Array(id).join(self.class.param_delimiter)
    def to_param(r)
      v = id(r)
      return nil if v == nil
      Array.join(Array.wrap(v), param_delimiter)
    end
  end
end
