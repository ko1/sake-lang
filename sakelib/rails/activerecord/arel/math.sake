# Port of activerecord-8.1.3/lib/arel/math.rb (partial: no ~@)

module Arel
  module Math
    include Arithmetic
    include Bitwise
    def *(a, other) = Nodes::Multiplication.new(a, other)
    def +(a, other) = Nodes::Grouping.new(Nodes::Addition.new(a, other))
    def -(a, other) = Nodes::Grouping.new(Nodes::Subtraction.new(a, other))
    def /(a, other) = Nodes::Division.new(a, other)
    def &(a, other) = Nodes::Grouping.new(Nodes::BitwiseAnd.new(a, other))
    def |(a, other) = Nodes::Grouping.new(Nodes::BitwiseOr.new(a, other))
    def ^(a, other) = Nodes::Grouping.new(Nodes::BitwiseXor.new(a, other))
    def <<(a, other) = Nodes::Grouping.new(Nodes::BitwiseShiftLeft.new(a, other))
    def >>(a, other) = Nodes::Grouping.new(Nodes::BitwiseShiftRight.new(a, other))
  end
end
