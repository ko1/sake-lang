fn cb(x) return x end
fn m() try return map([1], fn(a, b) return 1 end) catch e return e.function end end
print(m())
fn p(a = 1 / 0) return a end
try p() catch e print(e.function) end
fn fin() try assert false finally print("f") end end
try fin() catch e print(e.function) end
fn inner(a) return a[3] end
fn outer() return inner([0]) end
outer()
