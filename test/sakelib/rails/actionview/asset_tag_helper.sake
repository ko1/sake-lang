require "rails/actionview/action_view/base"

# A view with an app's settings: config.asset_host, a CSP nonce, forgery protection (a controller gives these)
class AppView < ActionView::Base
  def asset_host(v) = "assets%d.example.com"
  def relative_url_root(v) = "/app"
  def content_security_policy?(v) = true
  def content_security_policy_nonce(v) = "n0nce"
  def protect_against_forgery?(v) = true
  def form_authenticity_token(v, form_options: nil) = "t0ken"
  def request_forgery_protection_token(v) = :authenticity_token
  # (the request is ActionView::Base's field)
end

view = ActionView::Base.empty
V = ActionView::Base
req = ActionDispatch::Request.new(Rack::MockRequest.env_for("http://www.example.com/"))
ActionDispatch::Request.set_content_security_policy_nonce_directives(req, String["script-src"])
app = AppView.new(request: req)

# asset paths
puts V.asset_path(view, "application.js")
puts V.asset_path(view, "application", type: :javascript)
puts V.asset_path(view, "application.js", type: :javascript)
puts V.asset_path(view, "/images/logo.png?v=1#top")
puts V.asset_path(view, "http://example.com/a.js")
puts V.asset_path(view, "//cdn.example.com/a.js")
p V.asset_path(view, "")
puts V.image_path(view, "edit.png")
puts V.image_path(view, "edit.png", host: "cdn.example.com")
puts V.image_path(view, "edit.png", host: "cdn.example.com", protocol: :https)
puts V.image_url(view, "edit.png", host: "http://cdn.example.com")
puts V.javascript_path(view, "xmlhr")
puts V.javascript_path(view, "xmlhr", extname: false)
puts V.stylesheet_path(view, "style")
puts V.stylesheet_url(view, "style", host: "http://a.example.com")
puts V.font_path(view, "font.ttf"), V.video_path(view, "hd.avi"), V.audio_path(view, "horse.wav")
puts AppView.image_path(app, "logo.png")
puts AppView.javascript_path(app, "app"), AppView.stylesheet_path(app, "style"), AppView.asset_path(app, "/app/x.css")
begin
  V.asset_path(view, nil)
rescue ArgumentError => e
  puts Exception.message(e)
end
# tags
puts V.javascript_include_tag(view, "xmlhr")
puts V.javascript_include_tag(view, "common", "elsewhere", "common", defer: true)
puts V.javascript_include_tag(view, "http://www.example.com/xmlhr.js", crossorigin: true, type: "module")
puts AppView.javascript_include_tag(app, "app", nonce: true)
puts V.javascript_include_tag(view, "a", nonce: false, async: true)
puts V.stylesheet_link_tag(view, "style")
puts V.stylesheet_link_tag(view, "style", media: "all", host: "s.example.com")
puts V.stylesheet_link_tag(view, "random.styles", "/elsewhere/file")
puts AppView.stylesheet_link_tag(app, "style", nonce: true)
puts V.auto_discovery_link_tag(view, :rss, "/feed.rss")
puts V.auto_discovery_link_tag(view, :atom, "http://www.example.com/feed.atom", Hash.of(title: "My Atom"))
puts V.auto_discovery_link_tag(view, :json, "/feed.json")
puts V.auto_discovery_link_tag(view, :rss, "/feed", Hash.of(rel: "feed", type: "application/x-rss"))
begin
  V.auto_discovery_link_tag(view, :xml, "/feed")
rescue ArgumentError => e
  puts Exception.message(e)
end
puts V.favicon_link_tag(view)
puts V.favicon_link_tag(view, "myicon.png", rel: "apple-touch-icon", type: "image/png")
puts AppView.preload_link_tag(app, "application.js")
puts AppView.preload_link_tag(app, "style.css", fetchpriority: "high")
puts AppView.preload_link_tag(app, "/fonts/a.woff2", type: "font/woff2")
puts AppView.preload_link_tag(app, "/media/audio.ogg", nopush: true)
puts AppView.preload_link_tag(app, "/v.mp4", as: "video", crossorigin: true)
puts V.image_tag(view, "icon.png")
puts V.image_tag(view, "icon.png", alt: "Edit", size: "16x10", class: "i")
puts V.image_tag(view, "icon.png", size: "20")
puts V.image_tag(view, "icon.png", size: "x")
puts V.image_tag(view, "/icons/icon.gif", height: 32, width: 32)
puts V.image_tag(view, "http://example.com/a.png", srcset: Hash.of("a-2x.png" => "2x", "a-3x.png" => "3x"))
puts V.image_tag(view, "a.png", srcset: Any[Any["a-1.png", "100w"], Any["a-2.png", "200w"]], sizes: "50vw")
puts V.image_tag(view, "a.png", srcset: "x.png 2x")
begin
  V.image_tag(view, "a.png", size: "1x1", width: 3)
rescue ArgumentError => e
  puts Exception.message(e)
end
puts V.picture_tag(view, "icon.webp")
puts V.picture_tag(view, "icon.webp", "icon.png", class: "p", image: Hash.of(alt: "Icon"))
puts V.picture_tag(view, id: "pic") { V.image_tag(view, "inside.png") }
puts V.video_tag(view, "trailer")
puts V.video_tag(view, "trailer.ogg", controls: true, preload: "none", poster: "screen.png", size: "16x10")
puts V.video_tag(view, "trailer.ogg", "trailer.flv", autoplay: true)
puts V.video_tag(view, "/trailers/hd.avi", size: "16")
puts V.audio_tag(view, "sound")
puts V.audio_tag(view, "sound.wav", "sound.mid", autoplay: true, controls: true)
# csrf and csp
p V.csrf_meta_tags(view)
puts AppView.csrf_meta_tags(app)
puts AppView.csrf_meta_tag(app)
puts AppView.csp_meta_tag(app)
puts AppView.csp_meta_tag(app, id: "csp")
