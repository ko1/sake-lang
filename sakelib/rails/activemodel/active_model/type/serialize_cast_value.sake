# Port of activemodel-8.1.3/lib/active_model/type/serialize_cast_value.rb
#
# Ruby includes DefaultImplementation (serialize_cast_value(value) = value) unless the class defines one, and
# SerializeCastValue.serialize(type, value) asks, through the ancestors, whether serialize_cast_value is as
# specific as serialize. Here every type has serialize_cast_value (the default comes with the module, a
# type's own wins) and `serialize_cast_value_compatible?` is a function each type answers (Value: true; a
# type whose serialize does more than its serialize_cast_value says false).

module ActiveModel
  module Type
    module SerializeCastValue
      def serialize_cast_value(t, value) = value
      def serialize_cast_value_compatible?(t) = true

      module_function

      def serialize(type, value)
        if ActiveModel::Type::Value.serialize_cast_value_compatible?(type)
          ActiveModel::Type::Value.serialize_cast_value(type, value)
        else
          ActiveModel::Type::Value.serialize(type, value)
        end
      end
    end
  end
end
