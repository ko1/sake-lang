def read_lines
  out = String[]
  l = gets
  while l != nil
    Array.push(out, String.chomp(l))
    l = gets
  end
  out
end

def money(c)
  "#{c / 100}.#{String.rjust(Integer.to_s(c % 100), 2, "0")}"
end

def parse_event(line)
  toks = String.split(line)
  return nil if Array.size(toks) != 3
  return nil unless String.match?(toks[0], /\A([01][0-9]|2[0-3]):[0-5][0-9]\z/)
  return nil unless toks[1] == "IN" || toks[1] == "OUT"
  return nil unless String.match?(toks[2], /\A[A-Z0-9]{1,8}\z/)
  hm = String.split(toks[0], ":")
  [String.to_i(hm[0]) * 60 + String.to_i(hm[1]), toks[1], toks[2]]
end

def fee(stay, first, step, cap, grace)
  return 0 if stay <= grace
  d = stay / 1440
  r = stay % 1440
  part = 0
  if r > 0
    extra = 0
    extra = (r - 60 + 29) / 30 if r > 60
    part = first + step * extra
  end
  capped = part < cap ? part : cap
  d * cap + capped
end

def solve(lines)
  hd = String.split(lines[0])
  first = String.to_i(hd[1])
  step = String.to_i(hd[2])
  cap = String.to_i(hd[3])
  grace = String.to_i(hd[4])
  inside = Hash[]
  exits = Hash[]
  rev = Hash[]
  day = 0
  prev = -1
  i = 1
  while i < Array.size(lines)
    line = lines[i]
    if String.strip(line) != ""
      ev = parse_event(line)
      if ev == nil
        puts("line #{i + 1}: invalid")
      else
        m, kind, plate = ev
        day += 1 if m < prev
        prev = m
        now = day * 1440 + m
        if kind == "IN"
          if Hash.key?(inside, plate)
            puts("line #{i + 1}: #{plate} already inside")
          else
            inside[plate] = now
          end
        elsif !Hash.key?(inside, plate)
          puts("line #{i + 1}: #{plate} not inside")
        else
          stay = now - inside[plate]
          Hash.delete(inside, plate)
          f = fee(stay, first, step, cap, grace)
          mm = String.rjust(Integer.to_s(stay % 60), 2, "0")
          puts("#{plate} #{stay / 60}:#{mm} #{money(f)}")
          if Hash.key?(exits, plate)
            exits[plate] += 1
            rev[plate] += f
          else
            exits[plate] = 1
            rev[plate] = f
          end
        end
      end
    end
    i += 1
  end

  puts("--- summary")
  plates = Array.sort_by(Hash.keys(exits)) { |pl| [-rev[pl], pl] }
  te = 0
  tr = 0
  Array.each(plates) do |pl|
    puts("#{pl} #{exits[pl]} #{money(rev[pl])}")
    te += exits[pl]
    tr += rev[pl]
  end
  puts("total #{te} #{money(tr)}")
  left = Array.sort(Hash.keys(inside))
  if Array.size(left) == 0
    puts("inside: none")
  else
    puts("inside: #{Array.join(left, ", ")}")
  end
end

solve(read_lines)
