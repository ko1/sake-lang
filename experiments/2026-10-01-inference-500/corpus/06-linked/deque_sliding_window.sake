DNode = Struct.new(:value, :prev, :next)

class Deque
  attr_reader front, back, length
  include Indexable

  def create = Deque.new(nil, nil, 0)

  def empty?(d) = @length == 0

  def push_back(d, v)
    node = DNode.new(v, @back, nil)
    b = @back
    if b
      DNode.set_next(b, node)
    else
      @front = node
    end
    @back = node
    @length += 1
    d
  end

  def push_front(d, v)
    node = DNode.new(v, nil, @front)
    f = @front
    if f
      DNode.set_prev(f, node)
    else
      @back = node
    end
    @front = node
    @length += 1
    d
  end

  def pop_front(d)
    node = @front
    return nil unless node
    nxt = DNode.next(node)
    @front = nxt
    if nxt
      DNode.set_prev(nxt, nil)
    else
      @back = nil
    end
    @length -= 1
    DNode.value(node)
  end

  def pop_back(d)
    node = @back
    return nil unless node
    prv = DNode.prev(node)
    @back = prv
    if prv
      DNode.set_next(prv, nil)
    else
      @front = nil
    end
    @length -= 1
    DNode.value(node)
  end

  def peek_front(d) = @front ? DNode.value(@front) : nil
  def peek_back(d) = @back ? DNode.value(@back) : nil

  def [](d, i)
    return nil if i >= @length || i < 0 - @length
    if i < 0
      node = @back
      Integer.times(0 - i - 1) { node = DNode.prev(node) }
    else
      node = @front
      Integer.times(i) { node = DNode.next(node) }
    end
    DNode.value(node)
  end

  def to_s(d)
    parts = Array[]
    node = @front
    while node
      Array.push(parts, Kernel.inspect(DNode.value(node)))
      node = DNode.next(node)
    end
    "<" + Array.join(parts, ", ") + ">"
  end
end

def sliding_max(xs, k)
  window = Deque.create
  out = Array[]
  Array.each_with_index(xs) do |x, i|
    while Deque.empty?(window) == false && Deque.peek_front(window) <= i - k
      Deque.pop_front(window)
    end
    while Deque.empty?(window) == false && xs[Deque.peek_back(window)] <= x
      Deque.pop_back(window)
    end
    Deque.push_back(window, i)
    Array.push(out, xs[Deque.peek_front(window)]) if i >= k - 1
  end
  out
end

def palindrome?(text)
  d = Deque.create
  String.each_char(String.downcase(text)) { |c| Deque.push_back(d, c) if String.match?(c, /[a-z0-9]/) }
  while Deque.length(d) > 1
    return false if Deque.pop_front(d) != Deque.pop_back(d)
  end
  true
end

d = Deque.create
Deque.push_back(d, 2)
Deque.push_back(d, 3)
Deque.push_front(d, 1)
Deque.push_front(d, 0)
puts("deque #{d} length=#{Deque.length(d)}")
puts("d[0]=#{d[0]} d[2]=#{d[2]} d[-1]=#{d[-1]} d[-4]=#{d[-4]} d[9]=#{Kernel.inspect(d[9])}")
puts("pop_back=#{Deque.pop_back(d)} pop_front=#{Deque.pop_front(d)} -> #{d}")
Deque.pop_back(d)
Deque.pop_back(d)
puts("emptied: #{d} front=#{Kernel.inspect(Deque.peek_front(d))} pop=#{Kernel.inspect(Deque.pop_front(d))}")

temps = Array[3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8, 9, 7, 9]
Array.each(Array[1, 3, 5]) do |k|
  puts("max over #{k}: #{Kernel.inspect(sliding_max(temps, k))}")
end

Array.each(Array["A man, a plan, a canal: Panama", "deque", "Was it a car or a cat I saw?", "", "ab"]) do |s|
  puts("#{Kernel.inspect(s)} palindrome? #{palindrome?(s)}")
end

rotating = Deque.create
Array.each(String.chars("abcdef")) { |c| Deque.push_back(rotating, c) }
Integer.times(4) do |round|
  Integer.times(round + 1) { Deque.push_back(rotating, Deque.pop_front(rotating)) }
  puts("rotate #{round + 1}: #{rotating}")
end
