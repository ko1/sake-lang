# The same options, parsed into a Hash the program reads afterwards (current Sake style).
class Option
  attr_reader short, long, arg, key
end
class Parser
  attr_reader options, banner
  def on(op, short, long, arg, key)
    Array.push(@options, Option.new(short, long, arg, key))
    op
  end

  def find(op, name) = Array.find(@options) { |o| o.Option.short == name || o.Option.long == name }

  def parse(op, argv)
    rest = Array[]
    got = Hash[]
    i = 0
    while i < Array.size(argv)
      a = argv[i]
      o = String.start_with?(a, "-") ? find(op, a) : nil
      if o == nil
        Array.push(rest, a)
      elsif o.Option.arg
        i += 1
        Hash.[]=(got, o.Option.key, Array.push(Hash.fetch(got, o.Option.key, String[]), argv[i] || ""))
      else
        Hash.[]=(got, o.Option.key, Array["true"])
      end
      i += 1
    end
    [got, rest]
  end
end

op = Parser.new(Array[], "usage: prog [options]")
Parser.on(op, "-v", "--verbose", false, :verbose)
Parser.on(op, "-n", "--count", true, :count)
Parser.on(op, "-o", "--output", true, :output)
Parser.on(op, "-t", "--tag", true, :tag)
Parser.on(op, "-l", "--level", true, :level)
got, rest = Parser.parse(op, Array["-v", "-n", "3", "--tag", "a", "-t", "b", "file1", "-l", "debug", "-o", "out.txt"])
verbose = Hash.key?(got, :verbose)
count = Integer(Array.last(Hash.fetch(got, :count, Array["1"])) || "1")
output = Array.last(Hash.fetch(got, :output, Array["-"])) || "-"
tags = Hash.fetch(got, :tag, String[])
level = String.to_sym(Array.last(Hash.fetch(got, :level, Array["info"])) || "info")
p verbose
p count
p output
p tags
p level
p rest
p Integer.*(count, 2)
p String.upcase(output)
