pair = [1, "one"]                 # a literal is a Tuple
n, word = pair
puts(word)
puts(Tuple.size(pair))

xs = Array[1, "two", 3.0]         # Array[...] has no declared element type
Array.push(xs, nil)
p(xs)

ws = String.split("to be or not to be", " ")
p(ws)
puts(Array.join(Array.map(ws) { String.capitalize(it) }, " "))

fs = Float[]                      # T[...] declares the element type
Array.push(fs, 1.5, 2.5)
puts(Array.sum(fs))
Array.push(fs, 3)
