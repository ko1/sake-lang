require "rails/activesupport/active_support/hash_with_indifferent_access"
require "rails/activesupport/active_support/json"

# ActiveSupport::HashWithIndifferentAccess (hash_with_indifferent_access, core_ext/hash/indifferent_access)
params = Hash.with_indifferent_access(Hash.of(:user => Hash.of("name" => "ann", :roles => Any[Hash.of(id: 1)]), "page" => 2))
p(params[:page], params["page"], params[:user], ActiveSupport::HashWithIndifferentAccess.dig(params, :user, :name), ActiveSupport::HashWithIndifferentAccess.dig(params, "user", "roles", 0, :id))
params[:sort] = "name"
p(ActiveSupport::HashWithIndifferentAccess.keys(params), ActiveSupport::HashWithIndifferentAccess.key?(params, :sort), ActiveSupport::HashWithIndifferentAccess.fetch(params, :page), ActiveSupport::HashWithIndifferentAccess.fetch(params, :missing, 0))
begin
  ActiveSupport::HashWithIndifferentAccess.fetch(params, :missing)
rescue KeyError => e
  puts Exception.message(e)
end
p(ActiveSupport::HashWithIndifferentAccess.values_at(params, :page, "sort"), ActiveSupport::HashWithIndifferentAccess.slice(params, :page, :sort), ActiveSupport::HashWithIndifferentAccess.except(params, :user))
merged = ActiveSupport::HashWithIndifferentAccess.merge(params, Hash.of(page: 3, per: 20))
p(merged[:page], merged["per"], params[:page], ActiveSupport::HashWithIndifferentAccess.reverse_merge(params, Hash.of(page: 9, limit: 5))[:limit])
p(ActiveSupport::HashWithIndifferentAccess.to_hash(params), ActiveSupport::HashWithIndifferentAccess.symbolize_keys(ActiveSupport::HashWithIndifferentAccess.except(params, :user)))
p(ActiveSupport::HashWithIndifferentAccess.delete(params, :sort), ActiveSupport::HashWithIndifferentAccess.size(params), ActiveSupport::HashWithIndifferentAccess.select(params) { |k, v| k == "page" })
p(params == Hash.of("page" => 2, "user" => Hash.of("name" => "ann", "roles" => Any[Hash.of("id" => 1)])), ActiveSupport::HashWithIndifferentAccess.transform_values(ActiveSupport::HashWithIndifferentAccess.slice(params, :page)) { |v| v })
puts(ActiveSupport::JSON.encode(params))
