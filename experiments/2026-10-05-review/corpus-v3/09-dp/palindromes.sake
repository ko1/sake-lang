# pal[i][j]: s[i..j] reads the same both ways
def palindrome_table(s)
  n = String.size(s)
  pal = Array.new(n) { Array.new(n, false) }
  Integer.downto(n - 1, 0) do |i|
    Integer.upto(i, n - 1) do |j|
      pal[i][j] = true if s[i] == s[j] && (j - i < 2 || pal[i + 1][j - 1])
    end
  end
  pal
end

def longest_substring(s, pal)
  best_i = 0
  best_len = String.size(s) > 0 ? 1 : 0
  Array.each_with_index(pal) do |row, i|
    Array.each_with_index(row) do |ok, j|
      if ok && j - i + 1 > best_len
        best_len = j - i + 1
        best_i = i
      end
    end
  end
  s[best_i, best_len]
end

def min_cut_partition(s, pal)
  n = String.size(s)
  cuts = Array[]
  start_of = Array[]
  Integer.times(n) do |j|
    best = nil
    from = 0
    Integer.upto(0, j) do |i|
      next unless pal[i][j]
      c = i == 0 ? 0 : cuts[i - 1] + 1
      if best == nil || c < best
        best = c
        from = i
      end
    end
    Array.push(cuts, best)
    Array.push(start_of, from)
  end
  pieces = Array[]
  j = n - 1
  while j >= 0
    i = start_of[j]
    Array.unshift(pieces, s[i..j])
    j = i - 1
  end
  [n == 0 ? 0 : cuts[n - 1], pieces]
end

def longest_subsequence(s)
  n = String.size(s)
  return "" if n == 0
  t = Array.new(n) { Array.new(n, 0) }
  Integer.downto(n - 1, 0) do |i|
    t[i][i] = 1
    Integer.upto(i + 1, n - 1) do |j|
      t[i][j] = s[i] == s[j] ? t[i + 1][j - 1] + 2 : Array.max(Array[t[i + 1][j], t[i][j - 1]])
    end
  end
  left = ""
  middle = ""
  i = 0
  j = n - 1
  while i <= j
    if i == j
      middle = s[i]
      break
    elsif s[i] == s[j]
      left += s[i]
      i += 1
      j -= 1
    elsif t[i + 1][j] >= t[i][j - 1]
      i += 1
    else
      j -= 1
    end
  end
  left + middle + String.reverse(left)
end

def normalize(text) = String.gsub(String.downcase(text), /[^a-z]/, "")

samples = Array["banana", "racecar", "aab", "abacdcaba", "noonabbad", "character", "x", "abcdef"]
Array.each(samples) do |s|
  pal = palindrome_table(s)
  count = Array.sum(pal) { |row| Array.count(row, true) }
  cuts, pieces = min_cut_partition(s, pal)
  puts(s)
  puts("  palindromic substrings: #{count}")
  puts("  longest substring:      #{longest_substring(s, pal)}")
  puts("  longest subsequence:    #{longest_subsequence(s)}")
  puts("  min cuts: #{cuts} -> #{Array.join(pieces, "|")}")
end

phrases = Array["A man, a plan, a canal: Panama", "Never odd or even", "Dynamic programming"]
Array.each(phrases) do |phrase|
  letters = normalize(phrase)
  sub = longest_subsequence(letters)
  whole = sub == letters
  puts(format("%-32s %-6s keep %2d/%2d letters", Kernel.inspect(phrase), whole ? "yes" : "no", String.size(sub), String.size(letters)))
end
