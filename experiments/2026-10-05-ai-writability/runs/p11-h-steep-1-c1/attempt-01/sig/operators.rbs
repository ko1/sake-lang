module Sql
  module Operators
    def self.arithmetic: (String op, value left, value right) -> value
    def self.integer_arithmetic: (String op, Integer x, Integer y) -> Integer?
    def self.real_arithmetic: (String op, Float x, Float y) -> Float?
    def self.negate: (value value) -> number?
    def self.concat: (value left, value right) -> String?
    def self.comparison: (String op, value left, column_type? left_aff, value right, column_type? right_aff, collation collation) -> Integer?
    def self.same?: (value left, column_type? left_aff, value right, column_type? right_aff, collation collation) -> bool
    def self.like?: (String text, String pattern) -> bool
  end
end
