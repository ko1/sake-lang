# IO values: IO.stdin, IO.stdout, IO.stderr, and File.open. One type, IO, for all of them.
def report(io, title, rows)
  IO.puts(io, "== #{title}")
  Array.each(rows) { |k, v| IO.puts(io, format("%-5s %3d", k, v)) }
end

rows = Array[["ann", 31], ["bob", 25]]
report(IO.stdout, "to stdout", rows)
path = "io_example.tmp"
File.open(path, "w") { |f| report(f, "to a file", rows) }  # closed after the block
File.open(path) do |f|
  p(IO.gets(f))
  p(IO.readlines(f))
end
File.delete(path)
