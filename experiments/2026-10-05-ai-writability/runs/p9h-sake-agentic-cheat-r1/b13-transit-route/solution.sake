first_line = gets
penalty = String.to_i(String.strip(first_line))

edges = Array[]
stations = Set[]
line_num = 1
line_num = line_num + 1

while (line = gets)
  line = String.strip(line)

  if String.empty?(line)
    line_num = line_num + 1
    next
  end

  if line == "QUERIES"
    line_num = line_num + 1
    break
  end

  parts = String.split(line)

  if Array.size(parts) != 4
    puts("invalid segment at line #{line_num}")
    line_num = line_num + 1
    next
  end

  line_name = Array.at(parts, 0)
  station_a = Array.at(parts, 1)
  station_b = Array.at(parts, 2)
  min_str = Array.at(parts, 3)

  if station_a == station_b
    puts("invalid segment at line #{line_num}")
    line_num = line_num + 1
    next
  end

  unless String.match?(min_str, /^\d+$/)
    puts("invalid segment at line #{line_num}")
    line_num = line_num + 1
    next
  end

  mins = String.to_i(min_str)
  if mins < 1 || mins > 999
    puts("invalid segment at line #{line_num}")
    line_num = line_num + 1
    next
  end

  edge = Array[line_name, station_a, station_b, mins]
  Array.push(edges, edge)
  Set.add(stations, station_a)
  Set.add(stations, station_b)

  line_num = line_num + 1
end

# Process queries
while (query_line = gets)
  query_line = String.strip(query_line)

  if String.empty?(query_line)
    line_num = line_num + 1
    next
  end

  parts = String.split(query_line)

  if Array.size(parts) != 2
    puts("invalid query at line #{line_num}")
    line_num = line_num + 1
    next
  end

  from_s = Array.at(parts, 0)
  to_s = Array.at(parts, 1)

  if !Set.include?(stations, from_s)
    puts("#{from_s} -> #{to_s}: unknown station #{from_s}")
    line_num = line_num + 1
    next
  end

  if !Set.include?(stations, to_s)
    puts("#{from_s} -> #{to_s}: unknown station #{to_s}")
    line_num = line_num + 1
    next
  end

  if from_s == to_s
    puts("#{from_s} -> #{to_s}: 0 min, 0 transfers")
    line_num = line_num + 1
    next
  end

  # Find shortest path using Dijkstra
  # State: [time, transfers, from_s, current_line_or_nil, path_stations, path_lines]
  distances = Hash.new()
  distances[from_s] = Array[0, 0, nil, Array[from_s], Array[]]

  visited = Set[]
  found = false
  best_time = nil
  best_transfers = nil
  best_path_s = nil
  best_path_l = nil

  100.times do
    # Find unvisited node with minimum distance
    min_time = nil
    min_node = nil

    Array.each(Set.to_a(stations)) { |node|
      if !Set.include?(visited, node) && Hash.key?(distances, node)
        state = Hash.[](distances, node)
        time = Array.at(state, 0)
        if min_time == nil || time < min_time
          min_time = time
          min_node = node
        end
      end
    }

    if min_node == nil
      break
    end

    if min_node == to_s
      state = Hash.[](distances, to_s)
      time = Array.at(state, 0)
      transfers = Array.at(state, 1)
      path_s = Array.at(state, 3)
      path_l = Array.at(state, 4)

      if best_time == nil || time < best_time || (time == best_time && transfers < best_transfers)
        best_time = time
        best_transfers = transfers
        best_path_s = path_s
        best_path_l = path_l
        found = true
      end
      break
    end

    Set.add(visited, min_node)

    current_state = Hash.[](distances, min_node)
    current_time = Array.at(current_state, 0)
    current_transfers = Array.at(current_state, 1)
    current_line = Array.at(current_state, 2)
    path_stations = Array.at(current_state, 3)
    path_lines = Array.at(current_state, 4)

    Array.each(edges) { |edge|
      line_n = Array.at(edge, 0)
      a = Array.at(edge, 1)
      b = Array.at(edge, 2)
      cost = Array.at(edge, 3)

      next_s = nil
      if a == min_node
        next_s = b
      elsif b == min_node
        next_s = a
      end

      if next_s != nil
        new_time = current_time + cost
        new_transfers = current_transfers
        if current_line != nil && current_line != line_n
          new_time = new_time + penalty
          new_transfers = new_transfers + 1
        end

        new_path_s = Array.dup(path_stations)
        Array.push(new_path_s, next_s)
        new_path_l = Array.dup(path_lines)
        Array.push(new_path_l, line_n)

        new_state = Array[new_time, new_transfers, line_n, new_path_s, new_path_l]

        if !Hash.key?(distances, next_s) || Array.at(Hash.[](distances, next_s), 0) > new_time
          Hash.store(distances, next_s, new_state)
        end
      end
    }
  end

  if !found
    puts("#{from_s} -> #{to_s}: no route")
  else
    transfer_word = best_transfers == 1 ? "transfer" : "transfers"
    puts("#{from_s} -> #{to_s}: #{best_time} min, #{best_transfers} #{transfer_word}")

    route = ""
    i = 0
    while i < Array.size(best_path_l)
      if i == 0 || Array.at(best_path_l, i) != Array.at(best_path_l, i - 1)
        if i > 0
          route = route + "; "
        end
        line_name = Array.at(best_path_l, i)
        route = route + line_name + ":"
        route = route + " " + Array.at(best_path_s, i)
      end
      route = route + " > " + Array.at(best_path_s, i + 1)
      i = i + 1
    end

    puts("  " + route)
  end

  line_num = line_num + 1
end
