# case/in without else, `x => T`, and typed Arrays with no elements (their element type is the one written).
module Shape
  def area(s) = raise NotImplementedError
end
class Sq
  attr_reader s
  include Shape
  def area(q) = @s * @s
end
class Ci
  attr_reader r
  include Shape
  def area(c) = 3 * @r * @r
end
P = Struct.new(:x)

def kind(x) = case x
  in Integer then "int"
  in String then "str"
end
p(kind(3))
case 4
in Integer then p(4)
end
y = 5
y => Integer
p(y)

p(Integer[])
p(String[])
p(Float[])
p(P[])
p(Shape[])
xs = Shape[Sq.new(2)]
Array.push(xs, Ci.new(1))
p(Array.map(xs) { Shape.area(it) })
