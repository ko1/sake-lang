# Port of activerecord-8.1.3/lib/arel/nodes/window.rb (partial: no hash/eql?)
#
# Ruby's NamedWindow < Window: the functions are written in a module (WindowMethods, Sake only) both include.

module Arel
  module Nodes
    module WindowMethods
      include Node
      def orders(w) = raise(NotImplementedError)
      def partitions(w) = raise(NotImplementedError)
      def framing(w) = raise(NotImplementedError)
      def set_framing(w, v) = raise(NotImplementedError)

      def order(w, *expr)
        Array.concat(orders(w), Array.map(expr) { |x| (x in String | Symbol) ? SqlLiteral.new(Kernel.to_s(x)) : x })
        w
      end

      def partition(w, *expr)
        Array.concat(partitions(w), Array.map(expr) { |x| (x in String | Symbol) ? SqlLiteral.new(Kernel.to_s(x)) : x })
        w
      end

      def frame(w, expr) = set_framing(w, expr)

      def rows(w, expr = nil)
        framing(w) ? Rows.new(expr) : frame(w, Rows.new(expr))
      end

      def range(w, expr = nil)
        framing(w) ? Arel::Nodes::Range.new(expr) : frame(w, Arel::Nodes::Range.new(expr))
      end
    end

    class Window
      attr_accessor orders, framing, partitions
      include WindowMethods
      def initialize(w)
        @orders = Any[]
        @partitions = Any[]
      end
    end

    class NamedWindow
      attr_accessor name, orders, framing, partitions
      include WindowMethods
      def initialize(w)
        @orders = Any[]
        @partitions = Any[]
      end
    end

    class Rows
      attr_accessor expr
      include Unary
    end

    class Range
      attr_accessor expr
      include Unary
    end

    class CurrentRow
      include Node
    end

    class Preceding
      attr_accessor expr
      include Unary
    end

    class Following
      attr_accessor expr
      include Unary
    end
  end
end
