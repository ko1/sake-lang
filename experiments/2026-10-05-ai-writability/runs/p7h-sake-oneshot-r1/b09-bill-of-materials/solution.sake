def valid_name?(s)
  if String.size(s) < 1 || String.size(s) > 16
    false
  else
    first = String.at(s, 0)
    (first >= "a" && first <= "z") && String.match?(String.slice(s, 1), /^[a-z0-9_]*$/)
  end
end

def valid_money?(s)
  String.match?(s, /^[0-9]+\.[0-9]{2}$/)
end

def valid_quantity?(s)
  String.match?(s, /^[0-9]+$/) && String.to_i(s) >= 1 && String.to_i(s) <= 999
end

def build_quantity?(s)
  String.match?(s, /^[0-9]+$/) && String.to_i(s) >= 1 && String.to_i(s) <= 1000
end

parts = Hash[]
assemblies = Hash[]
line_no = 0

loop do
  line = gets
  break if line == nil
  line_no += 1

  if String.empty?(String.strip(line))
    next
  end

  line_parts = String.split(String.strip(line), /\s+/)
  if Array.size(line_parts) < 1
    next
  end

  cmd = Array.at(line_parts, 0)

  case cmd
  in "PART"
    if Array.size(line_parts) != 3
      puts("line #{line_no}: error: wrong field count")
    else
      name = Array.at(line_parts, 1)
      cost_str = Array.at(line_parts, 2)

      if !valid_name?(name)
        puts("line #{line_no}: error: bad name")
      elsif !valid_money?(cost_str)
        puts("line #{line_no}: error: bad cost")
      elsif Hash.key?(parts, name) || Hash.key?(assemblies, name)
        puts("line #{line_no}: error: duplicate #{name}")
      else
        parts[name] = Float(cost_str)
      end
    end
  in "ASSY"
    if Array.size(line_parts) < 4
      puts("line #{line_no}: error: wrong field count")
    else
      name = Array.at(line_parts, 1)
      labor_str = Array.at(line_parts, 2)
      components = Array.drop(line_parts, 3)

      if !valid_name?(name)
        puts("line #{line_no}: error: bad name")
      elsif !valid_money?(labor_str)
        puts("line #{line_no}: error: bad cost")
      elsif Hash.key?(parts, name) || Hash.key?(assemblies, name)
        puts("line #{line_no}: error: duplicate #{name}")
      else
        parsed_components = Array[]
        error = nil

        Array.each(components) do |comp_text|
          if String.include?(comp_text, ":")
            comp_parts = String.split(comp_text, ":")
            if Array.size(comp_parts) != 2
              error = "bad component #{comp_text}"
            else
              comp_name = Array.at(comp_parts, 0)
              comp_qty_str = Array.at(comp_parts, 1)

              if !valid_quantity?(comp_qty_str)
                error = "bad component #{comp_text}"
              else
                Array.push(parsed_components, {name: comp_name, qty: String.to_i(comp_qty_str)})
              end
            end
          else
            error = "bad component #{comp_text}"
          end
        end

        if error
          puts("line #{line_no}: error: #{error}")
        else
          seen = Set[]
          has_dupe = false
          Array.each(parsed_components) do |comp|
            if Set.include?(seen, comp[:name])
              has_dupe = true
            else
              Set.add(seen, comp[:name])
            end
          end

          if has_dupe
            puts("line #{line_no}: error: repeated component")
          else
            assemblies[name] = {labor: Float(labor_str), components: parsed_components}
          end
        end
      end
    end
  in "BUILD"
    if Array.size(line_parts) != 3
      puts("line #{line_no}: error: wrong field count")
    else
      name = Array.at(line_parts, 1)
      qty_str = Array.at(line_parts, 2)

      if !build_quantity?(qty_str)
        puts("line #{line_no}: error: bad quantity")
      else
        qty = String.to_i(qty_str)

        if !Hash.key?(parts, name) && !Hash.key?(assemblies, name)
          puts("line #{line_no}: cannot build: unknown item #{name}")
        else
          puts("exploded bill for #{name}:")
        end
      end
    end
  else
    puts("line #{line_no}: error: unknown command")
  end
end

puts("parts:")
puts("  none")
