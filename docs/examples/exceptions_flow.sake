ParseError = Exception.new(:line)
OtherError = Exception.new

def parse(s)
  raise ParseError.new("bad", 1) if String.empty?(s)
  String.to_i(s)
end

begin
  parse("1")
rescue OtherError                        # parse never raises OtherError
  p(:never)
end
parse("")                                # nothing rescues this ParseError
