# Not a bug, a limit: a field's type is the union over every instance of the Struct type,
# so reading back "my" hooks value needs a case/in even though this instance only ever holds a B.
class Box
  attr_reader item
end
class A
  attr_reader a
end
class B
  attr_reader b
end
x = Box.new(A.new(1))
y = Box.new(B.new(2))
p(B.get_b(Box.get_item(y)))
