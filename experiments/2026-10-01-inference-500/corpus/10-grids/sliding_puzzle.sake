Node = Struct.new(:f, :g, :state, :seq)

class Node
  include Comparable
  def <=>(a, b)
    if @f != Node.f(b)
      @f <=> Node.f(b)
    else
      Node.seq(b) <=> @seq
    end
  end
end

Heap = Struct.new(:items)

class Heap
  def empty = Heap.new(Node[])
  def size(h) = Array.size(@items)

  def push(h, x)
    Array.push(@items, x)
    i = Array.size(@items) - 1
    while i > 0
      parent = (i - 1) / 2
      break if @items[parent] <= @items[i]
      tmp = @items[parent]
      @items[parent] = @items[i]
      @items[i] = tmp
      i = parent
    end
    h
  end

  def pop(h)
    top = Array.first(@items)
    last = Array.pop(@items)
    return top if Array.empty?(@items)
    @items[0] = last
    i = 0
    n = Array.size(@items)
    while true
      l = 2 * i + 1
      r = l + 1
      m = i
      m = l if l < n && @items[l] < @items[m]
      m = r if r < n && @items[r] < @items[m]
      break if m == i
      tmp = @items[m]
      @items[m] = @items[i]
      @items[i] = tmp
      i = m
    end
    top
  end
end

def goal = "123456780"

def manhattan(state)
  total = 0
  Array.each_with_index(String.chars(state)) do |ch, i|
    next if ch == "0"
    t = String.to_i(ch) - 1
    total += Integer.abs(i / 3 - t / 3) + Integer.abs(i % 3 - t % 3)
  end
  total
end

def solvable?(state)
  tiles = Array.reject(Array.map(String.chars(state)) { String.to_i(it) }) { it == 0 }
  inversions = 0
  Array.each_with_index(tiles) do |a, i|
    Array.each(Array.drop(tiles, i + 1)) { |b| inversions += 1 if a > b }
  end
  Integer.even?(inversions)
end

def neighbours(state)
  z = String.index(state, "0")
  return Array[] unless z
  out = Array[]
  Array.each(Array[[-3, "up"], [3, "down"], [-1, "left"], [1, "right"]]) do |delta, name|
    t = z + delta
    next if t < 0 || t > 8
    next if (delta == -1 || delta == 1) && t / 3 != z / 3
    chars = String.chars(state)
    moved = chars[t]
    chars[t] = chars[z]
    chars[z] = moved
    Array.push(out, [Array.join(chars, ""), name])
  end
  out
end

def solve(start)
  return nil unless solvable?(start)
  heap = Heap.empty
  seq = 0
  Heap.push(heap, Node.new(manhattan(start), 0, start, seq))
  best_g = Hash[start => 0]
  came = Hash[]
  expanded = 0
  while Heap.size(heap) > 0
    node = Heap.pop(heap)
    state = Node.state(node)
    g = Node.g(node)
    next if g > Hash.fetch(best_g, state, g)
    expanded += 1
    if state == goal
      moves = Array[]
      cur = state
      while came[cur]
        prev, name = came[cur]
        Array.unshift(moves, name)
        cur = prev
      end
      return {moves: moves, expanded: expanded}
    end
    Array.each(neighbours(state)) do |nxt, name|
      ng = g + 1
      known = best_g[nxt]
      next if known && known <= ng
      best_g[nxt] = ng
      came[nxt] = [state, name]
      seq += 1
      Heap.push(heap, Node.new(ng + manhattan(nxt), ng, nxt, seq))
    end
  end
  nil
end

def show(state) = Array.join(Array.map(Range.to_a(0..2)) { |r| String.tr(state[(r * 3)...(r * 3 + 3)], "0", ".") }, " / ")

Array.each(Array["123456780", "123456708", "123405786", "413726580", "023156478", "436718520", "150732684", "724506831", "812043765", "123456870"]) do |start|
  result = solve(start)
  if result
    result => {moves:, expanded:}
    puts("#{show(start)}: #{Array.size(moves)} moves, #{expanded} expanded")
    puts("  #{Array.join(moves, " ")}") unless Array.empty?(moves)
  else
    puts("#{show(start)}: unsolvable (odd permutation)")
  end
end
