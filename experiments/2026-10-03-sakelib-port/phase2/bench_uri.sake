require "uri"

# 300 URIs parsed, printed, and merged; a 300-pair form encoded and decoded.
srcs = String[]
Integer.times(300) { |i| Array.push(srcs, "http://user:pw@example#{i}.com:8080/a/b/../c#{i}/./d?q=#{i}&r=x%20y#frag#{i}") }
form = Array[]
Integer.times(300) { |i| Array.push(form, ["key #{i}", "value & 日本 #{i}"]) }
t0 = Time.now
n = 0
Array.each(srcs) do |s|
  u = URI.parse(s)
  n += String.size(URI.to_s(URI.merge(u, "../x/y?z")))
end
enc = URI.encode_www_form(form)
dec = URI.decode_www_form(enc)
el = Time.to_f(Time.now) - Time.to_f(t0)
p [n, String.size(enc), Array.size(dec)]
warn "work #{Float.round(el * 1000)}ms"
