# Non-comparison sorts for a warehouse: counting sort of shipments by zone (stable),
# LSD radix sort of numeric order ids, and a histogram of package weights.

Shipment = Struct.new(:order_id, :zone, :weight)

def counting_sort_by(items, max_key)
  counts = Array[]
  Integer.times(max_key + 1) { Array.push(counts, 0) }
  Array.each(items) { |x| counts[yield(x)] += 1 }
  # prefix sums: starting position for each key
  starts = Array[]
  total = 0
  Array.each(counts) do |c|
    Array.push(starts, total)
    total += c
  end
  out = Array[]
  Integer.times(Array.size(items)) { Array.push(out, nil) }
  Array.each(items) do |x|
    k = yield(x)
    out[starts[k]] = x
    starts[k] += 1
  end
  out
end

def radix_sort(nums, base)
  a = Array.dup(nums)
  maxv = Array.max(a)
  return [a, 0] if maxv == nil
  exp = 1
  passes = 0
  while maxv / exp > 0
    a = counting_sort_by(a, base - 1) { |n| n / exp % base }
    exp *= base
    passes += 1
  end
  [a, passes]
end

def histogram(values, width)
  buckets = Hash.new(0)
  Array.each(values) { |v| buckets[Float.floor(v / width)] += 1 }
  keys = Array.sort(Hash.keys(buckets))
  Array.each(keys) do |b|
    lo = b * width
    label = format("%5.1f-%5.1f", lo, lo + width)
    puts("  #{label} #{"#" * buckets[b]} #{buckets[b]}")
  end
end

shipments = Array[
  Shipment.new(480213, 3, 2.4), Shipment.new(102938, 1, 12.0), Shipment.new(774001, 3, 0.8),
  Shipment.new(300120, 0, 5.5), Shipment.new(102937, 2, 7.25), Shipment.new(999999, 1, 1.1),
  Shipment.new(450000, 0, 3.3), Shipment.new(450001, 3, 9.9), Shipment.new(120, 2, 4.0),
  Shipment.new(661234, 1, 2.2), Shipment.new(480212, 0, 15.75), Shipment.new(5003, 2, 6.6)
]

by_zone = counting_sort_by(shipments, 3) { |s| Shipment.zone(s) }
puts("by zone (stable):")
current = nil
Array.each(by_zone) do |s|
  z = Shipment.zone(s)
  if z != current
    puts("  zone #{z}:")
    current = z
  end
  puts(format("    %06d %6.2fkg", Shipment.order_id(s), Shipment.weight(s)))
end

ids = Array.map(shipments) { |s| Shipment.order_id(s) }
Array.each(Array[10, 16, 256]) do |base|
  sorted, passes = radix_sort(ids, base)
  same = Array.join(sorted, ",") == Array.join(Array.sort(ids), ",")
  puts("radix base #{base}: #{passes} passes, matches sort: #{same}")
end
sorted, _ = radix_sort(ids, 10)
puts("ids: #{Array.join(Array.map(sorted) { |i| format("%06d", i) }, " ")}")

largest_gap = 0
gap_at = nil
Array.each_cons(sorted, 2) do |pair|
  d = pair[1] - pair[0]
  if d > largest_gap
    largest_gap = d
    gap_at = pair[0]
  end
end
puts("largest id gap: #{largest_gap} after #{gap_at}")

empty_sorted, empty_passes = radix_sort(Array[], 10)
puts("empty input: #{empty_passes} passes")
p(empty_sorted)

puts("weight histogram:")
histogram(Array.map(shipments) { |s| Shipment.weight(s) }, 2.5)
heavy = Array.count(shipments) { |s| Shipment.weight(s) >= 10.0 }
puts("heavy parcels: #{heavy}, total #{Float.round(Array.sum(Array.map(shipments) { |s| Shipment.weight(s) }), 2)}kg")
