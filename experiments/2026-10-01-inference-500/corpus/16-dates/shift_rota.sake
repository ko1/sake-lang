# Builds a four-week shift rota greedily: three shifts a day, rest rules
# (11 hours between shifts, at most 5 shifts per week), requested days off,
# and fairness by fewest hours so far. Then prints the rota and per-person totals.

Shift = Struct.new(:name, :start, :hours)
Worker = Struct.new(:name, :off, :assigned, :hours)

def shifts
  Shift[Shift.new("E", 6, 8), Shift.new("L", 14, 8), Shift.new("N", 22, 8)]
end

def dow_names = Array["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

class Worker
  # Absolute hour at which the worker's last shift ended, or nil.
  def last_end(w)
    last = Array.last(@assigned)
    return nil if last == nil
    day, shift = last
    day * 24 + Shift.start(shift) + Shift.hours(shift)
  end

  def shifts_in_week(w, week) = Array.count(@assigned) { |day, shift| day / 7 == week }

  def can_take?(w, day, shift)
    return false if Set.include?(@off, day)
    return false if Array.any?(@assigned) { |d, s| d == day }
    return false if shifts_in_week(w, day / 7) >= 5
    ended = last_end(w)
    return true if ended == nil
    day * 24 + Shift.start(shift) - ended >= 11
  end

  def take(w, day, shift)
    Array.push(@assigned, [day, shift])
    @hours += Shift.hours(shift)
  end
end

def build_rota(workers, days)
  rota = Array[]
  gaps = Array[]
  Integer.times(days) do |day|
    row = Array[]
    Array.each(shifts) do |shift|
      candidates = Array.select(workers) { |w| Worker.can_take?(w, day, shift) }
      pick = Array.min_by(candidates) { |w| Worker.hours(w) * 100 + Array.index(workers, w) }
      if pick
        Worker.take(pick, day, shift)
        Array.push(row, Worker.name(pick))
      else
        Array.push(row, "--")
        Array.push(gaps, [day, Shift.name(shift)])
      end
    end
    Array.push(rota, row)
  end
  [rota, gaps]
end

workers = Array[
  Worker.new("Ada", Set[5, 6], Array[], 0),
  Worker.new("Bo", Set[0, 1, 2], Array[], 0),
  Worker.new("Cy", Set[], Array[], 0),
  Worker.new("Di", Set[12, 13, 19, 20], Array[], 0),
  Worker.new("Ed", Set[7, 8, 9, 10, 11], Array[], 0),
  Worker.new("Flo", Set[26, 27], Array[], 0)
]

rota, gaps = build_rota(workers, 28)

puts("Day        " + Array.join(Array.map(shifts) { |s| format("%-4s", "#{Shift.name(s)}#{format("%02d", Shift.start(s))}") }, " "))
Array.each_with_index(rota) do |row, day|
  sep = day % 7 == 6 ? "\n" : ""
  puts(format("W%d %s %2d  %s%s", day / 7 + 1, dow_names[day % 7], day + 1, Array.join(Array.map(row) { |n| format("%-4s", n) }, " "), sep))
end

puts("Unfilled: #{Array.size(gaps)}#{Array.empty?(gaps) ? "" : " " + Array.join(Array.map(gaps) { |d, s| "day#{d + 1}/#{s}" }, ", ")}")
puts
puts("Who     hours  E  L  N  weekend  max-in-a-week")
Array.each(workers) do |w|
  kinds = Array.tally(Array.map(Worker.assigned(w)) { |day, shift| Shift.name(shift) })
  weekend = Array.count(Worker.assigned(w)) { |day, shift| day % 7 >= 5 }
  per_week = Range.map(0..3) { |wk| Worker.shifts_in_week(w, wk) }
  puts(format("%-6s %6d %2d %2d %2d %8d %8d", Worker.name(w), Worker.hours(w),
              Hash.fetch(kinds, "E", 0), Hash.fetch(kinds, "L", 0), Hash.fetch(kinds, "N", 0), weekend, Array.max(per_week)))
end

hours = Array.map(workers) { |w| Worker.hours(w) }
spread = Array.max(hours) - Array.min(hours)
puts("Spread between most and least hours: #{spread}")

# Verify the rest rule independently from the assignment code.
violations = 0
Array.each(workers) do |w|
  ends = Array.map(Worker.assigned(w)) { |day, shift| [day * 24 + Shift.start(shift), day * 24 + Shift.start(shift) + Shift.hours(shift)] }
  Array.each_cons(ends, 2) do |pair|
    a = pair[0]
    b = pair[1]
    violations += 1 if b[0] - a[1] < 11
  end
end
puts("Rest-rule violations: #{violations}")
