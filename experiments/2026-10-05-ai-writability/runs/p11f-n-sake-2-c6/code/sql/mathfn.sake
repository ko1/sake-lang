# ceil, floor, trunc, mod, pow, sqrt and pi (7). Arguments are read by 7.1, not by numeric prefix.
module MathFn
  module_function

  # The number a function argument means (7.1): INTEGER and REAL as they are, TEXT only if it is
  # wholly a numeric literal; nil (the call gives NULL) otherwise. args has no NULLs.
  def number(v)
    case v
    in String then NumText.parse_whole(v)
    else v
    end
  end

  def to_f(n)
    case n
    in Integer then Integer.to_f(n)
    else n
    end
  end

  # Calls the function `name` (one of those above) with its argument values; NULL if any argument is.
  def call(name, args)
    return Math.PI() if name == "pi"
    nums = Array.map(args) { |v| number(v) }
    return nil if Array.any?(nums) { |n| n == nil }
    x = nums[0]
    case name
    in "ceil" | "ceiling" then keep_integer(x) { |f| Float.ceil(f) }
    in "floor" then keep_integer(x) { |f| Float.floor(f) }
    in "trunc" then keep_integer(x) { |f| Float.truncate(f) }
    in "mod" then fmod(to_f(x), to_f(nums[1]))
    in "pow" | "power" then power(to_f(x), to_f(nums[1]))
    else square_root(to_f(x))
    end
  end

  # An INTEGER stays as it is; a REAL is made whole by the block (which gives an Integer) and stays a REAL.
  def keep_integer(x)
    case x
    in Integer then x
    else Integer.to_f(yield(x))
    end
  end

  # C's fmod: the sign is x's. NULL if y is zero.
  def fmod(x, y)
    return nil if y == 0.0
    r = Float.abs(x) % Float.abs(y)
    x < 0.0 ? -r : r
  end

  # NULL when the result is not a real number (negative base, fractional exponent).
  def power(x, y)
    return nil if x < 0.0 && Integer.to_f(Float.floor(y)) != y
    x ** y
  end

  def square_root(x) = x < 0.0 ? nil : Math.sqrt(x)
end
