# bcrypt (sakelib/bcrypt.sake, the gem's API) over the built-in String.crypt.
require "bcrypt"
pw = BCrypt::Password.create("secret", cost: BCrypt::Engine.MIN_COST)
p([BCrypt::Password.version(pw), BCrypt::Password.cost(pw), String.size(BCrypt::Password.to_s(pw)), String.size(BCrypt::Password.salt(pw))])
p([pw == "secret", pw == "wrong", BCrypt::Password.is_password?(pw, "secret")])
p(BCrypt::Password.new(BCrypt::Password.to_s(pw)) == "secret")
# The OpenBSD test vectors (also the gem's).
Array.each(Any[["U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"],
               ["", "$2a$06$DCq7YPn5Rq63x1Lad4cll.", "$2a$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s."],
               ["0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789chars after 72 are ignored",
                "$2a$05$abcdefghijklmnopqrstuu", "$2a$05$abcdefghijklmnopqrstuu5s2v8.iXieOjg/.AySBTTZIIVFJeBui"]]) do |secret, salt, want|
  got = BCrypt::Engine.hash_secret(secret, salt)
  p(got == want)
end
q = BCrypt::Password.new("$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")
p(q)
puts(q)
p([BCrypt::Password.salt(q), BCrypt::Password.checksum(q), q == "U*U", BCrypt::Engine.autodetect_cost(BCrypt::Password.salt(q))])
p(String.size(BCrypt::Engine.generate_salt(1)), String.start_with?(BCrypt::Engine.generate_salt, "$2a$12$"))
begin
  BCrypt::Password.new("not a hash")
rescue BCrypt::Errors::BCryptError => e
  p(e)
end
begin
  BCrypt::Engine.hash_secret("x", "$2a$05$short")
rescue BCrypt::Errors::InvalidSalt => e
  p(e)
end
