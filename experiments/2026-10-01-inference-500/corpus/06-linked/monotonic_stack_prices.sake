Frame = Struct.new(:value, :min, :max, :below)

class MinMaxStack < {reader: [top, size]}
  def create = MinMaxStack.new(nil, 0)

  def push(s, v)
    t = @top
    lo = t && Frame.get_min(t) < v ? Frame.get_min(t) : v
    hi = t && Frame.get_max(t) > v ? Frame.get_max(t) : v
    @top = Frame.new(v, lo, hi, t)
    @size += 1
    s
  end

  def pop(s)
    t = @top
    return nil unless t
    @top = Frame.get_below(t)
    @size -= 1
    Frame.get_value(t)
  end

  def peek(s) = @top ? Frame.get_value(@top) : nil
  def min(s) = @top ? Frame.get_min(@top) : nil
  def max(s) = @top ? Frame.get_max(@top) : nil
  def empty?(s) = @top == nil
end

def spans(prices)
  st = MinMaxStack.create
  out = Array[]
  Array.each_with_index(prices) do |p, i|
    while MinMaxStack.empty?(st) == false && prices[MinMaxStack.peek(st)] <= p
      MinMaxStack.pop(st)
    end
    prev = MinMaxStack.peek(st)
    Array.push(out, prev ? i - prev : i + 1)
    MinMaxStack.push(st, i)
  end
  out
end

def next_greater(xs)
  st = MinMaxStack.create
  out = Array[]
  Array.each(xs) { Array.push(out, -1) }
  Array.each_with_index(xs) do |x, i|
    while MinMaxStack.empty?(st) == false && xs[MinMaxStack.peek(st)] < x
      out[MinMaxStack.pop(st)] = x
    end
    MinMaxStack.push(st, i)
  end
  out
end

def largest_rectangle(heights)
  st = MinMaxStack.create
  best = 0
  best_at = nil
  i = 0
  n = Array.size(heights)
  while i <= n
    h = i < n ? heights[i] : 0
    if MinMaxStack.empty?(st) || heights[MinMaxStack.peek(st)] <= h
      MinMaxStack.push(st, i)
      i += 1
    else
      top = MinMaxStack.pop(st)
      left = MinMaxStack.peek(st)
      width = left ? i - left - 1 : i
      area = heights[top] * width
      if area > best
        best = area
        best_at = [left ? left + 1 : 0, width, heights[top]]
      end
    end
  end
  [best, best_at]
end

prices = Array[100, 80, 60, 70, 60, 75, 85, 90, 65, 95]
puts("prices: #{Kernel.inspect(prices)}")
puts("spans:  #{Kernel.inspect(spans(prices))}")
puts("next greater: #{Kernel.inspect(next_greater(prices))}")

window = MinMaxStack.create
Array.each(prices) do |p|
  MinMaxStack.push(window, p)
  puts(format("push %3d  min %3d  max %3d  size %d", p, MinMaxStack.min(window), MinMaxStack.max(window), MinMaxStack.get_size(window)))
end
Integer.times(4) do
  v = MinMaxStack.pop(window)
  puts(format("pop  %3d  min %3d  max %3d", v, MinMaxStack.min(window), MinMaxStack.max(window)))
end

Array.each(Array[Array[2, 1, 5, 6, 2, 3], Array[6, 2, 5, 4, 5, 1, 6], Array[3, 3, 3], Array[]]) do |hs|
  area, where = largest_rectangle(hs)
  if where
    start, width, height = where
    puts("#{Kernel.inspect(hs)} -> #{area} (from #{start}, width #{width}, height #{height})")
  else
    puts("#{Kernel.inspect(hs)} -> #{area}")
  end
end
empty = MinMaxStack.create
p([MinMaxStack.pop(empty), MinMaxStack.min(empty), MinMaxStack.peek(empty)])
