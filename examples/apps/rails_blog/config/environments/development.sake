Rails.application.configure(:development) do |config|
  # Settings specified here will take precedence over those in config/application.sake.

  # Make code changes take effect immediately without server restart.
  config.Rails::Application::Configuration.enable_reloading = true

  # Do not eager load code on boot.
  config.Rails::Application::Configuration.eager_load = false

  # Show full error reports.
  config.Rails::Application::Configuration.consider_all_requests_local = true

  # Enable server timing.
  config.Rails::Application::Configuration.server_timing = true

  config.Rails::Application::Configuration.action_controller[:perform_caching] = false

  # Highlight code that triggered redirect in logs.
  config.Rails::Application::Configuration.action_dispatch[:verbose_redirect_logs] = true

  # Annotate rendered view with file names.
  config.Rails::Application::Configuration.action_view[:annotate_rendered_view_with_filenames] = true

  # Raise error when a before_action's only/except options reference missing actions.
  config.Rails::Application::Configuration.action_controller[:raise_on_missing_callback_actions] = true
end
