# Port of activerecord-8.1.3/lib/active_record/translation.rb
#
# Ruby extends a model with Translation (which includes ActiveModel::Translation; here the model has that through
# ActiveModel::API, and a module including it would check its functions without a model): i18n_scope and
# lookup_ancestors are class methods, here functions of the model without an instance. Ruby's lookup_ancestors
# walks superclasses up to the base class; a model's parents here are abstract (no STI), so it is the model alone.

module ActiveRecord
  module Translation
    def lookup_ancestors = String[ModelClass.name(__model)]
    def i18n_scope = :activerecord
  end

  module_function

  # Rails adds active_record/locale/en.yml to I18n.load_path when it loads (after ActiveModel's); here at the first record.
  def load_locale
    once do
      ActiveModel.load_locale
      I18n.load_yaml(File.join(__dir__, "locale/en.yml"))
    end
  end
end
