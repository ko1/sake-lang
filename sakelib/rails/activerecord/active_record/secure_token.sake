# Port of activerecord-8.1.3/lib/active_record/secure_token.rb (partial: on: :initialize is not generated)
#
# Ruby: has_secure_token :token, length: 24 adds a before_create callback that sets the token when blank and
# regenerate_token (update! with a new token); both are generated (generate/features.sake).

require "securerandom"

module ActiveRecord
  module SecureToken
    def base58_alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

    # Ruby: SecureRandom.base58(length)
    def generate_unique_secure_token(length = 24)
      raise ArgumentError, "Token requires a minimum length of 24 characters." if length < 24
      SecureRandom.alphanumeric(length, chars: String.chars(base58_alphabet))
    end
  end
end
