# Port of actionview-8.1.3/lib/action_view/railtie.rb (partial: the logger and annotate_rendered_view_with_filenames (read by the template compiler at generate time); the form and tag defaults of load_defaults 8.1 are the port's fixed values)

module ActionView
  module Railtie
    module_function

    def initializers
      list = Rails::Initializable::Initializer[]
      Rails::Initializable.add(list, :"action_view.set_configs", :action_view)
      list
    end

    def run(config, name)
      case name
      in :"action_view.set_configs" then nil
      else raise ArgumentError, "no initializer #{name}"
      end
      nil
    end
  end
end
