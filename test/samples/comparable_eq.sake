# With Comparable and <=>, == means `a <=> b` is 0 (as Ruby); a type's own == still wins.
Temp = Struct.new(:kelvin, :unit)
class Temp
  include Comparable
  def <=>(a, b) = @kelvin <=> Temp.get_kelvin(b)
end
c = Temp.new(293, :c)
f = Temp.new(293, :f)
p([c == f, c != f, c == Temp.new(300, :c)])
p(Array.include?(Array[f], c))
P = Struct.new(:x, :tag)
p(P.new(1, :a) == P.new(1, :b))
