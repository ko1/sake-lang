State = Struct.new(:t, :y)

def add_scaled(y, h, k)
  Range.map(0...Array.size(y)) { |i| y[i] + h * k[i] }
end

def euler_step(t, y, h)
  k = yield(t, y)
  add_scaled(y, h, k)
end

def midpoint_step(t, y, h)
  k1 = yield(t, y)
  k2 = yield(t + h / 2.0, add_scaled(y, h / 2.0, k1))
  add_scaled(y, h, k2)
end

def rk4_step(t, y, h)
  k1 = yield(t, y)
  k2 = yield(t + h / 2.0, add_scaled(y, h / 2.0, k1))
  k3 = yield(t + h / 2.0, add_scaled(y, h / 2.0, k2))
  k4 = yield(t + h, add_scaled(y, h, k3))
  Range.map(0...Array.size(y)) { |i| y[i] + h / 6.0 * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]) }
end

def integrate(method, y0, t0, t1, steps)
  h = (t1 - t0) / steps
  s = State.new(t0, y0)
  Integer.times(steps) do
    t = State.get_t(s)
    y = State.get_y(s)
    ny = case method
         in :euler then euler_step(t, y, h) { |tt, yy| yield(tt, yy) }
         in :midpoint then midpoint_step(t, y, h) { |tt, yy| yield(tt, yy) }
         in :rk4 then rk4_step(t, y, h) { |tt, yy| yield(tt, yy) }
         end
    State.set_y(s, ny)
    State.set_t(s, t + h)
  end
  s
end

def oscillator(t, y) = Float[y[1], -y[0]]
def energy(y) = 0.5 * (y[0] ** 2 + y[1] ** 2)

methods = Array[:euler, :midpoint, :rk4]

puts("harmonic oscillator, t = 0..10, y(0) = [1, 0]")
Array.each(methods) do |m|
  Array.each(Integer[50, 100, 200]) do |n|
    s = integrate(m, Float[1.0, 0.0], 0.0, 10.0, n) { |t, y| oscillator(t, y) }
    y = State.get_y(s)
    err = Float.abs(y[0] - Math.cos(10.0))
    puts(format("  %-8s n=%3d x=%+.6f err=%.3e energy drift=%+.3e", m, n, y[0], err, energy(y) - 0.5))
  end
end

puts("logistic growth r=0.8 K=100, y(0)=5")
exact = 100.0 / (1.0 + 19.0 * Math.exp(-0.8 * 12.0))
Array.each(methods) do |m|
  s = integrate(m, Float[5.0], 0.0, 12.0, 60) { |t, y| Float[0.8 * y[0] * (1.0 - y[0] / 100.0)] }
  puts(format("  %-8s y(12)=%.6f exact=%.6f", m, State.get_y(s)[0], exact))
end

puts("Lotka-Volterra predator/prey (rk4, h=0.05)")
s = State.new(0.0, Float[40.0, 9.0])
peaks = Array[]
prev_prey = 40.0
rising = false
Integer.times(3000) do
  t = State.get_t(s)
  y = rk4_step(t, State.get_y(s), 0.05) { |tt, v| Float[0.1 * v[0] - 0.02 * v[0] * v[1], 0.01 * v[0] * v[1] - 0.1 * v[1]] }
  State.set_y(s, y)
  State.set_t(s, t + 0.05)
  if rising && y[0] < prev_prey
    Array.push(peaks, [t, prev_prey])
    rising = false
  elsif !rising && y[0] > prev_prey
    rising = true
  end
  prev_prey = y[0]
end
Array.each(peaks) { |t, v| puts(format("  prey peak %.2f at t=%.2f", v, t)) }
final = State.get_y(s)
puts(format("  at t=%.1f prey=%.3f predators=%.3f", State.get_t(s), final[0], final[1]))

puts("convergence order (rk4 on y' = -2ty, y(0)=1, t=0..1)")
prev_err = nil
Array.each(Integer[5, 10, 20, 40]) do |n|
  st = integrate(:rk4, Float[1.0], 0.0, 1.0, n) { |t, y| Float[-2.0 * t * y[0]] }
  err = Float.abs(State.get_y(st)[0] - Math.exp(-1.0))
  order = prev_err ? Math.log2(prev_err / err) : 0.0
  puts(format("  n=%2d err=%.3e observed order=%.2f", n, err, order))
  prev_err = err
end
