let m = {true: "yes", 1: "one", nil: "none", true: "Y"}
m[false] = "no"
m[nil] += "!"
print(m, m[true], m[1], nil in m, keys(m), [1] in m, "true" in m, contains(m, false))
for k, v in m do print(type(k), v)  end
print(has(m, nil), get(m, 0, "d"), del(m, false), len(m), {true: 1} == {1: 1}, {true: 1, nil: 2} == {nil: 2, true: 1})
print(get({false: 0}, false), get({}, [1], 0))
