class Rider
  attr_reader name, from, to, called_at
  attr_accessor boarded_at, arrived_at
  def initialize(r)
    @boarded_at = nil
    @arrived_at = nil
  end
end

def top_floor = 9

def direction_to(from, to)
  if to > from
    :up
  elsif to < from
    :down
  else
    :idle
  end
end

class Car
  attr_reader id, floor, dir, riders, stops, moves

  def initialize(c)
    @dir = :idle
    @riders = nil
    @stops = nil
    @moves = 0
    @riders = Rider[]
    @stops = Set[]
  end

  def to_s(c) = "car #{@id} @#{@floor} #{@dir} load=#{Array.size(@riders)}"

  def cost(c, floor, dir)
    distance = Integer.abs(@floor - floor)
    return distance if @dir == :idle
    heading = direction_to(@floor, floor)
    return distance if heading == @dir && (dir == @dir || heading == :idle)
    distance + 2 * top_floor
  end

  def next_dir(c)
    return :idle if Set.empty?(@stops)
    ahead = Set.select(@stops) { |s| @dir == :up ? s > @floor : s < @floor }
    return @dir if @dir != :idle && !Array.empty?(ahead)
    target = Array.min_by(Set.to_a(@stops)) { |s| Integer.abs(s - @floor) }
    direction_to(@floor, target)
  end

  def step(c, tick, waiting, done)
    @dir = next_dir(c)
    case @dir
    in :up
      @floor += 1
      @moves += 1
    in :down
      @floor -= 1
      @moves += 1
    else
    end
    return unless Set.include?(@stops, @floor)
    Set.delete(@stops, @floor)
    leaving, @riders = Array.partition(@riders) { Rider.to(it) == @floor }
    Array.each(leaving) do |r|
      Rider.set_arrived_at(r, tick)
      Array.push(done, r)
      puts("t=#{tick} #{Rider.name(r)} leaves car #{@id} at #{@floor}")
    end
    boarding = Array.select(waiting) { |r| Rider.from(r) == @floor && Rider.boarded_at(r) == nil }
    Array.each(boarding) do |r|
      Rider.set_boarded_at(r, tick)
      Array.push(@riders, r)
      Set.add(@stops, Rider.to(r))
      puts("t=#{tick} #{Rider.name(r)} boards car #{@id} at #{@floor} -> #{Rider.to(r)}")
    end
    Array.delete_if(waiting) { Rider.boarded_at(it) }
    @dir = next_dir(c) if Set.empty?(@stops)
  end
end

def dispatch(cars, rider)
  dir = direction_to(Rider.from(rider), Rider.to(rider))
  best = Array.min_by(cars) { |c| [Car.cost(c, Rider.from(rider), dir), Car.id(c)] }
  Set.add(Car.stops(best), Rider.from(rider))
  best
end

calls = Array[
  [0, "ann", 0, 7], [0, "ben", 5, 1], [2, "cat", 3, 9], [3, "dan", 8, 0],
  [4, "eve", 1, 4], [6, "fay", 9, 2], [7, "gus", 4, 6], [9, "hal", 0, 3],
  [11, "ivy", 6, 0], [12, "jon", 2, 8], [15, "kim", 7, 5], [16, "lou", 0, 9]
]
riders = Array.map(calls) { |t, name, from, to| Rider.new(name, from, to, t) }
cars = Car[Car.new("A", 0), Car.new("B", 9)]
waiting = Rider[]
done = Rider[]
pending = Array.dup(riders)

tick = 0
while tick < 60
  arriving, pending = Array.partition(pending) { Rider.called_at(it) == tick }
  Array.each(arriving) do |r|
    car = dispatch(cars, r)
    Array.push(waiting, r)
    puts("t=#{tick} #{Rider.name(r)} calls at #{Rider.from(r)}, assigned #{Car.id(car)}")
  end
  Array.each(cars) { |c| Car.step(c, tick, waiting, done) }
  break if Array.empty?(pending) && Array.empty?(waiting) && Array.all?(cars) { Array.empty?(Car.riders(it)) }
  tick += 1
end

puts("--- finished at t=#{tick}")
Array.each(cars) { puts(it) }
total_wait = 0
total_ride = 0
Array.each(Array.sort_by(done) { Rider.name(it) }) do |r|
  wait = Rider.boarded_at(r) - Rider.called_at(r)
  ride = Rider.arrived_at(r) - Rider.boarded_at(r)
  total_wait += wait
  total_ride += ride
  puts(format("%-4s %d->%d wait %2d ride %2d", Rider.name(r), Rider.from(r), Rider.to(r), wait, ride))
end
n = Array.size(done)
puts(format("avg wait %.2f, avg ride %.2f, moves %s", total_wait / Integer.to_f(n), total_ride / Integer.to_f(n),
  Array.join(Array.map(cars) { |c| "#{Car.id(c)}=#{Car.moves(c)}" }, " ")))
unserved = Array.select(riders) { Rider.arrived_at(it) == nil }
puts("unserved: #{Array.size(unserved)}")
