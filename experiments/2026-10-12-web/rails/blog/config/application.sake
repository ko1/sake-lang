# Ruby: config/application.rb + config/environment.rb (require "rails/all"; the app's classes are autoloaded).
# Sake reads every file before running, so the app's files are listed here; tmp/generated/ comes from
# `bin/sake bin/rails.sake generate`.
require "../../rails"
require "../tmp/generated/models"
require "../app/models/*"
require "../app/controllers/*"
require "./routes"
require "../tmp/generated/routes"
require "../tmp/generated/views"
require "../tmp/generated/controllers"

module Blog
  module_function
  def application = once { Rails::Application.new("Blog") }
end
