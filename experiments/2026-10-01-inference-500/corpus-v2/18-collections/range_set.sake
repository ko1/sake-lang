# A RangeSet of Integers stored as sorted, disjoint inclusive Ranges, with | & - operators; used to track
# which ticket numbers were sold, refunded, and scanned.

class RangeSet
  attr_reader ranges
  include Bitwise
  include Arithmetic

  def empty = RangeSet.new(Array[])

  def of(nums)
    s = RangeSet.new(Array[])
    Array.each(nums) { |n| add(s, n..n) }
    s
  end

  def add(s, r)
    lo = Range.begin(r)
    hi = Range.end(r)
    keep = Array[]
    Array.each(@ranges) do |x|
      if Range.end(x) < lo - 1 || Range.begin(x) > hi + 1
        Array.push(keep, x)
      else
        lo = Range.begin(x) if Range.begin(x) < lo
        hi = Range.end(x) if Range.end(x) > hi
      end
    end
    Array.push(keep, lo..hi)
    @ranges = Array.sort_by(keep) { |x| Range.begin(x) }
    s
  end

  def remove(s, r)
    out = Array[]
    Array.each(@ranges) do |x|
      unless Range.overlap?(x, r)
        Array.push(out, x)
        next
      end
      Array.push(out, Range.begin(x)..(Range.begin(r) - 1)) if Range.begin(x) < Range.begin(r)
      Array.push(out, (Range.end(r) + 1)..Range.end(x)) if Range.end(x) > Range.end(r)
    end
    @ranges = out
    s
  end

  def include?(s, n) = Array.any?(@ranges) { |x| Range.cover?(x, n) }

  def size(s) = Array.sum(Array.map(@ranges) { |x| Range.size(x) })

  def |(a, b)
    out = RangeSet.new(Array.dup(@ranges))
    Array.each(RangeSet.get_ranges(b)) { |x| add(out, x) }
    out
  end

  def &(a, b)
    out = Array[]
    Array.each(@ranges) do |x|
      Array.each(RangeSet.get_ranges(b)) do |y|
        lo = Range.begin(x) > Range.begin(y) ? Range.begin(x) : Range.begin(y)
        hi = Range.end(x) < Range.end(y) ? Range.end(x) : Range.end(y)
        Array.push(out, lo..hi) if lo <= hi
      end
    end
    RangeSet.new(out)
  end

  def -(a, b) = Array.reduce(RangeSet.get_ranges(b), RangeSet.new(Array.dup(@ranges))) { |acc, r| remove(acc, r) }

  def gaps(s, within)
    RangeSet.new(Array[within]) - s
  end

  def to_s(s)
    parts = Array.map(@ranges) { |x| Range.begin(x) == Range.end(x) ? Integer.to_s(Range.begin(x)) : "#{Range.begin(x)}-#{Range.end(x)}" }
    "{#{Array.join(parts, ",")}}"
  end
end

sold = RangeSet.empty
Array.each(Array[1..20, 41..60, 21..25, 100..100, 61..70, 30..35]) { |r| RangeSet.add(sold, r) }
puts("sold:     #{sold} (#{RangeSet.size(sold)} tickets)")

refunded = RangeSet.of(Array[5, 6, 7, 33, 100, 64])
puts("refunded: #{refunded}")
valid = sold - refunded
puts("valid:    #{valid} (#{RangeSet.size(valid)})")

scanned = RangeSet.of(Array[1, 2, 3, 4, 5, 8, 9, 10, 44, 45, 46, 99, 100, 101])
puts("scanned:  #{scanned}")
ok = valid & scanned
puts("admitted: #{ok} (#{RangeSet.size(ok)})")
bad = scanned - valid
puts("rejected: #{bad}")
puts("no-shows: #{RangeSet.size(valid - scanned)}")

unsold = RangeSet.gaps(sold, 1..120)
puts("unsold in 1-120: #{unsold}")
largest = Array.max_by(RangeSet.get_ranges(unsold)) { |r| Range.size(r) }
puts("largest unsold block: #{Range.begin(largest)}-#{Range.end(largest)}")
everything = sold | unsold
puts("sold | unsold covers 1-120? #{RangeSet.size(everything) == 120 && Array.size(RangeSet.get_ranges(everything)) == 1}")

Array.each(Array[7, 22, 36, 100, 120]) do |n|
  state = if RangeSet.include?(valid, n)
    "valid"
  elsif RangeSet.include?(refunded, n)
    "refunded"
  elsif RangeSet.include?(sold, n)
    "sold?"
  else
    "unsold"
  end
  puts("ticket #{n}: #{state}")
end

seen = Set[]
dupes = Array.select(Array[3, 9, 3, 44, 9, 9, 70]) { |n| Set.add?(seen, n) == nil }
puts("double scans: #{Array.join(Array.uniq(dupes), ", ")}")
blocks = Array.map(RangeSet.get_ranges(valid)) { |r| Range.size(r) }
puts("valid block sizes: #{Array.join(blocks, " ")}; singles: #{Array.count(blocks) { |n| n == 1 }}")
