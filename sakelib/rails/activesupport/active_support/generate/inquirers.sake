# (Sake only) The generator for StringInquirer and ArrayInquirer predicates: Ruby answers `env.production?` and
# `variants.phone?` in method_missing; Sake needs each name as a function, so the program lists the names:
#   generate "rails/activesupport/active_support/generate/inquirers", "production", "development", "phone"
# prints, for each name, `def production?(x) = inquire(x, :production?)` in both classes.

Array.each(ARGV) do |name|
  raise ArgumentError, "not a method name: #{name}" unless String.match?(name, /\A[a-z_][a-z0-9_]*\z/)
end
["ActiveSupport::StringInquirer", "ActiveSupport::ArrayInquirer"].Tuple.to_a.Array.each do |klass|
  puts "class #{klass}"
  Array.each(ARGV) { |name| puts "  def #{name}?(x) = inquire(x, :#{name}?)" }
  puts "end"
end
