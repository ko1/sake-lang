# A generator that compiles a tiny template language: `<%= expr %>` in a text file becomes a function
# render_NAME(user) returning the text with each expression interpolated. Each line carries its origin.
path = Array.first(ARGV) || ""
name = File.basename(path, ".txt")
puts "def render_#{name}(user)"
puts "  out = String[]"
Array.each_with_index(String.lines(File.read(path))) do |line, i|
  code = String.gsub(Kernel.inspect(line), /<%= (.*?) %>/) { |m| "\#{#{String.[](m, 4, String.length(m) - 7)}}" }
  puts "# sake-origin: #{path}:#{i + 1}"
  puts "  Array.push(out, #{code})"
end
puts "# sake-origin: none"
puts "  Array.join(out)"
puts "end"
