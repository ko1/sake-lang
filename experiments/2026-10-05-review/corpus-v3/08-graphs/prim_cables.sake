class Point
  attr_reader x, y
  include Arithmetic
  def -(a, b) = Point.new(@x - Point.get_x(b), @y - Point.get_y(b))
  def +(a, b) = Point.new(@x + Point.get_x(b), @y + Point.get_y(b))
  def length(p) = Math.hypot(@x, @y)
  def to_s(p) = format("(%.1f, %.1f)", @x, @y)
end

class Site
  attr_reader name, pos
end

def pi = 3.141592653589793

def dist(a, b) = Point.length(Site.get_pos(a) - Site.get_pos(b))

# Prim's algorithm on the complete graph, O(n^2) with a plain array of best links.
def prim(sites)
  n = Array.size(sites)
  in_tree = Array.new(n, false)
  best = Array.new(n)
  link = Array.new(n)
  best[0] = 0.0
  edges = Array[]
  Integer.times(n) do
    u = nil
    Integer.times(n) do |i|
      next if in_tree[i] || best[i] == nil
      u = i if u == nil || best[i] < best[u]
    end
    in_tree[u] = true
    Array.push(edges, [link[u], u, best[u]]) if link[u]
    Integer.times(n) do |v|
      next if in_tree[v]
      d = dist(sites[u], sites[v])
      if best[v] == nil || d < best[v]
        best[v] = d
        link[v] = u
      end
    end
  end
  edges
end

def centroid(sites)
  sum = Array.reduce(sites, Point.new(0.0, 0.0)) { |acc, s| acc + Site.get_pos(s) }
  n = Array.size(sites)
  Point.new(Point.get_x(sum) / n, Point.get_y(sum) / n)
end

def plan(title, raw)
  sites = Array.map(raw) { |name, x, y| Site.new(name, Point.new(x, y)) }
  puts("== #{title}: #{Array.size(sites)} sites")
  edges = prim(sites)
  total = 0.0
  Array.each(edges) do |a, b, d|
    total += d
    puts(format("  %-7s - %-7s %6.2f km", Site.get_name(sites[a]), Site.get_name(sites[b]), d))
  end
  puts(format("  total cable: %.2f km", total))
  longest = Array.max_by(edges) { |a, b, d| d }
  if longest
    a, b, d = longest
    puts(format("  longest run: %s-%s", Site.get_name(sites[a]), Site.get_name(sites[b])))
  end
  degree = Hash.new(0)
  Array.each(edges) do |a, b, d|
    degree[a] += 1
    degree[b] += 1
  end
  hub, deg = Hash.max_by(degree) { |i, c| c } || [0, 0]
  puts("  busiest junction: #{Site.get_name(sites[hub])} (#{deg} cables)")
  puts("  centre of sites: #{centroid(sites)}")
end

plan("farm sensors", Array[
  ["barn", 0.0, 0.0], ["silo", 1.5, 0.5], ["pump", 4.0, 1.0], ["gate", 0.5, 3.5],
  ["pond", 5.5, 4.0], ["field1", 2.5, 2.5], ["field2", 3.5, 5.0], ["house", -1.0, 1.5],
  ["shed", 6.0, 0.0], ["well", 2.0, -1.5]
])
plan("ring of towers", Range.map(0...6) { |i|
  ang = i * pi / 3
  ["t#{i}", Float.round(Math.cos(ang) * 10, 3), Float.round(Math.sin(ang) * 10, 3)]
})
plan("single", Array[["solo", 1.0, 1.0]])
