# Port of actionview-8.1.3/lib/action_view/helpers/tags/label.rb
#
# Ruby's `label(:post, :title) { |builder| ... }` passes the LabelBuilder to the block (capture(builder, &block)).

require "base"
require "translator"

module ActionView
  module Helpers
    module Tags
      class Label < Base
        attr_accessor content

        class LabelBuilder
          attr_reader template_object, object_name, method_name, object, tag_value

          def translation(b)
            method_and_value = Object.present?(@tag_value) ? "#{@method_name}.#{@tag_value}" : @method_name
            content = Translator.translate(Translator.make(@object, @object_name, method_and_value, scope: "helpers.label"))
            content || String.humanize(@method_name)
          end

          def to_s(b) = translation(b)
        end

        def render(t)
          options = Hash.stringify_keys(@options)
          tag_value = Hash.delete(options, "value")
          add_default_name_and_field_for_value(t, tag_value, options, "for")
          Hash.delete(options, "index")
          Hash.delete(options, "name")
          Hash.delete(options, "namespace")
          builder = LabelBuilder.new(@template_object, @object_name, @method_name, @object, tag_value)
          content = if block_given?
                      CaptureHelper.capture(@template_object) { yield(builder) }
                    elsif TagHelper.present_content?(@content)
                      Object.html_text(@content)
                    else
                      render_component(t, builder)
                    end
          # Ruby: label_tag(...), whose content_tag is this tag's (with the error wrapping)
          error_wrapping(t, FormTagHelper.label_tag(@template_object, options["for"], content, options))
        end

        # private
        def render_component(t, builder) = LabelBuilder.translation(builder)
      end
    end
  end
end
