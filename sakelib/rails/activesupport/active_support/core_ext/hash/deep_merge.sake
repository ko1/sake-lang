# Port of activesupport-8.1.3/lib/active_support/core_ext/hash/deep_merge.rb and deep_mergeable.rb (Sake needs them together)

class Hash
  # Ruby: deep_merge(other) { |key, this_val, other_val| ... }
  def deep_merge(h, other)
    if block_given?
      Hash.deep_merge!(Hash.dup(h), other) { |k, a, b| yield(k, a, b) }
    else
      Hash.deep_merge!(Hash.dup(h), other)
    end
  end

  # Ruby's DeepMergeable#deep_merge!: Hashes under the same key are merged recursively; the block decides the rest.
  def deep_merge!(h, other)
    Hash.each(other) do |key, other_val|
      if Hash.key?(h, key)
        this_val = h[key]
        if (this_val in Hash) && (other_val in Hash)
          h[key] = block_given? ? Hash.deep_merge(this_val, other_val) { |k, a, b| yield(k, a, b) } : Hash.deep_merge(this_val, other_val)
        elsif block_given?
          h[key] = yield(key, this_val, other_val)
        else
          h[key] = other_val
        end
      else
        h[key] = other_val
      end
    end
    h
  end

  def deep_merge?(h, other) = (other in Hash)
end
