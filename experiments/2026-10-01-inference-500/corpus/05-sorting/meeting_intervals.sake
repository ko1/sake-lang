# Calendar analysis: sort meetings by start, merge overlapping busy blocks,
# list free slots, and count rooms needed with a sorted sweep.

Meeting = Struct.new(:title, :start, :finish, :room)

class Meeting
  def minutes(m) = @finish - @start
  def to_s(m) = "#{@title} #{clock(@start)}-#{clock(@finish)}"
end

InvalidMeeting = Exception.new(:title)

def clock(t) = format("%02d:%02d", t / 60, t % 60)

def parse_clock(s)
  parts = String.split(s, ":")
  String.to_i(parts[0]) * 60 + String.to_i(parts[1])
end

def make(title, from, to, room)
  start = parse_clock(from)
  finish = parse_clock(to)
  raise InvalidMeeting.new("ends before it starts", title) if finish <= start
  Meeting.new(title, start, finish, room)
end

def merge_busy(meetings)
  sorted = Array.sort_by(meetings) { |m| Meeting.start(m) }
  blocks = Array[]
  Array.each(sorted) do |m|
    last = Array.last(blocks)
    if last && Meeting.start(m) <= last[1]
      last[1] = Meeting.finish(m) if Meeting.finish(m) > last[1]
    else
      Array.push(blocks, [Meeting.start(m), Meeting.finish(m)])
    end
  end
  blocks
end

def free_slots(blocks, day_start, day_end, min_len)
  slots = Array[]
  cursor = day_start
  Array.each(blocks) do |s, f|
    Array.push(slots, [cursor, s]) if s - cursor >= min_len
    cursor = f if f > cursor
  end
  Array.push(slots, [cursor, day_end]) if day_end - cursor >= min_len
  slots
end

def rooms_needed(meetings)
  starts = Array.sort(Array.map(meetings) { |m| Meeting.start(m) })
  ends = Array.sort(Array.map(meetings) { |m| Meeting.finish(m) })
  i = 0
  j = 0
  current = 0
  peak = 0
  peak_at = nil
  while i < Array.size(starts)
    if starts[i] < ends[j]
      current += 1
      if current > peak
        peak = current
        peak_at = starts[i]
      end
      i += 1
    else
      current -= 1
      j += 1
    end
  end
  [peak, peak_at]
end

input = Array[
  ["standup", "09:00", "09:15", "A"], ["design review", "10:00", "11:30", "B"],
  ["1:1 kana", "10:30", "11:00", "A"], ["lunch talk", "12:00", "13:00", "C"],
  ["hiring sync", "11:15", "12:15", "A"], ["retro", "15:00", "16:00", "B"],
  ["broken", "14:00", "13:30", "C"], ["vendor call", "15:30", "16:15", "B"],
  ["planning", "16:15", "17:00", "B"]
]

meetings = Array[]
Array.each(input) do |title, from, to, room|
  begin
    Array.push(meetings, make(title, from, to, room))
  rescue InvalidMeeting => e
    puts("skipped #{InvalidMeeting.title(e)}: #{Exception.message(e)}")
  end
end

puts("agenda:")
Array.each(Array.sort_by(meetings) { |m| Meeting.start(m) }) { |m| puts("  #{m} [#{Meeting.room(m)}]") }

blocks = merge_busy(meetings)
puts("busy: " + Array.join(Array.map(blocks) { |s, f| "#{clock(s)}-#{clock(f)}" }, ", "))
busy_total = Array.sum(Array.map(blocks) { |s, f| f - s })
puts("busy minutes: #{busy_total}, booked minutes: #{Array.sum(Array.map(meetings) { |m| Meeting.minutes(m) })}")
free = free_slots(blocks, parse_clock("09:00"), parse_clock("17:30"), 30)
puts("free (>= 30 min): " + Array.join(Array.map(free) { |s, f| "#{clock(s)}-#{clock(f)}" }, ", "))

peak, at = rooms_needed(meetings)
puts("rooms needed: #{peak} (first reached at #{clock(at)})")

by_room = Array.group_by(meetings) { |m| Meeting.room(m) }
Array.each(Array.sort(Hash.keys(by_room))) do |room|
  ms = Array.sort_by(by_room[room]) { |m| Meeting.start(m) }
  clashes = Array[]
  Array.each_cons(ms, 2) do |pair|
    Array.push(clashes, "#{Meeting.title(pair[0])}/#{Meeting.title(pair[1])}") if Meeting.start(pair[1]) < Meeting.finish(pair[0])
  end
  status = Array.empty?(clashes) ? "ok" : "double-booked: #{Array.join(clashes, ", ")}"
  puts("room #{room}: #{Array.size(ms)} meetings, #{status}")
end
longest = Array.max_by(meetings) { |m| Meeting.minutes(m) }
puts("longest: #{longest}")
