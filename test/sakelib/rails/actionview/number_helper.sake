require "rails/actionview/action_view/base"

view = ActionView::Base.empty

p ActionView::Base.number_to_phone(view, 5551234)
p ActionView::Base.number_to_phone(view, "5551234")
p ActionView::Base.number_to_phone(view, 1235551234, area_code: true)
p ActionView::Base.number_to_phone(view, 1235551234, delimiter: " ", country_code: 1, extension: 555)
p ActionView::Base.number_to_phone(view, nil)
p ActionView::Base.number_to_currency(view, 1234567890.50)
p ActionView::Base.number_to_currency(view, 1234567890.506, precision: 3)
p ActionView::Base.number_to_currency(view, -1234567890.50, negative_format: "(%u%n)")
p ActionView::Base.number_to_currency(view, 1234567890.50, unit: "&pound;", separator: ",", delimiter: "", format: "%n %u")
p ActionView::Base.number_to_currency(view, 1234567890.50, unit: String.html_safe("&pound;"))
p ActionView::Base.number_to_currency(view, "123a456")
p ActionView::Base.number_to_percentage(view, 100)
p ActionView::Base.number_to_percentage(view, 302.24398923423, precision: 5)
p ActionView::Base.number_to_percentage(view, 1000, delimiter: ".", separator: ",")
p ActionView::Base.number_to_percentage(view, "98a")
p ActionView::Base.number_with_delimiter(view, 12345678)
p ActionView::Base.number_with_delimiter(view, 12345678.05)
p ActionView::Base.number_with_delimiter(view, 12345678, delimiter: ".")
p ActionView::Base.number_with_delimiter(view, "<b>123456</b>")
p ActionView::Base.number_with_precision(view, 111.2345)
p ActionView::Base.number_with_precision(view, 111.2345, precision: 2)
p ActionView::Base.number_with_precision(view, 13, precision: 5, significant: true)
p ActionView::Base.number_with_precision(view, 389.32314, precision: 4, significant: true)
p ActionView::Base.number_with_precision(view, 13.00, precision: 5, strip_insignificant_zeros: true)
p ActionView::Base.number_to_human_size(view, 123)
p ActionView::Base.number_to_human_size(view, 1234567)
p ActionView::Base.number_to_human_size(view, 1234567890, precision: 2)
p ActionView::Base.number_to_human(view, 123)
p ActionView::Base.number_to_human(view, 1234567)
p ActionView::Base.number_to_human(view, 489939, precision: 4)
p ActionView::Base.number_to_human(view, 1234567, units: Hash.of(unit: "m", thousand: "km"))
p Object.html_safe?(ActionView::Base.number_to_currency(view, 12.5)), Object.html_safe?(ActionView::Base.number_to_currency(view, "x"))
begin
  ActionView::Base.number_to_currency(view, "12x", raise: true)
rescue ActionView::Helpers::NumberHelper::InvalidNumberError => e
  p ActionView::Helpers::NumberHelper::InvalidNumberError.number(e)
end
begin
  ActionView::Base.number_to_phone(view, "abc", raise: true)
rescue ActionView::Helpers::NumberHelper::InvalidNumberError => e
  p ActionView::Helpers::NumberHelper::InvalidNumberError.number(e)
end
