<p style="color: green"><%= notice(view) %></p>

<% content_for view, :title, "Posts" %>

<h1>Posts</h1>

<div id="posts">
  <% Array.each(@posts) do |post| %>
    <%= render post %>
    <p>
      <%= link_to "Show this post", post %>
      (<%= pluralize Array.size(Post.comments(post)), "comment" %>, <%= time_ago_in_words Post.created_at(post) %> ago)
    </p>
  <% end %>
</div>

<%= link_to "New post", new_post_path %>
