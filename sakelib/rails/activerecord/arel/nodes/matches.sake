# Port of activerecord-8.1.3/lib/arel/nodes/matches.rb
#
# Ruby's DoesNotMatch < Matches; both are written out. initialize quotes the escape as Ruby's does.

module Arel
  module Nodes
    class Matches
      attr_accessor left, right
      attr_reader escape
      attr_accessor case_sensitive
      include Binary
      def initialize(o)
        e = @escape
        @escape = e == nil ? nil : Nodes.build_quoted(e)
        @case_sensitive ||= false
      end
    end

    class DoesNotMatch
      attr_accessor left, right
      attr_reader escape
      attr_accessor case_sensitive
      include Binary
      def initialize(o)
        e = @escape
        @escape = e == nil ? nil : Nodes.build_quoted(e)
        @case_sensitive ||= false
      end
    end
  end
end
