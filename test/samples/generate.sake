# `generate "gen", args...` runs the generator gen.sake first (stage 0, with args as its ARGV) and joins what it
# prints into the program, as if required; then the whole program is checked and run. Here the generator
# writes a class for each line of lib/gen/records.txt, and another compiles a template to a function.
generate "lib/gen/records", "lib/gen/records.txt"
generate "lib/gen/template", "lib/gen/hello.txt"
generate "lib/gen/records", "lib/gen/records.txt"   # the same generator and arguments: joined once

u = User.new("ko1", 25)
puts User.describe(u)
puts Point.describe(Point.new(3, 4))
puts render_hello(u)
