def add_edge(adj, a, b, lname, m)
  adj[a] = Array[] if adj[a] == nil
  Array.push(adj[a], [b, lname, m])
end

def route(adj, from, to, penalty)
  best = Hash[]
  best[[from, ""]] = [0, 0, Array[from], Array[]]
  changed = true
  while changed
    changed = false
    Array.each(Hash.to_a(best)) do |sk, v|
      st, last = sk
      t, k, sts, lns = v
      edges = adj[st]
      next if edges == nil
      Array.each(edges) do |e|
        to2, ln, mins = e
        nt = t + mins
        nk = k
        if last != "" && last != ln
          nt += penalty
          nk += 1
        end
        nkey = [nt, nk, sts + Array[to2], lns + Array[ln]]
        sk2 = [to2, ln]
        old = best[sk2]
        if old == nil || nkey < old
          best[sk2] = nkey
          changed = true
        end
      end
    end
  end
  res = nil
  Hash.each(best) do |sk, v|
    if sk[0] == to && (res == nil || v < res)
      res = v
    end
  end
  res
end

lines = IO.readlines(IO.stdin)
penalty = 0
got_p = false
in_q = false
known = Hash[]
adj = Hash[]
n = 0
Array.each(lines) do |raw|
  n += 1
  line = String.strip(raw)
  next if String.empty?(line)
  if !got_p
    penalty = String.to_i(line)
    got_p = true
    next
  end
  f = String.split(line, /\s+/)
  if !in_q
    if line == "QUERIES"
      in_q = true
      next
    end
    if Array.size(f) == 4 && String.match?(f[3], /\A[1-9]\d{0,2}\z/) && f[1] != f[2]
      lname, a, b, mins = f
      m = String.to_i(mins)
      known[a] = true
      known[b] = true
      add_edge(adj, a, b, lname, m)
      add_edge(adj, b, a, lname, m)
    else
      puts("invalid segment at line #{n}")
    end
    next
  end
  if Array.size(f) != 2
    puts("invalid query at line #{n}")
    next
  end
  from, to = f
  if !Hash.key?(known, from)
    puts("#{from} -> #{to}: unknown station #{from}")
  elsif !Hash.key?(known, to)
    puts("#{from} -> #{to}: unknown station #{to}")
  elsif from == to
    puts("#{from} -> #{to}: 0 min, 0 transfers")
  else
    r = route(adj, from, to, penalty)
    if r == nil
      puts("#{from} -> #{to}: no route")
    else
      t, k, sts, lns = r
      tw = k == 1 ? "transfer" : "transfers"
      puts("#{from} -> #{to}: #{t} min, #{k} #{tw}")
      legs = Array[]
      Array.each_with_index(lns) do |ln, i|
        if i == 0 || ln != lns[i - 1]
          Array.push(legs, [ln, Array[sts[i], sts[i + 1]]])
        else
          leg = Array.last(legs)
          Array.push(leg[1], sts[i + 1])
        end
      end
      texts = Array.map(legs) { |ln, ss| "#{ln}: #{Array.join(ss, " > ")}" }
      puts("  " + Array.join(texts, "; "))
    end
  end
end
