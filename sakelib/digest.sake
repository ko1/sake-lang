# Digest: MD5, SHA1, SHA256, SHA384, SHA512 written in Sake over a String's bytes.
# Ruby's Digest::MD5 is the type MD5 here (`::` cannot be written); the mixin Digest holds what they share.
# Each algorithm both hashes a String at once (`MD5.hexdigest(s)`, Ruby's class method) and is a
# type for incremental hashing (`md = MD5.new; md << s; MD5.hexdigest(md)`, Ruby's instance method).

module Digest
  include Bitwise                             # for `md << s`
  # Each algorithm defines these.
  def block_length(md) = raise(NotImplementedError)
  def digest_length(md) = raise(NotImplementedError)
  def word_bytes(md) = raise(NotImplementedError)
  def little_endian?(md) = raise(NotImplementedError)
  def initial_state = raise(NotImplementedError)  # the chaining words; also the default of the field h
  def compress(md, h, x, o) = raise(NotImplementedError)
  def name(md) = raise(NotImplementedError)

  def words(md, s) = raise(NotImplementedError)        # String.unpack with the type's literal format
  def pack_words(md, ws) = raise(NotImplementedError)

  # Whole blocks are unpacked to words at once; the rest waits in @pending (a binary String).
  def update(md, s)
    @len += String.bytesize(s)
    buf = String.empty?(@pending) ? String.b(s) : @pending + String.b(s)
    bl = block_length(md)
    n = String.bytesize(buf) / bl * bl
    if n > 0
      compress_words(md, @h, words(md, String.byteslice(buf, 0, n) || ""))
      buf = String.byteslice(buf, n, String.bytesize(buf) - n) || ""
    end
    @pending = buf
    md
  end

  def <<(md, s) = update(md, s)

  def compress_words(md, h, w)
    o = 0
    while o < Array.size(w)
      compress(md, h, w, o)
      o += 16
    end
    h
  end

  # The digest so far, as a binary String; md is left as it is (as Ruby's digest).
  def finish(md)
    bl = block_length(md)
    wb = word_bytes(md)
    pad = Array.new((bl - 2 * wb - 1 - String.bytesize(@pending)) % bl + 1, 0)
    pad[0] = 0x80
    bits = @len * 8
    mask = (1 << (8 * wb)) - 1
    hi = (bits >> (8 * wb)) & mask
    lo = bits & mask
    len = pack_words(md, little_endian?(md) ? Integer[lo, hi] : Integer[hi, lo])
    h = compress_words(md, Array.dup(@h), words(md, @pending + Array.pack(pad, "C*") + len))
    String.byteslice(pack_words(md, h), 0, digest_length(md)) || ""
  end

  # Ruby's class method (x a String) and instance method (x a digest; with s, a one-shot digest of s
  # that leaves x reset) share one name; fresh is a new digest of the type.
  def digest_of(fresh, x, s)
    case x
    in String then finish(update(fresh, x))
    else
      return finish(x) if s == nil
      reset(x)
      d = finish(update(x, s))
      reset(x)
      d
    end
  end

  def finish_hex(md) = Digest.hexencode(finish(md))

  # Ruby's class methods (given a String) and instance methods (given a digest) share these names;
  # `new` is the including type's.
  def digest(x, s = nil) = digest_of(new, x, s)
  def hexdigest(x, s = nil) = Digest.hexencode(digest(x, s))
  def base64digest(x, s = nil) = Array.pack(Array[digest(x, s)], "m0")
  # Ruby's Digest::MD5.file(path) (a new digest) and md.file(path) (md, updated).
  def file(x, path = nil)
    case x
    in String then update(new, File.read(x))
    else update(x, File.read(path))
    end
  end

  # Ruby's md.dup: a copy whose state is its own.
  def dup(md) = new(Array.dup(@h), @pending, @len)

  def reset(md)
    @h = initial_state
    @pending = ""
    @len = 0
    md
  end

  def digest!(md)
    d = finish(md)
    reset(md)
    d
  end

  def hexdigest!(md) = Digest.hexencode(digest!(md))
  def base64digest!(md) = Array.pack(Array[digest!(md)], "m0")
  def size(md) = digest_length(md)
  def length(md) = digest_length(md)
  def to_s(md) = finish_hex(md)
  def inspect(md) = "#<Digest::#{name(md)}: #{finish_hex(md)}>"

  def hexencode(s) = String.unpack1(s, "H*") || ""
  module_function :hexencode
end

class MD5
  private attr_reader h, pending, len
  def initialize(m)
    @h = initial_state if @h == nil
    @pending = "" if @pending == nil
    @len = 0 if @len == nil
  end
  include Digest

  def block_length(md) = 64
  def digest_length(md) = 16
  def word_bytes(md) = 4
  def little_endian?(md) = true
  def words(md, s) = String.unpack(s, "V*")
  def pack_words(md, ws) = Array.pack(ws, "V*")
  def name(md) = "MD5"
  def initial_state = Integer[0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]

  def k = once { Integer[
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
] }

  def shifts = once { Integer[7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
                       5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
                       4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
                       6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21] }

  # One block: the 16 words of x from o; h is updated in place.
  def compress(md, h, x, o)
    kk = k
    r = shifts
    a, b, c, d = h
    i = 0
    while i < 64
      if i < 16
        f = (b & c) | (~b & d)
        g = i
      elsif i < 32
        f = (d & b) | (~d & c)
        g = (5 * i + 1) & 15
      elsif i < 48
        f = b ^ c ^ d
        g = (3 * i + 5) & 15
      else
        f = (c ^ (b | ~d)) & 0xffffffff
        g = (7 * i) & 15
      end
      f = (f + a + kk[i] + x[o + g]) & 0xffffffff
      s = r[i]
      a = d
      d = c
      c = b
      b = (b + (((f << s) | (f >> (32 - s))) & 0xffffffff)) & 0xffffffff
      i += 1
    end
    h[0] = (h[0] + a) & 0xffffffff
    h[1] = (h[1] + b) & 0xffffffff
    h[2] = (h[2] + c) & 0xffffffff
    h[3] = (h[3] + d) & 0xffffffff
    h
  end
end

class SHA1
  private attr_reader h, pending, len
  def initialize(s)
    @h = initial_state if @h == nil
    @pending = "" if @pending == nil
    @len = 0 if @len == nil
  end
  include Digest

  def block_length(md) = 64
  def digest_length(md) = 20
  def word_bytes(md) = 4
  def little_endian?(md) = false
  def words(md, s) = String.unpack(s, "N*")
  def pack_words(md, ws) = Array.pack(ws, "N*")
  def name(md) = "SHA1"
  def initial_state = Integer[0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0]

  def compress(md, h, x, o)
    w = Array.new(16) { |j| x[o + j] }
    i = 16
    while i < 80
      t = w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]
      Array.push(w, ((t << 1) | (t >> 31)) & 0xffffffff)
      i += 1
    end
    a, b, c, d, e = h
    i = 0
    while i < 80
      if i < 20
        f = (b & c) | (~b & d)
        kk = 0x5a827999
      elsif i < 40
        f = b ^ c ^ d
        kk = 0x6ed9eba1
      elsif i < 60
        f = (b & c) | (b & d) | (c & d)
        kk = 0x8f1bbcdc
      else
        f = b ^ c ^ d
        kk = 0xca62c1d6
      end
      t = ((((a << 5) | (a >> 27)) & 0xffffffff) + f + e + kk + w[i]) & 0xffffffff
      e = d
      d = c
      c = ((b << 30) | (b >> 2)) & 0xffffffff
      b = a
      a = t
      i += 1
    end
    h[0] = (h[0] + a) & 0xffffffff
    h[1] = (h[1] + b) & 0xffffffff
    h[2] = (h[2] + c) & 0xffffffff
    h[3] = (h[3] + d) & 0xffffffff
    h[4] = (h[4] + e) & 0xffffffff
    h
  end
end

class SHA256
  private attr_reader h, pending, len
  def initialize(s)
    @h = initial_state if @h == nil
    @pending = "" if @pending == nil
    @len = 0 if @len == nil
  end
  include Digest

  def block_length(md) = 64
  def digest_length(md) = 32
  def word_bytes(md) = 4
  def little_endian?(md) = false
  def words(md, s) = String.unpack(s, "N*")
  def pack_words(md, ws) = Array.pack(ws, "N*")
  def name(md) = "SHA256"
  def initial_state = Integer[
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
]

  def k = once { Integer[
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
] }

  def compress(md, h, x, o)
    kk = k
    w = Array.new(16) { |j| x[o + j] }
    i = 16
    while i < 64
      v = w[i - 15]
      s0 = (((v >> 7) | (v << 25)) ^ ((v >> 18) | (v << 14)) ^ (v >> 3)) & 0xffffffff
      v = w[i - 2]
      s1 = (((v >> 17) | (v << 15)) ^ ((v >> 19) | (v << 13)) ^ (v >> 10)) & 0xffffffff
      Array.push(w, (w[i - 16] + s0 + w[i - 7] + s1) & 0xffffffff)
      i += 1
    end
    a, b, c, d, e, f, g, hh = h
    i = 0
    while i < 64
      s1 = (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & 0xffffffff
      ch = (e & f) ^ (~e & g)
      t1 = (hh + s1 + ch + kk[i] + w[i]) & 0xffffffff
      s0 = (((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & 0xffffffff
      maj = (a & b) ^ (a & c) ^ (b & c)
      t2 = (s0 + maj) & 0xffffffff
      hh = g
      g = f
      f = e
      e = (d + t1) & 0xffffffff
      d = c
      c = b
      b = a
      a = (t1 + t2) & 0xffffffff
      i += 1
    end
    h[0] = (h[0] + a) & 0xffffffff
    h[1] = (h[1] + b) & 0xffffffff
    h[2] = (h[2] + c) & 0xffffffff
    h[3] = (h[3] + d) & 0xffffffff
    h[4] = (h[4] + e) & 0xffffffff
    h[5] = (h[5] + f) & 0xffffffff
    h[6] = (h[6] + g) & 0xffffffff
    h[7] = (h[7] + hh) & 0xffffffff
    h
  end
end

class SHA512
  private attr_reader h, pending, len
  def initialize(s)
    @h = initial_state if @h == nil
    @pending = "" if @pending == nil
    @len = 0 if @len == nil
  end
  include Digest

  def block_length(md) = 128
  def digest_length(md) = 64
  def word_bytes(md) = 8
  def little_endian?(md) = false
  def words(md, s) = String.unpack(s, "Q>*")
  def pack_words(md, ws) = Array.pack(ws, "Q>*")
  def name(md) = "SHA512"
  def initial_state = Integer[
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
]

  def k = once { Integer[
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
] }

  def compress(md, h, x, o)
    m = 0xffffffffffffffff
    kk = k
    w = Array.new(16) { |j| x[o + j] }
    i = 16
    while i < 80
      v = w[i - 15]
      s0 = (((v >> 1) | (v << 63)) ^ ((v >> 8) | (v << 56)) ^ (v >> 7)) & m
      v = w[i - 2]
      s1 = (((v >> 19) | (v << 45)) ^ ((v >> 61) | (v << 3)) ^ (v >> 6)) & m
      Array.push(w, (w[i - 16] + s0 + w[i - 7] + s1) & m)
      i += 1
    end
    a, b, c, d, e, f, g, hh = h
    i = 0
    while i < 80
      s1 = (((e >> 14) | (e << 50)) ^ ((e >> 18) | (e << 46)) ^ ((e >> 41) | (e << 23))) & m
      ch = (e & f) ^ (~e & g)
      t1 = (hh + s1 + ch + kk[i] + w[i]) & m
      s0 = (((a >> 28) | (a << 36)) ^ ((a >> 34) | (a << 30)) ^ ((a >> 39) | (a << 25))) & m
      maj = (a & b) ^ (a & c) ^ (b & c)
      t2 = (s0 + maj) & m
      hh = g
      g = f
      f = e
      e = (d + t1) & m
      d = c
      c = b
      b = a
      a = (t1 + t2) & m
      i += 1
    end
    h[0] = (h[0] + a) & m
    h[1] = (h[1] + b) & m
    h[2] = (h[2] + c) & m
    h[3] = (h[3] + d) & m
    h[4] = (h[4] + e) & m
    h[5] = (h[5] + f) & m
    h[6] = (h[6] + g) & m
    h[7] = (h[7] + hh) & m
    h
  end
end

# SHA384 is SHA512 from other initial words, keeping 48 bytes (written over SHA512's definitions;
# as in Ruby, a SHA384 is not a SHA512).
class SHA384 < SHA512
  def digest_length(md) = 48
  def name(md) = "SHA384"
  def initial_state = Integer[
    0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
    0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4
]
end
