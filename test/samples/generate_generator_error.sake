# A generator is a program of its own: it is checked before it runs, and its problems, or the error it ends with,
# stop the program before it is checked, each named at its generate statement. generate takes string literals.
generate "lib/gen/broken"
generate "lib/gen/failing", "b"
generate "lib/gen/missing"
generate "lib/gen/adir.sake"
gen = "lib/gen/records"
generate gen

puts "not reached"
