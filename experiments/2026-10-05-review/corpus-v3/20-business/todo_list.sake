class Todo
  attr_reader id, title, priority, due, tags
  attr_accessor done
end

class CommandError < StandardError
  attr_reader line
end

def priority_rank = once { Hash[high: 0, normal: 1, low: 2] }

def parse_priority(s, lineno)
  case s
  in "!!" then :high
  in "!" then :normal
  in "." then :low
  else raise CommandError.new("bad priority '#{s}'", lineno)
  end
end

class TodoList
  attr_reader items, next_id

  def initialize(list)
    @items = nil
    @next_id = 1
    @items = Todo[]
  end

  def add(list, title, priority, due, tags)
    t = Todo.new(@next_id, title, priority, due, tags, false)
    @next_id += 1
    Array.push(@items, t)
    t
  end

  def find(list, id) = Array.find(@items) { |t| Todo.id(t) == id }

  def complete(list, id, lineno)
    t = find(list, id)
    raise CommandError.new("no todo ##{id}", lineno) unless t
    raise CommandError.new("##{id} is already done", lineno) if Todo.done(t)
    Todo.set_done(t, true)
    t
  end

  def ordered(list)
    Array.sort_by(@items) { |t| [Hash.fetch(priority_rank, Todo.priority(t)), Todo.due(t), Todo.id(t)] }
  end

  def pending(list) = Array.reject(ordered(list)) { |t| Todo.done(t) }

  def tagged(list, tag) = Array.select(ordered(list)) { |t| Set.include?(Todo.tags(t), tag) }
end

def show(t)
  mark = Todo.done(t) ? "x" : " "
  tags = Array.join(Array.map(Set.sort(Todo.tags(t))) { |g| "##{g}" }, " ")
  format("[%s] %3d %-6s %s  %-24s %s", mark, Todo.id(t), Symbol.to_s(Todo.priority(t)), Todo.due(t), Todo.title(t), tags)
end

def run(list, script)
  Array.each_with_index(String.lines(script)) do |raw, i|
    lineno = i + 1
    line = String.strip(raw)
    next if String.empty?(line) || String.start_with?(line, "#")
    begin
      cmd, rest = String.split(line, " ", 2)
      case cmd
      in "add"
        m = String.match(rest, /\A(\S+) (\d\d-\d\d) (.*)\z/)
        raise CommandError.new("cannot parse '#{rest}'", lineno) unless m
        words = String.split(m[3], " ")
        tag_words, title_words = Array.partition(words) { |w| String.start_with?(w, "#") }
        tags = Array.to_set(Array.map(tag_words) { |w| String.delete_prefix(w, "#") })
        t = TodoList.add(list, Array.join(title_words, " "), parse_priority(m[1], lineno), m[2], tags)
        puts("added ##{Todo.id(t)} #{Todo.title(t)}")
      in "done"
        t = TodoList.complete(list, String.to_i(rest), lineno)
        puts("done  ##{Todo.id(t)} #{Todo.title(t)}")
      in "list"
        puts("-- #{rest} --")
        shown = rest == "all" ? TodoList.ordered(list) : TodoList.tagged(list, rest)
        Array.each(shown) { |t| puts(show(t)) }
      else
        raise CommandError.new("unknown command '#{cmd}'", lineno)
      end
    rescue CommandError => e
      puts("line #{CommandError.line(e)}: #{Exception.message(e)}")
    end
  end
end

script = <<~TXT
  # weekly plan
  add !! 10-03 Pay office rent #admin #money
  add ! 10-05 Call the accountant #admin
  add . 10-09 Water the plants #office
  add !! 10-02 Send invoice to Acme #money #clients
  add ! 10-02 Order printer toner #office
  add ? 10-04 Something odd
  add ! tomorrow Fix the sign
  done 4
  done 4
  done 17
  add . 10-03 Book team lunch #team #office
  add ! 10-05 Review contracts #clients #admin
  frobnicate now
  done 2
  list all
  list office
  list clients
TXT

list = TodoList.new
run(list, script)

puts
puts("Pending by priority:")
groups = Array.group_by(TodoList.pending(list)) { |t| Todo.priority(t) }
Hash.each(groups) do |prio, ts|
  titles = Array.map(ts) { |t| Todo.title(t) }
  puts("  #{prio}: #{Array.join(titles, ", ")}")
end

tag_counts = Hash.new(0)
Array.each(TodoList.items(list)) do |t|
  Set.each(Todo.tags(t)) { |g| tag_counts[g] += 1 }
end
puts("Tags: " + Array.join(Array.map(Hash.sort_by(tag_counts) { |g, n| g }) { |g, n| "#{g}=#{n}" }, " "))

done = Array.count(TodoList.items(list)) { |t| Todo.done(t) }
total = Array.size(TodoList.items(list))
puts(format("Progress: %d/%d (%.0f%%)", done, total, done * 100.0 / total))
