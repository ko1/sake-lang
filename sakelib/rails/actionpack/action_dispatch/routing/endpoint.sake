# Port of actionpack-8.1.3/lib/action_dispatch/routing/endpoint.rb (partial: engine? is always false (no engines))
#
# Rails' Endpoint is a base class; here a module that a route's app includes (RouteSet::Dispatcher, the redirects,
# Mapper::Constraints, Mounted). `serve(e, req)` is Rails' `serve(req)` for the dispatcher and `call(req.env)` for a
# Rack app; both return Rack's triple. Mounted holds a mounted Rack app (`mount app, at: "/x"`).

require "../app"

module ActionDispatch
  module Routing
    module Endpoint
      def serve(e, req) = raise(NotImplementedError)
      def inspect(e) = raise(NotImplementedError)
      def dispatcher?(e) = false
      def redirect?(e) = false
      def matches?(e, req) = true
      def engine?(e) = false
      def rack_app(e) = e
    end

    # (Sake only) a mounted Rack app: Rails' route app is the Rack app itself
    class Mounted
      attr_reader app
      include Endpoint
      def serve(mt, req) = Rack::App.call(@app, Request.env(req))
      def inspect(mt) = Kernel.inspect(@app)
    end

    # (Sake only) Rails' `to.respond_to?(:to_param)` on a record: a type that includes ToParam is a URL parameter by
    # its to_param (ActiveModel::Conversion includes it); anything else is `to_s`.
    module ToParam
      def to_param(x) = raise(NotImplementedError)

      # (Sake only) a parameter given as is: `post_path(ToParam::Param.new("my-slug"))`
      class Param
        attr_reader value
        include ToParam
        def to_param(pa) = @value
      end
    end
  end
end
