def parse_score(score_str)
  if score_str == "EX"
    Array["EX", 0, 0]
  elsif score_str == "-"
    Array["MISS", 0, 0]
  elsif String.include?(score_str, "/")
    parts = String.split(score_str, "/")
    if Array.length(parts) != 2
      nil
    else
      p_str = Array.at(parts, 0)
      m_str = Array.at(parts, 1)
      p = Kernel.Integer(p_str) rescue nil
      m = Kernel.Integer(m_str) rescue nil
      if p == nil || m == nil || m <= 0 || p > m
        nil
      else
        Array["SCORE", p, m]
      end
    end
  else
    nil
  end
end

lines = Array[]
Array.each(IO.readlines(IO.stdin())) { |line|
  stripped = String.strip(line)
  Array.push(lines, stripped)
}

weights = Hash[]
students = Hash[]
errors = Array[]
line_num = 0

Array.each(lines) { |line|
  line_num = Integer.+(line_num, 1)

  if String.empty?(line) || String.start_with?(line, "#")
    # Skip blank and comment lines
  else
    fields = String.split(line)

    if Array.length(fields) == 3 && Array.at(fields, 0) == "weight"
      category_name = Array.at(fields, 1)
      weight_str = Array.at(fields, 2)

      # Validate weight
      weight_int = Kernel.Integer(weight_str) rescue nil
      if weight_int == nil || Integer.<(weight_int, 1) || Integer.>(weight_int, 100)
        Array.push(errors, Array[line_num, String.%(Kernel.to_s("bad weight %s"), weight_str)])
      elsif Hash.has_key?(weights, category_name)
        Array.push(errors, Array[line_num, String.%(Kernel.to_s("duplicate category %s"), category_name)])
      else
        Hash.store(weights, category_name, weight_int)
      end
    elsif Array.length(fields) == 3
      student_name = Array.at(fields, 0)
      category_name = Array.at(fields, 1)
      score_str = Array.at(fields, 2)

      # Validate format and values
      if !Hash.has_key?(weights, category_name)
        Array.push(errors, Array[line_num, String.%(Kernel.to_s("unknown category %s"), category_name)])
      else
        score_info = parse_score(score_str)
        if score_info == nil
          Array.push(errors, Array[line_num, String.%(Kernel.to_s("bad score %s"), score_str)])
        else
          if !Hash.has_key?(students, student_name)
            Hash.store(students, student_name, Hash[])
          end
          student_data = Hash.fetch(students, student_name)
          if !Hash.has_key?(student_data, category_name)
            Hash.store(student_data, category_name, Array[])
          end
          category_scores = Hash.fetch(student_data, category_name)
          Array.push(category_scores, score_info)
        end
      end
    else
      Array.push(errors, Array[line_num, Kernel.to_s("bad format")])
    end
  end
}

# Output errors
Array.each(errors) { |err|
  err_line = Array.at(err, 0)
  err_msg = Array.at(err, 1)
  puts(String.%(Kernel.to_s("line %s: %s"), Kernel.to_s(err_line), err_msg))
}

# Calculate percentages and grades
results = Array[]
max_name_len = 7

Array.each(Hash.keys(students)) { |name|
  if Integer.<(max_name_len, String.length(name))
    max_name_len = String.length(name)
  end
}

Array.each(Hash.keys(students)) { |student_name|
  student_data = Hash.fetch(students, student_name)

  # Calculate weighted average
  total_weight = 0
  total_weighted_sum = 0.0
  has_score = false

  Array.each(Hash.keys(weights)) { |category|
    if Hash.has_key?(student_data, category)
      scores = Hash.fetch(student_data, category)

      # Filter out EX entries and sum points/maxima
      points = 0
      maxima = 0
      Array.each(scores) { |score_info|
        type_val = Array.at(score_info, 0)
        p_val = Kernel.Integer(Kernel.to_s(Array.at(score_info, 1))) rescue 0
        m_val = Kernel.Integer(Kernel.to_s(Array.at(score_info, 2))) rescue 0
        if type_val != "EX"
          points = Integer.+(points, p_val)
          maxima = Integer.+(maxima, m_val)
        end
      }

      if Integer.>(maxima, 0)
        has_score = true
        weight_val = Hash.fetch(weights, category)
        total_weight = Integer.+(total_weight, weight_val)
        fraction = Float./(Kernel.Float(points), Kernel.Float(maxima))
        weight_float = Kernel.Float(weight_val)
        total_weighted_sum = Float.+(total_weighted_sum, Float.*(weight_float, fraction))
      end
    end
  }

  if has_score
    total_weight_f = Kernel.Float(total_weight)
    percentage = Float./(total_weighted_sum, total_weight_f)
    percent_times_100 = Float.*(percentage, 100.0)
    rounded = Float.round(percent_times_100, 1)

    # Determine grade
    grade = if Float.>=(rounded, 90.0)
      "A"
    elsif Float.>=(rounded, 80.0)
      "B"
    elsif Float.>=(rounded, 70.0)
      "C"
    elsif Float.>=(rounded, 60.0)
      "D"
    else
      "F"
    end

    # Count missing entries
    missing = 0
    Array.each(Hash.keys(weights)) { |category|
      if Hash.has_key?(student_data, category)
        scores = Hash.fetch(student_data, category)
        Array.each(scores) { |score_info|
          type_val = Array.at(score_info, 0)
          if type_val == "MISS"
            missing = Integer.+(missing, 1)
          end
        }
      end
    }

    Array.push(results, Array[student_name, rounded, grade, missing, 1])
  else
    # No percentage
    missing = 0
    Array.each(Hash.keys(weights)) { |category|
      if Hash.has_key?(student_data, category)
        scores = Hash.fetch(student_data, category)
        Array.each(scores) { |score_info|
          type_val = Array.at(score_info, 0)
          if type_val != "EX"
            missing = Integer.+(missing, 1)
          end
        }
      end
    }
    Array.push(results, Array[student_name, 0.0, "-", missing, 0])
  end
}

# Sort results by score descending then name ascending
sorted = Array.sort_by(results) { |r|
  status = Array.at(r, 4)
  name = Array.at(r, 0)
  score = Array.at(r, 1)
  if status == 1
    Array[-score, name]
  else
    Array[1.0, name]
  end
}

# Print header
puts(String.ljust("Student", max_name_len) + "  Score  G  Missing")

# Print rows
all_percentages = Array[]
Array.each(sorted) { |r|
  name = Array.at(r, 0)
  score_val = Array.at(r, 1)
  grade = Array.at(r, 2)
  missing = Array.at(r, 3)
  status = Array.at(r, 4)

  name_col = String.ljust(name, max_name_len)
  if status == 1
    score_col = String.rjust(Kernel.to_s(score_val), 5)
    Array.push(all_percentages, score_val)
  else
    score_col = String.rjust("n/a", 5)
  end

  missing_col = String.rjust(Kernel.to_s(missing), 7)
  puts(String.+(String.+(String.+(String.+(name_col, "  "), score_col), "  "), String.+(grade, String.+(Kernel.to_s("  "), missing_col))))
}

# Class average
if Array.empty?(all_percentages)
  puts("class average: n/a")
else
  sum = Array.sum(all_percentages)
  count = Array.length(all_percentages)
  avg = Float./(Kernel.Float(sum), Kernel.Float(count))
  rounded_avg = Float.round(avg, 1)
  puts(String.+(Kernel.to_s("class average: "), Kernel.to_s(rounded_avg)))
end
