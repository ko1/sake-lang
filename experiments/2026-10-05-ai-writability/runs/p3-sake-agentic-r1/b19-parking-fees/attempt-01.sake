def money(c) = format("%d.%02d", c / 100, c % 100)

def part(r, first, step)
  return 0 if r == 0
  extra = r > 60 ? r - 60 : 0
  first + step * ((extra + 29) / 30)
end

lines = Array.map(IO.readlines(IO.stdin())) { String.chomp(it) }
hd = String.split(lines[0])
first = String.to_i(hd[1])
step = String.to_i(hd[2])
cap = String.to_i(hd[3])
grace = String.to_i(hd[4])

inside = Hash[]
exits = Hash.new(0)
revenue = Hash.new(0)
day = 0
prev = nil
tot_exits = 0
tot_rev = 0

Array.each_with_index(lines) do |line, i|
  next if i == 0
  next if String.strip(line) == ""
  n = i + 1
  toks = String.split(line)
  ok = Array.size(toks) == 3 && String.match?(toks[0], /\A([01]\d|2[0-3]):[0-5]\d\z/) && (toks[1] == "IN" || toks[1] == "OUT") && String.match?(toks[2], /\A[A-Z0-9]{1,8}\z/)
  if !ok
    puts("line #{n}: invalid")
    next
  end
  hm = String.split(toks[0], ":")
  tm = String.to_i(hm[0]) * 60 + String.to_i(hm[1])
  day += 1 if prev != nil && tm < prev
  prev = tm
  abs = day * 1440 + tm
  plate = toks[2]
  if toks[1] == "IN"
    if inside[plate] != nil
      puts("line #{n}: #{plate} already inside")
    else
      inside[plate] = abs
    end
  else
    if inside[plate] == nil
      puts("line #{n}: #{plate} not inside")
    else
      stay = abs - inside[plate]
      Hash.delete(inside, plate)
      fee = 0
      if stay > grace
        dd = stay / 1440
        r = stay % 1440
        pr = part(r, first, step)
        pr = cap if pr > cap
        fee = dd * cap + pr
      end
      puts("#{plate} #{stay / 60}:#{String.rjust(Integer.to_s(stay % 60), 2, "0")} #{money(fee)}")
      exits[plate] += 1
      revenue[plate] += fee
      tot_exits += 1
      tot_rev += fee
    end
  end
end

puts("--- summary")
plates = Array.sort_by(Hash.keys(exits)) { |p| [-revenue[p], p] }
Array.each(plates) { |p| puts("#{p} #{exits[p]} #{money(revenue[p])}") }
puts("total #{tot_exits} #{money(tot_rev)}")
left = Array.sort(Hash.keys(inside))
puts("inside: #{Array.empty?(left) ? "none" : Array.join(left, ", ")}")
