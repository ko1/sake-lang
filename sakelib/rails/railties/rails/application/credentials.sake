# Port of railties-8.1.3/lib/rails/application.rb (partial: credentials, encrypted), rails/application/configuration.rb (partial: secret_key_base, secret_key_base=, credentials_defaults, generate_local_secret) and rails/commands/credentials/credentials_command.rb (partial: show and fetch; edit and diff need an editor and git)
#
#   Ruby                                              Sake (the Application calls these with its config values)
#   config.credentials.content_path / key_path       Rails::Credentials.credentials_defaults(root, env)
#   Rails.application.credentials                    Rails::Credentials.encrypted(root, content_path, key_path: key_path, require_master_key: false)
#   Rails.application.encrypted("config/x.yml.enc")  Rails::Credentials.encrypted(root, "config/x.yml.enc")
#   config.secret_key_base                           Rails::Credentials.secret_key_base(root, env, credentials)
#   config.secret_key_base = v                       Rails::Credentials.checked_secret_key_base(root, env, v)
#   bin/rails credentials:show / credentials:fetch   Rails::Credentials.show(credentials, key_path, content_path) / fetch(...)
#
# Rails memoizes the credentials and the secret in the application; the Application keeps what these return.
# Paths are Strings: Rails.root.join(path) is File.expand_path(path, root).

require "rails/activesupport/active_support/encrypted_configuration"
require "fileutils"

module Rails
  module Credentials
    # Rails' command says the message on stderr and exits 1 (missing_credentials!); here it is raised.
    class MissingCredentials < StandardError
    end

    module_function

    def local?(env) = env == "development" || env == "test"

    def join(root, path) = File.expand_path(path, root)

    # Ruby: Configuration#credentials_defaults, the per-environment file first
    def credentials_defaults(root, env)
      content_path = join(root, "config/credentials/#{env}.yml.enc")
      content_path = join(root, "config/credentials.yml.enc") if !File.exist?(content_path)
      key_path = join(root, "config/credentials/#{env}.key")
      key_path = join(root, "config/master.key") if !File.exist?(key_path)
      [content_path, key_path]
    end

    def encrypted(root, path, key_path: "config/master.key", env_key: "RAILS_MASTER_KEY", require_master_key: false)
      ActiveSupport::EncryptedConfiguration.make(config_path: join(root, path), key_path: join(root, key_path),
                                                 env_key: env_key, raise_if_missing_key: require_master_key)
    end

    # Ruby: Configuration#secret_key_base (the getter's lookup, then the setter's checks)
    def secret_key_base(root, env, credentials)
      return checked_secret_key_base(root, env, generate_local_secret(root)) if ENV.get("SECRET_KEY_BASE_DUMMY")
      from_credentials = ActiveSupport::EncryptedConfiguration.[](credentials, :secret_key_base)
      v = ENV.get("SECRET_KEY_BASE") || from_credentials || (local?(env) ? generate_local_secret(root) : nil)
      checked_secret_key_base(root, env, v)
    end

    def checked_secret_key_base(root, env, new_secret_key_base)
      if new_secret_key_base == nil && local?(env)
        generate_local_secret(root)
      elsif (new_secret_key_base in String) && String.present?(new_secret_key_base)
        new_secret_key_base
      elsif new_secret_key_base != nil
        raise ArgumentError, "`secret_key_base` for #{env} environment must be a type of String`"
      else
        raise ArgumentError, "Missing `secret_key_base` for '#{env}' environment, set this string with `bin/rails credentials:edit`"
      end
    end

    def generate_local_secret(root)
      key_file = join(root, "tmp/local_secret.txt")
      unless File.exist?(key_file)
        random_key = SecureRandom.hex(64)
        FileUtils.mkdir_p(File.dirname(key_file))
        File.write(key_file, random_key)
      end
      File.read(key_file)
    end

    # Ruby: CredentialsCommand#show: `say credentials.read.presence || missing_credentials!`
    def show(credentials, key_path, content_path)
      String.presence(ActiveSupport::EncryptedConfiguration.read(credentials)) || missing_credentials!(credentials, key_path, content_path)
    end

    # Ruby: CredentialsCommand#fetch: the value at a dotted path of the YAML, or "Invalid or missing credential path"
    def fetch(credentials, path, key_path, content_path)
      yaml = ActiveSupport::EncryptedConfiguration.read(credentials)
      missing_credentials!(credentials, key_path, content_path) if String.empty?(yaml)
      value = YAML.load(yaml)
      Array.each(String.split(path, ".")) do |key|
        value = (value in Hash) && Hash.key?(value, key) ? value[key] : raise(MissingCredentials, "Invalid or missing credential path: #{path}")
      end
      Kernel.to_s(value)
    end

    def missing_credentials!(credentials, key_path, content_path)
      if !ActiveSupport::EncryptedConfiguration.key?(credentials)
        raise MissingCredentials, "Missing '#{key_path}' to decrypt credentials. See `bin/rails credentials:help`."
      else
        raise MissingCredentials, "File '#{content_path}' does not exist. Use `bin/rails credentials:edit` to change that."
      end
    end
  end
end
