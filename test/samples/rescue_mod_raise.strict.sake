# `x = f rescue raise(...)`: the raise ends only the rescue path; the checks after it still apply.
def parse(raw, lo, hi)
  n = Integer(raw) rescue raise(ArgumentError, "not an integer: #{raw}")
  raise ArgumentError, "#{n} outside #{lo}..#{hi}" unless n >= lo && n <= hi
  String.upcase(n)
end
p(parse("5", 1, 10))
