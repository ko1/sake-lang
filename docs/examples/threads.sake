# Threads share the variables around their block; a Queue passes values between them.
q = Queue.new
workers = Array.map(Range.to_a(1..3)) do |id|
  Thread.new do
    sum = 0
    Range.each(1..(id * 100)) { |i| sum += i }
    Queue.push(q, [id, sum])
  end
end
Array.each(workers) { |t| Thread.join(t) }
results = Array.sort(Array.new(3) { Queue.pop(q) })
p(results)
lock = Mutex.new
count = 0
ts = Array.map(Range.to_a(1..4)) { Thread.new { Integer.times(1000) { Mutex.synchronize(lock) { count += 1 } } } }
Array.each(ts) { |t| Thread.join(t) }
p(count)
