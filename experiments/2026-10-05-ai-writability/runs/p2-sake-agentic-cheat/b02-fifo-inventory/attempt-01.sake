def money(c)
  a = Arithmetic.abs(c)
  s = "#{a / 100}.#{String.rjust(Integer.to_s(a % 100), 2, "0")}"
  c < 0 ? "-" + s : s
end

def cents(s)
  parts = String.split(s, ".")
  frac = parts[1] || ""
  String.to_i(parts[0]) * 100 + String.to_i(String.ljust(frac, 2, "0"))
end

def good_price(s) = Regexp.match?(/\A\d+(\.\d{1,2})?\z/, s)

def value(qs, cs)
  v = 0
  i = 0
  while i < Array.size(qs)
    v += qs[i] * cs[i]
    i += 1
  end
  v
end

def report(skus, qtys, costs)
  puts(format("%-12s %5s %10s", "SKU", "QTY", "VALUE"))
  tq = 0
  tv = 0
  Array.each(Array.sort(Array.dup(skus))) do |k|
    q = Array.sum(qtys[k])
    v = value(qtys[k], costs[k])
    tq += q
    tv += v
    puts(format("%-12s %5d %10s", k, q, money(v)))
  end
  puts(format("%-12s %5d %10s", "TOTAL", tq, money(tv)))
end

skus = String[]
qtys = Hash[]
costs = Hash[]
revenue = 0
cogs = 0
lineno = 0
while (line = gets)
  lineno += 1
  l = String.strip(String.chomp(line))
  next if String.empty?(l)
  f = String.split(l, " ")
  cmd = f[0]
  n = Array.size(f)
  if cmd != "RECEIVE" && cmd != "SHIP" && cmd != "REPORT"
    puts("line #{lineno}: error: unknown command #{cmd}")
    next
  end
  if cmd == "REPORT"
    if n != 1
      puts("line #{lineno}: error: wrong field count")
    else
      report(skus, qtys, costs)
    end
    next
  end
  if n != 4
    puts("line #{lineno}: error: wrong field count")
    next
  end
  sku = f[1]
  if !Regexp.match?(/\A[A-Z0-9-]{1,12}\z/, sku)
    puts("line #{lineno}: error: bad sku")
    next
  end
  if !Regexp.match?(/\A\d{1,7}\z/, f[2]) || String.to_i(f[2]) < 1 || String.to_i(f[2]) > 1000000
    puts("line #{lineno}: error: bad quantity")
    next
  end
  if !good_price(f[3])
    puts("line #{lineno}: error: bad price")
    next
  end
  q = String.to_i(f[2])
  p4 = cents(f[3])
  if cmd == "RECEIVE"
    if !Hash.key?(qtys, sku)
      Array.push(skus, sku)
      qtys[sku] = Integer[]
      costs[sku] = Integer[]
    end
    Array.push(qtys[sku], q)
    Array.push(costs[sku], p4)
  else
    if !Hash.key?(qtys, sku)
      puts("line #{lineno}: error: unknown sku #{sku}")
      next
    end
    have = Array.sum(qtys[sku])
    if q > have
      puts("line #{lineno}: error: insufficient stock for #{sku} (have #{have}, need #{q})")
      next
    end
    need = q
    cost = 0
    while need > 0
      lq = qtys[sku][0]
      lc = costs[sku][0]
      if lq <= need
        cost += lq * lc
        need -= lq
        Array.shift(qtys[sku])
        Array.shift(costs[sku])
      else
        cost += need * lc
        qtys[sku][0] = lq - need
        need = 0
      end
    end
    rev = q * p4
    revenue += rev
    cogs += cost
    puts("line #{lineno}: shipped #{q} #{sku}: revenue #{money(rev)}, cost #{money(cost)}")
  end
end
puts("== final ==")
report(skus, qtys, costs)
puts("revenue: #{money(revenue)}")
puts("cost of goods sold: #{money(cogs)}")
puts("gross profit: #{money(revenue - cogs)}")
