print(2 ** -1.0, 2.0 ** 3, 4 ** 0.5, 2.0 ** -2, 0.0 ** 0, 0 ** 0.0, 2 ** 10)
print(-2.0 ** 2, (-2.0) ** 2, (-2.0) ** 3.0, 1.5 ** 2 ** 2)
fn try_it(f)
  try
    print(f())
  catch e
    print(e.kind, e.message, e.col)
  end
end
try_it(fn () return 2 ** -1 end)
try_it(fn () return 10.0 ** 400 end)
try_it(fn () return (-8.0) ** 0.5 end)
try_it(fn () return (-8) ** 0.5 end)
try_it(fn () return 0.0 ** -1 end)
try_it(fn () return 2.0 ** "a" end)
