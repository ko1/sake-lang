# Port of activerecord-8.1.3/lib/arel/nodes/cte.rb (partial: no hash/eql?)

module Arel
  module Nodes
    class Cte
      attr_accessor left, right
      attr_reader materialized
      include Binary
      def initialize(o) = nil
      def name(o) = @left
      def relation(o) = @right
      def to_cte(o) = o
      def to_table(o) = Arel::Table.new(Kernel.to_s(@left))
    end
  end
end
