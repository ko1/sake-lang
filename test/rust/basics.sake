class Point
  attr_accessor x, y
  def norm2(p) = @x * @x + @y * @y
end
def twice(x)
  yield(x)
  yield(x + 1)
end
pt = Point.new(3, 4)
pt.Point.x = 5
s = 0
Integer.times(3) { |i| s += i }
Range.each(1..3) { |i| s += i }
xs = Array[1, 2, 3]
Array.each(xs) { |v| s += v }
twice(10) { |v| s += v }
puts(Point.norm2(pt), s, 1.5 * 2, "a" + "b", xs == xs)
p(xs, "q", 2.0, nil, true, [1, "a"])
f = 1.0
puts(Math.sqrt(f), Integer.to_f(s) / 2)
