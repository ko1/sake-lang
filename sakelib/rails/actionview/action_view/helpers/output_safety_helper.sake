# Port of actionview-8.1.3/lib/action_view/helpers/output_safety_helper.rb (partial: to_sentence reads no I18n connectors)

require "../../../activesupport/active_support/core_ext/string/output_safety"

module ActionView
  module Helpers
    module OutputSafetyHelper
      def raw(v, stringish) = String.html_safe(Object.html_text(stringish))

      # Ruby: safe_join(array, sep = $,)
      def safe_join(v, array, sep = nil)
        sep_s = sep == nil ? "" : ActiveSupport::CoreExt::ERBUtil.unwrapped_html_escape(sep)
        String.html_safe(Array.join(Array.map(Array.flatten(array)) { |i| ActiveSupport::CoreExt::ERBUtil.unwrapped_html_escape(i) }, sep_s))
      end

      def to_sentence(v, array, words_connector: ", ", two_words_connector: " and ", last_word_connector: ", and ", locale: nil)
        case Array.length(array)
        in 0 then String.html_safe("")
        in 1 then ActiveSupport::CoreExt::ERBUtil.html_escape(array[0])
        in 2 then safe_join(v, Any[array[0], array[1]], two_words_connector)
        else safe_join(v, Any[safe_join(v, Array.[](array, 0...-1) || Any[], words_connector), last_word_connector, Array.last(array)], nil)
        end
      end
    end
  end
end
