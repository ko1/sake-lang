require "rails/activesupport/active_support/core_ext"

# String (core_ext/string): filters, access, indent, starts_ends_with, exclude, strip
puts "== string"
p(String.squish("  Hello \n  World  "), String.remove("Hello World", /o/, "l"), String.truncate("Once upon a time in a world far far away", 27, separator: " "))
p(String.truncate_words("Once upon a time in a world", 4), String.truncate_bytes("🔪🔪🔪🔪", 9), String.truncate_bytes("abc", 10))
p(String.at("hello", 1), String.from("hello", 2), String.to("hello", 2), String.first("hello", 3), String.last("hello", 2))
p(String.indent("foo\nbar", 2), String.starts_with?("rails", "ra"), String.exclude?("rails", "x"), String.strip_heredoc("    a\n      b\n"))
p(String.blank?("  \n"), String.present?("x"), String.presence(""), Object.blank?(nil), Object.blank?(Any[]), Object.blank?(0), Object.present?(Hash.of(a: 1)))
s = "  dirty  "
String.squish!(s)
p(s)

# Array (core_ext/array): access, grouping, conversions, wrap, extract_options, extract
puts "== array"
xs = Range.to_a(1..7)
p(Array.second(xs), Array.forty_two(xs), Array.from(xs, 5), Array.to(xs, 1), Array.including(xs, 8), Array.excluding(xs, 1, 2))
p(Array.in_groups_of(xs, 3), Array.in_groups_of(xs, 3, false), Array.in_groups(xs, 2), Array.split(xs, 4))
Array.in_groups_of(Range.to_a(1..4), 2) { |g| p(g) }
p(Array.to_sentence(String["ruby", "rails", "sake"]), Array.to_sentence(String["a", "b"], two_words_connector: " or "), Array.to_fs(Any[1, 2], :db), Array.to_fs(Any[], :db))
p(Array.wrap(nil), Array.wrap(Any[1]), Array.wrap("x"))
args = Any[1, 2, Hash.of(verbose: true)]
p(Array.extract_options!(args), args, Array.extract_options!(Any[1]))
nums = Range.to_a(1..10)
odd = Array.extract!(nums) { |n| n % 2 == 1 }
p(odd, nums)

# Enumerable (core_ext/enumerable)
puts "== enumerable"
people = Any[Hash.of(name: "ann", age: 30), Hash.of(name: "bob", age: 25), Hash.of(name: "cy", age: 30)]
p(Array.index_by(people) { |x| x[:name] }.Hash.keys, Array.index_with(String["a", "b"]) { |x| String.upcase(x) }, Array.many?(people), Array.many?(people) { |x| x[:age] == 25 })
p(Array.pluck(people, :name), Array.pluck(people, :name, :age), Array.pick(people, :name), Array.compact_blank(Any[1, "", nil, Any[], "x"]))
p(Array.minimum(String["ccc", "a", "bb"]) { |x| String.size(x) }, Array.maximum(String["ccc", "a", "bb"]) { |x| String.size(x) }, Array.exclude?(Any[1, 2], 3), Array.sole(Any[42]))
p(Array.in_order_of(String["b", "c", "a"], String["a", "b"]) { |x| x }, Array.without(Any[1, 2, 3], 2))

# Hash (core_ext/hash)
puts "== hash"
h = Hash.of(a: 1, b: Hash.of(c: 2, d: Hash.of(e: 3)))
p(Hash.deep_merge(h, Hash.of(b: Hash.of(d: Hash.of(f: 4)))), Hash.reverse_merge(Hash.of(a: 1), Hash.of(a: 2, b: 3)), Hash.with_defaults(Hash.of(x: 1), Hash.of(y: 2)))
p(Hash.stringify_keys(Hash.of(a: 1)), Hash.symbolize_keys(Hash.of("a" => 1)), Hash.deep_stringify_keys(h), Hash.deep_transform_values(h) { |v| v * 10 })
p(Hash.deep_symbolize_keys(Hash.of("x" => Any[Hash.of("y" => 1)])), Hash.compact_blank(Hash.of(a: "", b: 1)), Hash.assert_valid_keys(Hash.of(a: 1), :a, :b))
begin
  Hash.assert_valid_keys(Hash.of(a: 1, z: 2), Any[:a, :b])
rescue ArgumentError => e
  puts Exception.message(e)
end

# Object (core_ext/object): deep_dup, inclusion, to_query / to_param
puts "== object"
orig = Hash.of("list" => Any["a", Hash.of("b" => "c")])
copy = Object.deep_dup(orig)
inner = copy["list"]
inner => Array
Array.push(inner, "d")
p(orig, copy)
p(Object.in?(1, Any[1, 2]), Object.in?(5, 1..3), Object.in?("lo", "hello"), Object.presence_in("x", Any["x", "y"]), Object.presence_in("z", Any["x"]))
begin
  Object.in?(1, 2)
rescue ArgumentError => e
  puts Exception.message(e)
end
p(Object.to_param(nil), Object.to_param(true), Object.to_param(12), Array.to_param(Any[1, "a b", nil]))
p(Hash.to_query(Hash.of(name: "David", nationality: "Danish")), Hash.to_query(Hash.of(user: Hash.of(name: "ann", roles: Any["admin", "dev"]), empty: Any[], q: "a&b")))
p(Hash.to_query(Hash.of(a: 1), "ns"), Object.to_query(Any[], "k"), Object.to_query("x y", "q"), Hash.to_param(Hash.of(b: 2, a: 1)))

# Integer and Numeric (core_ext/integer, core_ext/numeric)
puts "== numeric"
p(Integer.ordinalize(21), Integer.multiple_of?(10, 5), Integer.kilobytes(2), Integer.megabytes(1), Float.kilobytes(1.5), Integer.in_milliseconds(3))
p(Integer.to_fs(1234567, :delimited), Integer.to_fs(5551234, :phone), Float.to_fs(1234.5, :currency), Integer.to_fs(1234567, :human_size), Integer.to_fs(1234567, :human))
