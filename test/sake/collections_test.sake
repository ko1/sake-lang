require "minitest"

# Array, Tuple, Hash, Set, Range: the operations a program uses most, checked against Ruby's results.
suite = Minitest.suite("collections")

Minitest.test(suite, "Array: build, read, grow") do |t|
  a = Array[1, 2, 3]
  Minitest.assert_equal(t, 3, Array.size(a))
  Minitest.assert_equal(t, 1, Array.first(a))
  Minitest.assert_equal(t, Array[1, 2], Array.first(a, 2))
  Minitest.assert_equal(t, 3, Array.last(a))
  Minitest.assert_equal(t, 2, a[1])
  Minitest.assert_equal(t, 3, a[-1])
  Minitest.assert_nil(t, a[9])
  Minitest.assert_equal(t, 2, Array.fetch(a, 1))
  Minitest.assert_equal(t, 0, Array.fetch(a, 9, 0))
  Minitest.assert_match(t, /index 9 outside/, Minitest.assert_raises(t) { Array.fetch(a, 9) })
  Array.push(a, 4, 5)
  Minitest.assert_equal(t, Array[1, 2, 3, 4, 5], a)
  Minitest.assert_equal(t, 5, Array.pop(a))
  Minitest.assert_equal(t, 1, Array.shift(a))
  Array.unshift(a, 0)
  Minitest.assert_equal(t, Array[0, 2, 3, 4], a)
  Minitest.assert_equal(t, Array[0, 2, 3, 4, 9], Array.concat(a, Array[9]))
  Minitest.assert_equal(t, Array[0, 2, 3, 4, 9, 7], a + Array[7])
  Minitest.assert_equal(t, Array[2, 3, 4, 9], a - Array[0])
  Minitest.assert_equal(t, Array[1, 1], Array[1] * 2)
  Minitest.assert(t, Array.include?(a, 9))
  Minitest.assert_equal(t, 4, Array.index(a, 9))
  Minitest.assert_equal(t, Array[nil, nil], Array.new(2))
  Minitest.assert_equal(t, Array[0, 1], Array.new(2) { |i| i })
  Minitest.assert_equal(t, Array[7, 7], Array.new(2, 7))
end

Minitest.test(suite, "Array: iteration and transformation") do |t|
  a = Array[3, 1, 2]
  Minitest.assert_equal(t, Array[6, 2, 4], Array.map(a) { |x| x * 2 })
  Minitest.assert_equal(t, Array[3, 2], Array.select(a) { |x| x > 1 })
  Minitest.assert_equal(t, Array[1], Array.reject(a) { |x| x > 1 })
  Minitest.assert_equal(t, Array[1, 2, 3], Array.sort(a))
  Minitest.assert_equal(t, Array[3, 2, 1], Array.sort_by(a) { |x| -x })
  Minitest.assert_equal(t, Array[2, 1, 3], Array.reverse(a))
  Minitest.assert_equal(t, 6, Array.sum(a))
  Minitest.assert_equal(t, 6, Array.reduce(a, 0) { |acc, x| acc + x })
  Minitest.assert_equal(t, 3, Array.max(a))
  Minitest.assert_equal(t, 1, Array.min(a))
  Minitest.assert_equal(t, 3, Array.max_by(a) { |x| x })
  Minitest.assert_equal(t, 2, Array.find(a) { |x| x.Integer.even? })
  Minitest.assert_equal(t, 2, Array.count(a) { |x| x > 1 })
  Minitest.assert(t, Array.any?(a) { |x| x > 2 })
  Minitest.assert(t, Array.all?(a) { |x| x > 0 })
  Minitest.assert_equal(t, Array[1, 2, 3], Array.uniq(Array[1, 1, 2, 3, 3]))
  Minitest.assert_equal(t, Array[1, 2], Array.compact(Array[1, nil, 2]))
  Minitest.assert_equal(t, Array[1, 2, 3], Array.flatten(Array[Array[1], Array[2, 3]]))
  Minitest.assert_equal(t, Array[2, 4], Array.flat_map(Array[1, 2]) { |x| Array[x * 2] })
  Minitest.assert_equal(t, Array[[1, :a], [2, :b]], Array.zip(Array[1, 2], Array[:a, :b]))
  Minitest.assert_equal(t, Array[[3, 0], [1, 1], [2, 2]], Array.each_with_index(a))
  Minitest.assert_equal(t, Array[Array[3, 1], Array[2]], Array.each_slice(a, 2))
  Minitest.assert_equal(t, Hash[1 => 2, 2 => 1], Array.tally(Array[1, 1, 2]))
  Minitest.assert_equal(t, Hash[true => Array[2], false => Array[3, 1]], Array.group_by(a) { |x| x == 2 })
  Minitest.assert_equal(t, [Array[3, 2], Array[1]], Array.partition(a) { |x| x > 1 })
  Minitest.assert_equal(t, Array[1, 2], Array.take(Array[1, 2, 3], 2))
  Minitest.assert_equal(t, Array[3], Array.drop(Array[1, 2, 3], 2))
  Minitest.assert_equal(t, Hash[a: 1], Array.to_h(Array[[:a, 1]]))
  sum = 0
  Array.each(a) { |x| sum += x }
  Minitest.assert_equal(t, 6, sum)
  Minitest.assert_match(t, /cannot compare/, Minitest.assert_raises(t) { Array.sort(Array[1.0, Float.NAN]) }) # a mixed literal is rejected statically
end

Minitest.test(suite, "typed arrays keep their element type") do |t|
  xs = Integer[1, 2]
  Array.push(xs, 3)
  Minitest.assert_equal(t, Integer[1, 2, 3], xs)
  # `Array.push(xs, "a")` is rejected before the program runs (a type error), so it cannot be tested here.
  Minitest.assert_equal(t, 3, Array.size(xs))
end

Minitest.test(suite, "Tuple: fixed length, positions, destructuring") do |t|
  pair = [1, "a"]
  x, y = pair
  Minitest.assert_equal(t, 1, x)
  Minitest.assert_equal(t, "a", y)
  Minitest.assert_equal(t, 2, Tuple.size(pair))
  Minitest.assert_equal(t, "a", pair[1])
  Minitest.assert_equal(t, Array[1, "a"], Tuple.to_a(pair))
  Minitest.assert_equal(t, 3, Tuple.max([1, 3, 2]))
  # `pair[5]` is rejected before the program runs (the Tuple's length is part of its type).
  Minitest.assert(t, [1, 2] < [1, 3])
  Minitest.assert_equal(t, [1, 2], [1, 2])
end

Minitest.test(suite, "Hash: read, write, iterate, transform") do |t|
  h = Hash[a: 1, b: 2]
  Minitest.assert_equal(t, 1, h[:a])
  Minitest.assert_nil(t, h[:z])
  Minitest.assert_equal(t, 2, Hash.fetch(h, :b))
  Minitest.assert_equal(t, 0, Hash.fetch(h, :z, 0))
  Minitest.assert_match(t, /key not found/, Minitest.assert_raises(t) { Hash.fetch(h, :z) })
  h[:c] = 3
  Minitest.assert_equal(t, 3, Hash.size(h))
  Minitest.assert(t, Hash.key?(h, :c))
  Minitest.assert_equal(t, Array[:a, :b, :c], Hash.keys(h))
  Minitest.assert_equal(t, Array[1, 2, 3], Hash.values(h))
  Minitest.assert_equal(t, 3, Hash.delete(h, :c))
  Minitest.assert_equal(t, Hash[a: 1, b: 2, d: 4], Hash.merge(h, Hash[d: 4]))
  Minitest.assert_equal(t, Hash[a: 10, b: 20], Hash.transform_values(h) { |v| v * 10 })
  Minitest.assert_equal(t, Hash["a" => 1, "b" => 2], Hash.transform_keys(h) { |k| Symbol.to_s(k) })
  Minitest.assert_equal(t, Hash[b: 2], Hash.select(h) { |kv| kv[1] > 1 })
  Minitest.assert_equal(t, Array[[:a, 1], [:b, 2]], Hash.to_a(h))
  Minitest.assert_equal(t, Array["a=1", "b=2"], Hash.map(h) { |kv| "#{kv[0]}=#{kv[1]}" })
  Minitest.assert_equal(t, [:b, 2], Hash.max_by(h) { |kv| kv[1] })
  Minitest.assert_equal(t, Hash[1 => :a, 2 => :b], Hash.invert(h))
  Minitest.assert_equal(t, :a, Hash.key(h, 1))
  keys = Array[]
  Hash.each(h) { |kv| Array.push(keys, kv[0]) }
  Minitest.assert_equal(t, Array[:a, :b], keys)
  counts = Hash.new(0)
  counts["x"] += 1
  counts["x"] += 1
  Minitest.assert_equal(t, 2, counts["x"])
  Minitest.assert_equal(t, 0, counts["y"])
  Minitest.assert_match(t, /cannot be a Hash key/, Minitest.assert_raises(t) { Hash.store(Hash[], /re/, 1) })
end

Minitest.test(suite, "Set: membership and algebra") do |t|
  s = Set[1, 2]
  Set.add(s, 3)
  Minitest.assert(t, Set.include?(s, 3))
  Minitest.assert_nil(t, Set.add?(s, 3))
  Minitest.assert_equal(t, 3, Set.size(s))
  Minitest.assert_equal(t, Set[1, 2, 3, 4], s | Set[4])
  Minitest.assert_equal(t, Set[2], s & Set[2, 9])
  Minitest.assert_equal(t, Set[1, 3], s - Set[2])
  Minitest.assert(t, Set.subset?(Set[1], s))
  Minitest.assert_equal(t, Array[1, 2, 3], Array.sort(Set.to_a(s)))
  Minitest.assert_equal(t, Array[2, 4, 6], Array.sort(Set.map(s) { |x| x * 2 }))
  Minitest.assert_equal(t, Array[1, 2], Set.select(s) { |x| x < 3 }) # an Array, as Ruby 4.0 gives
  Minitest.assert_equal(t, Set[1, 2], Array.to_set(Array[1, 2, 2]))
end

Minitest.test(suite, "Range: iteration, membership, conversion") do |t|
  r = 1..4
  Minitest.assert_equal(t, Array[1, 2, 3, 4], Range.to_a(r))
  Minitest.assert_equal(t, Array[1, 2, 3], Range.to_a(1...4))
  Minitest.assert_equal(t, 10, Range.sum(r))
  Minitest.assert_equal(t, 4, Range.size(r))
  Minitest.assert(t, Range.include?(r, 3))
  Minitest.refute(t, Range.cover?(r, 5))
  Minitest.assert_equal(t, Array[2, 4, 6, 8], Range.map(r) { |x| x * 2 })
  Minitest.assert_equal(t, Array[2, 4], Range.select(r) { |x| x % 2 == 0 })
  Minitest.assert_equal(t, Array[1, 3], Range.step(1..4, 2) { |x| x } ? Array.select(Range.to_a(r)) { |x| x % 2 == 1 } : Array[])
  Minitest.assert_equal(t, 1, Range.begin(r))
  Minitest.assert_equal(t, 4, Range.end(r))
  Minitest.assert_equal(t, Array["a", "b", "c"], Range.to_a("a".."c"))
  Minitest.assert_equal(t, 5, Range.first(5..))
  Minitest.assert_match(t, /endless/, Minitest.assert_raises(t) { Range.to_a(1..) })
  # `Range.to_a(1.0..2.0)` is rejected before the program runs (a Range of Floats cannot be walked).
end

Minitest.run(suite)
