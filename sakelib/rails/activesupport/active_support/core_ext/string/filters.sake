# Port of activesupport-8.1.3/lib/active_support/core_ext/string/filters.rb

class String
  def squish(s) = String.squish!(dup(s))

  def squish!(s)
    String.gsub!(s, /[[:space:]]+/, " ")
    String.strip!(s)
    s
  end

  def remove(s, *patterns) = String.remove!(dup(s), *patterns)

  def remove!(s, *patterns)
    Array.each(patterns) { |pattern| String.gsub!(s, pattern, "") }
    s
  end

  # Ruby: truncate(truncate_to, options = {}) with :omission and :separator (a String or a Regexp).
  def truncate(s, truncate_to, omission: "...", separator: nil)
    return dup(s) unless String.length(s) > truncate_to
    length_with_room_for_omission = truncate_to - String.length(omission)
    stop = if separator
             String.rindex(s, separator, length_with_room_for_omission) || length_with_room_for_omission
           else
             length_with_room_for_omission
           end
    "#{String.[](s, 0, stop) || ""}#{omission}"
  end

  def truncate_bytes(s, truncate_to, omission: "…")
    if String.bytesize(s) <= truncate_to
      dup(s)
    elsif String.bytesize(omission) > truncate_to
      raise ArgumentError, "Omission #{Kernel.inspect(omission)} is #{String.bytesize(omission)}, larger than the truncation length of #{truncate_to} bytes"
    elsif String.bytesize(omission) == truncate_to
      dup(omission)
    else
      cut = ""
      cut_at = truncate_to - String.bytesize(omission)
      String.each_grapheme_cluster(s) do |grapheme|
        break if String.bytesize(cut) + String.bytesize(grapheme) > cut_at
        cut += grapheme
      end
      cut + omission
    end
  end

  # Ruby: truncate_words(words_count, options = {}) with :omission and :separator (default /\s+/).
  def truncate_words(s, words_count, omission: "...", separator: nil)
    sep = case separator
          in nil then "\\s+"
          in Regexp then Regexp.source(separator)
          in String then Regexp.escape(separator)
          end
    m = String.match(s, Regexp.new("\\A((?>.+?#{sep}){#{words_count - 1}}.+?)#{sep}.*", "m"))
    m ? (m[1] || "") + omission : dup(s)
  end
end
