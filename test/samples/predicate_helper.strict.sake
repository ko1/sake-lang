# A predicate helper whose body is `param in Pattern` narrows its argument where it is used as a condition.
def number?(l) = (l in Integer | Float)
def text?(l) = (l in String)
def show(l)
  return puts(String.upcase(l)) if text?(l)
  if number?(l)
    p(l + 1)
  else
    p(l)
  end
end
show(1)
show("a")
show(2.5)
show(:sym)
# Thread.raise makes Thread.value raise a RuntimeError, which rescue RuntimeError may catch.
t = Thread.new { Kernel.sleep(5); 1 }
Thread.raise(t, "stop")
begin
  Thread.value(t)
rescue RuntimeError => e
  puts "caught #{Exception.message(e)}"
end
