# sake: --strict=4
# Symbol literals are tracked as values, so a case over them can be shown complete.
def apply(op, a, b)
  case op
  in :add then a + b
  in :sub then a - b
  end
end
p(apply(:add, 1, 2))
p(apply(:sub, 5, 3))

# A String's values are open: no branch for some of them is the `exhaustive` item (level 3).
def kind(s)
  case s
  in "a" then 1
  in "b" then 2
  end
end
p(kind("a"))

# A type with no branch at all is a type problem (level 1).
def size_or(x)
  case x
  in String then String.size(x)
  end
end
p(size_or("abc"))
p(size_or(Integer.succ(41) > 0 ? "ok" : 3))
