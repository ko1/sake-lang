require "rails/actionpack/action_dispatch/middleware/stack"

# The app's env_config, without secret_key_base: the session goes in the signed jar (Rails: encrypted with one).
def configure(req)
  c = ActionDispatch::Request.env_config(req)
  c["action_dispatch.key_generator"] = ActiveSupport::CachingKeyGenerator.new(ActiveSupport::KeyGenerator.new("b" * 64, iterations: 2))
  c["action_dispatch.signed_cookie_salt"] = "signed cookie"
  c["action_dispatch.cookies_serializer"] = :json
  c["action_dispatch.use_cookies_with_metadata"] = true
end

class Endpoint
  include ActionDispatch::App
  def call(e, req)
    session = ActionDispatch::Request.session(req)
    case ActionDispatch::Request.path_info(req)
    in "/login"
      session[:user_id] = 42
    in "/show"
      p([session[:user_id], String.size(Kernel.to_s(session["session_id"])), ActionDispatch::Request::Session.loaded?(session)])
    in "/logout"
      ActionDispatch::Request.reset_session(req)
    else
    end
    [200, Hash.of("content-type" => "text/plain"), String["ok"]]
  end
end

# configure runs before the session middleware, as Rails' env_config is in the env before the stack
class Config
  attr_reader app
  include ActionDispatch::App
  def call(c, req)
    configure(req)
    ActionDispatch::App.call(@app, req)
  end
end
app = ActionDispatch::RackApp.new(Config.new(ActionDispatch::Cookies.new(ActionDispatch::Session::CookieStore.new(Endpoint.new, Hash.of(key: "_app_session")))))

# The cookie's session, with the random id hidden.
def decode(set_cookie)
  return nil unless set_cookie
  value = Rack::Utils.unescape(String.[](set_cookie, /\A_app_session=([^;]*)/, 1) || "")
  envelope = JSON.parse(Base64.strict_decode64(String.split(value, "--")[0] || ""))
  envelope => Hash
  rails = envelope["_rails"]
  rails => Hash
  data = JSON.parse(Base64.strict_decode64(Kernel.to_s(rails["message"])))
  data => Hash
  [rails["pur"], Hash.transform_values(data) { |v| (v in String) && String.size(v) == 32 ? "<sid>" : v }, String.[](set_cookie, /;.*/)]
end

def run(app, path, cookie)
  env = Rack::MockRequest.env_for("http://www.example.com#{path}")
  env["HTTP_COOKIE"] = cookie if cookie
  _, headers, _ = Rack::App.call(app, env)
  h = headers["set-cookie"]
  sc = (h in Array) ? Array.first(h) : h
  p([path, sc ? decode(Kernel.to_s(sc)) : nil])
  sc ? String.[](Kernel.to_s(sc), /\A[^;]*/) : cookie
end

c = run(app, "/show", nil)
c = run(app, "/login", c)
c = run(app, "/show", c)
c = run(app, "/logout", c)
c = run(app, "/show", c)
run(app, "/show", "_app_session=forged--0123")
