ModulusMismatch = Exception.new(:a, :b)
NotInvertible = Exception.new(:value)

class ModInt
  attr_reader v, m
  include Arithmetic

  def of(v, m) = ModInt.new(v % m, m)

  def other(a, b)
    case b
    in Integer then ModInt.of(b, @m)
    in ModInt
      raise ModulusMismatch.new("mod #{@m} vs mod #{ModInt.m(b)}", @m, ModInt.m(b)) if ModInt.m(b) != @m
      b
    end
  end

  def +(a, b) = of(@v + ModInt.v(other(a, b)), @m)
  def -(a, b) = of(@v - ModInt.v(other(a, b)), @m)
  def *(a, b) = of(@v * ModInt.v(other(a, b)), @m)
  def **(a, e) = ModInt.new(Integer.pow(@v, e, @m), @m)

  def inverse(a)
    g = Integer.gcd(@v, @m)
    raise NotInvertible.new("#{@v} has no inverse mod #{@m}", @v) if g != 1
    # extended Euclid
    old_r, r = @v, @m
    old_s, s = 1, 0
    while r != 0
      q = old_r / r
      old_r, r = r, old_r - q * r
      old_s, s = s, old_s - q * s
    end
    of(old_s, @m)
  end

  def /(a, b) = a * inverse(other(a, b))
  def to_s(a) = "#{@v} (mod #{@m})"
end

def prime = 1_000_000_007

def factorials(n, m)
  facts = Array[ModInt.of(1, m)]
  Range.each(1..n) { |i| Array.push(facts, facts[i - 1] * i) }
  facts
end

def binom(facts, n, k)
  return ModInt.of(0, ModInt.m(facts[0])) if k < 0 || k > n
  facts[n] / (facts[k] * facts[n - k])
end

def lucas(n, k, p)
  facts = factorials(p - 1, p)
  result = ModInt.of(1, p)
  while n > 0 || k > 0
    result = result * binom(facts, n % p, k % p)
    n = n / p
    k = k / p
  end
  result
end

def rolling_hash(s, base, m)
  Array.reduce(String.bytes(s), ModInt.of(0, m)) { |h, b| h * base + b }
end

def crt(residues)
  x = 0
  modulus = 1
  Array.each(residues) do |r|
    rv = ModInt.v(r)
    rm = ModInt.m(r)
    # find t with x + modulus * t == rv (mod rm)
    t = (ModInt.of(rv - x, rm) / ModInt.of(modulus, rm))
    x = x + modulus * ModInt.v(t)
    modulus = modulus * rm
  end
  ModInt.of(x, modulus)
end

facts = factorials(1000, prime)
puts("C(10, 3) = #{binom(facts, 10, 3)}")
puts("C(1000, 500) = #{binom(facts, 1000, 500)}")
puts("C(5, 7) = #{binom(facts, 5, 7)}")
row = Range.map(0..10) { |k| ModInt.v(binom(facts, 10, k)) }
puts("row 10: #{Array.join(row, " ")}")
puts("catalan(1..10): #{Array.join(Range.map(1..10) { |n| ModInt.v(binom(facts, 2 * n, n) / (n + 1)) }, " ")}")

puts("== Lucas mod 13 ==")
Array.each(Array[[100, 30], [1000, 1], [2026, 1001], [13, 13]]) do |n, k|
  puts("C(#{n}, #{k}) mod 13 = #{ModInt.v(lucas(n, k, 13))}")
end
exact = Range.reduce(1..30, 1) { |acc, i| acc * (100 - i + 1) / i }
puts("check C(100, 30) mod 13 exactly: #{exact % 13 == ModInt.v(lucas(100, 30, 13))} (C(100, 30) = #{exact})")

puts("== arithmetic mod 17 ==")
a = ModInt.of(5, 17)
b = ModInt.of(13, 17)
puts("a + b = #{a + b}")
puts("a - b = #{a - b}")
puts("a * b = #{a * b}")
puts("a / b = #{a / b}  check: #{(a / b) * b}")
puts("a ** 16 = #{a ** 16} (Fermat)")
puts("a + 100 = #{a + 100}, a * -1 = #{a * -1}")
Array.each(Array[ModInt.of(6, 9), ModInt.of(4, 9)]) do |x|
  begin
    puts("1 / #{x} = #{ModInt.inverse(x)}")
  rescue NotInvertible => e
    puts("error: #{Exception.message(e)}")
  end
end
begin
  puts(a + ModInt.of(1, 19))
rescue ModulusMismatch => e
  puts("error: #{Exception.message(e)}")
end

puts("== CRT ==")
system = Array[ModInt.of(2, 3), ModInt.of(3, 5), ModInt.of(2, 7)]
puts("x = #{Array.join(system, ", ")}  =>  #{crt(system)}")
puts("x = 1 (mod 4), 2 (mod 9), 3 (mod 25) => #{crt(Array[ModInt.of(1, 4), ModInt.of(2, 9), ModInt.of(3, 25)])}")

puts("== rolling hash ==")
words = Array["listen", "silent", "enlist", "google", "listen"]
hashes = Array.map(words) { |w| ModInt.v(rolling_hash(w, 131, prime)) }
Array.each_with_index(words) { |w, i| puts(format("%-7s %10d", w, hashes[i])) }
dupes = Array.select(Array.uniq(words)) { |w| Array.count(words, w) > 1 }
puts("repeated: #{Array.join(dupes, ", ")}; distinct hashes: #{Array.size(Array.uniq(hashes))}")
