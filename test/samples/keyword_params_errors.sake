# Keyword arguments are checked by name against the callee's keyword parameters.
def area(w:, h: w) = w * h
def f(a, b = 1, c: 2) = a + b + c
def g(a) = a
p(area(h: 2))
p(area(w: 1, wdth: 2))
p(f(1, 2, 3))
p(f(1, "c" => 3))
p(f(c: 3))
p(g(k: 1))
p(f(1, cc: 1))
module M
  def m(x, k: 1) = raise NotImplementedError
end
class A < {reader: [:v]}
  include M
  def m(x, j: 1) = j
end
p(M.m(A.new(1), k: 2))
