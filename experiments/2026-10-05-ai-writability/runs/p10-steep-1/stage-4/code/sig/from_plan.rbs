module Sql
  class PlanSource
    attr_reader table: Table?
    attr_reader plan: SelectPlan?
    attr_reader source: Source

    def initialize: (Table? table, SelectPlan? plan, Source source) -> void
  end

  class PlanJoin
    attr_reader kind: Symbol
    attr_reader item: PlanSource
    attr_reader condition: Ast::Expr?

    def initialize: (Symbol kind, PlanSource item, Ast::Expr? condition) -> void
  end

  class FromPlan
    attr_reader first: PlanSource?
    attr_reader joins: Array[PlanJoin]
    attr_reader scope: Scope

    def initialize: (PlanSource? first, Array[PlanJoin] joins, Scope scope) -> void
    def items: () -> Array[PlanSource]
    def self.build: (Ast::FromClause? clause, Scope base) -> FromPlan
    def self.plan_item: (Ast::FromItem item, Scope scope) -> PlanSource
    def self.plan_join: (Ast::Join join, Scope scope) -> [PlanSource, Scope, Ast::Expr?]
    def self.plan_using: (Ast::FromItem from_item, Array[String] names, Scope scope) -> [PlanSource, Scope, Ast::Expr?]
  end
end
