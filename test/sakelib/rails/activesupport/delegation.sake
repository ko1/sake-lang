require "rails/activesupport/active_support/core_ext/module/delegation"

# Module#delegate (core_ext/module/delegation, delegation)
class User
  attr_reader name, email
  def greet(u, other) = "hi #{other}, I am #{@name}"
end

class Post
  attr_reader title, author
end

generate "rails/activesupport/active_support/generate/delegation", "Post", "to=author:User", "name", "greet/1"
generate "rails/activesupport/active_support/generate/delegation", "Post", "to=author:User", "prefix=true", "allow_nil=true", "name", "email"
generate "rails/activesupport/active_support/generate/delegation", "Post", "to=author:User", "prefix=writer", "email"

post = Post.new("Hello", User.new("ann", "ann@example.com"))
p(Post.name(post), Post.greet(post, "bob"), Post.author_name(post), Post.author_email(post), Post.writer_email(post))
orphan = Post.new("Orphan", nil)
p(Post.author_name(orphan))
begin
  Post.name(orphan)
rescue ActiveSupport::DelegationError => e
  puts Exception.message(e)
end
puts(ActiveSupport::Delegation.generate("Post", String["name"], "author:User", "true", true))
