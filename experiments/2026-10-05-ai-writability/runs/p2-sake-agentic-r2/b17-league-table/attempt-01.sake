lines = IO.readlines(IO.stdin)
idx = Hash[]
names = String[]
mh = Integer[]
ma = Integer[]
mg = Integer[]
mb = Integer[]

def team_id(idx, names, nm)
  id = idx[nm]
  if id == nil
    id = Array.size(names)
    idx[nm] = id
    Array.push(names, nm)
  end
  id
end

Array.each_with_index(lines) do |raw, i|
  text = String.chomp(raw)
  next if String.strip(text) == ""
  toks = String.split(text)
  ok = Array.size(toks) == 3
  if ok
    ok = String.match?(toks[0], /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/) && String.match?(toks[2], /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/) && toks[0] != toks[2]
  end
  m = nil
  if ok && toks[1] != "P-P"
    m = String.match(toks[1], /\A(\d{1,2})-(\d{1,2})\z/)
    ok = m != nil
  end
  if !ok
    puts("invalid line #{i + 1}: #{text}")
    next
  end
  h = team_id(idx, names, toks[0])
  a = team_id(idx, names, toks[2])
  if m != nil
    c = MatchData.captures(m)
    Array.push(mh, h)
    Array.push(ma, a)
    Array.push(mg, String.to_i(c[0]))
    Array.push(mb, String.to_i(c[1]))
  end
end

n = Array.size(names)
if n == 0
  puts("no teams")
  exit
end

pl = Array.new(n, 0)
w = Array.new(n, 0)
d = Array.new(n, 0)
l = Array.new(n, 0)
gf = Array.new(n, 0)
ga = Array.new(n, 0)
Integer.times(Array.size(mh)) do |k|
  h = mh[k]
  a = ma[k]
  pl[h] += 1
  pl[a] += 1
  gf[h] += mg[k]
  ga[h] += mb[k]
  gf[a] += mb[k]
  ga[a] += mg[k]
  if mg[k] > mb[k]
    w[h] += 1
    l[a] += 1
  elsif mg[k] < mb[k]
    w[a] += 1
    l[h] += 1
  else
    d[h] += 1
    d[a] += 1
  end
end
pts = Array.new(n) { |i| 3 * w[i] + d[i] }
gd = Array.new(n) { |i| gf[i] - ga[i] }

h2h = Array.new(n, 0)
Integer.times(Array.size(mh)) do |k|
  h = mh[k]
  a = ma[k]
  if pts[h] == pts[a] && gd[h] == gd[a] && gf[h] == gf[a]
    if mg[k] > mb[k]
      h2h[h] += 3
    elsif mg[k] < mb[k]
      h2h[a] += 3
    else
      h2h[h] += 1
      h2h[a] += 1
    end
  end
end

key4 = Array.new(n) { |i| [-pts[i], -gd[i], -gf[i], -h2h[i]] }
order = Array.sort_by(Range.to_a(0...n)) { |i| [-pts[i], -gd[i], -gf[i], -h2h[i], names[i]] }

puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
Array.each(order) do |i|
  pos = 1 + Array.count(Range.to_a(0...n)) { |j| key4[j] < key4[i] }
  g = gd[i] > 0 ? "+#{gd[i]}" : Integer.to_s(gd[i])
  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", pos, names[i], pl[i], w[i], d[i], l[i], gf[i], ga[i], g, pts[i]))
end
