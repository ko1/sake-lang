module Costs
  module_function
  def insert = 1
  def delete = 1
  def substitute(a, b) = a == b ? 0 : 1
end

def distance_table(s, t)
  n = String.size(s)
  m = String.size(t)
  d = Range.map(0..n) { |i| Range.map(0..m) { |j| i == 0 ? j : (j == 0 ? i : 0) } }
  Integer.upto(1, n) do |i|
    Integer.upto(1, m) do |j|
      del = d[i - 1][j] + Costs.delete
      ins = d[i][j - 1] + Costs.insert
      sub = d[i - 1][j - 1] + Costs.substitute(s[i - 1], t[j - 1])
      d[i][j] = Array.min(Array[del, ins, sub])
    end
  end
  d
end

def distance(s, t)
  d = distance_table(s, t)
  d[String.size(s)][String.size(t)]
end

def script(s, t)
  d = distance_table(s, t)
  i = String.size(s)
  j = String.size(t)
  steps = Array[]
  while i > 0 || j > 0
    if i > 0 && j > 0 && d[i][j] == d[i - 1][j - 1] + Costs.substitute(s[i - 1], t[j - 1])
      if s[i - 1] == t[j - 1]
        Array.push(steps, "=#{s[i - 1]}")
      else
        Array.push(steps, "#{s[i - 1]}>#{t[j - 1]}")
      end
      i -= 1
      j -= 1
    elsif i > 0 && d[i][j] == d[i - 1][j] + Costs.delete
      Array.push(steps, "-#{s[i - 1]}")
      i -= 1
    else
      Array.push(steps, "+#{t[j - 1]}")
      j -= 1
    end
  end
  Array.reverse(steps)
end

def suggest(word, dictionary, limit)
  scored = Array.map(dictionary) { |w| [distance(word, w), w] }
  close = Array.select(scored) { |dist, w| dist <= limit }
  sorted = Array.sort_by(close) { |dist, w| dist * 100 + String.size(w) }
  Array.map(Array.take(sorted, 3)) { |dist, w| "#{w}(#{dist})" }
end

pairs = Array[
  ["kitten", "sitting"],
  ["sunday", "saturday"],
  ["flaw", "lawn"],
  ["intention", "execution"],
  ["", "abc"],
  ["same", "same"]
]
Array.each(pairs) do |s, t|
  steps = script(s, t)
  edits = Array.count(steps) { |st| String.start_with?(st, "=") == false }
  puts(format("%-10s -> %-10s distance %d", s, t, distance(s, t)))
  puts("  #{Array.join(steps, " ")}")
  puts("  (#{edits} edit operations)")
end

dictionary = String.split("receive believe achieve weird seize their there friend separate definitely necessary occasion", " ")
typos = Array["recieve", "beleive", "wierd", "freind", "seperate", "definately", "neccessary", "ocasion", "xyzzy"]
puts("spelling suggestions:")
Array.each(typos) do |typo|
  found = suggest(typo, dictionary, 2)
  if Array.empty?(found)
    puts("  #{typo}: no suggestion")
  else
    puts("  #{typo}: #{Array.join(found, ", ")}")
  end
end

words = Array["rust", "ruby", "rubs", "tuba", "cube", "cubs"]
puts("distance matrix:")
puts("      " + Array.join(Array.map(words) { |w| String.ljust(w, 5) }, ""))
Array.each(words) do |a|
  row = Array.map(words) { |b| String.ljust(Integer.to_s(distance(a, b)), 5) }
  puts(String.ljust(a, 6) + Array.join(row, ""))
end
