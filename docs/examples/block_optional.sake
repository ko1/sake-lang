# block_given?: a function that may be called with or without a block.
def info(msg = nil)
  msg = yield if block_given?
  puts("INFO #{msg}")
end
info("plain")
info { "built only when logged: #{Array.sum(Array[1, 2, 3])}" }

def total(xs)
  return Array.sum(xs) unless block_given?
  Array.sum(Array.map(xs) { |x| yield x })
end
p(total(Array[1, 2, 3]))
p(total(Array[1, 2, 3]) { |x| x * x })

# &b passes the function's own block on to another call.
def each_twice(xs, &b)
  Array.each(xs, &b)
  Array.each(xs, &b)
  nil
end
each_twice(Array["a", "b"]) { |s| print(s) }
puts
