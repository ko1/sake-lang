class CurrencyMismatch < Exception
  attr_reader left, right
end
class UnknownRate < Exception
  attr_reader from, to
end

class Money
  attr_reader cents, currency
  include Arithmetic
  include Comparable

  def check_same(a, b)
    if @currency != Money.currency(b)
      raise CurrencyMismatch.new("cannot combine #{@currency} and #{Money.currency(b)}", @currency, Money.currency(b))
    end
  end

  def +(a, b)
    check_same(a, b)
    Money.new(@cents + Money.cents(b), @currency)
  end

  def -(a, b)
    check_same(a, b)
    Money.new(@cents - Money.cents(b), @currency)
  end

  def *(a, k) = Money.new(Float.round(@cents * k * 1.0), @currency)

  def <=>(a, b)
    check_same(a, b)
    @cents <=> Money.cents(b)
  end

  def zero(cur) = Money.new(0, cur)
  def negative?(a) = @cents < 0

  def allocate(a, ratios)
    total = Array.sum(ratios)
    parts = Array.map(ratios) { |r| Money.new(@cents * r / total, @currency) }
    remainder = @cents - Array.sum(parts) { |m| Money.cents(m) }
    i = 0
    while remainder > 0
      m = parts[i]
      parts[i] = Money.new(Money.cents(m) + 1, @currency)
      remainder -= 1
      i += 1
    end
    parts
  end

  def to_s(a)
    sign = @cents < 0 ? "-" : ""
    abs = Integer.abs(@cents)
    "#{sign}#{@currency} #{abs / 100}.#{String.rjust(Integer.to_s(abs % 100), 2, "0")}"
  end
end

def rates = once { Hash[["USD", "EUR"] => 0.92, ["EUR", "USD"] => 1.09, ["USD", "JPY"] => 149.5, ["GBP", "USD"] => 1.27] }

def convert(m, to)
  from = Money.currency(m)
  return m if from == to
  rate = rates[[from, to]]
  raise UnknownRate.new("no rate #{from}->#{to}", from, to) if rate == nil
  Money.new(Float.round(Money.cents(m) * rate), to)
end

class Txn
  attr_accessor who, amount, memo
end

txns = Txn[
  Txn.new("alice", Money.new(12_500, "USD"), "consulting"),
  Txn.new("bob", Money.new(-3_250, "USD"), "hardware"),
  Txn.new("alice", Money.new(8_000, "EUR"), "workshop"),
  Txn.new("carol", Money.new(-1_999, "EUR"), "travel"),
  Txn.new("bob", Money.new(45_000, "JPY"), "license"),
  Txn.new("carol", Money.new(7_525, "USD"), "support"),
  Txn.new("alice", Money.new(-600, "GBP"), "fees")
]

puts("== ledger ==")
Array.each(txns) { |t| puts(format("%-6s %-12s %14s", Txn.who(t), Txn.memo(t), Txn.amount(t))) }

puts("== balance per currency ==")
by_cur = Hash[]
Array.each(txns) do |t|
  m = Txn.amount(t)
  cur = Money.currency(m)
  by_cur[cur] = (by_cur[cur] || Money.zero(cur)) + m
end
Hash.each(by_cur) { |cur, m| puts("#{cur}: #{m}") }

puts("== mixing currencies ==")
begin
  bad = Txn.amount(txns[0]) + Txn.amount(txns[2])
  puts("unexpected: #{bad}")
rescue CurrencyMismatch => e
  puts("error: #{Exception.message(e)} (#{CurrencyMismatch.left(e)}/#{CurrencyMismatch.right(e)})")
end

puts("== in USD ==")
total_usd = Money.zero("USD")
Array.each(txns) do |t|
  begin
    usd = convert(Txn.amount(t), "USD")
    total_usd += usd
    puts(format("%-12s %12s", Txn.memo(t), usd))
  rescue UnknownRate => e
    puts(format("%-12s %12s", Txn.memo(t), "n/a (#{UnknownRate.from(e)})"))
  end
end
puts("total: #{total_usd}")

puts("== per person (USD only) ==")
usd_txns = Array.select(txns) { |t| Money.currency(Txn.amount(t)) == "USD" }
people = Array.group_by(usd_txns) { |t| Txn.who(t) }
Hash.each(people) do |who, ts|
  sum = Array.reduce(ts, Money.zero("USD")) { |acc, t| acc + Txn.amount(t) }
  flag = Money.negative?(sum) ? " (owes)" : ""
  puts("#{who}: #{sum}#{flag}")
end

usd_amounts = Array.map(usd_txns) { |t| Txn.amount(t) }
puts("largest USD: #{Array.max(usd_amounts)}")
puts("smallest USD: #{Array.min(usd_amounts)}")
puts("sorted: #{Array.join(Array.sort(usd_amounts), ", ")}")

puts("== split 100.00 USD 1:1:1 and 50:30:20 ==")
pot = Money.new(10_000, "USD")
puts(Array.join(Money.allocate(pot, Array[1, 1, 1]), " | "))
puts(Array.join(Money.allocate(pot, Array[50, 30, 20]), " | "))
puts("tip 15%: #{pot * 0.15}")
puts("triple: #{pot * 3}")
puts("equal? #{pot == Money.new(10_000, "USD")} bigger? #{pot > Money.new(9_999, "USD")}")
