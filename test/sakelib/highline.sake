require "highline"
require "stringio"

# The answers come from a StringIO, so the Ruby twin reads the same script; the prompts and the error
# messages go to stdout, where the test compares them.
input = StringIO.new(Array.join(String[
  "Alice",            # Name?
  "abc", "200", "42", # Age? (not an Integer, out of range, ok)
  "1.75",             # Height?
  "ab1", "ABC",       # Code? (does not match, ok)
  "",                 # City? (the default)
  "",                 # Count? (the default)
  "",                 # Pick (a default after a newline)
  "maybe", "Y",       # Continue? (asked again, yes)
  "",                 # Really? (the default, no)
  "9", "2",           # Fruits (not a choice, banana)
  "b", "bl",          # ambiguous, blueberry
  "CHER",             # cherry, by a prefix in any case
  "mango",            # by its name
], "\n") + "\n")
cli = HighLine.new(input, IO.stdout)

HighLine.say(cli, "Welcome")
HighLine.say(cli, "no newline here ")
HighLine.newline(cli)
HighLine.say(cli, 42)

name = HighLine.ask(cli, "Name? ")
p(name)
age = HighLine.ask_integer(cli, "Age? ", range: 0..120)
p(age)
p(age + 1)
height = HighLine.ask_float(cli, "Height (m)? ", above: 0.0, below: 3.0)
p(height)
code = HighLine.ask(cli, "Code? ", validate: /\A[A-Z]{3}\z/)
p(code)
city = HighLine.ask(cli, "City? ", default: "Tokyo")
p(city)
count = HighLine.ask_integer(cli, "Count? ", default: 3)
p(count)
pick = HighLine.ask(cli, "Pick\n", default: "x")
p(pick)
ok = HighLine.agree(cli, "Continue? ")
p(ok)
p(HighLine.agree(cli, "Really? ", default: "no"))
fruit = HighLine.choose(cli, String["apple", "banana", "cherry"], header: "Fruits")
p(fruit)
p(HighLine.choose(cli, String["apple", "banana", "blueberry"]))
p(HighLine.choose(cli, String["apple", "banana", "cherry"], prompt: "Which? "))
p(HighLine.choose(cli, Symbol[:kiwi, :mango]))
print(HighLine.list(cli, Array["a", 2, :c]))
begin
  HighLine.ask(cli, "More? ")
rescue EOFError => e
  puts(Exception.message(e))
end

# the output as a StringIO
out = StringIO.new
cli2 = HighLine.new(StringIO.new("x\n5\n"), out)
p(HighLine.ask(cli2, "Letter? "))
p(HighLine.ask_integer(cli2, "Digit?", above: 3))
p(StringIO.string(out))
p(HighLine.input(cli2) == HighLine.output(cli2))
