def pieces(word, w)
  out = String[]
  rest = word
  while String.size(rest) > w
    Array.push(out, String.slice(rest, 0, w - 1) + "-")
    rest = String.slice(rest, w - 1, String.size(rest) - (w - 1))
  end
  Array.push(out, rest)
  out
end

def justify(words, w)
  total = 0
  Array.each(words) { |x| total += String.size(x) }
  gaps = Array.size(words) - 1
  extra = w - total
  out = ""
  Array.each_with_index(words) do |x, i|
    out = out + x
    if i < gaps
      n = extra / gaps
      n += 1 if i < extra % gaps
      out = out + " " * n
    end
  end
  out
end

def layout(words, w)
  rows = String[]
  cur = Array[]
  curlen = 0
  Array.each(words) do |x|
    if Array.empty?(cur)
      Array.push(cur, x)
      curlen = String.size(x)
    elsif curlen + 1 + String.size(x) <= w
      Array.push(cur, x)
      curlen += 1 + String.size(x)
    else
      Array.push(rows, cur)
      cur = String[x]
      curlen = String.size(x)
    end
  end
  Array.push(rows, cur) unless Array.empty?(cur)
  rows
end

lines = Array.map(String.lines(IO.read(IO.stdin))) { |l| String.chomp(l) }
head = Array.empty?(lines) ? "" : String.strip(lines[0])
if !String.match?(head, /\A\d+\z/) || String.to_i(head) < 2 || String.to_i(head) > 80
  puts("invalid width")
  exit
end
w = String.to_i(head)

paras = Array[]
cur = String[]
Array.each(Array.drop(lines, 1)) do |l|
  ws = String.scan(l, /[^ \t]+/)
  if Array.empty?(ws)
    unless Array.empty?(cur)
      Array.push(paras, cur)
      cur = String[]
    end
  else
    Array.concat(cur, ws)
  end
end
Array.push(paras, cur) unless Array.empty?(cur)

border = "+" + "-" * w + "+"
out = String[]
nwords = 0
nlines = 0
Array.each_with_index(paras) do |ws, pi|
  nwords += Array.size(ws)
  Array.push(out, "|" + " " * w + "|") if pi > 0
  pcs = String[]
  Array.each(ws) { |x| Array.concat(pcs, pieces(x, w)) }
  rows = layout(pcs, w)
  Array.each_with_index(rows) do |r, ri|
    text = if ri < Array.size(rows) - 1 && Array.size(r) > 1
      justify(r, w)
    else
      Array.join(r, " ")
    end
    Array.push(out, "|" + String.ljust(text, w) + "|")
    nlines += 1
  end
end
puts(border)
puts(*out) unless Array.empty?(out)
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{nwords}")
