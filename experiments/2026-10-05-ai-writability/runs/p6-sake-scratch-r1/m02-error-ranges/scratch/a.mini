try print(10 / (5 - 5)) catch e print(e) end
try [1][5] catch e print(e) end
try (1) + "a" catch e print(e) end
try print((1 + "a")) catch e print(e) end
try -"x" catch e print(e) end
try {1: 2}.a catch e print(e) end
try let q = {(nil): 1} catch e print(e) end
let a = [1]
try a[3] = 1 catch e print(e) end
try a[0] += "s" catch e print(e) end
try a[1:"x"] catch e print(e) end
try assert 1 == 2, "m" catch e print(e) end
try
  for x in len(
    "ab") do end
catch e print(e) end
try let [p, q] = [1] catch e print(e) end
try match 1 when 2 then print(1) end catch e print(e) end
let L = len
try L() catch e print(e) end
try print(map([1], fn(x, y) end)) catch e print(e) end
try 5(1) catch e print(e) end
try throw 7 catch e print(e) end
let fa = [[]]
let i = 0
while i < 105 do let n = [fa]; fa = n; i += 1 end
try fa == fa catch e print(e) end
fn f() return f() end
try f() catch e print(e) end
try print(1 in 5) catch e print(e) end
try g() catch e print(e) end
let y = 1
fn g() print(y) end
throw [1,
  2]
