require "active_support_inflector"

# ActiveSupport::Inflector is Inflector; its output must equal active_support_inflector.rb.
Array.each(String["person", "people", "sheep", "octopus", "octopi", "CamelOctopus", "words", "quiz", "ox", "oxen", "mouse", "matrix", "vertex", "index", "axis", "test", "bus", "buffalo", "tomato", "datum", "medium", "analysis", "wife", "half", "knife", "hive", "query", "box", "church", "wish", "miss", "virus", "status", "alias", "news", "series", "movie", "shoe", "crisis", "thesis", "child", "children", "man", "men", "woman", "sex", "move", "zombie", "equipment", "Information", "fish", "money", "CamelSheep", "database", "databases", "ley", "rice", "jeans", "police", "cactus"]) { |w| puts "#{w}: #{Inflector.pluralize(w)} / #{Inflector.singularize(w)}" }
Array.each(Array[Inflector.pluralize(""), Inflector.singularize("ss"), Inflector.pluralize("s"), Inflector.singularize("s")]) { |x| p x }
Array.each(Array[Inflector.camelize("active_model/errors"), Inflector.camelize("active_model", false), Inflector.camelize("Active_MODEL"), Inflector.camelize("ab1_c"), Inflector.camelize("a/b"), Inflector.camelize("")]) { |x| p x }
Array.each(Array[Inflector.underscore("ActiveModel::Errors"), Inflector.underscore("SSLError"), Inflector.underscore("HTML5Parser"), Inflector.underscore("already_under"), Inflector.underscore("Foo-Bar"), Inflector.underscore("ABC"), Inflector.underscore("aB"), Inflector.underscore("Html5")]) { |x| p x }
Array.each(Array[Inflector.humanize("employee_salary"), Inflector.humanize("author_id"), Inflector.humanize("author_id", capitalize: false), Inflector.humanize("_id"), Inflector.humanize("author_id", keep_id_suffix: true), Inflector.humanize("  _leading"), Inflector.humanize("ABC_def"), Inflector.humanize("x__y")]) { |x| p x }
Array.each(Array[Inflector.titleize("man from the boondocks"), Inflector.titleize("x-men: the last stand"), Inflector.titleize("TheManWithoutAPast"), Inflector.titleize("raiders_of_the_lost_ark"), Inflector.titleize("string_ending_with_id", keep_id_suffix: true), Inflector.titleize("o'neil isn't here (ok)"), Inflector.titleize("string_ending_with_id")]) { |x| p x }
Array.each(Array[Inflector.tableize("RawScaledScorer"), Inflector.tableize("ham_and_egg"), Inflector.tableize("fancyCategory"), Inflector.classify("ham_and_eggs"), Inflector.classify("posts"), Inflector.classify("calculus"), Inflector.classify("schema.posts")]) { |x| p x }
Array.each(Array[Inflector.demodulize("ActiveSupport::Inflector::Inflections"), Inflector.demodulize("::Inflections"), Inflector.demodulize(""), Inflector.deconstantize("Net::HTTP"), Inflector.deconstantize("::Net::HTTP"), Inflector.deconstantize("String"), Inflector.deconstantize("::String"), Inflector.deconstantize("")]) { |x| p x }
Array.each(Array[Inflector.foreign_key("Message"), Inflector.foreign_key("Message", false), Inflector.foreign_key("Admin::Post")]) { |x| p x }
p Array.map(Array[1,2,3,4,11,12,13,21,22,23,101,111,1002,1003,-11,-1021,0,1.5,113,100]) { |n| Inflector.ordinalize(n) }
Array.each(Array[Inflector.parameterize("Donald E. Knuth"), Inflector.parameterize("^très|Jolie-- "), Inflector.parameterize("Donald E. Knuth", separator: "_"), Inflector.parameterize("^très|Jolie__ ", separator: "_"), Inflector.parameterize("Donald E. Knuth", preserve_case: true), Inflector.parameterize("^très|Jolie__ "), Inflector.parameterize("^très_Jolie-- ", separator: "."), Inflector.parameterize("a  b", separator: "--"), Inflector.parameterize("a b", separator: ""), Inflector.parameterize("--x--")]) { |x| p x }
Array.each(Array[Inflector.transliterate("Ærøskøbing"), Inflector.transliterate("Jürgen"), Inflector.transliterate("日本"), Inflector.transliterate("日本", "*"), Inflector.transliterate("abc"), Inflector.transliterate("ẞ")]) { |x| p x }
Array.each(Array[Inflector.upcase_first("what a Lovely Day"), Inflector.downcase_first("If"), Inflector.upcase_first("")]) { |x| p x }
Array.each(Array[Inflector.dasherize("puni_puni")]) { |x| p x }
puts "== acronym"
Inflector.acronym("HTML")
Inflector.acronym("RESTful")
Array.each(Array[Inflector.camelize("html"), Inflector.camelize("my_html_parser"), Inflector.underscore("MyHTMLParser"), Inflector.titleize("RESTfulController"), Inflector.humanize("html_error"), Inflector.camelize("restful_controller"), Inflector.underscore("RESTfulController"), Inflector.underscore("HTMLS")]) { |x| p x }
