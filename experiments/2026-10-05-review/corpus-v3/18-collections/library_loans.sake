# A small library: books with genre Sets, members, loans with due-day Ranges, reservations queues,
# overdue fines, and reports shared through a mixin module.

class LoanRefused < StandardError
  attr_reader reason
end

module Report
  def summary(x)
    rows = lines(x)
    "#{heading(x)} (#{Array.size(rows)})\n" + Array.join(Array.map(rows) { |r| "  " + r }, "\n")
  end
end

class Book
  attr_reader id, title, author, genres, copies
end

class Member
  include Report
  attr_reader id, name, kind

  def heading(m) = "#{@name} (#{@kind})"
  def lines(m) = Array["id #{@id}"]
end

class Loan
  attr_reader book_id, member_id, period
  attr_accessor returned
end

def fine(days) = format("$%.2f", Float.clamp(days * 0.25, 0.0, 5.0))

class Library
  include Report
  attr_reader today, books = nil, members = nil, loans = nil, queues = nil

  def initialize(lib)
    @books = Hash[]
    @members = Hash[]
    @loans = Array[]
    @queues = Hash[]
  end

  def add_book(lib, id, title, author, genres, copies)
    @books[id] = Book.new(id, title, author, Array.to_set(String.split(genres, ",")), copies)
  end

  def add_member(lib, id, name, kind) = @members[id] = Member.new(id, name, kind)

  def loan_days(lib, member) = Member.get_kind(member) == :staff ? 28 : 14

  def active(lib) = Array.select(@loans) { |l| Loan.get_returned(l) == nil }

  def out_count(lib, book_id) = Array.count(active(lib)) { |l| Loan.get_book_id(l) == book_id }

  def available?(lib, book_id) = out_count(lib, book_id) < Book.get_copies(@books[book_id])

  def lend(lib, book_id, member_id, day)
    book = @books[book_id]
    member = @members[member_id]
    raise LoanRefused.new("cannot lend", "no such book #{book_id}") unless book
    raise LoanRefused.new("cannot lend", "no such member #{member_id}") unless member
    mine = Array.count(active(lib)) { |l| Loan.get_member_id(l) == member_id }
    raise LoanRefused.new("cannot lend", "#{Member.get_name(member)} has #{mine} books out") if mine >= 3
    queue = Hash.fetch(@queues, book_id, Array[])
    unless Array.empty?(queue) || queue[0] == member_id
      raise LoanRefused.new("cannot lend", "reserved for #{Member.get_name(@members[queue[0]])}")
    end
    raise LoanRefused.new("cannot lend", "no copy of #{Book.get_title(book)} left") unless available?(lib, book_id)
    Array.shift(queue) if queue[0] == member_id
    loan = Loan.new(book_id, member_id, day...(day + loan_days(lib, member)), nil)
    Array.push(@loans, loan)
    loan
  end

  def give_back(lib, book_id, member_id, day)
    loan = Array.find(active(lib)) { |l| Loan.get_book_id(l) == book_id && Loan.get_member_id(l) == member_id }
    return nil unless loan
    Loan.set_returned(loan, day)
    late = day - (Range.end(Loan.get_period(loan)) - 1)
    late > 0 ? late : 0
  end

  def reserve(lib, book_id, member_id)
    q = (@queues[book_id] ||= Array[])
    Array.push(q, member_id) unless Array.include?(q, member_id)
    Array.index(q, member_id) + 1
  end

  def overdue(lib)
    Array.select(active(lib)) { |l| @today >= Range.end(Loan.get_period(l)) }
  end

  def heading(lib) = "Overdue on day #{@today}"

  def lines(lib)
    Array.map(overdue(lib)) do |l|
      days = @today - Range.end(Loan.get_period(l)) + 1
      "#{Book.get_title(@books[Loan.get_book_id(l)])} - #{Member.get_name(@members[Loan.get_member_id(l)])}, #{days} days, fine #{fine(days)}"
    end
  end
end

lib = Library.new(40)
Library.add_book(lib, "b1", "Dune", "Herbert", "scifi,classic", 2)
Library.add_book(lib, "b2", "Emma", "Austen", "romance,classic", 1)
Library.add_book(lib, "b3", "Neuromancer", "Gibson", "scifi,cyberpunk", 1)
Library.add_book(lib, "b4", "The Hobbit", "Tolkien", "fantasy,classic", 3)
Library.add_book(lib, "b5", "Snow Crash", "Stephenson", "scifi,cyberpunk,satire", 1)
Library.add_member(lib, "m1", "Ann", :adult)
Library.add_member(lib, "m2", "Bo", :staff)
Library.add_member(lib, "m3", "Cy", :adult)
Library.add_member(lib, "m4", "Di", :child)

requests = Array[
  ["lend", "b1", "m1", 1], ["lend", "b3", "m1", 2], ["lend", "b3", "m2", 3], ["reserve", "b3", "m3", 3],
  ["reserve", "b3", "m2", 4], ["lend", "b2", "m4", 5], ["lend", "b4", "m1", 6], ["lend", "b5", "m1", 7],
  ["return", "b2", "m4", 18], ["return", "b2", "m4", 19], ["return", "b3", "m1", 20], ["lend", "b3", "m2", 21],
  ["lend", "b3", "m3", 22], ["lend", "b9", "m3", 22], ["lend", "b5", "m2", 23], ["lend", "b4", "m4", 25],
  ["return", "b1", "m1", 30], ["lend", "b1", "m3", 30]
]
puts("== Desk log ==")
Array.each(requests) do |action, book, member, day|
  case action
  in "lend"
    loan = Library.lend(lib, book, member, day)
    puts(format("day %2d lend   %s -> %s, due day %d", day, book, member, Range.end(Loan.get_period(loan)) - 1))
  in "return"
    late = Library.give_back(lib, book, member, day)
    if late == nil
      puts(format("day %2d return %s by %s: no such loan", day, book, member))
    else
      puts(format("day %2d return %s by %s%s", day, book, member, late > 0 ? ", #{late} days late, fine #{fine(late)}" : ""))
    end
  in "reserve"
    pos = Library.reserve(lib, book, member)
    puts(format("day %2d reserve %s for %s, position %d", day, book, member, pos))
  end
rescue LoanRefused => e
  puts(format("day %2d refused %s for %s: %s", day, book, member, LoanRefused.get_reason(e)))
end

puts
puts(Report.summary(lib))
puts(Report.summary(Library.get_members(lib)["m2"]))

puts("== Holdings ==")
books = Hash.values(Library.get_books(lib))
Array.each(books) do |b|
  out = Library.out_count(lib, Book.get_id(b))
  q = Hash.fetch(Library.get_queues(lib), Book.get_id(b), Array[])
  puts(format("  %-12s %d/%d out%s", Book.get_title(b), out, Book.get_copies(b), Array.empty?(q) ? "" : ", queue #{Array.join(q, ",")}"))
end

genres = Array.reduce(books, Set[]) { |acc, b| acc | Book.get_genres(b) }
puts("genres: #{Array.join(Set.sort(genres), " ")}")
loans = Library.get_loans(lib)
by_member = Array.group_by(loans) { |l| Loan.get_member_id(l) }
Hash.each(by_member) do |mid, ls|
  read = Array.reduce(ls, Set[]) { |acc, l| acc | Book.get_genres(Library.get_books(lib)[Loan.get_book_id(l)]) }
  puts("  #{Member.get_name(Library.get_members(lib)[mid])} borrowed #{Array.size(ls)}, genres: #{Array.join(Set.sort(read), ",")}")
end
scifi_fans = Array.select(Hash.keys(by_member)) do |mid|
  Array.all?(by_member[mid]) { |l| Set.include?(Book.get_genres(Library.get_books(lib)[Loan.get_book_id(l)]), "scifi") }
end
puts("only scifi: #{Array.join(scifi_fans, ", ")}")
never = Array.reject(books) { |b| Array.any?(loans) { |l| Loan.get_book_id(l) == Book.get_id(b) } }
puts("never borrowed: #{Array.empty?(never) ? "none" : Array.join(Array.map(never) { |b| Book.get_title(b) }, ", ")}")
durations = Array.filter_map(loans) { |l| r = Loan.get_returned(l); r ? r - Range.begin(Loan.get_period(l)) : nil }
puts("returned loans: #{Array.size(durations)}, average #{format("%.1f", Array.sum(durations) / Integer.to_f(Array.size(durations)))} days")
