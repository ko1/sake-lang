require "lru_cache"

c = LRUCache.new(3)
c[:a] = 1
c[:b] = 2
c[:c] = 3
p LRUCache.keys(c)
p c[:a]
p LRUCache.keys(c)
c[:d] = 4
p LRUCache.keys(c)
p LRUCache.key?(c, :b)
p c[:b]
p LRUCache.to_a(c)
c[:c] = 30
p LRUCache.to_a(c)
p LRUCache.count(c)
p LRUCache.stats(c)

# getset computes and stores; fetch computes without storing
p LRUCache.getset(c, :e) { |k| Symbol.length(k) * 100 }
p LRUCache.getset(c, :e) { |k| -1 }
p LRUCache.keys(c)
p LRUCache.fetch(c, :zz) { |k| "no #{k}" }
p LRUCache.key?(c, :zz)
p LRUCache.fetch(c, :c)
begin
  LRUCache.fetch(c, :zz)
rescue KeyError => e
  puts Exception.message(e)
end
p LRUCache.stats(c)
p LRUCache.hit_rate(c)

# shrink, delete, clear
p LRUCache.set_max_size(c, 2)
p LRUCache.max_size(c)
p LRUCache.to_a(c)
p LRUCache.delete(c, :c)
p LRUCache.delete(c, :nope)
LRUCache.each(c) { |k, v| puts "#{k} => #{v}" }
LRUCache.clear(c)
p LRUCache.empty?(c)
p LRUCache.stats(c)

# memoizing a recursive function
def fib(cache, n)
  return n if n < 2
  LRUCache.getset(cache, n) { |k| fib(cache, k - 1) + fib(cache, k - 2) }
end
memo = LRUCache.new(100)
p fib(memo, 80)
p LRUCache.stats(memo)
p LRUCache.count(memo)

# a capacity of 1
one = LRUCache.new(1)
one["x"] = 1
one["y"] = 2
p LRUCache.to_a(one)
p one["x"]
p LRUCache.stats(one)
p LRUCache.hit_rate(LRUCache.new(5))

# errors
Array.each(Array[0, -2]) do |n|
  begin
    LRUCache.new(n)
  rescue ArgumentError => e
    puts Exception.message(e)
  end
end
begin
  LRUCache.new(Array.fetch(Array[1, "big"], 1))
rescue NoMatchingPatternError
  puts "max_size must be an Integer"
end
begin
  LRUCache.set_max_size(one, 0)
rescue ArgumentError => e
  puts Exception.message(e)
end
