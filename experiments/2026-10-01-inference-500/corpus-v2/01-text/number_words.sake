def ones
  String["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
         "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
         "seventeen", "eighteen", "nineteen"]
end

def tens = String["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]

def scales = Array[[1_000_000_000, "billion"], [1_000_000, "million"], [1000, "thousand"]]

def below_hundred(n)
  return ones[n] if n < 20
  t, u = Integer.divmod(n, 10)
  u == 0 ? tens[t] : "#{tens[t]}-#{ones[u]}"
end

def below_thousand(n)
  h, rest = Integer.divmod(n, 100)
  parts = Array[]
  Array.push(parts, "#{ones[h]} hundred") if h > 0
  if rest > 0
    Array.push(parts, "and") if h > 0
    Array.push(parts, below_hundred(rest))
  end
  Array.join(parts, " ")
end

def to_words(n)
  return "zero" if n == 0
  return "minus " + to_words(-n) if n < 0
  parts = Array[]
  rest = n
  Array.each(scales) do |size, name|
    if rest >= size
      Array.push(parts, "#{to_words(rest / size)} #{name}")
      rest = rest % size
    end
  end
  if rest > 0
    Array.push(parts, "and") if !Array.empty?(parts) && rest < 100
    Array.push(parts, below_thousand(rest))
  end
  Array.join(parts, " ")
end

def ordinal_word(n)
  irregular = Hash["one" => "first", "two" => "second", "three" => "third", "five" => "fifth",
                   "eight" => "eighth", "nine" => "ninth", "twelve" => "twelfth"]
  words = to_words(n)
  m = String.match(words, /([a-z]+)\z/)
  return words if m == nil
  last = m[1]
  stem = String.delete_suffix(words, last)
  if (replacement = irregular[last])
    stem + replacement
  elsif String.end_with?(last, "y")
    stem + String.delete_suffix(last, "y") + "ieth"
  else
    stem + last + "th"
  end
end

def ordinal_suffix(n)
  return "th" if Integer.between?(n % 100, 11, 13)
  case n % 10
  in 1 then "st"
  in 2 then "nd"
  in 3 then "rd"
  else "th"
  end
end

def cheque(amount_cents)
  dollars, cents = Integer.divmod(amount_cents, 100)
  text = String.capitalize(to_words(dollars))
  unit = dollars == 1 ? "dollar" : "dollars"
  format("%s %s and %02d/100", text, unit, cents)
end

def roman(n)
  table = Array[[1000, "M"], [900, "CM"], [500, "D"], [400, "CD"], [100, "C"], [90, "XC"],
                [50, "L"], [40, "XL"], [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"]]
  out = ""
  rest = n
  Array.each(table) do |value, sym|
    while rest >= value
      out += sym
      rest -= value
    end
  end
  out
end

Array.each(Integer[0, 7, 13, 21, 40, 99, 100, 101, 342, 1000, 1001, 2024, 15_016, 700_000, 1_234_567, -58, 3_000_000_005]) do |n|
  puts(format("%14d  %s", n, to_words(n)))
end
puts
Array.each(Integer[1, 2, 3, 4, 11, 12, 13, 21, 22, 30, 101, 112, 1000]) do |n|
  puts(format("%5s  %-6s %s", "#{n}#{ordinal_suffix(n)}", roman(n), ordinal_word(n)))
end
puts
Array.each(Integer[100, 1999, 123_456, 100_000_001]) { |c| puts(cheque(c)) }
total_letters = Array.sum(Range.map(1..100) { |n| String.size(String.delete(to_words(n), " -")) })
puts("letters used writing 1..100: #{total_letters}")
