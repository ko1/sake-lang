# A function from an `include`d module loses to the function of the same name that `class B < A` pasted, whatever
# the order. Ruby: `class B < A; include M; end` -> M#host wins over A#host (M comes before A in B's ancestors),
# and Rails relies on it (ActionDispatch::Request includes Http::URL, whose host/port/url override Rack's).
# Here B.url calls A's host, printing "A" (Ruby prints "M"). Workaround: define the functions in B itself.
class A
  attr_reader x
  def host(a) = "A"
end
module M
  def host(m) = "M"
  def url(m) = host(m)
end
class B < A
  include M
end
p(B.url(B.new(1)))
