# BLOB values (7.1). A Blob keeps its bytes as upper case hex digits, two per byte, so equality,
# the byte-by-byte order of 7.3 and the group key all follow from comparing the digits.
Blob = Struct.new(:hex)

module Blobs
  module_function

  def blob?(v)
    case v
    in Blob then true
    else false
    end
  end

  # The BLOB of the (UTF-8) bytes of a text.
  def of_text(s) = Blob.new(Array.join(Array.map(String.bytes(s)) { |b| byte_hex(b) }, ""))

  # A byte (0 to 255) as two upper case hex digits.
  def byte_hex(b)
    digits = "0123456789ABCDEF"
    Text.slice(digits, b / 16, 1) + Text.slice(digits, b % 16, 1)
  end

  def size(b) = String.size(Blob.hex(b)) / 2

  # The bytes read as characters: the text form of a BLOB (7.1).
  def text_of(b)
    hex = Blob.hex(b)
    out = String[]
    i = 0
    while i < String.size(hex)
      Array.push(out, Integer.chr(String.hex(Text.slice(hex, i, 2))))
      i += 2
    end
    Array.join(out, "")
  end

  # 1-based byte position of the first occurrence of the digits `part` in the digits `whole`, or 0;
  # an occurrence must start on a byte, that is at an even digit.
  def instr(whole, part)
    i = String.index(whole, part)
    while i != nil && !Integer.even?(i)
      i = String.index(whole, part, i + 1)
    end
    i == nil ? 0 : i / 2 + 1
  end
end
