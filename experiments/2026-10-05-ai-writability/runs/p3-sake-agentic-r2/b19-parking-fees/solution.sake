def money(c) = format("%d.%02d", c / 100, c % 100)

def part(r, first, step)
  return 0 if r == 0
  extra = r > 60 ? (r - 60 + 29) / 30 : 0
  first + step * extra
end

def fee(stay, first, step, cap, grace)
  return 0 if stay <= grace
  d = stay / 1440
  r = stay % 1440
  p = part(r, first, step)
  d * cap + (p < cap ? p : cap)
end

def main
  lines = IO.readlines(IO.stdin)
  h = String.split(lines[0])
  first = String.to_i(h[1])
  step = String.to_i(h[2])
  cap = String.to_i(h[3])
  grace = String.to_i(h[4])
  inside = Hash[]
  exits = Hash.new(0)
  rev = Hash.new(0)
  total_n = 0
  total_r = 0
  day = 0
  prev = -1
  i = 1
  while i < Array.size(lines)
    raw = String.chomp(lines[i])
    i += 1
    next if String.empty?(String.strip(raw))
    m = String.match(raw, /\A(\d\d):(\d\d) +(IN|OUT) +([A-Z0-9]{1,8})\z/)
    ok = m != nil
    if ok
      cs = MatchData.captures(m)
      hh = String.to_i(cs[0])
      mm = String.to_i(cs[1])
      ok = hh <= 23 && mm <= 59
    end
    if !ok
      puts("line #{i}: invalid")
      next
    end
    tm = hh * 60 + mm
    day += 1 if tm < prev
    prev = tm
    at = day * 1440 + tm
    kind = cs[2]
    plate = cs[3]
    if kind == "IN"
      if Hash.key?(inside, plate)
        puts("line #{i}: #{plate} already inside")
      else
        inside[plate] = at
      end
    else
      if !Hash.key?(inside, plate)
        puts("line #{i}: #{plate} not inside")
      else
        stay = at - inside[plate]
        Hash.delete(inside, plate)
        f = fee(stay, first, step, cap, grace)
        puts(format("%s %d:%02d %s", plate, stay / 60, stay % 60, money(f)))
        exits[plate] += 1
        rev[plate] += f
        total_n += 1
        total_r += f
      end
    end
  end
  puts("--- summary")
  plates = Array.sort_by(Hash.keys(exits)) { |pl| [-rev[pl], pl] }
  Array.each(plates) { |pl| puts("#{pl} #{exits[pl]} #{money(rev[pl])}") }
  puts("total #{total_n} #{money(total_r)}")
  left = Array.sort(Hash.keys(inside))
  puts(Array.empty?(left) ? "inside: none" : "inside: #{Array.join(left, ", ")}")
end

main
