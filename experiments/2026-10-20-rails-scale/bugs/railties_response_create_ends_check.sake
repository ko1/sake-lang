# railties: the same as railties_initialize_call_ends_check.sake inside actionpack: ActionDispatch::Response.create
# (Response.new, whose initialize reads the fields new was given) makes the checker treat everything after it as
# unreachable, silently: this prints "OK" instead of the String.upcase error. Every request of an app goes through
# ActionController::DefaultHeaders.make_response! (Response.create), so no action, view or model code reached from a
# request is checked in the blog (bin/sake -c --strict bin/rails.sake: OK in 7 s). Ruby: runs, TypeError at line 3.
require "rails/actionpack/action_dispatch/http/response"
x = ActionDispatch::Response.create
p(String.upcase(42))
