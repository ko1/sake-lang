Rails.application.configure(:test) do |config|
  config.Rails::Application::Configuration.enable_reloading = false
  config.Rails::Application::Configuration.eager_load = ENV.get("CI") != nil
  config.Rails::Application::Configuration.consider_all_requests_local = true
  config.Rails::Application::Configuration.action_dispatch[:show_exceptions] = :rescuable
  config.Rails::Application::Configuration.action_controller[:allow_forgery_protection] = false
  config.Rails::Application::Configuration.action_controller[:raise_on_missing_callback_actions] = true
end
