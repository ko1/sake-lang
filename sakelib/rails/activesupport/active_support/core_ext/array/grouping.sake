# Port of activesupport-8.1.3/lib/active_support/core_ext/array/grouping.rb
#
# The block forms yield each group and give the groups (Ruby gives the receiver back).

class Array
  def in_groups_of(xs, number, fill_with = nil)
    if number <= 0
      raise ArgumentError, "Group size must be a positive integer, was #{Kernel.inspect(number)}"
    end
    # a new untyped Array: a `String[]` could not take the nil padding
    collection = Array.concat(Any[], xs)
    if fill_with != false
      padding = (number - Array.size(xs) % number) % number
      Array.concat(collection, Array.new(padding, fill_with))
    end
    groups = Array.each_slice(collection, number)
    Array.each(groups) { |g| yield(g) } if block_given?
    groups
  end

  def in_groups(xs, number, fill_with = nil)
    division = Array.size(xs) / number
    modulo = Array.size(xs) % number
    groups = Any[]
    start = 0
    Integer.times(number) do |index|
      length = division + (modulo > 0 && modulo > index ? 1 : 0)
      group = Array.concat(Any[], Array.slice(xs, start, length) || Any[])
      Array.push(group, fill_with) if fill_with != false && modulo > 0 && length == division
      Array.push(groups, group)
      start += length
    end
    Array.each(groups) { |g| yield(g) } if block_given?
    groups
  end

  # Ruby: split(value = nil) or split { |x| ... }
  def split(xs, value = nil)
    arr = Array.dup(xs)
    result = Any[]
    if block_given?
      while (idx = Array.find_index(arr) { |e| yield(e) })
        Array.push(result, Array.shift(arr, idx))
        Array.shift(arr)
      end
    else
      while (idx = Array.index(arr, value))
        Array.push(result, Array.shift(arr, idx))
        Array.shift(arr)
      end
    end
    Array.push(result, arr)
  end
end
