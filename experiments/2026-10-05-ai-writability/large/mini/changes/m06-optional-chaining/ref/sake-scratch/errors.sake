# Errors: the one-line reports of the four phases (SPEC section 1), and the two
# exceptions a running Mini program can catch (section 9).

# A lexical, syntax or static error. It stops the run before evaluation starts.
# kind is "lexical", "syntax" or "static".
CompileError = Exception.new(:kind, :line, :col)

# A runtime error raised by an operation: kind is one of the kinds of SPEC
# section 9 ("type", "index", "key", "zero", "arity", "value", "name", "stack",
# "assert"). A `catch` receives it as an error map.
MiniFault = Exception.new(:kind, :line, :col)

# A value thrown by `throw`, at the position of the `throw` keyword.
MiniThrow = Exception.new(:value, :line, :col)

# Raised when the receiver of a `?.` or `?[` is nil; its OptChain rescues it.
ChainNil = Exception.new

# A broken invariant of this interpreter (never a property of the Mini program).
InternalError = Exception.new

module Fail
  module_function

  def lexical(line, col, message) = raise(CompileError.new(message, "lexical", line, col))

  def syntax(line, col, message) = raise(CompileError.new(message, "syntax", line, col))

  def static(line, col, message) = raise(CompileError.new(message, "static", line, col))

  def runtime(kind, line, col, message) = raise(MiniFault.new(message, kind, line, col))

  def internal(message) = raise(InternalError.new(message))

  # The report line: `<kind> error at <line>:<col>: <message>`.
  def report(kind, line, col, message) = "#{kind} error at #{line}:#{col}: #{message}"

  # "1 argument", "2 arguments".
  def count_of(n, noun) = n == 1 ? "#{n} #{noun}" : "#{n} #{noun}s"

  # The arity message shared by the static check and the call (SPEC 6.6).
  # max is -1 when there is no maximum.
  def arity_message(name, min, max, got)
    if max < 0
      "#{name} expects at least #{count_of(min, "argument")}, got #{got}"
    elsif min == max
      "#{name} expects #{count_of(min, "argument")}, got #{got}"
    else
      "#{name} expects #{min} to #{max} arguments, got #{got}"
    end
  end
end
