# Errors raised while processing a Mini program.
#
# - CompileError: a lexical, syntax or static error (phase is "lexical", "syntax" or "static");
#   it stops the run before anything is evaluated.
# - MiniError: a runtime error (kind is one of the kinds of SPEC section 9, e.g. "type").
#   A `catch` turns it into an error map.
# - MiniThrow: a value thrown by `throw`.
# Each records the 1-based line and column where it is reported.

class CompileError < Exception
  attr_reader phase, line, col
end

class MiniError < Exception
  attr_reader kind, line, col
end

class MiniThrow < Exception
  attr_reader value, line, col
end

# A bug in this interpreter (never a fault of the Mini program).
class InternalError < Exception
end

def lexical_error(message, line, col) = CompileError.new(message, "lexical", line, col)
def syntax_error(message, line, col) = CompileError.new(message, "syntax", line, col)
def static_error(message, line, col) = CompileError.new(message, "static", line, col)
def runtime_error(kind, message, line, col) = MiniError.new(message, kind, line, col)

# The one-line report of SPEC section 1: "<kind> error at <line>:<col>: <message>".
def error_line(kind, line, col, message) = "#{kind} error at #{line}:#{col}: #{message}"

# "1 argument", "2 arguments": the noun agrees with the count.
def count_noun(n, singular, plural) = n == 1 ? "#{n} #{singular}" : "#{n} #{plural}"

# The arity wording shared by the static check and the runtime check (SPEC 6.6):
# "f expects 2 arguments", "f expects 1 to 2 arguments", "min expects at least 1 argument".
# max is nil when there is no maximum.
def arity_message(name, min, max, given)
  expected =
    if max == nil
      "at least #{count_noun(min, "argument", "arguments")}"
    elsif min == max
      count_noun(min, "argument", "arguments")
    else
      "#{min} to #{count_noun(max, "argument", "arguments")}"
    end
  "#{name} expects #{expected}, got #{given}"
end
