def responses
  Array[
    {age: 23, region: "north", answer: "yes"}, {age: 35, region: "south", answer: "no"},
    {age: 41, region: "north", answer: "yes"}, {age: 19, region: "east", answer: "unsure"},
    {age: 52, region: "south", answer: "no"}, {age: 67, region: "east", answer: "no"},
    {age: 29, region: "north", answer: "yes"}, {age: 33, region: "east", answer: "yes"},
    {age: 45, region: "south", answer: "unsure"}, {age: 58, region: "north", answer: "no"},
    {age: 71, region: "south", answer: "no"}, {age: 26, region: "south", answer: "yes"},
    {age: 38, region: "east", answer: "yes"}, {age: 62, region: "north", answer: "unsure"},
    {age: 17, region: "east", answer: "yes"}, {age: 48, region: "north", answer: "no"},
    {age: 31, region: "south", answer: "yes"}, {age: 55, region: "east", answer: "no"},
    {age: 24, region: "north", answer: "skip"}, {age: 44, region: "east", answer: "yes"}
  ]
end

def answers = String.split("yes no unsure", " ")

def age_band(age)
  if age < 18 then nil
  elsif age < 30 then "18-29"
  elsif age < 45 then "30-44"
  elsif age < 60 then "45-59"
  else "60+"
  end
end

def crosstab(rows)
  table = Hash.new(0)
  Array.each(rows) { |key, ans| table[[key, ans]] += 1 }
  table
end

def print_table(title, table, keys)
  puts(title)
  puts(format("  %-8s", "") + Array.join(Array.map(answers) { format("%14s", it) }, "") + format("%7s", "n"))
  Array.each(keys) do |k|
    n = Array.sum(answers) { |a| table[[k, a]] }
    cells = Array.map(answers) do |a|
      c = table[[k, a]]
      format("%5d (%5.1f%%)", c, n == 0 ? 0.0 : c * 100.0 / n)
    end
    puts(format("  %-8s", k) + Array.join(cells, "") + format("%7d", n))
  end
end

def chi_square(table, keys)
  total = Hash.sum(table) { |k, v| v }
  stat = 0.0
  Array.each(keys) do |k|
    row = Array.sum(answers) { |a| table[[k, a]] }
    Array.each(answers) do |a|
      col = Array.sum(keys) { |kk| table[[kk, a]] }
      expected = row * col * 1.0 / total
      stat += (table[[k, a]] - expected) ** 2 / expected if expected > 0
    end
  end
  [stat, (Array.size(keys) - 1) * (Array.size(answers) - 1)]
end

all = responses
valid = Array.select(all) { |r| r => {answer:, age:}; Array.include?(answers, answer) && age_band(age) != nil }
dropped = Array.size(all) - Array.size(valid)
puts("#{Array.size(all)} responses, #{Array.size(valid)} usable, #{dropped} dropped (minor or invalid answer)")
puts

by_region = crosstab(Array.map(valid) { |r| r => {region:, answer:}; [region, answer] })
regions = Array.sort(Array.uniq(Array.map(valid) { |r| r => {region:}; region }))
print_table("Answer by region", by_region, regions)
stat, dof = chi_square(by_region, regions)
puts(format("  chi-square %.3f with %d degrees of freedom", stat, dof))
puts

by_age = crosstab(Array.filter_map(valid) do |r|
  r => {age:, answer:}
  band = age_band(age)
  band ? [band, answer] : nil
end)
bands = Array.sort(Array.uniq(Array.map(Hash.keys(by_age)) { |band, a| band }))
print_table("Answer by age band", by_age, bands)
stat2, dof2 = chi_square(by_age, bands)
puts(format("  chi-square %.3f with %d degrees of freedom", stat2, dof2))
puts

yes_rate = Array.map(bands) { |b| n = Array.sum(answers) { |a| by_age[[b, a]] }; [b, by_age[[b, "yes"]] * 1.0 / n] }
most = Array.max_by(yes_rate) { |b, r| r }
least = Array.min_by(yes_rate) { |b, r| r }
if most && least
  mb, mr = most
  lb, lr = least
  puts(format("'yes' is most common in %s (%.0f%%) and least in %s (%.0f%%)", mb, mr * 100, lb, lr * 100))
end
