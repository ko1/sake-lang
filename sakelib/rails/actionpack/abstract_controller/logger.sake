# Port of actionpack-8.1.3/lib/abstract_controller/logger.rb and action_controller/metal/logging.rb (partial: no log_at)
#
# Ruby's `config_accessor :logger` (ActiveSupport::Configurable, so one logger for the controller classes, which
# railties sets to Rails.logger): a module-level slot here.

require "rails/activesupport/active_support/logger"

module AbstractController
  module Logger
    def _logger_config = once { Hash.of(:logger => nil) }
    def set_logger(l) = _logger_config[:logger] = l
    def class_logger = _logger_config[:logger]
    module_function :_logger_config, :set_logger, :class_logger

    def logger(c) = Logger.class_logger
  end
end
