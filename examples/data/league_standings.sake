# Builds a league table from match results round by round with a Comparable Team type (points, goal
# difference, goals, name), recent form, rank movement and rank history.
# Shows: include Comparable with a multi-key `<=>` written as a Tuple comparison, a heredoc parsed
# with Regexp, format.

class Team
  include Comparable
  attr_reader name, played, won, drawn, lost, goals_for, goals_against, form

  def points(t) = @won * 3 + @drawn
  def goal_diff(t) = @goals_for - @goals_against

  def <=>(a, b)
    c = Team.points(b) <=> points(a)
    c = Team.goal_diff(b) <=> goal_diff(a) if c == 0
    c = Team.goals_for(b) <=> @goals_for if c == 0
    c = @name <=> Team.name(b) if c == 0
    c
  end

  def record!(t, scored, conceded)
    @played += 1
    @goals_for += scored
    @goals_against += conceded
    if scored > conceded
      @won += 1
      Array.push(@form, "W")
    elsif scored == conceded
      @drawn += 1
      Array.push(@form, "D")
    else
      @lost += 1
      Array.push(@form, "L")
    end
  end
end

def results
  <<~TXT
    1: Lions 2-1 Tigers, Bears 0-0 Wolves, Eagles 3-1 Sharks
    2: Tigers 1-1 Bears, Wolves 2-0 Eagles, Sharks 1-4 Lions
    3: Lions 0-2 Wolves, Eagles 2-2 Tigers, Bears 3-1 Sharks
    4: Wolves 1-1 Tigers, Sharks 0-1 Eagles, Lions 1-0 Bears
    5: Tigers 3-0 Sharks, Bears 2-2 Eagles, Wolves 1-3 Lions
  TXT
end

def last_n(a, n) = Array.size(a) <= n ? a : Array.drop(a, Array.size(a) - n)

def standings(table) = Array.sort(Hash.values(table))

def ranks(table)
  out = Hash[]
  Array.each_with_index(standings(table)) { |t, i| out[Team.name(t)] = i + 1 }
  out
end

table = Hash[]
previous = nil
history = Hash[]
Array.each(String.lines(results)) do |line|
  _round, games = String.split(String.chomp(line), ": ")
  previous = ranks(table) unless Hash.empty?(table)
  Array.each(String.split(games, ", ")) do |g|
    m = String.match(g, /\A(\w+) (\d+)-(\d+) (\w+)\z/)
    next unless m
    home = table[m[1]] ||= Team.new(m[1], 0, 0, 0, 0, 0, 0, Array[])
    away = table[m[4]] ||= Team.new(m[4], 0, 0, 0, 0, 0, 0, Array[])
    hs = String.to_i(m[2])
    as = String.to_i(m[3])
    Team.record!(home, hs, as)
    Team.record!(away, as, hs)
  end
  now = ranks(table)
  Hash.each(now) { |name, r| Array.push(history[name] ||= Array[], r) }
end

puts(format("%-3s %-7s %2s %2s %2s %2s %5s %4s %3s  %-6s %s", "#", "team", "P", "W", "D", "L", "goals", "GD", "Pts", "form", "move"))
Array.each_with_index(standings(table)) do |t, i|
  name = Team.name(t)
  before = previous ? previous[name] : nil
  move = if before == nil then "new"
         elsif before > i + 1 then "+#{before - i - 1}"
         elsif before < i + 1 then "-#{i + 1 - before}"
         else "="
         end
  form = Array.join(last_n(Team.form(t), 5), "")
  puts(format("%-3d %-7s %2d %2d %2d %2d %2d:%-2d %+4d %3d  %-6s %s", i + 1, name, Team.played(t), Team.won(t),
              Team.drawn(t), Team.lost(t), Team.goals_for(t), Team.goals_against(t),
              Team.goal_diff(t), Team.points(t), form, move))
end

puts
puts("Rank by round:")
Hash.each(history) { |name, rs| puts(format("  %-7s %s", name, Array.join(rs, " "))) }
leader = Array.first(standings(table))
puts
puts("Leader: #{Team.name(leader)} with #{Team.points(leader)} points") if leader
unbeaten = Array.select(Hash.values(table)) { Team.lost(it) == 0 }
puts("Unbeaten: #{Array.empty?(unbeaten) ? "none" : Array.join(Array.map(unbeaten) { Team.name(it) }, ", ")}")
best_attack = Array.max_by(Hash.values(table)) { Team.goals_for(it) }
puts("Best attack: #{Team.name(best_attack)} (#{Team.goals_for(best_attack)} goals)") if best_attack
