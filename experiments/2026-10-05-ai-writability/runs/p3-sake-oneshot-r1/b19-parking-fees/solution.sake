def money(c) = format("%d.%02d", c / 100, c % 100)

def part(r, first, step)
  return 0 if r == 0
  extra = r <= 60 ? 0 : (r - 60 + 29) / 30
  first + step * extra
end

def fee(stay, first, step, cap, grace)
  return 0 if stay <= grace
  d = stay / 1440
  r = stay % 1440
  pr = part(r, first, step)
  d * cap + (pr < cap ? pr : cap)
end

def main
  lines = IO.readlines(IO.stdin)
  hd = String.split(String.strip(lines[0]), /\s+/)
  first = String.to_i(hd[1])
  step = String.to_i(hd[2])
  cap = String.to_i(hd[3])
  grace = String.to_i(hd[4])
  inside = Hash[]
  exits = Hash[]
  rev = Hash[]
  day = 0
  prev = -1
  k = 1
  while k < Array.size(lines)
    raw = String.chomp(lines[k])
    k += 1
    next if String.match?(raw, /\A *\z/)
    m = String.match(raw, /\A(\d\d):(\d\d) +(IN|OUT) +([A-Z0-9]{1,8})\z/)
    valid = false
    hh = 0
    mm = 0
    if m
      hh = String.to_i(m[1])
      mm = String.to_i(m[2])
      valid = hh <= 23 && mm <= 59
    end
    unless valid
      puts("line #{k}: invalid")
      next
    end
    tm = hh * 60 + mm
    day += 1 if tm < prev
    prev = tm
    at = day * 1440 + tm
    plate = m[4]
    if m[3] == "IN"
      if inside[plate] == nil
        inside[plate] = at
      else
        puts("line #{k}: #{plate} already inside")
      end
    else
      t0 = inside[plate]
      if t0 == nil
        puts("line #{k}: #{plate} not inside")
      else
        Hash.delete(inside, plate)
        stay = at - t0
        f = fee(stay, first, step, cap, grace)
        puts(format("%s %d:%02d %s", plate, stay / 60, stay % 60, money(f)))
        exits[plate] = (exits[plate] == nil ? 0 : exits[plate]) + 1
        rev[plate] = (rev[plate] == nil ? 0 : rev[plate]) + f
      end
    end
  end
  puts("--- summary")
  plates = Array.sort_by(Hash.keys(exits)) { |pl| [-rev[pl], pl] }
  te = 0
  tr = 0
  Array.each(plates) do |pl|
    puts("#{pl} #{exits[pl]} #{money(rev[pl])}")
    te += exits[pl]
    tr += rev[pl]
  end
  puts("total #{te} #{money(tr)}")
  ins = Array.sort(Hash.keys(inside))
  puts("inside: #{Array.empty?(ins) ? "none" : Array.join(ins, ", ")}")
end

main()
