Maze = Struct.new(:grid, :start, :goal)

class Maze
  def parse(text)
    grid = Array.map(String.lines(text)) { |l| String.chars(String.chomp(l)) }
    start = nil
    goal = nil
    Array.each_with_index(grid) do |row, r|
      Array.each_with_index(row) do |ch, c|
        start = [r, c] if ch == "S"
        goal = [r, c] if ch == "E"
      end
    end
    raise ArgumentError, "maze has no start" unless start
    raise ArgumentError, "maze has no exit" unless goal
    Maze.new(grid, start, goal)
  end

  def open?(m, r, c)
    return false if r < 0 || c < 0
    row = @grid[r]
    return false unless row
    ch = row[c]
    ch != nil && ch != "#"
  end

  def solve(m)
    dirs = Array[[0, 1], [1, 0], [0, -1], [-1, 0]]
    parent = Hash[]
    parent[@start] = @start
    queue = Array[@start]
    while Array.size(queue) > 0
      cur = Array.shift(queue)
      break if cur == @goal
      r, c = cur
      Array.each(dirs) do |dr, dc|
        nxt = [r + dr, c + dc]
        nr, nc = nxt
        next unless open?(m, nr, nc)
        next if Hash.key?(parent, nxt)
        parent[nxt] = cur
        Array.push(queue, nxt)
      end
    end
    return nil unless Hash.key?(parent, @goal)
    path = Array[@goal]
    node = @goal
    while node != @start
      node = parent[node]
      Array.unshift(path, node)
    end
    path
  end

  def render(m, path)
    rows = Array.map(@grid) { |row| Array.dup(row) }
    Array.each(path) do |r, c|
      rows[r][c] = "*" if rows[r][c] == "."
    end
    Array.join(Array.map(rows) { |row| Array.join(row) }, "\n")
  end

  def open_count(m) = Array.sum(Array.map(@grid) { |row| Array.count(row) { it != "#" } })
end

def report(name, text)
  puts("--- #{name} ---")
  maze = Maze.parse(text)
  path = Maze.solve(maze)
  if path
    puts("shortest path: #{Array.size(path) - 1} steps")
    turns = 0
    Array.each_cons(path, 3) do |a, b, c|
      ar, ac = a
      br, bc = b
      cr, cc = c
      turns += 1 if (br - ar) != (cr - br) || (bc - ac) != (cc - bc)
    end
    puts("turns: #{turns}")
    puts(Maze.render(maze, path))
  else
    puts("no path (#{Maze.open_count(maze)} open cells)")
  end
rescue ArgumentError => e
  puts("bad maze: #{Exception.message(e)}")
end

report("small", "#######\n#S..#.#\n#.#.#.#\n#.#...#\n#.###.#\n#...#E#\n#######\n")
report("open room", "S.....\n......\n..##..\n......\n.....E\n")
report("walled off", "#####\n#S#.#\n###.#\n#..E#\n#####\n")
report("broken", "#####\n#...#\n#..E#\n#####\n")
report("winding", "S.#.......\n..#.####.#\n.##.#..#..\n....#.##.#\n#####.#..#\n#.....#.##\n#.#####..E\n")
