# highline: questions and answers on a terminal, after the highline gem (2.x): a subset.
#
#   cli = HighLine.new(IO.stdin, IO.stdout)            # or a StringIO for either
#   name = HighLine.ask(cli, "Name? ")                 # a String; the prompt stays on its line
#   age = HighLine.ask_integer(cli, "Age? ", range: 0..120)
#   HighLine.agree(cli, "Continue? ")                  # true / false from yes / no
#   fruit = HighLine.choose(cli, String["apple", "banana"], header: "Fruits")  # 1. apple / 2. banana / ?
#   HighLine.say(cli, "Done")
#
# Ruby's ask(question, Integer) { |q| q.in = 0..120 } configures a Question in a block and returns
# the converted type. Sake cannot store the block, and a type is not a value, so the answer type
# picks the operation (ask → String, ask_integer → Integer, ask_float → Float) and the Question's
# settings are keywords: default:, validate: (a Regexp), range: (Ruby's q.in; `in` is a reserved
# word), above:, below:. The messages and the flow are the gem's: an invalid answer prints its
# response and then "?  " to read again (agree re-asks the question), a default is shown as |default|,
# and an input at its end raises EOFError.

require "stringio"

# HighLine.new(input = IO.stdin, output = IO.stdout) as Ruby, over IO or StringIO values.
class HighLine
  attr_reader input, output

  def initialize(cli)
    @input = IO.stdin if @input == nil
    @output = IO.stdout if @output == nil
  end

  # --- the streams ---

  def write(cli, s)
    o = @output
    case o
    in IO
      IO.print(o, s)
      IO.flush(o)
    in StringIO
      StringIO.print(o, s)
      StringIO.flush(o)
    end
    nil
  end

  def writeln(cli, s)
    o = @output
    case o
    in IO then IO.puts(o, s)
    in StringIO then StringIO.puts(o, s)
    end
    nil
  end

  def read_line(cli)
    i = @input
    case i
    in IO then IO.gets(i)
    in StringIO then StringIO.gets(i)
    end
  end

  # Ruby's say: a statement ending in a space or a tab is printed without a newline (a prompt).
  def say(cli, statement)
    s = Kernel.to_s(statement)
    last = String.[](s, -1)
    if last == " " || last == "\t"
      write(cli, s)
    else
      writeln(cli, s)
    end
  end

  def newline(cli) = writeln(cli, "")

  # Ruby's list(items, :rows): one item per line (the other modes are not here).
  def list(cli, items, mode = :rows)
    raise ArgumentError, "unsupported list mode #{Kernel.inspect(mode)}" unless mode == :rows
    Array.join(Array.map(items) { |i| "#{i}\n" })
  end

  # --- asking ---

  # The gem's Question#append_default: "Name? " => "Name? |Alice| ".
  def append_default(question, default)
    return question if default == nil
    m = String.match(question, /([\t ]+)\z/)
    if m
      "#{question}|#{default}|#{m[1]}"
    elsif question == ""
      "|#{default}|  "
    elsif String.end_with?(question, "\n")
      "#{String.chomp(question)}  |#{default}|\n"
    else
      "#{question}  |#{default}|"
    end
  end

  def get_line(cli)
    line = read_line(cli)
    raise EOFError, "The input stream is exhausted." if line == nil
    String.chomp(line)
  end

  # One answer, stripped; an empty one is the default, shown as a String (it is converted after).
  def read_answer(cli, default)
    answer = String.strip(get_line(cli))
    answer == "" && default != nil ? Kernel.to_s(default) : answer
  end

  # The gem's explain_error: the response, then what to ask again ("?  ", or the question).
  def explain_error(cli, response, ask_on_error)
    say(cli, response)
    say(cli, ask_on_error)
  end

  def in_range?(v, range, above, below)
    return false if above != nil && !(v > above)
    return false if below != nil && !(v < below)
    return false if range != nil && !Range.include?(range, v)
    true
  end

  def expected_range(range, above, below)
    parts = String[]
    Array.push(parts, "above #{above}") if above != nil
    Array.push(parts, "below #{below}") if below != nil
    Array.push(parts, "included in #{Kernel.inspect(range)}") if range != nil
    Array.join(parts, " and ")
  end

  def not_in_range_response(range, above, below) = "Your answer isn't within the expected range (#{expected_range(range, above, below)})."

  # Ruby: ask(question) { |q| q.default = ...; q.validate = /re/ }; the answer is a String.
  def ask(cli, question, default: nil, validate: nil)
    say(cli, append_default(question, default))
    loop do
      answer = read_answer(cli, default)
      if validate != nil && !String.match?(answer, validate)
        explain_error(cli, "Your answer isn't valid (must match #{Kernel.inspect(validate)}).", "?  ")
        next
      end
      break answer
    end
  end

  # Ruby: ask(question, Integer) { |q| q.in = 0..120; q.above = 0; q.below = 10 }.
  def ask_integer(cli, question, default: nil, range: nil, above: nil, below: nil)
    say(cli, append_default(question, default))
    loop do
      answer = read_answer(cli, default)
      v = Integer(answer) rescue nil
      if v == nil
        explain_error(cli, "You must enter a valid Integer.", "?  ")
        next
      end
      if !in_range?(v, range, above, below)
        explain_error(cli, not_in_range_response(range, above, below), "?  ")
        next
      end
      break v
    end
  end

  # Ruby: ask(question, Float) { |q| ... }.
  def ask_float(cli, question, default: nil, range: nil, above: nil, below: nil)
    say(cli, append_default(question, default))
    loop do
      answer = read_answer(cli, default)
      v = Float(answer) rescue nil
      if v == nil
        explain_error(cli, "You must enter a valid Float.", "?  ")
        next
      end
      if !in_range?(v, range, above, below)
        explain_error(cli, not_in_range_response(range, above, below), "?  ")
        next
      end
      break v
    end
  end

  # Ruby: agree(question): y / yes / n / no (any case) => true / false; anything else is asked again.
  def agree(cli, question, default: nil)
    q = append_default(question, default)
    say(cli, q)
    loop do
      answer = read_answer(cli, default)
      if String.match?(answer, /\A(?:y(?:es)?|no?)\z/i)
        break String.downcase(String.[](answer, 0) || "") == "y"
      end
      explain_error(cli, "Please enter \"yes\" or \"no\".", q)
    end
  end

  # The index in `choices` of the one `s` names: its exact text, or a unique prefix (any case);
  # :ambiguous when several start with it, nil when none does (the gem's OptionParser completion).
  def complete(choices, s)
    exact = Array.index(choices, s)
    return exact if exact != nil
    down = String.downcase(s)
    found = Array.select(Array.each_with_index(choices)) { |c, i| String.start_with?(String.downcase(c), down) }
    return nil if Array.empty?(found)
    return :ambiguous if Array.size(found) > 1
    _, i = Array.fetch(found, 0)
    i
  end

  def choices_complete_list(choices) = "[#{Array.join(choices, ", ")}]"

  # Ruby: choose { |menu| menu.header = "Fruits"; menu.prompt = "? "; menu.choices("apple", "banana") }
  # with the gem's defaults (numbered, "1. apple", prompt "?  ", chosen by number or name). The items
  # are the Array; the result is the chosen item (an action block per item cannot be stored).
  def choose(cli, items, prompt: "?  ", header: nil)
    names = Array.map(items) { |item| Kernel.to_s(item) }
    indexes = Array.map(Range.to_a(1..Array.size(items))) { |i| Integer.to_s(i) }
    choices = indexes + names
    lines = Array.map(Array.each_with_index(items)) { |item, i| "#{i + 1}. #{item}" }
    say(cli, (header == nil ? "" : "#{header}:\n") + list(cli, lines) + prompt)
    loop do
      answer = read_answer(cli, nil)
      found = complete(choices, answer)
      case found
      in nil then explain_error(cli, "You must choose one of #{choices_complete_list(choices)}.", "?  ")
      in :ambiguous then explain_error(cli, "Ambiguous choice.  Please choose one of #{choices_complete_list(choices)}.", "?  ")
      in Integer
        n = Array.size(indexes)
        break Array.fetch(items, found < n ? found : found - n)
      end
    end
  end
end
