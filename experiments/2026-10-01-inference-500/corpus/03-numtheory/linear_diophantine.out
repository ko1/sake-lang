== extended Euclid ==
gcd(240, 46) = 2 = 240*(-9) + 46*(47)  quotients [5, 4, 1, 1, 2]
gcd(1071, 462) = 21 = 1071*(-3) + 462*(7)  quotients [2, 3, 7]
gcd(17, 5) = 1 = 17*(-2) + 5*(7)  quotients [3, 2, 2]
gcd(99, 78) = 3 = 99*(-11) + 78*(14)  quotients [1, 3, 1, 2, 2]
== lcm of 1..n ==
  lcm(1..4) = 12
  lcm(1..8) = 840
  lcm(1..12) = 27720
  lcm(1..16) = 720720
  lcm(1..20) = 232792560
== a*x + b*y = c ==
12x + 18y = 30: x = -5 + 3n, y = 5 - 2n
12x + 18y = 31: no solution (6 does not divide 31)
7x + 11y = 100: x = -300 + 11n, y = 200 - 7n
35x + 15y = 5: x = 1 + 3n, y = -2 - 7n
6x + 10y = 7: no solution (2 does not divide 7)
== stamps of 5 and 7 cents ==
  24: 2x5+2x7
  35: 0x5+5x7, 7x5+0x7
  23: impossible
  74: 5x5+7x7, 12x5+2x7
largest impossible amount: 23
unreachable count: 12 = (5-1)(7-1)/2 = 12
