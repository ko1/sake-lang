# [points, is_double] or nil
def dart(tok)
  return [25, false] if tok == "25"
  return [50, true] if tok == "BULL"
  return [0, false] if tok == "MISS"
  m = String.match(tok, /\A([SDT])([1-9]|1[0-9]|20)\z/)
  return nil if m == nil
  c = MatchData.captures(m)
  n = String.to_i(c[1])
  if c[0] == "S"
    [n, false]
  elsif c[0] == "D"
    [n * 2, true]
  else
    [n * 3, false]
  end
end

def header(line)
  return nil if line == nil
  f = String.split(String.strip(line), /\s+/)
  return nil if Array.size(f) < 2 || Array.size(f) > 5
  return nil if !String.match?(f[0], /\A\d+\z/)
  start = String.to_i(f[0])
  return nil if start < 2 || start > 1001
  names = Array.drop(f, 1)
  return nil if !Array.all?(names) { |x| String.match?(x, /\A[a-z]{1,10}\z/) }
  return nil if Array.size(Array.uniq(names)) != Array.size(names)
  [start, names]
end

h = header(gets)
if h == nil
  puts("invalid header")
  exit
end
start = h[0]
names = h[1]
left = Hash[]
turns = Hash.new(0)
thrown = Hash.new(0)
Array.each(names) { |x| left[x] = start }
winner = nil
n = 1
while (raw = gets)
  n += 1
  line = String.strip(raw)
  next if String.empty?(line)
  f = String.split(line, /\s+/)
  who = f[0]
  ds = Array.drop(f, 1)
  if winner != nil
    puts("line #{n}: game over")
  elsif !Array.include?(names, who)
    puts("line #{n}: unknown player #{who}")
  elsif Array.size(ds) < 1 || Array.size(ds) > 3
    puts("line #{n}: expected 1 to 3 darts")
  else
    bad = Array.find(ds) { |t| dart(t) == nil }
    if bad != nil
      puts("line #{n}: bad dart #{bad}")
    else
      before = left[who]
      cur = before
      total = 0
      result = :score
      last = ""
      Array.each(ds) do |t|
        d = dart(t)
        nl = cur - d[0]
        thrown[who] += 1
        if nl < 0 || nl == 1 || (nl == 0 && !d[1])
          result = :bust
          break
        elsif nl == 0
          result = :out
          last = t
          cur = 0
          break
        else
          cur = nl
          total += d[0]
        end
      end
      turns[who] += 1
      if result == :bust
        left[who] = before
        puts("#{who} busts, #{before} left")
      elsif result == :out
        left[who] = 0
        winner = who
        puts("#{who} checks out with #{last}")
      else
        left[who] = cur
        puts("#{who} scores #{total}, #{cur} left")
      end
    end
  end
end

puts("STANDINGS")
idx = Hash[]
i = 0
Array.each(names) do |x|
  idx[x] = i
  i += 1
end
rank = 1
Array.each(Array.sort_by(names) { |x| [left[x], idx[x]] }) do |x|
  avg = thrown[x] == 0 ? "-" : format("%.2f", (start - left[x]) * 3.0 / thrown[x])
  puts(format("%d. %-10s %4d %3d %6s", rank, x, left[x], turns[x], avg))
  rank += 1
end
puts(winner == nil ? "no winner" : "winner: #{winner}")
