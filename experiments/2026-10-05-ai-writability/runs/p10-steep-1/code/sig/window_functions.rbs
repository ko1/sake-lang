module Sql
  module WindowFunctions
    ARITY: Hash[String, Array[Integer]]

    def self.window_only?: (String function) -> bool
    def self.accepts?: (String function, Integer argc) -> bool
    def self.value: (Ast::WindowCall call, WindowPartition partition, Integer pos) -> value
    def self.percent_rank: (WindowPartition partition, Integer pos) -> Float
    def self.ntile: (Ast::WindowCall call, WindowPartition partition, Integer pos) -> Integer
    def self.shifted: (Ast::WindowCall call, WindowPartition partition, Integer pos) -> value
    def self.frame_value: (Ast::WindowCall call, WindowPartition partition, Integer pos, Integer which) -> value
    def self.nth_value: (Ast::WindowCall call, WindowPartition partition, Integer pos) -> value
    def self.integer_argument: (Ast::WindowCall call, WindowPartition partition, Integer pos, Integer index) -> Integer?
  end
end
