# More of the subset: nil as Option, swaps, Array operations, default arguments, strings, floats.
module Geo
  class Vec
    attr_accessor x, y
    def add(v, w) = Vec.new(@x + Vec.x(w), @y + Vec.y(w))
    def to_s(v) = "(#{@x}, #{@y})"
  end
end

def first_even(xs)
  Array.each(xs) { |x| return x if x % 2 == 0 }
  nil
end

def scale(x, k = 10) = x * k

def each_pair(a, b)
  yield(a, b)
  yield(b, a)
end

def count_up(n)
  return 0 unless block_given?
  total = 0
  Integer.times(n) { |i| total += yield(i) }
  total
end

xs = Array.new(5) { |i| i * i }
p(xs)
e = first_even(Array[1, 3, 4, 5])
p(e)
if e != nil
  puts(e + 1)
end
p(first_even(Array[1, 3]))
m = Array.first(xs)
puts(m == nil ? "none" : "some")
a = 1
b = 2
a, b = b, a
puts("#{a} #{b}")
puts(scale(3), scale(3, 2))
each_pair(1, 2) { |p, q| puts(p - q) }
puts(count_up(4) { |i| i * 2 })
puts(count_up(4))
sq = Array.map(xs) { |x| x + 1 }
ev = Array.select(sq) { |x| x % 2 == 0 }
puts(Array.join(ev, ","), Array.sum(ev), Array.include?(ev, 10), Array.length(Array.reject(sq) { |x| x > 1 }))
s = "Hello, World"
puts(String.upcase(s), String.length(s), String.include?(s, "World"), s + "!", String.reverse("abc"))
puts(7 / 2, -7 / 2, 7 % 3, -7 % 3, 2 ** 10, 7.0 / 2, 1e20, 1.5e-7, 0.1 + 0.2, 3.0, 100.0 / 3)
puts(Float.to_i(3.7), Float.round(2.5), Float.floor(-1.5), Integer.to_f(3), Math.sqrt(16))
v = Geo::Vec.new(1, 2)
w = Geo::Vec.add(v, Geo::Vec.new(10, 20))
puts(Geo::Vec.to_s(w))
p(w, [1, "two", 3.0], Array[Array[1], Array[2, 3]])
i = 0
while true
  i += 1
  next if i == 2
  break if i > 4
  puts(i)
end
Array.each_with_index(Array["a", "b"]) { |x, k| puts("#{k}: #{x}") }
Range.each(1..3) { |k| puts(k) }
t = [1, "x"]
puts(t[0], t[1])
