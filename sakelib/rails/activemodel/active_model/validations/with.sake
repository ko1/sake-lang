# Port of activemodel-8.1.3/lib/active_model/validations/with.rb (partial: the instance's validates_with)
#
# WithValidator (`validates :x, with: :method`) sends the method to the record: here through the record's
# read_attribute_for_validation (Ruby's send), with the record only (Ruby picks arity 0 or 1 by reflection).
# The class's validates_with is a class-body line (generate/validations.sake).

module ActiveModel
  module Validations
    class WithValidator < EachValidator
      def validate_each(v, record, attr, val)
        method_name = @options[:with]
        method_name => Symbol
        ActiveModel::Validations.read_attribute_for_validation(record, method_name)
      end
    end
  end
end
