fn show(e)
  print(e.kind, e.line, e.col, e.end_line, e.end_col)
end
let m = {"a": {"b": 1}}
try print(m.a.c) catch e show(e) end
try print(m.a.b.c) catch e show(e) end
try print(m["a"].b[0]) catch e show(e) end
fn f() return nil end
try f()() catch e show(e) end
try print(m.a["b"][1:2]) catch e show(e) end
