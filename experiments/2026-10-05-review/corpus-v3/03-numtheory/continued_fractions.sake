# Continued fractions: expansions of rationals, periodic expansions of square
# roots, convergents as Rationals, and the fundamental solution of Pell's equation.

def cf_of_rational(r)
  terms = Integer[]
  num = Rational.numerator(r)
  den = Rational.denominator(r)
  while den != 0
    q, rem = Integer.divmod(num, den)
    Array.push(terms, q)
    num, den = den, rem
  end
  terms
end

def value_of(terms)
  acc = nil
  Array.reverse_each(terms) do |t|
    acc = acc == nil ? Rational(t, 1) : t + 1 / acc
  end
  acc
end

# sqrt(n) = [a0; (a1, ..., ak)] ; returns nil for perfect squares
def sqrt_cf(n)
  a0 = Integer.sqrt(n)
  return nil if a0 * a0 == n
  m = 0
  d = 1
  a = a0
  period = Integer[]
  while a != 2 * a0
    m = d * a - m
    d = (n - m * m) / d
    a = (a0 + m) / d
    Array.push(period, a)
  end
  {a0: a0, period: period}
end

def convergents(a0, period, count)
  out = Array[]
  h1, h0 = a0, 1
  k1, k0 = 1, 0
  Array.push(out, Rational(h1, k1))
  i = 0
  while Array.size(out) < count
    a = period[i % Array.size(period)]
    h1, h0 = a * h1 + h0, h1
    k1, k0 = a * k1 + k0, k1
    Array.push(out, Rational(h1, k1))
    i += 1
  end
  out
end

def pell(n)
  cf = sqrt_cf(n)
  return nil unless cf
  cf => {a0:, period:}
  Array.each(convergents(a0, period, 2 * Array.size(period) + 2)) do |c|
    x = Rational.numerator(c)
    y = Rational.denominator(c)
    return [x, y] if x * x - n * y * y == 1
  end
  nil
end

def show_cf(terms)
  first = Array.first(terms)
  rest = Array.drop(terms, 1)
  "[#{first}; #{Array.join(rest, ", ")}]"
end

puts("rationals:")
Array.each(Array[Rational(415, 93), Rational(649, 200), Rational(-17, 5), 3r / 7]) do |r|
  terms = cf_of_rational(r)
  back = value_of(terms)
  puts("  #{r} = #{show_cf(terms)}  (back: #{back})")
end

puts("square roots:")
lens = Hash[]
Range.each(2..30) do |n|
  cf = sqrt_cf(n)
  next unless cf
  cf => {a0:, period:}
  lens[n] = Array.size(period)
  puts("  sqrt(#{n}) = [#{a0}; (#{Array.join(period, ", ")})]") if n <= 14 || n == 29
end
odd = Array.select(Hash.keys(lens)) { |n| Integer.odd?(lens[n]) }
puts("  odd periods for n <= 30: #{Array.join(odd, " ")}")

puts("convergents of sqrt(2):")
cs = convergents(1, Integer[2], 8)
Array.each(cs) do |c|
  err = Float.abs(Rational.to_f(c) - Math.sqrt(2))
  puts(format("  %-10s %.10f  err %.2e", Rational.to_s(c), Rational.to_f(c), err))
end

puts("Pell x^2 - n*y^2 = 1:")
Array.each(Array[2, 3, 5, 7, 13, 29, 61, 9]) do |n|
  if (sol = pell(n))
    x, y = sol
    puts("  n=#{n}: x=#{x}, y=#{y}")
  else
    puts("  n=#{n}: perfect square, only trivial solution")
  end
end

golden = convergents(1, Integer[1], 12)
puts("golden ratio convergents: #{Array.join(Array.map(golden) { |c| Rational.to_s(c) }, " ")}")
