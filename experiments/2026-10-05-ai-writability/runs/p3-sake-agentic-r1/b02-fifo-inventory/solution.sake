def money(c)
  sign = c < 0 ? "-" : ""
  a = Integer.abs(c)
  "#{sign}#{a / 100}.#{String.rjust(Integer.to_s(a % 100), 2, "0")}"
end

def cents(s)
  parts = String.split(s, ".")
  whole = String.to_i(parts[0])
  frac = parts[1] || ""
  frac = String.ljust(frac, 2, "0")
  whole * 100 + String.to_i(frac)
end

def report(order, lots)
  puts(format("%-12s %5s %10s", "SKU", "QTY", "VALUE"))
  tq = 0
  tv = 0
  Array.each(Array.sort(order)) do |sku|
    q = 0
    v = 0
    Array.each(lots[sku]) do |lot|
      q += lot[0]
      v += lot[0] * lot[1]
    end
    tq += q
    tv += v
    puts(format("%-12s %5d %10s", sku, q, money(v)))
  end
  puts(format("%-12s %5d %10s", "TOTAL", tq, money(tv)))
end

lots = Hash[]
order = Array[]
revenue = 0
cogs = 0
n = 0
Array.each(String.lines(IO.read(IO.stdin))) do |raw|
  n += 1
  f = String.split(String.chomp(raw), " ")
  next if Array.size(f) == 0
  cmd = f[0]
  unless Array.include?(Array["RECEIVE", "SHIP", "REPORT"], cmd)
    puts("line #{n}: error: unknown command #{cmd}")
    next
  end
  if cmd == "REPORT"
    if Array.size(f) != 1
      puts("line #{n}: error: wrong field count")
    else
      report(order, lots)
    end
    next
  end
  if Array.size(f) != 4
    puts("line #{n}: error: wrong field count")
    next
  end
  sku = f[1]
  unless String.match?(sku, /\A[A-Z0-9-]{1,12}\z/)
    puts("line #{n}: error: bad sku")
    next
  end
  unless String.match?(f[2], /\A\d{1,7}\z/) && String.to_i(f[2]) >= 1 && String.to_i(f[2]) <= 1000000
    puts("line #{n}: error: bad quantity")
    next
  end
  unless String.match?(f[3], /\A\d+(\.\d{1,2})?\z/)
    puts("line #{n}: error: bad price")
    next
  end
  qty = String.to_i(f[2])
  price = cents(f[3])
  if cmd == "RECEIVE"
    if lots[sku] == nil
      lots[sku] = Array[]
      Array.push(order, sku)
    end
    Array.push(lots[sku], Array[qty, price])
  else
    if lots[sku] == nil
      puts("line #{n}: error: unknown sku #{sku}")
      next
    end
    have = Array.sum(Array.map(lots[sku]) { |l| l[0] }, 0)
    if have < qty
      puts("line #{n}: error: insufficient stock for #{sku} (have #{have}, need #{qty})")
      next
    end
    need = qty
    cost = 0
    while need > 0
      lot = lots[sku][0]
      take = lot[0] < need ? lot[0] : need
      cost += take * lot[1]
      lot[0] -= take
      need -= take
      Array.shift(lots[sku]) if lot[0] == 0
    end
    rev = qty * price
    revenue += rev
    cogs += cost
    puts("line #{n}: shipped #{qty} #{sku}: revenue #{money(rev)}, cost #{money(cost)}")
  end
end
puts("== final ==")
report(order, lots)
puts("revenue: #{money(revenue)}")
puts("cost of goods sold: #{money(cogs)}")
puts("gross profit: #{money(revenue - cogs)}")
