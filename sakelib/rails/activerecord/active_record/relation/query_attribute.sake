# Port of activerecord-8.1.3/lib/active_record/relation/query_attribute.rb (partial: no StatementCache::Substitute)
#
# Ruby's QueryAttribute < ActiveModel::Attribute: a class including the module here, with Attribute's fields.
# Ruby's unboundable? asks serializable? with a block that keeps `value <=> 0` of an out-of-range value; here
# the Integer type answers out_of_range? and the comparison is made here.

module ActiveRecord
  class Relation
    class QueryAttribute
      attr_reader name, value_before_type_cast, type
      private attr_reader original_attribute
      private attr_accessor cast_value, has_value, database_value, has_value_for_database
      include ActiveModel::Attribute

      def initialize(a)
        @has_value = false
        @has_value_for_database = false
      end

      def type_cast(a, value) = value

      def value_for_database(a)
        unless @has_value_for_database
          @database_value = _value_for_database(a)
          @has_value_for_database = true
        end
        @database_value
      end

      def with_cast_value_of(a, value) = QueryAttribute.new(@name, value, @type)

      def nil_value?(a) = @value_before_type_cast == nil

      def infinite?(a)
        v = @value_before_type_cast
        (v in Float) && Float.infinite?(v) != nil
      end

      def unboundable?(a)
        t = @type
        return nil unless t in ActiveModel::Type::Integer
        v = ActiveModel::Type::Value.cast(t, @value_before_type_cast)
        return nil unless v in Integer
        ActiveModel::Type::Integer.out_of_range?(t, v) ? (v <=> 0) : nil
      end
    end
  end
end
