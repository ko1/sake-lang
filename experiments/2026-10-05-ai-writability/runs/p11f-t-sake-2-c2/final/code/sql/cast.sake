# CAST(x AS INTEGER | REAL | TEXT | BLOB) (2.3, 7.9).
module Cast
  module_function

  # `type` is "integer", "real", "text" or "blob". A BLOB is cast as its text form, except to BLOB.
  def apply(v, type)
    return nil if v == nil
    return to_blob(v) if type == "blob"
    x = Values.rank(v) == 3 ? Values.text_of(v) : v
    case type
    in "integer" then to_integer(x)
    in "real" then to_real(x)
    else Values.text_of(x)
    end
  end

  # A BLOB stays; anything else becomes the BLOB of the bytes of its text form.
  def to_blob(v)
    case v
    in Blob then v
    else BlobFn.of_text(Values.text_of(v))
    end
  end

  def to_integer(v)
    case v
    in Integer then v
    in Float then clamp(Float.truncate(v))
    else text_to_integer(v)
    end
  end

  # An optional sign and digits at the start of the text (after whitespace); 0 if there are none.
  def text_to_integer(s)
    bytes = String.bytes(s)
    n = Array.size(bytes)
    first = 0
    first += 1 while first < n && NumText.space?(bytes[first])
    start = NumText.after_sign(bytes, first)
    stop = start
    stop += 1 while stop < n && NumText.digit?(bytes[stop])
    return 0 if stop == start
    clamp(String.to_i(Text.byteslice(s, first, stop - first)))
  end

  # Integers stay within 64 bits.
  def clamp(n)
    return 9223372036854775807 if n > 9223372036854775807
    return -9223372036854775807 - 1 if n < -9223372036854775807 - 1
    n
  end

  def to_real(v)
    n = Values.to_number(v)
    case n
    in Integer then Integer.to_f(n)
    else n
    end
  end
end
