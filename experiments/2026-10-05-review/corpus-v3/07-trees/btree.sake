class BNode
  attr_accessor keys, children

  def leaf?(n) = Array.empty?(@children)
  def full?(n, t) = Array.size(@keys) == 2 * t - 1
end

class BTree
  attr_reader t
  attr_accessor root = nil, splits = 0

  def initialize(bt) = @root = BNode.new(Array[], Array[])

  def search(bt, key)
    node = @root
    depth = 0
    while node
      keys = BNode.get_keys(node)
      i = 0
      i += 1 while i < Array.size(keys) && key > keys[i]
      return [true, depth] if i < Array.size(keys) && keys[i] == key
      return [false, depth] if BNode.leaf?(node)
      node = BNode.get_children(node)[i]
      depth += 1
    end
    [false, depth]
  end

  def split_child(bt, parent, i)
    t = @t
    full = BNode.get_children(parent)[i]
    keys = BNode.get_keys(full)
    kids = BNode.get_children(full)
    right = BNode.new(Array.drop(keys, t), BNode.leaf?(full) ? Array[] : Array.drop(kids, t))
    median = keys[t - 1]
    BNode.set_keys(full, Array.take(keys, t - 1))
    BNode.set_children(full, Array.take(kids, t)) unless BNode.leaf?(full)
    Array.insert(BNode.get_keys(parent), i, median)
    Array.insert(BNode.get_children(parent), i + 1, right)
    @splits += 1
  end

  def insert(bt, key)
    found, _d = search(bt, key)
    return false if found
    r = @root
    if BNode.full?(r, @t)
      new_root = BNode.new(Array[], Array[r])
      @root = new_root
      split_child(bt, new_root, 0)
      r = new_root
    end
    insert_nonfull(bt, r, key)
    true
  end

  def insert_nonfull(bt, node, key)
    keys = BNode.get_keys(node)
    i = Array.size(keys)
    i -= 1 while i > 0 && key < keys[i - 1]
    if BNode.leaf?(node)
      Array.insert(keys, i, key)
      return
    end
    if BNode.full?(BNode.get_children(node)[i], @t)
      split_child(bt, node, i)
      i += 1 if key > BNode.get_keys(node)[i]
    end
    insert_nonfull(bt, BNode.get_children(node)[i], key)
  end

  def each_key(bt, &block) = walk(@root, &block)

  def walk(node, &block)
    keys = BNode.get_keys(node)
    if BNode.leaf?(node)
      Array.each(keys, &block)
      return
    end
    kids = BNode.get_children(node)
    Array.each_with_index(keys) do |k, i|
      walk(kids[i], &block)
      yield(k)
    end
    walk(Array.last(kids), &block)
  end

  def levels(bt)
    out = Array[]
    level = Array[@root]
    until Array.empty?(level)
      Array.push(out, Array.join(Array.map(level) { |n| "[#{Array.join(BNode.get_keys(n), " ")}]" }, " "))
      level = Array.flat_map(level) { |n| BNode.get_children(n) }
    end
    out
  end

  def range_count(bt, lo, hi)
    n = 0
    each_key(bt) { |k| n += 1 if lo <= k && k <= hi }
    n
  end
end

Array.each(Array[2, 3]) do |t|
  bt = BTree.new(t)
  keys = Array[50, 20, 80, 10, 30, 60, 90, 25, 35, 55, 65, 85, 95, 5, 15, 40, 45, 70, 75, 30, 100, 1]
  dupes = Array.count(keys) { |k| !BTree.insert(bt, k) }
  puts("== minimum degree #{t}: #{Array.size(keys) - dupes} keys, #{dupes} duplicate(s), #{BTree.get_splits(bt)} splits ==")
  Array.each_with_index(BTree.levels(bt)) { |line, d| puts("  L#{d}: #{line}") }
  all = Array[]
  BTree.each_key(bt) { |k| Array.push(all, k) }
  sorted = all == Array.sort(all)
  puts("  in order: #{Array.join(all, ",")} (#{sorted ? "sorted" : "NOT SORTED"})")
  Array.each(Array[45, 100, 33, 1]) do |k|
    found, depth = BTree.search(bt, k)
    puts("  search #{k}: #{found ? "found" : "missing"} at depth #{depth}")
  end
  puts("  keys in 20..60: #{BTree.range_count(bt, 20, 60)}")
end
