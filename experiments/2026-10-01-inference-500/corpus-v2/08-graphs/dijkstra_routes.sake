MinHeap = Struct.new(:items)

class MinHeap
  def create = MinHeap.new(Array[])
  def empty?(h) = Array.empty?(@items)
  def size(h) = Array.size(@items)

  def push(h, prio, value)
    Array.push(@items, [prio, value])
    i = Array.size(@items) - 1
    while i > 0
      parent = (i - 1) / 2
      break if prio_at(h, parent) <= prio_at(h, i)
      swap(h, i, parent)
      i = parent
    end
    h
  end

  def pop(h)
    return nil if Array.empty?(@items)
    top = @items[0]
    last = Array.pop(@items)
    unless Array.empty?(@items)
      @items[0] = last
      sift_down(h, 0)
    end
    top
  end

  def prio_at(h, i)
    prio, _ = @items[i]
    prio
  end

  def swap(h, i, j)
    tmp = @items[i]
    @items[i] = @items[j]
    @items[j] = tmp
  end

  def sift_down(h, i)
    n = Array.size(@items)
    while true
      smallest = i
      l = 2 * i + 1
      r = l + 1
      smallest = l if l < n && prio_at(h, l) < prio_at(h, smallest)
      smallest = r if r < n && prio_at(h, r) < prio_at(h, smallest)
      break if smallest == i
      swap(h, i, smallest)
      i = smallest
    end
  end
end

def build_graph(roads)
  graph = Hash[]
  Array.each(roads) do |a, b, km|
    graph[a] ||= Array[]
    graph[b] ||= Array[]
    Array.push(graph[a], [b, km])
    Array.push(graph[b], [a, km])
  end
  graph
end

def dijkstra(graph, source)
  dist = Hash[source => 0]
  prev = Hash[]
  done = Set[]
  heap = MinHeap.create
  MinHeap.push(heap, 0, source)
  pops = 0
  until MinHeap.empty?(heap)
    d, city = MinHeap.pop(heap)
    pops += 1
    next if Set.include?(done, city)
    Set.add(done, city)
    Array.each(Hash.fetch(graph, city, Array[])) do |nb, km|
      nd = d + km
      old = dist[nb]
      if old == nil || nd < old
        dist[nb] = nd
        prev[nb] = city
        MinHeap.push(heap, nd, nb)
      end
    end
  end
  [dist, prev, pops]
end

def path_to(prev, source, target)
  path = Array[target]
  cur = target
  while cur != source
    cur = prev[cur]
    return nil if cur == nil
    Array.unshift(path, cur)
  end
  path
end

roads = Array[
  ["Amsterdam", "Utrecht", 45], ["Amsterdam", "Haarlem", 20], ["Haarlem", "Leiden", 33],
  ["Leiden", "Den Haag", 19], ["Den Haag", "Rotterdam", 27], ["Utrecht", "Rotterdam", 61],
  ["Utrecht", "Arnhem", 64], ["Utrecht", "Den Bosch", 55], ["Rotterdam", "Breda", 50],
  ["Breda", "Den Bosch", 48], ["Den Bosch", "Eindhoven", 35], ["Eindhoven", "Maastricht", 87],
  ["Arnhem", "Nijmegen", 20], ["Nijmegen", "Den Bosch", 47], ["Amsterdam", "Zwolle", 105],
  ["Zwolle", "Arnhem", 68], ["Zwolle", "Groningen", 103], ["Leiden", "Utrecht", 56],
  ["Texel", "Den Helder", 4]
]
graph = build_graph(roads)
puts("cities: #{Hash.size(graph)}, roads: #{Array.size(roads)}")

source = "Amsterdam"
dist, prev, pops = dijkstra(graph, source)
puts("heap pops: #{pops}")
sorted = Array.sort_by(Hash.keys(graph)) { |c| [Hash.fetch(dist, c, 1_000_000), c] }
Array.each(sorted) do |city|
  d = dist[city]
  if d == nil
    puts(format("%-11s unreachable", city))
  else
    path = path_to(prev, source, city)
    puts(format("%-11s %4d km  %s", city, d, Array.join(path, " > ")))
  end
end

far_city, far_d = Hash.max_by(dist) { |c, d| d }
puts("farthest: #{far_city} (#{far_d} km)")
avg = Array.sum(Hash.values(dist)) / Float(Hash.size(dist))
puts("mean distance: #{Float.round(avg, 1)} km")
