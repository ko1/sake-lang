try [1][5] catch e print(e) end
try print((1) + "a") catch e print(e) end
try
  print(10 / (5 -
   5))
catch e print(e) end
try for x in len(
  "ab") do end catch e print(e) end
try let [a, b] = [1] catch e print(e) end
try assert 1 == 2, "boo" catch e print(e) end
try -"a" catch e print(e) end
try {fn() 1 end: 2} catch e print(e) end
let x = {}
try x.y.z = 3 catch e print(e) end
let m = {"a": 1}
try m.zz catch e print(e) end
try match 1 when "a" then 1 end catch e print(e) end
let ln = len
try ln(1, 2) catch e print(e) end
try
  let q = 1
  q += "x"
catch e print(e) end
try throw 5 catch e print(e) end
try "abc"[1:"x"] catch e print(e) end
print(1 +
  "a")
