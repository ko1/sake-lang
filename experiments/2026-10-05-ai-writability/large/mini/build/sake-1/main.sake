# Mini: an interpreter for the language of ../../SPEC.md.
#
#   sake main.sake [--tokens | --ast] < program.mini
#
# The program goes through four phases (SPEC section 1): lexing (lexer.sake),
# parsing (parser.sake, parser_expr.sake), the static checks (checker.sake)
# and evaluation (interp_*.sake). Everything, errors included, goes to
# standard output, and the exit status is always 0.

require "errors"
require "token"
require "lexer"
require "ast"
require "parser"
require "parser_expr"
require "checker"
require "values"
require "text"
require "operators"
require "interp_stmt"
require "interp_expr"
require "builtins"
require "dump"

def main
  mode = Array.first(ARGV)
  if Array.size(ARGV) > 1 || (mode != nil && mode != "--tokens" && mode != "--ast")
    puts("usage: sake main.sake [--tokens | --ast] < program.mini")
    return
  end
  source = IO.read(IO.stdin)
  begin
    tokens = Lexer.tokenize(source)
    return dump_tokens(tokens, "") if mode == "--tokens"
    program = Parser.parse_program(tokens)
    Checker.check_program(program)
    return dump_block(program, "") if mode == "--ast"
    Machine.run_program(program)
  rescue CompileError => e
    puts("#{CompileError.kind(e)} error at #{CompileError.line(e)}:#{CompileError.col(e)}: #{Exception.message(e)}")
  rescue MiniThrow => e
    puts("runtime error at #{MiniThrow.line(e)}:#{MiniThrow.col(e)}: #{Exception.message(e)}")
  end
  nil
end

main
