def mean(xs) = Array.sum(xs) / Array.length(xs)

def variance(xs)
  m = mean(xs)
  Array.reduce(xs, 0.0) { |acc, x| acc + (x - m) ** 2 } / Array.length(xs)
end

values = Float[2.5, 3.0, 4.5, 1.0, 6.0]
m = mean(values)
v = variance(values)
sd = Math.sqrt(v)

puts(String.+("mean: ", Float.to_s(Float.round(m, 3))))
puts(String.+("variance: ", Float.to_s(Float.round(v, 3))))
puts(String.+("stddev: ", Float.to_s(Float.round(sd, 3))))
above = Array.select(values) { |x| x > m }
puts(String.+("above mean: ", Array.join(Array.map(above) { |x| Float.to_s(x) }, ", ")))
