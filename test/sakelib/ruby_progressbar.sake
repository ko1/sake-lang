require "ruby_progressbar"
require "stringio"

# A bar that renders to a String: the output is a StringIO, the clock is fixed (Ruby: a fake tty
# and a fake time source), so every line below is reproducible.
out = StringIO.new
clock = Time.at(1000)
bar = ProgressBar.create(total: 10, format: "%t: |%B| %p%% %c/%C", length: 50, output: out,
                         throttle_rate: 0, clock: clock)
p(ProgressBar.to_s(bar))
Integer.times(3) { ProgressBar.increment(bar) }
p(ProgressBar.to_s(bar))
p(ProgressBar.progress(bar))
p(ProgressBar.total(bar))
p(ProgressBar.title(bar))
ProgressBar.set_progress(bar, 7)
puts(ProgressBar.to_s(bar))
ProgressBar.set_title(bar, "Files")
ProgressBar.set_progress_mark(bar, "#")
ProgressBar.set_remainder_mark(bar, ".")
puts(ProgressBar.to_s(bar))
p(ProgressBar.finished?(bar))
ProgressBar.finish(bar)
p(ProgressBar.finished?(bar))
p(ProgressBar.stopped?(bar))
puts(ProgressBar.to_s(bar))
p(bar)
# what the terminal would have received: a redraw per update, "\r" between, "\n" at the end
p(StringIO.string(out))

# every molecule, with the time under control (3 seconds per step)
out2 = StringIO.new
clock2 = Time.at(1000)
bar2 = ProgressBar.create(total: 8, length: 40, output: out2, throttle_rate: 0, clock: clock2,
                          format: "%c/%C %a %e %r %R %l %E %f")
step = 3
Integer.times(2) do
  clock2 += step
  ProgressBar.set_clock(bar2, clock2)
  ProgressBar.increment(bar2)
  puts(ProgressBar.to_s(bar2))
end
ProgressBar.increment(bar2)
puts(ProgressBar.to_s(bar2))
ProgressBar.pause(bar2)
clock2 += 10
ProgressBar.set_clock(bar2, clock2)
puts(ProgressBar.to_s(bar2))
p(ProgressBar.paused?(bar2))
ProgressBar.resume(bar2)
puts(ProgressBar.to_s(bar2))
ProgressBar.log(bar2, "hello from the log")
ProgressBar.finish(bar2)
puts(ProgressBar.to_s(bar2))
puts(ProgressBar.to_s(bar2, "%j|%J|%P|%w|%i|%T"))
puts(ProgressBar.to_s(bar2, "%W"))
puts(ProgressBar.to_s(bar2, "a%%b|%b|"))
p(StringIO.string(out2))
h = ProgressBar.to_h(bar2)
Array.each(String["length", "title", "progress", "total", "percentage", "elapsed_time_in_seconds",
                  "estimated_time_remaining_in_seconds", "base_rate_of_change", "throttle_rate",
                  "finished?"]) { |k| puts("#{k}: #{Kernel.inspect(h[k])}") }

# an unknown total: %u is ??, the bar animates
bar3 = ProgressBar.create(total: nil, output: nil, length: 30, format: "%t: |%B| %u %c %p %P")
Integer.times(3) do
  puts(ProgressBar.to_s(bar3))
  ProgressBar.increment(bar3)
end
puts(ProgressBar.to_s(bar3, "%i|%W|%w|%b|"))
p(bar3)
ProgressBar.set_total(bar3, 4)
ProgressBar.finish(bar3)
puts(ProgressBar.to_s(bar3, "%t: |%B| %u %c %p %P"))

# a half-done bar with the percentage inside, starting_at, limits
bar4 = ProgressBar.create(total: 10, output: nil, length: 30, format: "|%W| %j%%", starting_at: 3)
puts(ProgressBar.to_s(bar4))
ProgressBar.set_progress(bar4, 5)
puts(ProgressBar.to_s(bar4))
puts(ProgressBar.to_s(bar4, "|%w|%i| %J %%"))
begin
  ProgressBar.set_progress(bar4, 11)
rescue ProgressBar::InvalidProgressError => e
  puts(Exception.message(e))
end
ProgressBar.set_total(bar4, 20)
puts(ProgressBar.to_s(bar4, "%c/%C %p%%"))
begin
  ProgressBar.set_total(bar4, 2)
rescue ProgressBar::InvalidProgressError => e
  puts(Exception.message(e))
end
ProgressBar.reset(bar4)
p(ProgressBar.progress(bar4))
p(ProgressBar.started?(bar4))
puts(ProgressBar.to_s(bar4, "%a %e"))

# autofinish: false, and the warnings at the ends (on stderr)
bar5 = ProgressBar.create(total: 3, output: nil, length: 20, format: "%B", autofinish: false)
Integer.times(3) { ProgressBar.increment(bar5) }
p(ProgressBar.finished?(bar5))
p(ProgressBar.stopped?(bar5))
ProgressBar.increment(bar5)
ProgressBar.decrement(bar5)
p(ProgressBar.progress(bar5))
ProgressBar.finish(bar5)
p(ProgressBar.finished?(bar5))
ProgressBar.set_progress(bar5, 0)
ProgressBar.decrement(bar5)
p(ProgressBar.progress(bar5))

# a total of 0 is complete at once; a coloured format does not count its escape codes
puts(ProgressBar.to_s(ProgressBar.create(total: 0, output: nil, length: 20, format: "|%B| %p %P")))
puts(ProgressBar.to_s(ProgressBar.create(total: 4, output: nil, length: 20, format: "\e[31m%t\e[0m |%B|", progress_mark: "*")))
puts(ProgressBar.to_s(ProgressBar.create(total: 4, output: nil, length: 3, format: "%t: |%B|")))
begin
  ProgressBar.to_s(ProgressBar.create(total: 4, output: nil, format: "%z"))
rescue KeyError => e
  puts(Exception.message(e))
end
