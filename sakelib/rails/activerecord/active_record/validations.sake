# Port of activerecord-8.1.3/lib/active_record/validations.rb (partial: validations/{associated,presence,absence,length,numericality}.rb, ActiveRecord's own versions of those validators, are not ported: ActiveModel's run)
#
# Over ActiveModel::Validations (which the model includes first, through ActiveModel::API, as Rails' Base does):
# Ruby's `super` in save/save!/valid? is the next body by name (persistence_save, ActiveModel's super_valid?).
# The validators are ActiveModel's generated ones (ActiveModel::Validations::Generate, called by generate/model.sake),
# run in the :validate chain inside the :validation chain (ActiveModel::Validations::Callbacks).

require "validations/uniqueness"

module ActiveRecord
  class RecordInvalid < StandardError
    attr_reader record
    include ActiveRecordError

    # Ruby: RecordInvalid.new(record): the message from activerecord.errors.messages.record_invalid
    def build(record)
      errors = Array.join(ActiveModel::Errors.full_messages(ActiveModel::Validations.errors(record)), ", ")
      scope = ActiveModel::Translation.i18n_scope_of(record)
      ActiveRecord.load_locale
      message = I18n.translate_with(String.to_sym("#{scope}.errors.messages.record_invalid"), nil, nil, :"errors.messages.record_invalid", nil, ".", Hash.of(errors: errors), false)
      RecordInvalid.new(Kernel.to_s(message), record)
    end
  end

  module Validations
    # Ruby's Validations#save, under Transactions#save
    def validations_save(r, validate, context)
      perform_validations(r, validate, context) ? persistence_save(r) : false
    end

    def validations_save!(r, validate, context)
      perform_validations(r, validate, context) ? persistence_save!(r) : raise_validation_error(r)
    end

    def valid?(r, context = nil)
      context ||= default_validation_context(r)
      output = super_valid?(r, context)
      ActiveModel::Errors.empty?(errors(r)) && output != false
    end
    def validate(r, context = nil) = valid?(r, context)
    def invalid?(r, context = nil) = !valid?(r, context)

    def custom_validation_context?(r)
      vc = validation_context(r)
      vc != nil && vc != :create && vc != :update
    end

    def default_validation_context(r) = new_record?(r) ? :create : :update

    def raise_validation_error(r) = raise(RecordInvalid.build(r))

    def perform_validations(r, validate = true, context = nil) = validate == false || valid?(r, context)

    # NumericalityValidator's value as the user gave it (Ruby: `#{attr}_came_from_user?` then `_before_type_cast`)
    def attribute_raw_value_for_validation(r, attr_name)
      name = Symbol.to_s(attr_name)
      attribute_came_from_user?(r, name) ? read_attribute_before_type_cast(r, name) : nil
    end
  end
end
