try [1][5] catch e print(e) end
try print(10 / (5 - 5)) catch e print(e) end
try
  for x in len(
  "ab") do end
catch e print(e) end
try let [a, b] = [1] catch e print(e) end
try
  let m = {(1): 2, true: 3}
catch e print(e) end
let q = 5
try q += "a" catch e print(e) end
try (1) + "a" catch e print(e) end
try match 1 when [[1]] then print(1) end catch e print(e) end
try assert 1 == 2, "x" catch e print(e) end
try -"a" catch e print(e) end
try map([1], fn(x) x.foo end) catch e print(e) end
try
  throw (
    "a")
catch e print(e) end
let f = fn(a) end
try f() catch e print(e) end
try print(
  (f)(1,
  2)) catch e print(e) end
throw "boom"
