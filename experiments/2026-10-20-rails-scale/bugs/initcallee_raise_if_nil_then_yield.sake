# After `raise ... if model == nil` with a model that is only nil, the rest of the function is still checked, here
# the block, which reads the caller's `post` (nil in that call): "Post.title: argument 1 must be Post, but is nil".
# Ruby: form(nil) raises before the yield; this prints "a" and the message. Not caused by 04cea37b (the same with
# fbfd2733). Seen in test/sakelib/rails/actionpack/controller_view.sake once the checker got past the construction:
# ActionView's form_with_options raises on a nil model, but the _form partial's block (`Post.errors_count(post)`) was
# checked with the post of a nil @post. Workaround in the Sake template: `if post && Post.errors_count(post) > 0`.
class Post
  attr_reader title
end
def form_with(model)
  raise ArgumentError, "Passed nil to the :model argument" if model == nil
  yield
end
def form(post) = form_with(post) { Post.title(post) }
p(form(Post.new("a")))
begin
  form(nil)
rescue ArgumentError => e
  puts(Exception.message(e))
end
