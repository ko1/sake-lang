puts(7 / 2)           # Integer / Integer truncates toward -infinity, as in Ruby
puts(-7 / 2)
puts(7 % 3)
puts(7 / 2.0)         # mixing Integer and Float gives Float
puts(2 ** 10)
puts(Float.round(3.14159, 2))
puts(Float.round(2.5))   # without digits: an Integer
puts(Integer.+(1, 2))    # the operator written with its type
puts("ab" * 3)
puts("a" < "b")
p(1/3r + 1/6r)
p(2r ** -1)
