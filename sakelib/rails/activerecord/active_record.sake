# Port of activerecord-8.1.3/lib/active_record.rb (partial: the require list of what is ported: Arel, the types,
# the SQLite3 adapter, and the model layer (Base, Relation, associations, migrations), on ActiveModel)
#
# Ruby's module-level settings (ActiveRecord.default_timezone = :utc, ...) are functions with Rails' defaults.

require "arel"
require "../activemodel/active_model"
require "active_record/errors"
require "active_record/type"
require "active_record/relation/query_attribute"
require "active_record/type_caster"
require "active_record/result"
require "active_record/connection_adapters/sql_type_metadata"
require "active_record/connection_adapters/column"
require "active_record/connection_adapters/abstract/quoting"
require "active_record/connection_adapters/abstract/database_statements"
require "active_record/connection_adapters/abstract/schema_definitions"
require "active_record/connection_adapters/abstract/schema_creation"
require "active_record/connection_adapters/abstract/schema_statements"
require "active_record/connection_adapters/abstract/transaction"
require "active_record/connection_adapters/abstract_adapter"
require "active_record/connection_adapters/sqlite3_adapter"
require "rails/activesupport/active_support/callbacks"
require "rails/activesupport/active_support/notifications"
require "active_record/translation"
require "active_record/model_schema"
require "active_record/core"
require "active_record/attribute_methods"
require "active_record/persistence"
require "active_record/scoping"
require "active_record/integration"
require "active_record/sanitization"
require "active_record/querying"
require "active_record/relation"
require "active_record/validations"
require "active_record/callbacks"
require "active_record/timestamp"
require "active_record/transactions"
require "active_record/counter_cache"
require "active_record/locking/optimistic"
require "active_record/locking/pessimistic"
require "active_record/enum"
require "active_record/store"
require "active_record/secure_token"
require "active_record/associations"
require "active_record/serialization"
require "active_record/connection_handling"
require "active_record/base"
require "active_record/migration"
require "active_record/schema"
require "active_record/schema_dumper"

module ActiveRecord
  module_function

  def default_timezone = :utc
  def version = "8.1.3"
end
