class TooLongWord < StandardError
  attr_reader word, width
end

def badness(words, i, j, width)
  len = Array.sum(words[i..j]) { |w| String.size(w) } + (j - i)
  return nil if len > width
  return 0 if j == Array.size(words) - 1
  (width - len) ** 3
end

# cost[i]: cheapest layout of words[i..]; brk[i]: index after the first line
def layout(words, width)
  Array.each(words) do |w|
    raise TooLongWord.new("word does not fit", w, width) if String.size(w) > width
  end
  n = Array.size(words)
  cost = Array.new(n + 1, 0)
  brk = Array.new(n + 1, n)
  Integer.downto(n - 1, 0) do |i|
    best = nil
    Range.each(i...n) do |j|
      b = badness(words, i, j, width)
      break if b == nil
      total = b + cost[j + 1]
      if best == nil || total < best
        best = total
        brk[i] = j + 1
      end
    end
    cost[i] = best
  end
  lines = Array[]
  i = 0
  while i < n
    Array.push(lines, Array.join(words[i...brk[i]], " "))
    i = brk[i]
  end
  [cost[0], lines]
end

def greedy(words, width)
  lines = Array[]
  current = ""
  Array.each(words) do |w|
    if String.empty?(current)
      current = w
    elsif String.size(current) + 1 + String.size(w) <= width
      current = "#{current} #{w}"
    else
      Array.push(lines, current)
      current = w
    end
  end
  Array.push(lines, current) unless String.empty?(current)
  lines
end

def raggedness(lines, width)
  Array.sum(lines[0...-1]) { |line| (width - String.size(line)) ** 3 }
end

def show(title, lines, width)
  puts("#{title} (cost #{raggedness(lines, width)})")
  puts("  +" + "-" * width + "+")
  Array.each(lines) { |l| puts("  |" + String.ljust(l, width) + "|") }
  puts("  +" + "-" * width + "+")
end

text = "Dynamic programming solves a problem by combining the solutions of overlapping subproblems, each solved once and stored for reuse, which turns many exponential searches into polynomial ones."
words = String.split(text, " ")

Array.each(Array[24, 32]) do |width|
  cost, lines = layout(words, width)
  show("greedy, width #{width}", greedy(words, width), width)
  show("optimal, width #{width}", lines, width)
  puts("  dp cost #{cost} agrees") if cost == raggedness(lines, width)
end

short = String.split("aaa bb cc ddddd", " ")
cost, lines = layout(short, 6)
p(lines)
p(greedy(short, 6))

begin
  layout(String.split("a supercalifragilistic word", " "), 10)
rescue TooLongWord => e
  puts("#{Exception.message(e)}: #{Kernel.inspect(TooLongWord.word(e))} is wider than #{TooLongWord.width(e)}")
end
