# Status (2026-10-03): by design. Every built-in failure names the operation ("Mod.op: ...").
# String.unpack1(s, "m0") raises Ruby's ArgumentError with the built-in's prefix:
# prints "String.unpack1: invalid base64"; Ruby's "YQ".unpack1("m0") says "invalid base64".
# Also: under --strict, unpack1(s, "m") is typed String | nil, although "m" always gives a String.
begin
  String.unpack1("YQ", "m0")
rescue ArgumentError => e
  puts Exception.message(e)
end
