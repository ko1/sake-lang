# Port of activemodel-8.1.3/lib/active_model/attribute_methods.rb (partial: the instance side; method_missing/respond_to? have no Sake form and are not needed)
#
# Ruby defines the attribute methods (`name`, `name=`, `name_changed?`, `restore_name!`, ...) at run time from
# the patterns (attribute_method_prefix/suffix/affix) with define_method, and finds the rest through
# method_missing. Here the generator (generate/attribute_methods.sake, which ports AttributeMethodPattern,
# define_attribute_methods, alias_attribute and define_proxy_call) writes every one of them as a function that
# calls its proxy target with the attribute's name, as Ruby's generated `def name_changed?(**options) =
# attribute_changed?("name", **options)` does. What is left here is what those functions and Ruby's private
# helpers call: Ruby's `__send__(attr)` is the generated `__send`.

require "send"

module ActiveModel
  module AttributeMethods
    include ActiveModel::Send
    # Required (generated): Ruby's class_attribute :attribute_aliases.
    def attribute_aliases = raise(NotImplementedError)
    # Required: the field @attributes (an AttributeSet, or nil without ActiveModel::Attributes) and the class name.
    def __attributes(r) = raise(NotImplementedError)
    def set___attributes(r, v) = raise(NotImplementedError)

    def attribute_alias?(new_name) = Hash.key?(attribute_aliases, Kernel.to_s(new_name))
    def attribute_alias(name) = attribute_aliases[Kernel.to_s(name)]

    # Ruby: respond_to_without_attributes?(:attributes) && attributes.include?(attr_name)
    def attribute_method?(r, attr_name)
      s = __attributes(r)
      s != nil && ActiveModel::AttributeSet.key?(s, Kernel.to_s(attr_name))
    end

    def missing_attribute(r, attr_name)
      raise ActiveModel::MissingAttributeError, "missing attribute '#{attr_name}' for #{__class_name}"
    end

    def _read_attribute(r, attr) = __send(r, Kernel.to_s(attr).String.to_sym)
  end
end
