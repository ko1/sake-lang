Ant = Struct.new(:x, :y, :heading)

def turn_right
  Hash[north: :east, east: :south, south: :west, west: :north]
end

def turn_left
  Hash[north: :west, west: :south, south: :east, east: :north]
end

def step_for(heading)
  case heading
  in :north then [0, -1]
  in :south then [0, 1]
  in :east then [1, 0]
  in :west then [-1, 0]
  end
end

World = Struct.new(:rule, :cells, :ant, :steps)

class World
  def create(rule) = World.new(String.chars(rule), Hash.new(0), Ant.new(0, 0, :north), 0)

  def tick(w)
    ant = @ant
    pos = [Ant.x(ant), Ant.y(ant)]
    colour = @cells[pos]
    table = @rule[colour] == "R" ? turn_right : turn_left
    Ant.set_heading(ant, table[Ant.heading(ant)])
    nxt = (colour + 1) % Array.size(@rule)
    if nxt == 0
      Hash.delete(@cells, pos)
    else
      @cells[pos] = nxt
    end
    dx, dy = step_for(Ant.heading(ant))
    Ant.set_x(ant, Ant.x(ant) + dx)
    Ant.set_y(ant, Ant.y(ant) + dy)
    @steps += 1
  end

  def run(w, n)
    Integer.times(n) { tick(w) }
    w
  end

  def bounds(w)
    xs = Array.map(Hash.keys(@cells)) { |x, y| x }
    ys = Array.map(Hash.keys(@cells)) { |x, y| y }
    xs_min = Array.min(xs)
    xs_max = Array.max(xs)
    ys_min = Array.min(ys)
    ys_max = Array.max(ys)
    return nil unless xs_min && xs_max && ys_min && ys_max
    [xs_min, ys_min, xs_max, ys_max]
  end

  def picture(w)
    b = bounds(w)
    return "(empty)" unless b
    x0, y0, x1, y1 = b
    glyphs = ".#o+*"
    lines = Range.map(y0..y1) do |y|
      Array.join(Range.map(x0..x1) do |x|
        if x == Ant.x(@ant) && y == Ant.y(@ant)
          "A"
        else
          glyphs[@cells[[x, y]]]
        end
      end, "")
    end
    Array.join(lines, "\n")
  end

  def summary(w)
    counts = Hash.new(0)
    Hash.each_value(@cells) { |c| counts[c] += 1 }
    parts = Array.map(Array.sort(Hash.keys(counts))) { |c| "#{c}:#{counts[c]}" }
    "step #{@steps}: #{Hash.size(@cells)} coloured cells (#{Array.join(parts, " ")}), ant at (#{Ant.x(@ant)},#{Ant.y(@ant)}) facing #{Ant.heading(@ant)}"
  end
end

Array.each(Array[["RL", Array[11, 100, 389]], ["LLRR", Array[50, 200]], ["RLR", Array[120]]]) do |rule, checkpoints|
  puts("rule #{rule}")
  w = World.create(rule)
  Array.each(checkpoints) do |target|
    World.run(w, target - World.steps(w))
    puts("  #{World.summary(w)}")
  end
  puts(World.picture(w))
end
