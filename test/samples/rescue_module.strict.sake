# A module groups exception types: `rescue M` catches the types that include it; built-ins keep Ruby's parents.
module WSError
  def describe(e) = "ws: " + Exception.message(e)
end
class ParseError < Exception
  include WSError
end
class FrameError < Exception
  include WSError
  attr_reader code
end
def run(k)
  raise ParseError, "bad" if k == 0
  raise FrameError.new("frame", 7) if k == 1
  k
end
Array.each(Any[0, 1, 2]) do |k|
  begin
    p run(k)
  rescue WSError => e
    puts WSError.describe(e)
    case e
    in FrameError then p FrameError.code(e)
    in ParseError then puts "parse"
    end
  end
end
begin
  h = Hash.of("a" => 1)
  Hash.fetch(h, "b")
rescue IndexError => e
  puts "index: " + Exception.message(e)
end
