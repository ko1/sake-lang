# Zlib's checksum combinations (crc32_combine, adler32_combine), written in Sake; Zlib.crc32 and Zlib.adler32
# themselves are built in.
# Compression (deflate/inflate, GzipReader/Writer) is not ported.

module Zlib
  module_function

  # The CRC of A + B from those of A and B and B's length (zlib's GF(2) matrix method).
  def crc32_combine(crc1, crc2, len2)
    raise ArgumentError, "negative length" if len2 < 0
    odd = Integer[0xedb88320]
    row = 1
    Integer.times(31) do
      Array.push(odd, row)
      row <<= 1
    end
    even = gf2_square(odd)
    odd = gf2_square(even)
    crc = crc1
    len = len2
    while len != 0
      even = gf2_square(odd)
      crc = gf2_times(even, crc) if len & 1 == 1
      len >>= 1
      break if len == 0
      odd = gf2_square(even)
      crc = gf2_times(odd, crc) if len & 1 == 1
      len >>= 1
    end
    crc ^ crc2
  end

  def adler32_combine(adler1, adler2, len2)
    base = 65521
    rem = len2 % base
    sum1 = adler1 & 0xffff
    sum2 = (rem * sum1) % base
    sum1 += (adler2 & 0xffff) + base - 1
    sum2 += ((adler1 >> 16) & 0xffff) + ((adler2 >> 16) & 0xffff) + base - rem
    sum1 -= base if sum1 >= base
    sum1 -= base if sum1 >= base
    sum2 -= 2 * base if sum2 >= 2 * base
    sum2 -= base if sum2 >= base
    sum1 | (sum2 << 16)
  end

  # Helpers of crc32_combine (zlib's gf2_matrix_times / gf2_matrix_square).
  def gf2_times(mat, vec)
    sum = 0
    i = 0
    v = vec
    while v != 0
      sum ^= mat[i] if v & 1 == 1
      v >>= 1
      i += 1
    end
    sum
  end

  def gf2_square(mat)
    Array.map(mat) { |m| gf2_times(mat, m) }
  end

  # The table for the reflected polynomial 0xedb88320, built once.
  def crc_table = once do
    Array.new(256) do |n|
      c = n
      Integer.times(8) { c = c & 1 == 1 ? 0xedb88320 ^ (c >> 1) : c >> 1 }
      c
    end
  end
end
