# The planned form of a SELECT: everything resolved, ready for Query to execute.

# A result column: its resolved expression, its alias (nil if none) and, when the expression
# contains an aggregate call, that call's name as written (else nil).
class ResultItem
  attr_reader expr, alias_name, aggregate_name
end

# Where the rows of one FROM source come from.
class TableSource
  attr_reader table
end

# A subquery in FROM: its Plan runs once (it is not correlated).
class DerivedSource
  attr_reader plan
end

# One source joined in. left: LEFT JOIN (unmatched rows so far are kept, NULL-extended by `width`
# columns). condition: resolved ON / USING condition, or nil (every pair). The first step has no condition.
class JoinStep
  attr_reader left, source, width, condition
end

# base:       length of the row prefix taken from the enclosing queries (0 for a statement).
# width:      number of columns of this query's sources; aggregate values follow them in a group row.
# joins:      the JoinSteps of FROM (empty without FROM: one row, the prefix alone).
# items:      the ResultItems.
# where:      resolved WHERE, or nil.
# group:      resolved GROUP BY terms (empty: none).
# aggregates: the Aggregates of the whole query, in the order of their slots.
# grouped:    is it an aggregate query (3.3)? Then rows become group rows.
# having:     resolved HAVING, or nil.
# distinct:   SELECT DISTINCT?
# order:      the SortKeys of ORDER BY.
# limit, offset: Integers, or nil when absent.
# refs:       not empty when the query reads columns of an enclosing query (it is correlated).
# cache:      holds the rows of an uncorrelated query once it has run (Query.rows).
class Plan
  attr_reader base, width, joins, items, where, group, aggregates, grouped, having, distinct, order, limit, offset, refs, cache
end
