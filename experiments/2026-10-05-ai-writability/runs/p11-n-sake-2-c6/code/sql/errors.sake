# Errors a SQL statement can end with. The message is printed as "Error: <message>".
SqlError = Exception.new

module Errors
  module_function

  def sql_error(message) = raise(SqlError, message)

  def syntax = raise(SqlError, "syntax error")

  # 1 -> "1st", 2 -> "2nd", 11 -> "11th", 21 -> "21st"
  def ordinal(n)
    last_two = n % 100
    last = n % 10
    suffix = "th"
    if last_two < 11 || last_two > 13
      suffix = "st" if last == 1
      suffix = "nd" if last == 2
      suffix = "rd" if last == 3
    end
    "#{n}#{suffix}"
  end
end
