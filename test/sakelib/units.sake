require "units"

speed = Unit.new(90, "km/h")
puts speed
p speed
p Unit.scalar(speed)
p Unit.units(speed)
p Unit.kind(speed)
puts Unit.convert_to(speed, "m/s")
puts Unit.convert_to(speed, "mi/h")
puts Unit.to_base(speed)

# length, mass, time
Array.each(Array[["1 mi", "km"], ["12 in", "ft"], ["5280 ft", "mi"], ["100 cm", "m"], ["2.5 kg", "lb"],
                 ["16 oz", "lb"], ["1 t", "g"], ["90 min", "h"], ["1 day", "s"], ["250 ms", "s"],
                 ["3 L", "cm^3"], ["1 m^2", "cm^2"]]) do |from, to|
  u = Unit.parse(from)
  puts "#{u} = #{Unit.convert_to(u, to)} (#{Unit.kind(u)})"
end

# compound units
g = Unit.parse("9.81 m/s^2")
p Unit.kind(g)
puts Unit.convert_to(g, "km/h^2")
mass = Unit.new(70, "kg")
force = mass * g
puts force
p Unit.kind(force)
puts Unit.convert_to(force, "N")
work = Unit.convert_to(force, "N") * Unit.new(2, "m")
puts work
p Unit.kind(work)
distance = Unit.new(42.195, "km")
time = Unit.new(2, "h") + Unit.new(35, "min")
puts time
pace = distance / time
puts pace
puts Unit.convert_to(pace, "m/s")
p Unit.kind(Unit.new(1, "km") / Unit.new(200, "m"))
puts Unit.new(1, "km") / Unit.new(200, "m")
puts Unit.new(3, "m") * Unit.new(4, "m")
puts Unit.new(10, "m^3") / Unit.new(2, "m")
puts Unit.new(120, "1/min")
puts Unit.convert_to(Unit.new(120, "1/min"), "1/s")
p Unit.kind(Unit.new(1, "kg*s"))

# arithmetic and comparison
a = Unit.new(1, "km")
b = Unit.new(300, "m")
puts a + b
puts b + a
puts a - b
puts a * 3
puts a / 4
p a > b
p Unit.new(1, "mi") > Unit.new(1600, "m")
p Unit.new(100, "cm") == Unit.new(1, "m")
p Array.sort(Array[Unit.new(1, "mi"), Unit.new(1, "km"), Unit.new(3000, "ft"), Unit.new(500, "yd")])
p Array.max(Array[Unit.new(1, "h"), Unit.new(3000, "s"), Unit.new(70, "min")])
p Unit.compatible?(a, Unit.new(1, "ft"))
p Unit.compatible?(a, Unit.new(1, "s"))
puts Unit.round(Unit.convert_to(Unit.new(1, "mi"), "km"), 2)

# errors
Array.each(Array["5 parsecs", "abc", "5 m/s/s", "5 m^x"]) do |s|
  begin
    Unit.parse(s)
  rescue ArgumentError => e
    puts Exception.message(e)
  end
end
begin
  Unit.convert_to(speed, "kg")
rescue ArgumentError => e
  puts Exception.message(e)
end
begin
  a + Unit.new(1, "s")
rescue ArgumentError => e
  puts Exception.message(e)
end
begin
  a < Unit.new(1, "kg")
rescue ArgumentError => e
  puts Exception.message(e)
end
begin
  Unit.new(Array.fetch(Array[1, "5"], 1), "m")
rescue NoMatchingPatternError
  puts "the scalar must be a number"
end
