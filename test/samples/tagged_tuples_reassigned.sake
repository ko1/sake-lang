# sake: -c --strict=2
# A variable assigned again no longer follows its Tuple: these are reported.
ops = Array[[:copy, 3], [:literal, Integer[1, 2]]]
Array.each(ops) do |kind, arg|
  arg = Integer[9] if kind == :literal
  case kind
  in :copy then p(arg + 1)
  in :literal then p(Array.size(arg))
  end
end
Array.each(ops) do |kind, arg|
  kind = :copy
  p(arg + 1) if kind == :copy
end
