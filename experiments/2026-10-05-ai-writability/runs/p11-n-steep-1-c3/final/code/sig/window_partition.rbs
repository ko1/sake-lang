module Sql
  class WindowPartition
    attr_reader size: Integer

    @call: Ast::WindowCall
    @rows: Array[Array[value]]
    @keys: Array[Array[value]]
    @peer_first: Array[Integer]
    @peer_last: Array[Integer]
    @peer_group: Array[Integer]

    def initialize: (Ast::WindowCall call, Array[Array[value]] members) -> void
    def row: (Integer pos) -> Array[value]
    def peer_first: (Integer pos) -> Integer
    def peer_last: (Integer pos) -> Integer
    def peer_group: (Integer pos) -> Integer
    def frame_rows: (Integer pos) -> Array[Array[value]]

    private

    def find_peers: (Array[Ast::OrderTerm] terms) -> void
    def frame_start: (Ast::Frame frame, Integer pos) -> Integer
    def frame_end: (Ast::Frame frame, Integer pos) -> Integer
    def rows_offset: (Ast::FrameBound bound) -> Integer
    def range_edge: (Integer pos, Ast::FrameBound bound, bool first) -> Integer
    def shifted: (Integer | Float | String current, Ast::FrameBound bound, Ast::OrderTerm term) -> number
  end
end
