module Sql
  module Collation
    def self.fetch: (String name) -> collation
    def self.fold: (String text, collation collation) -> String
    def self.choose: (collation? left, bool left_explicit, collation? right, bool right_explicit) -> collation
    def self.defaulted: (Array[collation?] list) -> Array[collation]
    def self.merge: (Array[Array[collation?]] lists, Integer count) -> Array[collation]
  end
end
