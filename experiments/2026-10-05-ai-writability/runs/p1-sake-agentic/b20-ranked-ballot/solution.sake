def pct(c, a)
  return "0.0%" if a == 0
  t = (2000 * c + a) / (2 * a)
  "#{t / 10}.#{t % 10}%"
end

def main
  lines = IO.readlines(IO.stdin)
  first = lines[0] == nil ? "" : String.strip(lines[0])
  if first == ""
    puts("no candidates")
    return
  end
  names = String[]
  cidx = Hash[]
  Array.each(String.split(first, /\s+/)) do |nm|
    if cidx[nm] == nil
      Array.push(names, nm)
      cidx[nm] = Array.size(names) - 1
    end
  end
  nc = Array.size(names)
  ballots = Array[]
  rejected = String[]
  n = 1
  Array.each(Array.drop(lines, 1)) do |raw|
    n += 1
    line = String.chomp(raw)
    next if String.strip(line) == ""
    ranks = Array.map(String.split(line, ">", -1)) { |r| String.strip(r) }
    seen = Hash[]
    order = Integer[]
    reason = nil
    Array.each(ranks) do |r|
      if reason == nil
        if r == ""
          reason = "empty rank"
        elsif cidx[r] == nil
          reason = "unknown candidate #{r}"
        elsif seen[r] != nil
          reason = "duplicate #{r}"
        else
          seen[r] = true
          Array.push(order, cidx[r])
        end
      end
    end
    if reason == nil
      Array.push(ballots, order)
    else
      Array.push(rejected, "rejected line #{n}: #{reason}")
    end
  end
  Array.each(rejected) { |s| puts(s) }
  nb = Array.size(ballots)
  puts("ballots: #{nb} valid, #{Array.size(rejected)} rejected")
  out = Array.new(nc, false)
  history = Array[]
  round = 0
  while true
    round += 1
    votes = Array.new(nc, 0)
    active = 0
    Array.each(ballots) do |b|
      pick = Array.find(b) { |c| !out[c] }
      if pick != nil
        votes[pick] += 1
        active += 1
      end
    end
    Array.push(history, votes)
    puts("round #{round}")
    cont = Array.select(Range.to_a(0...nc)) { |c| !out[c] }
    shown = Array.sort_by(cont) { |c| [-votes[c], names[c]] }
    Array.each(shown) { |c| puts("  #{names[c]} #{votes[c]} #{pct(votes[c], active)}") }
    puts("  exhausted #{nb - active}")
    if active == 0
      puts("no winner")
      break
    end
    win = Array.find(cont) { |c| votes[c] * 2 > active }
    if win != nil
      puts("winner #{names[win]}")
      break
    end
    tied = cont
    lo = Array.min(Array.map(tied) { |c| votes[c] })
    tied = Array.select(tied) { |c| votes[c] == lo }
    r = round - 2
    while Array.size(tied) > 1 && r >= 0
      hv = history[r]
      m = Array.min(Array.map(tied) { |c| hv[c] })
      tied = Array.select(tied) { |c| hv[c] == m }
      r -= 1
    end
    victim = tied[0]
    Array.each(tied) { |c| victim = c if names[c] > names[victim] }
    out[victim] = true
    puts("  eliminated #{names[victim]}")
  end
end

main
