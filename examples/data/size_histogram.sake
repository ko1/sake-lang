# Buckets file sizes into power-of-two ranges and prints a bar histogram with cumulative
# percentages, human-readable sizes, median and p90.
# Shows: the typed array Integer[], Tuples, format with widths, while.

def file_sizes
  Integer[
    512, 1800, 2400, 3100, 650, 72000, 15000, 15500, 4096, 8191, 8192, 120, 98000, 250000,
    1048576, 3000, 2900, 2048, 640, 33000, 47000, 5100, 5200, 6100, 130, 0, 9, 1_500_000, 16384, 70
  ]
end

def bucket_of(n)
  return 0 if n < 1
  Integer.bit_length(n)
end

def bucket_label(b)
  return "0" if b == 0
  lo = 2 ** (b - 1)
  hi = 2 ** b - 1
  "#{human(lo)}-#{human(hi)}"
end

def human(n)
  units = String.split("B K M G", " ")
  value = n
  idx = 0
  while value >= 1024 && idx < Array.size(units) - 1
    value /= 1024
    idx += 1
  end
  "#{value}#{units[idx]}"
end

sizes = file_sizes
counts = Hash.new(0)
Array.each(sizes) { |n| counts[bucket_of(n)] += 1 }
lo, hi = Array.minmax(Hash.keys(counts))
peak = Array.max(Hash.values(counts))
total = Array.size(sizes)

puts("#{total} files, #{human(Array.sum(sizes))} total")
running = 0
Integer.upto(lo, hi) do |b|
  c = counts[b]
  running += c
  bar = "*" * (c * 30 / peak)
  puts(format("%-11s %3d %-30s %5.1f%%", bucket_label(b), c, bar, running * 100.0 / total))
end
sorted = Array.sort(sizes)
median = Array.fetch(sorted, total / 2)
p90 = Array.fetch(sorted, total * 9 / 10)
puts("median #{human(median)}, p90 #{human(p90)}, largest #{human(Array.last(sorted) || 0)}")
small = Array.count(sizes) { it < 4096 }
puts(format("%d files (%.0f%%) fit in one 4K block", small, small * 100.0 / total))
