def training_text
  "the quick brown fox jumps over the lazy dog the dog barks at the fox " +
  "a quick reply is better than a late reply the fox is quick and the dog is lazy " +
  "spelling errors are common when people type quickly and the correct word is often " +
  "one edit away from the typed word people often type the wrong letter or swap two letters " +
  "the dictionary counts how often each word appears so common words win ties"
end

def letters = "abcdefghijklmnopqrstuvwxyz"

def word_counts(text)
  counts = Hash.new(0)
  Array.each(String.split(text, " ")) { |w| counts[w] += 1 }
  counts
end

def edits1(word)
  results = Set[]
  n = String.size(word)
  Integer.upto(0, n) do |i|
    left = word[0...i]
    right = word[i..]
    Set.add(results, left + right[1..]) if String.size(right) > 0
    if String.size(right) > 1
      Set.add(results, left + right[1] + right[0] + right[2..])
    end
    String.each_char(letters) do |c|
      Set.add(results, left + c + right[1..]) if String.size(right) > 0
      Set.add(results, left + c + right)
    end
  end
  results
end

def known(words, dict) = Set.select(words) { |w| Hash.key?(dict, w) }

def edits2_known(word, dict)
  found = Set[]
  Set.each(edits1(word)) { |e1| Set.each(edits1(e1)) { |e2| Set.add(found, e2) if Hash.key?(dict, e2) } }
  found
end

def best(cands, dict)
  sorted = (Set|Array).sort(cands)
  Array.max_by(sorted) { |w| dict[w] }
end

def correct(word, dict)
  return [word, 0] if Hash.key?(dict, word)
  one = known(edits1(word), dict)
  return [best(one, dict), 1] unless Array.empty?(one)
  two = edits2_known(word, dict)
  return [best(two, dict), 2] unless Set.empty?(two)
  [word, -1]
end

dict = word_counts(training_text)
puts("dictionary: #{Hash.size(dict)} words, #{Array.sum(Hash.values(dict))} tokens")
puts("edits1('fox') has #{Set.size(edits1("fox"))} candidates")

tests = Array["teh", "quik", "dgo", "lazzy", "fxo", "speling", "dictonary", "the", "xyzzy", "brwn", "comon", "ofen"]
fixed = 0
cache = Hash[]
Array.each(tests) do |t|
  cache[t] ||= correct(t, dict)
  w, dist = cache[t]
  label = case dist
          in 0 then "known"
          in 1 then "1 edit"
          in 2 then "2 edits"
          else "no suggestion"
          end
  fixed += 1 if dist > 0
  puts(format("%-10s -> %-10s (%s)", t, w, label))
end
puts("corrected #{fixed} of #{Array.size(tests)}")

sentence = "teh quik brwn fxo jumsp ovr teh lazzy dgo"
out = Array.map(String.split(sentence, " ")) do |t|
  cache[t] ||= correct(t, dict)
  w, _ = cache[t]
  w
end
puts("sentence: #{Array.join(out, " ")}")
puts("cache size: #{Hash.size(cache)}")
