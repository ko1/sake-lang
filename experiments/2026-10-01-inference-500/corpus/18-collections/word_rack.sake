# Word games over a small dictionary: anagram classes, letter racks (multisets via tally), scoring.

def dictionary
  String.split("stone notes onset tones steno alert alter later ratel least slate stale steal tales teals " +
               "rat tar art star rats arts tsar lose sole oles reals earls rales lares seal sale ales " +
               "quiz jazz zest", " ")
end

def letter_scores
  scores = Hash.new(1)
  Array.each(Array[["dg", 2], ["bcmp", 3], ["fhvwy", 4], ["k", 5], ["jx", 8], ["qz", 10]]) do |letters, pts|
    Array.each(String.chars(letters)) { |c| scores[c] = pts }
  end
  scores
end

def signature(w) = Array.join(Array.sort(String.chars(w)), "")

def score(w, table) = Array.sum(Array.map(String.chars(w)) { |c| table[c] })

def can_make?(word, rack_counts)
  need = Array.tally(String.chars(word))
  Hash.all?(need) { |c, n| Hash.fetch(rack_counts, c, 0) >= n }
end

def leftover(rack, word)
  counts = Array.tally(String.chars(rack))
  Array.each(String.chars(word)) { |c| counts[c] -= 1 }
  Array.join(Array.sort(Array.flat_map(Hash.to_a(counts)) { |c, n| Array.map(Range.to_a(0...n)) { |_i| c } }), "")
end

words = dictionary
table = letter_scores
puts("dictionary: #{Array.size(words)} words, #{Array.size(Array.uniq(words))} distinct")

classes = Array.group_by(words) { |w| signature(w) }
big = Array.select(Hash.to_a(classes)) { |sig, ws| Array.size(ws) > 1 }
puts("== Anagram classes ==")
Array.each(Array.sort_by(big) { |sig, ws| format("%02d%s", 99 - Array.size(ws), sig) }) do |sig, ws|
  puts(format("%-6s %d: %s", sig, Array.size(ws), Array.join(Array.sort(ws), " ")))
end
singles = Array.map(Array.select(Hash.to_a(classes)) { |sig, ws| Array.size(ws) == 1 }) { |sig, ws| ws[0] }
puts("no anagram: #{Array.join(Array.sort(singles), " ")}")

puts("== Racks ==")
Array.each(Array["aelrst", "otsen", "zzaj", "qixx"]) do |rack|
  counts = Array.tally(String.chars(rack))
  playable = Array.uniq(Array.select(words) { |w| can_make?(w, counts) })
  if Array.empty?(playable)
    puts("#{rack}: nothing playable")
    next
  end
  best = Array.max_by(playable) { |w| score(w, table) * 100 + String.size(w) }
  full = Array.select(playable) { |w| String.size(w) == String.size(rack) }
  puts("#{rack}: #{Array.size(playable)} words, best #{best} (#{score(best, table)}), leaves '#{leftover(rack, best)}'")
  puts("  uses every tile: #{Array.join(Array.sort(full), " ")}") unless Array.empty?(full)
end

puts("== Letters ==")
used = Array.reduce(words, Set[]) { |acc, w| Set.merge(acc, Array.to_set(String.chars(w))) }
alphabet = Array.to_set(String.chars("abcdefghijklmnopqrstuvwxyz"))
puts("unused letters: #{Array.join(Set.sort(alphabet - used), "")}")
common = Array.reduce(Array.map(Array.select(words) { |w| String.size(w) == 5 }) { |w| Array.to_set(String.chars(w)) }, alphabet) { |acc, s| acc & s }
puts("in every 5-letter word: #{Array.join(Set.sort(common), "")}")
by_len = Array.tally(Array.map(words) { |w| String.size(w) })
puts("lengths: #{Array.join(Array.map(Array.sort(Hash.keys(by_len))) { |l| "#{l}x#{by_len[l]}" }, " ")}")
top = Array.take(Array.sort_by(Array.uniq(words)) { |w| format("%03d%s", 999 - score(w, table), w) }, 3)
puts("highest scoring: #{Array.join(Array.map(top) { |w| "#{w}=#{score(w, table)}" }, " ")}")
doubles = Array.select(words) { |w| Array.size(Array.uniq(String.chars(w))) < String.size(w) }
puts("repeated letters: #{Array.join(doubles, " ")}")
