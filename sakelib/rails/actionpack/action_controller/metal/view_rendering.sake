# Port of nothing (Sake only): what ActionController::Base asks of ActionView::ViewPaths, ActionView::Rendering
# and ActionView::Layouts (actionview-8.1.3, ported separately under sakelib/rails/actionview/).
#
# Without templates, template_exists? is false and the render options that need a template are an error.

module ActionController
  module ViewRendering
    def template_exists?(c, name, prefixes) = false
    def any_templates?(c, name, prefixes) = false

    # ActionView::Rendering#render_to_body: _process_options, then the template (nil: the :plain/:html/:body option).
    def view_render_to_body(c, options)
      _process_options(c, options)
      nil
    end
  end
end
