def break_word(word, w)
  out = Array[]
  rest = word
  while String.size(rest) > w
    Array.push(out, String.slice(rest, 0, w - 1) + "-")
    rest = String.slice(rest, w - 1, String.size(rest))
  end
  Array.push(out, rest)
  out
end

def justify(ws, w)
  gaps = Array.size(ws) - 1
  return Array.join(ws, " ") if gaps == 0
  letters = Array.sum(Array.map(ws) { |x| String.size(x) })
  spaces = w - letters
  base = spaces / gaps
  rem = spaces % gaps
  out = ""
  i = 0
  Array.each(ws) do |x|
    out = out + x
    if i < gaps
      out = out + " " * (base + (i < rem ? 1 : 0))
    end
    i += 1
  end
  out
end

def layout(words, w)
  lines = Array[]
  cur = Array[]
  curlen = 0
  Array.each(words) do |x|
    if Array.empty?(cur)
      cur = Array[x]
      curlen = String.size(x)
    elsif curlen + 1 + String.size(x) <= w
      Array.push(cur, x)
      curlen += 1 + String.size(x)
    else
      Array.push(lines, cur)
      cur = Array[x]
      curlen = String.size(x)
    end
  end
  Array.push(lines, cur) if !Array.empty?(cur)
  lines
end

first = gets
m = first ? String.match(String.chomp(first), /\A *(\d+) *\z/) : nil
w = m ? String.to_i(MatchData.captures(m)[0]) : 0
if w < 2 || w > 80
  puts("invalid width")
  exit
end

paras = Array[]
cur = Array[]
nwords = 0
while (raw = gets)
  ws = Array.reject(String.split(String.chomp(raw), /[ \t]+/)) { |x| String.empty?(x) }
  if Array.empty?(ws)
    if !Array.empty?(cur)
      Array.push(paras, cur)
      cur = Array[]
    end
  else
    nwords += Array.size(ws)
    cur = cur + ws
  end
end
Array.push(paras, cur) if !Array.empty?(cur)

border = "+" + "-" * w + "+"
puts(border)
nlines = 0
pi = 0
Array.each(paras) do |para|
  puts("|" + " " * w + "|") if pi > 0
  pi += 1
  pieces = Array.flat_map(para) { |x| break_word(x, w) }
  ls = layout(pieces, w)
  li = 0
  Array.each(ls) do |l|
    text = li < Array.size(ls) - 1 ? justify(l, w) : Array.join(l, " ")
    puts("|" + String.ljust(text, w) + "|")
    nlines += 1
    li += 1
  end
end
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{nwords}")
