# Check password changes against a policy: composition, dictionary words (with leetspeak), history, and user data.
class PolicyViolation < StandardError
  attr_reader violations
end

class User
  attr_reader login, full_name, history
end

def dictionary = once { Set["password", "dragon", "monkey", "sunshine", "letmein", "football", "welcome"] }

def unleet(s) = String.tr(String.downcase(s), "4@310$5", "aaeioss")

def strength(pw)
  classes = Array.count(Array[/[a-z]/, /[A-Z]/, /\d/, /[^A-Za-z0-9]/]) { |re| String.match?(pw, re) }
  unique = Array.size(Array.uniq(String.chars(pw)))
  score = String.length(pw) * 4 + classes * 10 + unique * 2
  score -= 20 if String.match?(pw, /(.)\1\1/)
  score -= 15 if String.match?(String.downcase(pw), /abc|bcd|123|234|345|qwe|wer/)
  score
end

def violations_for(user, pw)
  v = Array[]
  Array.push(v, "shorter than 10 characters") if String.length(pw) < 10
  Array.push(v, "longer than 64 characters") if String.length(pw) > 64
  missing = Array[]
  Array.push(missing, "lowercase") unless String.match?(pw, /[a-z]/)
  Array.push(missing, "uppercase") unless String.match?(pw, /[A-Z]/)
  Array.push(missing, "digit") unless String.match?(pw, /\d/)
  Array.push(v, "missing #{Array.join(missing, ", ")}") unless Array.empty?(missing)
  plain = unleet(pw)
  word = Set.find(dictionary) { |w| String.include?(plain, w) }
  Array.push(v, "contains dictionary word '#{word}'") if word
  login = String.downcase(User.get_login(user))
  Array.push(v, "contains the login name") if String.include?(plain, login)
  parts = Array.select(String.split(String.downcase(User.get_full_name(user)), " ")) { String.length(it) >= 3 }
  hit = Array.find(parts) { |n| String.include?(plain, n) }
  Array.push(v, "contains part of the full name (#{hit})") if hit
  Array.push(v, "reuses one of the last 3 passwords") if Array.include?(Array.take(Array.reverse(User.get_history(user)), 3), pw)
  v
end

def change_password(user, pw)
  v = violations_for(user, pw)
  raise PolicyViolation.new("#{Array.size(v)} policy violation(s)", v) unless Array.empty?(v)
  s = strength(pw)
  raise PolicyViolation.new("too weak", Array["strength #{s} is below 70"]) if s < 70
  Array.push(User.get_history(user), pw)
  s
end

user = User.new("kenji", "Kenji Tanaka", Array["Spring2024!x", "Summer2024!x", "Autumn2024!x", "Winter2024!x"])
attempts = Array[
  "short1A",
  "alllowercaseletters",
  "P@ssw0rd2026!",
  "MyKenjiPass99",
  "tanakaRules2026",
  "Summer2024!x",
  "Spring2024!x",
  "aaaBBB111ccc",
  "Abcdefgh1234",
  "Blue-Kettle-Rain-77",
  "Blue-Kettle-Rain-77"
]

accepted = 0
reasons = Hash.new(0)
Array.each(attempts) do |pw|
  s = change_password(user, pw)
  accepted += 1
  puts("#{String.ljust(pw, 20)} accepted (strength #{s})")
rescue PolicyViolation => e
  puts("#{String.ljust(pw, 20)} rejected: #{Exception.message(e)}")
  Array.each(PolicyViolation.get_violations(e)) do |msg|
    puts("    - #{msg}")
    reasons[String.split(msg, " ")[0]] += 1
  end
end
puts("accepted #{accepted} of #{Array.size(attempts)}; history size #{Array.size(User.get_history(user))}")
puts(Array.join(Array.map(Hash.sort_by(reasons) { |k, _| k }) { |k, n| "#{k}:#{n}" }, " "))
