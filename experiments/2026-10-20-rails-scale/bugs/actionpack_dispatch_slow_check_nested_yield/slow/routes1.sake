# one `resources` (7 routes)
require "actionpack/action_dispatch/routing"
rs = ActionDispatch::Routing::RouteSet.make
ActionDispatch::Routing::RouteSet.draw(rs) { |map| ActionDispatch::Routing::Mapper.resources(map, :posts) }
p(ActionDispatch::Journey::Routes.size(ActionDispatch::Routing::RouteSet.routes(rs)))
