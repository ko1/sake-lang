def extract_words(text)
  # Split on spaces and tabs, filtering empty
  parts = String.split(text, /[ \t]+/)
  Array.filter(parts) { |p| !String.empty?(p) }
end

def break_long_word(word, width)
  if String.length(word) <= width
    Array[word]
  else
    pieces = Array[]
    remaining = word
    while String.length(remaining) > width
      piece = String.slice(remaining, 0, width - 1)
      Array.push(pieces, piece + "-")
      remaining = String.slice(remaining, width - 1, String.length(remaining) - (width - 1))
    end
    Array.push(pieces, remaining)
    pieces
  end
end

def justify_line(words, width)
  if Integer.length(words) == 1
    String.ljust(String.at(words, 0), width)
  else
    # Calculate spaces needed
    text_len = Array.sum(Array.map(words) { String.length(it) }, 0)
    total_spaces = width - text_len
    gaps = Integer.length(words) - 1
    spaces_per_gap = total_spaces / gaps
    extra_spaces = total_spaces % gaps

    result = ""
    Integer.times(Integer.length(words)) do |i|
      result += String.at(words, i)
      if i < Integer.length(words) - 1
        gap_spaces = spaces_per_gap
        if i < extra_spaces
          gap_spaces += 1
        end
        Integer.times(gap_spaces) { result += " " }
      end
    end
    result
  end
end

# Read all input
all_lines = IO.readlines(IO.stdin)

if Integer.length(all_lines) == 0
  puts("invalid width")
  exit(0)
end

first_line = String.chomp(String.at(all_lines, 0))
first_line = String.strip(first_line)

if String.empty?(first_line) || !String.match?(first_line, /^\d+$/)
  puts("invalid width")
  exit(0)
end

width = String.to_i(first_line)
if width < 2 || width > 80
  puts("invalid width")
  exit(0)
end

# Extract remaining lines as text
text_lines = Array[]
Integer.times(Integer.length(all_lines) - 1) do |i|
  Array.push(text_lines, String.chomp(String.at(all_lines, i + 1)))
end

# Extract paragraphs
paragraphs = Array[]
current_paragraph = Array[]

Array.each(text_lines) do |line|
  stripped = String.strip(line)
  if String.empty?(stripped)
    if !Array.empty?(current_paragraph)
      Array.push(paragraphs, current_paragraph)
      current_paragraph = Array[]
    end
  else
    Array.push(current_paragraph, line)
  end
end

if !Array.empty?(current_paragraph)
  Array.push(paragraphs, current_paragraph)
end

# Layout paragraphs
output_lines = Array[]
total_words = 0
total_text_lines = 0

Array.each(paragraphs) do |para|
  # Extract all words from this paragraph
  para_words = Array[]
  Array.each(para) do |line|
    words = extract_words(line)
    Array.each(words) do |w|
      Array.push(para_words, w)
    end
  end

  total_words += Integer.length(para_words)

  # Break long words
  broken_words = Array[]
  Array.each(para_words) do |w|
    pieces = break_long_word(w, width)
    Array.each(pieces) do |piece|
      Array.push(broken_words, piece)
    end
  end

  # Fill lines greedily
  para_lines = Array[]
  current_line = Array[]

  Array.each(broken_words) do |word|
    # Check if word fits on current line
    if Array.empty?(current_line)
      Array.push(current_line, word)
    else
      # Calculate length with this word
      text_len = Array.sum(Array.map(current_line) { String.length(it) }, 0)
      text_len += Integer.length(current_line) - 1  # spaces between words
      text_len += 1  # space before new word
      text_len += String.length(word)

      if text_len <= width
        Array.push(current_line, word)
      else
        Array.push(para_lines, current_line)
        current_line = Array[word]
      end
    end
  end

  if !Array.empty?(current_line)
    Array.push(para_lines, current_line)
  end

  # Justify lines
  para_output = Array[]
  Array.each_with_index(para_lines) do |line_words, idx|
    is_last = idx == Integer.length(para_lines) - 1

    if is_last || Integer.length(line_words) == 1
      # Left align
      joined = Array.join(line_words, " ")
      justified = String.ljust(joined, width)
    else
      # Full justify
      justified = justify_line(line_words, width)
    end

    Array.push(para_output, justified)
  end

  # Add lines to output
  if !Array.empty?(para_output)
    Array.each(para_output) do |line|
      Array.push(output_lines, line)
    end
  end

  total_text_lines += Integer.length(para_output)

  # Add separator if not last paragraph
  if para != Array.last(paragraphs)
    Array.push(output_lines, String.center("", width))
    total_text_lines += 1
  end
end

# Print output
border = "+" + String.*(String["-"], width) + "+"
puts(border)

Array.each(output_lines) do |line|
  puts("|" + line + "|")
end

puts(border)
puts("paragraphs: #{Integer.length(paragraphs)}, lines: #{total_text_lines}, words: #{total_words}")
