class Account
  attr_reader owner
  attr_accessor balance = 0
  def deposit(a, n) = @balance += n
  def rename(a, s) = @owner = s          # a reader field is writable inside the class
end

a = Account.new("ann")                   # balance takes its default
Account.deposit(a, 50)
Account.rename(a, "bob")
p(a)
p(Account.owner(a))
