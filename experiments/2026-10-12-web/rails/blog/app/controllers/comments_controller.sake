# The Rails guide's CommentsController (app/controllers/comments_controller.rb).
class CommentsController < ApplicationController
  attr_reader post, comment

  # POST /posts/1/comments
  def create(c)
    post = Post.find(@params[:post_id])
    @post = post
    comment = Comment.build(comment_params(c))      # Ruby: @post.comments.create(comment_params)
    comment.Comment.post_id = Post.id(post)
    @comment = comment
    if Comment.save(comment)
      redirect_to c, post_path(post)
    else
      redirect_to c, post_path(post), {alert: "Comment could not be saved: #{Array.join(ActiveModel::Errors.full_messages(Comment.errors(comment)), ", ")}."}
    end
  end

  # DELETE /posts/1/comments/2
  def destroy(c)
    post = Post.find(@params[:post_id])
    @post = post
    comment = Post.comments(post).ActiveRecord::Relation.find(@params[:id])   # Ruby: @post.comments.find(params[:id])
    @comment = comment
    Comment.destroy(comment)
    redirect_to c, post_path(post), {status: :see_other}
  end

  # private
  def comment_params(c)
    ActionController::Parameters.expect(@params, {comment: Any[:commenter, :body]})
  end
end
