module Sql
  module Value
    INT_MIN: Integer
    INT_MAX: Integer
    NUMBER: String
    NUMERIC_LITERAL: Regexp
    NUMERIC_PREFIX: Regexp
    BLANKS: Regexp

    def self.parse_number: (String text) -> number
    def self.parse_numeric_text: (String text) -> number?
    def self.numeric_prefix: (String text) -> number
    def self.to_number: (Integer | Float | String value) -> number
    def self.format_real: (Float x) -> String
    def self.text_form: (Integer | Float | String value) -> String
    def self.type_name: (value value) -> String
    def self.truth: (value value) -> bool?
    def self.from_truth: (bool? truth) -> Integer?
    def self.rank: (value value) -> Integer
    def self.compare: (value left, value right) -> Integer
    def self.numeric_affinity?: (column_type? affinity) -> bool
    def self.coerce_for_comparison: (value left, column_type? left_aff, value right, column_type? right_aff) -> [value, value]
    def self.number_if_text: (value value) -> value
    def self.text_if_number: (value value) -> value
  end

  module Operators
    def self.arithmetic: (String op, value left, value right) -> value
    def self.integer_arithmetic: (String op, Integer x, Integer y) -> Integer?
    def self.real_arithmetic: (String op, Float x, Float y) -> Float?
    def self.negate: (value value) -> number?
    def self.concat: (value left, value right) -> String?
    def self.comparison: (String op, value left, column_type? left_aff, value right, column_type? right_aff) -> Integer?
    def self.same?: (value left, column_type? left_aff, value right, column_type? right_aff) -> bool
  end

  module Functions
    class Spec
      attr_reader min: Integer
      attr_reader max: Integer?

      def initialize: (Integer min, Integer? max) -> void
      def accepts?: (Integer count) -> bool
    end

    SPECS: Hash[String, Spec]

    def self.lookup: (String name) -> Spec?
    def self.call: (String name, Array[value] args) -> value
    def self.unary: (String name, Integer | Float | String arg) -> value
    def self.absolute: (Integer | Float | String arg) -> number
  end
end
