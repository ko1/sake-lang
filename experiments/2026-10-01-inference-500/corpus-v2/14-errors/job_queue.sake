# A background job runner: failed jobs are requeued with a delay until max attempts, then dead-lettered.
TemporaryFailure = Exception.new(:retry_after)
PermanentFailure = Exception.new(:reason)

class Job
  attr_reader id, kind, payload
  attr_accessor attempts, run_at, errors
  def describe(j) = "#{@id}(#{@kind})"
end

class JobQueue
  attr_reader pending, dead, done
  attr_accessor clock
  def enqueue(q, job) = Array.push(@pending, job)

  def next_due(q)
    due = Array.select(@pending) { Job.run_at(it) <= @clock }
    return nil if Array.empty?(due)
    job = Array.min_by(due) { |j| [Job.run_at(j), Job.id(j)] }
    Array.delete(@pending, job)
    job
  end
end

# Handlers succeed or fail depending on the payload and the attempt number.
def perform(job)
  payload = Job.payload(job)
  attempt = Job.attempts(job)
  case Job.kind(job)
  in :email
    raise PermanentFailure.new("bad address", "invalid") unless String.include?(payload, "@")
    raise TemporaryFailure.new("smtp busy", 3) if attempt < 2
    "sent to #{payload}"
  in :resize
    size = Integer(payload) rescue raise(PermanentFailure.new("not a size: #{payload}", "parse"))
    raise TemporaryFailure.new("no worker free", 1) if size > 1000 && attempt < 3
    "resized to #{size / 2}"
  in :report
    raise TemporaryFailure.new("db unavailable", 5)
  end
end

def max_attempts = 4

def run(q)
  ticks = 0
  while !Array.empty?(JobQueue.pending(q)) && ticks < 50
    job = JobQueue.next_due(q)
    if job == nil
      JobQueue.set_clock(q, JobQueue.clock(q) + 1)
      ticks += 1
      next
    end
    Job.set_attempts(job, Job.attempts(job) + 1)
    now = JobQueue.clock(q)
    begin
      result = perform(job)
      Array.push(JobQueue.done(q), job)
      puts("t=#{now} #{Job.describe(job)} ok: #{result}")
    rescue TemporaryFailure => e
      Array.push(Job.errors(job), Exception.message(e))
      if Job.attempts(job) >= max_attempts
        Array.push(JobQueue.dead(q), job)
        puts("t=#{now} #{Job.describe(job)} dead after #{Job.attempts(job)} attempts")
      else
        Job.set_run_at(job, now + TemporaryFailure.retry_after(e))
        JobQueue.enqueue(q, job)
        puts("t=#{now} #{Job.describe(job)} retry at t=#{Job.run_at(job)}: #{Exception.message(e)}")
      end
    rescue PermanentFailure => e
      Array.push(Job.errors(job), "#{PermanentFailure.reason(e)}: #{Exception.message(e)}")
      Array.push(JobQueue.dead(q), job)
      puts("t=#{now} #{Job.describe(job)} failed permanently: #{Exception.message(e)}")
    end
  end
end

q = JobQueue.new(Job[], Job[], Job[], 0)
specs = Array[[:email, "ann@example.com"], [:resize, "640"], [:resize, "4096"], [:email, "nobody"],
              [:report, "weekly"], [:resize, "huge"], [:email, "bob@example.com"]]
Array.each_with_index(specs) do |spec, i|
  kind, payload = spec
  JobQueue.enqueue(q, Job.new("j#{i + 1}", kind, payload, 0, i / 3, Array[]))
end
run(q)

puts("done: #{Array.join(Array.map(JobQueue.done(q)) { Job.id(it) }, " ")}")
puts("dead letters:")
Array.each(JobQueue.dead(q)) do |j|
  puts("  #{Job.describe(j)} attempts=#{Job.attempts(j)} last=#{Array.last(Job.errors(j))}")
end
attempts = Array.sum(Array.map(Array.concat(Array.dup(JobQueue.done(q)), JobQueue.dead(q))) { Job.attempts(it) })
puts("total attempts #{attempts}, finished at t=#{JobQueue.clock(q)}")
