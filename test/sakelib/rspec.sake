require "rspec"

# A spec with passing, failing and pending examples, nested contexts, and every matcher; the output is
# RSpec's documentation format (without the timing line and the "Failed examples" list), compared with
# the plain-Ruby reference test/sakelib/ref/rspec.rb. RSpec.report (not run) so that the exit status
# stays 0 for the test harness.

def square(x) = x * x

RSpec.describe("Array") do |g|
  RSpec.it(g, "pushes at the end") do |ex|
    a = Array[1]
    Array.push(a, 2)
    RSpec.expect(ex, a).To.eq(Array[1, 2])
    RSpec.expect(ex, a).NotTo.eq(Array[2, 1])
    RSpec.expect(ex, a).To.include(2)
    RSpec.expect(ex, a).To.include(1, 2)
    RSpec.expect(ex, a).NotTo.include(3)
    RSpec.expect(ex, a).To.have_size(2)
    RSpec.expect(ex, a).NotTo.be_empty
    RSpec.expect(ex, a).To.contain_exactly(2, 1)
    RSpec.expect(ex, a).To.match_array(Array[2, 1])
    RSpec.expect(ex, a).To.all { |x| x > 0 }
  end
  RSpec.it(g, "fails on eq") do |ex|
    RSpec.expect(ex, Array.sum(Array[1, 2])).To.eq(4)
  end
  RSpec.context(g, "when empty") do |g2|
    RSpec.it(g2, "has no first element") do |ex|
      RSpec.expect(ex, Array.first(Array[])).To.be_nil
      RSpec.expect(ex, Array[]).To.be_empty
      RSpec.expect(ex, Array.first(Array[])).To.be_falsey
    end
    RSpec.it(g2, "fails on include") do |ex|
      RSpec.expect(ex, Array[]).To.include(1)
    end
    RSpec.context(g2, "and nested deeper") do |g3|
      RSpec.it(g3, "still reports") { |ex| RSpec.expect(ex, Array.size(Array[])).To.eq(0) }
    end
  end
  RSpec.it(g, "is not yet written")
  RSpec.xit(g, "is skipped for now") { |ex| RSpec.expect(ex, 1).To.eq(2) }
end

RSpec.describe("String") do |g|
  RSpec.it(g, "matches and starts") do |ex|
    s = "hello world"
    RSpec.expect(ex, s).To.match(/wor/)
    RSpec.expect(ex, s).NotTo.match(/xyz/)
    RSpec.expect(ex, s).To.start_with("hello")
    RSpec.expect(ex, s).To.end_with("world")
    RSpec.expect(ex, s).To.include("lo w")
    RSpec.expect(ex, s).To.have_size(11)
    RSpec.expect(ex, String.upcase(s)).To.eq("HELLO WORLD")
    RSpec.expect(ex, "").To.be_empty
  end
  RSpec.it(g, "fails on match") do |ex|
    RSpec.expect(ex, "abc").To.match(/\d/)
  end
  RSpec.it(g, "fails on start_with") do |ex|
    RSpec.expect(ex, "abc").To.start_with("b")
  end
  # RSpec.expect(ex, 42).To.match(/4/) is a type error before running: String.match? needs a String.
end

RSpec.describe("numbers") do |g|
  RSpec.it(g, "compares") do |ex|
    RSpec.expect(ex, square(3)).To.eq(9)
    RSpec.expect(ex, 3.14159).To.be_within(0.01, 3.14)
    RSpec.expect(ex, 10).To.be_gt(9)
    RSpec.expect(ex, 10).To.be_ge(10)
    RSpec.expect(ex, 10).To.be_lt(11)
    RSpec.expect(ex, 10).To.be_le(10)
    RSpec.expect(ex, 5).To.be_between(1, 10)
    RSpec.expect(ex, 7).To.satisfy("be odd") { |x| Integer.odd?(x) }
    RSpec.expect(ex, 0).To.be_truthy
    RSpec.expect(ex, nil).To.be_falsey
    RSpec.expect(ex, nil).To.be_nil
    RSpec.expect(ex, 1).NotTo.be_nil
    RSpec.expect(ex, :a).To.be(:a)
  end
  RSpec.it(g, "fails on be_within") do |ex|
    RSpec.expect(ex, 3.0).To.be_within(0.1, 3.5)
  end
  RSpec.it(g, "fails on be_truthy") do |ex|
    RSpec.expect(ex, nil).To.be_truthy
  end
  RSpec.it(g, "fails on be >") do |ex|
    RSpec.expect(ex, 1).To.be_gt(2)
  end
  RSpec.it(g, "fails on satisfy") do |ex|
    RSpec.expect(ex, 8).To.satisfy("be odd") { |x| Integer.odd?(x) }
  end
end

RSpec.describe("errors") do |g|
  RSpec.it(g, "raises") do |ex|
    RSpec.expect(ex).To.raise_error { raise "boom" }
    RSpec.expect(ex).To.raise_error("boom") { raise "boom" }
    RSpec.expect(ex).To.raise_error(/bo+m/) { raise "boom" }
    RSpec.expect(ex).To.raise_error(/divided/) { 1 / 0 }
    msg = RSpec.expect(ex).To.raise_error { Integer("x") }
    RSpec.expect(ex, msg).To.include("invalid value")
    RSpec.expect(ex).NotTo.raise_error { 1 + 1 }
  end
  RSpec.it(g, "fails when nothing is raised") do |ex|
    RSpec.expect(ex).To.raise_error { 1 + 1 }
  end
  RSpec.it(g, "fails on the message") do |ex|
    RSpec.expect(ex).To.raise_error("bang") { raise "boom" }
  end
  RSpec.it(g, "fails on an unexpected error") do |ex|
    RSpec.expect(ex).NotTo.raise_error { raise "oops" }
  end
  RSpec.it(g, "fails by raising") do |ex|
    raise "the example itself raised"
  end
  RSpec.it(g, "is pending from inside") do |ex|
    RSpec.pending(ex, "waiting for a fix")
  end
end

RSpec.describe("Hash") do |g|
  RSpec.it(g, "has keys") do |ex|
    h = Hash["a" => 1, "b" => 2]
    RSpec.expect(ex, h).To.have_key("a")
    RSpec.expect(ex, h).To.include("b")
    RSpec.expect(ex, h).NotTo.include("c")
    RSpec.expect(ex, h).To.eq(Hash["a" => 1, "b" => 2])
    RSpec.expect(ex, Hash.keys(h)).To.contain_exactly("b", "a")
  end
  RSpec.it(g, "fails on have_key") do |ex|
    RSpec.expect(ex, Hash["a" => 1]).To.have_key("z")
  end
end

# the long-hand form works too: Expectation.to_eq(RSpec.expect(ex, x), y)
RSpec.describe("long-hand") do |g|
  RSpec.it(g, "uses the operations directly") do |ex|
    Expectation.to_eq(RSpec.expect(ex, 1 + 1), 2)
    Expectation.to_be_within(RSpec.expect(ex, 1.0), 0.5, 1.2)
    Expectation.to_raise_error(RSpec.expect(ex), "x") { raise "x" }
  end
end

ok = RSpec.report
puts
p ok
