# The checks on one row before it is stored (2.1), in the order the specification gives them.
module Constraints
  module_function

  # The row as it will be stored, or the first error. `raw` has one value per column, then the rowid
  # (defaults already applied); `rows` is the table as it stands, whose row number `skip` (-1 for
  # none) is the row being replaced. A NULL rowid is filled in only when `auto_key` (INSERT).
  def check_row(table, raw, rows, skip, auto_key)
    columns = Table.columns(table)
    n = Array.size(columns)
    key_col = Table.rowid(table)
    row = Array.dup(raw)
    settle_rowid(row, Catalog.rowid_slot(table), rows, n, auto_key)
    row[n] = row[key_col] if key_col >= 0
    check_not_null(table, row)
    keys = Table.keys(table)
    if key_col >= 0
      Array.each(keys) { |k| check_unique(table, k, row, rows, skip) if Key.is_rowid(k) }
    else
      check_rowid_unique(table, row, rows, skip)
    end
    i = 0
    Array.each(columns) do |c|
      row[i] = Storage.coerce(row[i], c, Table.name(table)) if i != key_col
      i += 1
    end
    Array.each(Array.reverse(keys)) { |k| check_unique(table, k, row, rows, skip) unless Key.is_rowid(k) }
    row
  end

  # The rowid (at `slot`) gets the next number when NULL on INSERT, and must be an INTEGER otherwise.
  # `n` is the number of columns, where the rows keep a copy of the rowid.
  def settle_rowid(row, slot, rows, n, auto_key)
    v = row[slot]
    if v == nil
      Errors.sql_error("datatype mismatch") unless auto_key
      row[slot] = next_key(rows, n)
    else
      m = Storage.key_value(v)
      Errors.sql_error("datatype mismatch") if m == nil
      row[slot] = m
    end
  end

  # One more than the largest rowid (stored at `at`) of the rows, or 1 if there are no rows.
  def next_key(rows, at)
    return 1 if Array.empty?(rows)
    best = rows[0][at]
    Array.each(rows) { |r| best = r[at] if r[at] > best }
    best + 1
  end

  # Another row with the same rowid conflicts; a table with an INTEGER PRIMARY KEY is checked as a key instead.
  def check_rowid_unique(table, row, rows, skip)
    n = Array.size(Table.columns(table))
    i = 0
    Array.each(rows) do |other|
      Errors.sql_error("UNIQUE constraint failed: #{Table.name(table)}.rowid") if i != skip && other[n] == row[n]
      i += 1
    end
  end

  def check_not_null(table, row)
    i = 0
    Array.each(Table.columns(table)) do |c|
      Errors.sql_error("NOT NULL constraint failed: #{Table.name(table)}.#{Column.name(c)}") if Column.not_null(c) && row[i] == nil
      i += 1
    end
  end

  # Another row with equal values in all the key's columns conflicts, unless one of them is NULL.
  def check_unique(table, key, row, rows, skip)
    return if Array.any?(Key.cols(key)) { |c| row[c] == nil }
    i = 0
    Array.each(rows) do |other|
      if i != skip && same_key?(key, row, other)
        names = Array.map(Key.cols(key)) { |c| "#{Table.name(table)}.#{Column.name(Table.columns(table)[c])}" }
        Errors.sql_error("UNIQUE constraint failed: #{Array.join(names, ", ")}")
      end
      i += 1
    end
  end

  def same_key?(key, a, b) = Array.all?(Key.cols(key)) { |c| Values.compare(a[c], b[c]) == 0 }
end
