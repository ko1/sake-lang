# Port of actionpack-8.1.3/lib/action_controller/metal/helpers.rb (partial: no `helper` modules or `helpers` proxy; `helper_method` lines are generated) and actionview-8.1.3/lib/action_view/helpers/controller_helper.rb's delegation to the controller
#
# Rails' view calls its controller: ControllerHelper's `delegate :params, :session, :cookies, :flash, :action_name,
# ... to: :controller`, and the methods `helper_method` writes into the controller's `_helpers` module, which the
# view class includes (RequestForgeryProtection's form_authenticity_token and protect_against_forgery?, Flash's
# notice and alert, an app's current_user). Here the view's `controller` field holds the controller (any of the
# app's controller classes), and HelperMethods is what the app's view class includes: each function asks the
# controller through a module every controller includes (ActionController::Helpers for Metal's and
# AbstractController::Base's functions), which dispatches on the controller's class.
#
#   Ruby                                             Sake (an app's own helper_method, generated per view class)
#   helper_method :current_user                      def AppView.current_user(v) = case AppView.controller(v)
#                                                      in PostsController => c then PostsController.current_user(c) ...

require "flash"
require "cookies"
require "strong_parameters"
require "url_for"
require "request_forgery_protection"

module ActionController
  module Helpers
    # Metal's and AbstractController::Base's, which every controller class pastes
    def action_name(c) = raise(NotImplementedError)
    def controller_name(c) = raise(NotImplementedError)
    def controller_path(c) = raise(NotImplementedError)
    def session(c) = raise(NotImplementedError)
    def response(c) = raise(NotImplementedError)
    def headers(c) = raise(NotImplementedError)
    def view_context(c) = raise(NotImplementedError)

    # Provides a proxy to access helper methods from outside the view (Ruby: @_helper_proxy ||= view_context; a
    # new view each call here, nil when the app has no view class)
    def helpers(c) = view_context(c)

    # Rails' `_helpers` module of ActionController::Base, and ControllerHelper's delegation, for the view class
    module HelperMethods
      def controller(v) = raise(NotImplementedError)
      def view_controller(v) = controller(v) || raise(ArgumentError, "This view has no controller")

      # ControllerHelper: delegate ... to: :controller
      def params(v) = ActionController::StrongParameters.params(view_controller(v))
      def session(v) = ActionController::Helpers.session(view_controller(v))
      def cookies(v) = ActionController::Cookies.cookies(view_controller(v))
      def response(v) = ActionController::Helpers.response(view_controller(v))
      def headers(v) = ActionController::Helpers.headers(view_controller(v))
      def flash(v) = ActionController::Flash.flash(view_controller(v))
      def action_name(v) = ActionController::Helpers.action_name(view_controller(v))
      def controller_name(v) = ActionController::Helpers.controller_name(view_controller(v))
      def controller_path(v) = ActionController::Helpers.controller_path(view_controller(v))
      def request_forgery_protection_token(v) = RequestForgeryProtection.request_forgery_protection_token

      # Flash: helper_method(*types) of add_flash_types(:alert, :notice)
      def notice(v) = ActionController::Flash.notice(view_controller(v))
      def alert(v) = ActionController::Flash.alert(view_controller(v))

      # RequestForgeryProtection: helper_method :form_authenticity_token, :protect_against_forgery?
      def form_authenticity_token(v, form_options: nil) = ActionController::RequestForgeryProtection.form_authenticity_token(view_controller(v), form_options: form_options)
      def protect_against_forgery?(v) = ActionController::RequestForgeryProtection.protect_against_forgery?(view_controller(v))

      # ActionView::RoutingUrlFor#url_options: the controller's (host, port, protocol, _recall)
      def url_options(v) = ActionController::UrlFor.url_options(view_controller(v))
    end
  end
end
