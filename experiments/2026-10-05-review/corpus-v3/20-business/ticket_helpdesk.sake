class InvalidTransition < StandardError
  attr_reader from, to
end

def transitions = once {
  Hash[
    new: Set[:assigned, :closed],
    assigned: Set[:in_progress, :waiting, :closed],
    in_progress: Set[:waiting, :resolved],
    waiting: Set[:in_progress, :closed],
    resolved: Set[:closed, :in_progress],
    closed: Set[]
  ]
}

# minutes allowed until the first reply, and until resolution
def sla = once { Hash[urgent: [30, 240], high: [120, 1440], normal: [480, 4320]] }

def stamp(min) = format("d%d %02d:%02d", min / 1440 + 1, min % 1440 / 60, min % 60)

class Ticket
  attr_reader id, subject, priority, opened_at, status
  attr_accessor agent
  attr_reader first_reply_at, closed_at, log

  def initialize(t)
    @status = :new
    @agent = nil
    @first_reply_at = nil
    @closed_at = nil
    @log = nil
    @log = Array[]
  end

  def move(t, to, at)
    from = @status
    raise InvalidTransition.new("##{@id} cannot go from #{from} to #{to}", from, to) unless Set.include?(Hash.fetch(transitions, from), to)
    @status = to
    @first_reply_at ||= at if to == :in_progress || to == :waiting
    @closed_at = at if to == :resolved
    Array.push(@log, "#{stamp(at)} #{from} -> #{to}")
  end

  def breaches(t, now)
    reply_limit, resolve_limit = Hash.fetch(sla, @priority)
    out = Array[]
    reply = @first_reply_at || now
    done = @closed_at || now
    Array.push(out, "reply #{reply - @opened_at - reply_limit}m late") if reply - @opened_at > reply_limit
    Array.push(out, "resolution #{done - @opened_at - resolve_limit}m late") if done - @opened_at > resolve_limit
    out
  end
end

class Desk
  attr_reader agents, tickets

  def initialize(d)
    @tickets = nil
    @tickets = Hash[]
  end

  def open_ticket(d, id, subject, priority, at)
    @tickets[id] = Ticket.new(id, subject, priority, at)
  end

  # the agent with the fewest active tickets; ties go to the earlier name in the list
  def assign(d, t, at)
    load = Array.to_h(Array.map(@agents) { |a| [a, 0] })
    Hash.each_value(@tickets) do |x|
      agent = Ticket.agent(x)
      load[agent] += 1 if agent && Array.include?(Array[:assigned, :in_progress, :waiting], Ticket.status(x))
    end
    agent = Array.min_by(@agents) { |a| [load[a], Array.index(@agents, a)] }
    Ticket.set_agent(t, agent)
    Ticket.move(t, :assigned, at)
    agent
  end
end

desk = Desk.new(Array["ana", "raj", "li"])
script = Array[
  [0, 1, :open, "VPN down for sales team", :urgent],
  [5, 2, :open, "Invoice PDF has wrong address", :normal],
  [9, 1, :assign, nil, nil],
  [12, 3, :open, "Password reset loop", :high],
  [14, 2, :assign, nil, nil],
  [20, 3, :assign, nil, nil],
  [50, 1, :to, nil, :in_progress],
  [200, 3, :to, nil, :resolved],
  [210, 3, :to, nil, :in_progress],
  [300, 1, :to, nil, :resolved],
  [320, 4, :open, "New laptop request", :normal],
  [330, 4, :assign, nil, nil],
  [400, 2, :to, nil, :waiting],
  [900, 2, :to, nil, :in_progress],
  [1000, 1, :to, nil, :closed],
  [1500, 3, :to, nil, :resolved],
  [1510, 4, :to, nil, :closed],
  [1600, 2, :to, nil, :closed],
  [1700, 5, :open, "Printer jam on 3rd floor", :high]
]

Array.each(script) do |at, id, action, subject, arg|
  case action
  in :open
    Desk.open_ticket(desk, id, subject, arg, at)
    puts("#{stamp(at)} ##{id} opened (#{arg}): #{subject}")
  in :assign
    agent = Desk.assign(desk, Hash.fetch(Desk.tickets(desk), id), at)
    puts("#{stamp(at)} ##{id} -> #{agent}")
  in :to
    Ticket.move(Hash.fetch(Desk.tickets(desk), id), arg, at)
  end
rescue InvalidTransition => e
  puts("#{stamp(at)} rejected: #{Exception.message(e)}")
end

now = 2000
puts
puts("Tickets at #{stamp(now)}:")
Hash.each_value(Desk.tickets(desk)) do |t|
  b = Ticket.breaches(t, now)
  flag = Array.empty?(b) ? "ok" : "BREACH " + Array.join(b, ", ")
  puts(format("  #%d %-30s %-7s %-12s %-4s %s", Ticket.id(t), Ticket.subject(t), Ticket.priority(t), Ticket.status(t), Ticket.agent(t) || "-", flag))
  Array.each(Ticket.log(t)) { |l| puts("      #{l}") }
end

resolved = Array.select(Hash.values(Desk.tickets(desk))) { |t| Ticket.closed_at(t) != nil }
times = Array.sort(Array.map(resolved) { |t| Ticket.closed_at(t) - Ticket.opened_at(t) })
puts
puts("Resolved: #{Array.size(times)}, fastest #{Array.first(times)}m, slowest #{Array.last(times)}m")
by_agent = Array.group_by(Array.select(Hash.values(Desk.tickets(desk))) { |t| Ticket.agent(t) != nil }) { |t| Ticket.agent(t) }
Hash.each(by_agent) { |a, ts| puts("  #{a}: #{Array.join(Array.map(ts) { |t| "##{Ticket.id(t)}" }, " ")}") }
