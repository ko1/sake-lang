# Port of actionview-8.1.3/lib/action_view/helpers/tags/translator.rb (partial: no I18n lookup of helpers.label / helpers.placeholder keys: the model's human_attribute_name, as Rails gives when the app has no such keys)

require "../../model_naming"

module ActionView
  module Helpers
    module Tags
      class Translator
        attr_reader object, object_name, method_and_value, scope

        def make(object, object_name, method_and_value, scope:)
          Translator.new(object, String.gsub(Kernel.to_s(object_name), /\[(.*)_attributes\]\[\d+\]/, '.\1'), method_and_value, scope)
        end

        def translate(tr) = human_attribute_name(tr)

        # private
        def human_attribute_name(tr)
          o = @object
          (o in ModelNaming::Model) ? ModelNaming::Model.human_attribute_name_of(o, @method_and_value) : nil
        end
      end
    end
  end
end
