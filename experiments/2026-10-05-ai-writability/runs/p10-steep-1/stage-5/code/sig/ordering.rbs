module Sql
  module Ordering
    def self.sort: [T] (Array[T] items, Array[Array[value]] keys, Array[Ast::OrderTerm] terms) -> Array[T]
    def self.compare_keys: (Array[value] left, Array[value] right, Array[Ast::OrderTerm] terms) -> Integer
    def self.compare_term: (value a, value b, Ast::OrderTerm term) -> Integer
    def self.compare_lists: (Array[value] left, Array[value] right) -> Integer
  end
end
