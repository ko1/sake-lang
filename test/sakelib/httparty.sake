require "httparty"
require "webrick"
require "json"

# --- an API server: the webrick port, one handler type ---
class Api
  include WEBrick::HTTPHandler
  def allow?(h, method) = true           # a servlet answering every method (Ruby: `def service(req, res)`)
  def call(h, req, res)
    body = WEBrick::HTTPRequest.body(req)
    q = WEBrick::HTTPRequest.query(req)
    case WEBrick::HTTPRequest.path_info(req)
    in "/users"
      WEBrick::HTTPResponse.set_content_type(res, "application/json; charset=utf-8")
      res.WEBrick::HTTPResponse.body = JSON.generate(Hash["users" => Array[Hash["id" => 1, "name" => "ko1"]], "page" => q["page"] || "1", "q" => Hash.sort_by(WEBrick::HTTPUtils.parse_query(WEBrick::HTTPRequest.query_string(req))) { |k, v| k }])
    in "/echo"
      WEBrick::HTTPResponse.set_content_type(res, "application/json")
      res.WEBrick::HTTPResponse.body = JSON.generate(Hash["method" => WEBrick::HTTPRequest.request_method(req), "content_type" => WEBrick::HTTPRequest.content_type(req), "body" => body, "auth" => req["Authorization"], "x" => req["X-Api-Key"], "accept" => req["Accept"]])
    in "/text"
      WEBrick::HTTPResponse.set_content_type(res, "text/plain")
      res.WEBrick::HTTPResponse.body = "plain #{WEBrick::HTTPRequest.request_method(req)} #{Kernel.inspect(body)}"
    in "/missing"
      WEBrick::HTTPResponse.set_status(res, 404)
      WEBrick::HTTPResponse.set_content_type(res, "application/json")
      res.WEBrick::HTTPResponse.body = "{\"error\":\"not found\"}"
    in "/boom"
      WEBrick::HTTPResponse.set_status(res, 503)
      res.WEBrick::HTTPResponse.body = "down"
    in "/go"
      WEBrick::HTTPResponse.set_status(res, 302)
      res["Location"] = "/text"
    in "/loop"
      WEBrick::HTTPResponse.set_status(res, 302)
      res["Location"] = "/loop"
    in "/empty"
      WEBrick::HTTPResponse.set_status(res, 204)
    else
      WEBrick::HTTPResponse.set_status(res, 400)
      res.WEBrick::HTTPResponse.body = "?"
    end
  end
end

srv = WEBrick::HTTPServer.new("127.0.0.1", 0)
port = WEBrick::HTTPServer.port(srv)
WEBrick::HTTPServer.mount(srv, "/", Api.new)
t = Thread.new { WEBrick::HTTPServer.start(srv) }
base = "http://127.0.0.1:#{port}"

def show(r)
  puts("#{HTTParty::Response.code(r)} #{Kernel.inspect(HTTParty::Response.message(r))} success=#{HTTParty::Response.success?(r)} type=#{Kernel.inspect(HTTParty::Response.content_type(r))}")
  puts("  body=#{Kernel.inspect(HTTParty::Response.body(r))}")
  puts("  parsed=#{Kernel.inspect(HTTParty::Response.parsed_response(r))}")
end

puts("-- get")
r = HTTParty.get("#{base}/users")
show(r)
p([HTTParty::Response.ok?(r), HTTParty::Response.client_error?(r), HTTParty::Response.server_error?(r), HTTParty::Response.redirection?(r), HTTParty::Response.not_found?(r), HTTParty::Response.nil?(r)])
p(r["users"])
p(HTTParty::Response.header(r, "Content-Type"))
p(HTTParty::Response.headers(r)["content-length"])
p(HTTParty::Response.content_length(r))
puts(HTTParty::Response.to_s(r))
r = HTTParty.get("#{base}/users?page=2", query: Hash["sort" => "name", "tags" => Array["a", "b c"], "f" => Hash["x" => 1]])
show(r)
r = HTTParty.get(URI.parse("#{base}/echo"), headers: Hash["X-Api-Key" => "k1", "Accept" => "application/json"])
show(r)
r = HTTParty.get("#{base}/echo", basic_auth: Hash[username: "user", password: "pw"])
p(r["auth"])
r = HTTParty.get("#{base}/text")
show(r)
p(r[0])

puts("-- post, put, patch, delete, head")
r = HTTParty.post("#{base}/echo", body: Hash["name" => "sake", "tags" => Array["x", "y"]])
show(r)
r = HTTParty.post("#{base}/echo", body: JSON.generate(Hash["a" => 1]), headers: Hash["Content-Type" => "application/json"])
show(r)
r = HTTParty.post("#{base}/text", body: "raw text")
show(r)
r = HTTParty.put("#{base}/echo", body: Hash["v" => "2"])
p([r["method"], r["body"]])
r = HTTParty.patch("#{base}/echo", body: "p")
p([r["method"], r["body"], r["content_type"]])
r = HTTParty.delete("#{base}/echo")
p([r["method"], r["body"]])
r = HTTParty.head("#{base}/users")
p([HTTParty::Response.code(r), HTTParty::Response.body(r), HTTParty::Response.parsed_response(r), HTTParty::Response.headers(r)["content-type"]])

puts("-- errors, redirects")
r = HTTParty.get("#{base}/missing")
show(r)
p([HTTParty::Response.not_found?(r), HTTParty::Response.client_error?(r), r["error"]])
r = HTTParty.get("#{base}/boom")
show(r)
r = HTTParty.get("#{base}/empty")
show(r)
r = HTTParty.get("#{base}/go")
show(r)
r = HTTParty.get("#{base}/go", follow_redirects: false)
p([HTTParty::Response.code(r), HTTParty::Response.redirection?(r), String.sub(HTTParty::Response.headers(r)["location"] || "", /:\d+\//, ":PORT/")])
r = HTTParty.post("#{base}/go", body: "x")
show(r)
begin
  HTTParty.get("#{base}/loop")
rescue HTTParty::RedirectionTooDeep => e
  puts("RedirectionTooDeep: #{Exception.message(e)}")
end

puts("-- to_params")
p(HTTParty.to_params(Hash["a" => 1, "b" => Array[1, 2], "c" => Hash["d" => "e f"], "n" => nil]))
p(HTTParty.normalize_param("k", "v&w"))

puts("-- client (the class DSL)")
api = HTTParty::Client.new(base, Hash["X-Api-Key" => "secret"], Hash["page" => "9"])
r = HTTParty::Client.get(api, "/users", query: Hash["sort" => "id"])
show(r)
r = HTTParty::Client.get(api, "/echo")
p([r["x"], r["accept"]])
api.HTTParty::Client.basic_auth = Hash[username: "u", password: "p"]
r = HTTParty::Client.post(api, "/echo", body: Hash["k" => "v"], headers: Hash["Accept" => "text/*"])
p([r["auth"], r["x"], r["accept"], r["body"]])
api2 = HTTParty::Client.new(base + "/")
p(HTTParty::Response.body(HTTParty::Client.get(api2, "/text")))

WEBrick::HTTPServer.shutdown(srv)
Thread.join(t)
puts("end")
