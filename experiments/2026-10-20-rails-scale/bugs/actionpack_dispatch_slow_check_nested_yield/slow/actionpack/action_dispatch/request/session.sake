# Port of actionpack-8.1.3/lib/action_dispatch/request/session.rb (partial: no dig, no inspect's object id)
#
# The store a session belongs to (`@by`) is any type that includes ActionDispatch::Session::AbstractStore
# (middleware/session/abstract_store.sake); Rails' `@by.send(:load_session, @req)` is the module dispatch
# `Session::AbstractStore.load_session(@by, @req)`. Keys are Strings (Rails' key.to_s); values are any JSON-able value.

require "../http/request"

module ActionDispatch
  class Request
    # Rails (Rack::Request::Helpers#session): the session, or a disabled one when no store is in the stack
    def session(req) = @_session ||= Session.disabled(req)
    def set_session(req, s) = @_session = s
    def session_options(req) = Session::Options.find(req)
    def rack_session(req) = @_session                    # get_header("rack.session")
    def rack_session_options(req) = @_session_options    # get_header("rack.session.options")
    def set_session_options(req, o) = @_session_options = o
    def reset_session(req)
      Session.destroy(session(req))
      @_flash = nil
      nil
    end

    class Session
      attr_reader by, req
      include Indexable
      private attr_accessor delegate, loaded, exists, enabled, id_was, id_was_initialized

      class DisabledSessionError < StandardError
      end

      def create(store, req, default_options)
        session_was = find(req)
        session = Session.new(store, req)
        Session.update(session, Session.to_hash(session_was)) if session_was
        set(req, session)
        Options.set(req, Options.new(store, default_options))
        session
      end

      def disabled(req)
        s = Session.new(nil, req)
        s.Session.enabled = false
        Options.set(req, Options.new(nil, Hash.of(id: nil)))
        s
      end

      def find(req) = Request.rack_session(req)
      def set(req, session) = Request.set_session(req, session)
      # Rails' Session.delete(req): renamed, as `delete(session, key)` is the instance's (one name is one function)
      def delete_from(req) = Request.set_session(req, nil)

      # The session id is kept in its own field (Rails keeps it in the options Hash under :id), so that it stays a
      # Rack::Session::SessionId where the other options are Strings and Booleans.
      class Options
        attr_reader by, delegate
        private attr_accessor sid, sid_known
        include Indexable

        def set(req, options) = Request.set_session_options(req, options)
        def find(req) = Request.rack_session_options(req)

        def initialize(o)
          d = Hash.dup(@delegate)
          @sid_known = Hash.key?(d, :id)
          @sid = nil
          Hash.delete(d, :id)
          @delegate = d
        end

        def [](o, key) = @delegate[key]
        def id(o, req)
          return @sid if @sid_known
          by = @by
          by ? ActionDispatch::Session::AbstractStore.extract_session_id(by, req) : nil
        end
        def set_id(o, sid)
          @sid = sid
          @sid_known = true
        end
        def []=(o, k, v)
          @delegate[k] = v
        end
        def to_hash(o)
          h = Hash.dup(@delegate)
          h[:id] = @sid if @sid_known
          h
        end
        def values_at(o, *args) = Array.map(args) { |a| @delegate[a] }
      end

      def initialize(s)
        @delegate = Hash.new
        @loaded = false
        @exists = nil
        @enabled = true if @enabled == nil
        @id_was = nil
        @id_was_initialized = false
      end

      def id(s)
        o = options(s)
        o ? Options.id(o, @req) : nil
      end
      def enabled?(s) = @enabled == true
      def options(s) = Options.find(@req)

      def destroy(s)
        clear(s)
        if enabled?(s)
          by = @by
          o = options(s)
          if by && o
            ActionDispatch::Session::AbstractStore.delete_session(by, @req, Options.id(o, @req), o)
          end
          @loaded = false
          load_for_write!(s)
        end
        nil
      end

      def [](s, key)
        load_for_read!(s)
        k = Kernel.to_s(key)
        if k == "session_id"
          i = id(s)
          i ? Rack::Session::SessionId.public_id(i) : nil
        else
          @delegate[k]
        end
      end

      def has_key?(s, key)
        load_for_read!(s)
        Hash.key?(@delegate, Kernel.to_s(key))
      end
      def key?(s, key) = has_key?(s, key)
      def include?(s, key) = has_key?(s, key)

      def keys(s)
        load_for_read!(s)
        Hash.keys(@delegate)
      end
      def values(s)
        load_for_read!(s)
        Hash.values(@delegate)
      end

      def []=(s, key, value)
        load_for_write!(s)
        @delegate[Kernel.to_s(key)] = value
      end
      def store(s, key, value) = Session.[]=(s, key, value)

      def clear(s)
        load_for_delete!(s)
        Hash.clear(@delegate)
        nil
      end

      def to_hash(s)
        load_for_read!(s)
        Hash.reject(@delegate) { |_, v| v == nil }
      end
      def to_h(s) = to_hash(s)

      def update(s, hash)
        load_for_write!(s)
        Hash.each(hash) { |k, v| @delegate[Kernel.to_s(k)] = v }
        @delegate
      end
      def merge!(s, hash) = update(s, hash)

      def delete(s, key)
        load_for_delete!(s)
        Hash.delete(@delegate, Kernel.to_s(key))
      end

      def fetch(s, key, default = nil)
        load_for_read!(s)
        return Hash.fetch(@delegate, Kernel.to_s(key)) if default == nil
        Hash.fetch(@delegate, Kernel.to_s(key), default)
      end

      def exists?(s)
        return false unless enabled?(s)
        e = @exists
        return e if e != nil
        by = @by
        e = by ? ActionDispatch::Session::AbstractStore.session_exists?(by, @req) : false
        @exists = e
        e
      end

      def loaded?(s) = @loaded == true

      def empty?(s)
        load_for_read!(s)
        Hash.empty?(@delegate)
      end

      def each(s)
        Hash.each(to_hash(s)) { |k, v| yield([k, v]) }
        s
      end

      def id_was(s)
        load_for_read!(s)
        @id_was
      end

      def inspect(s) = loaded?(s) ? Kernel.inspect(@delegate) : "#<ActionDispatch::Request::Session not yet loaded>"

      def load_for_read!(s)
        load!(s) if !loaded?(s) && exists?(s)
        nil
      end

      def load_for_write!(s)
        unless enabled?(s)
          raise DisabledSessionError, "Your application has sessions disabled. To write to the session you must first configure a session store"
        end
        load!(s) unless loaded?(s)
        nil
      end

      def load_for_delete!(s)
        load!(s) if enabled?(s) && !loaded?(s)
        nil
      end

      def load!(s)
        by = @by
        if enabled?(s) && by
          @id_was_initialized = true unless exists?(s)
          sid, session = ActionDispatch::Session::AbstractStore.load_session(by, @req)
          o = options(s)
          Options.set_id(o, sid) if o
          Hash.clear(@delegate)
          Hash.each(session) { |k, v| @delegate[Kernel.to_s(k)] = v }
          @id_was = sid unless @id_was_initialized
        end
        @id_was_initialized = true
        @loaded = true
        nil
      end
    end
  end
end
