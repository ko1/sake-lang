RateError = Exception.new(:pair)

# Exchange rates as exact Rationals; an edge a->b with rate r implies b->a with 1/r.
def load_rates(quotes)
  graph = Hash[]
  Array.each(quotes) do |q|
    m = String.match(q, /\A(\w{3})\/(\w{3})\s*=\s*(\d+)(?:\/(\d+))?\z/)
    raise RateError.new("unreadable quote '#{q}'", q) unless m
    den = m[4] ? String.to_i(m[4]) : 1
    raise RateError.new("zero rate", q) if String.to_i(m[3]) == 0 || den == 0
    r = Rational(String.to_i(m[3]), den)
    graph[m[1]] ||= Hash[]
    graph[m[2]] ||= Hash[]
    graph[m[1]][m[2]] = r
    graph[m[2]][m[1]] = 1 / r
  end
  graph
end

# DFS that accumulates the product of rates along the path.
def convert(graph, from, to)
  return nil unless Hash.key?(graph, from) && Hash.key?(graph, to)
  stack = Array[[from, 1r, Array[from]]]
  seen = Set[from]
  until Array.empty?(stack)
    cur, rate, path = Array.pop(stack)
    return [rate, path] if cur == to
    Hash.each(graph[cur]) do |nb, r|
      next unless Set.add?(seen, nb)
      Array.push(stack, [nb, rate * r, Array.push(Array.dup(path), nb)])
    end
  end
  nil
end

# A cycle whose product differs from 1 means the quotes are inconsistent.
def inconsistencies(graph)
  issues = Array[]
  Array.each(Array.sort(Hash.keys(graph))) do |a|
    Hash.each(graph[a]) do |b, r_ab|
      next unless a < b
      Hash.each(graph[b]) do |c, r_bc|
        next unless b < c
        r_ca = graph[c][a]
        next if r_ca == nil
        loop_rate = r_ab * r_bc * r_ca
        if loop_rate != 1
          Array.push(issues, "#{a}>#{b}>#{c}>#{a} = #{Rational.to_s(loop_rate)}")
        end
      end
    end
  end
  issues
end

def show(amount, rate)
  value = amount * rate
  Float.round(Rational.to_f(value), 2)
end

def desk(title, quotes, asks)
  puts("== #{title}")
  graph = load_rates(quotes)
  puts("currencies: #{Array.join(Array.sort(Hash.keys(graph)), " ")}")
  Array.each(asks) do |amount, from, to|
    found = convert(graph, from, to)
    if found
      rate, path = found
      puts("  #{amount} #{from} = #{show(amount, rate)} #{to}  (rate #{rate}, via #{Array.join(path, ">")})")
    else
      puts("  #{amount} #{from} -> #{to}: no conversion")
    end
  end
  issues = inconsistencies(graph)
  puts(Array.empty?(issues) ? "  quotes are consistent" : "  inconsistent: #{Array.join(issues, "; ")}")
rescue RateError => e
  puts("  bad quotes: #{Exception.message(e)}")
end

desk("morning", Array["EUR/USD = 11/10", "USD/JPY = 150", "GBP/EUR = 6/5", "CHF/EUR = 21/20", "AUD/USD = 2/3"],
     Array[[100, "GBP", "JPY"], [250, "AUD", "CHF"], [1000, "JPY", "EUR"], [5, "EUR", "EUR"], [7, "EUR", "XYZ"]])
desk("stale feed", Array["EUR/USD = 11/10", "USD/GBP = 4/5", "GBP/EUR = 6/5", "SEK/NOK = 1"],
     Array[[10, "SEK", "EUR"], [10, "NOK", "SEK"]])
desk("garbage", Array["EUR/USD = 11/10", "EURUSD 1.1"], Array[])
