# sake: --strict=0
# class C < {accessor: [...], reader: [...], writer: [...], default: {...}, exception: true}
class Point < {accessor: [x, y]}
  def norm2(p) = @x * @x + @y * @y
end
class Account < {reader: [owner], accessor: [balance]}
  def deposit(a, n) = @balance += n
  def rename(a, s) = @owner = s
end
class Config < {reader: [host, port], default: {port: 80}}
end
class ParseError < {exception: true, reader: [line]}
end
p(Point.norm2(Point.new(3, 4)))
a = Account.new("ann", 10)
Account.deposit(a, 5)
Account.rename(a, "bob")
p(a)
p(Config.new("example.com"))
p(Config.get_port(Config.new("h", 8080)))
begin
  raise ParseError.new("bad", 3)
rescue ParseError => e
  p([Exception.message(e), ParseError.get_line(e)])
end
Config.new("h", "eighty")
