# Port of activesupport-8.1.3/lib/active_support/railtie.rb (partial: the time zone and beginning_of_week; no deprecation behaviors, executor, cache format, message serializers (ActiveSupport's are fixed in this port))
#
# Ruby's `initializer "active_support.initialize_time_zone" do |app| ... end` blocks are the `run` cases.

require "core_ext/time/zones"

module ActiveSupport
  module Railtie
    module_function

    def initializers
      list = Rails::Initializable::Initializer[]
      Rails::Initializable.add(list, :"active_support.initialize_time_zone", :active_support)
      Rails::Initializable.add(list, :"active_support.initialize_beginning_of_week", :active_support)
      list
    end

    def run(config, name)
      case name
      # Ruby: Time.zone_default = Time.find_zone!(app.config.time_zone)
      in :"active_support.initialize_time_zone" then Time.set_zone_default(Kernel.to_s(Rails::Application::Configuration.time_zone(config)))
      # Ruby: Date.beginning_of_week_default (Sake's Date calculations start the week on Monday)
      in :"active_support.initialize_beginning_of_week" then nil
      else raise ArgumentError, "no initializer #{name}"
      end
      nil
    end
  end
end
