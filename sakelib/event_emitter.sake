# event_emitter: Node's EventEmitter (on, once, off, emit, ...) with snake_case names, as Ruby's
# event_emitter gems have it.
#
# A listener cannot be a block, since Sake does not keep blocks. It is a value of a class that
# includes the module Listener and defines `call(listener, args)`: the type is the code, its fields
# are the state the code closes over (what a Ruby block would capture). `emit` runs `Listener.call`,
# which dispatches to the listener's type. `off` finds a listener by ==, which compares a
# value's fields; in Ruby a block is found by identity.
#
#   class Printer
#     attr_reader prefix
#     include Listener
#     def call(l, args) = puts("#{@prefix}: #{args}")
#   end
#   e = EventEmitter.new
#   EventEmitter.on(e, :data, Printer.new("got"))
#   EventEmitter.emit(e, :data, 1, 2)          # got: [1, 2]
#
# The args reach the listener as one Array (`call(l, args)`), not spread over its parameters.

module Listener
  def call(l, args) = raise(NotImplementedError)
end

class EventEmitter
  # event => [[listener, once?], ...] in calling order
  private attr_reader handlers
  def initialize(e) = @handlers = Hash[]

  def add(e, event, listener, once, prepend)
    list = @handlers[event] || (@handlers[event] = Array[])
    entry = [listener, once]
    prepend ? Array.unshift(list, entry) : Array.push(list, entry)
    e
  end

  def on(e, event, listener) = add(e, event, listener, false, false)
  def add_listener(e, event, listener) = add(e, event, listener, false, false)
  def once(e, event, listener) = add(e, event, listener, true, false)
  def prepend_listener(e, event, listener) = add(e, event, listener, false, true)
  def prepend_once_listener(e, event, listener) = add(e, event, listener, true, true)

  # Removes the most recently added listener == to the given one, as Node does.
  def off(e, event, listener)
    list = @handlers[event]
    return e unless list
    i = Array.size(list) - 1
    while i >= 0
      l, _ = Array.fetch(list, i)
      if l == listener
        Array.delete_at(list, i)
        break
      end
      i -= 1
    end
    Hash.delete(@handlers, event) if Array.empty?(list)
    e
  end

  def remove_listener(e, event, listener) = off(e, event, listener)

  def remove_all_listeners(e, event = nil)
    event == nil ? Hash.clear(@handlers) : Hash.delete(@handlers, event)
    e
  end

  # Calls the event's listeners in order with args (a copy of the list, so that a listener added
  # or removed while emitting takes effect from the next emit); once-listeners are removed first.
  # true when there was a listener. An :error event without a listener raises, as in Node.
  def emit(e, event, *args)
    list = @handlers[event]
    if list == nil || Array.empty?(list)
      raise "Unhandled error. (#{Kernel.inspect(args[0])})" if event == :error
      return false
    end
    current = Array.dup(list)
    Array.each(current) { |entry| off(e, event, entry[0]) if entry[1] }
    Array.each(current) { |l, _| Listener.call(l, args) }
    true
  end

  def listener_count(e, event)
    list = @handlers[event]
    list ? Array.size(list) : 0
  end

  def listeners(e, event)
    list = @handlers[event]
    list ? Array.map(list) { |l, _| l } : Array[]
  end

  def event_names(e) = Hash.keys(@handlers)
end
