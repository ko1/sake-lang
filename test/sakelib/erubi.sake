require "erubi"

# Ruby evals the source with the Hash's keys as local variables; Sake renders without eval
def render(engine, vars) = Erubi::Engine.render(engine, vars)

page = "<h1><%= title %></h1>\n<ul>\n<% items.each do |item| %>\n  <li><%== item[:name] %> <%= item[:price] %></li>\n<% end %>\n</ul>\n<%# a comment\nover two lines %>\n<% if items.empty? %>\nnone\n<% else %>\n<%= items.size %> items\n<% end %>\n"

# the generated Ruby source
engine = Erubi::Engine.new(page)
puts(Erubi::Engine.src(engine))
p(Erubi::Engine.bufvar(engine))
p(Erubi::Engine.filename(engine))

# rendering: <%= is not escaped by default, <%== is
data = Hash[:title => "Fruits & Nuts", :items => Array[Hash[:name => "<apple>", :price => 120], Hash[:name => "nut's", :price => 30]]]
print(render(engine, data))
print(render(engine, Hash[:title => "Empty", :items => Array[]]))

# escape: true swaps the two
escaped = Erubi::Engine.new(page, Hash[:escape => true])
puts(Erubi::Engine.src(escaped))
print(render(escaped, data))

# trimming: a tag alone on its line takes the line with it, unless trim is false
small = "a\n  <% if flag %>\n  b\n  <% end %>\nc <%= 1 -%>\nd <%- x = 1 -%>\n"
puts(Erubi::Engine.src(Erubi::Engine.new(small)))
puts(Erubi::Engine.src(Erubi::Engine.new(small, Hash[:trim => false])))
print(render(Erubi::Engine.new("a\n  <% if flag %>\n  b\n  <% end %>\nc\n"), Hash[:flag => true]))
print(render(Erubi::Engine.new("a\n  <% if flag %>\n  b\n  <% end %>\nc\n", Hash[:trim => false]), Hash[:flag => false]))

# <%% is a literal <%, quotes and backslashes in text are kept
lit = "<%% x %> it's \\ <%%= y -%>\n"
puts(Erubi::Engine.src(Erubi::Engine.new(lit)))
print(render(Erubi::Engine.new(lit), Hash[]))
puts(Erubi::Engine.src(Erubi::Engine.new(lit, Hash[:literal_prefix => "{%", :literal_postfix => "%}"])))

# options that change the source only
puts(Erubi::Engine.src(Erubi::Engine.new("x<%= y %>z", Hash[:bufvar => "@out", :freeze => true])))
puts(Erubi::Engine.src(Erubi::Engine.new("x<%= y %>z", Hash[:outvar => "out", :ensure => true])))
puts(Erubi::Engine.src(Erubi::Engine.new("x<%= y %>z", Hash[:bufvar => "@b", :ensure => true])))
puts(Erubi::Engine.src(Erubi::Engine.new("x<%= y %><%= z %>w<% q %>", Hash[:chain_appends => true])))
puts(Erubi::Engine.src(Erubi::Engine.new("x<%== y %>", Hash[:freeze_template_literals => false, :escapefunc => "esc"])))
puts(Erubi::Engine.src(Erubi::Engine.new("x", Hash[:preamble => "b = [];", :postamble => "b.join\n", :bufvar => "b", :src => "# hi\n"])))
p(Erubi::Engine.filename(Erubi::Engine.new("", Hash[:filename => "t.erb"])))
p(Erubi::Engine.src(Erubi::Engine.new("")))

# Erubi.h escapes & < > " '
p(Erubi.h("<a href=\"x\">'&'</a>"))
p(Erubi.h(42))

# a regexp with an indicator the engine does not know
begin
  Erubi::Engine.new("<%@ x %>", Hash[:regexp => /<%(@)?(.*?)([-=])?%>([ \t]*\r?\n)?/m])
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
