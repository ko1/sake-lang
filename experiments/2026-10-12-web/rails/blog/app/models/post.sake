# Ruby (app/models/post.rb):
#   class Post < ApplicationRecord
#     has_many :comments, dependent: :destroy
#     validates :title, presence: true, length: { minimum: 5 }
#     validates :body, presence: true
#   end
#
# `class Post < ApplicationRecord` and the columns are generated from db/schema.sake (bin/rails source): the first
# `class Post` declares the fields, so this file adds functions to it.
class Post
  # has_many :comments
  def comments(post) = Comment.where({post_id: @id})
  # dependent: :destroy
  def before_destroy(post)
    Enum.each(comments(post)) { |c| Comment.destroy(c) }
  end

  def validate(post)
    validates post, :title, {presence: true, length: {minimum: 5}}
    validates post, :body, {presence: true}
  end
end
