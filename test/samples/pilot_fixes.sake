# From the AI writability pilot: String.slice; Tuples holding Arrays compared in order
s = "hello"
p String.slice(s, 1, 3)
p String.slice(s, 1..2)
p String.slice(s, 9)
best = [3, Array["b", "a"]]
cand = [3, Array["a", "z"]]
p(cand < best)
labels = Hash["x" => [1, Array["p"]]]
cur = Hash.fetch(labels, "x", nil)
p(cur == nil || [1, Array["o"]] < cur)
