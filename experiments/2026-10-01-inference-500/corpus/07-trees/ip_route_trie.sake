BitNode = Struct.new(:zero, :one, :route)
Route = Struct.new(:prefix, :len, :iface, :metric)
BadAddress = Exception.new(:text)

def parse_ip(text)
  parts = String.split(text, ".")
  raise BadAddress.new("bad address #{text}", text) if Array.size(parts) != 4
  Array.reduce(parts, 0) do |acc, p|
    raise BadAddress.new("bad octet #{p} in #{text}", text) unless String.match?(p, /\A\d{1,3}\z/) && String.to_i(p) <= 255
    (acc << 8) | String.to_i(p)
  end
end

def ip_to_s(n) = Array.join(Array.map(Array[24, 16, 8, 0]) { |s| (n >> s) & 255 }, ".")

def bit(addr, i) = (addr >> (31 - i)) & 1

def mask(len) = len == 0 ? 0 : ((1 << len) - 1) << (32 - len)

class Route
  def to_s(r) = "#{ip_to_s(@prefix)}/#{@len} via #{@iface} (metric #{@metric})"
end

class RouteTable
  attr_reader root
  attr_accessor size
  def create = RouteTable.new(BitNode.new(nil, nil, nil), 0)

  def add(t, cidr, iface, metric)
    f = String.split(cidr, "/")
    len = String.to_i(f[1])
    raise BadAddress.new("bad prefix length in #{cidr}", cidr) if len > 32
    prefix = parse_ip(f[0]) & mask(len)
    node = @root
    Range.each(0...len) do |i|
      if bit(prefix, i) == 0
        BitNode.set_zero(node, BitNode.new(nil, nil, nil)) if BitNode.zero(node) == nil
        node = BitNode.zero(node)
      else
        BitNode.set_one(node, BitNode.new(nil, nil, nil)) if BitNode.one(node) == nil
        node = BitNode.one(node)
      end
    end
    old = BitNode.route(node)
    if old == nil || Route.metric(old) > metric
      @size += 1 if old == nil
      BitNode.set_route(node, Route.new(prefix, len, iface, metric))
    end
  end

  def lookup(t, text)
    addr = parse_ip(text)
    node = @root
    best = BitNode.route(node)
    depth = 0
    while node != nil && depth < 32
      node = bit(addr, depth) == 0 ? BitNode.zero(node) : BitNode.one(node)
      depth += 1
      if node
        r = BitNode.route(node)
        best = r if r
      end
    end
    best
  end

  def remove(t, cidr)
    f = String.split(cidr, "/")
    len = String.to_i(f[1])
    prefix = parse_ip(f[0]) & mask(len)
    node = @root
    Range.each(0...len) do |i|
      node = bit(prefix, i) == 0 ? BitNode.zero(node) : BitNode.one(node)
      return false if node == nil
    end
    return false if BitNode.route(node) == nil
    BitNode.set_route(node, nil)
    @size -= 1
    true
  end

  def each_route(t) = walk(@root) { |r| yield(r) }

  def walk(node)
    return if node == nil
    r = BitNode.route(node)
    yield(r) if r
    walk(BitNode.zero(node)) { |x| yield(x) }
    walk(BitNode.one(node)) { |x| yield(x) }
  end

  def node_count(t) = count(@root)
  def count(node) = node == nil ? 0 : 1 + count(BitNode.zero(node)) + count(BitNode.one(node))
end

table = RouteTable.create
routes = <<~T
  0.0.0.0/0 wan0 100
  10.0.0.0/8 vpn0 10
  10.20.0.0/16 lan1 5
  10.20.30.0/24 lab0 1
  10.20.30.128/25 lab1 1
  192.168.1.0/24 lan0 1
  192.168.1.77/32 printer 1
  172.16.0.0/12 dmz0 20
  10.20.0.0/16 backup 50
  172.16.5.9/33 typo 1
  300.1.1.0/24 typo 1
T
String.each_line(routes) do |line|
  f = String.split(line, " ")
  begin
    RouteTable.add(table, f[0], f[1], String.to_i(f[2]))
  rescue BadAddress => e
    puts("skip: #{Exception.message(e)}")
  end
end
puts("#{RouteTable.size(table)} routes, #{RouteTable.node_count(table)} trie nodes")
RouteTable.each_route(table) { |r| puts("  #{r}") }

puts("-- lookups --")
Array.each(Array["10.20.30.200", "10.20.30.5", "10.20.99.1", "10.1.2.3", "192.168.1.77", "192.168.1.78", "172.31.255.255", "8.8.8.8", "10.20.30"]) do |ip|
  begin
    r = RouteTable.lookup(table, ip)
    puts(format("  %-15s -> %-8s (%s/%d)", ip, Route.iface(r), ip_to_s(Route.prefix(r)), Route.len(r)))
  rescue BadAddress => e
    puts("  #{ip}: #{Exception.message(e)}")
  end
end

puts("-- withdraw 10.20.30.0/24 and 0.0.0.0/0 --")
Array.each(Array["10.20.30.0/24", "0.0.0.0/0", "10.99.0.0/16"]) { |c| puts("  remove #{c}: #{RouteTable.remove(table, c)}") }
Array.each(Array["10.20.30.5", "8.8.8.8"]) do |ip|
  r = RouteTable.lookup(table, ip)
  puts("  #{ip} -> #{r == nil ? "unreachable" : Route.iface(r)}")
end
puts("#{RouteTable.size(table)} routes left")
