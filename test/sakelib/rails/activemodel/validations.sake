# ActiveModel's validators: length, absence, numericality, format, inclusion/exclusion, acceptance,
# confirmation, comparison, a custom EachValidator (validates key) and Validator (validates_with), the
# validates_*_of helpers, validates! and except_on.
require "rails/activemodel/active_model"
require "date"


class UniquenessOfDomainValidator < ActiveModel::EachValidator
  def validate_each(v, record, attribute, value)
    ActiveModel::Errors.add(ActiveModel::Validations.errors(record), attribute, :taken, message: "has a taken domain") if String.end_with?(Kernel.to_s(value), "@taken.com")
  end
end

class PlanValidator < ActiveModel::Validator
  def validate(v, record)
    record => Signup
    ActiveModel::Errors.add(Signup.errors(record), :base, "Plan 3 needs a level") if Signup.plan(record) == 3 && Signup.level(record) == nil
  end
end

generate "rails/activemodel/active_model/generate/active_model", "validations_decl.rb"

def check(label, attrs, context = nil)
  s = Signup.build(Hash.merge(Hash.of(login: "kosaki", age: 20, terms: "1", limit: 10, level: 3), attrs))
  ok = Signup.valid?(s, context)
  puts("#{label}: #{ok} #{Kernel.inspect(ActiveModel::Errors.full_messages(Signup.errors(s)))}")
  p(ActiveModel::Errors.details(Signup.errors(s))) unless ok
end

check("ok", Hash.new)
check("login short", Hash.of(login: "ab"))
check("login long", Hash.of(login: "abcdefghi"))
check("nickname", Hash.of(nickname: "abc"))
check("pin", Hash.of(pin: "12"))
check("pin letters", Hash.of(pin: "12ab5"))
check("pin blank", Hash.of(pin: ""))
check("bio limit", Hash.of(bio: "x" * 11))
check("code", Hash.of(code: "x"))
check("age low", Hash.of(age: 17))
check("age high", Hash.of(age: "121"))
check("age text", Hash.of(age: "old"))
check("age nil", Hash.of(age: nil))
check("score", Hash.of(score: 11))
check("count", Hash.of(count: 2))
check("count float", Hash.of(count: 3.5))
check("ratio", Hash.of(ratio: 0))
check("ratio string", Hash.of(ratio: "1.5"))
check("level", Hash.of(level: 4))
check("email", Hash.of(email: "nope"))
check("email taken", Hash.of(email: "a@taken.com"))
check("size", Hash.of(size: "XL"))
check("color", Hash.of(color: "red"))
check("plan", Hash.of(plan: 5))
check("plan 3", Hash.of(plan: 3, level: nil))
check("plan 3 level", Hash.of(plan: 3, level: 3))
check("terms", Hash.of(terms: "0"))
check("terms nil", Hash.of(terms: nil))
check("password", Hash.of(password: "Secret", password_confirmation: "secret"))
check("password mismatch", Hash.of(password: "Secret", password_confirmation: "other"))
check("dates", Hash.of(starts_on: Date.new(2026, 10, 20), ends_on: Date.new(2026, 10, 19)))
check("dates ok", Hash.of(starts_on: Date.new(2026, 10, 20), ends_on: Date.new(2026, 10, 21)))
check("no login", Hash.of(login: nil))
check("draft", Hash.of(level: nil), :draft)
begin
  check("strict", Hash.of(count: 101))
rescue ActiveModel::StrictValidationFailed => e
  puts("strict: StrictValidationFailed #{Exception.message(e)}")
end
p(Array.map(Signup.validators_on(:count)) { |v| ActiveModel::AnyValidator.kind(v) })
p(Array.map(Signup.validators_on(:email)) { |v| ActiveModel::AnyValidator.class_name(v) })
p(Array.map(Signup.validators_on(:login)) { |v| [ActiveModel::AnyValidator.kind(v), ActiveModel::AnyValidator.options(v)] })
