# Port of activesupport-8.1.3/lib/active_support/core_ext/array/wrap.rb, array/extract_options.rb and array/extract.rb (three small files)

class Array
  # Ruby: Array.wrap(object): nil is [], an Array itself, anything else [object].
  def wrap(object)
    case object
    in nil then Any[]
    in Array then object
    else Any[object]
    end
  end

  # Ruby: extract_options!: the last element if it is a Hash, else {}.
  def extract_options!(xs)
    last = Array.last(xs)
    if last in Hash
      Array.pop(xs)
      last
    else
      Hash.new
    end
  end

  def extract!(xs)
    extracted_elements = Any[]
    Array.reject!(xs) do |element|
      if yield(element)
        Array.push(extracted_elements, element)
        true
      else
        false
      end
    end
    extracted_elements
  end
end
