# Port of actionpack-8.1.3/lib/action_dispatch/testing/assertions.rb (partial: no html_document / Rails::Dom::Testing selectors)
#
# Rails' assertions are methods of the test case, built on Minitest::Assertions (`assert`, `assert_equal`, ...),
# with the test's state in @response, @request, @routes. Here ResponseAssertions and RoutingAssertions are mixins
# whose includer (a test: IntegrationTest, or a small class) defines `minitest(x)` (the Minitest::Test the block
# of Minitest.test got: assertions count against it), `response(x)`, `request(x)` and `routes(x)`. The Minitest
# helpers below give the messages Ruby's Minitest gives (Minitest#message, #diff without the external diff), and
# raise Minitest::Assertion, which sakelib's Minitest.test records as a failure.

require "minitest"
require "assertion_response"
require "assertions/response"
require "assertions/routing"

module ActionDispatch
  module Assertions
    module_function

    def mu_pp(obj) = Kernel.inspect(obj)

    # Minitest#diff for values whose inspect is one short line; longer ones would go to `diff -u` in Ruby
    def diff(exp, act) = "Expected: #{mu_pp(exp)}\n  Actual: #{mu_pp(act)}"

    # Minitest#message(msg, ending) { default }
    def message(msg, ending, default) = msg == nil || msg == "" ? "#{default}#{ending}" : "#{msg}.\n#{default}#{ending}"

    def assert(t, test, msg)
      Minitest.count(t)
      raise Minitest::Assertion, msg unless test
      true
    end

    def assert_equal(t, exp, act, msg) = assert(t, exp == act, msg)

    def flunk(t, msg) = assert(t, false, msg || "Epic Fail!")
  end
end
