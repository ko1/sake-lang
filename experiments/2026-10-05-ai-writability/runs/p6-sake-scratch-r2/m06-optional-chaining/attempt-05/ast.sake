# The syntax tree (SPEC section 3).
#
# Every node is a Struct type; the evaluator and the static checks dispatch on
# them with case/in. line/col is the position at which the node's runtime
# errors are reported: the operator for an operation, the `(` of a call, the
# `[` of an index or slice, the `.` of a field, the keyword of a statement.
#
# The static checks (checker.sake) fill in the fields declared with
# attr_accessor: the scope slot of each declaration and the place each name
# refers to.

# ---- Expressions ----

class IntLit
  attr_reader value, line, col
end

class StrLit
  attr_reader value, line, col
end

# A string with interpolations: parts are Strings and expression nodes.
class InterpStr
  attr_reader parts, line, col
end

class BoolLit
  attr_reader value, line, col
end

class NilLit
  attr_reader line, col
end

# A use of a name. After the static checks, hops is the number of scopes to
# walk out from the current one and slot the variable's index there; hops is
# -1 for a built-in, whose slot is then its index in Builtins.names.
class NameRef
  attr_reader name, line, col
  attr_accessor hops, slot
end

class ArrayLit
  attr_reader elements, line, col
end

# One `key: value` of a map literal; line/col is where the key starts.
class MapEntry
  attr_reader key, value, line, col
end

class MapLit
  attr_reader entries, line, col
end

# A parameter; default is nil when it has none.
class Param
  attr_reader name, default, line, col
end

# A function: `fn (params) body end`, or the function of a declaration.
# name is "" for an anonymous function. min_args counts the parameters
# without a default.
class FnLit
  attr_reader name, params, min_args, body, line, col
end

# A binary operator: op is "+", "-", "*", "/", "%", "**", "==", "!=", "<",
# "<=", ">", ">=" or "in".
class BinOp
  attr_reader op, left, right, line, col
end

# `and` / `or`: op is "and" or "or".
class LogicOp
  attr_reader op, left, right, line, col
end

class NotOp
  attr_reader operand, line, col
end

class NegOp
  attr_reader operand, line, col
end

class CallExpr
  attr_reader callee, args, line, col
end

class IndexExpr
  attr_reader target, index, line, col
end

# `a[lo:hi]`: lo and hi are nil when left out.
class SliceExpr
  attr_reader target, lo, hi, line, col
end

# `m.name`, which means m["name"].
class FieldExpr
  attr_reader target, name, line, col
end

# `a?.name`, `a?[i]`, `a?[lo:hi]`: nil target skips the rest of the chain.
class OptField
  attr_reader target, name, line, col
end

class OptIndex
  attr_reader target, index, line, col
end

class OptSlice
  attr_reader target, lo, hi, line, col
end

# A chain containing an optional link; inner is its last link.
class OptChain
  attr_reader inner
end

# ---- Statements ----

# A statement list and the scope it runs in. nslots is the number of variable
# slots of that scope (set by the static checks); fns are the function
# declarations of the list, whose closures are created when it starts running.
class Block
  attr_reader stmts, fns
  attr_accessor nslots
end

# A name being declared (let, const, fn, for, catch, let [...]).
class Binder
  attr_reader name, line, col
  attr_accessor slot
end

class ExprStmt
  attr_reader expr
end

# `let x [= value]`: value is nil when left out.
class LetStmt
  attr_reader binder, value
end

# `let [a, b] = value`; line/col is the `[`.
class LetArrayStmt
  attr_reader binders, value, line, col
end

class ConstStmt
  attr_reader binder, value
end

class FnStmt
  attr_reader binder, fn
end

# `if c1 then b1 elif c2 then b2 ... else e end`: else_block is nil when left out.
class IfStmt
  attr_reader conds, blocks, else_block
end

class WhenArm
  attr_reader values, block
end

# line/col is the `match` keyword, where comparison errors are reported.
class MatchStmt
  attr_reader subject, arms, else_block, line, col
end

class WhileStmt
  attr_reader cond, body
end

# `for a [, b] in iter do body end`: binders has one or two names.
class ForStmt
  attr_reader binders, iter, body, line, col
end

class BreakStmt
  attr_reader line, col
end

class ContinueStmt
  attr_reader line, col
end

# value is nil for a bare `return`.
class ReturnStmt
  attr_reader value, line, col
end

class ThrowStmt
  attr_reader value, line, col
end

# message is nil when left out.
class AssertStmt
  attr_reader cond, message, line, col
end

# catch_binder and catch_block are both nil, or both set; so is finally_block.
class TryStmt
  attr_reader body, catch_binder, catch_block, finally_block
end

# `t1, t2 = v1, v2` or `t op= v`: op is "=", "+=", "-=", "*=", "/=" or "%=";
# line/col is the operator.
class AssignStmt
  attr_reader targets, op, values, line, col
end
