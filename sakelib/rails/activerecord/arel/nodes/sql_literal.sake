# Port of activerecord-8.1.3/lib/arel/nodes/sql_literal.rb (partial: no encode_with)
#
# Ruby's SqlLiteral < String is a String that is also a node. Sake cannot extend String, so a SqlLiteral holds
# its String (`string`), and `to_s` gives it back.

module Arel
  module Nodes
    class SqlLiteral
      attr_reader string, retryable
      include Arel::Expressions
      include Arel::Predications
      include Arel::AliasPredication
      include Arel::OrderPredications
      include Arithmetic
      def initialize(o) = @retryable ||= false
      def to_s(o) = @string
      def inspect(o) = Kernel.inspect(@string)
      def empty?(o) = String.empty?(@string)
      def +(o, other)
        raise ArgumentError, "Expected Arel node" unless Arel.arel_node?(other)
        Fragments.new(Any[o, other])
      end
    end
  end
end
