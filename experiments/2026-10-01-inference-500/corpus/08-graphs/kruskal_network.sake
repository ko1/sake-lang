UnionFind = Struct.new(:parent, :rank, :sets)
Edge = Struct.new(:a, :b, :cost)

class UnionFind
  def create(n) = UnionFind.new(Range.to_a(0...n), Range.map(0...n) { 0 }, n)

  def find(uf, x)
    root = x
    root = @parent[root] while @parent[root] != root
    while @parent[x] != root
      nxt = @parent[x]
      @parent[x] = root
      x = nxt
    end
    root
  end

  def union(uf, a, b)
    ra = find(uf, a)
    rb = find(uf, b)
    return false if ra == rb
    if @rank[ra] < @rank[rb]
      ra, rb = rb, ra
    end
    @parent[rb] = ra
    @rank[ra] += 1 if @rank[ra] == @rank[rb]
    @sets -= 1
    true
  end
end

class Edge
  include Comparable
  def <=>(e, other)
    c = @cost <=> Edge.get_cost(other)
    return c if c != 0
    "#{@a}-#{@b}" <=> "#{Edge.get_a(other)}-#{Edge.get_b(other)}"
  end
  def to_s(e) = "#{@a}-#{@b} (#{@cost})"
end

def kruskal(names, edges)
  index = Hash[]
  Array.each_with_index(names) { |n, i| index[n] = i }
  uf = UnionFind.create(Array.size(names))
  chosen = Array[]
  rejected = 0
  Array.each(Array.sort(edges)) do |e|
    if UnionFind.union(uf, index[Edge.get_a(e)], index[Edge.get_b(e)])
      Array.push(chosen, e)
    else
      rejected += 1
    end
  end
  {tree: chosen, rejected: rejected, parts: UnionFind.get_sets(uf)}
end

def parse_edges(text)
  edges = Edge[]
  Array.each(String.lines(text)) do |line|
    m = String.match(line, /^\s*(\w+)\s*-\s*(\w+)\s*:\s*(\d+)/)
    next unless m
    Array.push(edges, Edge.new(m[1], m[2], String.to_i(m[3])))
  end
  edges
end

def summarize(title, names, text)
  puts("== #{title}")
  edges = parse_edges(text)
  result = kruskal(names, edges)
  result => {tree:, rejected:, parts:}
  Array.each(tree) { |e| puts("  #{e}") }
  total = Array.sum(Array.map(tree) { |e| Edge.get_cost(e) })
  all = Array.sum(Array.map(edges) { |e| Edge.get_cost(e) })
  puts("  cable: #{total} of #{all} (#{rejected} links skipped)")
  if parts > 1
    puts("  WARNING: network splits into #{parts} parts")
  end
  cheapest = Array.min(edges)
  priciest = Array.max(tree)
  puts("  cheapest link: #{cheapest}") if cheapest
  puts("  priciest used: #{priciest}") if priciest
end

office = Array["hq", "lab", "dock", "shop", "mill", "farm", "port"]
office_links = "hq - lab : 7\n" \
               "hq - dock : 5\n" \
               "lab - dock : 8\n" \
               "lab - shop : 9\n" \
               "lab - mill : 7\n" \
               "dock - shop : 15\n" \
               "dock - farm : 6\n" \
               "shop - farm : 8\n" \
               "shop - mill : 5\n" \
               "farm - mill : 9\n" \
               "farm - port : 11\n" \
               "mill - port : 9\n" \
               "# a comment line\n"
summarize("office campus", office, office_links)

islands = Array["a", "b", "c", "d", "e"]
island_links = "a - b : 3\nb - c : 1\na - c : 2\nd - e : 4\n"
summarize("two islands", islands, island_links)
