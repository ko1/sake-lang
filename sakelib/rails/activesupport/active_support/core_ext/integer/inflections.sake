# Port of activesupport-8.1.3/lib/active_support/core_ext/integer/inflections.rb and integer/multiple.rb (two small files)

require "../../inflector/methods"

class Integer
  def ordinalize(n) = ActiveSupport::Inflector.ordinalize(n)
  def ordinal(n) = ActiveSupport::Inflector.ordinal(n)
  def multiple_of?(n, number) = number == 0 ? n == 0 : n % number == 0
end
