require "bigdecimal"

def d(x) = BigDecimal.parse(x)
def s(x) = BigDecimal.to_s(x)
def f(x) = BigDecimal.format(x, "F")
def show(label, *xs) = puts("#{label}: #{Array.join(Array.map(xs) { |x| s(x) }, " ")}")

# parsing and to_s (Ruby's "0.123e1" form)
show("parse", d("1.23"), d("-0"), d("0"), d("100"), d("0.001"), d("1e3"), d("  1.5  "), d("1_000.5"), d(".5"), d("5."), d("+.5"), d("1E+3"), d("1e-3"), d("0.0e5"), d("00012.3400"), d("12_"), d("1e1_0"), d("1d3"), d("-1.5e+2"))
show("special", d("Infinity"), d("-Infinity"), d("+Infinity"), d("NaN"), BigDecimal.NAN, BigDecimal.INFINITY, -BigDecimal.INFINITY)
Array.each(String["abc", "", "1.2.3", "1e", "1x", "1 2", "1__2", "_12", "+-1", "0x10", "1,5", "Inf", "nan", "  ", "-", "."]) do |x|
  begin
    d(x)
    puts("parsed #{Kernel.inspect(x)}")
  rescue ArgumentError => e
    puts("ArgumentError: #{Exception.message(e)}")
  end
end
show("from_i", BigDecimal.from_i(12), BigDecimal.from_i(-0), BigDecimal.from_i(10 ** 30), BigDecimal.from_i(-7))
show("from_f", BigDecimal.from_f(1.5), BigDecimal.from_f(0.1), BigDecimal.from_f(1.0 / 3, 5), BigDecimal.from_f(1.0 / 3), BigDecimal.from_f(1e20), BigDecimal.from_f(Float.NAN), BigDecimal.from_f(-Float.INFINITY), BigDecimal.from_f(-0.0))
show("from_r", BigDecimal.from_r(1r / 3, 10), BigDecimal.from_r(3r / 2, 5), BigDecimal.from_r(-2r / 3, 4))
begin
  BigDecimal.from_f(1.0 / 3, 20)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end
show("from_r0", BigDecimal.from_r(1r / 3, 0), BigDecimal.from_r(123456789r / 7, 0), BigDecimal.from_r(1r / 2))

# plain form and the format string
puts(f(d("1.23")), f(d("100")), f(d("0.001")), f(d("0")), f(d("-0")), f(d("-12.5")), f(d("1e20")), f(d("1e-20")), f(d("NaN")), f(d("-Infinity")))
puts(BigDecimal.format(d("1.23"), "+"), BigDecimal.format(d("-1.23"), "+"), BigDecimal.format(d("1.23"), " F"), BigDecimal.format(d("1234.5678"), "3F"), BigDecimal.format(d("1234.5678"), 3), BigDecimal.format(d("12345678.123456789"), "3F"), BigDecimal.format(d("-12345678.123456789"), "+3F"), BigDecimal.format(d("12345678.123456789"), 3), BigDecimal.format(d("1.23"), "E"), BigDecimal.format(d("1.23"), "f"), BigDecimal.format(d("0"), "+"), BigDecimal.format(d("NaN"), "+"), BigDecimal.format(d("Infinity"), "+F"), BigDecimal.format(d("1.23"), "5F"))
p(d("1.5"))
puts("#{d("2.5")} and #{Kernel.inspect(d("-0.25"))}")
p(Array[d("1"), d("2.5")])

# exact arithmetic, with Integers and Floats
show("add", d("1.5") + d("2.25"), d("1.5") + 1, d("0.1") + d("0.2"), d("1e20") + 1, d("1.5") - d("1.5"), d("-1.5") + d("1.5"), d("1.5") + 0.1, d("1.5") - 1.5)
show("sub", d("1.5") - d("2.25"), d("10") - 3, d("0") - d("0.001"))
show("mul", d("1.5") * d("2.25"), d("1.5") * 2, d("0") * -1, d("1.5") * 0, d("-1.5") * 0, d("1.5") * 0.1, d("123456789") * d("987654321"), d("1e-10") * d("1e-10"))
show("neg", -d("1.5"), -d("0"), +d("1.5"), BigDecimal.abs(d("-1.5")), BigDecimal.abs(d("-Infinity")), BigDecimal.abs(d("NaN")))
show("prec", BigDecimal.add(d("1.5"), d("2.25"), 2), BigDecimal.sub(d("1.5"), d("2.25"), 2), BigDecimal.mult(d("1.5"), d("2.25"), 2), BigDecimal.add(d("1.5"), 1, 0), BigDecimal.add(d("123.456"), 0, 2), BigDecimal.mult(d("123.456"), 1, 4), BigDecimal.add(d("125"), 0, 2))

# NaN and Infinity propagate
show("nan", d("NaN") + 1, d("Infinity") + 1, d("Infinity") - d("Infinity"), d("Infinity") * 0, d("Infinity") * -2, d("1") / d("Infinity"), d("Infinity") / 2, d("Infinity") / d("Infinity"), d("NaN") + d("NaN"), d("-Infinity") + d("-Infinity"), d("1") - d("Infinity"), d("NaN") * d("Infinity"))

# division: Ruby's default precision, and div with digits
show("div", d("1") / d("3"), d("2") / d("3"), d("1") / d("7"), d("10") / d("3"), d("1000") / d("3"), d("1.5") / d("7"), d("1") / d("300"), d("1.23456789") / d("3"), d("123456789012345678") / d("7"), d("22") / d("7"), d("1") / d("-3"), d("-1") / d("3"), d("0.1") / d("3"), d("1") / d("0.3"), d("1") / d("3e10"), d("1e10") / d("3"), d("1") / d("7e-5"), d("7") / d("11"), d("1") / 3, d("1") / 3.0, d("1") / 0, d("-1") / 0, d("0") / 0, d("1") / d("-0"), d("0") / 3, d("3") / 8)
show("divn", BigDecimal.div(d("1"), 3, 5), BigDecimal.div(d("1"), 3, 0), BigDecimal.div(d("2"), 3, 20), BigDecimal.div(d("2"), 3, 1), BigDecimal.div(d("200"), 3, 2), BigDecimal.div(d("1"), 0, 5), BigDecimal.div(d("0"), 0, 5), BigDecimal.div(d("3"), d("0.7"), 3), BigDecimal.quo(d("1.5"), 3), BigDecimal.quo(d("1.5"), 3, 2), BigDecimal.div(d("1"), d("7"), 40))
p([BigDecimal.idiv(d("1"), 3), BigDecimal.idiv(d("7"), 2), BigDecimal.idiv(d("-7"), 2), BigDecimal.idiv(d("7.5"), d("0.7"))])
begin
  BigDecimal.idiv(d("1"), 0)
rescue ZeroDivisionError => e
  puts("ZeroDivisionError: #{Exception.message(e)}")
end

# modulo, divmod, remainder
show("mod", d("7") % 3, d("-7") % 3, d("7.5") % 2, d("7") % d("2.5"), BigDecimal.modulo(d("7"), -3), BigDecimal.remainder(d("7"), 3), BigDecimal.remainder(d("-7"), 3), BigDecimal.remainder(d("7.5"), 2), d("Infinity") % 2, d("7") % d("Infinity"), d("NaN") % 2)
p(Array.map(Tuple.to_a(BigDecimal.divmod(d("7"), 3))) { |x| Kernel.to_s(x) })
p(Array.map(Tuple.to_a(BigDecimal.divmod(d("-7"), 3))) { |x| Kernel.to_s(x) })
p(Array.map(Tuple.to_a(BigDecimal.divmod(d("7.5"), 2))) { |x| Kernel.to_s(x) })
p(Array.map(Tuple.to_a(BigDecimal.divmod(d("7.5"), d("0.7")))) { |x| Kernel.to_s(x) })
begin
  d("7") % 0
rescue ZeroDivisionError => e
  puts("ZeroDivisionError: #{Exception.message(e)}")
end
begin
  BigDecimal.divmod(d("Infinity"), 2)
rescue FloatDomainError => e
  puts("FloatDomainError: #{Exception.message(e)}")
end

# powers
show("pow", d("1.5") ** 2, d("1.5") ** 0, d("2") ** -2, d("3") ** -1, d("1.5") ** 10, BigDecimal.power(d("2"), 3), d("0") ** 0, d("0") ** -1, d("-2") ** 3, d("-2") ** -3, d("0") ** 2, d("-0") ** -1, d("3") ** -2, d("1.1") ** -3, d("1.1") ** 20, BigDecimal.power(d("1.1"), 20, 5), BigDecimal.power(d("2"), -1, 5), BigDecimal.power(d("2"), 10, 3), d("Infinity") ** 2, d("Infinity") ** -2, d("NaN") ** 2, d("-Infinity") ** 3, d("-Infinity") ** 2)
p(String.length(s(d("1.5") ** 100)))

# sqrt
show("sqrt", BigDecimal.sqrt(d("2"), 10), BigDecimal.sqrt(d("2"), 1), BigDecimal.sqrt(d("2"), 20), BigDecimal.sqrt(d("4"), 10), BigDecimal.sqrt(d("0.25"), 5), BigDecimal.sqrt(d("100"), 5), BigDecimal.sqrt(d("2"), 0), BigDecimal.sqrt(d("0"), 5), BigDecimal.sqrt(d("3"), 30), BigDecimal.sqrt(d("1e10"), 5), BigDecimal.sqrt(d("Infinity"), 5), BigDecimal.sqrt(d("1.44"), 3), BigDecimal.sqrt(d("1.5"), 2), BigDecimal.sqrt(d("0.0001"), 3), BigDecimal.sqrt(d("123456789"), 12))
Array.each(String["-1", "NaN", "-Infinity"]) do |x|
  begin
    BigDecimal.sqrt(d(x), 5)
  rescue FloatDomainError => e
    puts("FloatDomainError: #{Exception.message(e)}")
  end
end
begin
  BigDecimal.sqrt(d("2"), -1)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end

# rounding: round(n, mode), floor, ceil, truncate, fix, frac
show("round", BigDecimal.round(d("1.5")), BigDecimal.round(d("2.5")), BigDecimal.round(d("-2.5")), BigDecimal.round(d("1.25"), 1), BigDecimal.round(d("1.35"), 1), BigDecimal.round(d("1.25"), 1, :half_even), BigDecimal.round(d("1.35"), 1, :half_even), BigDecimal.round(d("1.25"), 1, :half_down), BigDecimal.round(d("1.21"), 1, :up), BigDecimal.round(d("1.29"), 1, :down), BigDecimal.round(d("-1.21"), 1, :ceiling), BigDecimal.round(d("-1.21"), 1, :floor), BigDecimal.round(d("1.21"), 1, :truncate), BigDecimal.round(d("1.25"), 1, :banker), BigDecimal.round(d("1.25"), 1, :half_up), BigDecimal.round(d("1.25"), 1, :default), BigDecimal.round(d("-1.21"), 1, :ceil), BigDecimal.round(d("1234.5"), -2), BigDecimal.round(d("1234.5"), 0), BigDecimal.round(d("NaN"), 1), BigDecimal.round(d("1.23"), 5), BigDecimal.round(d("0.0049"), 2), BigDecimal.round(d("-0.0049"), 2), BigDecimal.round(d("99.99"), 1), BigDecimal.round(d("0.5")), BigDecimal.round(d("-0.5")), BigDecimal.round(d("0.5"), 0, :half_even), BigDecimal.round(d("1.5"), 0, :half_even))
p([BigDecimal.to_i(BigDecimal.round(d("1.5"))), BigDecimal.to_i(BigDecimal.round(d("-2.5"))), BigDecimal.to_i(BigDecimal.round(d("1234.5"), -2))])
show("floor", BigDecimal.floor(d("1.5")), BigDecimal.floor(d("-1.5")), BigDecimal.ceil(d("1.5")), BigDecimal.ceil(d("-1.5")), BigDecimal.floor(d("1.55"), 1), BigDecimal.ceil(d("1.55"), 1), BigDecimal.truncate(d("-1.55"), 1), BigDecimal.truncate(d("-1.55")), BigDecimal.truncate(d("15.5"), -1), BigDecimal.floor(d("15.5"), -1), BigDecimal.ceil(d("15.5"), -1), BigDecimal.fix(d("1.5")), BigDecimal.frac(d("1.5")), BigDecimal.frac(d("-1.5")), BigDecimal.frac(d("15")), BigDecimal.fix(d("-0.5")), BigDecimal.floor(d("Infinity"), 1), BigDecimal.frac(d("NaN")))
begin
  BigDecimal.round(d("1.25"), 1, :bogus)
rescue ArgumentError => e
  puts("ArgumentError: #{Exception.message(e)}")
end

# conversions
p([BigDecimal.to_i(d("1.5")), BigDecimal.to_i(d("-1.5")), BigDecimal.to_i(d("1e30")), BigDecimal.to_i(d("0.001")), BigDecimal.to_int(d("99.9")), BigDecimal.to_i(d("-0"))])
p([BigDecimal.to_f(d("1.5")), BigDecimal.to_f(d("1e400")), BigDecimal.to_f(d("-1e400")), BigDecimal.to_f(d("1e-400")), BigDecimal.to_f(d("0.1")), BigDecimal.to_f(d("Infinity")), BigDecimal.to_f(d("-0")), BigDecimal.to_f(d("123456789.125"))])
p(Float.nan?(BigDecimal.to_f(d("NaN"))))
p([BigDecimal.to_r(d("1.5")), BigDecimal.to_r(d("0.001")), BigDecimal.to_r(d("100")), BigDecimal.to_r(d("-0.25")), BigDecimal.to_r(d("0"))])
Array.each(String["NaN", "Infinity", "-Infinity"]) do |x|
  begin
    BigDecimal.to_i(d(x))
  rescue FloatDomainError => e
    puts("FloatDomainError: #{Exception.message(e)}")
  end
  begin
    BigDecimal.to_r(d(x))
  rescue FloatDomainError => e
    puts("FloatDomainError: #{Exception.message(e)}")
  end
end
puts(s(BigDecimal.to_d(d("1.5"))))

# parts: precision, scale, exponent, sign, n_significant_digits
Array.each(String["1.23", "100", "0.001", "1e10", "0", "-0", "NaN", "Infinity", "-12.340", "0.1", "123.456", "-Infinity", "2"]) do |x|
  v = d(x)
  puts("#{x}: precision=#{BigDecimal.precision(v)} scale=#{BigDecimal.scale(v)} exponent=#{BigDecimal.exponent(v)} sign=#{BigDecimal.sign(v)} nsd=#{BigDecimal.n_significant_digits(v)} ps=#{Kernel.inspect(BigDecimal.precision_scale(v))}")
end
p(BigDecimal.double_fig)

# predicates
Array.each(String["1", "0", "-0", "NaN", "Infinity", "-Infinity", "-2"]) do |x|
  v = d(x)
  puts("#{x}: zero?=#{BigDecimal.zero?(v)} nan?=#{BigDecimal.nan?(v)} infinite?=#{Kernel.inspect(BigDecimal.infinite?(v))} finite?=#{BigDecimal.finite?(v)} nonzero?=#{Kernel.inspect(BigDecimal.nonzero?(v))} negative?=#{BigDecimal.negative?(v)} positive?=#{BigDecimal.positive?(v)}")
end

# comparison, with BigDecimal, Integer, Float, Rational, and NaN
p([d("1.5") <=> d("1.50"), d("1.5") == d("1.50"), d("1.5") <=> 2, d("1.5") <=> 1.5, d("NaN") <=> 1, d("NaN") == d("NaN"), d("Infinity") > 10 ** 100, d("1.5") < d("NaN"), d("0") == d("-0"), d("0") <=> d("-0"), d("1.5") == 1.5, d("1") == 1, d("1.5") <=> 3r / 2])
p([d("NaN") < 1, d("NaN") <= d("NaN"), d("Infinity") <=> d("Infinity"), d("-Infinity") < d("Infinity"), d("Infinity") == Float.INFINITY, d("1.5") != 2, d("1.5") != d("1.50"), d("2") >= d("2"), d("2") > d("2"), d("-3") <= d("-2.9"), d("1.5") <=> d("-Infinity"), d("0.1") == 0.1, d("1.5") == "1.5", d("1.5") <=> "1.5"])
p(Array.map(Array.sort(Array[d("3"), d("1.5"), d("-2"), d("-Infinity"), d("0")])) { |x| s(x) })
mx = Array.max(Array[d("3"), d("1.5")])
p(s(mx)) if mx != nil
p(Array.include?(Array[d("1.5"), d("2")], d("2.0")))

# a computation: compound interest to the cent
balance = d("1000.00")
rate = d("0.05")
Integer.times(10) { balance = BigDecimal.round(balance * (rate + 1), 2) }
puts(f(balance))
total = Array.reduce(Array.map(String["19.99", "5.01", "0.10", "0.20"]) { |x| d(x) }, d("0")) { |acc, x| acc + x }
puts(f(total))
