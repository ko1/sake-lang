Search = Struct.new(:n, :solutions, :nodes)

class Search
  def count(n)
    s = Search.new(n, 0, 0)
    place(s, 0, 0, 0, 0)
    s
  end

  # cols / diag1 / diag2 are bitmasks of attacked columns for the current row
  def place(s, row, cols, diag1, diag2)
    @nodes += 1
    if row == @n
      @solutions += 1
      return
    end
    full = (1 << @n) - 1
    free = full & ~(cols | diag1 | diag2)
    while free != 0
      bit = free & -free
      free = free ^ bit
      place(s, row + 1, cols | bit, ((diag1 | bit) << 1) & full, (diag2 | bit) >> 1)
    end
  end
end

def safe?(queens, row, col)
  Array.each_with_index(queens) do |c, r|
    return false if c == col || Integer.abs(c - col) == Integer.abs(r - row)
  end
  true
end

def first_solution(n, queens)
  row = Array.size(queens)
  return Array.dup(queens) if row == n
  Integer.times(n) do |col|
    next unless safe?(queens, row, col)
    Array.push(queens, col)
    found = first_solution(n, queens)
    return found if found
    Array.pop(queens)
  end
  nil
end

def board(queens)
  n = Array.size(queens)
  Array.map(queens) { |col| Array.join(Range.map(0...n) { |c| c == col ? "Q" : "." }, " ") }
end

def symmetric?(queens)
  n = Array.size(queens)
  mirrored = Array.map(queens) { |c| n - 1 - c }
  mirrored == Array.reverse(queens)
end

puts(" n  solutions   nodes")
totals = Hash[]
Range.each(1..8) do |n|
  s = Search.count(n)
  totals[n] = Search.solutions(s)
  puts(format("%2d %10d %7d", n, Search.solutions(s), Search.nodes(s)))
end

best = Hash.max_by(totals) { |n, count| count }
if best
  n, count = best
  puts("most solutions: n=#{n} (#{count})")
end
puts("unsolvable sizes: #{Array.join(Hash.keys(Hash.select(totals) { |n, count| count == 0 }), ", ")}")

Array.each(Array[3, 5, 6, 8]) do |n|
  q = first_solution(n, Integer[])
  if q
    puts("first solution for n=#{n}: #{Array.join(q, " ")}#{symmetric?(q) ? " (point-symmetric)" : ""}")
    Array.each(board(q)) { |line| puts("  #{line}") }
  else
    puts("first solution for n=#{n}: none")
  end
end
