# Port of activemodel-8.1.3/lib/active_model/type/float.rb

module ActiveModel
  module Type
    class Float
      attr_reader precision, scale, limit
      include Value
      include Helpers::Immutable
      include Helpers::Numeric

      def initialize(t) = nil

      def type(t) = :float

      def type_cast_for_schema(t, value)
        return "::Float::NAN" if (value in ::Float) && ::Float.nan?(value)
        return "::Float::INFINITY" if (value in ::Float) && value == ::Float.INFINITY
        return "-::Float::INFINITY" if (value in ::Float) && value == -::Float.INFINITY
        Kernel.inspect(value)
      end

      def cast_value(t, value)
        case value
        in ::Float then value
        in "Infinity" then ::Float.INFINITY
        in "-Infinity" then -::Float.INFINITY
        in "NaN" then ::Float.NAN
        in ::String then ::String.to_f(value)
        in ::Integer then ::Integer.to_f(value)
        in BigDecimal then BigDecimal.to_f(value)
        in ::Rational then ::Rational.to_f(value)
        in true then 1.0
        in false then 0.0
        else 0.0
        end
      end
    end
  end
end
