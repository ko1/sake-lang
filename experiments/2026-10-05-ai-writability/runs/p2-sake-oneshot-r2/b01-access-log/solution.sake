class Req
  attr_reader ts, ep, status, bytes, dur
end

class Ep
  attr_reader count, n4, n5, bytes, sum, max
  def add(e, status, bytes, dur)
    @count += 1
    @n4 += 1 if status >= 400 && status <= 499
    @n5 += 1 if status >= 500 && status <= 599
    @bytes += bytes
    @sum += dur
    @max = dur if dur > @max
    e
  end
end

def digits?(s) = String.match?(s, /\A\d+\z/)

def valid_ts?(s)
  m = String.match(s, /\A(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)\z/)
  return false unless m
  y, mo, d, h, mi, se = MatchData.captures(m)
  mo = String.to_i(mo)
  d = String.to_i(d)
  h = String.to_i(h)
  mi = String.to_i(mi)
  se = String.to_i(se)
  mo >= 1 && mo <= 12 && d >= 1 && d <= 31 && h <= 23 && mi <= 59 && se <= 59
end

def parse(line)
  f = String.split(line, " ")
  return "wrong field count" if Array.size(f) != 6
  return "bad timestamp" unless valid_ts?(f[0])
  return "bad method" unless Array.include?(Array["GET", "POST", "PUT", "DELETE"], f[1])
  return "bad path" unless String.start_with?(f[2], "/")
  return "bad status" unless String.match?(f[3], /\A\d{3}\z/)
  st = String.to_i(f[3])
  return "bad status" if st < 100 || st > 599
  return "bad bytes" unless f[4] == "-" || digits?(f[4])
  return "bad duration" unless digits?(f[5])
  path = f[2]
  i = String.index(path, "?")
  base = i ? path[0, i] : path
  bytes = f[4] == "-" ? 0 : String.to_i(f[4])
  Req.new(f[0], "#{f[1]} #{base}", st, bytes, String.to_i(f[5]))
end

lines = IO.readlines(IO.stdin)
eps = Hash[]
hours = Hash.new(0)
invalid = Array[]
valid = 0
n = 0
Array.each(lines) do |raw|
  n += 1
  line = String.chomp(raw)
  next if String.empty?(String.strip(line))
  r = parse(line)
  if r in String
    Array.push(invalid, "  line #{n}: #{r}")
  else
    valid += 1
    key = Req.ep(r)
    e = eps[key]
    unless e
      e = Ep.new(0, 0, 0, 0, 0, 0)
      eps[key] = e
    end
    Ep.add(e, Req.status(r), Req.bytes(r), Req.dur(r))
    ts = Req.ts(r)
    hours[ts[0, 13]] += 1
  end
end

if valid == 0
  puts("no valid requests")
else
  keys = Hash.keys(eps)
  w = Array.max(Array.map(keys) { |k| String.size(k) })
  w = 8 if w < 8
  puts(format("%s %5s %4s %4s %8s %7s %6s", String.ljust("endpoint", w), "count", "4xx", "5xx", "bytes", "avg_ms", "max_ms"))
  sorted = Array.sort_by(keys) { |k| [-Ep.count(eps[k]), k] }
  Array.each(sorted) do |k|
    e = eps[k]
    c = Ep.count(e)
    tenths = (20 * Ep.sum(e) + c) / (2 * c)
    avg = "#{tenths / 10}.#{tenths % 10}"
    puts(format("%s %5d %4d %4d %8d %7s %6d", String.ljust(k, w), c, Ep.n4(e), Ep.n5(e), Ep.bytes(e), avg, Ep.max(e)))
  end
  best = nil
  bestc = 0
  Array.each(Array.sort(Hash.keys(hours))) do |hk|
    if hours[hk] > bestc
      bestc = hours[hk]
      best = hk
    end
  end
  puts("busiest hour: #{best[0, 10]} #{best[11, 2]}:00 (#{bestc} requests)")
end
puts("invalid lines: #{Array.size(invalid)}")
Array.each(invalid) { |l| puts(l) }
