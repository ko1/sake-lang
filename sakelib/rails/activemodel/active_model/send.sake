# Port of nothing (Sake only): Ruby's send(name) on a model, which Validations (read_attribute_for_validation),
# Serialization (read_attribute_for_serialization, methods:), Access (slice) and AttributeMethods use.
#
# The generator writes `__send(r, name)`: a `case` over the class's readers (fields, attributes, aliases) and
# the names its declarations read. Any other name goes to `__send_missing(r, name)`, Ruby's method_missing
# for send: it raises as Ruby's NoMethodError does, and a class defines its own to answer more names
# (`def __send_missing(r, name) = name == :full_name ? full_name(r) : super_...`).

module ActiveModel
  module Send
    def __send(r, name) = raise(NotImplementedError)
    def __class_name = raise(NotImplementedError)
    def __send_missing(r, name) = raise(NoMethodError, "undefined method '#{name}' for an instance of #{__class_name}")
  end
end
