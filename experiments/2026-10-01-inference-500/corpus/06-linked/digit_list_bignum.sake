Digit = Struct.new(:d, :next)

class BigNat
  attr_reader low
  include Arithmetic
  include Comparable

  def parse(s)
    low = nil
    String.each_char(s) do |c|
      raise ArgumentError, "not a digit: #{Kernel.inspect(c)}" unless String.match?(c, /\d/)
      low = Digit.new(String.to_i(c), low)
    end
    BigNat.new(trim(low))
  end

  def from_int(n) = parse(Integer.to_s(n))

  def trim(low)
    digits = Array[]
    node = low
    while node
      Array.push(digits, Digit.get_d(node))
      node = Digit.get_next(node)
    end
    while Array.size(digits) > 1 && Array.last(digits) == 0
      Array.pop(digits)
    end
    build(digits)
  end

  def build(digits_low_first)
    head = nil
    Array.reverse_each(digits_low_first) { |d| head = Digit.new(d, head) }
    head
  end

  def +(a, b)
    x = @low
    y = BigNat.get_low(b)
    carry = 0
    out = Array[]
    while x || y || carry > 0
      s = carry
      if x
        s += Digit.get_d(x)
        x = Digit.get_next(x)
      end
      if y
        s += Digit.get_d(y)
        y = Digit.get_next(y)
      end
      Array.push(out, s % 10)
      carry = s / 10
    end
    BigNat.new(build(out))
  end

  def scale(a, k, shift)
    out = Array[]
    Integer.times(shift) { Array.push(out, 0) }
    carry = 0
    x = @low
    while x || carry > 0
      s = carry
      if x
        s += Digit.get_d(x) * k
        x = Digit.get_next(x)
      end
      Array.push(out, s % 10)
      carry = s / 10
    end
    BigNat.new(trim(build(out)))
  end

  def *(a, b)
    total = BigNat.from_int(0)
    shift = 0
    y = BigNat.get_low(b)
    while y
      total = total + scale(a, Digit.get_d(y), shift)
      y = Digit.get_next(y)
      shift += 1
    end
    total
  end

  def length(a)
    n = 0
    x = @low
    while x
      n += 1
      x = Digit.get_next(x)
    end
    n
  end

  def <=>(a, b)
    la = length(a)
    lb = BigNat.length(b)
    return la <=> lb if la != lb
    result = 0
    x = @low
    y = BigNat.get_low(b)
    while x && y
      c = Digit.get_d(x) <=> Digit.get_d(y)
      result = c if c != 0
      x = Digit.get_next(x)
      y = Digit.get_next(y)
    end
    result
  end

  def to_s(a)
    s = ""
    x = @low
    while x
      s = Integer.to_s(Digit.get_d(x)) + s
      x = Digit.get_next(x)
    end
    s
  end
end

def factorial(n)
  acc = BigNat.from_int(1)
  Range.each(2..n) { |k| acc = acc * BigNat.from_int(k) }
  acc
end

a = BigNat.parse("987654321987654321")
b = BigNat.parse("123456789123456789")
puts("a + b = #{a + b}")
puts("a * b = #{a * b}")
puts("check   #{987654321987654321 * 123456789123456789}")
puts("a > b: #{a > b}, b < a: #{b < a}, a == a': #{a == BigNat.parse("000987654321987654321")}")
puts("00042 -> #{BigNat.parse("00042")} (#{BigNat.length(BigNat.parse("00042"))} digits)")
puts("0 * a = #{BigNat.from_int(0) * a}")

f30 = factorial(30)
puts("30! = #{f30}")
puts("matches Integer: #{Kernel.to_s(f30) == Integer.to_s(Range.reduce(1..30, 1) { |p, k| p * k })}")
fib_a = BigNat.from_int(0)
fib_b = BigNat.from_int(1)
Integer.times(99) do
  nxt = fib_a + fib_b
  fib_a = fib_b
  fib_b = nxt
end
puts("fib(100) = #{fib_b}")
digit_sum = Array.sum(Array.map(String.chars(Kernel.to_s(f30))) { String.to_i(it) })
puts("digit sum of 30! = #{digit_sum}")
nums = Array.map(Array["31415926535", "2718281828", "31415926536", "999", "1000"]) { BigNat.parse(it) }
puts("sorted: #{Array.join(Array.map(Array.sort(nums)) { Kernel.to_s(it) }, " ")}")
puts("max: #{Array.max(nums)}")
begin
  BigNat.parse("12a4")
rescue ArgumentError => e
  puts("error: #{Exception.message(e)}")
end
