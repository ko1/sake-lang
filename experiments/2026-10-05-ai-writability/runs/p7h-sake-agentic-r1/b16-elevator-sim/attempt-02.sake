Request = Struct.new(:id, :time, :from_floor, :to_floor)

def parse_int(s)
  if String.match(s, /^\d+$/)
    String.to_i(s)
  else
    nil
  end
end

def main
  header_line = gets
  return if header_line == nil

  header = String.split(String.strip(header_line), " ")
  return unless Array.size(header) == 3

  n = parse_int(Array.at(header, 0))
  d = parse_int(Array.at(header, 1))
  c = parse_int(Array.at(header, 2))

  unless n && d && c && n >= 2 && n <= 50 && d >= 0 && d <= 5 && c >= 1 && c <= 20
    puts("invalid header")
    return
  end

  requests = Array[]
  line_num = 2
  errors = Array[]
  last_time = 0

  while true
    line = gets
    break if line == nil

    line = String.strip(line)
    next if String.empty?(line)

    parts = String.split(line, " ")
    if Array.size(parts) != 3
      Array.push(errors, line_num)
      line_num += 1
      next
    end

    t = parse_int(Array.at(parts, 0))
    f = parse_int(Array.at(parts, 1))
    g = parse_int(Array.at(parts, 2))

    if !t || !f || !g || f < 1 || f > n || g < 1 || g > n || f == g || t > 1000 || t < last_time
      Array.push(errors, line_num)
      line_num += 1
      next
    end

    Array.push(requests, Request.new(Array.size(requests) + 1, t, f, g))
    last_time = t
    line_num += 1
  end

  Array.each(errors) { |ln| puts("line #{ln}: invalid request") }

  if Array.empty?(requests)
    puts("no passengers")
    return
  end

  simulate(n, d, c, requests)
end

def simulate(n, d, c, requests)
  floor = 1
  time = 0
  direction = :idle
  riders = Array[]
  waiting = Array[]
  Integer.times(n + 1) { |i| Array.push(waiting, Array[]) }

  pickups = Array[]
  dropoffs = Array[]

  pickup_times = Hash[]
  dropoff_times = Hash[]
  Array.each(requests) { |r| pickup_times[Request.id(r)] = nil; dropoff_times[Request.id(r)] = nil }

  req_idx = 0

  loop do
    # Add waiting requests
    while req_idx < Array.size(requests)
      req = Array.at(requests, req_idx)
      break if Request.time(req) > time
      Array.push(Array.at(waiting, Request.from_floor(req)), Request.id(req))
      req_idx += 1
    end

    # Check if done
    if Array.empty?(riders) && req_idx >= Array.size(requests)
      all_empty = true
      Integer.times(n + 1) do |f|
        all_empty = false if !Array.empty?(Array.at(waiting, f))
      end
      break if all_empty
    end

    # Drop off riders at current floor
    riders_before = Array.size(riders)
    riders_filtered = Array[]
    Array.each(riders) do |pid|
      # Find corresponding request
      found_dest = nil
      Array.each(requests) { |r| found_dest = Request.to_floor(r) if Request.id(r) == pid }

      if found_dest == floor
        Hash.[]=(dropoff_times, pid, time)
        Array.push(dropoffs, pid)
      else
        Array.push(riders_filtered, pid)
      end
    end
    riders = riders_filtered

    # Determine direction
    targets = Set[]
    Array.each(riders) do |pid|
      Array.each(requests) do |r|
        if Request.id(r) == pid
          Set.add(targets, Request.to_floor(r))
        end
      end
    end

    Integer.times(n + 1) do |f|
      if !Array.empty?(Array.at(waiting, f))
        Set.add(targets, f)
      end
    end

    case direction
    in :up
      has_above = false
      has_below = false
      Set.each(targets) do |f|
        has_above = true if f > floor
        has_below = true if f < floor
      end
      if has_above
        direction = :up
      elsif has_below
        direction = :down
      else
        direction = :idle
      end
    in :down
      has_above = false
      has_below = false
      Set.each(targets) do |f|
        has_above = true if f > floor
        has_below = true if f < floor
      end
      if has_below
        direction = :down
      elsif has_above
        direction = :up
      else
        direction = :idle
      end
    in :idle
      if !Set.empty?(targets)
        # Find nearest
        nearest = nil
        min_dist = nil
        Set.each(targets) do |f|
          dist = Arithmetic.abs(f - floor)
          if min_dist == nil || dist < min_dist || (dist == min_dist && (nearest == nil || f < nearest))
            nearest = f
            min_dist = dist
          end
        end

        if nearest == floor
          lowest = nil
          Array.each(Array.at(waiting, floor)) do |pid|
            if lowest == nil || pid < lowest
              lowest = pid
            end
          end
          if lowest
            dest = nil
            Array.each(requests) { |r| dest = Request.to_floor(r) if Request.id(r) == lowest }
            direction = dest > floor ? :up : :down
          end
        else
          direction = nearest > floor ? :up : :down
        end
      end
    end

    # Pick up riders at current floor
    picked_up = 0
    waiting_at_floor = Array.at(waiting, floor)
    waiting_sorted = Array.sort(waiting_at_floor)
    waiting_new = Array[]

    Array.each(waiting_sorted) do |pid|
      if picked_up < c
        dest = nil
        Array.each(requests) { |r| dest = Request.to_floor(r) if Request.id(r) == pid }
        passenger_dir = dest > floor ? :up : :down

        if direction == passenger_dir || direction == :idle
          Array.push(riders, pid)
          Hash.[]=(pickup_times, pid, time)
          Array.push(pickups, pid)
          picked_up += 1
        else
          Array.push(waiting_new, pid)
        end
      else
        Array.push(waiting_new, pid)
      end
    end
    Array.[]=(waiting, floor, waiting_new)

    # Advance time
    someone_moved = riders_before != Array.size(riders) || Array.size(riders) < Array.size(riders_filtered) + 1

    if picked_up > 0 || riders_before > Array.size(riders)
      time += d
    else
      case direction
      in :idle
        # Stay
      in :up
        floor += 1
      in :down
        floor -= 1
      end
      time += 1
    end
  end

  # Output events in order
  events = Array[]
  Array.each(dropoffs) do |pid|
    t = Hash[](dropoff_times, pid)
    Array.each(requests) do |r|
      if Request.id(r) == pid
        Array.push(events, [0, t, Request.from_floor(r), pid])
      end
    end
  end

  Array.each(pickups) do |pid|
    t = Hash[](pickup_times, pid)
    Array.each(requests) do |r|
      if Request.id(r) == pid
        Array.push(events, [1, t, Request.from_floor(r), pid])
      end
    end
  end

  # We need to output in time order
  events_all = Array[]
  Array.each(pickups) do |pid|
    Array.each(requests) do |r|
      if Request.id(r) == pid
        Array.push(events_all, [:pick, Hash[](pickup_times, pid), Request.from_floor(r), pid])
      end
    end
  end

  Array.each(dropoffs) do |pid|
    Array.each(requests) do |r|
      if Request.id(r) == pid
        Array.push(events_all, [:drop, Hash[](dropoff_times, pid), Request.from_floor(r), pid])
      end
    end
  end

  # Sort by time, then by type (drop before pick)
  events_sorted = Array.sort_by(events_all) { |e| [Array.at(e, 1), Array.at(e, 0) == :drop ? 0 : 1] }

  Array.each(events_sorted) do |e|
    type = Array.at(e, 0)
    t = Array.at(e, 1)
    f = Array.at(e, 2)
    pid = Array.at(e, 3)
    if type == :drop
      puts("t=#{t} floor #{f} drop P#{pid}")
    else
      puts("t=#{t} floor #{f} pick P#{pid}")
    end
  end

  # Output summary
  total_wait = 0
  total_ride = 0
  Array.each(requests) do |r|
    pid = Request.id(r)
    req_time = Request.time(r)
    pick_time = Hash[](pickup_times, pid)
    drop_time = Hash[](dropoff_times, pid)
    wait = pick_time - req_time
    ride = drop_time - pick_time
    total_wait += wait
    total_ride += ride
    puts("P#{pid} wait #{wait} ride #{ride}")
  end

  avg_wait = Float(total_wait) / Array.size(requests)
  avg_ride = Float(total_ride) / Array.size(requests)
  puts(format("average wait %.2f ride %.2f", avg_wait, avg_ride))

  last_drop = nil
  Array.each(events_sorted) do |e|
    if Array.at(e, 0) == :drop
      last_drop = Array.at(e, 1)
    end
  end
  puts("done at t=#{last_drop}")
end

main
