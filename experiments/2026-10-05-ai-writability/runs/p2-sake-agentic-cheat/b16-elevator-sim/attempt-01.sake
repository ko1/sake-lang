def digits?(tok) = String.match?(tok, /\A\d+\z/)

def toks(line) = String.split(String.strip(line), " ")

def all_digits?(ts) = Array.all?(ts) { |x| digits?(x) }

def sign(a, b) = a < b ? 1 : -1

def main
  lines = IO.readlines(IO.stdin)
  if Array.empty?(lines)
    puts("invalid header")
    return
  end
  h = toks(lines[0])
  ok = Array.size(h) == 3 && all_digits?(h)
  if ok
    nf = String.to_i(h[0])
    dt = String.to_i(h[1])
    cap = String.to_i(h[2])
    ok = nf >= 2 && nf <= 50 && dt >= 0 && dt <= 5 && cap >= 1 && cap <= 20
  end
  unless ok
    puts("invalid header")
    return
  end
  ts = Integer[]
  fs = Integer[]
  gs = Integer[]
  lastt = 0
  k = 1
  while k < Array.size(lines)
    line = lines[k]
    lineno = k + 1
    k += 1
    next if String.strip(line) == ""
    r = toks(line)
    good = Array.size(r) == 3 && all_digits?(r)
    if good
      t = String.to_i(r[0])
      f = String.to_i(r[1])
      g = String.to_i(r[2])
      good = f >= 1 && f <= nf && g >= 1 && g <= nf && f != g && t <= 1000 && t >= lastt
      if good
        Array.push(ts, t)
        Array.push(fs, f)
        Array.push(gs, g)
        lastt = t
      end
    end
    puts("line #{lineno}: invalid request") unless good
  end
  n = Array.size(ts)
  if n == 0
    puts("no passengers")
    return
  end
  state = Array.new(n, 0)
  pickt = Array.new(n, 0)
  dropt = Array.new(n, 0)
  dropped = 0
  f = 1
  t = 0
  dir = 0
  lastdrop = 0
  while dropped < n
    n.times { |i| state[i] = 1 if state[i] == 0 && ts[i] <= t }
    changed = false
    n.times do |i|
      if state[i] == 2 && gs[i] == f
        puts("t=#{t} floor #{f} drop P#{i + 1}")
        state[i] = 3
        dropt[i] = t
        dropped += 1
        changed = true
        lastdrop = t
      end
    end
    break if dropped == n
    above = false
    below = false
    n.times do |i|
      tf = 0
      if state[i] == 2
        tf = gs[i]
      elsif state[i] == 1
        tf = fs[i]
      end
      if tf > f
        above = true
      elsif tf != 0 && tf < f
        below = true
      end
    end
    if dir == 1
      if above
        dir = 1
      elsif below
        dir = -1
      else
        dir = 0
      end
    elsif dir == -1
      if below
        dir = -1
      elsif above
        dir = 1
      else
        dir = 0
      end
    end
    if dir == 0
      best = 0
      bestd = 1000
      first_at = -1
      n.times do |i|
        tf = 0
        if state[i] == 2
          tf = gs[i]
        elsif state[i] == 1
          tf = fs[i]
          first_at = i if fs[i] == f && first_at == -1
        end
        if tf != 0
          d = Arithmetic.abs(tf - f)
          if d < bestd || (d == bestd && tf < best)
            bestd = d
            best = tf
          end
        end
      end
      if best != 0
        if best == f
          dir = sign(fs[first_at], gs[first_at])
        else
          dir = best > f ? 1 : -1
        end
      end
    end
    riding = Array.count(state) { |s| s == 2 }
    n.times do |i|
      if state[i] == 1 && fs[i] == f && dir != 0 && sign(fs[i], gs[i]) == dir && riding < cap
        puts("t=#{t} floor #{f} pick P#{i + 1}")
        state[i] = 2
        pickt[i] = t
        riding += 1
        changed = true
      end
    end
    if changed
      t += dt
    else
      f += dir
      t += 1
    end
  end
  sw = 0
  sr = 0
  n.times do |i|
    w = pickt[i] - ts[i]
    r = dropt[i] - pickt[i]
    sw += w
    sr += r
    puts("P#{i + 1} wait #{w} ride #{r}")
  end
  puts(format("average wait %.2f ride %.2f", sw.Integer.fdiv(n), sr.Integer.fdiv(n)))
  puts("done at t=#{lastdrop}")
end
main
