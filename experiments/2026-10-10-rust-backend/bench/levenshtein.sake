# The "levenshtein" micro benchmark: the edit distance between every pair of the arguments.
def levenshtein(s, t)
  a = String.bytes(s)
  b = String.bytes(t)
  m = Array.length(a)
  n = Array.length(b)
  return n if m == 0
  return m if n == 0
  prev = Array.new(n + 1, 0)
  curr = Array.new(n + 1, 0)
  j = 0
  while j <= n
    prev[j] = j
    j += 1
  end
  i = 1
  while i <= m
    curr[0] = i
    j = 1
    while j <= n
      cost = Array.fetch(a, i - 1) == Array.fetch(b, j - 1) ? 0 : 1
      del = Array.fetch(prev, j) + 1
      ins = Array.fetch(curr, j - 1) + 1
      sub = Array.fetch(prev, j - 1) + cost
      best = del
      best = ins if ins < best
      best = sub if sub < best
      curr[j] = best
      j += 1
    end
    tmp = prev
    prev = curr
    curr = tmp
    i += 1
  end
  Array.fetch(prev, n)
end

args = ARGV
count = Array.length(args)
min = -1
times = 0
i = 0
while i < count
  j = 0
  while j < count
    if i != j
      d = levenshtein(Array.fetch(args, i), Array.fetch(args, j))
      min = d if min == -1 || d < min
      times += 1
    end
    j += 1
  end
  i += 1
end
puts("times: #{times}")
puts("min_distance: #{min}")
