# CREATE VIEW and DROP VIEW (spec 5.3). A view is only stored: its select is planned, afresh, by each
# statement that uses it (FromPlanner.named_source).
module Views
  module_function

  def create(db, st)
    name = CreateView.name(st)
    return unless Ddl.claim_name(db, name, CreateView.if_not_exists(st))
    Database.add_view(db, View.new(name, CreateView.columns(st), CreateView.query(st)))
  end

  def drop(db, st)
    name = DropView.name(st)
    if Database.view(db, name) == nil
      if Database.table?(db, name)
        raise SqlError.new("use DROP TABLE to delete table #{Table.name(Database.table(db, name))}")
      end
      return if DropView.if_exists(st)
      raise SqlError.new("no such view: #{name}")
    end
    Database.remove_view(db, name)
  end
end
