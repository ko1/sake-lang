# Port of activerecord-8.1.3/lib/arel/nodes/select_core.rb (partial: no hash/eql?)

module Arel
  module Nodes
    class SelectCore
      attr_accessor projections, wheres, groups, windows, comment
      attr_accessor havings, source, set_quantifier, optimizer_hints
      include Node
      def initialize(o) = @projections ||= Any[]

      # Ruby: SelectCore.new(relation = nil)
      def build(relation = nil)
        SelectCore.new(projections: Any[], wheres: Any[], groups: Any[], windows: Any[], havings: Any[], source: JoinSource.new(relation))
      end

      def from(o) = JoinSource.left(@source)
      def set_from(o, value) = JoinSource.set_left(@source, value)
      def froms(o) = JoinSource.left(@source)
      def set_froms(o, value) = JoinSource.set_left(@source, value)
    end
  end
end
