class Product
  attr_reader sku, title, category
end

class Review
  attr_reader sku, stars
end

class Score
  attr_reader rating, votes, title
  include Comparable

  def <=>(a, b)
    c = Score.get_rating(b) <=> @rating
    c = Score.get_votes(b) <=> @votes if c == 0
    c = @title <=> Score.get_title(b) if c == 0
    c
  end
end

def catalog
  Product[
    Product.new("b1", "Dune", :books), Product.new("b2", "Neuromancer", :books),
    Product.new("b3", "Hyperion", :books), Product.new("b4", "Solaris", :books),
    Product.new("k1", "Chef knife", :kitchen), Product.new("k2", "Cast iron pan", :kitchen),
    Product.new("k3", "Peeler", :kitchen), Product.new("g1", "Trail tent", :garden),
    Product.new("t1", "Desk lamp", :tools), Product.new("t2", "Cordless drill", :tools)
  ]
end

def reviews
  stars = Hash[
    "b1" => Integer[5, 5, 4, 5, 4, 5], "b2" => Integer[4, 3, 5], "b3" => Integer[5],
    "b4" => Integer[4, 4, 3, 5, 4], "k1" => Integer[5, 4, 5, 5], "k2" => Integer[5, 5, 5, 4, 5, 5, 4],
    "k3" => Integer[2, 3], "t1" => Integer[3, 4, 4], "t2" => Integer[5, 4], "x9" => Integer[1, 1]
  ]
  Hash.flat_map(stars) { |sku, list| Array.map(list) { |s| Review.new(sku, s) } }
end

def bayesian(sum, n, prior_mean, prior_weight) = (sum + prior_mean * prior_weight) / (n + prior_weight)

products = catalog
by_sku = Array.to_h(Array.map(products) { |p| [Product.get_sku(p), p] })
all_reviews = reviews
global_mean = Array.sum(all_reviews) { Review.get_stars(it) } * 1.0 / Array.size(all_reviews)
grouped = Array.group_by(all_reviews) { Review.get_sku(it) }

orphans = Array.reject(Hash.keys(grouped)) { Hash.key?(by_sku, it) }
puts(format("%d reviews, global mean %.2f", Array.size(all_reviews), global_mean))
puts("reviews for unknown products: #{Array.join(orphans, ", ")}") unless Array.empty?(orphans)
puts

scored = Array.map(products) do |p|
  rs = grouped[Product.get_sku(p)] || Array[]
  total = Array.sum(rs) { Review.get_stars(it) }
  rating = bayesian(total, Array.size(rs), global_mean, 3)
  [p, Score.new(Float.round(rating, 3), Array.size(rs), Product.get_title(p))]
end

by_cat = Array.group_by(scored) { |p, s| Product.get_category(p) }
Array.each(Array.sort_by(Hash.keys(by_cat)) { Symbol.to_s(it) }) do |cat|
  entries = Hash.fetch(by_cat, cat)
  rated = Array.select(entries) { |p, s| Score.get_votes(s) > 0 }
  puts("#{Symbol.upcase(cat)} (#{Array.size(entries)} products, #{Array.size(rated)} rated)")
  if Array.size(rated) < 2
    puts("  not enough data")
    next
  end
  top = Array.take(Array.sort_by(rated) { |p, s| s }, 3)
  Array.each_with_index(top) do |(p, s), i|
    puts(format("  %d. %-15s %.2f  (%d votes)", i + 1, Product.get_title(p), Score.get_rating(s), Score.get_votes(s)))
  end
end

puts
unrated = Array.select(scored) { |p, s| Score.get_votes(s) == 0 }
puts("No reviews yet: #{Array.join(Array.map(unrated) { |p, s| Product.get_title(p) }, ", ")}")
best_pair = Array.min_by(scored) { |p, s| s }
if best_pair
  bp, bs = best_pair
  puts(format("Best overall: %s (%.2f)", Product.get_title(bp), Score.get_rating(bs)))
end
