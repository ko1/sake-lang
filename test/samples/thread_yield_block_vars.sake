# A block that runs on a thread (yield inside Thread.new) sees the block variables as they were when the
# thread started: each call of a block has its own parameters, as in Ruby, so this prints [0, 1, 2] twice.
def later
  Thread.new do
    sleep 0.02
    yield
  end
end
out = Queue.new
ts = Array.map(Range.to_a(0..2)) { |i| later { Queue.push(out, i) } }
Array.each(ts) { |t| Thread.join(t) }
got = Array[]
Array.push(got, Queue.pop(out)) until Queue.empty?(out)
p Array.sort(got)
# A function's own parameter is per call, so this prints [0, 1, 2]:
def post_i(out, i) = later { Queue.push(out, i) }
ts = Array.map(Range.to_a(0..2)) { |i| post_i(out, i) }
Array.each(ts) { |t| Thread.join(t) }
got = Array[]
Array.push(got, Queue.pop(out)) until Queue.empty?(out)
p Array.sort(got)
