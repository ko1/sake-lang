# (Sake only) The source of the named route helpers, as Rails' NamedRouteCollection#add defines them with
# define_method (`post_path`, `post_url`, ...), and `route_for(name, *args)` (Rails' public_send("#{name}_url")).
#
#   Rails (at boot, per named route)               Sake (generated before the program is checked)
#   define_url_helper @path_helpers_module,        def post_path(t, *args, **options) =
#     :post_path, helper, PATH                       ...UrlHelper.call(t, :post, :path, args, options)
#
# The helpers go in a mixin (module_name) that a UrlFor includer includes (a controller, a view, RouteSet's
# the generated Proxy, Rails' url_helpers called on the module itself); `t` is that includer, Rails' `self` in the defined method. railties runs this from a generator
# program that draws the app's routes; `generate "gen"` joins what it prints into the app.

require "../route_set"

module ActionDispatch
  module Routing
    module Generate
      module_function

      def url_helpers(set, module_name)
        names = RouteSet::NamedRouteCollection.names(RouteSet.named_routes(set))
        call = "ActionDispatch::Routing::RouteSet::NamedRouteCollection::UrlHelper.call"
        out = String["# Generated by ActionDispatch::Routing::Generate.url_helpers: #{Array.size(names)} named routes",
                     "module #{module_name}"]
        Array.each(names) do |name|
          route = RouteSet::NamedRouteCollection.get(RouteSet.named_routes(set), name)
          next unless route
          Array.push(out, "  # #{Journey::Route.verb(route)} #{Journey::Nodes::Node.to_s(Journey::Path::Pattern.spec(Journey::Route.path(route)))}")
          Array.each(String["path", "url"]) do |kind|
            Array.push(out, "  def #{name}_#{kind}(t, *args, **options) = #{call}(t, :#{name}, :#{kind}, args, Hash.empty?(options) ? nil : options)")
          end
        end
        Hash.each_key(RouteSet.custom_url_helpers(set)) do |name|
          Array.push(out, "  # direct :#{name}")
          Array.each(String["path", "url"]) do |kind|
            Array.push(out, "  def #{name}_#{kind}(t, *args, **options) = ActionDispatch::Routing::RouteSet::CustomUrlHelper.call(t, :#{name}, args, options, #{kind == "path"})")
          end
        end
        Array.push(out, "  def route_for(t, name, *args, **options)")
        Array.push(out, "    case name")
        Array.each(names) { |name| Array.push(out, "    in :#{name} then #{call}(t, :#{name}, :url, args, Hash.empty?(options) ? nil : options)") }
        Array.push(out, "    else raise ArgumentError, \"undefined route helper #{"\#{name}"}_url\"")
        Array.push(out, "    end")
        Array.push(out, "  end")
        Array.push(out, "end")
        # Rails' url_helpers module answers the helpers itself, through a proxy_class with `url_options` {}
        Array.push(out, "class #{module_name}::Proxy")
        Array.push(out, "  attr_reader routes")
        Array.push(out, "  include ActionDispatch::Routing::UrlFor")
        Array.push(out, "  include #{module_name}")
        Array.push(out, "  def _routes(pr) = @routes")
        Array.push(out, "  def url_options(pr) = Hash.new")
        Array.push(out, "end")
        Array.join(out, "\n") + "\n"
      end
    end
  end
end
