# shellwords: Ruby's Shellwords module in Sake (Bourne shell word splitting and escaping).
#
# Shellwords.split / shellsplit / shellwords, escape / shellescape, join / shelljoin, and Ruby's
# String#shellsplit, String#shellescape, Array#shelljoin as String.shellsplit(s) and so on.

module Shellwords
  module_function

  # Ruby's pattern, unchanged: one word at pos (\G), then a separator.
  def word_re = /\G\s*(?>([^\0\s\\'"]+)|'([^\0']*)'|"((?:[^\0"\\]|\\[^\0])*)"|(\\[^\0]?)|(\S))(\s|\z)?/m

  # Ruby's line.scan(word_re) { ... }, with the position passed to String.match.
  def shellsplit(line)
    words = String[]
    field = ""
    pos = 0
    while (m = String.match(line, word_re, pos))
      whole = m[0] || ""
      garbage = m[5]
      if garbage
        shown = pos > 0 ? "..." + whole : whole
        raise ArgumentError, "#{garbage == "\0" ? "Nul character" : "Unmatched quote"} at #{pos}: #{shown}"
      end
      dq = m[3]
      field += m[1] || m[2] || (dq && String.gsub(dq, /\\([$`"\\\n])/, "\\1")) || String.gsub(m[4] || "", /\\(.)/, "\\1")
      if m[6]
        Array.push(words, field)
        field = ""
      end
      pos = MatchData.end(m, 0) || pos
    end
    words
  end

  def shellwords(line) = shellsplit(line)
  def split(line) = shellsplit(line)

  # Any value, as Ruby's str.to_s; an empty String gives "''".
  def shellescape(x)
    str = Kernel.to_s(x)
    return "''" if str == ""
    raise ArgumentError, "NUL character" if String.include?(str, "\0")
    String.gsub(str, /[^A-Za-z0-9_\-.,:+\/@\n]/, "\\\\\\&")
      .String.gsub(/\n/, "'\n'")
  end

  def escape(x) = shellescape(x)

  def shelljoin(a) = Array.join(Array.map(a) { |x| shellescape(x) }, " ")

  def join(a) = shelljoin(a)
end

class String
  def shellsplit(s) = Shellwords.shellsplit(s)
  def shellescape(s) = Shellwords.shellescape(s)
end

class Array
  def shelljoin(a) = Shellwords.shelljoin(a)
end
