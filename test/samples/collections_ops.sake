# Array + - * , Array.new, Symbol order, and == between values of different types (false, as Ruby).
p(Array[1, 2] + Array[3])
p(Array[1, 2, 3, 2] - Array[2])
p(Array["-"] * 3)
p(Array.new(3, 0))
p(Array.new(4) { |i| i * i })
p(Array.new(2))
p([:a < :b, :b <=> :a])
p(Array.sort(Array[:pear, :apple]))
p([1 == :a, "x" != 3, 1 == 1.0])
