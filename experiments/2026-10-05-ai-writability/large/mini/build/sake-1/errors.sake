# Errors of the four phases (SPEC section 1) and of Mini programs (section 9).

# A lexical, syntax or static error. It is found before anything runs, and
# stops the run: `kind` is "lexical", "syntax" or "static".
class CompileError < Exception
  attr_reader kind, line, col
end

# A Mini throw or runtime error travelling to the innermost `catch`.
# `value` is what the catch receives (for a runtime error, the error map);
# the exception's message is the text printed if nothing catches it.
class MiniThrow < Exception
  attr_reader value, line, col
end

def compile_error(kind, message, line, col)
  raise CompileError.new(message, kind, line, col)
end

# Raises a runtime error of the given kind ("type", "index", ...).
def runtime_error(kind, message, line, col)
  map = Hash["kind" => kind, "message" => message, "line" => line, "col" => col]
  raise MiniThrow.new(message, map, line, col)
end

def type_error(message, line, col) = runtime_error("type", message, line, col)

# "1 argument", "3 arguments"
def count_noun(n, word) = n == 1 ? "#{n} #{word}" : "#{n} #{word}s"

# The wording of an arity error, shared by the static checks, user functions
# and built-ins (SPEC 6.6). `max` is nil when there is no maximum.
def arity_message(name, min, max, given)
  expected =
    if max == nil
      "at least #{count_noun(min, "argument")}"
    elsif min == max
      count_noun(min, "argument")
    else
      "#{min} to #{count_noun(max, "argument")}"
    end
  "#{name} expects #{expected}, got #{given}"
end

# Whether `given` arguments fit `min`..`max` (`max` nil: no maximum).
def arity_ok?(min, max, given)
  return false if given < min
  max == nil || given <= max
end
