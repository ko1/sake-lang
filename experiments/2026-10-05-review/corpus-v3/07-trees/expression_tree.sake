class Num
  attr_reader value
end

class Var
  attr_reader name
end

class BinOp
  attr_reader op, left, right
end

class ParseError < StandardError
  attr_reader pos
end

class UnboundError < StandardError
  attr_reader name
end

class Parser
  attr_reader tokens, pos = 0

  def peek(ps) = @tokens[@pos]

  def advance(ps)
    t = @tokens[@pos]
    @pos += 1
    t
  end

  def expect(ps, t)
    got = advance(ps)
    raise ParseError.new("expected #{t} but got #{got == nil ? "end" : got}", @pos) unless got == t
  end

  def parse(src)
    ps = Parser.new(String.scan(src, /\d+(?:\.\d+)?|[a-z]+|[-+*\/^()]/))
    e = expr(ps)
    raise ParseError.new("trailing #{peek(ps)}", Parser.pos(ps)) if peek(ps) != nil
    e
  end

  def expr(ps)
    left = term(ps)
    while peek(ps) == "+" || peek(ps) == "-"
      op = advance(ps)
      left = BinOp.new(op, left, term(ps))
    end
    left
  end

  def term(ps)
    left = power(ps)
    while peek(ps) == "*" || peek(ps) == "/"
      op = advance(ps)
      left = BinOp.new(op, left, power(ps))
    end
    left
  end

  def power(ps)
    base = atom(ps)
    if peek(ps) == "^"
      advance(ps)
      return BinOp.new("^", base, power(ps))
    end
    base
  end

  def atom(ps)
    t = advance(ps)
    raise ParseError.new("unexpected end", @pos) if t == nil
    if t == "("
      e = expr(ps)
      expect(ps, ")")
      e
    elsif t == "-"
      BinOp.new("-", Num.new(0), atom(ps))
    elsif String.match?(t, /\A\d/)
      String.include?(t, ".") ? Num.new(String.to_f(t)) : Num.new(String.to_i(t))
    elsif String.match?(t, /\A[a-z]/)
      Var.new(t)
    else
      raise ParseError.new("unexpected #{t}", @pos)
    end
  end
end

def evaluate(e, env)
  case e
  in Num then Num.value(e)
  in Var
    v = env[Var.name(e)]
    raise UnboundError.new("unbound variable #{Var.name(e)}", Var.name(e)) if v == nil
    v
  in BinOp
    a = evaluate(BinOp.left(e), env)
    b = evaluate(BinOp.right(e), env)
    case BinOp.op(e)
    in "+" then a + b
    in "-" then a - b
    in "*" then a * b
    in "/" then a / b
    else a ** b
    end
  end
end

def prec(op)
  case op
  in "+" | "-" then 1
  in "*" | "/" then 2
  else 3
  end
end

def show(e)
  case e
  in Num then Kernel.to_s(Num.value(e))
  in Var then Var.name(e)
  in BinOp
    op = BinOp.op(e)
    l = BinOp.left(e)
    r = BinOp.right(e)
    ls = show(l)
    rs = show(r)
    ls = "(#{ls})" if (l in BinOp) && prec(BinOp.op(l)) < prec(op)
    rs = "(#{rs})" if (r in BinOp) && (prec(BinOp.op(r)) < prec(op) || (prec(BinOp.op(r)) == prec(op) && op != "^"))
    "#{ls} #{op} #{rs}"
  end
end

def num?(e, v) = (e in Num) && Num.value(e) == v

def simplify(e)
  return e unless e in BinOp
  op = BinOp.op(e)
  l = simplify(BinOp.left(e))
  r = simplify(BinOp.right(e))
  if (l in Num) && (r in Num) && (op != "/" || Num.value(r) != 0)
    return Num.new(evaluate(BinOp.new(op, l, r), Hash[]))
  end
  return r if op == "+" && num?(l, 0)
  return l if (op == "+" || op == "-") && num?(r, 0)
  return Num.new(0) if op == "*" && (num?(l, 0) || num?(r, 0))
  return r if op == "*" && num?(l, 1)
  return l if (op == "*" || op == "/" || op == "^") && num?(r, 1)
  return Num.new(1) if op == "^" && num?(r, 0)
  BinOp.new(op, l, r)
end

def derive(e, x)
  case e
  in Num then Num.new(0)
  in Var then Num.new(Var.name(e) == x ? 1 : 0)
  in BinOp
    op = BinOp.op(e)
    u = BinOp.left(e)
    v = BinOp.right(e)
    du = derive(u, x)
    dv = derive(v, x)
    case op
    in "+" | "-" then BinOp.new(op, du, dv)
    in "*" then BinOp.new("+", BinOp.new("*", du, v), BinOp.new("*", u, dv))
    in "/" then BinOp.new("/", BinOp.new("-", BinOp.new("*", du, v), BinOp.new("*", u, dv)), BinOp.new("^", v, Num.new(2)))
    else
      raise ArgumentError, "cannot differentiate non-constant power" unless v in Num
      BinOp.new("*", BinOp.new("*", v, BinOp.new("^", u, Num.new(Num.value(v) - 1))), du)
    end
  end
end

def node_count(e) = (e in BinOp) ? 1 + node_count(BinOp.left(e)) + node_count(BinOp.right(e)) : 1

env = Hash["x" => 3, "y" => 2.5, "n" => 4]
sources = Array["1 + 2 * 3", "(1 + 2) * 3", "2 ^ 3 ^ 2", "x * x - 4 * x + 4", "10 - 4 - 3", "8 / (4 / 2)",
                "y * (x + 1) / 2", "-x + n * 0 + 1 * y", "x ^ n / (x - 3 + 0)", "2 * (3 + ", "z + 1", "4 $ 2"]
Array.each(sources) do |src|
  tree = Parser.parse(src)
  simp = simplify(tree)
  puts("#{src}  =>  #{show(tree)}  [#{node_count(tree)} nodes]")
  puts("    simplified: #{show(simp)}  [#{node_count(simp)} nodes]") if node_count(simp) < node_count(tree)
  puts("    value: #{evaluate(tree, env)}")
rescue ParseError => e
  puts("#{src}  =>  parse error at #{ParseError.pos(e)}: #{Exception.message(e)}")
rescue UnboundError => e
  puts("    error: #{Exception.message(e)}")
rescue ZeroDivisionError
  puts("    error: division by zero")
end

puts("-- derivatives d/dx --")
Array.each(Array["x * x - 4 * x + 4", "3 * x ^ 3 + y * x", "x / (x + 1)", "2 ^ x"]) do |src|
  d = simplify(derive(Parser.parse(src), "x"))
  puts("#{src}  ->  #{show(d)}  = #{evaluate(d, env)} at x=3")
rescue ArgumentError => e
  puts("#{src}  ->  #{Exception.message(e)}")
end
