class SessionsController < ApplicationController
  def new_(c) = nil

  def create(c)
    if (user = User.authenticate_by(ActionController::Parameters.to_hash(ActionController::Parameters.permit(params(c), :email_address, :password))))
      start_new_session_for c, user
      redirect_to c, after_authentication_url(c)
    else
      redirect_to c, new_session_path(c), alert: "Try another email address or password."
    end
  end

  def destroy(c)
    terminate_session c
    redirect_to c, new_session_path(c), status: :see_other
  end
end
