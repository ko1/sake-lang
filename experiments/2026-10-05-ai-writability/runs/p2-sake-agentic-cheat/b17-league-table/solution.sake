def main
  lines = IO.readlines(IO.stdin)
  idx = Hash.new
  names = String[]
  mh = Integer[]
  ma = Integer[]
  mhg = Integer[]
  mag = Integer[]
  lineno = 0
  Array.each(lines) do |raw|
    lineno += 1
    line = String.chomp(raw)
    next if String.strip(line) == ""
    tk = String.split(String.strip(line))
    ok = Array.size(tk) == 3
    if ok
      ok = String.match?(tk[0], /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/) && String.match?(tk[2], /\A[A-Za-z][A-Za-z0-9_]{0,11}\z/) && tk[0] != tk[2]
    end
    if ok
      ok = String.match?(tk[1], /\A\d{1,2}-\d{1,2}\z/) || tk[1] == "P-P"
    end
    unless ok
      puts("invalid line #{lineno}: #{line}")
      next
    end
    [tk[0], tk[2]].Tuple.to_a.Array.each do |nm|
      unless Hash.key?(idx, nm)
        idx[nm] = Array.size(names)
        Array.push(names, nm)
      end
    end
    if tk[1] != "P-P"
      sc = String.split(tk[1], "-")
      Array.push(mh, idx[tk[0]] || 0)
      Array.push(ma, idx[tk[2]] || 0)
      Array.push(mhg, String.to_i(sc[0]))
      Array.push(mag, String.to_i(sc[1]))
    end
  end
  n = Array.size(names)
  if n == 0
    puts("no teams")
    return
  end
  pl = Array.new(n, 0)
  w = Array.new(n, 0)
  d = Array.new(n, 0)
  l = Array.new(n, 0)
  gf = Array.new(n, 0)
  ga = Array.new(n, 0)
  pts = Array.new(n, 0)
  m = Array.size(mh)
  Integer.times(m) do |k|
    a = mh[k]
    b = ma[k]
    x = mhg[k]
    y = mag[k]
    pl[a] += 1
    pl[b] += 1
    gf[a] += x
    ga[a] += y
    gf[b] += y
    ga[b] += x
    if x > y
      w[a] += 1
      l[b] += 1
      pts[a] += 3
    elsif x < y
      w[b] += 1
      l[a] += 1
      pts[b] += 3
    else
      d[a] += 1
      d[b] += 1
      pts[a] += 1
      pts[b] += 1
    end
  end
  key = Array.new(n, "")
  Integer.times(n) { |i| key[i] = "#{pts[i]},#{gf[i] - ga[i]},#{gf[i]}" }
  h2h = Array.new(n, 0)
  Integer.times(m) do |k|
    a = mh[k]
    b = ma[k]
    if key[a] == key[b]
      if mhg[k] > mag[k]
        h2h[a] += 3
      elsif mhg[k] < mag[k]
        h2h[b] += 3
      else
        h2h[a] += 1
        h2h[b] += 1
      end
    end
  end
  order = Array.sort_by(Range.to_a(0...n)) { |i| [-pts[i], -(gf[i] - ga[i]), -gf[i], -h2h[i], names[i]] }
  puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", "Pos", "Team", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"))
  Array.each(order) do |i|
    pos = 1 + Array.count(Range.to_a(0...n)) { |j| pts[j] > pts[i] || (pts[j] == pts[i] && (gf[j] - ga[j] > gf[i] - ga[i] || (gf[j] - ga[j] == gf[i] - ga[i] && (gf[j] > gf[i] || (gf[j] == gf[i] && h2h[j] > h2h[i]))))) }
    gd = gf[i] - ga[i]
    gds = gd > 0 ? "+#{gd}" : Integer.to_s(gd)
    puts(format("%3s %-12s%3s%3s%3s%3s%4s%4s%4s%4s", pos, names[i], pl[i], w[i], d[i], l[i], gf[i], ga[i], gds, pts[i]))
  end
end
main
