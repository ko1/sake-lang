require "fugit"

# Times are fixed UTC values (never the clock); results print as text
def show(t) = Time.strftime(t, "%F %T %z %a")

# cron: parse, fields, to_cron_s
c = Fugit::Cron.parse("*/15 9-17 * * mon-fri")
c => Fugit::Cron
p(Fugit::Cron.original(c))
p(Fugit::Cron.to_cron_s(c))
p(Fugit::Cron.seconds(c))
p(Fugit::Cron.minutes(c))
p(Fugit::Cron.hours(c))
p(Fugit::Cron.monthdays(c))
p(Fugit::Cron.months(c))
p(Fugit::Cron.weekdays(c))
p(Fugit::Cron.to_a(c))
p(Fugit::Cron.to_h(c))

# next_time / previous_time / match? from a fixed time
t = Time.new(2024, 1, 31, 10, 7, 0, "UTC")
puts(show(Fugit::Cron.next_time(c, t)))
puts(show(Fugit::Cron.previous_time(c, t)))
p(Fugit::Cron.match?(c, t))
p(Fugit::Cron.match?(c, Time.new(2024, 1, 31, 10, 15, 0, "UTC")))
p(Fugit::Cron.match?(c, Time.new(2024, 2, 3, 10, 15, 0, "UTC")))
# from a Friday evening, the next is Monday morning
puts(show(Fugit::Cron.next_time(c, Time.new(2024, 2, 2, 17, 50, 0, "UTC"))))
puts(show(Fugit::Cron.previous_time(c, Time.new(2024, 2, 5, 9, 0, 0, "UTC"))))

# a run of next times
n = Time.new(2024, 2, 28, 23, 0, 0, "UTC")
Array.each(Enum.take(Fugit::Cron.next(Fugit::Cron.do_parse("30 0 * * *"), n), 3)) { |x| puts(show(x)) }
Array.each(Enum.take(Fugit::Cron.prev(Fugit::Cron.do_parse("0 12 * * *"), n), 2)) { |x| puts(show(x)) }
w = Fugit::Cron.within(Fugit::Cron.do_parse("0 */6 * * *"), Time.new(2024, 3, 1, 0, 0, 0, "UTC"), Time.new(2024, 3, 2, 0, 0, 0, "UTC"))
p(Array.map(w) { |x| Time.hour(x) })

# the many forms of a cron string
Array.each(Array[
  "0 0 L * *",
  "0 0 -2 * *",
  "0 0 * * 1#2,5#-1",
  "0 0 * * tue%2+1",
  "0 0 * * mon%2",
  "@daily",
  "@hourly",
  "@weekly",
  "*/10 * * * * *",
  "5 0 * 8 *",
  "0 22 * * 1-5",
  "0 0,12 1 */2 *",
  "0 4 8-14 * *",
  "0 0 1,15 * 3",
  "0 0 1,15 * 3&",
  "0 0 * * sun,7",
  "0 0 * * fri-mon",
  "0 0 * jan-mar,dec *",
  "0 23-2 * * *",
  "0 0 30 * *",
  "0 9 * * * +09:00",
  "0 9 * * * UTC",
  ",0,,30, * * * *",
]) do |s|
  cc = Fugit::Cron.do_parse(s)
  puts("#{Kernel.inspect(s)} -> #{Kernel.inspect(Fugit::Cron.to_cron_s(cc))} #{show(Fugit::Cron.next_time(cc, t))} #{show(Fugit::Cron.previous_time(cc, t))}")
end

# hash (n-th weekday) and modulo (every other week) in action
second_monday = Fugit::Cron.do_parse("0 8 * * mon#2")
puts(show(Fugit::Cron.next_time(second_monday, t)))
last_friday = Fugit::Cron.do_parse("0 8 * * fri#L")
puts(show(Fugit::Cron.next_time(last_friday, t)))
every_other = Fugit::Cron.do_parse("0 8 * * tue%2")
puts(show(Fugit::Cron.next_time(every_other, t)))
puts(show(Fugit::Cron.next_time(every_other, Fugit::Cron.next_time(every_other, t))))
# monthday and weekday: either matches; with & both must
p(Array.map(Enum.take(Fugit::Cron.next(Fugit::Cron.do_parse("0 0 13 * 5"), t), 3)) { |x| show(x) })
p(Array.map(Enum.take(Fugit::Cron.next(Fugit::Cron.do_parse("0 0 13 * 5&"), t), 2)) { |x| show(x) })

# a cron with a zone: computed there, shown in the zone of the argument
tokyo = Fugit::Cron.do_parse("0 9 * * * +09:00")
p(Fugit::Cron.zone(tokyo))
puts(show(Fugit::Cron.next_time(tokyo, t)))
p(Fugit::Cron.match?(tokyo, Time.new(2024, 2, 1, 0, 0, 0, "UTC")))

# rough_frequency (seconds between occurrences, roughly)
Array.each(Array["* * * * *", "*/15 * * * *", "0 * * * *", "0 0 * * *", "0 0 * * 1", "0 0 1 * *", "*/10 * * * * *"]) do |s|
  p([s, Fugit::Cron.rough_frequency(Fugit::Cron.do_parse(s))])
end

# equality
p(Fugit::Cron.do_parse("0 0 * * *") == Fugit::Cron.do_parse("@daily"))
p(Fugit::Cron.do_parse("0 0 * * *") == Fugit::Cron.do_parse("@hourly"))

# what is not a cron: nil from parse, ArgumentError from do_parse
Array.each(Array["", "* * *", "60 * * * *", "* 25 * * *", "0 0 30 2 *", "@reboot", "0 0 * * * Europe/Nowhere", "*/0 * * * *", "1 2 3 4 5 6 7 8"]) do |s|
  p([s, Fugit::Cron.parse(s)])
end
begin
  Fugit::Cron.do_parse("nada")
rescue ArgumentError => e
  puts(Exception.message(e))
end
begin
  Fugit::Cron.do_parse("a long string that is not a cron, not at all")
rescue ArgumentError => e
  puts(Exception.message(e))
end
# an impossible date is found while searching
begin
  p(Fugit::Cron.parse("0 0 31 4,6 *"))
  p(Time.year(Fugit::Cron.next_time(Fugit::Cron.do_parse("0 0 31 * 0&"), t)))
rescue RuntimeError => e
  puts(String.[](Exception.message(e), 0, 40))
end

# duration: parse, h, the printers
d = Fugit::Duration.do_parse("1h30m")
p(Fugit::Duration.h(d))
p(Fugit::Duration.to_plain_s(d))
p(Fugit::Duration.to_iso_s(d))
p(Fugit::Duration.to_long_s(d))
p(Fugit::Duration.to_rufus_s(d))
p(Fugit::Duration.to_sec(d))
p(Fugit::Duration.original(d))
Array.each(Array[
  "1y2M3d4h5m6s",
  "1 year, 2 months and 3 days",
  "2 weeks",
  "1.5h",
  "-1h +30m",
  "-1h30m",
  "90",
  "1h 90s",
  "3 hours and 15 minutes",
  "P1Y2M3DT4H5M6.5S",
  "PT36H",
  "p1w",
  "1d 2h, 3m",
]) do |s|
  dd = Fugit::Duration.do_parse(s)
  puts("#{Kernel.inspect(s)} -> #{Fugit::Duration.h(dd)} #{Fugit::Duration.to_plain_s(dd)} #{Fugit::Duration.to_iso_s(dd)} #{Fugit::Duration.to_plain_s(Fugit::Duration.deflate(dd))}")
end
p(Fugit::Duration.h(Fugit::Duration.do_parse(3700)))
p(Fugit::Duration.h(Fugit::Duration.deflate(Fugit::Duration.do_parse(3700))))
p(Fugit::Duration.to_plain_s(Fugit::Duration.deflate(Fugit::Duration.do_parse(90.5))))
p(Fugit::Duration.h(Fugit::Duration.deflate(Fugit::Duration.do_parse("1.5h"))))
p(Fugit::Duration.to_plain_s(Fugit::Duration.deflate(Fugit::Duration.do_parse("100d"), Hash[month: true])))
p(Fugit::Duration.to_plain_s(Fugit::Duration.deflate(Fugit::Duration.do_parse("400d"), Hash[year: true, month: true])))
p(Fugit::Duration.h(Fugit::Duration.inflate(Fugit::Duration.do_parse("36h"))))
p(Fugit::Duration.h(Fugit::Duration.inflate(Fugit::Duration.do_parse("1y36h"))))
p(Fugit::Duration.to_long_s(Fugit::Duration.do_parse("1y2M"), Hash[oxford: false]))

# class-level shorthands: parse, deflate, print
p(Fugit::Duration.to_plain_s("3600s"))
p(Fugit::Duration.to_iso_s("90m"))
p(Fugit::Duration.to_long_s("1y2M3d"))

# arithmetic on durations and times
p(Fugit::Duration.h(Fugit::Duration.do_parse("1d2h") + Fugit::Duration.do_parse("3h")))
p(Fugit::Duration.h(Fugit::Duration.do_parse("1d2h") + 60))
p(Fugit::Duration.h(Fugit::Duration.do_parse("1d2h") + "1d"))
p(Fugit::Duration.h(Fugit::Duration.do_parse("1d2h") - Fugit::Duration.do_parse("3h")))
p(Fugit::Duration.h(Fugit::Duration.opposite(Fugit::Duration.do_parse("1h"))))
p(Fugit::Duration.h(-Fugit::Duration.do_parse("1h")))
p(Fugit::Duration.h(Fugit::Duration.drop_seconds(Fugit::Duration.do_parse("1h30m"))))
p(Fugit::Duration.h(Fugit::Duration.drop_seconds(Fugit::Duration.do_parse("30s"))))
p(Fugit::Duration.do_parse("1h") == Fugit::Duration.do_parse("60m"))
p(Fugit::Duration.do_parse("1h") == Fugit::Duration.do_parse("1h"))
puts(show(Fugit::Duration.add_to_time(Fugit::Duration.do_parse("1d1h"), t)))
puts(show(Fugit::Duration.add_to_time(Fugit::Duration.do_parse("1M"), Time.new(2024, 1, 15, 0, 0, 0, "UTC"))))
puts(show(Fugit::Duration.add_to_time(Fugit::Duration.do_parse("1y"), t)))
puts(show(Fugit::Duration.next_time(Fugit::Duration.do_parse("1h"), t)))
puts(show(Fugit::Duration.subtract_from_time(Fugit::Duration.do_parse("2h"), t)))

# not a duration
Array.each(Array["", "abc", "1x", "h1"]) do |s|
  dd = Fugit::Duration.parse(s)
  p([s, dd ? Fugit::Duration.h(dd) : nil])
end
begin
  Fugit::Duration.do_parse("nope")
rescue ArgumentError => e
  puts(Exception.message(e))
end
p(Fugit::Duration.h(Fugit::Duration.do_parse("P1Y2M", Hash[iso: true])))
p(Fugit::Duration.parse("1h", Hash[iso: true]))
p(Fugit::Duration.parse("P1D", Hash[plain: true]))

# Fugit.parse: a cron, else a duration, else nil
p((Fugit.parse("0 0 * * *") in Fugit::Cron))
p((Fugit.parse("1h") in Fugit::Duration))
p(Fugit.parse("tomorrow!"))
p(Fugit::Cron.to_cron_s(Fugit.do_parse_cron("@noon")))
p(Fugit::Duration.to_plain_s(Fugit.do_parse_duration("2d")))
p(Fugit::Duration.to_sec(Fugit.do_parse_in("1h")))
puts(Fugit.time_to_plain_s(t))
