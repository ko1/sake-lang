# `bin/rails generate` and `bin/rails routes`: what Rails does by metaprogramming while booting, done ahead of
# time, since Sake defines no function while running (no define_method, send or eval; a field is read and written
# by name with T.read_field / T.write_field, so the attribute functions are ActiveRecord::Base's):
#
#   Rails, at boot or first use                       here, written to tmp/generated/
#   route helpers (define_method per named route)     routes.sake: posts_path, post_path(post), polymorphic_path
#   attribute methods from the schema (reflection)    models.sake: each model's fields and their casts
#   send(action_name) in AbstractController           controllers.sake: send_action(c, action), a case
#   templates compiled to methods (ActionView::Template)  views.sake: one function per .html.erb
#   const_get("PostsController")                      controllers.sake: _rails_dispatch, a case
#
# The program is run from the app's directory (bin/rails.sake reads config/routes.sake and db/schema.sake).

require "action_dispatch"
require "active_record"
require "active_support"

module Rails
  module Generate
    module_function

    def banner = "# Generated by `bin/rails generate` (rails_generate.sake). Do not edit.\n"

    def classify(table) = ActiveSupport::Inflector.classify(table)
    def controller_class(name) = "#{ActiveSupport::Inflector.camelize(name)}Controller"

    # ---- routes.sake -----------------------------------------------------------------------------------------
    def routes_source(set, models)
      out = String[banner, "\n# Ruby: the url_helpers module of Rails.application.routes (one method per named route)\n"]
      Array.each(ActionDispatch::Routing::RouteSet.named_routes(set)) do |r|
        names = ActionDispatch::Routing::Route.param_names(r)
        path = String.delete_suffix(ActionDispatch::Routing::Route.path(r), "(.:format)")
        body = String.gsub(path, /:(\w+)/) { |m| "\#{_to_param(#{String.delete_prefix(m, ":")})}" }
        args = Array.empty?(names) ? "" : "(#{Array.join(names, ", ")})"
        Array.push(out, "def #{ActionDispatch::Routing::Route.name(r)}_path#{args} = \"#{body}\"\n")
      end
      Array.push(out, <<~SAKE)

        # a record (or an id) in a path: Ruby's to_param
        def _to_param(x)
          case x
          in Integer | String then Kernel.to_s(x)
          else Kernel.to_s(ActiveModel::Model.to_param(x))
          end
        end

        # Ruby: polymorphic_path(post) / polymorphic_path([post, comment]) (link_to post, form_with model: ...)
        def polymorphic_path(record)
          case record
      SAKE
      Array.each(ActionDispatch::Routing::RouteSet.named_routes(set)) do |r|
        next unless ActionDispatch::Routing::Route.action(r) == "show" || ActionDispatch::Routing::Route.action(r) == "destroy" || ActionDispatch::Routing::Route.action(r) == "update"
        name = ActionDispatch::Routing::Route.name(r) || ""
        names = ActionDispatch::Routing::Route.param_names(r)
        model = classify(ActionDispatch::Routing::Route.controller(r))
        next unless Array.include?(models, model)
        parents = Array.map(Array.first(names, Array.size(names) - 1)) { |n| classify(String.delete_suffix(n, "_id")) }
        collection = Array.find(ActionDispatch::Routing::RouteSet.named_routes(set)) do |x|
          ActionDispatch::Routing::Route.controller(x) == ActionDispatch::Routing::Route.controller(r) &&
            (ActionDispatch::Routing::Route.action(x) == "index" || ActionDispatch::Routing::Route.action(x) == "create") &&
            ActionDispatch::Routing::Route.param_names(x) == Array.first(names, Array.size(names) - 1)
        end
        coll = collection ? "#{ActionDispatch::Routing::Route.name(collection)}_path" : nil
        if Array.empty?(parents)
          new_call = coll ? "#{coll}" : "raise(ArgumentError, \"no collection route for #{model}\")"
          Array.push(out, "  in #{model} then ActiveModel::Model.persisted?(record) ? #{name}_path(record) : #{new_call}\n")
        else
          vars = Array.map(parents) { |p| ActiveSupport::Inflector.underscore(p) }
          Array.push(out, "  in [#{Array.join(parents, ", ")}, #{model}]\n")
          Array.push(out, "    #{Array.join(vars, ", ")}, last = record\n")
          new_call = coll ? "#{coll}(#{Array.join(vars, ", ")})" : "raise(ArgumentError, \"no collection route for #{model}\")"
          Array.push(out, "    ActiveModel::Model.persisted?(last) ? #{name}_path(#{Array.join(vars, ", ")}, last) : #{new_call}\n")
        end
      end
      Array.push(out, "  in nil then raise(ArgumentError, \"Nil location provided. Can't build URI.\")\n")
      Array.push(out, "  else raise(ArgumentError, \"no route for \#{Kernel.inspect(record)}\")\n")
      Array.push(out, "  end\nend\n")
      Array.join(out)
    end

    # ---- models.sake -----------------------------------------------------------------------------------------
    def models_source(schema)
      out = String[banner]
      Array.each(ActiveRecord::Schema.tables(schema)) do |t|
        table = ActiveRecord::Schema::Table.name(t)
        model = classify(table)
        cols = ActiveRecord::Schema::Table.columns(t)
        names = Array.map(cols) { |c| ActiveRecord::Schema::Column.name(c) }
        Array.push(out, "\n# #{model}: the columns of \"#{table}\" (db/schema.sake)\n")
        Array.push(out, "class #{model} < ApplicationRecord\n  attr_accessor #{Array.join(names, ", ")}\nend\n")
        Array.push(out, "def #{model}.table_name = #{Kernel.inspect(table)}\n")
        Array.push(out, "def #{model}._table = once { _load }\n")
        # _cast: a value from a row or a form, by the column's type (Rails: ActiveModel::Type); each branch names
        # the columns of one type, so write_field gives each field only its type's values
        Array.push(out, "def #{model}._cast(r, name, value)\n  case name\n")
        groups = Array.group_by(cols) { |c| ActiveRecord::Schema::Column.type(c) }
        Hash.each(groups) do |type, cs|
          lits = Array.join(Array.map(cs) { |c| ":#{ActiveRecord::Schema::Column.name(c)}" }, " | ")
          cast = type == :text ? :string : type
          Array.push(out, "  in #{lits} then write_field(r, name, ActiveRecord::Type.#{cast}(value))\n")
        end
        Array.push(out, "  else raise(ActiveModel::UnknownAttributeError, \"unknown attribute '\#{name}' for #{model}.\")\n  end\nend\n")
      end
      Array.join(out)
    end

    # ---- views.sake and controllers.sake ---------------------------------------------------------------------
    def view_function(dir, base) = "_view_#{dir}_#{base}"
    def partial_function(dir, base) = "_partial_#{dir}_#{String.delete_prefix(base, "_")}"

    def views_source(controllers, models)
      out = String[banner]
      partials = String[]
      Array.each(Array.sort(Dir.glob("app/views/**/*.html.erb"))) do |path|
        rel = String.delete_prefix(path, "app/views/")
        dir = File.dirname(rel)
        base = File.basename(rel, ".html.erb")
        src = File.read(path)
        if dir == "layouts"
          next unless base == "application"
          Array.push(out, "\n# #{path}\n")
          Array.push(out, ActionView::Template::Compiler.compile(src, "def ApplicationController._layout(view)", dir))
        elsif String.start_with?(base, "_")
          locals = ActionView::Template::Compiler.strict_locals(src) || "#{String.delete_prefix(base, "_")}:"
          Array.push(partials, "#{dir}/#{base}")
          Array.push(out, "\n# #{path} (a partial; locals: #{locals})\n")
          Array.push(out, ActionView::Template::Compiler.compile(src, "def ApplicationController.#{partial_function(dir, base)}(view, #{locals})", dir))
        else
          next unless Array.include?(controllers, dir)
          Array.push(out, "\n# #{path}\n")
          Array.push(out, ActionView::Template::Compiler.compile(src, "def #{controller_class(dir)}.#{view_function(dir, base)}(view)", dir))
        end
      end
      # render @post / render @post.comments: the partial named by the record's class (Ruby: to_partial_path)
      Array.push(out, "\n# Ruby: render(record) / render(collection), by the record's to_partial_path\n")
      Array.push(out, "def ApplicationController._render_object(view, x)\n  case x\n")
      Array.push(out, "  in Array then html_safe(Array.join(Array.map(x) { |r| Kernel.to_s(_render_object(view, r)) }))\n")
      Array.each(models) do |m|
        singular = ActiveSupport::Inflector.underscore(m)
        dir = ActiveSupport::Inflector.pluralize(singular)
        next unless Array.include?(partials, "#{dir}/_#{singular}")
        Array.push(out, "  in #{m} then #{partial_function(dir, "_" + singular)}(view, #{singular}: x)\n")
      end
      Array.push(out, "  end\nend\n")
      Array.join(out)
    end

    def controllers_source(set)
      out = String[banner]
      by = Hash[]
      Array.each(ActionDispatch::Routing::RouteSet.routes(set)) do |r|
        acts = by[ActionDispatch::Routing::Route.controller(r)] ||= String[]
        a = ActionDispatch::Routing::Route.action(r)
        Array.push(acts, a) unless Array.include?(acts, a)
      end
      Hash.each(by) do |ctrl, actions|
        klass = controller_class(ctrl)
        Array.push(out, "\n# Ruby: #{klass}#send_action (send(action_name)); `new` is Sake's constructor, so the action is new_\n")
        Array.push(out, "def #{klass}.send_action(c, action)\n  case action\n")
        Array.each(actions) { |a| Array.push(out, "  in :#{a} then #{a == "new" ? "new_" : a}(c)\n") }
        Array.push(out, "  else raise(AbstractController::ActionNotFound, \"The action '\#{action}' could not be found for #{klass}\")\n  end\nend\n")
        templates = Array.map(Array.sort(Dir.glob("app/views/#{ctrl}/*.html.erb"))) { |p| File.basename(p, ".html.erb") }
          .Array.reject { |b| String.start_with?(b, "_") }
        missing = "raise(ActionView::MissingTemplate, \"Missing template #{ctrl}/\#{name}\")"
        if Array.empty?(templates)
          Array.push(out, "def #{klass}._render_template(c, name) = #{missing}\n")
        else
          Array.push(out, "def #{klass}._render_template(c, name)\n  case name\n")
          Array.each(templates) { |base| Array.push(out, "  in #{Kernel.inspect(base)} then #{view_function(ctrl, base)}(c)\n") }
          Array.push(out, "  else #{missing}\n  end\nend\n")
        end
      end
      # the dispatcher (Ruby: ActionDispatch::Routing::RouteSet::Dispatcher, controller class from its name)
      Array.push(out, "\n# Ruby: the route's controller class by name (\"posts\" => PostsController), then #process\n")
      Array.push(out, "def _rails_dispatch(controller, action, req, params, sid, session, flash)\n  case controller\n")
      Hash.each(by) do |ctrl, _|
        klass = controller_class(ctrl)
        Array.push(out, "  in #{Kernel.inspect(ctrl)}\n")
        Array.push(out, "    c = #{klass}.new(request: req, params: params, session_id: sid, session: session, flash: flash, action_name: action)\n")
        Array.push(out, "    #{klass}.to_rack(#{klass}.process(c))\n")
      end
      Array.push(out, "  else raise(AbstractController::ActionNotFound, \"uninitialized constant \#{controller}\")\n  end\nend\n")
      Array.join(out)
    end

    def run(command)
      set = ActionDispatch::Routing::RouteSet.draw(ActionDispatch::Routing::RouteSet.new)
      if command == "routes"
        puts ActionDispatch::Routing::RouteSet.inspect_routes(set)
        return nil
      end
      schema = ActiveRecord::Schema.new
      ActiveRecord::Schema.define(schema)
      models = Array.map(ActiveRecord::Schema.tables(schema)) { |t| classify(ActiveRecord::Schema::Table.name(t)) }
      controllers = Array.uniq(Array.map(ActionDispatch::Routing::RouteSet.routes(set)) { |r| ActionDispatch::Routing::Route.controller(r) })
      Dir.mkdir("tmp") unless Dir.exist?("tmp")
      Dir.mkdir("tmp/generated") unless Dir.exist?("tmp/generated")
      files = Array[
        ["tmp/generated/routes.sake", routes_source(set, models)],
        ["tmp/generated/models.sake", models_source(schema)],
        ["tmp/generated/views.sake", views_source(controllers, models)],
        ["tmp/generated/controllers.sake", controllers_source(set)]
      ]
      Array.each(files) do |path, src|
        File.write(path, src)
        puts "      create  #{path} (#{Array.size(String.lines(src))} lines)"
      end
      nil
    end
  end
end

# ---- the template compiler (Ruby: ActionView::Template::Handlers::ERB, with Erubi's trim mode) --------------------
module ActionView
  module Template
    module Compiler
      module_function

      # Rails 7.1 strict locals: `<%# locals: (post:) -%>` => "post:"
      def strict_locals(src)
        m = String.match(src, /<%#\s*locals:\s*\((.*?)\)\s*-?%>/)
        m ? m[1] : nil
      end

      def tag_re = once { /<%(=|#)?(.*?)-?%>/m }

      # The source of a function `header` whose body builds the template's output (a SafeBuffer).
      def compile(src, header, dir)
        out = String["#{header}\n", "  _buf0 = String[]\n"]
        bufs = String["_buf0"]       # the buffer each nesting level appends to (a <%= ... do %> block captures)
        opens = Symbol[]             # :code for if/each/... blocks, :capture for <%= ... do %>
        pos = 0
        text_start = 0
        pending = ""
        while (m = Regexp.match(tag_re, src, pos))
          b = MatchData.begin(m, 0) || 0
          e = MatchData.end(m, 0) || 0
          kind = m[1] || ""
          code = String.strip(m[2] || "")
          text = String.[](src, text_start, b - text_start) || ""
          statement = kind != "="
          after = e
          if statement
            # Erubi's trim: a statement tag alone on its line takes the line's indentation and newline with it
            line_start = (String.rindex(text, "\n") || -1) + 1
            indent = String.[](text, line_start..) || ""
            if String.match?(indent, /\A[ \t]*\z/) && (src[e] == "\n" || e == String.length(src)) && (line_start > 0 || text_start == 0 || src[text_start - 1] == "\n")
              text = String.[](text, 0, line_start) || ""
              after = e + 1
            end
          end
          depth = Array.size(opens) + 1
          indent = "  " * depth
          buf = Array.last(bufs) || "_buf0"
          Array.push(out, "#{indent}ActionView::OutputBuffer.safe_append(#{buf}, #{Kernel.inspect(text)})\n") unless text == ""
          if kind == "#"
            nil
          elsif kind == "="
            if String.match?(code, /\bdo\s*(\|[^|]*\|)?\z/)
              nb = "_buf#{Array.size(bufs)}"
              Array.push(out, "#{indent}ActionView::OutputBuffer.append(#{buf}, (#{rewrite_render(code, dir)}\n")
              Array.push(out, "#{indent}  #{nb} = String[]\n")
              Array.push(bufs, nb)
              Array.push(opens, :capture)
            else
              Array.push(out, "#{indent}ActionView::OutputBuffer.append(#{buf}, (#{rewrite_render(code, dir)}))\n")
            end
          elsif code == "end" || String.start_with?(code, "end ") || String.start_with?(code, "end.")
            open = Array.pop(opens)
            ind = "  " * (Array.size(opens) + 1)
            if open == :capture
              inner = Array.pop(bufs) || "_buf0"
              Array.push(out, "#{ind}  ActionView::OutputBuffer.to_s(#{inner})\n#{ind}#{code}))\n")
            else
              Array.push(out, "#{ind}#{code}\n")
            end
          else
            ind = String.match?(code, /\A(else|elsif|in|when)\b/) ? "  " * (depth - 1) : indent
            Array.push(out, "#{ind}#{code}\n")
            Array.push(opens, :code) if String.match?(code, /\A(if|unless|case|while|until|begin)\b/) || String.match?(code, /\bdo\s*(\|[^|]*\|)?\z/)
          end
          pos = e
          text_start = after
          pos = after if after > pos
        end
        rest = String.[](src, text_start..) || ""
        Array.push(out, "  ActionView::OutputBuffer.safe_append(_buf0, #{Kernel.inspect(rest)})\n") unless rest == ""
        Array.push(out, "  ActionView::OutputBuffer.to_s(_buf0)\nend\n")
        Array.join(out)
      end

      # Rails' `render "form", post: @post` (a partial of this directory, or "comments/form") and `render x` (a record
      # or a collection, by its partial path) become calls of the compiled partials.
      def rewrite_render(code, dir)
        return "yield(nil)" if code == "yield"     # the layout's block takes the content_for name (nil: the page)
        inner = if String.start_with?(code, "render(") && String.end_with?(code, ")")
                  String.[](code, 7, String.length(code) - 8) || ""
                elsif String.start_with?(code, "render ")
                  String.strip(String.[](code, 7..) || "")
                end
        return code unless inner
        m = String.match(inner, /\A"([^"]+)"\s*(?:,\s*(.*))?\z/m)
        if m
          name = m[1] || ""
          d, base = String.include?(name, "/") ? String.split(name, "/") : [dir, name]
          args = m[2] ? ", #{m[2]}" : ""
          return "#{Rails::Generate.partial_function(d || dir, "_#{base}")}(view#{args})"
        end
        "_render_object(view, #{inner})"
      end
    end
  end
end
