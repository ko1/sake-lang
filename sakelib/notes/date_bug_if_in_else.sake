# Status (2026-10-05): fixed.
# `if x in T ... else ... end` does not drop the else branch's result when x can only be T,
# while the equivalent `case x in T ... in U ...` does. Expected: both pass --strict.
def f(x)
  if x in String
    1
  else
    "s"
  end
end
def g(x)
  case x
  in String then 1
  in Integer then "s"
  end
end
p(Integer.succ(g("x")))   # passes
p(Integer.succ(f("x")))   # reported: argument 1 must be Integer, but can be String [type]
