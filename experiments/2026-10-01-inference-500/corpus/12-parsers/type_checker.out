1 + 2 * 3
  : int = 7
let x = 5 in let y = x * x in y - x
  : int = 20
"ab" ++ show(len("hello") + 1)
  : str = "ab6"
if len("abc") < 4 then upcase("short") else "long"
  : str = "SHORT"
let ok = not(1 == 2) in if ok then 10 else 20
  : int = 10
let s = "x" in s == "x"
  : bool = true
1 + "two"
  type error: '+' needs int operands, got int and str
if 1 then 2 else 3
  type error: condition must be bool, got int
if true then 1 else "one"
  type error: branches differ: int vs str
len(42)
  type error: len expects str, got int
let a = 1 in b
  type error: unbound variable b
frob(1)
  type error: unknown function frob
"a" == 1
  type error: '==' compares str with int
let x = in 3
  syntax error: unexpected token at 'in'
(1 + 2
  syntax error: unexpected end of input at 'end'
1 2
  syntax error: unexpected token at '2'
