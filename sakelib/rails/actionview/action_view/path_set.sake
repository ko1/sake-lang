# Port of actionview-8.1.3/lib/action_view/path_set.rb

require "template/resolver"

module ActionView
  class PathSet
    attr_reader paths

    # Ruby: PathSet.new(paths = []) (Strings become FileSystemResolvers)
    def make(paths = String[]) = PathSet.new(Array.map(paths) { |p| FileSystemResolver.make(p) })

    def size(s) = Array.size(@paths)
    def to_ary(s) = Array.map(@paths) { |r| FileSystemResolver.to_s(r) }
    def +(a, b) = PathSet.new(@paths + PathSet.paths(b))

    def find(s, path, prefixes, partial, details, details_key, locals)
      Array.first(find_all(s, path, prefixes, partial, details, details_key, locals)) ||
        raise(MissingTemplate.make(to_ary(s), path, prefixes, partial, details))
    end

    def find_all(s, path, prefixes, partial, details, details_key, locals)
      Array.each(prefixes) do |prefix|
        Array.each(@paths) do |resolver|
          templates = FileSystemResolver.find_all(resolver, path, prefix, partial, details, details_key, locals)
          return templates unless Array.empty?(templates)
        end
      end
      Any[]
    end

    def exists?(s, path, prefixes, partial, details, details_key, locals) = !Array.empty?(find_all(s, path, prefixes, partial, details, details_key, locals))
  end
end
