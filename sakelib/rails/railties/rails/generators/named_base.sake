# Port of railties-8.1.3/lib/rails/generators/named_base.rb, resource_helpers.rb and model_helpers.rb (partial: no namespaced names (Admin::Post: class_path is always empty), no pluralize_table_names = false, no --model-name)
#
# Ruby's NamedBase computes these names from `name` with memoized methods; here they are functions of the Name
# value made once from the NAME argument and the attributes.

require "rails/activesupport/active_support/inflector"
require "generated_attribute"

module Rails
  module Generators
    class Name
      attr_reader name, attributes

      def make(name, args) = Name.new(name, Array.map(args) { |a| GeneratedAttribute.parse(a) })

      def file_name(n) = ActiveSupport::Inflector.underscore(@name)
      def class_name(n) = ActiveSupport::Inflector.camelize(file_name(n))
      def singular_name(n) = file_name(n)
      def plural_name(n) = ActiveSupport::Inflector.pluralize(singular_name(n))
      def human_name(n) = ActiveSupport::Inflector.humanize(singular_name(n))
      def table_name(n) = ActiveSupport::Inflector.pluralize(file_name(n))
      def singular_table_name(n) = ActiveSupport::Inflector.singularize(table_name(n))
      def plural_table_name(n) = table_name(n)
      def route_url(n) = "/#{plural_name(n)}"
      def index_helper(n) = plural_table_name(n)
      def attributes_names(n) = Array.map(Array.reject(@attributes) { |a| GeneratedAttribute.virtual?(a) && !GeneratedAttribute.attachments?(a) }) { |a| GeneratedAttribute.column_name(a) }

      # ResourceHelpers: the controller's names (plural, as Rails' default)
      def controller_name(n) = ActiveSupport::Inflector.pluralize(@name)
      def controller_file_name(n) = ActiveSupport::Inflector.underscore(controller_name(n))
      def controller_class_name(n) = ActiveSupport::Inflector.camelize(controller_file_name(n))
      def controller_file_path(n) = controller_file_name(n)
    end
  end
end
