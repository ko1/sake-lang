# Port of activerecord-8.1.3/lib/arel/nodes/nary.rb (partial: no hash/eql?)
#
# Ruby's class Nary is a module here; And and Or (Class.new(Nary) in Ruby) include it.

module Arel
  module Nodes
    module Nary
      include NodeExpression
      def children(o) = raise(NotImplementedError)
      def left(o) = Array.first(children(o))
      def right(o) = children(o)[1]
    end

    class And
      attr_reader children
      include Nary
    end

    class Or
      attr_reader children
      include Nary
    end
  end
end
