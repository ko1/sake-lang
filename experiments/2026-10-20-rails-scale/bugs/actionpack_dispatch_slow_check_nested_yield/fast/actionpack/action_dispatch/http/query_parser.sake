# Port of actionpack-8.1.3/lib/action_dispatch/http/query_parser.rb (partial: no deprecated strict_query_string_separator)

require "uri"

module ActionDispatch
  module QueryParser
    module_function

    def default_sep = /& */n
    def common_sep(separator)
      case separator
      in ";" then /; */n
      in ";," then /[;,] */n
      in "&" then /& */n
      in "&;" then /[&;] */n
      else nil
      end
    end

    # Rails: QueryParser.each_pair(s, separator) { |k, v| } yields each pair, unescaped (v nil without "=");
    # without a block it is an Enumerator (here: the Array of the pairs).
    def each_pair(s, separator = nil)
      ps = pairs(s, separator)
      return ps unless block_given?
      Array.each(ps) { |k, v| yield(k, v) }
      nil
    end

    def pairs(s, separator = nil)
      out = Any[]
      splitter = separator ? (common_sep(separator) || Regexp.new("[#{separator}] *", "n")) : default_sep
      Array.each(String.split(s || "", splitter)) do |part|
        next if String.empty?(part)
        kv = String.split(part, "=", 2)
        k = URI.decode_www_form_component(kv[0] || "")
        v = kv[1]
        v = URI.decode_www_form_component(v) if v
        Array.push(out, [k, v])
      end
      out
    end
  end
end
