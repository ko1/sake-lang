class Pos
  attr_reader row, col
  include Arithmetic
  def +(a, b) = Pos.new(@row + Pos.get_row(b), @col + Pos.get_col(b))
  def -(a, b) = Pos.new(@row - Pos.get_row(b), @col - Pos.get_col(b))
  def to_s(p) = "#{Integer.chr(String.ord("a") + @col)}#{@row + 1}"
end

def jumps
  Pos[Pos.new(2, 1), Pos.new(1, 2), Pos.new(-1, 2), Pos.new(-2, 1),
      Pos.new(-2, -1), Pos.new(-1, -2), Pos.new(1, -2), Pos.new(2, -1)]
end

Board = Struct.new(:size, :order)

class Board
  def empty(size) = Board.new(size, Range.map(0...size) { Range.map(0...size) { 0 } })

  def inside?(b, p)
    r = Pos.get_row(p)
    c = Pos.get_col(p)
    r >= 0 && r < @size && c >= 0 && c < @size
  end

  def free?(b, p) = inside?(b, p) && @order[Pos.get_row(p)][Pos.get_col(p)] == 0

  def mark(b, p, n)
    @order[Pos.get_row(p)][Pos.get_col(p)] = n
  end

  def moves_from(b, p) = Array.select(Array.map(jumps) { |j| p + j }) { |q| free?(b, q) }

  def degree(b, p) = Array.size(moves_from(b, p))

  def to_s(b)
    Array.join(Array.map(Array.reverse(@order)) { |row| Array.join(Array.map(row) { |n| String.rjust(Integer.to_s(n), 2) }, " ") }, "\n")
  end
end

# Warnsdorff: always jump to the square with the fewest onward moves
def tour(size, start)
  b = Board.empty(size)
  path = Pos[start]
  Board.mark(b, start, 1)
  cur = start
  step = 1
  while step < size * size
    options = Board.moves_from(b, cur)
    break if Array.empty?(options)
    nxt = Array.min_by(options) { |q| Board.degree(b, q) }
    step += 1
    Board.mark(b, nxt, step)
    Array.push(path, nxt)
    cur = nxt
  end
  [b, path]
end

def knight_move?(a, b)
  d = b - a
  dr = Integer.abs(Pos.get_row(d))
  dc = Integer.abs(Pos.get_col(d))
  (dr == 1 && dc == 2) || (dr == 2 && dc == 1)
end

def check(path)
  bad = 0
  Array.each_cons(path, 2) { |pair| bad += 1 unless knight_move?(Array.fetch(pair, 0), Array.fetch(pair, 1)) }
  bad
end

Array.each(Array[[5, Pos.new(0, 0)], [5, Pos.new(0, 1)], [6, Pos.new(0, 0)], [8, Pos.new(3, 4)]]) do |size, start|
  b, path = tour(size, start)
  visited = Array.size(path)
  puts("#{size}x#{size} from #{start}: visited #{visited}/#{size * size}, bad jumps #{check(path)}")
  if visited == size * size
    first = Array.first(path)
    last = Array.last(path)
    closed = first && last && knight_move?(last, first)
    puts("  complete tour, #{closed ? "closed" : "open"}; ends at #{last}")
    puts(b) if size <= 6
  else
    puts("  stuck at #{Array.last(path)}; route: #{Array.join(Array.take(path, 8), " ")} ...")
  end
end
