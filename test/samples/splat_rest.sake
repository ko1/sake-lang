# `f(*xs)`: a splat fills a user function's `*rest` (after the written-out positional arguments)
def f(a, b = 2, *rest, k: 0) = p([a, b, rest, k])
xs = Array[3, 4]
f(1, 2, *xs)
f(1, 2, 9, *xs, *xs, k: 5)
f(1, 2, *Array[])
def join(*parts) = Array.join(parts, "/")
def join_all(parts) = join(*parts)
p join_all(String.split("usr/local/bin", "/"))
