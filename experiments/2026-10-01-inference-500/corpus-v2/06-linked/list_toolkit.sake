Cons = Struct.new(:head, :tail)

module L
  module_function

  def from(xs)
    list = nil
    Array.reverse_each(xs) { |x| list = Cons.new(x, list) }
    list
  end

  def to_a(list)
    out = Array[]
    while list
      Array.push(out, Cons.get_head(list))
      list = Cons.get_tail(list)
    end
    out
  end

  def show(list) = "(" + Array.join(Array.map(to_a(list)) { Kernel.inspect(it) }, " ") + ")"

  def length(list)
    n = 0
    while list
      n += 1
      list = Cons.get_tail(list)
    end
    n
  end

  def reverse(list)
    acc = nil
    while list
      nxt = Cons.get_tail(list)
      Cons.set_tail(list, acc)
      acc = list
      list = nxt
    end
    acc
  end

  def dedupe!(list)
    seen = Set[]
    prev = nil
    node = list
    while node
      if Set.include?(seen, Cons.get_head(node))
        Cons.set_tail(prev, Cons.get_tail(node))
      else
        Set.add(seen, Cons.get_head(node))
        prev = node
      end
      node = Cons.get_tail(node)
    end
    list
  end

  def partition(list, pivot)
    low = nil
    high = nil
    while list
      nxt = Cons.get_tail(list)
      if Cons.get_head(list) < pivot
        Cons.set_tail(list, low)
        low = list
      else
        Cons.set_tail(list, high)
        high = list
      end
      list = nxt
    end
    [reverse(low), reverse(high)]
  end

  def kth_from_end(list, k)
    lead = list
    Integer.times(k) do
      return nil unless lead
      lead = Cons.get_tail(lead)
    end
    trail = list
    while lead
      lead = Cons.get_tail(lead)
      trail = Cons.get_tail(trail)
    end
    trail ? Cons.get_head(trail) : nil
  end

  def palindrome?(list)
    n = length(list)
    return true if n < 2
    mid = list
    Integer.times((n + 1) / 2 - 1) { mid = Cons.get_tail(mid) }
    second = reverse(Cons.get_tail(mid))
    a = list
    b = second
    same = true
    while b
      same = false if Cons.get_head(a) != Cons.get_head(b)
      a = Cons.get_tail(a)
      b = Cons.get_tail(b)
    end
    Cons.set_tail(mid, reverse(second))
    same
  end

  def rotate_right(list, k)
    n = length(list)
    return list if n == 0 || k % n == 0
    cut = list
    Integer.times(n - k % n - 1) { cut = Cons.get_tail(cut) }
    new_head = Cons.get_tail(cut)
    Cons.set_tail(cut, nil)
    last = new_head
    while Cons.get_tail(last)
      last = Cons.get_tail(last)
    end
    Cons.set_tail(last, list)
    new_head
  end

  def interleave(a, b)
    return b if a == nil
    Cons.new(Cons.get_head(a), interleave(b, Cons.get_tail(a)))
  end

  def fold(list, acc)
    while list
      acc = yield(acc, Cons.get_head(list))
      list = Cons.get_tail(list)
    end
    acc
  end
end

nums = L.from(Array[4, 8, 4, 1, 9, 8, 2, 7, 1, 3])
puts("nums       #{L.show(nums)} length #{L.length(nums)}")
puts("3rd last   #{L.kth_from_end(nums, 3)}; 11th last #{Kernel.inspect(L.kth_from_end(nums, 11))}")
L.dedupe!(nums)
puts("deduped    #{L.show(nums)}")
low, high = L.partition(nums, 5)
puts("< 5        #{L.show(low)}")
puts(">= 5       #{L.show(high)}")
puts("sum/max    #{L.fold(low, 0) { |a, x| a + x }} / #{L.fold(high, 0) { |a, x| x > a ? x : a }}")
joined = L.interleave(low, high)
puts("interleave #{L.show(joined)}")
Array.each(Array[1, 3, 7, 0]) do |k|
  joined = L.rotate_right(joined, k)
  puts("rotate #{k}   #{L.show(joined)}")
end
puts("reversed   #{L.show(L.reverse(joined))}")

Array.each(Array["racecar", "level up", "abba", "abca", "x", ""]) do |w|
  chars = L.from(String.chars(w))
  result = L.palindrome?(chars)
  puts(format("%-10s palindrome=%-5s intact=%s", Kernel.inspect(w), result, Array.join(L.to_a(chars), "") == w))
end

words = L.from(String.split("pear apple pear fig apple kiwi fig plum", " "))
L.dedupe!(words)
short, long = L.partition(words, "g")
puts("words      #{L.show(words)}")
puts("before g   #{L.show(short)}, from g #{L.show(long)}")
puts("lengths    #{L.fold(L.interleave(short, long), "") { |acc, w| acc + Integer.to_s(String.size(w)) }}")
puts("empty      #{L.show(L.rotate_right(nil, 3))} #{L.palindrome?(nil)} #{Kernel.inspect(L.kth_from_end(nil, 1))}")
