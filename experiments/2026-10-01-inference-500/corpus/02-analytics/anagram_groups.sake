def word_list
  "listen silent enlist tinsel inlets google stone tones notes onset seton " +
  "angel glean angle evil vile live veil levi rat tar art star rats tars arts " +
  "night thing apple paple elbow below bowel state taste teats loop pool polo " +
  "dusty study cat act tac dog god heart earth hater"
end

def signature(word) = Array.join(Array.sort(String.chars(String.downcase(word))), "")

def group_anagrams(words)
  groups = Hash[]
  Array.each(words) do |w|
    key = signature(w)
    groups[key] ||= Array[]
    Array.push(groups[key], w) unless Array.include?(groups[key], w)
  end
  groups
end

def letter_counts(phrase)
  counts = Hash.new(0)
  String.each_char(String.downcase(phrase)) do |c|
    counts[c] += 1 if String.match?(c, /[a-z]/)
  end
  counts
end

def phrase_anagram?(a, b)
  ca = letter_counts(a)
  cb = letter_counts(b)
  return false if Hash.size(ca) != Hash.size(cb)
  Hash.all?(ca) { |c, n| cb[c] == n }
end

def missing_letters(a, b)
  ca = letter_counts(a)
  cb = letter_counts(b)
  diff = Array[]
  Array.each(Array.sort(Hash.keys(ca))) do |c|
    extra = ca[c] - cb[c]
    Array.push(diff, "#{c}x#{extra}") if extra > 0
  end
  diff
end

words = String.split(word_list, " ")
groups = group_anagrams(words)
puts("words: #{Array.size(words)}, signatures: #{Hash.size(groups)}")

multi = Hash.select(groups) { |k, ws| Array.size(ws) > 1 }
ordered = Array.sort_by(Hash.keys(multi)) { |k| k }
Array.each(ordered) do |k|
  ws = multi[k]
  puts(format("%-6s %d: %s", k, Array.size(ws), Array.join(Array.sort(ws), " ")))
end

loners = Array.sort(Array.flat_map(Hash.values(Hash.reject(groups) { |k, ws| Array.size(ws) > 1 })) { |ws| ws })
puts("no anagram partner: #{Array.join(loners, ", ")}")

largest = Hash.max_by(groups) { |k, ws| Array.size(ws) }
if largest
  k, ws = largest
  puts("largest group (#{k}): #{Array.join(ws, ", ")}")
end

by_len = Hash.new(0)
Hash.each(multi) { |k, ws| by_len[String.size(k)] += 1 }
Array.each(Array.sort(Hash.keys(by_len))) { |len| puts("groups with #{len} letters: #{by_len[len]}") }

phrases = Array[
  ["Dormitory", "Dirty room"],
  ["The eyes", "They see"],
  ["Astronomer", "Moon starer"],
  ["Conversation", "Voices rant on"],
  ["Hello world", "Word hollow"]
]
Array.each(phrases) do |a, b|
  if phrase_anagram?(a, b)
    puts("#{a} <-> #{b}: anagram")
  else
    puts("#{a} <-> #{b}: no (#{Array.join(missing_letters(a, b), " ")} | #{Array.join(missing_letters(b, a), " ")})")
  end
end
