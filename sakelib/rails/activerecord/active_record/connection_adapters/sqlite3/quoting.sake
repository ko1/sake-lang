# Port of activerecord-8.1.3/lib/active_record/connection_adapters/sqlite3/quoting.rb (partial: no
# column_name_matcher regexps)
#
# Ruby caches quoted names in a Concurrent::Map; here they are computed each time.

module ActiveRecord
  module ConnectionAdapters
    module SQLite3
      module Quoting
        def quote_column_name(c, name) = "\"#{String.gsub(Kernel.to_s(name), "\"", "\"\"")}\""

        def quote_table_name(c, name)
          "\"#{String.gsub(Kernel.to_s(name), "\"", "\"\"").String.gsub(".", "\".\"")}\""
        end

        def quote(c, value)
          case value
          in Float
            Float.finite?(value) ? super_quote(c, value) : "'#{value}'"
          else super_quote(c, value)
          end
        end

        # Ruby: ::SQLite3::Database.quote(s), which doubles single quotes
        def quote_string(c, s) = String.gsub(s, "'", "''")

        def quote_table_name_for_assignment(c, table, attr) = quote_column_name(c, attr)

        def quoted_time(c, value)
          value => Time
          t = Time.utc(2000, 1, 1, Time.hour(value), Time.min(value), Time.sec(value) + Rational(Time.nsec(value), 1_000_000_000))
          String.sub(quoted_date(c, t), /\A\d\d\d\d-\d\d-\d\d /, "2000-01-01 ")
        end

        def quoted_binary(c, value) = "x'#{ActiveModel::Type::Binary::Data.hex(value)}'"

        def unquoted_true(c) = 1
        def unquoted_false(c) = 0

        def type_cast(c, value)
          case value
          in BigDecimal then BigDecimal.to_f(value)
          in Rational then Rational.to_f(value)
          else super_type_cast(c, value)
          end
        end
      end
    end
  end
end
