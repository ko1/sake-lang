# Lottery checker: tickets and draws as Sets, prize tiers from match counts, hot and cold numbers.

def prize_table = Hash.of(6 => "jackpot", 5 => "second", 4 => "third", 3 => "fourth")

def draws
  Any[
    [Set.of(3, 11, 19, 27, 34, 45), 8],
    [Set.of(1, 11, 22, 27, 38, 41), 19],
    [Set.of(5, 11, 19, 30, 34, 49), 2],
    [Set.of(7, 14, 21, 28, 35, 42), 11]
  ]
end

def tickets
  Hash.of(
    "amy" => Any[Set.of(3, 11, 19, 27, 34, 40), Set.of(1, 2, 3, 4, 5, 6)],
    "ben" => Any[Set.of(5, 11, 19, 30, 34, 2)],
    "cat" => Any[Set.of(7, 14, 21, 28, 35, 49), Set.of(11, 19, 27, 34, 45, 3)],
    "dan" => Any[Set.of(10, 20, 30, 40, 44, 48), Set.of(6, 5, 4, 3, 2, 1)]
  )
end

def check(ticket, draw, bonus)
  hits = Set.size(ticket & draw)
  tier = prize_table[hits]
  tier = "second+bonus" if hits == 5 && Set.include?(ticket, bonus)
  [hits, tier]
end

results = Hash.new(0)
Array.each_with_index(draws) do |pair, i|
  draw, bonus = pair
  puts("draw #{i + 1}: #{Array.join(Set.sort(draw), " ")} + #{bonus}")
  Hash.each(tickets) do |name, list|
    Array.each_with_index(list) do |t, j|
      hits, tier = check(t, draw, bonus)
      next unless tier
      results[tier] += 1
      puts("  #{name} ticket #{j + 1}: #{hits} hits -> #{tier} (#{Array.join(Set.sort(t & draw), ",")})")
    end
  end
end
puts("prizes: #{Array.join(Array.map(Hash.to_a(results)) { |tier, n| "#{tier}=#{n}" }, " ")}")

all_drawn = Array.flat_map(draws) { |pair| Set.to_a(pair[0]) }
freq = Array.tally(all_drawn)
hot = Array.sort(Hash.keys(Hash.select(freq) { |n, c| c == Array.max(Hash.values(freq)) }))
puts("hottest: #{Array.join(hot, " ")} (#{Array.max(Hash.values(freq))} times)")
never = Range.reject(1..49) { |n| Hash.key?(freq, n) }
puts("never drawn: #{Array.size(never)} numbers, lowest #{Array.join(Array.take(never, 5), " ")}")
by_decade = Array.tally(Array.map(all_drawn) { |n| n / 10 * 10 })
puts("by decade: #{Array.join(Array.map(Array.sort(Hash.keys(by_decade))) { |d| "#{d}s:#{by_decade[d]}" }, " ")}")

puts("== Ticket quality ==")
Hash.each(tickets) do |name, list|
  best = Array.max_by(list) do |t|
    Array.sum(Array.map(draws) { |pair| Set.size(t & pair[0]) })
  end
  total = Array.sum(Array.map(draws) { |pair| Set.size(best & pair[0]) })
  odd = Set.count(best) { |n| Integer.odd?(n) }
  span = Set.max(best) - Set.min(best)
  puts(format("  %-3s best ticket %-20s total hits %2d, odd %d, span %d", name, Array.join(Set.sort(best), ","), total, odd, span))
end
same = Array.select(Array.combination(Array.flat_map(Hash.values(tickets)) { |l| l }, 2)) { |pair| Set.subset?(pair[0], pair[1]) && Set.superset?(pair[0], pair[1]) }
puts("identical tickets: #{Array.size(same)}")
