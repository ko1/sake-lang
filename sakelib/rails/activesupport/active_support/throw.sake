# Port of Ruby's Kernel#throw and Kernel#catch for ActiveSupport::Callbacks (Sake only)
#
# Callbacks halt with `throw :abort` (Rails 5+). Sake has neither, so they are an exception that `catch` takes back.
# Ruby's catch without a tag, and a value passed by throw, are left out: Rails throws only :abort.

class UncaughtThrowError < StandardError
  attr_reader tag
end

def throw(tag) = raise(UncaughtThrowError.new("uncaught throw #{Kernel.inspect(tag)}", tag))

# Ruby's catch(tag) { }: the block's value, or nil when a throw of tag left it.
def catch(tag)
  yield
rescue => e   # not `rescue UncaughtThrowError`: a program that never throws would get an unused-rescue warning
  raise e unless e in UncaughtThrowError
  raise e if UncaughtThrowError.tag(e) != tag
  nil
end
