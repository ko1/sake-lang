# A field read from a local is narrowed like a local, until something may change the field.
Node = Struct.new(:word, :n, :nxt)
class Node
  def shout(n)
    if @word
      puts "has a word"               # a built-in call without a block keeps the narrowing
      String.upcase(@word)
    else
      "-"
    end
  end
  def count(n)
    @n ||= 0                          # a write narrows: @n is an Integer after it
    @n + 1
  end
  def early(n)
    return "-" unless @word
    String.size(@word)
  end
  def kind(n)
    case @word
    in String then String.upcase(@word)
    in nil then "none"
    end
  end
end
def second_word(n)
  if Node.nxt(n) && Node.word(Node.nxt(n))
    String.upcase(Node.word(Node.nxt(n)))
  else
    "-"
  end
end
p Node.shout(Node.new("abc", nil, nil))
p Node.shout(Node.new(nil, nil, nil))
p Node.count(Node.new(nil, nil, nil))
p Node.early(Node.new("abcd", 1, nil))
p Node.kind(Node.new(nil, 1, nil))
p second_word(Node.new("a", 1, Node.new("b", 2, nil)))
p second_word(Node.new("a", 1, nil))
