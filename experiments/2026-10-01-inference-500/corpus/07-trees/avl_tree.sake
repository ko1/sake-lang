AvlNode = Struct.new(:key, :height, :left, :right)

class AvlNode
  def make(key) = AvlNode.new(key, 1, nil, nil)
end

class Stats < {accessor: [rotations]}
end

def h(n) = n == nil ? 0 : AvlNode.get_height(n)

def fix_height(n)
  lh = h(AvlNode.get_left(n))
  rh = h(AvlNode.get_right(n))
  AvlNode.set_height(n, (lh > rh ? lh : rh) + 1)
end

def balance(n) = h(AvlNode.get_left(n)) - h(AvlNode.get_right(n))

def rotate_right(n, st)
  Stats.set_rotations(st, Stats.get_rotations(st) + 1)
  l = AvlNode.get_left(n)
  AvlNode.set_left(n, AvlNode.get_right(l))
  AvlNode.set_right(l, n)
  fix_height(n)
  fix_height(l)
  l
end

def rotate_left(n, st)
  Stats.set_rotations(st, Stats.get_rotations(st) + 1)
  r = AvlNode.get_right(n)
  AvlNode.set_right(n, AvlNode.get_left(r))
  AvlNode.set_left(r, n)
  fix_height(n)
  fix_height(r)
  r
end

def rebalance(n, st)
  fix_height(n)
  b = balance(n)
  if b > 1
    AvlNode.set_left(n, rotate_left(AvlNode.get_left(n), st)) if balance(AvlNode.get_left(n)) < 0
    return rotate_right(n, st)
  end
  if b < -1
    AvlNode.set_right(n, rotate_right(AvlNode.get_right(n), st)) if balance(AvlNode.get_right(n)) > 0
    return rotate_left(n, st)
  end
  n
end

def insert(n, key, st)
  return AvlNode.make(key) if n == nil
  k = AvlNode.get_key(n)
  if key < k
    AvlNode.set_left(n, insert(AvlNode.get_left(n), key, st))
  elsif key > k
    AvlNode.set_right(n, insert(AvlNode.get_right(n), key, st))
  else
    return n
  end
  rebalance(n, st)
end

def remove_min(n, st)
  left = AvlNode.get_left(n)
  return AvlNode.get_right(n) if left == nil
  AvlNode.set_left(n, remove_min(left, st))
  rebalance(n, st)
end

def delete(n, key, st)
  return nil if n == nil
  k = AvlNode.get_key(n)
  if key < k
    AvlNode.set_left(n, delete(AvlNode.get_left(n), key, st))
  elsif key > k
    AvlNode.set_right(n, delete(AvlNode.get_right(n), key, st))
  else
    l = AvlNode.get_left(n)
    r = AvlNode.get_right(n)
    return l if r == nil
    m = r
    m = AvlNode.get_left(m) while AvlNode.get_left(m)
    AvlNode.set_right(m, remove_min(r, st))
    AvlNode.set_left(m, l)
    return rebalance(m, st)
  end
  rebalance(n, st)
end

def valid?(n, lo, hi)
  return true if n == nil
  k = AvlNode.get_key(n)
  return false if (lo != nil && k <= lo) || (hi != nil && k >= hi)
  return false if balance(n) > 1 || balance(n) < -1
  return false if AvlNode.get_height(n) != 1 + Array.max(Array[h(AvlNode.get_left(n)), h(AvlNode.get_right(n))])
  valid?(AvlNode.get_left(n), lo, k) && valid?(AvlNode.get_right(n), k, hi)
end

def keys(n, out)
  return out if n == nil
  keys(AvlNode.get_left(n), out)
  Array.push(out, AvlNode.get_key(n))
  keys(AvlNode.get_right(n), out)
end

def draw(n, depth, lines)
  return lines if n == nil
  draw(AvlNode.get_right(n), depth + 1, lines)
  Array.push(lines, "#{"    " * depth}#{AvlNode.get_key(n)}")
  draw(AvlNode.get_left(n), depth + 1, lines)
end

def level_order(root)
  levels = Array[]
  queue = Array[[root, 0]]
  until Array.empty?(queue)
    node, d = Array.shift(queue)
    next if node == nil
    Array.push(levels, Array[]) if Array.size(levels) <= d
    Array.push(levels[d], AvlNode.get_key(node))
    Array.push(queue, [AvlNode.get_left(node), d + 1])
    Array.push(queue, [AvlNode.get_right(node), d + 1])
  end
  levels
end

st = Stats.new(0)
root = nil
Range.each(1..15) { |i| root = insert(root, i, st) }
puts("ascending 1..15: height #{h(root)}, rotations #{Stats.get_rotations(st)}, valid #{valid?(root, nil, nil)}")
Array.each_with_index(level_order(root)) { |lv, d| puts("  level #{d}: #{Array.join(lv, " ")}") }

st2 = Stats.new(0)
root2 = nil
seq = Array[50, 20, 70, 10, 30, 25, 27, 26, 80, 90, 85, 60, 65, 64, 5, 1]
Array.each(seq) { |k| root2 = insert(root2, k, st2) }
root2 = insert(root2, 30, st2)
puts("mixed: height #{h(root2)}, rotations #{Stats.get_rotations(st2)}, valid #{valid?(root2, nil, nil)}")
Array.each(draw(root2, 0, Array[])) { |l| puts(l) }

Array.each(Array[20, 50, 99, 1, 5, 10]) do |k|
  before = Stats.get_rotations(st2)
  root2 = delete(root2, k, st2)
  puts("delete #{k}: root #{AvlNode.get_key(root2)}, height #{h(root2)}, +#{Stats.get_rotations(st2) - before} rotations, valid #{valid?(root2, nil, nil)}")
end
puts("keys: #{Array.join(keys(root2, Array[]), ",")}")
