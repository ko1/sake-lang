Exam = Struct.new(:course, :students, :slot)

class Exam
  def to_s(e) = "#{@course}(#{Set.size(@students)})"
end

def enrollments
  Hash[
    "amy" => Array["math", "physics", "art"],
    "bob" => Array["math", "chem"],
    "cat" => Array["physics", "chem", "bio"],
    "dan" => Array["art", "history"],
    "eva" => Array["bio", "history", "math"],
    "fox" => Array["music"],
    "gus" => Array["chem", "music", "art"],
    "hal" => Array["history", "physics"]
  ]
end

def build_exams(enr)
  exams = Hash[]
  Hash.each(enr) do |student, courses|
    Array.each(courses) do |c|
      exams[c] ||= Exam.new(c, Set[], nil)
      Set.add(Exam.get_students(exams[c]), student)
    end
  end
  exams
end

def conflicts(exams)
  graph = Hash[]
  names = Array.sort(Hash.keys(exams))
  Array.each(names) { |n| graph[n] = Set[] }
  Array.each_with_index(names) do |a, i|
    Array.each(Array.drop(names, i + 1)) do |b|
      shared = Exam.get_students(exams[a]) & Exam.get_students(exams[b])
      next if Set.empty?(shared)
      Set.add(graph[a], b)
      Set.add(graph[b], a)
    end
  end
  graph
end

# Welsh-Powell: most-constrained exams first, each gets the lowest free slot.
def assign_slots(exams, graph)
  order = Array.sort_by(Hash.keys(graph)) { |n| [-Set.size(graph[n]), n] }
  Array.each(order) do |name|
    used = Set[]
    Set.each(graph[name]) do |other|
      s = Exam.get_slot(exams[other])
      Set.add(used, s) if s
    end
    slot = 0
    slot += 1 while Set.include?(used, slot)
    Exam.set_slot(exams[name], slot)
  end
  Array.max(Array.map(Hash.values(exams)) { |e| Exam.get_slot(e) }) + 1
end

def verify(exams, graph)
  bad = Array[]
  Hash.each(graph) do |a, nbs|
    Set.each(nbs) do |b|
      next unless a < b
      Array.push(bad, "#{a}/#{b}") if Exam.get_slot(exams[a]) == Exam.get_slot(exams[b])
    end
  end
  bad
end

exams = build_exams(enrollments)
graph = conflicts(exams)
Array.each(Array.sort(Hash.keys(graph))) do |n|
  puts(format("%-8s clashes with %d: %s", n, Set.size(graph[n]), Array.join(Set.sort(graph[n]), ",")))
end
slots = assign_slots(exams, graph)
puts("slots needed: #{slots}")
Integer.times(slots) do |s|
  in_slot = Array.select(Hash.values(exams)) { |e| Exam.get_slot(e) == s }
  in_slot = Array.sort_by(in_slot) { |e| Exam.get_course(e) }
  seats = Array.sum(Array.map(in_slot) { |e| Set.size(Exam.get_students(e)) })
  puts("slot #{s + 1}: #{Array.join(in_slot, " ")} - #{seats} seats")
end
problems = verify(exams, graph)
puts(Array.empty?(problems) ? "schedule ok" : "clashes: #{Array.join(problems, " ")}")

per_student = Hash.map(enrollments) do |student, courses|
  ss = Array.sort(Array.map(courses) { |c| Exam.get_slot(exams[c]) + 1 })
  "#{student}:#{Array.join(ss)}"
end
puts(Array.join(per_student, " "))
