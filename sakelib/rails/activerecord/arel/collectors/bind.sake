# Port of activerecord-8.1.3/lib/arel/collectors/bind.rb
#
# Ruby's add_binds(binds, proc_for_binds) maps the binds through the proc (HomogeneousIn's lambda that makes
# an ActiveModel::Attribute per value); here proc_for_binds is the attribute name the lambda closed over.

module Arel
  module Collectors
    class Bind
      attr_reader binds
      attr_accessor retryable
      include Collector

      def initialize(c) = @binds ||= Any[]

      def <<(c, str) = c

      def add_bind(c, bind, &block)
        Array.push(@binds, bind)
        c
      end

      def add_binds(c, binds, proc_for_binds = nil, &block)
        if proc_for_binds
          Array.concat(@binds, Array.map(binds) { |value| ActiveModel::Attribute.with_cast_value(proc_for_binds, value, ActiveModel::Type.default_value) })
        else
          Array.concat(@binds, binds)
        end
        c
      end

      def value(c) = @binds
    end
  end
end
