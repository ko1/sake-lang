# Keyword parameters, with optional positional ones before them: the callee is known when the program
# is checked, so `k: v` goes to its parameter by name. Values are evaluated in the order written.
def greet(name, greeting = "Hello", punct: "!", times: 1)
  String.*("#{greeting}, #{name}#{punct}", times)
end

def area(w:, h: w) = w * h

p(greet("Ruby"))
p(greet("Ruby", "Hi"))
p(greet("Ruby", times: 2))
p(greet("Ruby", "Yo", punct: "?", times: 2))
p(greet("Ruby", times: 3, punct: "."))
p(area(w: 3))
p(area(h: 2, w: 5))
p(area(w: 1.5))

def trace(log, x)
  Array.push(log, x)
  x
end
log = Array[]
p(greet(trace(log, "A"), times: trace(log, 1), punct: trace(log, "~")))
p(log)

class Box < {reader: [:v]}
  def show(b, prefix: "<", suffix: ">") = "#{prefix}#{@v}#{suffix}"
end
b = Box.new(1)
p(Box.show(b, suffix: "]"))
p(b.Box.show(prefix: "["))

module Shape
  def name(s, upcase: false) = raise NotImplementedError
end
class Square < {reader: [:side]}
  include Shape
  def name(s, upcase: false) = upcase ? "SQUARE" : "square"
end
p(Shape.name(Square.new(2), upcase: true))
p(Shape.name(Square.new(2)))
