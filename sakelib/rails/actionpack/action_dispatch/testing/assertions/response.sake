# Port of actionpack-8.1.3/lib/action_dispatch/testing/assertions/response.rb (partial: assert_redirected_to of a Hash goes through the routes (no controller's url_for), no records, no Regexp)
#
# Rails' generate_response_message is a lambda given to `assert` (computed only on failure); here the message is
# computed when the assertion fails. RESPONSE_PREDICATES' `public_send` is a `case`.

module ActionDispatch
  module Assertions
    module ResponseAssertions
      def minitest(x) = raise(NotImplementedError)
      def response(x) = raise(NotImplementedError)
      def request(x) = raise(NotImplementedError)
      def routes(x) = raise(NotImplementedError)

      def response!(x)
        r = response(x)
        raise ArgumentError, "no response yet: make a request first" unless r
        r
      end

      def response_predicate(x, type)
        res = response!(x)
        case type
        in :success then Response.successful?(res)
        in :missing then Response.not_found?(res)
        in :redirect then Response.redirection?(res)
        in :error then Response.server_error?(res)
        end
      end

      # assert_response(:success), assert_response(404), assert_response(:created, "message")
      def assert_response(x, type, message = nil)
        res = response!(x)
        if type == :success || type == :missing || type == :redirect || type == :error
          ok = response_predicate(x, type)
          Assertions.assert(minitest(x), ok, ok ? "" : (message || generate_response_message(x, type, Response.response_code(res))))
        else
          expected = AssertionResponse.code(AssertionResponse.make(type))
          actual = Response.response_code(res)
          # Rails: assert_equal(code, response_code, message); a String message gets Minitest's diff after it
          text = expected == actual ? "" : (message ? Assertions.message(message, "", Assertions.diff(expected, actual)) : generate_response_message(x, type, actual))
          Assertions.assert(minitest(x), expected == actual, text)
        end
      end

      # assert_redirected_to("/posts/1"), assert_redirected_to(posts_url, status: :see_other)
      def assert_redirected_to(x, url_options = Hash.new, options = Hash.new, message = nil)
        status = options[:status] || :redirect
        assert_response(x, status, message)
        location = Response.location(response!(x))
        return true if (url_options in String) && url_options == location
        redirect_is = normalize_argument_to_redirection(x, location)
        redirect_expected = normalize_argument_to_redirection(x, url_options)
        msg = message || "Expected response to be a redirect to <#{redirect_expected}> but was a redirect to <#{redirect_is}>"
        ok = redirect_expected == redirect_is
        Minitest.count(minitest(x))          # assert_operator's assert_respond_to(redirect_expected, :===)
        Assertions.assert(minitest(x), ok, ok ? "" : Assertions.message(msg, ".", "Expected #{Assertions.mu_pp(redirect_expected)} to be === #{Assertions.mu_pp(redirect_is)}"))
      end

      def assert_in_body(x, text)
        body = Response.body(response!(x))
        ok = String.match?(body, Regexp.new(Regexp.escape(text)))
        Assertions.assert(minitest(x), ok, ok ? "" : "Expected #{Assertions.mu_pp(Regexp.new(Regexp.escape(text)))} to match #{Assertions.mu_pp(body)}.")
      end

      def assert_not_in_body(x, text)
        body = Response.body(response!(x))
        ok = !String.match?(body, Regexp.new(Regexp.escape(text)))
        Assertions.assert(minitest(x), ok, ok ? "" : "Expected #{Assertions.mu_pp(Regexp.new(Regexp.escape(text)))} to not match #{Assertions.mu_pp(body)}.")
      end

      # ActionController::Redirecting._compute_redirect_to_location(request, fragment)
      def normalize_argument_to_redirection(x, fragment)
        case fragment
        in String
          return fragment if String.match?(fragment, /\A([a-z][a-z\d\-+.]*:|\/\/).*/i)
          req = request(x)
          prefix = req ? "#{Request.protocol(req)}#{Request.host_with_port(req)}" : ""
          String.delete(prefix + fragment, "\0\r\n")
        in Hash
          req = request(x)
          opts = Hash.dup(fragment)
          if req
            opts[:host] ||= Request.host(req)
            opts[:protocol] ||= Request.protocol(req)
          end
          Routing::RouteSet.url_for(routes(x), opts)
        in nil then ""
        in Array  # a header Rack 3 allows as an Array: Ruby's url_for(Array) of Strings (polymorphic_url) raises
          raise ArgumentError, Array.empty?(fragment) ? "Nil location provided. Can't build URI." : "Please use symbols for polymorphic route arguments."
        end
      end

      def generate_response_message(x, expected, actual)
        res = response!(x)
        "Expected response to be a <#{code_with_name(x, expected)}>, but was a <#{code_with_name(x, actual)}>" +
          location_if_redirected(x) + exception_if_present(x) + response_body_if_short(x)
      end

      def response_body_if_short(x)
        body = Response.body(response!(x))
        String.size(body) > 500 ? "" : "\nResponse body: #{body}"
      end

      def exception_if_present(x)
        req = request(x)
        return "" unless req
        ex = Request.exception(req)
        return "" unless ex
        "\n\nException while processing request: #{ExceptionWrapper.class_name_of(ex)}: #{Exception.message(ex)}\n"
      end

      def location_if_redirected(x)
        res = response!(x)
        loc = Response.location(res)
        return "" unless Response.redirection?(res) && loc != nil && loc != ""
        " redirect to <#{normalize_argument_to_redirection(x, Kernel.to_s(loc))}>"
      end

      # code_with_name(:success) => "2XX: success", code_with_name(404) => "404: Not Found"
      def code_with_name(x, code_or_name)
        c = code_or_name
        c = :success if c == :successful
        c = :missing if c == :not_found
        c = :redirect if c == :redirection
        c = :error if c == :server_error
        AssertionResponse.code_and_name(AssertionResponse.make(c))
      end
    end
  end
end
