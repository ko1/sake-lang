# Schedules project tasks with dependencies in working days (topological
# order, earliest start/finish, slack, critical path) and draws a text Gantt chart.

class Task
  attr_reader id, name
  attr_accessor days
  attr_reader deps
  attr_accessor start = 0, finish = 0, late_start = 0
end

class CycleError < StandardError
  attr_reader path
end

def days_from_civil(y, m, d)
  y -= 1 if m <= 2
  era = y / 400
  yoe = y - era * 400
  doy = (153 * ((m + 9) % 12) + 2) / 5 + d - 1
  era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468
end

def civil_from_days(z)
  z += 719468
  era = z / 146097
  doe = z - era * 146097
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  mp = (5 * doy + 2) / 153
  m = mp < 10 ? mp + 3 : mp - 9
  [yoe + era * 400 + (m <= 2 ? 1 : 0), m, doy - (153 * mp + 2) / 5 + 1]
end

def wday(z) = (z + 4) % 7

# Calendar date of working day number n (0-based) counted from a Monday.
def workday_date(monday, n) = monday + (n / 5) * 7 + n % 5

def show(z)
  y, m, d = civil_from_days(z)
  format("%02d/%02d", m, d)
end

def topo_order(tasks)
  by_id = Hash[]
  Array.each(tasks) { |t| by_id[Task.id(t)] = t }
  state = Hash.new(:new)
  order = Task[]
  stack = Array[]
  Array.each(tasks) { |t| visit(by_id, state, order, stack, Task.id(t)) }
  order
end

def visit(by_id, state, order, stack, id)
  return if state[id] == :done
  if state[id] == :active
    raise CycleError.new("dependency cycle", Array.join(stack, " -> ") + " -> " + id)
  end
  t = by_id[id]
  raise KeyError, "unknown task #{id}" if t == nil
  state[id] = :active
  Array.push(stack, id)
  Array.each(Task.deps(t)) { |d| visit(by_id, state, order, stack, d) }
  Array.pop(stack)
  state[id] = :done
  Array.push(order, t)
end

def schedule(tasks)
  order = topo_order(tasks)
  finish_of = Hash[]
  Array.each(order) do |t|
    start = Array.max(Array.map(Task.deps(t)) { |d| Hash.fetch(finish_of, d) }) || 0
    Task.set_start(t, start)
    Task.set_finish(t, start + Task.days(t))
    finish_of[Task.id(t)] = Task.finish(t)
  end
  project_end = Array.max(Hash.values(finish_of))
  late_start = Hash[]
  Array.each(Array.reverse(order)) do |t|
    succ = Array.select(order) { |s| Array.include?(Task.deps(s), Task.id(t)) }
    late_finish = Array.empty?(succ) ? project_end : Array.min(Array.map(succ) { |s| Hash.fetch(late_start, Task.id(s)) })
    late_start[Task.id(t)] = late_finish - Task.days(t)
    Task.set_late_start(t, late_finish - Task.days(t))
  end
  [order, project_end]
end


def plan
  Task[
    Task.new("req", "Requirements", 4, String[]),
    Task.new("ux", "UX design", 6, String["req"]),
    Task.new("api", "API design", 3, String["req"]),
    Task.new("be", "Backend", 12, String["api"]),
    Task.new("fe", "Frontend", 10, String["ux", "api"]),
    Task.new("int", "Integration", 4, String["be", "fe"]),
    Task.new("doc", "Docs", 5, String["api"]),
    Task.new("qa", "QA", 6, String["int"]),
    Task.new("rel", "Release", 1, String["qa", "doc"])
  ]
end

kickoff = days_from_civil(2026, 10, 5)
order, total = schedule(plan)
puts("Project starts Mon #{show(kickoff)}, #{total} working days, ends #{show(workday_date(kickoff, total - 1))}")
puts
width = total
Array.each(order) do |t|
  s = Task.start(t)
  f = Task.finish(t)
  slack = Task.late_start(t) - s
  bar = " " * s + (slack == 0 ? "=" : "-") * (f - s) + " " * (width - f)
  puts(format("%-13s %s..%s |%s| slack %d", Task.name(t), show(workday_date(kickoff, s)), show(workday_date(kickoff, f - 1)), bar, slack))
end

critical = Array.select(order) { |t| Task.late_start(t) == Task.start(t) }
puts
puts("Critical path: #{Array.join(Array.map(critical) { |t| Task.id(t) }, " > ")}")
weekends = Range.count(kickoff..workday_date(kickoff, total - 1)) { |z| wday(z) == 0 || wday(z) == 6 }
puts("Calendar days: #{workday_date(kickoff, total - 1) - kickoff + 1}, of which weekend days: #{weekends}")

# What if the backend slips by 3 days?
slipped = plan
be = Array.find(slipped) { |t| Task.id(t) == "be" }
Task.set_days(be, Task.days(be) + 3) if be
o2, total2 = schedule(slipped)
puts("Backend +3 days: project #{total2 - total >= 0 ? "+" : ""}#{total2 - total} days")

# A broken plan with a cycle and one with a missing dependency.
broken = Task[Task.new("a", "A", 1, String["c"]), Task.new("b", "B", 1, String["a"]), Task.new("c", "C", 1, String["b"])]
begin
  schedule(broken)
rescue CycleError => e
  puts("Rejected: #{Exception.message(e)}: #{CycleError.path(e)}")
end
missing = Task[Task.new("x", "X", 2, String["y"])]
begin
  schedule(missing)
rescue KeyError => e
  puts("Rejected: #{Exception.message(e)}")
end
