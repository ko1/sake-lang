def compose(f, g) = proc { |x| Proc.call(f, Proc.call(g, x)) }
f0 = proc { |x| x + 0 }
f1 = proc { |x| x + 1 }
f2 = proc { |x| x + 2 }
f3 = proc { |x| x + 3 }
f4 = proc { |x| x + 4 }
f5 = proc { |x| x + 5 }
f6 = proc { |x| x + 6 }
f7 = proc { |x| x + 7 }
f8 = proc { |x| x + 8 }
f9 = proc { |x| x + 9 }
f10 = proc { |x| x + 10 }
f11 = proc { |x| x + 11 }
f12 = proc { |x| x + 12 }
f13 = proc { |x| x + 13 }
f14 = proc { |x| x + 14 }
f15 = proc { |x| x + 15 }
f16 = proc { |x| x + 16 }
f17 = proc { |x| x + 17 }
f18 = proc { |x| x + 18 }
f19 = proc { |x| x + 19 }
c = f0
c = compose(c, f1)
c = compose(c, f2)
c = compose(c, f3)
c = compose(c, f4)
c = compose(c, f5)
c = compose(c, f6)
c = compose(c, f7)
c = compose(c, f8)
c = compose(c, f9)
c = compose(c, f10)
c = compose(c, f11)
c = compose(c, f12)
c = compose(c, f13)
c = compose(c, f14)
c = compose(c, f15)
c = compose(c, f16)
c = compose(c, f17)
c = compose(c, f18)
c = compose(c, f19)
p Proc.call(c, 0)
p Proc.call(c, 0.5)
