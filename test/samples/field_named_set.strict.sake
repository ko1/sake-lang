# A field whose name starts with `set_` is its own field, not the one without the prefix.
class Jar
  attr_reader set_cookies, cookies
  attr_accessor count
  def get(jar, name) = @cookies[name]
  def set(jar, name, opts)
    @cookies[name] = "s"
    @set_cookies[name] = opts
    @count += 1
  end
end
jar = Jar.new(Hash.new, Hash.new, 0)
Jar.set(jar, "a", Hash.of(value: "x"))
Jar.set_count(jar, Jar.count(jar) + 1)
v = Jar.get(jar, "a")
p(String.size(v)) if v
p(Jar.set_cookies(jar))
p(Jar.count(jar))
