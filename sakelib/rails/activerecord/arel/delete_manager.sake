# Port of activerecord-8.1.3/lib/arel/delete_manager.rb

module Arel
  class DeleteManager
    private attr_reader table
    attr_reader ast
    include Arel::TreeManager
    include Arel::TreeManager::StatementMethods

    def initialize(m) = @ast = Nodes::DeleteStatement.new(@table)

    def from(m, relation)
      Nodes::DeleteStatement.set_relation(@ast, relation)
      m
    end

    def group(m, columns)
      Array.each(columns) do |column|
        c = case column
            in String then Nodes::SqlLiteral.new(column)
            in Symbol then Nodes::SqlLiteral.new(Symbol.to_s(column))
            else column
            end
        Array.push(Nodes::DeleteStatement.groups(@ast), Nodes::Group.new(c))
      end
      m
    end

    def having(m, expr)
      Array.push(Nodes::DeleteStatement.havings(@ast), expr)
      m
    end

    def comment(m, value)
      Nodes::DeleteStatement.set_comment(@ast, value)
      m
    end
  end
end
