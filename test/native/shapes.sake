# The "shapes" micro benchmark: a mixin call dispatched on the type of its argument, over an Array that
# holds three classes. ARGV[0] rounds; each round sums the area of 1,000 shapes.
module Shape
  def area(s) = raise NotImplementedError
  def name(s) = raise NotImplementedError
  def describe(s) = "#{Shape.name(s)}: #{Shape.area(s)}"
end

class Circle
  include Shape
  attr_reader r
  def area(c) = 3 * @r * @r
  def name(c) = "circle"
end

class Rect
  include Shape
  attr_reader w, h
  def area(x) = @w * @h
  def name(x) = "rect"
end

class Tri
  include Shape
  attr_reader b, h
  def area(t) = @b * @h / 2
  def name(t) = "tri"
end

rounds = String.to_i(Array.fetch(ARGV, 0))
shapes = Array[]
i = 0
while i < 1000
  case i % 3
  in 0 then Array.push(shapes, Circle.new(i))
  in 1 then Array.push(shapes, Rect.new(i, 2))
  else Array.push(shapes, Tri.new(i, 4))
  end
  i += 1
end
total = 0
k = 0
while k < rounds
  Array.each(shapes) { |s| total += Shape.area(s) }
  k += 1
end
puts(total)
puts(Shape.describe(Array.fetch(shapes, 1)))
