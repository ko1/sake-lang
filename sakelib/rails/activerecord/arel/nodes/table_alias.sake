# Port of activerecord-8.1.3/lib/arel/nodes/table_alias.rb
#
# Ruby aliases name to right and relation to left; here the fields keep Binary's names and the aliases are functions.

module Arel
  module Nodes
    class TableAlias
      attr_accessor left, right
      include Binary
      include Indexable
      def name(o) = @right
      def relation(o) = @left
      def table_alias(o) = @right
      def [](o, name)
        rel = @left
        case rel
        in Arel::Table then Arel::Table.[](rel, name, o)
        else Arel::Attributes::Attribute.new(o, Kernel.to_s(name))
        end
      end
      def table_name(o)
        rel = @left
        case rel
        in Arel::Table then Arel::Table.name(rel)
        else @right
        end
      end
      def type_cast_for_database(o, attr_name, value)
        rel = @left
        rel => Arel::Table
        Arel::Table.type_cast_for_database(rel, attr_name, value)
      end
      def type_for_attribute(o, name)
        rel = @left
        rel => Arel::Table
        Arel::Table.type_for_attribute(rel, name)
      end
      def able_to_type_cast?(o)
        rel = @left
        case rel
        in Arel::Table then Arel::Table.able_to_type_cast?(rel)
        else false
        end
      end
      def to_cte(o) = Cte.new(@right, @left)
    end
  end
end
