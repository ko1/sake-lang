# Port of railties-8.1.3/lib/rails/application/finisher.rb (partial: no autoloaders, reloader, executor, eager loading (Sake reads the whole program before it runs), built-in routes)

require "../application"   # Rails::Application is declared there (its fields), before this file reopens it
module Rails
  class Application
    module Finisher
      module_function

      def initializers
        list = Initializable::Initializer[]
        Initializable.add(list, :add_builtin_route, :finisher)
        Initializable.add(list, :setup_default_session_store, :finisher, before: :build_middleware_stack)
        Initializable.add(list, :build_middleware_stack, :finisher)
        Initializable.add(list, :set_routes_reloader_hook, :finisher)
        Initializable.add(list, :eager_load!, :finisher)
        Initializable.add(list, :finisher_hook, :finisher)
        list
      end

      def run(config, name)
        case name
        # Ruby (development): /rails/info and /rails/welcome routes; not ported (Rails::InfoController)
        in :add_builtin_route then nil
        # Ruby: the RoutesReloader loads config/routes.rb and draws the routes: Application.run_initializer does it
        # (it needs the app, and the app is the app's class, which this module cannot name)
        in :set_routes_reloader_hook then nil
        # Ruby: config.eager_load ? eager_load! : nil (here every file is loaded before the program runs)
        in :eager_load! then nil
        in :finisher_hook then nil
        # (Application.run_initializer runs these: they need the app)
        in :setup_default_session_store | :build_middleware_stack then nil
        else raise ArgumentError, "no finisher initializer #{name}"
        end
        nil
      end
    end
  end
end
