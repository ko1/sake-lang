straight   walk=abcdef         floyd: cyclic=false start=-1 len=0 steps=3  brent: 0/0  repeat=nil
rho        walk=abcdefghdefg   floyd: cyclic=true  start= 3 len=5 steps=5  brent: 3/5  repeat="d"
           repaired: abcdefgh cyclic=false
full loop  walk=pqrspqrspqrs   floyd: cyclic=true  start= 0 len=4 steps=4  brent: 0/4  repeat="p"
           repaired: pqrs cyclic=false
self loop  walk=xyzzzzzzzzzz   floyd: cyclic=true  start= 2 len=1 steps=2  brent: 2/1  repeat="z"
           repaired: xyz cyclic=false
single     walk=k              floyd: cyclic=false start=-1 len=0 steps=0  brent: 0/0  repeat=nil
tiny rho   walk=mnnnnnnnnnnn   floyd: cyclic=true  start= 1 len=1 steps=1  brent: 1/1  repeat="n"
           repaired: mn cyclic=false
