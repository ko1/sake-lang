require "optparse"

# optparse: build a parser, parse 300 argument lists, render the help.
op = OptionParser.new
OptionParser.on(op, "-v", "--[no-]verbose", "Run verbosely")
OptionParser.on(op, "-n", "--name NAME", "Name to use")
OptionParser.on(op, "-c", "--count N", :Integer, "How many")
OptionParser.on(op, "-r", "--ratio R", :Float, "Ratio")
OptionParser.on(op, "-l", "--level [LEVEL]", "Optional level")
OptionParser.on(op, "-t", "--type TYPE", Array["text", "binary", "bits"], "Select type")
OptionParser.on(op, "", "--dry-run", "Dry run")
OptionParser.on_tail(op, "-h", "--help", "Show this message")
n = 0
Integer.times(300) do |i|
  h = Hash[]
  rest = OptionParser.parse(op, String["-vq0", "--name=foo", "-c", "#{i}", "a", "--ratio", "1.5", "--ty", "bi", "--dry", "b", "-l3"], h) rescue String[]
  h2 = Hash[]
  rest = OptionParser.parse(op, String["-v", "--name=foo", "-c", "#{i}", "a", "--ratio", "1.5", "--ty", "bin", "--dry", "b", "-l3"], h2)
  n += Array.size(rest) + Hash.size(h2)
  n += String.size(OptionParser.help(op)) if i % 10 == 0
end
p(n)
