# The routes of controller_view (Rails' config/routes.rb), for the test and for its url helpers' generator
require "rails/actionpack/action_dispatch/routing"

class ActionDispatch::Routing::Mapper
  def view_routes(map)
    resources map, :posts
    Array.each(String["about", "home", "plain", "plain_with_layout", "bare", "other", "string", "negotiate", "missing", "partial", "helper"]) { |a| get map, a, to: "pages##{a}" }
    Array.each(String["home", "about", "fixed"]) { |a| get map, "admin/#{a}", to: "admin_pages##{a}" }
    Array.each(String["index", "with_admin", "required"]) { |a| get map, "nolayout/#{a}", to: "bare##{a}" }
  end
end

def view_route_set
  set = ActionDispatch::Routing::RouteSet.make
  ActionDispatch::Routing::RouteSet.draw(set) { |map| ActionDispatch::Routing::Mapper.view_routes(map) }
  set
end
