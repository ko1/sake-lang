# Planning a SELECT (spec 1.7, 3.3): resolves every name and checks every clause before any row is
# read, and gathers the result in a Plan for Query to execute.

# A result column: its resolved expression, its alias (nil if none) and, when the expression
# contains an aggregate call, that call's name as written (else nil).
class ResultItem
  attr_reader expr, alias_name, aggregate_name
end

# width:      number of columns of the FROM table; aggregate values follow them in a group row.
# items:      the ResultItems.
# where:      resolved WHERE, or nil.
# group:      resolved GROUP BY terms (empty: none).
# aggregates: the Aggregates of the whole query, in the order of their slots.
# grouped:    is it an aggregate query (3.3)? Then rows become group rows.
# having:     resolved HAVING, or nil.
# distinct:   SELECT DISTINCT?
# order:      the SortKeys of ORDER BY.
# limit, offset: Integers, or nil when absent.
class Plan
  attr_reader width, items, where, group, aggregates, grouped, having, distinct, order, limit, offset
end

module Planner
  module_function

  def plan(db, st)
    columns = source_columns(db, st)
    aggregates = Array[]
    items = result_items(st, columns, Scope.new(columns, Hash[], Hash[], aggregates, :function), aggregates)
    aliases = alias_exprs(items)

    where_scope = Scope.new(columns, aliases, blocked_aliases(items, :where), nil, :function)
    where = Resolver.resolve_optional(Select.where(st), where_scope)
    group = group_terms(st, items, columns, aliases)

    grouped = !Array.empty?(group) || !Array.empty?(aggregates)
    having = nil
    condition = Select.having(st)
    if condition != nil
      raise SqlError.new("HAVING clause on a non-aggregate query") unless grouped
      having = Resolver.resolve(condition, Scope.new(columns, aliases, Hash[], aggregates, :function))
    end
    order_scope = Scope.new(columns, aliases, Hash[], grouped ? aggregates : nil, :misuse)
    order = sort_keys(st, items, order_scope)
    Plan.new(Array.size(columns), items, where, group, aggregates, grouped, having, Select.distinct(st), order,
             cut(Select.limit(st)), cut(Select.offset(st)))
  end

  # The columns of the FROM table (none without FROM); SqlError if it does not exist.
  def source_columns(db, st)
    name = Select.from(st)
    return Array[] if name == nil
    Table.columns(Database.table(db, name))
  end

  # The result columns with `*` expanded and names resolved against the table's columns.
  def result_items(st, columns, scope, collector)
    items = Array[]
    Array.each(Select.items(st)) do |rc|
      e = ResultColumn.expr(rc)
      if e == nil
        raise SqlError.new("no tables specified") if Select.from(st) == nil
        Array.each_with_index(columns) do |c, i|
          Array.push(items, ResultItem.new(Col.new(Column.name(c), i, Column.type(c)), nil, nil))
        end
      else
        before = Array.size(collector)
        expr = Resolver.resolve(e, scope)
        first = Array.size(collector) > before ? Aggregate.name(Array.fetch(collector, before)) : nil
        Array.push(items, ResultItem.new(expr, ResultColumn.alias_name(rc), first))
      end
    end
    items
  end

  # lower-cased alias -> the aliased result column's expression (for WHERE, GROUP BY, HAVING and ORDER BY).
  def alias_exprs(items)
    h = Hash[]
    Array.each(items) do |item|
      a = ResultItem.alias_name(item)
      h[Value.lower(a)] = ResultItem.expr(item) if a != nil
    end
    h
  end

  # lower-cased alias -> the aliased result column's position (for a bare name in ORDER BY).
  def alias_positions(items)
    h = Hash[]
    Array.each_with_index(items) do |item, i|
      a = ResultItem.alias_name(item)
      h[Value.lower(a)] = i if a != nil
    end
    h
  end

  # The aliases of result columns that contain an aggregate call, with the error for using one in
  # `clause` (:where or :group_by).
  def blocked_aliases(items, clause)
    h = Hash[]
    Array.each(items) do |item|
      a = ResultItem.alias_name(item)
      name = ResultItem.aggregate_name(item)
      next if a == nil || name == nil
      h[Value.lower(a)] = Resolver.misuse_message(clause == :where ? :misuse : :group_by, name)
    end
    h
  end

  # ---- GROUP BY ----

  # The resolved GROUP BY terms; an integer term k is the k-th result column.
  def group_terms(st, items, columns, aliases)
    scope = Scope.new(columns, aliases, blocked_aliases(items, :group_by), nil, :group_by)
    Array.map(Array.each_with_index(Select.group(st))) do |term, i|
      k = ordinal(term)
      if k == nil
        Resolver.resolve(term, scope)
      else
        check_ordinal(k, i, Array.size(items), "GROUP BY")
        item = Array.fetch(items, k - 1)
        raise SqlError.new(Resolver.misuse_message(:group_by, "")) if ResultItem.aggregate_name(item) != nil
        ResultItem.expr(item)
      end
    end
  end

  # ---- ORDER BY ----

  def sort_keys(st, items, scope)
    positions = alias_positions(items)
    n = Array.size(items)
    Array.map(Array.each_with_index(Select.order(st))) do |term, i|
      e = OrderTerm.expr(term)
      k = ordinal(e)
      pos = -1
      expr = nil
      if k != nil
        check_ordinal(k, i, n, "ORDER BY")
        pos = k - 1
      elsif e in Col
        p = positions[Value.lower(Col.name(e))]
        if p == nil
          expr = Resolver.resolve(e, scope)
        else
          pos = p
        end
      else
        expr = Resolver.resolve(e, scope)
      end
      SortKey.new(pos, expr, OrderTerm.desc(term), OrderTerm.nulls(term))
    end
  end

  # k for a term that is the integer literal k or -k, else nil.
  def ordinal(e)
    case e
    in Lit
      v = Lit.value(e)
      (v in Integer) ? v : nil
    in Unary
      return nil unless Unary.op(e) == :neg
      inner = Unary.operand(e)
      return nil unless inner in Lit
      v = Lit.value(inner)
      (v in Integer) ? -v : nil
    else nil
    end
  end

  # The k of the (0-based) i-th term of `clause` must name one of the n result columns.
  def check_ordinal(k, i, n, clause)
    if k < 1 || k > n
      raise SqlError.new("#{ordinal_word(i + 1)} #{clause} term out of range - should be between 1 and #{n}")
    end
  end

  def ordinal_word(i)
    suffix = if i % 100 >= 11 && i % 100 <= 13
      "th"
    else
      case i % 10
      in 1 then "st"
      in 2 then "nd"
      in 3 then "rd"
      else "th"
      end
    end
    "#{i}#{suffix}"
  end

  # ---- LIMIT / OFFSET ----

  # The Integer value of a LIMIT / OFFSET expression (no row in scope), or nil if absent.
  def cut(e)
    return nil if e == nil
    v = Evaluator.evaluate(Resolver.resolve(e, Resolver.empty_scope), Array[])
    return nil if v == nil
    n = Value.to_number(v)
    (n in Integer) ? n : Float.to_i(n)
  end
end
