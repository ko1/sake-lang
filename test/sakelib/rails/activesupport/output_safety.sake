require "rails/activesupport/active_support/core_ext/string/output_safety"

# SafeBuffer, String#html_safe and ERB::Util (core_ext/string/output_safety, core_ext/erb/util)
buf = String.html_safe("<p>")
ActiveSupport::SafeBuffer.concat(buf, "<script>alert(1)</script>")
ActiveSupport::SafeBuffer.concat(buf, String.html_safe("<b>ok</b>"))
ActiveSupport::SafeBuffer.concat(buf, nil)
ActiveSupport::SafeBuffer.safe_concat(buf, "</p>")
puts(buf)
p(ActiveSupport::SafeBuffer.html_safe?(buf), Object.html_safe?("x"), Object.html_safe?(1), String.html_safe?("x"), ActiveSupport::SafeBuffer.length(buf))
both = String.html_safe("<i>") + "<u>"
p(ActiveSupport::SafeBuffer.to_s(both), ActiveSupport::SafeBuffer.html_safe?(both))
p(ActiveSupport::SafeBuffer.to_s(String.html_safe("<li>%s</li>") % "<x>"), ActiveSupport::SafeBuffer.to_s(String.html_safe("%s-%s") % Any["<a>", String.html_safe("<b>")]))
p(ActiveSupport::SafeBuffer.to_s(String.html_safe("<a href=\"%{url}\">") % Hash.of(url: "/?a=1&b=2")), ActiveSupport::SafeBuffer.to_s(String.html_safe("<hr>") * 2))
up = ActiveSupport::SafeBuffer.upcase(buf)
p(up, ActiveSupport::SafeBuffer.gsub(buf, "p>", "div>"))
copy = ActiveSupport::SafeBuffer.dup(buf)
ActiveSupport::SafeBuffer.upcase!(copy)
p(ActiveSupport::SafeBuffer.html_safe?(copy), ActiveSupport::SafeBuffer.html_safe?(buf))
ActiveSupport::SafeBuffer.concat(copy, "<now escaped? no>")
puts(copy)
begin
  ActiveSupport::SafeBuffer.safe_concat(copy, "x")
rescue ActiveSupport::SafeBuffer::SafeConcatError => e
  puts Exception.message(e)
end
p(ActiveSupport::SafeBuffer.to_s(ActiveSupport::SafeBuffer.[](buf, 0, 3) || String.html_safe("")), ActiveSupport::SafeBuffer.strip(String.html_safe("  x ")))
p(ActiveSupport::CoreExt::ERBUtil.html_escape("<a href='x'>&</a>"), ActiveSupport::SafeBuffer.to_s(ActiveSupport::CoreExt::ERBUtil.h(buf)), ActiveSupport::SafeBuffer.to_s(ActiveSupport::CoreExt::ERBUtil.h(12)))
p(ActiveSupport::SafeBuffer.to_s(ERB::Util.html_escape_once("1 < 2 &amp; 3 &#x27; &foo")), ERB::Util.json_escape("{\"x\":\"</script>&\"}"), ERB::Util.xml_name_escape("1 <bad> name"), ERB::Util.xml_name_escape("ok-name"))
