# A thread that ends with an error nobody reads (no Thread.value / Thread.join) is reported when the program ends.
t = Thread.new { raise "boom" }
Kernel.sleep(0.2)
u = Thread.new { raise ArgumentError, "read" }
begin
  Thread.join(u)
rescue ArgumentError => e
  puts "joined: #{Exception.message(e)}"
end
puts "end"
