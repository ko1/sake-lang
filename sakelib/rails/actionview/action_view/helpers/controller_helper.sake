# Port of actionview-8.1.3/lib/action_view/helpers/controller_helper.rb (partial: no delegation to a controller object)
#
# Rails delegates request, params, session, cookies, flash, action_name, ... and the controller's helper_methods
# (protect_against_forgery?, form_authenticity_token) to the view's controller. Here they are functions of the
# view with Rails' defaults for a view without a controller; a controller's view class overrides them.

module ActionView
  module Helpers
    module ControllerHelper
      def request(v) = raise(NotImplementedError)

      # Rails: `defined?(protect_against_forgery?) && protect_against_forgery?` is false without a controller
      def protect_against_forgery?(v) = false
      def form_authenticity_token(v, form_options: nil) = ""
      def request_forgery_protection_token(v) = :authenticity_token
      def controller_name(v) = nil
      def action_name(v) = nil
    end
  end
end
