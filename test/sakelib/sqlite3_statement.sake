# SQLite3::Statement as ActiveRecord's sqlite3 adapter runs a query: prepare, bind, step or read all, columns, types.
db = SQLite3::Database.new(":memory:")
SQLite3::Database.execute_batch(db, "create table users (id integer primary key, name varchar(40) not null, born date, score decimal(5, 2), data blob)")
ins = SQLite3::Database.prepare(db, "insert into users (name, born, score) values (?, ?, ?)")
Array.each(Any[["ann", "1990-01-02", 9.5], ["bob", nil, 7]]) do |name, born, score|
  before = SQLite3::Database.total_changes(db)
  SQLite3::Statement.reset!(ins)
  SQLite3::Statement.bind_params(ins, Any[name, born, score])
  p SQLite3::Statement.step(ins)
  puts "affected #{SQLite3::Database.total_changes(db) > before ? SQLite3::Database.changes(db) : 0} id #{SQLite3::Database.last_insert_row_id(db)}"
end
p SQLite3::Statement.column_count(ins)
SQLite3::Statement.close(ins)
sel = SQLite3::Database.prepare(db, "select id, name, born, score, data, upper(name) from users where id > ?")
p SQLite3::Statement.column_count(sel)
p SQLite3::Statement.columns(sel)
p SQLite3::Statement.types(sel)
SQLite3::Statement.bind_params(sel, Any[0])
p SQLite3::Statement.to_a(sel)
p SQLite3::Statement.done?(sel)
p SQLite3::Statement.execute(sel, Any[1])
SQLite3::Statement.reset!(sel)
SQLite3::Statement.bind_params(sel, Any[0])
p SQLite3::Statement.step(sel)
p SQLite3::Statement.closed?(sel)
SQLite3::Statement.close(sel)
p SQLite3::Statement.closed?(sel)
p SQLite3::Database.total_changes(db)
begin
  SQLite3::Statement.step(sel)
rescue SQLite3::Exception => e
  puts Exception.message(e)
end
begin
  SQLite3::Statement.bind_params(SQLite3::Database.prepare(db, "select ?"), Any[1, 2])
rescue SQLite3::RangeException => e
  puts Exception.message(e)
end
