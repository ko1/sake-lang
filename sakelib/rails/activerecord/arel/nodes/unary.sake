# Port of activerecord-8.1.3/lib/arel/nodes/unary.rb (partial: no hash/eql?; Cube, DistinctOn, GroupingElement,
# GroupingSet, Lateral and RollUp, which only the PostgreSQL visitor writes, are left out)
#
# Ruby's class Unary (attr_accessor :expr, alias :value :expr) is a module here; each unary node class
# declares `attr_accessor expr`. Ruby makes the classes with const_set(name, Class.new(Unary)) in a loop.

module Arel
  module Nodes
    module Unary
      include NodeExpression
      def expr(o) = raise(NotImplementedError)
      def set_expr(o, v) = raise(NotImplementedError)
      def value(o) = expr(o)
    end

    class Bin
      attr_accessor expr
      include Unary
    end

    class Group
      attr_accessor expr
      include Unary
    end

    class Limit
      attr_accessor expr
      include Unary
    end

    class Lock
      attr_accessor expr
      include Unary
    end

    class Not
      attr_accessor expr
      include Unary
    end

    class Offset
      attr_accessor expr
      include Unary
    end

    class On
      attr_accessor expr
      include Unary
    end

    class OptimizerHints
      attr_accessor expr
      include Unary
    end
  end
end
