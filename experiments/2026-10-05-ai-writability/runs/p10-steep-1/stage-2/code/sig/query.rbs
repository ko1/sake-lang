module Sql
  module Query
    class Entry
      attr_reader values: Array[value]
      attr_reader keys: Array[value]
      attr_reader index: Integer

      def initialize: (Array[value] values, Array[value] keys, Integer index) -> void
    end

    def self.run: (Ast::Select statement, Catalog catalog) -> Array[String]
    def self.bound: (Ast::Expr? expr) -> Integer?
    def self.compare_entries: (Entry left, Entry right, Array[Ast::OrderTerm] terms) -> Integer
    def self.compare_keys: (value a, value b, Ast::OrderTerm term) -> Integer
  end
end
