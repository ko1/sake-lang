def pieces(word, w)
  out = Array[]
  rest = word
  while String.size(rest) > w
    Array.push(out, String.slice(rest, 0, w - 1) + "-")
    rest = String.slice(rest, w - 1, String.size(rest))
  end
  Array.push(out, rest)
  out
end

def justify(ws, w)
  k = Array.size(ws)
  return Array.join(ws, " ") if k == 1
  len = 0
  Array.each(ws) { |x| len += String.size(x) }
  gaps = k - 1
  extra = w - len
  base = extra / gaps
  rem = extra % gaps
  out = ""
  Array.each_with_index(ws) do |x, i|
    out += x
    if i < gaps
      out += " " * (base + (i < rem ? 1 : 0))
    end
  end
  out
end

lines = IO.readlines(IO.stdin())
head = Array.empty?(lines) ? "" : String.strip(lines[0])
if !String.match?(head, /\A\d+\z/) || String.to_i(head) < 2 || String.to_i(head) > 80
  puts("invalid width")
  exit
end
w = String.to_i(head)

paras = Array[]
cur = Array[]
total_words = 0
Array.each(Array.drop(lines, 1)) do |raw|
  ws = String.scan(String.chomp(raw), /[^ \t]+/)
  if Array.empty?(ws)
    unless Array.empty?(cur)
      Array.push(paras, cur)
      cur = Array[]
    end
  else
    total_words += Array.size(ws)
    Array.each(ws) { |x| Array.each(pieces(x, w)) { |pc| Array.push(cur, pc) } }
  end
end
Array.push(paras, cur) unless Array.empty?(cur)

border = "+" + "-" * w + "+"
puts(border)
nlines = 0
Array.each_with_index(paras) do |words, pi|
  puts("|" + " " * w + "|") if pi > 0
  rows = Array[]
  line = Array[]
  llen = 0
  Array.each(words) do |x|
    if Array.empty?(line)
      line = Array[x]
      llen = String.size(x)
    elsif llen + 1 + String.size(x) <= w
      Array.push(line, x)
      llen += 1 + String.size(x)
    else
      Array.push(rows, line)
      line = Array[x]
      llen = String.size(x)
    end
  end
  Array.push(rows, line)
  Array.each_with_index(rows) do |r, ri|
    s = ri < Array.size(rows) - 1 ? justify(r, w) : Array.join(r, " ")
    puts("|" + String.ljust(s, w) + "|")
    nlines += 1
  end
end
puts(border)
puts("paragraphs: #{Array.size(paras)}, lines: #{nlines}, words: #{total_words}")
