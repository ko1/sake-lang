# Scalar functions (spec 1.11). The resolver checks name and arity once; `call` runs one.
module Functions
  module_function

  def known?(fn)
    case fn
    in "length" | "upper" | "lower" | "abs" | "typeof" | "coalesce" | "ifnull" | "nullif" then true
    else false
    end
  end

  def arity_ok?(fn, count)
    case fn
    in "length" | "upper" | "lower" | "abs" | "typeof" then count == 1
    in "coalesce" then count >= 2
    in "ifnull" | "nullif" then count == 2
    else false
    end
  end

  # `args` are already-evaluated values.
  def call(fn, args)
    x = Array.fetch(args, 0)
    case fn
    in "length" then x == nil ? nil : String.length(Value.text_form(x))
    in "upper" then x == nil ? nil : Value.upper(Value.text_form(x))
    in "lower" then x == nil ? nil : Value.lower(Value.text_form(x))
    in "abs" then absolute(x)
    in "typeof" then type_of(x)
    in "coalesce" then Array.find(args) { it != nil }
    in "ifnull" then x == nil ? Array.fetch(args, 1) : x
    in "nullif" then null_if(x, Array.fetch(args, 1))
    end
  end

  def absolute(x)
    case x
    in nil then nil
    in Integer then Integer.abs(x)
    in Float then Float.abs(x)
    in String then Float.abs(Arithmetic.to_f(Value.numeric_prefix(x)))
    end
  end

  def type_of(x)
    case x
    in nil then "null"
    in Integer then "integer"
    in Float then "real"
    in String then "text"
    end
  end

  # x unless x = y (no affinity); a NULL on either side never equals.
  def null_if(x, y)
    return x if x == nil || y == nil
    Value.compare(x, y) == 0 ? nil : x
  end
end
