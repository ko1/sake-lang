# Port of activesupport-8.1.3/lib/active_support/core_ext/date/conversions.rb (partial: inspect is not replaced, to_time and xmlschema are not redefined)
#
# Ruby aliases Date#inspect to readable_inspect ("Sun, 10 Mar 2024"); sakelib/date's Date.inspect cannot be
# redefined, so `p(date)` prints Ruby's own Date#inspect and readable_inspect is called by name.

require "date"
require "../../inflector/methods"

class Date
  def date_formats = once do
    Hash.of(short: "%d %b", long: "%B %d, %Y", db: "%Y-%m-%d", inspect: "%Y-%m-%d", number: "%Y%m%d",
            rfc822: "%d %b %Y", rfc2822: "%d %b %Y")
  end

  def to_fs(d, format = :default)
    case format
    in :long_ordinal then Date.strftime(d, "%B #{ActiveSupport::Inflector.ordinalize(@day)}, %Y")
    in :iso8601 then Date.iso8601(d)
    else
      formatter = date_formats[format]
      formatter ? Date.strftime(d, formatter) : Date.to_s(d)
    end
  end

  def to_formatted_s(d, format = :default) = to_fs(d, format)
  def readable_inspect(d) = Date.strftime(d, "%a, %d %b %Y")
end
