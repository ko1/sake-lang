<%= form_with view, model: Any[article, Comment::ActiveRecord_Associations_CollectionProxy.build(Article.comments(article))] do |form| %>
  <p>
    <%= FormBuilder.label form, :commenter %><br>
    <%= FormBuilder.text_field form, :commenter %>
  </p>
  <p>
    <%= FormBuilder.label form, :body %><br>
    <%= FormBuilder.textarea form, :body %>
  </p>
  <p>
    <%= FormBuilder.submit form %>
  </p>
<% end %>
