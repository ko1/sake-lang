Block = Struct.new(:kind, :lines, :level)

def escape_html(s)
  String.gsub(String.gsub(String.gsub(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
end

def inline(text)
  out = ""
  rest = text
  while (m = String.match(rest, /`([^`]+)`/))
    out += format_spans(MatchData.pre_match(m)) + "<code>" + escape_html(m[1]) + "</code>"
    rest = MatchData.post_match(m)
  end
  out + format_spans(rest)
end

def format_spans(text)
  s = escape_html(text)
  s = String.gsub(s, /\*\*(.+?)\*\*/, "<strong>\\1</strong>")
  s = String.gsub(s, /\*(.+?)\*/, "<em>\\1</em>")
  s = String.gsub(s, /\[([^\]]+)\]\(([^)\s]+)\)/, "<a href=\"\\2\">\\1</a>")
  s
end

def classify(line)
  if String.match?(line, /\A```/)
    :fence
  elsif String.match?(line, /\A\#{1,6} /)
    :heading
  elsif String.match?(line, /\A\s*[-*] /)
    :bullet
  elsif String.match?(line, /\A\s*\d+\. /)
    :numbered
  elsif String.match?(line, /\A> ?/)
    :quote
  elsif String.empty?(String.strip(line))
    :blank
  else
    :text
  end
end

def blocks_of(source)
  blocks = Block[]
  in_code = false
  prev_blank = false
  Array.each(String.split(source, "\n")) do |line|
    kind = classify(line)
    current = Array.last(blocks)
    if in_code
      if kind == :fence
        in_code = false
      else
        Array.push(Block.lines(current), line)
      end
      next
    end
    after_blank = prev_blank
    prev_blank = kind == :blank
    case kind
    in :fence
      in_code = true
      Array.push(blocks, Block.new(:code, Array[], 0))
    in :heading
      hashes = String.match(line, /\A(#+) /)[1]
      Array.push(blocks, Block.new(:heading, Array[String.strip(line[String.size(hashes)..])], String.size(hashes)))
    in :blank
      nil
    else
      item = String.sub(line, /\A\s*([-*]|\d+\.|>) ?/, "")
      list_kind = kind == :bullet ? :ul : (kind == :numbered ? :ol : (kind == :quote ? :quote : :para))
      if current != nil && Block.kind(current) == list_kind && kind != :text
        Array.push(Block.lines(current), item)
      elsif current != nil && Block.kind(current) == :para && kind == :text && !after_blank
        Array.push(Block.lines(current), item)
      else
        Array.push(blocks, Block.new(list_kind, Array[item], 0))
      end
    end
  end
  blocks
end

def render(block)
  lines = Block.lines(block)
  case Block.kind(block)
  in :heading
    lvl = Block.level(block)
    "<h#{lvl}>#{inline(lines[0])}</h#{lvl}>"
  in :para then "<p>#{inline(Array.join(lines, " "))}</p>"
  in :quote then "<blockquote>#{inline(Array.join(lines, " "))}</blockquote>"
  in :code then "<pre><code>" + escape_html(Array.join(lines, "\n")) + "</code></pre>"
  in :ul | :ol
    tag = Symbol.to_s(Block.kind(block))
    items = Array.map(lines) { |l| "  <li>#{inline(l)}</li>" }
    "<#{tag}>\n" + Array.join(items, "\n") + "\n</#{tag}>"
  end
end

def document
  "# Release *notes* for v2\n" +
  "\n" +
  "This release makes **operations** carry their type & removes `x.y` calls.\n" +
  "See [the tutorial](docs/tutorial.md) for <details>.\n" +
  "\n" +
  "## Changes\n" +
  "- Added `Array.tally`\n" +
  "- Fixed **nil** hints\n" +
  "* Faster *startup*\n" +
  "\n" +
  "1. Install\n" +
  "2. Run `sake --strict=0 a.sake`\n" +
  "\n" +
  "> Types belong on operations,\n" +
  "> not on variables.\n" +
  "\n" +
  "```\n" +
  "puts(String.upcase(\"<b>\"))\n" +
  "  # indented & kept\n" +
  "```\n" +
  "Final words."
end

blocks = blocks_of(document)
Array.each(blocks) { |b| puts(render(b)) }
counts = Array.tally(Array.map(blocks) { |b| Block.kind(b) })
puts("<!-- " + Array.join(Array.map(Hash.to_a(counts)) { |k, n| "#{k}:#{n}" }, " ") + " -->")
