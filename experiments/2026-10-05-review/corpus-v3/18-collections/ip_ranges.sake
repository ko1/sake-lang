# GeoIP-style lookup: CIDR blocks become Integer Ranges; lookups use bsearch; overlaps and coverage.

class Block
  attr_reader cidr, range, label
end

class InvalidAddress < StandardError
  attr_reader text
end

def parse_ip(s)
  parts = String.split(s, ".")
  raise InvalidAddress.new("expected 4 octets", s) unless Array.size(parts) == 4
  Array.reduce(parts, 0) do |acc, part|
    raise InvalidAddress.new("bad octet #{part}", s) unless String.match?(part, /\A\d{1,3}\z/)
    n = String.to_i(part)
    raise InvalidAddress.new("octet out of range #{n}", s) unless Range.cover?(0..255, n)
    (acc << 8) | n
  end
end

def ip_to_s(n) = Array.join(Array.map(Array[24, 16, 8, 0]) { |sh| (n >> sh) & 255 }, ".")

def parse_cidr(text, label)
  addr, bits = String.split(text, "/")
  base = parse_ip(addr)
  size = 1 << (32 - String.to_i(bits))
  start = base & (0xFFFFFFFF ^ (size - 1))
  Block.new(text, start..(start + size - 1), label)
end

def table
  rows = Array[
    ["10.0.0.0/8", "private"], ["192.168.0.0/16", "private"], ["203.0.113.0/24", "docs-net"],
    ["198.51.100.0/25", "docs-a"], ["198.51.100.128/25", "docs-b"], ["8.8.8.0/24", "dns"],
    ["100.64.0.0/10", "cgnat"], ["192.168.10.0/24", "lab"]
  ]
  Array.sort_by(Array.map(rows) { |c, l| parse_cidr(c, l) }) { |b| Range.begin(Block.get_range(b)) }
end

def lookup(blocks, ip)
  idx = Array.bsearch(Range.to_a(0...Array.size(blocks))) { |i| Range.end(Block.get_range(blocks[i])) >= ip }
  matches = Array.select(blocks) { |b| Range.cover?(Block.get_range(b), ip) }
  return nil if Array.empty?(matches)
  best = Array.min_by(matches) { |b| Range.size(Block.get_range(b)) }
  [best, idx]
end

blocks = table
puts("blocks:")
Array.each(blocks) do |b|
  r = Block.get_range(b)
  puts(format("  %-18s %-15s - %-15s %8d  %s", Block.get_cidr(b), ip_to_s(Range.begin(r)), ip_to_s(Range.end(r)), Range.size(r), Block.get_label(b)))
end

puts("lookups:")
Array.each(Array["10.1.2.3", "192.168.10.77", "192.168.3.4", "198.51.100.200", "8.8.4.4", "100.127.255.255", "300.1.1.1", "1.2.3"]) do |text|
  ip = parse_ip(text)
  found = lookup(blocks, ip)
  if found
    b, idx = found
    puts(format("  %-16s %-8s (%s)", text, Block.get_label(b), Block.get_cidr(b)))
  else
    puts(format("  %-16s unknown", text))
  end
rescue InvalidAddress => e
  puts(format("  %-16s invalid: %s", InvalidAddress.get_text(e), Exception.message(e)))
end

puts("nested or overlapping:")
Array.each(Array.combination(blocks, 2)) do |x, y|
  a = Block.get_range(x)
  b = Block.get_range(y)
  next unless Range.overlap?(a, b)
  kind = Range.cover?(a, Range.begin(b)) && Range.cover?(a, Range.end(b)) ? "contains" : "overlaps"
  puts("  #{Block.get_cidr(x)} #{kind} #{Block.get_cidr(y)}")
end

adjacent = Array.select(Array.combination(blocks, 2)) { |x, y| Range.end(Block.get_range(x)) + 1 == Range.begin(Block.get_range(y)) }
Array.each(adjacent) { |x, y| puts("adjacent: #{Block.get_cidr(x)} + #{Block.get_cidr(y)}") }

by_label = Hash.transform_values(Array.group_by(blocks) { |b| Block.get_label(b) }) { |bs| Array.sum(Array.map(bs) { |b| Range.size(Block.get_range(b)) }) }
total = Array.sum(Hash.values(by_label))
puts("address share:")
Array.each(Hash.sort_by(by_label) { |l, n| -n }) do |l, n|
  puts(format("  %-9s %5.2f%%", l, n * 100.0 / total))
end
first_octets = Array.to_set(Array.map(blocks) { |b| Range.begin(Block.get_range(b)) >> 24 })
puts("first octets used: #{Array.join(Set.sort(first_octets), " ")}")
