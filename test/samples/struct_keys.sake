# Struct values, Arrays, Sets and Hashes can be Hash keys and Set elements; they compare as == does.
P = Struct.new(:x, :y)
seen = Set.new
Set.add(seen, P.new(1, 2))
p(Set.include?(seen, P.new(1, 2)))
counts = Hash.new(0)
Array.each(Any[P.new(0, 0), P.new(0, 0), P.new(1, 0)]) { |pt| counts[pt] += 1 }
p(Hash.values(counts))
cycles = Hash.new
cycles[Any[1, 2, 3]] = "loop"
p(cycles[Any[1, 2, 3]])
p(Array.uniq(Any[Set.of(1, 2), Set.of(2, 1)]))
V = Struct.new(:n)
class V
  include Comparable
  def <=>(a, b) = @n <=> V.n(b)
end
s = Set.new
Set.add(s, V.new(1))
