# Port of activerecord-8.1.3/lib/active_record/callbacks.rb (partial: callbacks name methods (no blocks, no
# callback objects); after_touch is declared but touch runs it only through touch)
#
# Ruby: `define_model_callbacks :initialize, :find, :touch, only: :after` and `define_model_callbacks :save,
# :create, :update, :destroy` in the included block, and `before_save :x` (ActiveModel::Callbacks) is
# `set_callback :save, :before, :x`. The generator writes every model's callbacks with ActiveSupport::Callbacks'
# generator: these define_callbacks, then the model's lines mapped onto set_callback (generate/active_record.sake),
# so `_run_save_callbacks` & co. exist on every model. The overrides of Ruby's super chain:

module ActiveRecord
  module Callbacks
    def CALLBACK_KINDS = Symbol[:initialize, :find, :touch, :validation, :validate, :save, :create, :update, :destroy, :commit, :rollback]

    # Ruby's Callbacks#create_or_update: _run_save_callbacks { super }
    def create_or_update(r) = _run_save_callbacks(r) { persistence_create_or_update(r) } == true

    # Ruby's Callbacks#_create_record (under Timestamp's): _run_create_callbacks { super }
    def callbacks__create_record(r) = _run_create_callbacks(r) { dirty__create_record(r) }

    # Ruby's Callbacks#_update_record: _run_update_callbacks { record_update_timestamps { super } }
    def callbacks__update_record(r)
      _run_update_callbacks(r) do
        record_update_timestamps(r)
        dirty__update_record(r)
      end
    end

    # Ruby's Callbacks#destroy: _run_destroy_callbacks { super }, false when a callback halted
    def callbacks_destroy(r)
      result = _run_destroy_callbacks(r) { persistence_destroy(r) }
      result == false ? false : r
    end

    # A halted before_* callback (throw :abort) makes run_callbacks return false, as Ruby's
    def halted_callback_hook(r, filter, name) = nil
  end
end
