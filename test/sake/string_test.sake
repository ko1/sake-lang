require "minitest"

# String: the operations a program uses most, checked against Ruby's results.
suite = Minitest.suite("string")

Minitest.test(suite, "case, strip, chomp, reverse, size") do |t|
  Minitest.assert_equal(t, "HELLO", String.upcase("Hello"))
  Minitest.assert_equal(t, "hello", String.downcase("Hello"))
  Minitest.assert_equal(t, "Hello", String.capitalize("hELLO"))
  Minitest.assert_equal(t, "hELLO", String.swapcase("Hello"))
  Minitest.assert_equal(t, "a b", String.strip("  a b \n"))
  Minitest.assert_equal(t, "a b \n", String.lstrip("  a b \n"))
  Minitest.assert_equal(t, "line", String.chomp("line\n"))
  Minitest.assert_equal(t, "lin", String.chop("line"))
  Minitest.assert_equal(t, "cba", String.reverse("abc"))
  Minitest.assert_equal(t, 3, String.size("abc"))
  Minitest.assert_equal(t, 3, String.length("日本語"))
  Minitest.assert_equal(t, 9, String.bytesize("日本語"))
  Minitest.assert(t, String.empty?(""))
end

Minitest.test(suite, "split, join, chars, lines, scan") do |t|
  Minitest.assert_equal(t, Array["a", "b", "c"], String.split("a,b,c", ","))
  Minitest.assert_equal(t, Array["a", "b,c"], String.split("a,b,c", ",", 2))
  Minitest.assert_equal(t, Array["a", "b"], String.split("a  b"))
  Minitest.assert_equal(t, Array["a", "b"], String.chars("ab"))
  Minitest.assert_equal(t, Array["x\n", "y"], String.lines("x\ny"))
  Minitest.assert_equal(t, Array["12", "34"], String.scan("a12b34", /\d+/))
  Minitest.assert_equal(t, Array[["1", "2"], ["3", "4"]], String.scan("12 34", /(\d)(\d)/))
  Minitest.assert_equal(t, "a-b", Array.join(Array["a", "b"], "-"))
end

Minitest.test(suite, "search: include?, index, start_with?, count, match") do |t|
  Minitest.assert(t, String.include?("hello", "ell"))
  Minitest.assert_equal(t, 1, String.index("hello", "e"))
  Minitest.assert_equal(t, 3, String.index("hello", "l", 3))
  Minitest.assert_nil(t, String.index("hello", "z"))
  Minitest.assert_equal(t, 3, String.rindex("hello", "l"))
  Minitest.assert(t, String.start_with?("hello", "he"))
  Minitest.assert(t, String.end_with?("hello", "lo"))
  Minitest.assert_equal(t, 2, String.count("hello", "l"))
  m = String.match("2024-07", /(\d+)-(\d+)/)
  Minitest.assert_equal(t, "07", m ? m[2] : "")
  Minitest.assert(t, String.match?("abc", /b/))
  Minitest.assert_equal(t, 1, "abc" =~ /b/)
end

Minitest.test(suite, "replace: sub, gsub, tr, delete, squeeze") do |t|
  Minitest.assert_equal(t, "hallo", String.sub("hello", "e", "a"))
  Minitest.assert_equal(t, "h*ll*", String.gsub("hello", /[eo]/, "*"))
  Minitest.assert_equal(t, "h[e]ll[o]", String.gsub("hello", /[eo]/) { |c| "[#{c}]" })
  Minitest.assert_equal(t, "hEllO", String.gsub("hello", /[eo]/, Hash["e" => "E", "o" => "O"]))
  Minitest.assert_equal(t, "hippo", String.tr("hello", "el", "ip"))
  Minitest.assert_equal(t, "heo", String.delete("hello", "l"))
  Minitest.assert_equal(t, "helo", String.squeeze("hello"))
  Minitest.assert_equal(t, "fix", String.delete_prefix("prefix", "pre"))
  Minitest.assert_equal(t, "pre", String.delete_suffix("prefix", "fix"))
end

Minitest.test(suite, "numbers and symbols: to_i, to_f, to_sym, ord, chr, format") do |t|
  Minitest.assert_equal(t, 42, String.to_i("42abc"))
  Minitest.assert_equal(t, 0, String.to_i("abc"))
  Minitest.assert_equal(t, 1.5, String.to_f("1.5"))
  Minitest.assert_equal(t, 255, String.hex("ff"))
  Minitest.assert_equal(t, 8, String.oct("10"))
  Minitest.assert_equal(t, :ab, String.to_sym("ab"))
  Minitest.assert_equal(t, 97, String.ord("a"))
  Minitest.assert_equal(t, "a", Integer.chr(97))
  Minitest.assert_equal(t, "003", Kernel.format("%03d", 3))
  Minitest.assert_equal(t, "3.14", Kernel.format("%.2f", 3.14159))
  Minitest.assert_equal(t, "x=1", "x=%d" % 1)
  Minitest.assert_equal(t, "a|b", "%s|%s" % ["a", "b"])
  Minitest.assert_match(t, /invalid value for Integer/, Minitest.assert_raises(t) { Kernel.Integer("x") })
end

Minitest.test(suite, "padding, slicing, bytes") do |t|
  Minitest.assert_equal(t, "ab   ", String.ljust("ab", 5))
  Minitest.assert_equal(t, "   ab", String.rjust("ab", 5))
  Minitest.assert_equal(t, "-ab--", String.center("ab", 5, "-"))
  Minitest.assert_equal(t, "ell", "hello"[1, 3])
  Minitest.assert_equal(t, "ell", "hello"[1..3])
  Minitest.assert_equal(t, "h", "hello"[0])
  Minitest.assert_nil(t, "hello"[9])
  Minitest.assert_equal(t, "ell", String.slice("hello", 1, 3))
  Minitest.assert_equal(t, Array[104, 105], String.bytes("hi"))
  Minitest.assert_equal(t, "ASCII-8BIT", String.encoding(String.b("あ")))
  Minitest.assert_equal(t, "UTF-8", String.encoding("あ"))
  Minitest.assert_equal(t, "ab", String.succ("aa"))
  Minitest.assert_equal(t, "b", String.next("a"))
end

Minitest.test(suite, "interpolation and to_s of values") do |t|
  Minitest.assert_equal(t, "1 and a", "#{1} and #{:a}")
  Minitest.assert_equal(t, "[1, 2]", "#{[1, 2]}")
  Minitest.assert_equal(t, "[1, 2]", Kernel.to_s(Array[1, 2]))
  Minitest.assert_equal(t, "{a: 1}", Kernel.inspect(Hash[a: 1]))
  Minitest.assert_equal(t, "\"x\"", Kernel.inspect("x"))
  Minitest.assert_equal(t, "nil", Kernel.inspect(nil))
  Minitest.assert_equal(t, "", Kernel.to_s(nil))
end

Minitest.run(suite)
