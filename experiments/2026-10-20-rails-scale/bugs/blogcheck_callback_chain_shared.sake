# Containers made at one site are one container to the checker, so an element pushed into one shows up in all.
# Here: "Named.name_of dispatches on its first argument, which is Rec; the types that include Named are Ctl", at
# line 26, reached by run(rec_chain, ...); rec_chain is empty (Ruby prints true twice).
# Seen in the blog's check: ActiveSupport::Callbacks::ClassMethods.new_callbacks (`Hash.new`) makes every class's
# chains, so a model's save chain (Session, User, Article, Comment, Current) was taken to hold the controllers'
# AbstractController::Callbacks::ActionFilter (`before_action ..., only:`), whose match? asks the target its
# action_name (abstract_controller/callbacks.sake:52, 56, 64). Workaround in the port: ActionFilter#match? raises
# NoMethodError unless the target includes AbstractController::Callbacks, as Ruby's controller.action_name would.
module Cond
  def match?(f, target) = raise(NotImplementedError)
end
module Named
  def name_of(x) = raise(NotImplementedError)
end
class Ctl
  attr_reader name
  include Named
  def name_of(c) = @name
end
class Rec
  attr_reader id
end
class ByName
  attr_reader names
  include Cond
  def match?(f, target) = Array.include?(@names, Named.name_of(target))
end
def new_chain = Any[]
def run(chain, target) = Array.all?(chain) { |c| Cond.match?(c, target) }
ctl_chain = new_chain
Array.push(ctl_chain, ByName.new(String["a"]))
rec_chain = new_chain
p(run(ctl_chain, Ctl.new("a")))
p(run(rec_chain, Rec.new(1)))
