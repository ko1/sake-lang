module Sql
  class Table
    attr_reader name: String
    attr_reader columns: Array[Column]
    attr_reader rows: Array[Array[value]]

    @rowid: Integer?
    @uniques: Array[Array[Integer]]

    def initialize: (String name, Array[Column] columns, Integer? rowid, Array[Array[Integer]] uniques) -> void
    def self.from_statement: (Ast::CreateTable statement) -> Table
    def self.positions: (Array[Ast::ColumnDef] definitions, Array[String] names) -> Array[Integer]
    def column_index: (String name) -> Integer?
    def default_row: () -> Array[value]
    def insert_rows: (Array[Array[value]] raw_rows) -> void
    def update_rows: (Array[[Integer, Array[value]]] changes) -> void
    def delete_rows: (Array[bool] doomed) -> void

    private

    def checked_row: (Array[value] raw, Array[Array[value]] others, Integer? skip) -> Array[value]
    def key_value: (value given, Array[Array[value]] others, bool inserting) -> Integer
    def next_key: (Array[Array[value]] others) -> Integer
    def duplicate?: (Array[Integer] positions, Array[value] row, Array[Array[value]] others, Integer? skip) -> bool
    def unique_message: (Array[Integer] positions) -> String
  end
end
