module Sql
  class CallSlots
    attr_reader all: Array[Ast::SlotExpr]
    attr_reader aggregates: Array[Ast::Aggregate]
    attr_reader windows: Array[Ast::WindowCall]
    attr_reader window_defs: WindowDefs

    @width: Integer
    @by_signature: Hash[String, Ast::Aggregate]

    def initialize: (Integer width, WindowDefs window_defs) -> void
    def width: () -> Integer
    def add_aggregate: (String name, String function, Array[Ast::Expr] args, bool distinct, bool star, Array[Ast::OrderTerm] order_by) -> Ast::Aggregate
    def add_window: (String name, String function, Array[Ast::Expr] args, Ast::WindowSpec spec, Ast::Frame frame, Ast::Aggregate? aggregate) -> Ast::WindowCall
  end
end
