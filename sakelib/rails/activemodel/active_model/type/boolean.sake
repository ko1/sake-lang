# Port of activemodel-8.1.3/lib/active_model/type/boolean.rb

module ActiveModel
  module Type
    class Boolean
      attr_reader precision, scale, limit
      include Value
      include Helpers::Immutable

      def initialize(t) = nil

      def false_values
        once { Set.of(false, 0, "0", :"0", "f", :f, "F", :F, "false", :false, "FALSE", :FALSE, "off", :off, "OFF", :OFF) }
      end

      def type(t) = :boolean
      def serialize(t, value) = cast(t, value)
      def serialize_cast_value(t, value) = value

      def cast_value(t, value) = value == "" ? nil : !Set.include?(false_values, value)
    end
  end
end
