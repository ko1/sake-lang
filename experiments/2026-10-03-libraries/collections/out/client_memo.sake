# collections: generic containers for Sake.
#
# Each container is a class:
#
#   Heap          binary min-heap ordered by `<`; push_with(h, key, v) orders by key only
#   LRU, LruNode  least-recently-used cache: Hash key -> node, doubly linked recency list
#   Deque         growable ring buffer, push/pop at both ends
#
# A Struct field has one type per program, so a ready-made type used with two element types
# sees the union of both. For a second element type, declare your own type as a copy of the
# ready-made one (`class IntHeap < Heap`, see the client programs): each copy gets its own
# field types. Allocate the Arrays/Hashes at the call (`IntHeap.new(Integer[])`), not in a
# shared function.

# ---------------------------------------------------------------- Heap
# Fields: items (an Array), seq (an Integer, for push_with).
class Heap
  attr_reader items
  attr_accessor seq = 0
  def create = Heap.new(Array[])

  def size(h) = Array.size(@items)
  def empty?(h) = Array.empty?(@items)
  def peek(h) = Array.first(@items)

  def push(h, x)
    Array.push(@items, x)
    sift_up(h, Array.size(@items) - 1)
    h
  end

  # Order by key and never compare the values: stores [key, seq, v]; seq keeps ties FIFO.
  def push_with(h, key, v)
    @seq += 1
    push(h, [key, @seq, v])
  end

  def pop(h)
    items = @items
    return nil if Array.empty?(items)
    top = Array.fetch(items, 0)
    last = Array.fetch(items, -1)
    Array.pop(items)
    unless Array.empty?(items)
      items[0] = last
      sift_down(h, 0)
    end
    top
  end

  # pop for an entry made by push_with: its value.
  def pop_value(h)
    e = pop(h)
    return nil unless e
    _k, _s, v = e
    v
  end

  # Yields the elements in order, emptying the heap.
  def drain(h)
    x = pop(h)
    while x != nil          # pop's nil means empty; checking it keeps nil out of the block
      yield(x)
      x = pop(h)
    end
    h
  end

  def sift_up(h, i)
    items = @items
    while i > 0
      parent = (i - 1) / 2
      break unless Array.fetch(items, i) < Array.fetch(items, parent)
      items[i], items[parent] = Array.fetch(items, parent), Array.fetch(items, i)
      i = parent
    end
  end

  def sift_down(h, i)
    items = @items
    n = Array.size(items)
    while true
      l = 2 * i + 1
      r = l + 1
      m = i
      m = l if l < n && Array.fetch(items, l) < Array.fetch(items, m)
      m = r if r < n && Array.fetch(items, r) < Array.fetch(items, m)
      break if m == i
      items[i], items[m] = Array.fetch(items, m), Array.fetch(items, i)
      i = m
    end
  end
end

# ---------------------------------------------------------------- LRU
# A node type includes LruNodeOps (fields key, value, prev, nxt), so a copy of LRU can
# link its own node type: `class PNode < LruNode`, and `class PCache < LRU` with its make_node.

module LruNodeOps
  def node_key(n) = @key
  def node_value(n) = @value
  def node_prev(n) = @prev
  def node_next(n) = @nxt
  def set_node_value(n, v) = @value = v
  def set_node_prev(n, m) = @prev = m
  def set_node_next(n, m) = @nxt = m
end

class LruNode
  attr_reader key
  attr_accessor value, prev = nil, nxt = nil
  include LruNodeOps
end

class LRU
  attr_reader capacity, index
  attr_accessor head = nil, tail = nil, hits = 0, misses = 0
  def create(capacity) = LRU.new(capacity, Hash[])

  # A copy (class C < LRU) redefines make_node to make its own node type.
  def make_node(c, key, value) = LruNode.new(key, value)

  def size(c) = Hash.size(@index)

  def unlink(c, node)
    pr = LruNodeOps.node_prev(node)
    nx = LruNodeOps.node_next(node)
    if pr
      LruNodeOps.set_node_next(pr, nx)
    else
      @head = nx
    end
    if nx
      LruNodeOps.set_node_prev(nx, pr)
    else
      @tail = pr
    end
    LruNodeOps.set_node_prev(node, nil)
    LruNodeOps.set_node_next(node, nil)
  end

  def push_front(c, node)
    old = @head
    LruNodeOps.set_node_next(node, old)
    LruNodeOps.set_node_prev(old, node) if old
    @head = node
    @tail = node unless @tail
  end

  def touch(c, node)
    unlink(c, node)
    push_front(c, node)
    LruNodeOps.node_value(node)
  end

  # The value for key (now the most recent), or nil.
  def get(c, key)
    node = @index[key]
    unless node
      @misses += 1
      return nil
    end
    @hits += 1
    touch(c, node)
  end

  def put(c, key, value)
    node = @index[key]
    if node
      LruNodeOps.set_node_value(node, value)
      touch(c, node)
      return value
    end
    node = make_node(c, key, value)
    @index[key] = node
    push_front(c, node)
    evict(c) if Hash.size(@index) > @capacity
    value
  end

  def evict(c)
    old = @tail
    return nil unless old
    unlink(c, old)
    Hash.delete(@index, LruNodeOps.node_key(old))
    old
  end

  # The cached value, or the block's value for key (then cached).
  def fetch(c, key)
    node = @index[key]
    if node
      @hits += 1
      return touch(c, node)
    end
    @misses += 1
    put(c, key, yield(key))
  end

  # Yields key and value, most recent first.
  def each(c)
    node = @head
    while node
      yield(LruNodeOps.node_key(node), LruNodeOps.node_value(node))
      node = LruNodeOps.node_next(node)
    end
    c
  end

  def stats(c) = "hits=#{@hits} misses=#{@misses} size=#{Hash.size(@index)}/#{@capacity}"
end

# ---------------------------------------------------------------- Deque
# Fields: buf (an Array, usually empty at first: Integer[], String[]), start, count.
class Deque
  attr_reader buf
  attr_accessor start = 0, count = 0
  def create = Deque.new(Array[])

  def size(d) = @count
  def empty?(d) = @count == 0
  def capacity(d) = Array.size(@buf)
  def slot(d, i) = (@start + i) % Array.size(@buf)

  def grow(d, x)
    old = @buf
    cap = Array.size(old)
    return Array.push(old, x) if cap == 0
    # Append a copy: the wrapped run [0, start) reappears at [cap, cap+start), right after
    # [start, cap), so start stays valid. Grows in place, so no new Array is allocated here.
    Integer.times(cap) { |i| Array.push(old, Array.fetch(old, i)) }
  end

  def push_back(d, x)
    grow(d, x) if @count == Array.size(@buf)
    @buf[slot(d, @count)] = x
    @count += 1
    d
  end

  def push_front(d, x)
    grow(d, x) if @count == Array.size(@buf)
    @start = (@start - 1) % Array.size(@buf)
    @buf[@start] = x
    @count += 1
    d
  end

  def pop_front(d)
    return nil if @count == 0
    x = Array.fetch(@buf, @start)
    @start = (@start + 1) % Array.size(@buf)
    @count -= 1
    x
  end

  def pop_back(d)
    return nil if @count == 0
    @count -= 1
    Array.fetch(@buf, slot(d, @count))
  end

  def front(d) = @count == 0 ? nil : Array.fetch(@buf, @start)
  def back(d) = @count == 0 ? nil : Array.fetch(@buf, slot(d, @count - 1))

  def at(d, i)
    raise IndexError.new("deque index #{i} outside 0...#{@count}") if i < 0 || i >= @count
    Array.fetch(@buf, slot(d, i))
  end

  def each(d)
    Integer.times(@count) { |i| yield(Array.fetch(@buf, slot(d, i))) }
    d
  end
end
# ---- client_memo.sake (line 1 of the client is line 277 here)
# Memoizing with the LRU cache: an Integer -> Integer cache for a recursive count, and a
# String -> Tuple cache for a slow parse, in one program.

# Number of ways to climb n stairs taking 1, 2 or 3 steps; the LRU (capacity 8) keeps the
# recent sub-results, so the recursion reuses them.
def ways(cache, n)
  return 1 if n == 0
  return 0 if n < 0
  LRU.fetch(cache, n) { |k| ways(cache, k - 1) + ways(cache, k - 2) + ways(cache, k - 3) }
end

c = LRU.create(8)
puts("ways(30) = #{ways(c, 30)}")
puts(LRU.stats(c))
keys = Integer[]
LRU.each(c) { |k, v| Array.push(keys, k) }
p(keys)

# A second cache with other key/value types gets its own node and cache types.
class ParseNode < LruNode
end
class ParseCache < LRU
  def make_node(c, key, value) = ParseNode.new(key, value)
end

def parse_point(cache, s)
  ParseCache.fetch(cache, s) do |text|
    xs = String.split(text, ",")
    [String.to_i(Array.fetch(xs, 0)), String.to_i(Array.fetch(xs, 1))]
  end
end

pc = ParseCache.new(2, Hash[])
inputs = String.split("1,2 3,4 1,2 5,6 3,4 1,2", " ")
sum_x = 0
Array.each(inputs) do |s|
  x, y = parse_point(pc, s)
  sum_x += x
  puts("#{s} -> x+y=#{x + y}")
end
puts("sum_x=#{sum_x}  #{ParseCache.stats(pc)}")
ParseCache.each(pc) { |k, v| puts("  cached #{k} => #{v}") }
