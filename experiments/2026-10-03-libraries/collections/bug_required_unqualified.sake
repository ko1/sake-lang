# A required function (body `raise NotImplementedError`) called unqualified inside the module:
# an includer that lacks it is not reported before running; it raises NotImplementedError.
# Written as `Shape.area(s)` (dispatch), the same program is reported statically.
module Shape
  def area(s) = raise(NotImplementedError)
  def describe(s) = "area #{area(s)}"
end
class Circle < {reader: [r]}
  include Shape
end
puts(Circle.describe(Circle.new(1)))
