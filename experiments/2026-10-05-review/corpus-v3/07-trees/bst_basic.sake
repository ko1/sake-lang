class Node
  attr_accessor key, value, left, right

  def leaf?(n) = @left == nil && @right == nil
end

def insert(node, key, value)
  return Node.new(key, value, nil, nil) if node == nil
  k = Node.key(node)
  if key < k
    Node.set_left(node, insert(Node.left(node), key, value))
  elsif key > k
    Node.set_right(node, insert(Node.right(node), key, value))
  else
    Node.set_value(node, value)
  end
  node
end

def search(node, key)
  while node
    k = Node.key(node)
    return Node.value(node) if key == k
    node = key < k ? Node.left(node) : Node.right(node)
  end
  nil
end

def min_node(node)
  left = Node.left(node)
  while left
    node = left
    left = Node.left(node)
  end
  node
end

def delete(node, key)
  return nil if node == nil
  k = Node.key(node)
  if key < k
    Node.set_left(node, delete(Node.left(node), key))
  elsif key > k
    Node.set_right(node, delete(Node.right(node), key))
  else
    left = Node.left(node)
    right = Node.right(node)
    return right if left == nil
    return left if right == nil
    succ = min_node(right)
    Node.set_key(node, Node.key(succ))
    Node.set_value(node, Node.value(succ))
    Node.set_right(node, delete(right, Node.key(succ)))
  end
  node
end

def each_inorder(node, &block)
  return if node == nil
  each_inorder(Node.left(node), &block)
  yield(Node.key(node), Node.value(node))
  each_inorder(Node.right(node), &block)
end

def height(node)
  return 0 if node == nil
  1 + Array.max(Array[height(Node.left(node)), height(Node.right(node))])
end

def count_leaves(node)
  return 0 if node == nil
  return 1 if Node.leaf?(node)
  count_leaves(Node.left(node)) + count_leaves(Node.right(node))
end

def range_keys(node, lo, hi, out)
  return out if node == nil
  k = Node.key(node)
  range_keys(Node.left(node), lo, hi, out) if lo < k
  Array.push(out, k) if lo <= k && k <= hi
  range_keys(Node.right(node), lo, hi, out) if k < hi
  out
end

def floor_key(node, key)
  best = nil
  while node
    k = Node.key(node)
    return k if k == key
    if k < key
      best = k
      node = Node.right(node)
    else
      node = Node.left(node)
    end
  end
  best
end

def kth_smallest(node, k)
  i = 0
  result = nil
  each_inorder(node) do |key, _v|
    i += 1
    result = key if i == k
  end
  result
end

words = String.split("mango kiwi apple peach banana cherry grape lemon fig date plum", " ")
root = nil
Array.each_with_index(words) { |w, i| root = insert(root, w, i * 10) }
root = insert(root, "kiwi", 999)

puts("size: #{Array.size(range_keys(root, "", "zzzz", Array[]))}")
puts("height: #{height(root)}")
puts("leaves: #{count_leaves(root)}")
pairs = Array[]
each_inorder(root) { |k, v| Array.push(pairs, "#{k}=#{v}") }
puts(Array.join(pairs, " "))
Array.each(Array["kiwi", "fig", "orange"]) do |w|
  v = search(root, w)
  puts(v ? "#{w} -> #{v}" : "#{w} missing")
end
puts("between c and l: #{Array.join(range_keys(root, "c", "l", Array[]), ",")}")
puts("floor(coconut): #{floor_key(root, "coconut")}")
fl = floor_key(root, "aardvark")
puts("floor(aardvark): #{fl == nil ? "none" : fl}")
puts("3rd smallest: #{kth_smallest(root, 3)}")

Array.each(Array["mango", "apple", "zebra", "peach"]) do |w|
  root = delete(root, w)
  keys = Array[]
  each_inorder(root) { |k, _v| Array.push(keys, k) }
  puts("after delete #{w}: #{Array.join(keys, " ")} (h=#{height(root)}, root=#{Node.key(root)})")
end
