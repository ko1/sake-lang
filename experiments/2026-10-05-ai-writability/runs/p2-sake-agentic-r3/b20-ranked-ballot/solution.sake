def pct(c, active)
  return "0.0%" if active == 0
  t = (c * 2000 + active) / (2 * active)
  "#{t / 10}.#{t % 10}%"
end

lines = IO.readlines(IO.stdin)
cands = Array.size(lines) > 0 ? Array.uniq(String.split(lines[0])) : Array[]
if Array.size(cands) == 0
  puts("no candidates")
  exit(0)
end
nc = Array.size(cands)
idx = Hash.new
i = 0
while i < nc
  idx[cands[i]] = i
  i += 1
end

ballots = Array[]
rejected = 0
k = 1
while k < Array.size(lines)
  text = String.chomp(lines[k])
  no = k + 1
  k += 1
  next if String.match?(text, /\A *\z/)
  ranks = Array.map(String.split(text, ">", -1)) { |s| String.strip(s) }
  seen = Array[]
  reason = nil
  Array.each(ranks) do |name|
    if reason == nil
      if name == ""
        reason = "empty rank"
      elsif idx[name] == nil
        reason = "unknown candidate #{name}"
      elsif Array.include?(seen, idx[name])
        reason = "duplicate #{name}"
      else
        Array.push(seen, idx[name])
      end
    end
  end
  if reason == nil
    Array.push(ballots, seen)
  else
    puts("rejected line #{no}: #{reason}")
    rejected += 1
  end
end
puts("ballots: #{Array.size(ballots)} valid, #{rejected} rejected")

elim = Array.new(nc, false)
hist = Array[]
round = 0
while true
  round += 1
  counts = Array.new(nc, 0)
  active = 0
  Array.each(ballots) do |b|
    f = Array.find(b) { |ci| !elim[ci] }
    if f != nil
      counts[f] += 1
      active += 1
    end
  end
  Array.push(hist, counts)
  cont = Array.select(Range.to_a(0...nc)) { |ci| !elim[ci] }
  cont = Array.sort_by(cont) { |ci| [-counts[ci], cands[ci]] }
  puts("round #{round}")
  Array.each(cont) { |ci| puts("  #{cands[ci]} #{counts[ci]} #{pct(counts[ci], active)}") }
  puts("  exhausted #{Array.size(ballots) - active}")
  if active == 0
    puts("no winner")
    break
  end
  win = Array.find(cont) { |ci| counts[ci] * 2 > active }
  if win != nil
    puts("winner #{cands[win]}")
    break
  end
  mn = Array.min(Array.map(cont) { |ci| counts[ci] })
  tied = Array.select(cont) { |ci| counts[ci] == mn }
  r = round - 2
  while Array.size(tied) > 1 && r >= 0
    h = hist[r]
    m2 = Array.min(Array.map(tied) { |ci| h[ci] })
    tied = Array.select(tied) { |ci| h[ci] == m2 }
    r -= 1
  end
  tied = Array.sort_by(tied) { |ci| cands[ci] }
  out = tied[Array.size(tied) - 1]
  puts("  eliminated #{cands[out]}")
  elim[out] = true
end
