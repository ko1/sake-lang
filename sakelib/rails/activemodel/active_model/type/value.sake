# Port of activemodel-8.1.3/lib/active_model/type/value.rb (partial: no as_json, no hash)
#
# Ruby's class Value is the superclass of every type. Here Value is a module (`ActiveModel::Type::Value.cast(t, v)`
# dispatches to t's type) and each type class declares Ruby's three readers `precision, scale, limit` first
# and includes it. Ruby's `Value.new` itself (the type of an attribute declared without one) is the class
# DefaultValue. Where a Ruby subclass calls `super`, the Value body is written in place (they are one line)
# or called under its super_ name.

module ActiveModel
  module Type
    module Value
      include SerializeCastValue
      def precision(t) = raise(NotImplementedError)
      def scale(t) = raise(NotImplementedError)
      def limit(t) = raise(NotImplementedError)

      def serializable?(t, value) = true
      def type(t) = nil
      def deserialize(t, value) = cast(t, value)
      def cast(t, value) = super_cast(t, value)
      def super_cast(t, value) = (value in nil) ? nil : cast_value(t, value)
      def serialize(t, value) = value
      def type_cast_for_schema(t, value) = Kernel.inspect(value)
      def binary?(t) = false
      def changed?(t, old_value, new_value, new_value_before_type_cast) = old_value != new_value
      def changed_in_place?(t, raw_old_value, new_value) = false
      def value_constructed_by_mass_assignment?(t, value) = false
      def force_equality?(t, value) = false
      def map(t, value) = value
      def assert_valid_value(t, value) = nil
      def serialized?(t) = false
      def mutable?(t) = true
      def cast_value(t, value) = value
    end

    class DefaultValue
      attr_reader precision, scale, limit
      include Value
      def initialize(t) = nil
    end
  end
end
