class Mapper
  attr_accessor routes

  def other(m)
    yield
    nil
  end
  def resources(m, kind)
    return other(m) { yield } if kind == 1
    return other(m) { yield } if kind == 2
    return other(m) { yield } if kind == 3
    return other(m) { yield } if kind == 4
    return other(m) { yield } if kind == 5
    return other(m) { yield } if kind == 6
    return other(m) { yield } if kind == 7
    return other(m) { yield } if kind == 8
    return other(m) { yield } if kind == 9
    return other(m) { yield } if kind == 10
    return other(m) { yield } if kind == 11
    return other(m) { yield } if kind == 12
    return other(m) { yield } if kind == 13
    return other(m) { yield } if kind == 14
    return other(m) { yield } if kind == 15
    return other(m) { yield } if kind == 16
    return other(m) { yield } if kind == 17
    return other(m) { yield } if kind == 18
    return other(m) { yield } if kind == 19
    return other(m) { yield } if kind == 20
    return other(m) { yield } if kind == 21
    return other(m) { yield } if kind == 22
    return other(m) { yield } if kind == 23
    return other(m) { yield } if kind == 24
    return other(m) { yield } if kind == 25
    return other(m) { yield } if kind == 26
    return other(m) { yield } if kind == 27
    return other(m) { yield } if kind == 28
    return other(m) { yield } if kind == 29
    return other(m) { yield } if kind == 30
    return other(m) { yield } if kind == 31
    return other(m) { yield } if kind == 32
    return other(m) { yield } if kind == 33
    return other(m) { yield } if kind == 34
    return other(m) { yield } if kind == 35
    return other(m) { yield } if kind == 36
    return other(m) { yield } if kind == 37
    return other(m) { yield } if kind == 38
    return other(m) { yield } if kind == 39
    return other(m) { yield } if kind == 40
    return other(m) { yield } if kind == 41
    return other(m) { yield } if kind == 42
    return other(m) { yield } if kind == 43
    return other(m) { yield } if kind == 44
    return other(m) { yield } if kind == 45
    return other(m) { yield } if kind == 46
    return other(m) { yield } if kind == 47
    return other(m) { yield } if kind == 48
    return other(m) { yield } if kind == 49
    return other(m) { yield } if kind == 50
    return other(m) { yield } if kind == 51
    return other(m) { yield } if kind == 52
    return other(m) { yield } if kind == 53
    return other(m) { yield } if kind == 54
    return other(m) { yield } if kind == 55
    return other(m) { yield } if kind == 56
    return other(m) { yield } if kind == 57
    return other(m) { yield } if kind == 58
    return other(m) { yield } if kind == 59
    return other(m) { yield } if kind == 60
    return other(m) { yield } if kind == 61
    return other(m) { yield } if kind == 62
    return other(m) { yield } if kind == 63
    return other(m) { yield } if kind == 64

    yield
    Array.push(@routes, kind)
    nil
  end
end
m = Mapper.new(Integer[])
Mapper.resources(m, 1) { Mapper.resources(m, 0) { Array.push(Mapper.routes(m), -1) } }
p(Mapper.routes(m))
