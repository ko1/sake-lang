def read_lines
  out = String[]
  l = gets
  while l != nil
    Array.push(out, String.chomp(l))
    l = gets
  end
  out
end

def all_digits?(toks)
  Array.all?(toks) { |s| String.match?(s, /\A[0-9]+\z/) }
end

def header_ok?(lines)
  return false if Array.size(lines) == 0
  toks = String.split(lines[0])
  return false if Array.size(toks) != 3
  return false unless all_digits?(toks)
  n = String.to_i(toks[0])
  d = String.to_i(toks[1])
  c = String.to_i(toks[2])
  n >= 2 && n <= 50 && d <= 5 && c >= 1 && c <= 20
end

def valid_request?(toks, n, prev)
  return false if Array.size(toks) != 3
  return false unless all_digits?(toks)
  t = String.to_i(toks[0])
  f = String.to_i(toks[1])
  g = String.to_i(toks[2])
  return false if t > 1000 || t < prev
  return false if f < 1 || f > n || g < 1 || g > n || f == g
  true
end

def solve(lines)
  unless header_ok?(lines)
    puts("invalid header")
    return
  end
  hd = String.split(lines[0])
  n = String.to_i(hd[0])
  dd = String.to_i(hd[1])
  cap = String.to_i(hd[2])
  pt = Integer[]
  pf = Integer[]
  pg = Integer[]
  prev = 0
  i = 1
  while i < Array.size(lines)
    toks = String.split(lines[i])
    if Array.size(toks) > 0
      if valid_request?(toks, n, prev)
        prev = String.to_i(toks[0])
        Array.push(pt, prev)
        Array.push(pf, String.to_i(toks[1]))
        Array.push(pg, String.to_i(toks[2]))
      else
        puts("line #{i + 1}: invalid request")
      end
    end
    i += 1
  end
  np = Array.size(pt)
  if np == 0
    puts("no passengers")
    return
  end

  st = Array.new(np, 0)
  pk = Array.new(np, 0)
  dr = Array.new(np, 0)
  f = 1
  t = 0
  dir = 0
  done = 0
  while done < np
    i = 0
    while i < np
      st[i] = 1 if st[i] == 0 && pt[i] <= t
      i += 1
    end

    changed = false
    i = 0
    while i < np
      if st[i] == 2 && pg[i] == f
        st[i] = 3
        dr[i] = t
        done += 1
        changed = true
        puts("t=#{t} floor #{f} drop P#{i + 1}")
      end
      i += 1
    end

    above = false
    below = false
    best = 0
    i = 0
    while i < np
      tg = 0
      if st[i] == 2
        tg = pg[i]
      elsif st[i] == 1
        tg = pf[i]
      end
      if tg > 0
        above = true if tg > f
        below = true if tg < f
        dist = Integer.abs(tg - f)
        if best == 0
          best = tg
        elsif dist < Integer.abs(best - f)
          best = tg
        elsif dist == Integer.abs(best - f) && tg < best
          best = tg
        end
      end
      i += 1
    end

    if dir == 1
      if above
        dir = 1
      elsif below
        dir = -1
      else
        dir = 0
      end
    elsif dir == -1
      if below
        dir = -1
      elsif above
        dir = 1
      else
        dir = 0
      end
    end
    if dir == 0 && best > 0
      if best > f
        dir = 1
      elsif best < f
        dir = -1
      else
        i = 0
        found = false
        while i < np && !found
          if st[i] == 1 && pf[i] == f
            dir = pg[i] > pf[i] ? 1 : -1
            found = true
          end
          i += 1
        end
      end
    end

    if dir != 0
      riding = 0
      i = 0
      while i < np
        riding += 1 if st[i] == 2
        i += 1
      end
      i = 0
      while i < np
        if st[i] == 1 && pf[i] == f && riding < cap
          pd = pg[i] > pf[i] ? 1 : -1
          if pd == dir
            st[i] = 2
            pk[i] = t
            riding += 1
            changed = true
            puts("t=#{t} floor #{f} pick P#{i + 1}")
          end
        end
        i += 1
      end
    end

    if changed
      t += dd
    else
      f += dir
      t += 1
    end
  end

  sw = 0
  sr = 0
  i = 0
  while i < np
    w = pk[i] - pt[i]
    r = dr[i] - pk[i]
    sw += w
    sr += r
    puts("P#{i + 1} wait #{w} ride #{r}")
    i += 1
  end
  puts(format("average wait %.2f ride %.2f", Integer.to_f(sw) / np, Integer.to_f(sr) / np))
  puts("done at t=#{Array.max(dr)}")
end

solve(read_lines)
