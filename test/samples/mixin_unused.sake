# A module that no type includes yet (a library's unused part) is accepted; a required function
# may be called with a block, as its includers define it.
module Walk
  def each_step(w) = raise(NotImplementedError)
  def steps(w)
    out = Array[]
    each_step(w) { |x| Array.push(out, x) }
    out
  end
end
class Line
  attr_reader n
  include Walk
  def each_step(l) = Integer.times(@n) { |i| yield(i) }
end
p(Line.steps(Line.new(3)))
module Handler                         # nobody includes it in this program
  def handle(h, ev) = raise(NotImplementedError)
  def describe(h) = "handler for #{events(h)}"
end
def publish_to(h, ev) = Handler.handle(h, ev)
puts("this program never publishes")
