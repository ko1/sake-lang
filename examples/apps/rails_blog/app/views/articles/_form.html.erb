<%= form_with view, model: article do |form| %>
  <% if ActiveModel::Errors.any?(Article.errors(article)) %>
    <div style="color: red">
      <h2><%= pluralize view, ActiveModel::Errors.count(Article.errors(article)), "error" %> prohibited this article from being saved:</h2>

      <ul>
        <% ActiveModel::Errors.each(Article.errors(article)) do |error| %>
          <li><%= ActiveModel::Error.full_message(error) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= FormBuilder.label form, :title, style: "display: block" %>
    <%= FormBuilder.text_field form, :title %>
  </div>

  <div>
    <%= FormBuilder.label form, :body, style: "display: block" %>
    <%= FormBuilder.textarea form, :body %>
  </div>

  <div>
    <%= FormBuilder.submit form %>
  </div>
<% end %>
