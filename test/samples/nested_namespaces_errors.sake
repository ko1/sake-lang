# What nested names reject: an unknown nested name, a namespace used as a value, a chain step with no
# operation, and a body statement that is not a definition.
module Geo
  class Point
    attr_reader x, y
  end
  puts("hi")
end

p(Geo::Nope.new(1))
p(Geo::Point)
pt = Geo::Point.new(1, 2)
pt.Geo::Point
p(Geo::Point.z(pt))
